{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Bo3fT93kBgYJmLLRkVPHC","type":"tool_result","content":"     1→/**\n     2→ * Alert Service\n     3→ *\n     4→ * Centralized alert system for the show controller.\n     5→ * Handles creating, resolving, and acknowledging alerts.\n     6→ * Alerts are stored in Firebase and broadcast via socket events.\n     7→ *\n     8→ * @module alertService\n     9→ */\n    10→\n    11→import { EventEmitter } from 'events';\n    12→import admin from 'firebase-admin';\n    13→\n    14→/**\n    15→ * Alert levels - determines visual treatment and urgency\n    16→ */\n    17→export const ALERT_LEVEL = {\n    18→  CRITICAL: 'critical',  // Red banner, alarm sound - immediate action required\n    19→  WARNING: 'warning',    // Yellow panel, chime - attention needed\n    20→  INFO: 'info'           // Toast notification - informational\n    21→};\n    22→\n    23→/**\n    24→ * Alert categories - groups alerts by source/type\n    25→ */\n    26→export const ALERT_CATEGORY = {\n    27→  VM: 'vm',           // VM health issues (unreachable, starting, stopping)\n    28→  SERVICE: 'service', // Service health (OBS, Node, NoMachine)\n    29→  CAMERA: 'camera',   // Camera health and fallback issues\n    30→  OBS: 'obs',         // OBS-specific issues (disconnection, scene problems)\n    31→  TALENT: 'talent'    // Talent view issues (connection, graphics)\n    32→};\n    33→\n    34→// Auto-resolve configuration by category\n    35→const DEFAULT_AUTO_RESOLVE_CONFIG = {\n    36→  [ALERT_CATEGORY.VM]: true,\n    37→  [ALERT_CATEGORY.SERVICE]: true,\n    38→  [ALERT_CATEGORY.CAMERA]: true,\n    39→  [ALERT_CATEGORY.OBS]: true,\n    40→  [ALERT_CATEGORY.TALENT]: true\n    41→};\n    42→\n    43→// Default configuration\n    44→const DEFAULT_CONFIG = {\n    45→  autoResolveEnabled: true,\n    46→  infoAutoDismissMs: 10000,  // Auto-dismiss info alerts after 10 seconds\n    47→  maxAlertsPerCompetition: 100  // Limit stored alerts per competition\n    48→};\n    49→\n    50→/**\n    51→ * Alert Service class\n    52→ * Manages alerts with Firebase persistence and socket broadcasting\n    53→ */\n    54→class AlertService extends EventEmitter {\n    55→  constructor(config = {}) {\n    56→    super();\n    57→\n    58→    this._config = { ...DEFAULT_CONFIG, ...config };\n    59→    this._autoResolveConfig = { ...DEFAULT_AUTO_RESOLVE_CONFIG };\n    60→    this._db = null;\n    61→    this._isInitialized = false;\n    62→    this._alertCounters = new Map();  // Track alert IDs per competition\n    63→\n    64→    console.log('[AlertService] Instance created');\n    65→  }\n    66→\n    67→  /**\n    68→   * Initialize the alert service\n    69→   * Sets up Firebase connection\n    70→   */\n    71→  async initialize() {\n    72→    if (this._isInitialized) {\n    73→      console.log('[AlertService] Already initialized');\n    74→      return;\n    75→    }\n    76→\n    77→    console.log('[AlertService] Initializing...');\n    78→\n    79→    try {\n    80→      // Initialize Firebase Admin if not already done\n    81→      if (admin.apps.length === 0) {\n    82→        const databaseURL = process.env.FIREBASE_DATABASE_URL ||\n    83→          'https://gymnastics-graphics-default-rtdb.firebaseio.com';\n    84→\n    85→        admin.initializeApp({\n    86→          credential: admin.credential.applicationDefault(),\n    87→          databaseURL\n    88→        });\n    89→      }\n    90→\n    91→      this._db = admin.database();\n    92→      this._isInitialized = true;\n    93→\n    94→      console.log('[AlertService] Initialized successfully');\n    95→      this.emit('initialized');\n    96→    } catch (error) {\n    97→      console.error('[AlertService] Initialization failed:', error.message);\n    98→      throw error;\n    99→    }\n   100→  }\n   101→\n   102→  /**\n   103→   * Generate a unique alert ID\n   104→   * @param {string} competitionId - Competition ID\n   105→   * @returns {string} Unique alert ID\n   106→   */\n   107→  _generateAlertId(competitionId) {\n   108→    const counter = (this._alertCounters.get(competitionId) || 0) + 1;\n   109→    this._alertCounters.set(competitionId, counter);\n   110→    const timestamp = Date.now();\n   111→    return `alert_${timestamp}_${counter}`;\n   112→  }\n   113→\n   114→  /**\n   115→   * Create a new alert\n   116→   * @param {string} competitionId - Competition ID the alert belongs to\n   117→   * @param {Object} alertData - Alert data\n   118→   * @param {string} alertData.level - Alert level (ALERT_LEVEL)\n   119→   * @param {string} alertData.category - Alert category (ALERT_CATEGORY)\n   120→   * @param {string} alertData.title - Short alert title\n   121→   * @param {string} alertData.message - Detailed alert message\n   122→   * @param {Object} [alertData.metadata] - Additional context data\n   123→   * @param {string} [alertData.sourceId] - Source identifier for auto-resolution\n   124→   * @returns {Promise<Object>} Created alert object\n   125→   */\n   126→  async createAlert(competitionId, alertData) {\n   127→    if (!this._isInitialized) {\n   128→      console.warn('[AlertService] Not initialized, cannot create alert');\n   129→      return null;\n   130→    }\n   131→\n   132→    const { level, category, title, message, metadata = {}, sourceId = null } = alertData;\n   133→\n   134→    // Validate required fields\n   135→    if (!level || !category || !title || !message) {\n   136→      throw new Error('Alert requires level, category, title, and message');\n   137→    }\n   138→\n   139→    // Validate level and category\n   140→    if (!Object.values(ALERT_LEVEL).includes(level)) {\n   141→      throw new Error(`Invalid alert level: ${level}`);\n   142→    }\n   143→    if (!Object.values(ALERT_CATEGORY).includes(category)) {\n   144→      throw new Error(`Invalid alert category: ${category}`);\n   145→    }\n   146→\n   147→    const alertId = this._generateAlertId(competitionId);\n   148→    const now = new Date().toISOString();\n   149→\n   150→    const alert = {\n   151→      id: alertId,\n   152→      competitionId,\n   153→      level,\n   154→      category,\n   155→      title,\n   156→      message,\n   157→      metadata,\n   158→      sourceId,\n   159→      createdAt: now,\n   160→      acknowledged: false,\n   161→      acknowledgedAt: null,\n   162→      acknowledgedBy: null,\n   163→      resolved: false,\n   164→      resolvedAt: null,\n   165→      resolvedBy: null,\n   166→      autoResolved: false\n   167→    };\n   168→\n   169→    try {\n   170→      // Store alert in Firebase\n   171→      await this._db.ref(`alerts/${competitionId}/${alertId}`).set(alert);\n   172→\n   173→      console.log(`[AlertService] Alert created: ${alertId} (${level}/${category}) - ${title}`);\n   174→\n   175→      // Emit event for socket broadcasting\n   176→      this.emit('alertCreated', { competitionId, alert });\n   177→\n   178→      // Schedule auto-dismiss for info alerts\n   179→      if (level === ALERT_LEVEL.INFO && this._config.infoAutoDismissMs > 0) {\n   180→        setTimeout(() => {\n   181→          this.resolveAlert(competitionId, alertId, 'system', true).catch(err => {\n   182→            console.error(`[AlertService] Auto-dismiss failed for ${alertId}:`, err.message);\n   183→          });\n   184→        }, this._config.infoAutoDismissMs);\n   185→      }\n   186→\n   187→      return alert;\n   188→    } catch (error) {\n   189→      console.error(`[AlertService] Failed to create alert:`, error.message);\n   190→      throw error;\n   191→    }\n   192→  }\n   193→\n   194→  /**\n   195→   * Resolve an alert\n   196→   * @param {string} competitionId - Competition ID\n   197→   * @param {string} alertId - Alert ID to resolve\n   198→   * @param {string} [resolvedBy='system'] - Who resolved the alert\n   199→   * @param {boolean} [autoResolved=false] - Whether this was auto-resolved\n   200→   * @returns {Promise<Object>} Updated alert object\n   201→   */\n   202→  async resolveAlert(competitionId, alertId, resolvedBy = 'system', autoResolved = false) {\n   203→    if (!this._isInitialized) {\n   204→      console.warn('[AlertService] Not initialized, cannot resolve alert');\n   205→      return null;\n   206→    }\n   207→\n   208→    const now = new Date().toISOString();\n   209→\n   210→    try {\n   211→      const alertRef = this._db.ref(`alerts/${competitionId}/${alertId}`);\n   212→      const snapshot = await alertRef.once('value');\n   213→      const alert = snapshot.val();\n   214→\n   215→      if (!alert) {\n   216→        console.warn(`[AlertService] Alert not found: ${alertId}`);\n   217→        return null;\n   218→      }\n   219→\n   220→      if (alert.resolved) {\n   221→        console.log(`[AlertService] Alert already resolved: ${alertId}`);\n   222→        return alert;\n   223→      }\n   224→\n   225→      const updates = {\n   226→        resolved: true,\n   227→        resolvedAt: now,\n   228→        resolvedBy,\n   229→        autoResolved\n   230→      };\n   231→\n   232→      await alertRef.update(updates);\n   233→\n   234→      const updatedAlert = { ...alert, ...updates };\n   235→\n   236→      console.log(`[AlertService] Alert resolved: ${alertId} by ${resolvedBy} (auto: ${autoResolved})`);\n   237→\n   238→      // Emit event for socket broadcasting\n   239→      this.emit('alertResolved', { competitionId, alertId, alert: updatedAlert });\n   240→\n   241→      return updatedAlert;\n   242→    } catch (error) {\n   243→      console.error(`[AlertService] Failed to resolve alert ${alertId}:`, error.message);\n   244→      throw error;\n   245→    }\n   246→  }\n   247→\n   248→  /**\n   249→   * Resolve all alerts matching a source ID (for auto-resolution on recovery)\n   250→   * @param {string} competitionId - Competition ID\n   251→   * @param {string} sourceId - Source identifier\n   252→   * @param {string} [resolvedBy='system'] - Who resolved the alerts\n   253→   * @returns {Promise<number>} Number of alerts resolved\n   254→   */\n   255→  async resolveBySourceId(competitionId, sourceId, resolvedBy = 'system') {\n   256→    if (!this._isInitialized || !sourceId) {\n   257→      return 0;\n   258→    }\n   259→\n   260→    try {\n   261→      const alertsRef = this._db.ref(`alerts/${competitionId}`);\n   262→      const snapshot = await alertsRef.once('value');\n   263→      const alerts = snapshot.val() || {};\n   264→\n   265→      let resolvedCount = 0;\n   266→\n   267→      for (const [alertId, alert] of Object.entries(alerts)) {\n   268→        if (alert.sourceId === sourceId && !alert.resolved) {\n   269→          await this.resolveAlert(competitionId, alertId, resolvedBy, true);\n   270→          resolvedCount++;\n   271→        }\n   272→      }\n   273→\n   274→      if (resolvedCount > 0) {\n   275→        console.log(`[AlertService] Auto-resolved ${resolvedCount} alerts for sourceId: ${sourceId}`);\n   276→      }\n   277→\n   278→      return resolvedCount;\n   279→    } catch (error) {\n   280→      console.error(`[AlertService] Failed to resolve by sourceId ${sourceId}:`, error.message);\n   281→      return 0;\n   282→    }\n   283→  }\n   284→\n   285→  /**\n   286→   * Acknowledge an alert (mark as seen, but not resolved)\n   287→   * @param {string} competitionId - Competition ID\n   288→   * @param {string} alertId - Alert ID to acknowledge\n   289→   * @param {string} [acknowledgedBy='producer'] - Who acknowledged the alert\n   290→   * @returns {Promise<Object>} Updated alert object\n   291→   */\n   292→  async acknowledgeAlert(competitionId, alertId, acknowledgedBy = 'producer') {\n   293→    if (!this._isInitialized) {\n   294→      console.warn('[AlertService] Not initialized, cannot acknowledge alert');\n   295→      return null;\n   296→    }\n   297→\n   298→    const now = new Date().toISOString();\n   299→\n   300→    try {\n   301→      const alertRef = this._db.ref(`alerts/${competitionId}/${alertId}`);\n   302→      const snapshot = await alertRef.once('value');\n   303→      const alert = snapshot.val();\n   304→\n   305→      if (!alert) {\n   306→        console.warn(`[AlertService] Alert not found: ${alertId}`);\n   307→        return null;\n   308→      }\n   309→\n   310→      if (alert.acknowledged) {\n   311→        console.log(`[AlertService] Alert already acknowledged: ${alertId}`);\n   312→        return alert;\n   313→      }\n   314→\n   315→      const updates = {\n   316→        acknowledged: true,\n   317→        acknowledgedAt: now,\n   318→        acknowledgedBy\n   319→      };\n   320→\n   321→      await alertRef.update(updates);\n   322→\n   323→      const updatedAlert = { ...alert, ...updates };\n   324→\n   325→      console.log(`[AlertService] Alert acknowledged: ${alertId} by ${acknowledgedBy}`);\n   326→\n   327→      // Emit event for socket broadcasting\n   328→      this.emit('alertAcknowledged', { competitionId, alertId, alert: updatedAlert });\n   329→\n   330→      return updatedAlert;\n   331→    } catch (error) {\n   332→      console.error(`[AlertService] Failed to acknowledge alert ${alertId}:`, error.message);\n   333→      throw error;\n   334→    }\n   335→  }\n   336→\n   337→  /**\n   338→   * Acknowledge all unacknowledged alerts for a competition\n   339→   * @param {string} competitionId - Competition ID\n   340→   * @param {string} [acknowledgedBy='producer'] - Who acknowledged the alerts\n   341→   * @returns {Promise<number>} Number of alerts acknowledged\n   342→   */\n   343→  async acknowledgeAll(competitionId, acknowledgedBy = 'producer') {\n   344→    if (!this._isInitialized) {\n   345→      return 0;\n   346→    }\n   347→\n   348→    try {\n   349→      const alerts = await this.getActiveAlerts(competitionId);\n   350→      let acknowledgedCount = 0;\n   351→\n   352→      for (const alert of alerts) {\n   353→        if (!alert.acknowledged) {\n   354→          await this.acknowledgeAlert(competitionId, alert.id, acknowledgedBy);\n   355→          acknowledgedCount++;\n   356→        }\n   357→      }\n   358→\n   359→      if (acknowledgedCount > 0) {\n   360→        console.log(`[AlertService] Acknowledged ${acknowledgedCount} alerts for ${competitionId}`);\n   361→      }\n   362→\n   363→      return acknowledgedCount;\n   364→    } catch (error) {\n   365→      console.error(`[AlertService] Failed to acknowledge all:`, error.message);\n   366→      return 0;\n   367→    }\n   368→  }\n   369→\n   370→  /**\n   371→   * Get all active (unresolved) alerts for a competition\n   372→   * @param {string} competitionId - Competition ID\n   373→   * @returns {Promise<Array>} Array of active alerts\n   374→   */\n   375→  async getActiveAlerts(competitionId) {\n   376→    if (!this._isInitialized) {\n   377→      return [];\n   378→    }\n   379→\n   380→    try {\n   381→      const alertsRef = this._db.ref(`alerts/${competitionId}`);\n   382→      const snapshot = await alertsRef.once('value');\n   383→      const alerts = snapshot.val() || {};\n   384→\n   385→      // Filter to unresolved alerts and convert to array\n   386→      const activeAlerts = Object.values(alerts)\n   387→        .filter(alert => !alert.resolved)\n   388→        .sort((a, b) => {\n   389→          // Sort by level (critical first), then by timestamp (newest first)\n   390→          const levelOrder = { critical: 0, warning: 1, info: 2 };\n   391→          const levelDiff = levelOrder[a.level] - levelOrder[b.level];\n   392→          if (levelDiff !== 0) return levelDiff;\n   393→          return new Date(b.createdAt) - new Date(a.createdAt);\n   394→        });\n   395→\n   396→      return activeAlerts;\n   397→    } catch (error) {\n   398→      console.error(`[AlertService] Failed to get active alerts:`, error.message);\n   399→      return [];\n   400→    }\n   401→  }\n   402→\n   403→  /**\n   404→   * Get all alerts for a competition (including resolved)\n   405→   * @param {string} competitionId - Competition ID\n   406→   * @param {Object} [options] - Query options\n   407→   * @param {boolean} [options.includeResolved=true] - Include resolved alerts\n   408→   * @param {number} [options.limit=100] - Maximum number of alerts to return\n   409→   * @returns {Promise<Array>} Array of alerts\n   410→   */\n   411→  async getAllAlerts(competitionId, options = {}) {\n   412→    if (!this._isInitialized) {\n   413→      return [];\n   414→    }\n   415→\n   416→    const { includeResolved = true, limit = 100 } = options;\n   417→\n   418→    try {\n   419→      const alertsRef = this._db.ref(`alerts/${competitionId}`);\n   420→      const snapshot = await alertsRef.once('value');\n   421→      const alerts = snapshot.val() || {};\n   422→\n   423→      let alertArray = Object.values(alerts);\n   424→\n   425→      if (!includeResolved) {\n   426→        alertArray = alertArray.filter(alert => !alert.resolved);\n   427→      }\n   428→\n   429→      // Sort by timestamp (newest first)\n   430→      alertArray.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));\n   431→\n   432→      // Apply limit\n   433→      return alertArray.slice(0, limit);\n   434→    } catch (error) {\n   435→      console.error(`[AlertService] Failed to get all alerts:`, error.message);\n   436→      return [];\n   437→    }\n   438→  }\n   439→\n   440→  /**\n   441→   * Get alert counts for a competition\n   442→   * @param {string} competitionId - Competition ID\n   443→   * @returns {Promise<Object>} Alert counts by level\n   444→   */\n   445→  async getAlertCounts(competitionId) {\n   446→    const activeAlerts = await this.getActiveAlerts(competitionId);\n   447→\n   448→    const counts = {\n   449→      total: activeAlerts.length,\n   450→      critical: 0,\n   451→      warning: 0,\n   452→      info: 0,\n   453→      unacknowledged: 0,\n   454→      unacknowledgedCritical: 0\n   455→    };\n   456→\n   457→    for (const alert of activeAlerts) {\n   458→      counts[alert.level]++;\n   459→      if (!alert.acknowledged) {\n   460→        counts.unacknowledged++;\n   461→        if (alert.level === ALERT_LEVEL.CRITICAL) {\n   462→          counts.unacknowledgedCritical++;\n   463→        }\n   464→      }\n   465→    }\n   466→\n   467→    return counts;\n   468→  }\n   469→\n   470→  /**\n   471→   * Clear all resolved alerts older than a specified age\n   472→   * @param {string} competitionId - Competition ID\n   473→   * @param {number} [maxAgeMs=86400000] - Maximum age in ms (default 24 hours)\n   474→   * @returns {Promise<number>} Number of alerts cleared\n   475→   */\n   476→  async clearOldResolvedAlerts(competitionId, maxAgeMs = 86400000) {\n   477→    if (!this._isInitialized) {\n   478→      return 0;\n   479→    }\n   480→\n   481→    const cutoffTime = new Date(Date.now() - maxAgeMs).toISOString();\n   482→\n   483→    try {\n   484→      const alertsRef = this._db.ref(`alerts/${competitionId}`);\n   485→      const snapshot = await alertsRef.once('value');\n   486→      const alerts = snapshot.val() || {};\n   487→\n   488→      let clearedCount = 0;\n   489→\n   490→      for (const [alertId, alert] of Object.entries(alerts)) {\n   491→        if (alert.resolved && alert.resolvedAt < cutoffTime) {\n   492→          await this._db.ref(`alerts/${competitionId}/${alertId}`).remove();\n   493→          clearedCount++;\n   494→        }\n   495→      }\n   496→\n   497→      if (clearedCount > 0) {\n   498→        console.log(`[AlertService] Cleared ${clearedCount} old alerts for ${competitionId}`);\n   499→      }\n   500→\n   501→      return clearedCount;\n   502→    } catch (error) {\n   503→      console.error(`[AlertService] Failed to clear old alerts:`, error.message);\n   504→      return 0;\n   505→    }\n   506→  }\n   507→\n   508→  /**\n   509→   * Check if auto-resolve is enabled for a category\n   510→   * @param {string} category - Alert category\n   511→   * @returns {boolean} Whether auto-resolve is enabled\n   512→   */\n   513→  isAutoResolveEnabled(category) {\n   514→    return this._config.autoResolveEnabled && this._autoResolveConfig[category] !== false;\n   515→  }\n   516→\n   517→  /**\n   518→   * Update auto-resolve configuration for a category\n   519→   * @param {string} category - Alert category\n   520→   * @param {boolean} enabled - Whether to enable auto-resolve\n   521→   */\n   522→  setAutoResolve(category, enabled) {\n   523→    if (Object.values(ALERT_CATEGORY).includes(category)) {\n   524→      this._autoResolveConfig[category] = enabled;\n   525→      console.log(`[AlertService] Auto-resolve for ${category}: ${enabled}`);\n   526→    }\n   527→  }\n   528→\n   529→  /**\n   530→   * Update service configuration\n   531→   * @param {Object} config - Configuration updates\n   532→   */\n   533→  updateConfig(config) {\n   534→    this._config = { ...this._config, ...config };\n   535→    console.log('[AlertService] Config updated');\n   536→    this.emit('configUpdated', this._config);\n   537→  }\n   538→\n   539→  /**\n   540→   * Check if the service is initialized\n   541→   * @returns {boolean}\n   542→   */\n   543→  isInitialized() {\n   544→    return this._isInitialized;\n   545→  }\n   546→\n   547→  /**\n   548→   * Shutdown the alert service\n   549→   */\n   550→  async shutdown() {\n   551→    console.log('[AlertService] Shutting down...');\n   552→\n   553→    this._alertCounters.clear();\n   554→    this._isInitialized = false;\n   555→\n   556→    this.emit('shutdown');\n   557→    console.log('[AlertService] Shutdown complete');\n   558→  }\n   559→}\n   560→\n   561→// Singleton instance\n   562→let alertServiceInstance = null;\n   563→\n   564→/**\n   565→ * Get or create the alert service singleton\n   566→ * @param {Object} config - Optional configuration override\n   567→ * @returns {AlertService} The alert service instance\n   568→ */\n   569→export function getAlertService(config = {}) {\n   570→  if (!alertServiceInstance) {\n   571→    alertServiceInstance = new AlertService(config);\n   572→  }\n   573→  return alertServiceInstance;\n   574→}\n   575→\n   576→// Export class for testing\n   577→export { AlertService };\n   578→\n   579→// Default export is the singleton getter\n   580→export default getAlertService;\n   581→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f403b4ff-09b5-4afb-92d0-74c6f663a833","uuid":"91cee4b8-4615-4abb-87ca-644d00aad099","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/server/lib/alertService.js","content":"/**\n * Alert Service\n *\n * Centralized alert system for the show controller.\n * Handles creating, resolving, and acknowledging alerts.\n * Alerts are stored in Firebase and broadcast via socket events.\n *\n * @module alertService\n */\n\nimport { EventEmitter } from 'events';\nimport admin from 'firebase-admin';\n\n/**\n * Alert levels - determines visual treatment and urgency\n */\nexport const ALERT_LEVEL = {\n  CRITICAL: 'critical',  // Red banner, alarm sound - immediate action required\n  WARNING: 'warning',    // Yellow panel, chime - attention needed\n  INFO: 'info'           // Toast notification - informational\n};\n\n/**\n * Alert categories - groups alerts by source/type\n */\nexport const ALERT_CATEGORY = {\n  VM: 'vm',           // VM health issues (unreachable, starting, stopping)\n  SERVICE: 'service', // Service health (OBS, Node, NoMachine)\n  CAMERA: 'camera',   // Camera health and fallback issues\n  OBS: 'obs',         // OBS-specific issues (disconnection, scene problems)\n  TALENT: 'talent'    // Talent view issues (connection, graphics)\n};\n\n// Auto-resolve configuration by category\nconst DEFAULT_AUTO_RESOLVE_CONFIG = {\n  [ALERT_CATEGORY.VM]: true,\n  [ALERT_CATEGORY.SERVICE]: true,\n  [ALERT_CATEGORY.CAMERA]: true,\n  [ALERT_CATEGORY.OBS]: true,\n  [ALERT_CATEGORY.TALENT]: true\n};\n\n// Default configuration\nconst DEFAULT_CONFIG = {\n  autoResolveEnabled: true,\n  infoAutoDismissMs: 10000,  // Auto-dismiss info alerts after 10 seconds\n  maxAlertsPerCompetition: 100  // Limit stored alerts per competition\n};\n\n/**\n * Alert Service class\n * Manages alerts with Firebase persistence and socket broadcasting\n */\nclass AlertService extends EventEmitter {\n  constructor(config = {}) {\n    super();\n\n    this._config = { ...DEFAULT_CONFIG, ...config };\n    this._autoResolveConfig = { ...DEFAULT_AUTO_RESOLVE_CONFIG };\n    this._db = null;\n    this._isInitialized = false;\n    this._alertCounters = new Map();  // Track alert IDs per competition\n\n    console.log('[AlertService] Instance created');\n  }\n\n  /**\n   * Initialize the alert service\n   * Sets up Firebase connection\n   */\n  async initialize() {\n    if (this._isInitialized) {\n      console.log('[AlertService] Already initialized');\n      return;\n    }\n\n    console.log('[AlertService] Initializing...');\n\n    try {\n      // Initialize Firebase Admin if not already done\n      if (admin.apps.length === 0) {\n        const databaseURL = process.env.FIREBASE_DATABASE_URL ||\n          'https://gymnastics-graphics-default-rtdb.firebaseio.com';\n\n        admin.initializeApp({\n          credential: admin.credential.applicationDefault(),\n          databaseURL\n        });\n      }\n\n      this._db = admin.database();\n      this._isInitialized = true;\n\n      console.log('[AlertService] Initialized successfully');\n      this.emit('initialized');\n    } catch (error) {\n      console.error('[AlertService] Initialization failed:', error.message);\n      throw error;\n    }\n  }\n\n  /**\n   * Generate a unique alert ID\n   * @param {string} competitionId - Competition ID\n   * @returns {string} Unique alert ID\n   */\n  _generateAlertId(competitionId) {\n    const counter = (this._alertCounters.get(competitionId) || 0) + 1;\n    this._alertCounters.set(competitionId, counter);\n    const timestamp = Date.now();\n    return `alert_${timestamp}_${counter}`;\n  }\n\n  /**\n   * Create a new alert\n   * @param {string} competitionId - Competition ID the alert belongs to\n   * @param {Object} alertData - Alert data\n   * @param {string} alertData.level - Alert level (ALERT_LEVEL)\n   * @param {string} alertData.category - Alert category (ALERT_CATEGORY)\n   * @param {string} alertData.title - Short alert title\n   * @param {string} alertData.message - Detailed alert message\n   * @param {Object} [alertData.metadata] - Additional context data\n   * @param {string} [alertData.sourceId] - Source identifier for auto-resolution\n   * @returns {Promise<Object>} Created alert object\n   */\n  async createAlert(competitionId, alertData) {\n    if (!this._isInitialized) {\n      console.warn('[AlertService] Not initialized, cannot create alert');\n      return null;\n    }\n\n    const { level, category, title, message, metadata = {}, sourceId = null } = alertData;\n\n    // Validate required fields\n    if (!level || !category || !title || !message) {\n      throw new Error('Alert requires level, category, title, and message');\n    }\n\n    // Validate level and category\n    if (!Object.values(ALERT_LEVEL).includes(level)) {\n      throw new Error(`Invalid alert level: ${level}`);\n    }\n    if (!Object.values(ALERT_CATEGORY).includes(category)) {\n      throw new Error(`Invalid alert category: ${category}`);\n    }\n\n    const alertId = this._generateAlertId(competitionId);\n    const now = new Date().toISOString();\n\n    const alert = {\n      id: alertId,\n      competitionId,\n      level,\n      category,\n      title,\n      message,\n      metadata,\n      sourceId,\n      createdAt: now,\n      acknowledged: false,\n      acknowledgedAt: null,\n      acknowledgedBy: null,\n      resolved: false,\n      resolvedAt: null,\n      resolvedBy: null,\n      autoResolved: false\n    };\n\n    try {\n      // Store alert in Firebase\n      await this._db.ref(`alerts/${competitionId}/${alertId}`).set(alert);\n\n      console.log(`[AlertService] Alert created: ${alertId} (${level}/${category}) - ${title}`);\n\n      // Emit event for socket broadcasting\n      this.emit('alertCreated', { competitionId, alert });\n\n      // Schedule auto-dismiss for info alerts\n      if (level === ALERT_LEVEL.INFO && this._config.infoAutoDismissMs > 0) {\n        setTimeout(() => {\n          this.resolveAlert(competitionId, alertId, 'system', true).catch(err => {\n            console.error(`[AlertService] Auto-dismiss failed for ${alertId}:`, err.message);\n          });\n        }, this._config.infoAutoDismissMs);\n      }\n\n      return alert;\n    } catch (error) {\n      console.error(`[AlertService] Failed to create alert:`, error.message);\n      throw error;\n    }\n  }\n\n  /**\n   * Resolve an alert\n   * @param {string} competitionId - Competition ID\n   * @param {string} alertId - Alert ID to resolve\n   * @param {string} [resolvedBy='system'] - Who resolved the alert\n   * @param {boolean} [autoResolved=false] - Whether this was auto-resolved\n   * @returns {Promise<Object>} Updated alert object\n   */\n  async resolveAlert(competitionId, alertId, resolvedBy = 'system', autoResolved = false) {\n    if (!this._isInitialized) {\n      console.warn('[AlertService] Not initialized, cannot resolve alert');\n      return null;\n    }\n\n    const now = new Date().toISOString();\n\n    try {\n      const alertRef = this._db.ref(`alerts/${competitionId}/${alertId}`);\n      const snapshot = await alertRef.once('value');\n      const alert = snapshot.val();\n\n      if (!alert) {\n        console.warn(`[AlertService] Alert not found: ${alertId}`);\n        return null;\n      }\n\n      if (alert.resolved) {\n        console.log(`[AlertService] Alert already resolved: ${alertId}`);\n        return alert;\n      }\n\n      const updates = {\n        resolved: true,\n        resolvedAt: now,\n        resolvedBy,\n        autoResolved\n      };\n\n      await alertRef.update(updates);\n\n      const updatedAlert = { ...alert, ...updates };\n\n      console.log(`[AlertService] Alert resolved: ${alertId} by ${resolvedBy} (auto: ${autoResolved})`);\n\n      // Emit event for socket broadcasting\n      this.emit('alertResolved', { competitionId, alertId, alert: updatedAlert });\n\n      return updatedAlert;\n    } catch (error) {\n      console.error(`[AlertService] Failed to resolve alert ${alertId}:`, error.message);\n      throw error;\n    }\n  }\n\n  /**\n   * Resolve all alerts matching a source ID (for auto-resolution on recovery)\n   * @param {string} competitionId - Competition ID\n   * @param {string} sourceId - Source identifier\n   * @param {string} [resolvedBy='system'] - Who resolved the alerts\n   * @returns {Promise<number>} Number of alerts resolved\n   */\n  async resolveBySourceId(competitionId, sourceId, resolvedBy = 'system') {\n    if (!this._isInitialized || !sourceId) {\n      return 0;\n    }\n\n    try {\n      const alertsRef = this._db.ref(`alerts/${competitionId}`);\n      const snapshot = await alertsRef.once('value');\n      const alerts = snapshot.val() || {};\n\n      let resolvedCount = 0;\n\n      for (const [alertId, alert] of Object.entries(alerts)) {\n        if (alert.sourceId === sourceId && !alert.resolved) {\n          await this.resolveAlert(competitionId, alertId, resolvedBy, true);\n          resolvedCount++;\n        }\n      }\n\n      if (resolvedCount > 0) {\n        console.log(`[AlertService] Auto-resolved ${resolvedCount} alerts for sourceId: ${sourceId}`);\n      }\n\n      return resolvedCount;\n    } catch (error) {\n      console.error(`[AlertService] Failed to resolve by sourceId ${sourceId}:`, error.message);\n      return 0;\n    }\n  }\n\n  /**\n   * Acknowledge an alert (mark as seen, but not resolved)\n   * @param {string} competitionId - Competition ID\n   * @param {string} alertId - Alert ID to acknowledge\n   * @param {string} [acknowledgedBy='producer'] - Who acknowledged the alert\n   * @returns {Promise<Object>} Updated alert object\n   */\n  async acknowledgeAlert(competitionId, alertId, acknowledgedBy = 'producer') {\n    if (!this._isInitialized) {\n      console.warn('[AlertService] Not initialized, cannot acknowledge alert');\n      return null;\n    }\n\n    const now = new Date().toISOString();\n\n    try {\n      const alertRef = this._db.ref(`alerts/${competitionId}/${alertId}`);\n      const snapshot = await alertRef.once('value');\n      const alert = snapshot.val();\n\n      if (!alert) {\n        console.warn(`[AlertService] Alert not found: ${alertId}`);\n        return null;\n      }\n\n      if (alert.acknowledged) {\n        console.log(`[AlertService] Alert already acknowledged: ${alertId}`);\n        return alert;\n      }\n\n      const updates = {\n        acknowledged: true,\n        acknowledgedAt: now,\n        acknowledgedBy\n      };\n\n      await alertRef.update(updates);\n\n      const updatedAlert = { ...alert, ...updates };\n\n      console.log(`[AlertService] Alert acknowledged: ${alertId} by ${acknowledgedBy}`);\n\n      // Emit event for socket broadcasting\n      this.emit('alertAcknowledged', { competitionId, alertId, alert: updatedAlert });\n\n      return updatedAlert;\n    } catch (error) {\n      console.error(`[AlertService] Failed to acknowledge alert ${alertId}:`, error.message);\n      throw error;\n    }\n  }\n\n  /**\n   * Acknowledge all unacknowledged alerts for a competition\n   * @param {string} competitionId - Competition ID\n   * @param {string} [acknowledgedBy='producer'] - Who acknowledged the alerts\n   * @returns {Promise<number>} Number of alerts acknowledged\n   */\n  async acknowledgeAll(competitionId, acknowledgedBy = 'producer') {\n    if (!this._isInitialized) {\n      return 0;\n    }\n\n    try {\n      const alerts = await this.getActiveAlerts(competitionId);\n      let acknowledgedCount = 0;\n\n      for (const alert of alerts) {\n        if (!alert.acknowledged) {\n          await this.acknowledgeAlert(competitionId, alert.id, acknowledgedBy);\n          acknowledgedCount++;\n        }\n      }\n\n      if (acknowledgedCount > 0) {\n        console.log(`[AlertService] Acknowledged ${acknowledgedCount} alerts for ${competitionId}`);\n      }\n\n      return acknowledgedCount;\n    } catch (error) {\n      console.error(`[AlertService] Failed to acknowledge all:`, error.message);\n      return 0;\n    }\n  }\n\n  /**\n   * Get all active (unresolved) alerts for a competition\n   * @param {string} competitionId - Competition ID\n   * @returns {Promise<Array>} Array of active alerts\n   */\n  async getActiveAlerts(competitionId) {\n    if (!this._isInitialized) {\n      return [];\n    }\n\n    try {\n      const alertsRef = this._db.ref(`alerts/${competitionId}`);\n      const snapshot = await alertsRef.once('value');\n      const alerts = snapshot.val() || {};\n\n      // Filter to unresolved alerts and convert to array\n      const activeAlerts = Object.values(alerts)\n        .filter(alert => !alert.resolved)\n        .sort((a, b) => {\n          // Sort by level (critical first), then by timestamp (newest first)\n          const levelOrder = { critical: 0, warning: 1, info: 2 };\n          const levelDiff = levelOrder[a.level] - levelOrder[b.level];\n          if (levelDiff !== 0) return levelDiff;\n          return new Date(b.createdAt) - new Date(a.createdAt);\n        });\n\n      return activeAlerts;\n    } catch (error) {\n      console.error(`[AlertService] Failed to get active alerts:`, error.message);\n      return [];\n    }\n  }\n\n  /**\n   * Get all alerts for a competition (including resolved)\n   * @param {string} competitionId - Competition ID\n   * @param {Object} [options] - Query options\n   * @param {boolean} [options.includeResolved=true] - Include resolved alerts\n   * @param {number} [options.limit=100] - Maximum number of alerts to return\n   * @returns {Promise<Array>} Array of alerts\n   */\n  async getAllAlerts(competitionId, options = {}) {\n    if (!this._isInitialized) {\n      return [];\n    }\n\n    const { includeResolved = true, limit = 100 } = options;\n\n    try {\n      const alertsRef = this._db.ref(`alerts/${competitionId}`);\n      const snapshot = await alertsRef.once('value');\n      const alerts = snapshot.val() || {};\n\n      let alertArray = Object.values(alerts);\n\n      if (!includeResolved) {\n        alertArray = alertArray.filter(alert => !alert.resolved);\n      }\n\n      // Sort by timestamp (newest first)\n      alertArray.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));\n\n      // Apply limit\n      return alertArray.slice(0, limit);\n    } catch (error) {\n      console.error(`[AlertService] Failed to get all alerts:`, error.message);\n      return [];\n    }\n  }\n\n  /**\n   * Get alert counts for a competition\n   * @param {string} competitionId - Competition ID\n   * @returns {Promise<Object>} Alert counts by level\n   */\n  async getAlertCounts(competitionId) {\n    const activeAlerts = await this.getActiveAlerts(competitionId);\n\n    const counts = {\n      total: activeAlerts.length,\n      critical: 0,\n      warning: 0,\n      info: 0,\n      unacknowledged: 0,\n      unacknowledgedCritical: 0\n    };\n\n    for (const alert of activeAlerts) {\n      counts[alert.level]++;\n      if (!alert.acknowledged) {\n        counts.unacknowledged++;\n        if (alert.level === ALERT_LEVEL.CRITICAL) {\n          counts.unacknowledgedCritical++;\n        }\n      }\n    }\n\n    return counts;\n  }\n\n  /**\n   * Clear all resolved alerts older than a specified age\n   * @param {string} competitionId - Competition ID\n   * @param {number} [maxAgeMs=86400000] - Maximum age in ms (default 24 hours)\n   * @returns {Promise<number>} Number of alerts cleared\n   */\n  async clearOldResolvedAlerts(competitionId, maxAgeMs = 86400000) {\n    if (!this._isInitialized) {\n      return 0;\n    }\n\n    const cutoffTime = new Date(Date.now() - maxAgeMs).toISOString();\n\n    try {\n      const alertsRef = this._db.ref(`alerts/${competitionId}`);\n      const snapshot = await alertsRef.once('value');\n      const alerts = snapshot.val() || {};\n\n      let clearedCount = 0;\n\n      for (const [alertId, alert] of Object.entries(alerts)) {\n        if (alert.resolved && alert.resolvedAt < cutoffTime) {\n          await this._db.ref(`alerts/${competitionId}/${alertId}`).remove();\n          clearedCount++;\n        }\n      }\n\n      if (clearedCount > 0) {\n        console.log(`[AlertService] Cleared ${clearedCount} old alerts for ${competitionId}`);\n      }\n\n      return clearedCount;\n    } catch (error) {\n      console.error(`[AlertService] Failed to clear old alerts:`, error.message);\n      return 0;\n    }\n  }\n\n  /**\n   * Check if auto-resolve is enabled for a category\n   * @param {string} category - Alert category\n   * @returns {boolean} Whether auto-resolve is enabled\n   */\n  isAutoResolveEnabled(category) {\n    return this._config.autoResolveEnabled && this._autoResolveConfig[category] !== false;\n  }\n\n  /**\n   * Update auto-resolve configuration for a category\n   * @param {string} category - Alert category\n   * @param {boolean} enabled - Whether to enable auto-resolve\n   */\n  setAutoResolve(category, enabled) {\n    if (Object.values(ALERT_CATEGORY).includes(category)) {\n      this._autoResolveConfig[category] = enabled;\n      console.log(`[AlertService] Auto-resolve for ${category}: ${enabled}`);\n    }\n  }\n\n  /**\n   * Update service configuration\n   * @param {Object} config - Configuration updates\n   */\n  updateConfig(config) {\n    this._config = { ...this._config, ...config };\n    console.log('[AlertService] Config updated');\n    this.emit('configUpdated', this._config);\n  }\n\n  /**\n   * Check if the service is initialized\n   * @returns {boolean}\n   */\n  isInitialized() {\n    return this._isInitialized;\n  }\n\n  /**\n   * Shutdown the alert service\n   */\n  async shutdown() {\n    console.log('[AlertService] Shutting down...');\n\n    this._alertCounters.clear();\n    this._isInitialized = false;\n\n    this.emit('shutdown');\n    console.log('[AlertService] Shutdown complete');\n  }\n}\n\n// Singleton instance\nlet alertServiceInstance = null;\n\n/**\n * Get or create the alert service singleton\n * @param {Object} config - Optional configuration override\n * @returns {AlertService} The alert service instance\n */\nexport function getAlertService(config = {}) {\n  if (!alertServiceInstance) {\n    alertServiceInstance = new AlertService(config);\n  }\n  return alertServiceInstance;\n}\n\n// Export class for testing\nexport { AlertService };\n\n// Default export is the singleton getter\nexport default getAlertService;\n","numLines":581,"startLine":1,"totalLines":581}}}
