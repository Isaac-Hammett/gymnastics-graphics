 = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n\n            const startValue = g.scores && g.scores.length > 0\n              ? parseFloat(g.scores[0].start) || 0\n              : 0;\n\n            const athleteRank = score > 0 ? getAthleteApparatusRank(g.gymnast_id, score) : null;\n            const athleteRankHtml = athleteRank && athleteRank <= 3\n              ? `<div class=\"athlete-rank rank-${athleteRank}\">${athleteRank}</div>`\n              : '';\n\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                ${athleteRankHtml}\n                <div class=\"athlete-sv\">${startValue > 0 ? startValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-left\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${eventDisplayName}</div>\n              </div>\n              <div class=\"header-right\">\n                <div class=\"rank-badge${rankClass}\">${rank}</div>\n                <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-split-row\">${columnsHtml}</div>`;\n    }\n\n    // Render functions for V5-V19 (apparatus view)\n    function renderMultiTeamSummaryApparatusV5(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v5', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV6(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v6', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV7(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v7', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV8(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v8', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV9(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v9', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV10(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v10', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV11(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v11', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV12(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v12', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV13(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v13', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV14(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v14', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV15(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v15', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV16(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v16', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV17(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v17', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV18(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v18', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV19(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      renderGenericLayout(contentEl, apparatusData, numTeams, 'v19', true, eventDisplayName);\n    }\n    function renderMultiTeamSummaryApparatusV20(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams, apparatusRankings = {}) {\n      // V20: V20 header (logo + team + event left, rank + total right) with V3 body/footer\n      // Now includes start values and meet-wide apparatus rankings for top 3 athletes\n      const maxAthletes = Math.min(\n        Math.max(...apparatusData.map(t => t.gymnasts.length)),\n        10\n      );\n\n      // Calculate ranks based on totalScore\n      const rankedTeams = apparatusData\n        .map((t, idx) => ({ idx, score: t.totalScore || 0 }))\n        .sort((a, b) => b.score - a.score);\n\n      // Helper to check if athlete is in top 3 for their apparatus across entire meet\n      function getAthleteApparatusRank(eventName, gymnastId, score) {\n        const rankings = apparatusRankings[eventName] || [];\n        const found = rankings.find(r => r.gymnastId === gymnastId || r.score === score);\n        return found ? found.rank : null;\n      }\n\n      let columnsHtml = '';\n\n      apparatusData.forEach((teamData, teamIndex) => {\n        const { team, eventName, gymnasts, eventScore, totalScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n\n        // Get rank for this team\n        const rank = rankedTeams.findIndex(t => t.idx === teamIndex) + 1;\n        const rankClass = rank <= 3 ? ` rank-${rank}` : '';\n\n        // Build athlete rows with start values and meet rankings\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n\n            // Get start value (difficulty score)\n            const startValue = g.scores && g.scores.length > 0\n              ? parseFloat(g.scores[0].start) || 0\n              : 0;\n\n            // Check if this athlete is in top 3 for this apparatus across entire meet\n            const athleteRank = score > 0 ? getAthleteApparatusRank(eventName, g.gymnast_id, score) : null;\n            const athleteRankHtml = athleteRank && athleteRank <= 3\n              ? `<div class=\"athlete-rank rank-${athleteRank}\">${athleteRank}</div>`\n              : '';\n\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                ${athleteRankHtml}\n                <div class=\"athlete-sv\">${startValue > 0 ? startValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-left\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${eventDisplayName}</div>\n              </div>\n              <div class=\"header-right\">\n                <div class=\"rank-badge${rankClass}\">${rank}</div>\n                <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-v20 teams-${numTeams}\">${columnsHtml}</div>`;\n    }\n\n    function renderMultiTeamSummaryApparatusV21(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams, apparatusRankings = {}) {\n      // V21: Extra Large - Same as V20 but uses v21 CSS class for larger fonts\n      const maxAthletes = Math.min(\n        Math.max(...apparatusData.map(t => t.gymnasts.length)),\n        10\n      );\n\n      // Calculate ranks based on totalScore\n      const rankedTeams = apparatusData\n        .map((t, idx) => ({ idx, score: t.totalScore || 0 }))\n        .sort((a, b) => b.score - a.score);\n\n      // Helper to check if athlete is in top 3 for their apparatus across entire meet\n      function getAthleteApparatusRank(eventName, gymnastId, score) {\n        const rankings = apparatusRankings[eventName] || [];\n        const found = rankings.find(r => r.gymnastId === gymnastId || r.score === score);\n        return found ? found.rank : null;\n      }\n\n      let columnsHtml = '';\n\n      apparatusData.forEach((teamData, teamIndex) => {\n        const { team, eventName, gymnasts, eventScore, totalScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n\n        // Get rank for this team\n        const rank = rankedTeams.findIndex(t => t.idx === teamIndex) + 1;\n        const rankClass = rank <= 3 ? ` rank-${rank}` : '';\n\n        // Build athlete rows with start values and meet rankings\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n\n            // Get start value (difficulty score)\n            const startValue = g.scores && g.scores.length > 0\n              ? parseFloat(g.scores[0].start) || 0\n              : 0;\n\n            // Check if this athlete is in top 3 for this apparatus across entire meet\n            const athleteRank = score > 0 ? getAthleteApparatusRank(eventName, g.gymnast_id, score) : null;\n            const athleteRankHtml = athleteRank && athleteRank <= 3\n              ? `<div class=\"athlete-rank rank-${athleteRank}\">${athleteRank}</div>`\n              : '';\n\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                ${athleteRankHtml}\n                <div class=\"athlete-sv\">${startValue > 0 ? startValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-left\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${eventDisplayName}</div>\n              </div>\n              <div class=\"header-right\">\n                <div class=\"rank-badge${rankClass}\">${rank}</div>\n                <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-v21 teams-${numTeams}\">${columnsHtml}</div>`;\n    }\n\n    function renderMultiTeamSummaryApparatusV22(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams, apparatusRankings = {}) {\n      // V22: Same as V21 but ranking is integrated into the order bubble\n      const maxAthletes = Math.min(\n        Math.max(...apparatusData.map(t => t.gymnasts.length)),\n        10\n      );\n\n      // Calculate ranks based on totalScore\n      const rankedTeams = apparatusData\n        .map((t, idx) => ({ idx, score: t.totalScore || 0 }))\n        .sort((a, b) => b.score - a.score);\n\n      // Helper to check if athlete is in top 3 for their apparatus across entire meet\n      function getAthleteApparatusRank(eventName, gymnastId, score) {\n        const rankings = apparatusRankings[eventName] || [];\n        const found = rankings.find(r => r.gymnastId === gymnastId || r.score === score);\n        return found ? found.rank : null;\n      }\n\n      // Medal icons for top 3\n      const medalIcons = { 1: '🥇', 2: '🥈', 3: '🥉' };\n\n      let columnsHtml = '';\n\n      apparatusData.forEach((teamData, teamIndex) => {\n        const { team, eventName, gymnasts, eventScore, totalScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n\n        // Get rank for this team\n        const rank = rankedTeams.findIndex(t => t.idx === teamIndex) + 1;\n        const rankClass = rank <= 3 ? ` rank-${rank}` : '';\n\n        // Build athlete rows with integrated ranking in order bubble\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n\n            // Get start value (difficulty score)\n            const startValue = g.scores && g.scores.length > 0\n              ? parseFloat(g.scores[0].start) || 0\n              : 0;\n\n            // Check if this athlete is in top 3 for this apparatus across entire meet\n            const athleteRank = score > 0 ? getAthleteApparatusRank(eventName, g.gymnast_id, score) : null;\n            const orderRankClass = athleteRank && athleteRank <= 3 ? ` rank-${athleteRank}` : '';\n            const medalIcon = athleteRank && athleteRank <= 3\n              ? `<span class=\"medal-icon\">${medalIcons[athleteRank]}</span>`\n              : '';\n\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order${orderRankClass}\">${i + 1}${medalIcon}</div>\n                <div class=\"athlete-name\">${name}</div>\n                <div class=\"athlete-sv\">${startValue > 0 ? startValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-left\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${eventDisplayName}</div>\n              </div>\n              <div class=\"header-right\">\n                <div class=\"rank-badge${rankClass}\">${rank}</div>\n                <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-v22 teams-${numTeams}\">${columnsHtml}</div>`;\n    }\n\n    function renderMultiTeamSummaryApparatusV23(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams, apparatusRankings = {}) {\n      // V23: Same as V22 but WITHOUT ranking in order bubble (no medals/colors)\n      const maxAthletes = Math.min(\n        Math.max(...apparatusData.map(t => t.gymnasts.length)),\n        10\n      );\n\n      // Calculate ranks based on totalScore\n      const rankedTeams = apparatusData\n        .map((t, idx) => ({ idx, score: t.totalScore || 0 }))\n        .sort((a, b) => b.score - a.score);\n\n      let columnsHtml = '';\n\n      apparatusData.forEach((teamData, teamIndex) => {\n        const { team, eventName, gymnasts, eventScore, totalScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n\n        // Get rank for this team\n        const rank = rankedTeams.findIndex(t => t.idx === teamIndex) + 1;\n        const rankClass = rank <= 3 ? ` rank-${rank}` : '';\n\n        // Build athlete rows WITHOUT ranking in order bubble\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n\n            // Get start value (difficulty score)\n            const startValue = g.scores && g.scores.length > 0\n              ? parseFloat(g.scores[0].start) || 0\n              : 0;\n\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                <div class=\"athlete-sv\">${startValue > 0 ? startValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-left\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${eventDisplayName}</div>\n              </div>\n              <div class=\"header-right\">\n                <div class=\"rank-badge${rankClass}\">${rank}</div>\n                <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-v23 teams-${numTeams}\">${columnsHtml}</div>`;\n    }\n\n    function renderMultiTeamSummaryApparatusV24(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams, apparatusRankings = {}) {\n      // V24: Meet Theme layout - uses --meet-* CSS variables for themed chrome\n      // Team columns still use team colors; only chrome elements are themed\n      const maxAthletes = Math.min(\n        Math.max(...apparatusData.map(t => t.gymnasts.length)),\n        10\n      );\n\n      // Calculate ranks based on totalScore\n      const rankedTeams = apparatusData\n        .map((t, idx) => ({ idx, score: t.totalScore || 0 }))\n        .sort((a, b) => b.score - a.score);\n\n      let columnsHtml = '';\n\n      apparatusData.forEach((teamData, teamIndex) => {\n        const { team, eventName, gymnasts, eventScore, totalScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n\n        // Get rank for this team\n        const rank = rankedTeams.findIndex(t => t.idx === teamIndex) + 1;\n        const rankClass = rank <= 3 ? ` rank-${rank}` : '';\n\n        // Build athlete rows WITHOUT ranking in order bubble\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n\n            // Get start value (difficulty score)\n            const startValue = g.scores && g.scores.length > 0\n              ? parseFloat(g.scores[0].start) || 0\n              : 0;\n\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                <div class=\"athlete-sv\">${startValue > 0 ? startValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-left\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${eventDisplayName}</div>\n              </div>\n              <div class=\"header-right\">\n                <div class=\"rank-badge${rankClass}\">${rank}</div>\n                <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-v24 teams-${numTeams}\">${columnsHtml}</div>`;\n    }\n\n    // Map apparatus short codes to API event names\n    // Supports both short codes (fx, ub) and button IDs (floor, ubars)\n    const APPARATUS_TO_EVENT = {\n      // Men's events\n      'fx': 'FLOOR',\n      'floor': 'FLOOR',\n      'ph': 'HORSE',\n      'pommel': 'HORSE',\n      'sr': 'RINGS',\n      'rings': 'RINGS',\n      'vt': 'VAULT',\n      'vault': 'VAULT',\n      'pb': 'PBARS',\n      'pbars': 'PBARS',\n      'hb': 'BAR',\n      'hbar': 'BAR',\n      // Women's events\n      'ub': 'BARS',\n      'ubars': 'BARS',\n      'bb': 'BEAM',\n      'beam': 'BEAM'\n    };\n\n    // Fetch event summary by apparatus (both teams on same event)\n    async function fetchAndRenderEventSummaryByApparatus(sessionId, apparatus, numTeams, competitionFormat, layout = 'default', gender = 'mens') {\n      const contentEl = document.getElementById('event-summary-content');\n      if (!contentEl) return;\n\n      // Wait for headshots to be loaded before rendering\n      await waitForHeadshots();\n\n      try {\n        const response = await fetch(`https://api.virti.us/session/${sessionId}/json`);\n        if (!response.ok) throw new Error('Failed to fetch');\n        const data = await response.json();\n\n        const teams = data.meet?.teams || [];\n        if (teams.length === 0) {\n          contentEl.innerHTML = '<div class=\"event-summary-error\">No teams found</div>';\n          return;\n        }\n\n        // Sort teams by team_order\n        const sortedTeams = [...teams].sort((a, b) => (a.team_order || 0) - (b.team_order || 0));\n\n        // Calculate meet-wide apparatus rankings for V20 layout\n        const apparatusRankings = calculateApparatusRankings(teams);\n\n        // Get the event name from the apparatus code\n        const eventName = APPARATUS_TO_EVENT[apparatus] || 'FLOOR';\n        const eventDisplayName = EVENT_DISPLAY_NAMES[eventName] || eventName;\n        const eventShortCode = EVENT_SHORT_CODES[eventName] || apparatus.toUpperCase();\n\n        // Determine if this is a dual meet (2 teams) or multi-team (3+)\n        const isDual = sortedTeams.length === 2;\n        const actualNumTeams = Math.min(sortedTeams.length, numTeams || sortedTeams.length);\n\n        // Build data for each team on the SAME event (apparatus mode)\n        const apparatusData = sortedTeams.slice(0, actualNumTeams).map((team) => {\n          // Use eventDisplayName for API lookup (e.g., 'Floor Exercise' instead of 'FLOOR')\n          const teamEvent = team.events?.find(e => e.event_name === eventDisplayName);\n          const gymnasts = teamEvent?.gymnasts?.sort((a, b) => (a.order || 0) - (b.order || 0)) || [];\n          const eventScore = parseFloat(teamEvent?.event_score) || 0;\n          const totalScore = parseFloat(team.final_score) || 0;\n\n          return {\n            team,\n            eventName,\n            eventDisplayName,\n            eventShortCode,\n            gymnasts,\n            eventScore,\n            totalScore\n          };\n        });\n\n        // Render based on meet type and layout\n        if (isDual) {\n          if (layout === 'broadcast-table') {\n            renderBroadcastTableLayoutApparatus(contentEl, apparatusData, eventDisplayName, eventShortCode);\n          } else if (layout === 'classic-broadcast') {\n            renderClassicBroadcastLayoutApparatus(contentEl, apparatusData, eventDisplayName, eventShortCode);\n          } else if (layout === 'default-v2') {\n            renderDefaultV2LayoutApparatus(contentEl, apparatusData, eventDisplayName, eventShortCode);\n          } else if (layout === 'dual-dynamic-v1') {\n            renderDualDynamicV1LayoutApparatus(contentEl, apparatusData, eventDisplayName, eventShortCode);\n          } else if (layout === 'default-v3') {\n            renderMultiTeamSummaryApparatusV3(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v4') {\n            renderMultiTeamSummaryApparatusV4(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v5') {\n            renderMultiTeamSummaryApparatusV5(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v6') {\n            renderMultiTeamSummaryApparatusV6(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v7') {\n            renderMultiTeamSummaryApparatusV7(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v8') {\n            renderMultiTeamSummaryApparatusV8(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v9') {\n            renderMultiTeamSummaryApparatusV9(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v10') {\n            renderMultiTeamSummaryApparatusV10(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v11') {\n            renderMultiTeamSummaryApparatusV11(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v12') {\n            renderMultiTeamSummaryApparatusV12(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v13') {\n            renderMultiTeamSummaryApparatusV13(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v14') {\n            renderMultiTeamSummaryApparatusV14(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v15') {\n            renderMultiTeamSummaryApparatusV15(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v16') {\n            renderMultiTeamSummaryApparatusV16(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v17') {\n            renderMultiTeamSummaryApparatusV17(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v18') {\n            renderMultiTeamSummaryApparatusV18(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v19') {\n            renderMultiTeamSummaryApparatusV19(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v20') {\n            renderMultiTeamSummaryApparatusV20(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v21') {\n            renderMultiTeamSummaryApparatusV21(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v22') {\n            renderMultiTeamSummaryApparatusV22(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v23') {\n            renderMultiTeamSummaryApparatusV23(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v24') {\n            renderMultiTeamSummaryApparatusV24(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams, apparatusRankings);\n          } else if (layout === 'split-row') {\n            renderMultiTeamSummaryApparatusSplitRow(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams, apparatusRankings);\n          } else {\n            renderDualMeetSummaryApparatus(contentEl, apparatusData, eventDisplayName, eventShortCode);\n          }\n        } else {\n          // Multi-team meet (3+ teams)\n          if (layout === 'default-v3') {\n            renderMultiTeamSummaryApparatusV3(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v4') {\n            renderMultiTeamSummaryApparatusV4(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v5') {\n            renderMultiTeamSummaryApparatusV5(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v6') {\n            renderMultiTeamSummaryApparatusV6(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v7') {\n            renderMultiTeamSummaryApparatusV7(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v8') {\n            renderMultiTeamSummaryApparatusV8(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v9') {\n            renderMultiTeamSummaryApparatusV9(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v10') {\n            renderMultiTeamSummaryApparatusV10(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v11') {\n            renderMultiTeamSummaryApparatusV11(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v12') {\n            renderMultiTeamSummaryApparatusV12(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v13') {\n            renderMultiTeamSummaryApparatusV13(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v14') {\n            renderMultiTeamSummaryApparatusV14(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v15') {\n            renderMultiTeamSummaryApparatusV15(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v16') {\n            renderMultiTeamSummaryApparatusV16(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v17') {\n            renderMultiTeamSummaryApparatusV17(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v18') {\n            renderMultiTeamSummaryApparatusV18(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v19') {\n            renderMultiTeamSummaryApparatusV19(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          } else if (layout === 'default-v20') {\n            renderMultiTeamSummaryApparatusV20(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v21') {\n            renderMultiTeamSummaryApparatusV21(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v22') {\n            renderMultiTeamSummaryApparatusV22(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v23') {\n            renderMultiTeamSummaryApparatusV23(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v24') {\n            renderMultiTeamSummaryApparatusV24(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams, apparatusRankings);\n          } else if (layout === 'split-row') {\n            renderMultiTeamSummaryApparatusSplitRow(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams, apparatusRankings);\n          } else {\n            renderMultiTeamSummaryApparatus(contentEl, apparatusData, eventDisplayName, eventShortCode, actualNumTeams);\n          }\n        }\n\n      } catch (error) {\n        console.error('Event summary fetch error:', error);\n        contentEl.innerHTML = '<div class=\"event-summary-error\">Error loading event summary</div>';\n      }\n    }\n\n    // Render dual meet apparatus layout (2 teams side-by-side, same event)\n    function renderDualMeetSummaryApparatus(contentEl, apparatusData, eventDisplayName, eventShortCode) {\n      const team1 = apparatusData[0];\n      const team2 = apparatusData[1];\n\n      // Calculate score differences for each lineup position\n      const maxAthletes = Math.max(team1.gymnasts.length, team2.gymnasts.length);\n\n      // Build left team column\n      const leftColumn = buildTeamColumn(team1, 'left', maxAthletes);\n      const rightColumn = buildTeamColumn(team2, 'right', maxAthletes);\n\n      // Build center divider with event name and visual diff bars\n      let centerHtml = `<div class=\"center-divider\"><div class=\"center-header\"><div class=\"rotation-badge\">${eventShortCode}</div></div>`;\n      for (let i = 0; i < maxAthletes; i++) {\n        const score1 = team1.gymnasts[i] ? parseFloat(team1.gymnasts[i].final_score) || 0 : 0;\n        const score2 = team2.gymnasts[i] ? parseFloat(team2.gymnasts[i].final_score) || 0 : 0;\n        const diff = score1 - score2;\n        const diffStr = (score1 === 0 && score2 === 0) ? '--' : diff.toFixed(3);\n\n        // Calculate bar width (max diff around 2.0 points maps to 50% width)\n        const barWidth = Math.min(Math.abs(diff) * 25, 50);\n        let barClass = 'tie';\n        if (diff > 0.001) barClass = 'left';\n        else if (diff < -0.001) barClass = 'right';\n\n        centerHtml += `\n          <div class=\"diff-row\">\n            <div class=\"diff-value\">${diffStr}</div>\n            <div class=\"diff-bar\">\n              <div class=\"diff-bar-fill ${barClass}\" style=\"width: ${barWidth}%;\"></div>\n            </div>\n          </div>\n        `;\n      }\n      centerHtml += '</div>';\n\n      // Calculate event total difference\n      const eventDiff = team1.eventScore - team2.eventScore;\n      const eventDiffStr = eventDiff.toFixed(3);\n      const eventBarWidth = Math.min(Math.abs(eventDiff) * 5, 50);\n      let eventBarClass = 'tie';\n      if (eventDiff > 0.001) eventBarClass = 'left';\n      else if (eventDiff < -0.001) eventBarClass = 'right';\n\n      // Build footer with event totals and icons (same event for both teams)\n      const footerHtml = `\n        <div class=\"event-summary-footer\">\n          <div class=\"footer-team left\">\n            <div class=\"event-abbr\">${eventShortCode}</div>\n            ${EVENT_ICONS[eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team1.eventScore > 0 ? team1.eventScore.toFixed(3) : '—'}</div>\n          </div>\n          <div class=\"footer-center\">\n            <div class=\"footer-diff\">${eventDiffStr}</div>\n            <div class=\"footer-diff-bar\">\n              <div class=\"footer-diff-fill ${eventBarClass}\" style=\"width: ${eventBarWidth}%;\"></div>\n            </div>\n          </div>\n          <div class=\"footer-team right\">\n            <div class=\"event-abbr\">${eventShortCode}</div>\n            ${EVENT_ICONS[eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team2.eventScore > 0 ? team2.eventScore.toFixed(3) : '—'}</div>\n          </div>\n        </div>\n      `;\n\n      contentEl.innerHTML = `\n        <div class=\"event-summary-dual\">\n          ${leftColumn}\n          ${centerHtml}\n          ${rightColumn}\n        </div>\n        ${footerHtml}\n      `;\n    }\n\n    // Render multi-team apparatus layout (all teams on same event)\n    function renderMultiTeamSummaryApparatus(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      let columnsHtml = '';\n\n      apparatusData.forEach(teamData => {\n        const { team, gymnasts, eventScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n\n        let athletesHtml = '';\n        gymnasts.forEach((g, i) => {\n          const score = parseFloat(g.final_score) || 0;\n          const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n          athletesHtml += `\n            <div class=\"athlete-row\">\n              <div class=\"athlete-order\">${i + 1}</div>\n              <div class=\"athlete-name\">${name}</div>\n              <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : ''}</div>\n            </div>\n          `;\n        });\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              <div class=\"event-name\">${eventDisplayName}</div>\n              <div class=\"team-name\">\n                ${team.name || team.tricode}\n                ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-quad\">${columnsHtml}</div>`;\n    }\n\n    // ==========================================\n    // LAYOUT: Hero Cards\n    // Clean symmetric layout with big text\n    // ==========================================\n\n    function renderBroadcastTableLayout(contentEl, rotationData, rotation) {\n      const team1 = rotationData[0];\n      const team2 = rotationData[1];\n      // Always use 6 rows for symmetric grid\n      const gridRows = 6;\n\n      // Build top scoreboard bar\n      const team1Logo = getTeamLogoUrl(team1.team.name, team1.team.logo);\n      const team2Logo = getTeamLogoUrl(team2.team.name, team2.team.logo);\n      const scoreboardHtml = `\n        <div class=\"hero-scoreboard\">\n          <div class=\"hero-team-score home\">\n            ${team1Logo ? `<img class=\"hero-team-logo\" src=\"${team1Logo}\" alt=\"\">` : ''}\n            <div class=\"hero-team-info\">\n              <div class=\"hero-team-name\">${team1.team.name || team1.team.tricode}</div>\n              <div class=\"hero-team-total\">${team1.totalScore > 0 ? team1.totalScore.toFixed(3) : '0.000'}</div>\n            </div>\n          </div>\n          <div class=\"hero-center-vs\">\n            <div class=\"hero-rotation-badge\">Rotation ${rotation}</div>\n            <div class=\"hero-vs-text\">VS</div>\n          </div>\n          <div class=\"hero-team-score away\">\n            ${team2Logo ? `<img class=\"hero-team-logo\" src=\"${team2Logo}\" alt=\"\">` : ''}\n            <div class=\"hero-team-info\">\n              <div class=\"hero-team-name\">${team2.team.name || team2.team.tricode}</div>\n              <div class=\"hero-team-total\">${team2.totalScore > 0 ? team2.totalScore.toFixed(3) : '0.000'}</div>\n            </div>\n          </div>\n        </div>\n      `;\n\n      // Build athlete cards for home team (always 6 rows for symmetry)\n      let homeCardsHtml = '';\n      for (let i = 0; i < gridRows; i++) {\n        const g = team1.gymnasts[i];\n        if (g) {\n          const score = parseFloat(g.final_score) || 0;\n          const name = `${g.first_name || ''} ${g.last_name || ''}`;\n          const photo = getAthleteHeadshot(g.first_name, g.last_name, g.headshot);\n\n          homeCardsHtml += `\n            <div class=\"hero-athlete-card home\">\n              ${renderAthletePhoto(photo, 'hero-athlete-photo')}\n              <div class=\"hero-athlete-info\">\n                <div class=\"hero-athlete-name\">${name}</div>\n              </div>\n              <div class=\"hero-athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n            </div>\n          `;\n        } else {\n          // Empty placeholder to maintain symmetry\n          homeCardsHtml += `<div class=\"hero-athlete-card empty\"></div>`;\n        }\n      }\n\n      // Build athlete cards for away team (always 6 rows for symmetry)\n      let awayCardsHtml = '';\n      for (let i = 0; i < gridRows; i++) {\n        const g = team2.gymnasts[i];\n        if (g) {\n          const score = parseFloat(g.final_score) || 0;\n          const name = `${g.first_name || ''} ${g.last_name || ''}`;\n          const photo = getAthleteHeadshot(g.first_name, g.last_name, g.headshot);\n\n          awayCardsHtml += `\n            <div class=\"hero-athlete-card away\">\n              ${renderAthletePhoto(photo, 'hero-athlete-photo')}\n              <div class=\"hero-athlete-info\">\n                <div class=\"hero-athlete-name\">${name}</div>\n              </div>\n              <div class=\"hero-athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n            </div>\n          `;\n        } else {\n          // Empty placeholder to maintain symmetry\n          awayCardsHtml += `<div class=\"hero-athlete-card empty\"></div>`;\n        }\n      }\n\n      // Calculate event total difference\n      const eventDiff = team1.eventScore - team2.eventScore;\n      const eventDiffText = eventDiff > 0 ? `+${eventDiff.toFixed(3)}` : eventDiff.toFixed(3);\n\n      // Build footer with event totals\n      const footerHtml = `\n        <div class=\"hero-footer\">\n          <div class=\"hero-footer-team home\">\n            <div class=\"hero-footer-event\">\n              <div class=\"hero-footer-event-code\">${team1.eventShortCode}</div>\n              <div class=\"hero-footer-event-label\">Total</div>\n            </div>\n            <div class=\"hero-footer-total\">${team1.eventScore > 0 ? team1.eventScore.toFixed(3) : '—'}</div>\n          </div>\n          <div class=\"hero-footer-center\">\n            <div class=\"hero-footer-diff\">${eventDiffText}</div>\n          </div>\n          <div class=\"hero-footer-team away\">\n            <div class=\"hero-footer-event\">\n              <div class=\"hero-footer-event-code\">${team2.eventShortCode}</div>\n              <div class=\"hero-footer-event-label\">Total</div>\n            </div>\n            <div class=\"hero-footer-total\">${team2.eventScore > 0 ? team2.eventScore.toFixed(3) : '—'}</div>\n          </div>\n        </div>\n      `;\n\n      contentEl.innerHTML = `\n        <div class=\"layout-broadcast-table\">\n          ${scoreboardHtml}\n          <div class=\"hero-cards-container\">\n            <div class=\"hero-team-column\">${homeCardsHtml}</div>\n            <div class=\"hero-team-column\">${awayCardsHtml}</div>\n          </div>\n          ${footerHtml}\n        </div>\n      `;\n    }\n\n    // Hero Cards Layout for Apparatus mode (same event for both teams)\n    function renderBroadcastTableLayoutApparatus(contentEl, apparatusData, eventDisplayName, eventShortCode) {\n      const team1 = apparatusData[0];\n      const team2 = apparatusData[1];\n      // Always use 6 rows for symmetric grid\n      const gridRows = 6;\n\n      // Build top scoreboard bar\n      const team1Logo = getTeamLogoUrl(team1.team.name, team1.team.logo);\n      const team2Logo = getTeamLogoUrl(team2.team.name, team2.team.logo);\n      const scoreboardHtml = `\n        <div class=\"hero-scoreboard\">\n          <div class=\"hero-team-score home\">\n            ${team1Logo ? `<img class=\"hero-team-logo\" src=\"${team1Logo}\" alt=\"\">` : ''}\n            <div class=\"hero-team-info\">\n              <div class=\"hero-team-name\">${team1.team.name || team1.team.tricode}</div>\n              <div class=\"hero-team-total\">${team1.totalScore > 0 ? team1.totalScore.toFixed(3) : '0.000'}</div>\n            </div>\n          </div>\n          <div class=\"hero-center-vs\">\n            <div class=\"hero-rotation-badge\">${eventDisplayName}</div>\n            <div class=\"hero-vs-text\">${eventShortCode}</div>\n          </div>\n          <div class=\"hero-team-score away\">\n            ${team2Logo ? `<img class=\"hero-team-logo\" src=\"${team2Logo}\" alt=\"\">` : ''}\n            <div class=\"hero-team-info\">\n              <div class=\"hero-team-name\">${team2.team.name || team2.team.tricode}</div>\n              <div class=\"hero-team-total\">${team2.totalScore > 0 ? team2.totalScore.toFixed(3) : '0.000'}</div>\n            </div>\n          </div>\n        </div>\n      `;\n\n      // Build athlete cards for home team (always 6 rows for symmetry)\n      let homeCardsHtml = '';\n      for (let i = 0; i < gridRows; i++) {\n        const g = team1.gymnasts[i];\n        if (g) {\n          const score = parseFloat(g.final_score) || 0;\n          const name = `${g.first_name || ''} ${g.last_name || ''}`;\n          const photo = getAthleteHeadshot(g.first_name, g.last_name, g.headshot);\n\n          homeCardsHtml += `\n            <div class=\"hero-athlete-card home\">\n              ${renderAthletePhoto(photo, 'hero-athlete-photo')}\n              <div class=\"hero-athlete-info\">\n                <div class=\"hero-athlete-name\">${name}</div>\n              </div>\n              <div class=\"hero-athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n            </div>\n          `;\n        } else {\n          homeCardsHtml += `<div class=\"hero-athlete-card empty\"></div>`;\n        }\n      }\n\n      // Build athlete cards for away team (always 6 rows for symmetry)\n      let awayCardsHtml = '';\n      for (let i = 0; i < gridRows; i++) {\n        const g = team2.gymnasts[i];\n        if (g) {\n          const score = parseFloat(g.final_score) || 0;\n          const name = `${g.first_name || ''} ${g.last_name || ''}`;\n          const photo = getAthleteHeadshot(g.first_name, g.last_name, g.headshot);\n\n          awayCardsHtml += `\n            <div class=\"hero-athlete-card away\">\n              ${renderAthletePhoto(photo, 'hero-athlete-photo')}\n              <div class=\"hero-athlete-info\">\n                <div class=\"hero-athlete-name\">${name}</div>\n              </div>\n              <div class=\"hero-athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n            </div>\n          `;\n        } else {\n          awayCardsHtml += `<div class=\"hero-athlete-card empty\"></div>`;\n        }\n      }\n\n      // Calculate event total difference\n      const eventDiff = team1.eventScore - team2.eventScore;\n      const eventDiffText = eventDiff > 0 ? `+${eventDiff.toFixed(3)}` : eventDiff.toFixed(3);\n\n      // Build footer with event totals\n      const footerHtml = `\n        <div class=\"hero-footer\">\n          <div class=\"hero-footer-team home\">\n            <div class=\"hero-footer-event\">\n              <div class=\"hero-footer-event-code\">${eventShortCode}</div>\n              <div class=\"hero-footer-event-label\">Total</div>\n            </div>\n            <div class=\"hero-footer-total\">${team1.eventScore > 0 ? team1.eventScore.toFixed(3) : '—'}</div>\n          </div>\n          <div class=\"hero-footer-center\">\n            <div class=\"hero-footer-diff\">${eventDiffText}</div>\n          </div>\n          <div class=\"hero-footer-team away\">\n            <div class=\"hero-footer-event\">\n              <div class=\"hero-footer-event-code\">${eventShortCode}</div>\n              <div class=\"hero-footer-event-label\">Total</div>\n            </div>\n            <div class=\"hero-footer-total\">${team2.eventScore > 0 ? team2.eventScore.toFixed(3) : '—'}</div>\n          </div>\n        </div>\n      `;\n\n      contentEl.innerHTML = `\n        <div class=\"layout-broadcast-table\">\n          ${scoreboardHtml}\n          <div class=\"hero-cards-container\">\n            <div class=\"hero-team-column\">${homeCardsHtml}</div>\n            <div class=\"hero-team-column\">${awayCardsHtml}</div>\n          </div>\n          ${footerHtml}\n        </div>\n      `;\n    }\n\n    // ==========================================\n    // Layout 2: Classic Broadcast\n    // Exact replica of default dual meet layout\n    // ==========================================\n\n    function renderClassicBroadcastLayout(contentEl, rotationData, rotation) {\n      const team1 = rotationData[0];\n      const team2 = rotationData[1];\n\n      const maxAthletes = Math.max(team1.gymnasts.length, team2.gymnasts.length);\n\n      // Build left team column\n      const leftColumn = buildClassicBroadcastColumn(team1, 'left', maxAthletes);\n      const rightColumn = buildClassicBroadcastColumn(team2, 'right', maxAthletes);\n\n      // Build center divider with visual diff bars\n      let centerHtml = `<div class=\"center-divider\"><div class=\"center-header\"><div class=\"rotation-badge\">R${rotation}</div></div>`;\n      for (let i = 0; i < maxAthletes; i++) {\n        const score1 = team1.gymnasts[i] ? parseFloat(team1.gymnasts[i].final_score) || 0 : 0;\n        const score2 = team2.gymnasts[i] ? parseFloat(team2.gymnasts[i].final_score) || 0 : 0;\n        const diff = score1 - score2;\n        const diffStr = (score1 === 0 && score2 === 0) ? '--' : diff.toFixed(3);\n\n        const barWidth = Math.min(Math.abs(diff) * 25, 50);\n        let barClass = 'tie';\n        if (diff > 0.001) barClass = 'left';\n        else if (diff < -0.001) barClass = 'right';\n\n        centerHtml += `\n          <div class=\"diff-row\">\n            <div class=\"diff-value\">${diffStr}</div>\n            <div class=\"diff-bar\">\n              <div class=\"diff-bar-fill ${barClass}\" style=\"width: ${barWidth}%;\"></div>\n            </div>\n          </div>\n        `;\n      }\n      centerHtml += '</div>';\n\n      // Calculate event total difference\n      const eventDiff = team1.eventScore - team2.eventScore;\n      const eventDiffStr = eventDiff.toFixed(3);\n      const eventBarWidth = Math.min(Math.abs(eventDiff) * 5, 50);\n      let eventBarClass = 'tie';\n      if (eventDiff > 0.001) eventBarClass = 'left';\n      else if (eventDiff < -0.001) eventBarClass = 'right';\n\n      // Build footer with event totals and icons\n      const footerHtml = `\n        <div class=\"summary-footer\">\n          <div class=\"footer-team left\">\n            <div class=\"event-abbr\">${team1.eventShortCode}</div>\n            ${EVENT_ICONS[team1.eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team1.eventScore > 0 ? team1.eventScore.toFixed(3) : '—'}</div>\n          </div>\n          <div class=\"footer-center\">\n            <div class=\"footer-diff\">${eventDiffStr}</div>\n            <div class=\"footer-diff-bar\">\n              <div class=\"footer-diff-fill ${eventBarClass}\" style=\"width: ${eventBarWidth}%;\"></div>\n            </div>\n          </div>\n          <div class=\"footer-team right\">\n            <div class=\"event-abbr\">${team2.eventShortCode}</div>\n            ${EVENT_ICONS[team2.eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team2.eventScore > 0 ? team2.eventScore.toFixed(3) : '—'}</div>\n          </div>\n        </div>\n      `;\n\n      contentEl.innerHTML = `\n        <div class=\"layout-classic-broadcast\">\n          ${leftColumn}\n          ${centerHtml}\n          ${rightColumn}\n        </div>\n        ${footerHtml}\n      `;\n    }\n\n    // Build a team column for classic broadcast layout\n    function buildClassicBroadcastColumn(teamData, side, maxAthletes) {\n      const { team, gymnasts, totalScore, eventShortCode } = teamData;\n\n      let athletesHtml = '';\n      for (let i = 0; i < maxAthletes; i++) {\n        const g = gymnasts[i];\n        if (g) {\n          const score = parseFloat(g.final_score) || 0;\n          const startValue = g.scores && g.scores.length > 0 ? parseFloat(g.scores[0].start) || 0 : 0;\n          const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n          const photoUrl = getAthleteHeadshot(g.first_name, g.last_name, g.headshot);\n          const isAnchor = i === 5;\n\n          athletesHtml += `\n            <div class=\"athlete-row\">\n              <div class=\"athlete-order${isAnchor ? ' anchor' : ''}\">${i + 1}</div>\n              ${renderAthletePhoto(photoUrl)}\n              <div class=\"athlete-name\">${name}</div>\n              <div class=\"athlete-score-block\">\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : 'On Eval'}</div>\n                ${startValue > 0 ? `<div class=\"athlete-start\">${startValue.toFixed(2)}</div>` : ''}\n              </div>\n            </div>\n          `;\n        } else {\n          athletesHtml += `<div class=\"athlete-row\" style=\"min-height: 72px;\"></div>`;\n        }\n      }\n\n      const logoUrl = getTeamLogoUrl(team.name, team.logo);\n      return `\n        <div class=\"team-column ${side}\">\n          <div class=\"team-header ${side}\">\n            ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n            <div class=\"team-name\">${team.name || team.tricode}</div>\n            <div class=\"team-total\">${totalScore > 0 ? totalScore.toFixed(3) : '0.000'}</div>\n          </div>\n          <div class=\"athlete-list\">\n            ${athletesHtml}\n          </div>\n        </div>\n      `;\n    }\n\n    // Classic Broadcast Layout for Apparatus mode (same event for both teams)\n    function renderClassicBroadcastLayoutApparatus(contentEl, apparatusData, eventDisplayName, eventShortCode) {\n      const team1 = apparatusData[0];\n      const team2 = apparatusData[1];\n\n      const maxAthletes = Math.max(team1.gymnasts.length, team2.gymnasts.length);\n\n      // Build left team column\n      const leftColumn = buildClassicBroadcastColumn(team1, 'left', maxAthletes);\n      const rightColumn = buildClassicBroadcastColumn(team2, 'right', maxAthletes);\n\n      // Build center divider with event name and visual diff bars\n      let centerHtml = `<div class=\"center-divider\"><div class=\"center-header\"><div class=\"rotation-badge\">${eventShortCode}</div></div>`;\n      for (let i = 0; i < maxAthletes; i++) {\n        const score1 = team1.gymnasts[i] ? parseFloat(team1.gymnasts[i].final_score) || 0 : 0;\n        const score2 = team2.gymnasts[i] ? parseFloat(team2.gymnasts[i].final_score) || 0 : 0;\n        const diff = score1 - score2;\n        const diffStr = (score1 === 0 && score2 === 0) ? '--' : diff.toFixed(3);\n\n        const barWidth = Math.min(Math.abs(diff) * 25, 50);\n        let barClass = 'tie';\n        if (diff > 0.001) barClass = 'left';\n        else if (diff < -0.001) barClass = 'right';\n\n        centerHtml += `\n          <div class=\"diff-row\">\n            <div class=\"diff-value\">${diffStr}</div>\n            <div class=\"diff-bar\">\n              <div class=\"diff-bar-fill ${barClass}\" style=\"width: ${barWidth}%;\"></div>\n            </div>\n          </div>\n        `;\n      }\n      centerHtml += '</div>';\n\n      // Calculate event total difference\n      const eventDiff = team1.eventScore - team2.eventScore;\n      const eventDiffStr = eventDiff.toFixed(3);\n      const eventBarWidth = Math.min(Math.abs(eventDiff) * 5, 50);\n      let eventBarClass = 'tie';\n      if (eventDiff > 0.001) eventBarClass = 'left';\n      else if (eventDiff < -0.001) eventBarClass = 'right';\n\n      // Build footer with event totals and icons (same event for both teams)\n      const footerHtml = `\n        <div class=\"summary-footer\">\n          <div class=\"footer-team left\">\n            <div class=\"event-abbr\">${eventShortCode}</div>\n            ${EVENT_ICONS[eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team1.eventScore > 0 ? team1.eventScore.toFixed(3) : '—'}</div>\n          </div>\n          <div class=\"footer-center\">\n            <div class=\"footer-diff\">${eventDiffStr}</div>\n            <div class=\"footer-diff-bar\">\n              <div class=\"footer-diff-fill ${eventBarClass}\" style=\"width: ${eventBarWidth}%;\"></div>\n            </div>\n          </div>\n          <div class=\"footer-team right\">\n            <div class=\"event-abbr\">${eventShortCode}</div>\n            ${EVENT_ICONS[eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team2.eventScore > 0 ? team2.eventScore.toFixed(3) : '—'}</div>\n          </div>\n        </div>\n      `;\n\n      contentEl.innerHTML = `\n        <div class=\"layout-classic-broadcast\">\n          ${leftColumn}\n          ${centerHtml}\n          ${rightColumn}\n        </div>\n        ${footerHtml}\n      `;\n    }\n\n    // ==========================================\n    // Layout 3: Default Original V2\n    // Improved default with larger text, team logos, and inline D-score\n    // ==========================================\n\n    function renderDefaultV2Layout(contentEl, rotationData, rotation) {\n      const team1 = rotationData[0];\n      const team2 = rotationData[1];\n\n      const maxAthletes = Math.max(team1.gymnasts.length, team2.gymnasts.length);\n\n      // Get home team logo from Firebase or API (only show home team in title bar)\n      const team1Logo = getTeamLogoUrl(team1.team.name, team1.team.logo);\n\n      // Build title bar - EVENT SUMMARY on left, home team logo on right\n      const titleHtml = `\n        <div class=\"title-bar\">\n          <div class=\"title-text\">Event Summary</div>\n          ${team1Logo ? `<img class=\"title-logo\" src=\"${team1Logo}\" alt=\"\">` : ''}\n        </div>\n      `;\n\n      // Build left team column\n      const leftColumn = buildDefaultV2Column(team1, 'left', maxAthletes);\n      const rightColumn = buildDefaultV2Column(team2, 'right', maxAthletes);\n\n      // Build center divider with visual diff bars (wrapped in diff-list for alignment)\n      let diffRowsHtml = '';\n      for (let i = 0; i < maxAthletes; i++) {\n        const score1 = team1.gymnasts[i] ? parseFloat(team1.gymnasts[i].final_score) || 0 : 0;\n        const score2 = team2.gymnasts[i] ? parseFloat(team2.gymnasts[i].final_score) || 0 : 0;\n        const diff = score1 - score2;\n        const diffStr = (score1 === 0 && score2 === 0) ? '--' : diff.toFixed(3);\n\n        const barWidth = Math.min(Math.abs(diff) * 25, 50);\n        let barClass = 'tie';\n        if (diff > 0.001) barClass = 'left';\n        else if (diff < -0.001) barClass = 'right';\n\n        diffRowsHtml += `\n          <div class=\"diff-row\">\n            <div class=\"diff-value\">${diffStr}</div>\n            <div class=\"diff-bar\">\n              <div class=\"diff-bar-fill ${barClass}\" style=\"width: ${barWidth}%;\"></div>\n            </div>\n          </div>\n        `;\n      }\n\n      const centerHtml = `\n        <div class=\"center-divider\">\n          <div class=\"center-header\"><div class=\"rotation-badge\">R${rotation}</div></div>\n          <div class=\"diff-list\">${diffRowsHtml}</div>\n        </div>\n      `;\n\n      // Calculate event total difference\n      const eventDiff = team1.eventScore - team2.eventScore;\n      const eventDiffStr = eventDiff.toFixed(3);\n      const eventBarWidth = Math.min(Math.abs(eventDiff) * 5, 50);\n      let eventBarClass = 'tie';\n      if (eventDiff > 0.001) eventBarClass = 'left';\n      else if (eventDiff < -0.001) eventBarClass = 'right';\n\n      // Build footer with event totals and icons\n      const footerHtml = `\n        <div class=\"event-summary-footer layout-default-v2-footer\">\n          <div class=\"footer-team left\">\n            <div class=\"event-abbr\">${team1.eventShortCode}</div>\n            ${EVENT_ICONS[team1.eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team1.eventScore > 0 ? team1.eventScore.toFixed(3) : '—'}</div>\n          </div>\n          <div class=\"footer-center\">\n            <div class=\"footer-diff\">${eventDiffStr}</div>\n            <div class=\"footer-diff-bar\">\n              <div class=\"footer-diff-fill ${eventBarClass}\" style=\"width: ${eventBarWidth}%;\"></div>\n            </div>\n          </div>\n          <div class=\"footer-team right\">\n            <div class=\"event-abbr\">${team2.eventShortCode}</div>\n            ${EVENT_ICONS[team2.eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team2.eventScore > 0 ? team2.eventScore.toFixed(3) : '—'}</div>\n          </div>\n        </div>\n      `;\n\n      contentEl.innerHTML = `\n        <div class=\"layout-default-v2\">\n          ${titleHtml}\n          <div class=\"main-content\">\n            ${leftColumn}\n            ${centerHtml}\n            ${rightColumn}\n          </div>\n        </div>\n        ${footerHtml}\n      `;\n    }\n\n    // Build a team column for Default V2 layout\n    function buildDefaultV2Column(teamData, side, maxAthletes) {\n      const { team, gymnasts, totalScore, eventShortCode } = teamData;\n\n      let athletesHtml = '';\n      for (let i = 0; i < maxAthletes; i++) {\n        const g = gymnasts[i];\n        if (g) {\n          const score = parseFloat(g.final_score) || 0;\n          const startValue = g.scores && g.scores.length > 0 ? parseFloat(g.scores[0].start) || 0 : 0;\n          const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n          const photoUrl = getAthleteHeadshot(g.first_name, g.last_name, g.headshot);\n          const isAnchor = i === 5;\n\n          athletesHtml += `\n            <div class=\"athlete-row\">\n              <div class=\"athlete-order${isAnchor ? ' anchor' : ''}\">${i + 1}</div>\n              ${renderAthletePhoto(photoUrl)}\n              <div class=\"athlete-info\">\n                <div class=\"athlete-name\">${name}</div>\n              </div>\n              <div class=\"athlete-score-block\">\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : 'On Eval'}</div>\n                ${startValue > 0 ? `<div class=\"athlete-start\">${startValue.toFixed(2)}</div>` : ''}\n              </div>\n            </div>\n          `;\n        } else {\n          athletesHtml += `<div class=\"athlete-row\"></div>`;\n        }\n      }\n\n      const logoUrl = getTeamLogoUrl(team.name, team.logo);\n      return `\n        <div class=\"team-column ${side}\">\n          <div class=\"team-header ${side}\">\n            ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n            <div class=\"team-name\">${team.name || team.tricode}</div>\n            <div class=\"team-total\">${totalScore > 0 ? totalScore.toFixed(3) : '0.000'}</div>\n          </div>\n          <div class=\"athlete-list\">\n            ${athletesHtml}\n          </div>\n        </div>\n      `;\n    }\n\n    // Default V2 Layout for Apparatus mode (same event for both teams)\n    function renderDefaultV2LayoutApparatus(contentEl, apparatusData, eventDisplayName, eventShortCode) {\n      const team1 = apparatusData[0];\n      const team2 = apparatusData[1];\n\n      const maxAthletes = Math.max(team1.gymnasts.length, team2.gymnasts.length);\n\n      // Get home team logo from Firebase or API (only show home team in title bar)\n      const team1Logo = getTeamLogoUrl(team1.team.name, team1.team.logo);\n\n      // Build title bar - EVENT SUMMARY on left, home team logo on right\n      const titleHtml = `\n        <div class=\"title-bar\">\n          <div class=\"title-text\">Event Summary</div>\n          ${team1Logo ? `<img class=\"title-logo\" src=\"${team1Logo}\" alt=\"\">` : ''}\n        </div>\n      `;\n\n      // Build left team column\n      const leftColumn = buildDefaultV2Column(team1, 'left', maxAthletes);\n      const rightColumn = buildDefaultV2Column(team2, 'right', maxAthletes);\n\n      // Build center divider with event name and visual diff bars (wrapped in diff-list for alignment)\n      let diffRowsHtml = '';\n      for (let i = 0; i < maxAthletes; i++) {\n        const score1 = team1.gymnasts[i] ? parseFloat(team1.gymnasts[i].final_score) || 0 : 0;\n        const score2 = team2.gymnasts[i] ? parseFloat(team2.gymnasts[i].final_score) || 0 : 0;\n        const diff = score1 - score2;\n        const diffStr = (score1 === 0 && score2 === 0) ? '--' : diff.toFixed(3);\n\n        const barWidth = Math.min(Math.abs(diff) * 25, 50);\n        let barClass = 'tie';\n        if (diff > 0.001) barClass = 'left';\n        else if (diff < -0.001) barClass = 'right';\n\n        diffRowsHtml += `\n          <div class=\"diff-row\">\n            <div class=\"diff-value\">${diffStr}</div>\n            <div class=\"diff-bar\">\n              <div class=\"diff-bar-fill ${barClass}\" style=\"width: ${barWidth}%;\"></div>\n            </div>\n          </div>\n        `;\n      }\n\n      const centerHtml = `\n        <div class=\"center-divider\">\n          <div class=\"center-header\"><div class=\"rotation-badge\">${eventShortCode}</div></div>\n          <div class=\"diff-list\">${diffRowsHtml}</div>\n        </div>\n      `;\n\n      // Calculate event total difference\n      const eventDiff = team1.eventScore - team2.eventScore;\n      const eventDiffStr = eventDiff.toFixed(3);\n      const eventBarWidth = Math.min(Math.abs(eventDiff) * 5, 50);\n      let eventBarClass = 'tie';\n      if (eventDiff > 0.001) eventBarClass = 'left';\n      else if (eventDiff < -0.001) eventBarClass = 'right';\n\n      // Build footer with event totals and icons (same event for both teams)\n      const footerHtml = `\n        <div class=\"event-summary-footer layout-default-v2-footer\">\n          <div class=\"footer-team left\">\n            <div class=\"event-abbr\">${eventShortCode}</div>\n            ${EVENT_ICONS[eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team1.eventScore > 0 ? team1.eventScore.toFixed(3) : '—'}</div>\n          </div>\n          <div class=\"footer-center\">\n            <div class=\"footer-diff\">${eventDiffStr}</div>\n            <div class=\"footer-diff-bar\">\n              <div class=\"footer-diff-fill ${eventBarClass}\" style=\"width: ${eventBarWidth}%;\"></div>\n            </div>\n          </div>\n          <div class=\"footer-team right\">\n            <div class=\"event-abbr\">${eventShortCode}</div>\n            ${EVENT_ICONS[eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team2.eventScore > 0 ? team2.eventScore.toFixed(3) : '—'}</div>\n          </div>\n        </div>\n      `;\n\n      contentEl.innerHTML = `\n        <div class=\"layout-default-v2\">\n          ${titleHtml}\n          <div class=\"main-content\">\n            ${leftColumn}\n            ${centerHtml}\n            ${rightColumn}\n          </div>\n        </div>\n        ${footerHtml}\n      `;\n    }\n\n    // Dual Dynamic V1 Layout - Scales to fit 1-9 athletes\n    // Calculate dynamic sizes based on athlete count\n    function getDynamicSizes(athleteCount) {\n      // Base sizes for 6 athletes (matches Default V2)\n      const base = {\n        photoSize: 88,\n        orderSize: 52,\n        orderFont: 24,\n        nameFont: 36,\n        scoreFont: 44,\n        startFont: 24,\n        rowPadding: 12,\n        rowGap: 16\n      };\n\n      // Scale factor: 6 athletes = 1.0, 9 athletes = 0.65\n      const scale = athleteCount <= 6 ? 1.0 : Math.max(0.65, 1.0 - (athleteCount - 6) * 0.12);\n\n      return {\n        photoSize: Math.round(base.photoSize * scale),\n        orderSize: Math.round(base.orderSize * scale),\n        orderFont: Math.round(base.orderFont * scale),\n        nameFont: Math.round(base.nameFont * scale),\n        scoreFont: Math.round(base.scoreFont * scale),\n        startFont: Math.round(base.startFont * scale),\n        rowPadding: Math.round(base.rowPadding * scale),\n        rowGap: Math.round(base.rowGap * scale)\n      };\n    }\n\n    function renderDualDynamicV1Layout(contentEl, rotationData, rotation) {\n      const team1 = rotationData[0];\n      const team2 = rotationData[1];\n\n      const maxAthletes = Math.max(team1.gymnasts.length, team2.gymnasts.length);\n      const sizes = getDynamicSizes(maxAthletes);\n\n      // Get home team logo from Firebase or API (only show home team in title bar)\n      const team1Logo = getTeamLogoUrl(team1.team.name, team1.team.logo);\n\n      // Build title bar - EVENT SUMMARY on left, home team logo on right\n      const titleHtml = `\n        <div class=\"title-bar\">\n          <div class=\"title-text\">Event Summary</div>\n          ${team1Logo ? `<img class=\"title-logo\" src=\"${team1Logo}\" alt=\"\">` : ''}\n        </div>\n      `;\n\n      // Build left team column\n      const leftColumn = buildDualDynamicV1Column(team1, 'left', maxAthletes, sizes);\n      const rightColumn = buildDualDynamicV1Column(team2, 'right', maxAthletes, sizes);\n\n      // Build center divider with visual diff bars (wrapped in diff-list for alignment)\n      let diffRowsHtml = '';\n      for (let i = 0; i < maxAthletes; i++) {\n        const score1 = team1.gymnasts[i] ? parseFloat(team1.gymnasts[i].final_score) || 0 : 0;\n        const score2 = team2.gymnasts[i] ? parseFloat(team2.gymnasts[i].final_score) || 0 : 0;\n        const diff = score1 - score2;\n        const diffStr = (score1 === 0 && score2 === 0) ? '--' : diff.toFixed(3);\n\n        const barWidth = Math.min(Math.abs(diff) * 25, 50);\n        let barClass = 'tie';\n        if (diff > 0.001) barClass = 'left';\n        else if (diff < -0.001) barClass = 'right';\n\n        diffRowsHtml += `\n          <div class=\"diff-row\">\n            <div class=\"diff-value\">${diffStr}</div>\n            <div class=\"diff-bar\">\n              <div class=\"diff-bar-fill ${barClass}\" style=\"width: ${barWidth}%;\"></div>\n            </div>\n          </div>\n        `;\n      }\n\n      const centerHtml = `\n        <div class=\"center-divider\">\n          <div class=\"center-header\"><div class=\"rotation-badge\">R${rotation}</div></div>\n          <div class=\"diff-list\">${diffRowsHtml}</div>\n        </div>\n      `;\n\n      // Calculate event total difference\n      const eventDiff = team1.eventScore - team2.eventScore;\n      const eventDiffStr = eventDiff.toFixed(3);\n      const eventBarWidth = Math.min(Math.abs(eventDiff) * 5, 50);\n      let eventBarClass = 'tie';\n      if (eventDiff > 0.001) eventBarClass = 'left';\n      else if (eventDiff < -0.001) eventBarClass = 'right';\n\n      // Build footer with event totals and icons\n      const footerHtml = `\n        <div class=\"event-summary-footer layout-dual-dynamic-v1-footer\">\n          <div class=\"footer-team left\">\n            <div class=\"event-abbr\">${team1.eventShortCode}</div>\n            ${EVENT_ICONS[team1.eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team1.eventScore > 0 ? team1.eventScore.toFixed(3) : '—'}</div>\n          </div>\n          <div class=\"footer-center\">\n            <div class=\"footer-diff\">${eventDiffStr}</div>\n            <div class=\"footer-diff-bar\">\n              <div class=\"footer-diff-fill ${eventBarClass}\" style=\"width: ${eventBarWidth}%;\"></div>\n            </div>\n          </div>\n          <div class=\"footer-team right\">\n            <div class=\"event-abbr\">${team2.eventShortCode}</div>\n            ${EVENT_ICONS[team2.eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team2.eventScore > 0 ? team2.eventScore.toFixed(3) : '—'}</div>\n          </div>\n        </div>\n      `;\n\n      contentEl.innerHTML = `\n        <div class=\"layout-dual-dynamic-v1\">\n          ${titleHtml}\n          <div class=\"main-content\">\n            ${leftColumn}\n            ${centerHtml}\n            ${rightColumn}\n          </div>\n        </div>\n        ${footerHtml}\n      `;\n    }\n\n    // Build a team column for Dual Dynamic V1 layout with dynamic sizing\n    function buildDualDynamicV1Column(teamData, side, maxAthletes, sizes) {\n      const { team, gymnasts, totalScore, eventShortCode } = teamData;\n\n      let athletesHtml = '';\n      for (let i = 0; i < maxAthletes; i++) {\n        const g = gymnasts[i];\n        if (g) {\n          const score = parseFloat(g.final_score) || 0;\n          const startValue = g.scores && g.scores.length > 0 ? parseFloat(g.scores[0].start) || 0 : 0;\n          const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n          const photoUrl = getAthleteHeadshot(g.first_name, g.last_name, g.headshot);\n          const isAnchor = i === 5;\n\n          athletesHtml += `\n            <div class=\"athlete-row\" style=\"padding: ${sizes.rowPadding}px 20px; gap: ${sizes.rowGap}px;\">\n              <div class=\"athlete-order${isAnchor ? ' anchor' : ''}\" style=\"width: ${sizes.orderSize}px; height: ${sizes.orderSize}px; font-size: ${sizes.orderFont}px;\">${i + 1}</div>\n              <img class=\"athlete-photo\" src=\"${photoUrl || ''}\" alt=\"\" style=\"width: ${sizes.photoSize}px; height: ${sizes.photoSize}px; ${!photoUrl ? 'display: none;' : ''}\" onerror=\"this.style.display='none'\">\n              <div class=\"athlete-info\">\n                <div class=\"athlete-name\" style=\"font-size: ${sizes.nameFont}px;\">${name}</div>\n              </div>\n              <div class=\"athlete-score-block\">\n                <div class=\"athlete-score\" style=\"font-size: ${sizes.scoreFont}px;\">${score > 0 ? score.toFixed(3) : 'On Eval'}</div>\n                ${startValue > 0 ? `<div class=\"athlete-start\" style=\"font-size: ${sizes.startFont}px;\">${startValue.toFixed(2)}</div>` : ''}\n              </div>\n            </div>\n          `;\n        } else {\n          athletesHtml += `<div class=\"athlete-row\" style=\"padding: ${sizes.rowPadding}px 20px;\"></div>`;\n        }\n      }\n\n      const logoUrl = getTeamLogoUrl(team.name, team.logo);\n      return `\n        <div class=\"team-column ${side}\">\n          <div class=\"team-header ${side}\">\n            ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n            <div class=\"team-name\">${team.name || team.tricode}</div>\n            <div class=\"team-total\">${totalScore > 0 ? totalScore.toFixed(3) : '0.000'}</div>\n          </div>\n          <div class=\"athlete-list\">\n            ${athletesHtml}\n          </div>\n        </div>\n      `;\n    }\n\n    // Dual Dynamic V1 Layout for Apparatus mode (same event for both teams)\n    function renderDualDynamicV1LayoutApparatus(contentEl, apparatusData, eventDisplayName, eventShortCode) {\n      const team1 = apparatusData[0];\n      const team2 = apparatusData[1];\n\n      const maxAthletes = Math.max(team1.gymnasts.length, team2.gymnasts.length);\n      const sizes = getDynamicSizes(maxAthletes);\n\n      // Get home team logo from Firebase or API (only show home team in title bar)\n      const team1Logo = getTeamLogoUrl(team1.team.name, team1.team.logo);\n\n      // Build title bar - EVENT SUMMARY on left, home team logo on right\n      const titleHtml = `\n        <div class=\"title-bar\">\n          <div class=\"title-text\">Event Summary</div>\n          ${team1Logo ? `<img class=\"title-logo\" src=\"${team1Logo}\" alt=\"\">` : ''}\n        </div>\n      `;\n\n      // Build left team column\n      const leftColumn = buildDualDynamicV1Column(team1, 'left', maxAthletes, sizes);\n      const rightColumn = buildDualDynamicV1Column(team2, 'right', maxAthletes, sizes);\n\n      // Build center divider with event name and visual diff bars\n      let diffRowsHtml = '';\n      for (let i = 0; i < maxAthletes; i++) {\n        const score1 = team1.gymnasts[i] ? parseFloat(team1.gymnasts[i].final_score) || 0 : 0;\n        const score2 = team2.gymnasts[i] ? parseFloat(team2.gymnasts[i].final_score) || 0 : 0;\n        const diff = score1 - score2;\n        const diffStr = (score1 === 0 && score2 === 0) ? '--' : diff.toFixed(3);\n\n        const barWidth = Math.min(Math.abs(diff) * 25, 50);\n        let barClass = 'tie';\n        if (diff > 0.001) barClass = 'left';\n        else if (diff < -0.001) barClass = 'right';\n\n        diffRowsHtml += `\n          <div class=\"diff-row\">\n            <div class=\"diff-value\">${diffStr}</div>\n            <div class=\"diff-bar\">\n              <div class=\"diff-bar-fill ${barClass}\" style=\"width: ${barWidth}%;\"></div>\n            </div>\n          </div>\n        `;\n      }\n\n      const centerHtml = `\n        <div class=\"center-divider\">\n          <div class=\"center-header\"><div class=\"rotation-badge\">${eventShortCode}</div></div>\n          <div class=\"diff-list\">${diffRowsHtml}</div>\n        </div>\n      `;\n\n      // Calculate event total difference\n      const eventDiff = team1.eventScore - team2.eventScore;\n      const eventDiffStr = eventDiff.toFixed(3);\n      const eventBarWidth = Math.min(Math.abs(eventDiff) * 5, 50);\n      let eventBarClass = 'tie';\n      if (eventDiff > 0.001) eventBarClass = 'left';\n      else if (eventDiff < -0.001) eventBarClass = 'right';\n\n      // Build footer with event totals and icons (same event for both teams)\n      const footerHtml = `\n        <div class=\"event-summary-footer layout-dual-dynamic-v1-footer\">\n          <div class=\"footer-team left\">\n            <div class=\"event-abbr\">${eventShortCode}</div>\n            ${EVENT_ICONS[eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team1.eventScore > 0 ? team1.eventScore.toFixed(3) : '—'}</div>\n          </div>\n          <div class=\"footer-center\">\n            <div class=\"footer-diff\">${eventDiffStr}</div>\n            <div class=\"footer-diff-bar\">\n              <div class=\"footer-diff-fill ${eventBarClass}\" style=\"width: ${eventBarWidth}%;\"></div>\n            </div>\n          </div>\n          <div class=\"footer-team right\">\n            <div class=\"event-abbr\">${eventShortCode}</div>\n            ${EVENT_ICONS[eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team2.eventScore > 0 ? team2.eventScore.toFixed(3) : '—'}</div>\n          </div>\n        </div>\n      `;\n\n      contentEl.innerHTML = `\n        <div class=\"layout-dual-dynamic-v1\">\n          ${titleHtml}\n          <div class=\"main-content\">\n            ${leftColumn}\n            ${centerHtml}\n            ${rightColumn}\n          </div>\n        </div>\n        ${footerHtml}\n      `;\n    }\n\n    // Graphic renderers\n    const renderers = {\n      clear: () => '',\n\n      logos: (data) => {\n        // Collect all team logos that exist (filter out empty/placeholder)\n        const logos = [];\n        for (let i = 1; i <= 7; i++) {\n          const logo = data[`team${i}Logo`];\n          if (logo && logo.trim() && !logo.includes('placeholder')) {\n            logos.push(logo);\n          }\n        }\n\n        // Use grid layout for 5+ teams, row for 2-4\n        const isGrid = logos.length >= 5;\n        const containerClass = isGrid ? 'graphic-logos graphic-logos-grid' : 'graphic-logos';\n\n        const logosHtml = logos.map((logo, i) =>\n          `<img class=\"team-logo\" src=\"${logo}\" alt=\"Team ${i + 1}\">`\n        ).join('');\n\n        return `<div class=\"graphic-container ${containerClass}\">${logosHtml}</div>`;\n      },\n\n      'event-bar': (data) => `\n        <div class=\"graphic-container graphic-event-bar\">\n          <div class=\"event-bar-logo\">\n            <img src=\"${getEventLevelLogo(data.team1Name, data.team1Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"event-bar-content\">\n            <div class=\"event-bar-venue\">${data.venue}</div>\n            <div class=\"event-bar-details\">\n              <div class=\"event-bar-name\">${data.eventName}</div>\n              <div class=\"event-bar-location\">${data.location}</div>\n            </div>\n          </div>\n        </div>\n      `,\n\n      hosts: (data) => `\n        <div class=\"graphic-container graphic-hosts\">\n          <div class=\"hosts-header\">\n            <div class=\"hosts-title\">HOSTS</div>\n          </div>\n          <div class=\"hosts-content\">\n            ${data.hosts.split('\\n').map(h => `<div class=\"hosts-name\">${h}</div>`).join('')}\n          </div>\n        </div>\n      `,\n\n      'team1-stats': (data) => `\n        <div class=\"graphic-container graphic-team-stats\">\n          <div class=\"stats-header\">\n            <div class=\"stats-team-name\">${data.team1Name}</div>\n            <img class=\"stats-logo\" src=\"${getTeamLogoUrl(data.team1Name, data.team1Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"stats-content\">\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">AVE</div>\n              <div class=\"stat-value\">${data.team1Ave}</div>\n            </div>\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">HIGH</div>\n              <div class=\"stat-value\">${data.team1High}</div>\n            </div>\n          </div>\n        </div>\n      `,\n\n      'team1-coaches': (data) => `\n        <div class=\"graphic-container graphic-coaches\">\n          <div class=\"coaches-header\">\n            <div class=\"coaches-title\">COACHES</div>\n            <img class=\"coaches-logo\" src=\"${getTeamLogoUrl(data.team1Name, data.team1Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"coaches-content\">\n            ${data.team1Coaches.split('\\n').map(c => `<div class=\"coach-name\">${c}</div>`).join('')}\n          </div>\n        </div>\n      `,\n\n      'team2-stats': (data) => `\n        <div class=\"graphic-container graphic-team-stats\">\n          <div class=\"stats-header\">\n            <div class=\"stats-team-name\">${data.team2Name}</div>\n            <img class=\"stats-logo\" src=\"${getTeamLogoUrl(data.team2Name, data.team2Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"stats-content\">\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">AVE</div>\n              <div class=\"stat-value\">${data.team2Ave}</div>\n            </div>\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">HIGH</div>\n              <div class=\"stat-value\">${data.team2High}</div>\n            </div>\n          </div>\n        </div>\n      `,\n\n      'team2-coaches': (data) => `\n        <div class=\"graphic-container graphic-coaches\">\n          <div class=\"coaches-header\">\n            <div class=\"coaches-title\">COACHES</div>\n            <img class=\"coaches-logo\" src=\"${getTeamLogoUrl(data.team2Name, data.team2Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"coaches-content\">\n            ${data.team2Coaches.split('\\n').map(c => `<div class=\"coach-name\">${c}</div>`).join('')}\n          </div>\n        </div>\n      `,\n\n      'team3-stats': (data) => `\n        <div class=\"graphic-container graphic-team-stats\">\n          <div class=\"stats-header\">\n            <div class=\"stats-team-name\">${data.team3Name}</div>\n            <img class=\"stats-logo\" src=\"${getTeamLogoUrl(data.team3Name, data.team3Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"stats-content\">\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">AVE</div>\n              <div class=\"stat-value\">${data.team3Ave}</div>\n            </div>\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">HIGH</div>\n              <div class=\"stat-value\">${data.team3High}</div>\n            </div>\n          </div>\n        </div>\n      `,\n\n      'team3-coaches': (data) => `\n        <div class=\"graphic-container graphic-coaches\">\n          <div class=\"coaches-header\">\n            <div class=\"coaches-title\">COACHES</div>\n            <img class=\"coaches-logo\" src=\"${getTeamLogoUrl(data.team3Name, data.team3Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"coaches-content\">\n            ${data.team3Coaches.split('\\n').map(c => `<div class=\"coach-name\">${c}</div>`).join('')}\n          </div>\n        </div>\n      `,\n\n      'team4-stats': (data) => `\n        <div class=\"graphic-container graphic-team-stats\">\n          <div class=\"stats-header\">\n            <div class=\"stats-team-name\">${data.team4Name}</div>\n            <img class=\"stats-logo\" src=\"${getTeamLogoUrl(data.team4Name, data.team4Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"stats-content\">\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">AVE</div>\n              <div class=\"stat-value\">${data.team4Ave}</div>\n            </div>\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">HIGH</div>\n              <div class=\"stat-value\">${data.team4High}</div>\n            </div>\n          </div>\n        </div>\n      `,\n\n      'team4-coaches': (data) => `\n        <div class=\"graphic-container graphic-coaches\">\n          <div class=\"coaches-header\">\n            <div class=\"coaches-title\">COACHES</div>\n            <img class=\"coaches-logo\" src=\"${getTeamLogoUrl(data.team4Name, data.team4Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"coaches-content\">\n            ${data.team4Coaches.split('\\n').map(c => `<div class=\"coach-name\">${c}</div>`).join('')}\n          </div>\n        </div>\n      `,\n\n      'team5-stats': (data) => `\n        <div class=\"graphic-container graphic-team-stats\">\n          <div class=\"stats-header\">\n            <div class=\"stats-team-name\">${data.team5Name}</div>\n            <img class=\"stats-logo\" src=\"${getTeamLogoUrl(data.team5Name, data.team5Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"stats-content\">\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">AVE</div>\n              <div class=\"stat-value\">${data.team5Ave}</div>\n            </div>\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">HIGH</div>\n              <div class=\"stat-value\">${data.team5High}</div>\n            </div>\n          </div>\n        </div>\n      `,\n\n      'team5-coaches': (data) => `\n        <div class=\"graphic-container graphic-coaches\">\n          <div class=\"coaches-header\">\n            <div class=\"coaches-title\">COACHES</div>\n            <img class=\"coaches-logo\" src=\"${getTeamLogoUrl(data.team5Name, data.team5Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"coaches-content\">\n            ${data.team5Coaches.split('\\n').map(c => `<div class=\"coach-name\">${c}</div>`).join('')}\n          </div>\n        </div>\n      `,\n\n      'team6-stats': (data) => `\n        <div class=\"graphic-container graphic-team-stats\">\n          <div class=\"stats-header\">\n            <div class=\"stats-team-name\">${data.team6Name}</div>\n            <img class=\"stats-logo\" src=\"${getTeamLogoUrl(data.team6Name, data.team6Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"stats-content\">\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">AVE</div>\n              <div class=\"stat-value\">${data.team6Ave}</div>\n            </div>\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">HIGH</div>\n              <div class=\"stat-value\">${data.team6High}</div>\n            </div>\n          </div>\n        </div>\n      `,\n\n      'team6-coaches': (data) => `\n        <div class=\"graphic-container graphic-coaches\">\n          <div class=\"coaches-header\">\n            <div class=\"coaches-title\">COACHES</div>\n            <img class=\"coaches-logo\" src=\"${getTeamLogoUrl(data.team6Name, data.team6Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"coaches-content\">\n            ${data.team6Coaches.split('\\n').map(c => `<div class=\"coach-name\">${c}</div>`).join('')}\n          </div>\n        </div>\n      `,\n\n      'team7-stats': (data) => `\n        <div class=\"graphic-container graphic-team-stats\">\n          <div class=\"stats-header\">\n            <div class=\"stats-team-name\">${data.team7Name}</div>\n            <img class=\"stats-logo\" src=\"${getTeamLogoUrl(data.team7Name, data.team7Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"stats-content\">\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">AVE</div>\n              <div class=\"stat-value\">${data.team7Ave}</div>\n            </div>\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">HIGH</div>\n              <div class=\"stat-value\">${data.team7High}</div>\n            </div>\n          </div>\n        </div>\n      `,\n\n      'team7-coaches': (data) => `\n        <div class=\"graphic-container graphic-coaches\">\n          <div class=\"coaches-header\">\n            <div class=\"coaches-title\">COACHES</div>\n            <img class=\"coaches-logo\" src=\"${getTeamLogoUrl(data.team7Name, data.team7Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"coaches-content\">\n            ${data.team7Coaches.split('\\n').map(c => `<div class=\"coach-name\">${c}</div>`).join('')}\n          </div>\n        </div>\n      `,\n\n      // Dynamic team-coaches renderer - uses teamSlot parameter to select team data\n      'team-coaches': (data) => {\n        const slot = data.teamSlot || 1;\n        const name = data[`team${slot}Name`] || '';\n        const logo = data[`team${slot}Logo`] || '';\n        const coaches = data[`team${slot}Coaches`] || '';\n        return `\n        <div class=\"graphic-container graphic-coaches\">\n          <div class=\"coaches-header\">\n            <div class=\"coaches-title\">COACHES</div>\n            <img class=\"coaches-logo\" src=\"${getTeamLogoUrl(name, logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"coaches-content\">\n            ${coaches ? coaches.split('\\n').map(c => `<div class=\"coach-name\">${c}</div>`).join('') : '<div class=\"coach-name\">No coaches defined</div>'}\n          </div>\n        </div>\n      `;\n      },\n\n      // Dynamic team-stats renderer - uses teamSlot parameter to select team data\n      'team-stats': (data) => {\n        const slot = data.teamSlot || 1;\n        const name = data[`team${slot}Name`] || '';\n        const logo = data[`team${slot}Logo`] || '';\n        const ave = data[`team${slot}Ave`] || '';\n        const high = data[`team${slot}High`] || '';\n        return `\n        <div class=\"graphic-container graphic-team-stats\">\n          <div class=\"stats-header\">\n            <div class=\"stats-team-name\">${name}</div>\n            <img class=\"stats-logo\" src=\"${getTeamLogoUrl(name, logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"stats-content\">\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">AVE</div>\n              <div class=\"stat-value\">${ave}</div>\n            </div>\n            <div class=\"stat-item\">\n              <div class=\"stat-label\">HIGH</div>\n              <div class=\"stat-value\">${high}</div>\n            </div>\n          </div>\n        </div>\n      `;\n      },\n\n      'event-frame': (data) => `\n        <div class=\"graphic-container graphic-event-frame\">\n          <div class=\"frame-header\">\n            <div class=\"frame-title\">${data.frameTitle}</div>\n            <img class=\"frame-logo\" id=\"event-frame-logo\" src=\"${getEventLevelLogo(data.team1Name, data.team1Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"frame-content\"></div>\n        </div>\n      `,\n\n      'stream-starting': (data) => `\n        <div class=\"graphic-container graphic-stream\">\n          <div class=\"stream-title\">STREAM STARTING SOON</div>\n          <img class=\"stream-logo\" id=\"stream-logo\" src=\"${getEventLevelLogo(data.team1Name, data.team1Logo)}\" alt=\"Team\">\n          <div class=\"stream-event-name\">${data.eventName}</div>\n          <div class=\"stream-date\">${data.meetDate}</div>\n          <div class=\"stream-branding\"><span>V</span>irtius</div>\n        </div>\n      `,\n\n      'stream-thanks': (data) => `\n        <div class=\"graphic-container graphic-stream\">\n          <div class=\"stream-title\">THANKS FOR WATCHING</div>\n          <img class=\"stream-logo\" id=\"stream-logo\" src=\"${getEventLevelLogo(data.team1Name, data.team1Logo)}\" alt=\"Team\">\n          <div class=\"stream-event-name\">${data.eventName}</div>\n          <div class=\"stream-date\">${data.meetDate}</div>\n          <div class=\"stream-branding\"><span>V</span>irtius</div>\n        </div>\n      `,\n\n      // Sponsor Graphics - load overlay files in iframe\n      'sponsors-thanks': (data) => {\n        const logo = encodeURIComponent(getTeamLogoUrl(data.team1Name, data.team1Logo) || '');\n        const sponsors = encodeURIComponent(data.sponsors || '[]');\n        const overlayUrl = `/overlays/sponsors-thanks.html?logo=${logo}&sponsors=${sponsors}`;\n        return `<iframe src=\"${overlayUrl}\" style=\"width: 1920px; height: 1080px; border: none; overflow: hidden;\"></iframe>`;\n      },\n\n      'sponsors-cycle': (data) => {\n        const logo = encodeURIComponent(getTeamLogoUrl(data.team1Name, data.team1Logo) || '');\n        const sponsors = encodeURIComponent(data.sponsors || '[]');\n        const overlayUrl = `/overlays/sponsors-cycle.html?logo=${logo}&sponsors=${sponsors}`;\n        return `<iframe src=\"${overlayUrl}\" style=\"width: 1920px; height: 1080px; border: none; overflow: hidden;\"></iframe>`;\n      },\n\n      'sponsors-bug': (data) => {\n        const sponsors = encodeURIComponent(data.sponsors || '[]');\n        const overlayUrl = `/overlays/sponsors-bug.html?sponsors=${sponsors}`;\n        return `<iframe src=\"${overlayUrl}\" style=\"width: 1920px; height: 1080px; border: none; overflow: hidden;\"></iframe>`;\n      },\n\n      // Frame Overlays for OBS\n      'frame-quad': () => `\n        <div class=\"graphic-frame-overlay frame-quad\">\n          <div class=\"frame-overlay-container\">\n            <div class=\"frame-panel\"></div>\n            <div class=\"frame-panel\"></div>\n            <div class=\"frame-panel\"></div>\n            <div class=\"frame-panel\"></div>\n          </div>\n          <div class=\"frame-watermark\"><span class=\"v\">V</span>irtius</div>\n        </div>\n      `,\n\n      'frame-tri-center': () => `\n        <div class=\"graphic-frame-overlay frame-tri-center\">\n          <div class=\"frame-overlay-container\">\n            <div class=\"top-row\">\n              <div class=\"frame-panel\"></div>\n              <div class=\"frame-panel\"></div>\n            </div>\n            <div class=\"bottom-row\">\n              <div class=\"frame-panel\"></div>\n            </div>\n          </div>\n          <div class=\"frame-watermark\"><span class=\"v\">V</span>irtius</div>\n        </div>\n      `,\n\n      'frame-tri-wide': () => `\n        <div class=\"graphic-frame-overlay frame-tri-wide\">\n          <div class=\"frame-overlay-container\">\n            <div class=\"top-row\">\n              <div class=\"frame-panel\"></div>\n              <div class=\"frame-panel\"></div>\n            </div>\n            <div class=\"frame-panel\"></div>\n          </div>\n          <div class=\"frame-watermark\"><span class=\"v\">V</span>irtius</div>\n        </div>\n      `,\n\n      'frame-single': () => `\n        <div class=\"graphic-frame-overlay frame-single\">\n          <div class=\"frame-overlay-container\">\n            <div class=\"frame-panel\"></div>\n          </div>\n          <div class=\"frame-watermark\"><span class=\"v\">V</span>irtius</div>\n        </div>\n      `,\n\n      'frame-team-header': (data) => {\n        // Collect all team logos that exist\n        const logos = [];\n        for (let i = 1; i <= 7; i++) {\n          const logo = data[`team${i}Logo`];\n          if (logo && logo.trim() && !logo.includes('placeholder')) {\n            logos.push(logo);\n          }\n        }\n        const logosHtml = logos.map((logo, i) =>\n          `<img class=\"team-logo\" src=\"${logo}\" alt=\"Team ${i + 1}\">`\n        ).join('');\n\n        return `\n          <div class=\"graphic-frame-overlay frame-team-header\">\n            <div class=\"header-row\">${logosHtml}</div>\n            <div class=\"frame-overlay-container\">\n              <div class=\"frame-panel\"></div>\n              <div class=\"frame-panel\"></div>\n            </div>\n            <div class=\"frame-watermark\"><span class=\"v\">V</span>irtius</div>\n          </div>\n        `;\n      },\n\n      'warm-up': (data) => {\n        const teamsText = data.eventName || (data.team1Name && data.team2Name\n          ? `${data.team1Name.toUpperCase()} VS ${data.team2Name.toUpperCase()}`\n          : 'WARM UP');\n        return `\n          <div class=\"graphic-container graphic-warm-up\">\n            <div class=\"warm-up-logo-section\">\n              <img src=\"${getEventLevelLogo(data.team1Name, data.team1Logo)}\" alt=\"Team\">\n            </div>\n            <div class=\"warm-up-content-section\">\n              <div class=\"warm-up-teams-row\">\n                <div class=\"warm-up-teams-text\">${teamsText}</div>\n              </div>\n              <div class=\"warm-up-status-row\">\n                <div class=\"warm-up-status-text\">WARM UP</div>\n              </div>\n            </div>\n          </div>\n        `;\n      },\n\n      'replay': (data) => `\n        <div class=\"graphic-container graphic-replay\">\n          <div class=\"replay-logo-section\">\n            <img src=\"${getEventLevelLogo(data.team1Name, data.team1Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"replay-content-section\">\n            <div class=\"replay-title-row\">\n              <div class=\"replay-title-text\">INSTANT REPLAY</div>\n            </div>\n            <div class=\"replay-status-row\">\n              <div class=\"replay-status-text\">REPLAY</div>\n            </div>\n          </div>\n        </div>\n      `,\n\n      'now-competing': (data) => `\n        <div class=\"graphic-container graphic-now-competing\">\n          <div class=\"now-competing-status\">\n            <div class=\"now-competing-status-dot\"></div>\n            <div class=\"now-competing-status-text\">Live</div>\n          </div>\n          <div class=\"now-competing-logo\">\n            <img src=\"${data.athleteLogo || getTeamLogoUrl(data.team1Name, data.team1Logo)}\" alt=\"Team\">\n          </div>\n          <div class=\"now-competing-content\">\n            <div class=\"now-competing-event\">${data.athleteEvent || 'Floor Exercise'}</div>\n            <div class=\"now-competing-details\">\n              <div class=\"now-competing-name\">${data.athleteName || 'Athlete Name'}</div>\n              <div class=\"now-competing-team\">${data.athleteTeam || 'Team'}</div>\n            </div>\n          </div>\n        </div>\n      `,\n\n      'event-summary': (data) => {\n        const sessionId = data.virtiusSessionId;\n        const mode = data.summaryMode || 'rotation';\n        const rotation = data.summaryRotation || 1;\n        const apparatus = data.summaryApparatus || 'fx';\n        const numTeams = data.summaryNumTeams || 2;\n        const competitionFormat = data.summaryFormat || 'head-to-head';\n        const gender = data.summaryGender || 'mens'; // Gender for correct event order\n        const hostLogo = getTeamLogoUrl(data.team1Name, data.team1Logo);\n        const theme = data.summaryTheme || 'default';\n\n        // Get team colors for dynamic themes\n        const team1Colors = getTeamColors(data.team1Name);\n        const team2Colors = getTeamColors(data.team2Name);\n\n        if (!sessionId) {\n          return '<div style=\"color: red; padding: 100px; font-size: 36px;\">No Virtius Session ID configured for this competition</div>';\n        }\n\n        // Determine if this is a layout theme (starts with 'layout-') or a color theme\n        const isLayoutTheme = theme.startsWith('layout-');\n        const layout = isLayoutTheme ? theme.replace('layout-', '') : 'default';\n\n        // Fetch and render after initial paint\n        if (mode === 'apparatus') {\n          setTimeout(() => fetchAndRenderEventSummaryByApparatus(sessionId, apparatus, numTeams, competitionFormat, layout, gender), 100);\n        } else {\n          setTimeout(() => fetchAndRenderEventSummary(sessionId, rotation, numTeams, competitionFormat, layout, gender), 100);\n        }\n\n        const logoHtml = hostLogo && hostLogo.trim() && !hostLogo.includes('placeholder')\n          ? `<img class=\"event-summary-header-logo\" src=\"${hostLogo}\" alt=\"\">`\n          : '';\n\n        const loadingText = mode === 'apparatus'\n          ? `Loading ${apparatus.toUpperCase()}...`\n          : `Loading rotation ${rotation}...`;\n\n        // Build theme class and CSS variables for team colors\n        // Only apply color theme class if not using a layout theme\n        const themeClass = (!isLayoutTheme && theme !== 'default') ? `theme-${theme}` : '';\n        const teamColorVars = `--home-primary: ${team1Colors.primary}; --home-secondary: ${team1Colors.secondary}; --home-bg: ${team1Colors.bg}; --away-primary: ${team2Colors.primary}; --away-secondary: ${team2Colors.secondary};`;\n\n        // For layout themes, don't show the standard header\n        if (isLayoutTheme) {\n          return `\n            <div class=\"graphic-container graphic-event-summary\" style=\"${teamColorVars}\">\n              <div class=\"event-summary-content\" id=\"event-summary-content\" style=\"flex: 1;\">\n                <div class=\"event-summary-loading\">${loadingText}</div>\n              </div>\n            </div>\n          `;\n        }\n\n        return `\n          <div class=\"graphic-container graphic-event-summary ${themeClass}\" style=\"${teamColorVars}\">\n            <div class=\"event-summary-header\">\n              <div class=\"event-summary-title\">EVENT SUMMARY</div>\n              ${logoHtml}\n            </div>\n            <div class=\"event-summary-content\" id=\"event-summary-content\">\n              <div class=\"event-summary-loading\">${loadingText}</div>\n            </div>\n          </div>\n        `;\n      },\n\n      'virtius-leaderboard': (data) => {\n        const sessionId = data.virtiusSessionId;\n        const event = data.leaderboardEvent || 'aa';\n        if (!sessionId) {\n          return '<div style=\"color: red; padding: 100px; font-size: 36px;\">No Virtius Session ID configured for this competition</div>';\n        }\n\n        // Map event codes to display titles and API event names\n        // Includes both men's and women's events\n        const eventTitles = {\n          // Men's events\n          'fx': 'FLOOR EXERCISE',\n          'ph': 'POMMEL HORSE',\n          'sr': 'STILL RINGS',\n          'vt': 'VAULT',\n          'pb': 'PARALLEL BARS',\n          'hb': 'HORIZONTAL BAR',\n          // Women's events\n          'ub': 'UNEVEN BARS',\n          'bb': 'BALANCE BEAM',\n          // All-around\n          'aa': 'ALL AROUND'\n        };\n        const eventApiNames = {\n          // Men's events\n          'fx': 'FLOOR',\n          'ph': 'HORSE',\n          'sr': 'RINGS',\n          'vt': 'VAULT',\n          'pb': 'PBARS',\n          'hb': 'BAR',\n          // Women's events\n          'ub': 'BARS',\n          'bb': 'BEAM',\n          // All-around\n          'aa': 'All Around'\n        };\n        const eventShortCodes = {\n          // Men's events\n          'fx': 'FX',\n          'ph': 'PH',\n          'sr': 'SR',\n          'vt': 'VT',\n          'pb': 'PB',\n          'hb': 'HB',\n          // Women's events\n          'ub': 'UB',\n          'bb': 'BB',\n          // All-around\n          'aa': 'AA'\n        };\n        const title = eventTitles[event] || event.toUpperCase();\n        const apiEventName = eventApiNames[event] || event;\n        const shortCode = eventShortCodes[event] || event.toUpperCase();\n        const gender = data.leaderboardGender || 'mens'; // Women don't have Exec/SB columns\n\n        // Return loading state initially, then fetch and update\n        setTimeout(() => fetchAndRenderLeaderboard(sessionId, apiEventName, shortCode, gender), 100);\n\n        // Use event-level logo (meet logo when theme active, else team logo)\n        const resolvedLogo = getEventLevelLogo(data.team1Name, data.team1Logo);\n        const logoHtml = resolvedLogo\n          ? `<img class=\"frame-logo\" id=\"leaderboard-logo\" src=\"${resolvedLogo}\" alt=\"\">`\n          : '';\n\n        // Setup observer to update logo if theme loads later (theme loads async)\n        setTimeout(() => {\n          const observer = new MutationObserver(() => {\n            const newMeetLogo = document.body.getAttribute('data-meet-logo');\n            const logoEl = document.getElementById('leaderboard-logo');\n            if (newMeetLogo && logoEl) {\n              logoEl.src = newMeetLogo;\n            }\n          });\n          observer.observe(document.body, { attributes: true, attributeFilter: ['data-meet-logo'] });\n        }, 100);\n\n        return `\n          <div class=\"graphic-container graphic-virtius-leaderboard\">\n            <div class=\"frame-header\">\n              <div class=\"frame-title\">${title}</div>\n              ${logoHtml}\n            </div>\n            <div class=\"frame-content\" id=\"leaderboard-content\">\n              <div class=\"leaderboard-loading\">Loading leaderboard...</div>\n            </div>\n          </div>\n        `;\n      },\n\n      'team-roster': (data) => {\n        // Extract team slot from graphicId (e.g., \"team1-roster\" -> 1)\n        const teamSlotMatch = data.graphicId?.match(/^team(\\d+)-roster$/);\n        const teamSlot = teamSlotMatch ? teamSlotMatch[1] : '1';\n\n        // Get team info\n        const teamName = data[`team${teamSlot}Name`] || `Team ${teamSlot}`;\n        const teamLogo = data[`team${teamSlot}Logo`] || '';\n\n        // Build iframe URL - use compId from data or competition context\n        const activeMeetTheme = document.body.getAttribute('data-meet-theme') || '';\n        const rosterUrl = `/overlays/team-roster.html?compId=${encodeURIComponent(competitionId)}&teamSlot=${teamSlot}${activeMeetTheme ? `&meetTheme=${encodeURIComponent(activeMeetTheme)}` : ''}`;\n\n        return `\n          <div class=\"graphic-container\" style=\"width: 100%; height: 100%; background: transparent;\">\n            <iframe\n              src=\"${rosterUrl}\"\n              style=\"width: 100%; height: 100%; border: none; background: transparent;\"\n              allowtransparency=\"true\"\n            ></iframe>\n          </div>\n        `;\n      }\n    };\n\n    // Check for URL-based graphic parameter (for URL Generator preview)\n    const urlGraphic = urlParams.get('graphic');\n    const isUrlPreviewMode = !!urlGraphic; // If URL has graphic param, we're in