];\n        const rowEl = document.querySelector(`.team-row[data-team-index=\"${team.index}\"]`);\n        if (!rowEl) return;\n\n        const onBye = isTeamOnBye(apiTeam, currentRotation);\n\n        if (onBye) {\n          rowEl.classList.add('on-bye');\n          // Show BYE indicator in slot if no active flash\n          if (!state.activeFlashes[team.index]) {\n            const slotContent = document.getElementById(`slotContent${team.index}`);\n            if (slotContent && !slotContent.innerHTML.includes('bye-indicator')) {\n              slotContent.innerHTML = '<span class=\"bye-indicator\">BYE</span>';\n              slotContent.classList.add('visible');\n            }\n          }\n        } else {\n          rowEl.classList.remove('on-bye');\n          // Clear BYE indicator if it was showing\n          const slotContent = document.getElementById(`slotContent${team.index}`);\n          if (slotContent && slotContent.innerHTML.includes('bye-indicator')) {\n            slotContent.innerHTML = '';\n            slotContent.classList.remove('visible');\n          }\n        }\n      });\n    }\n\n    /**\n     * Detect current rotation from API data using ALL teams."},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":490,"cache_read_input_tokens":69473,"cache_creation":{"ephemeral_5m_input_tokens":490,"ephemeral_1h_input_tokens":0},"output_tokens":908,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"5b031880-c959-4e00-9afb-faf8081cc469","uuid":"6b37f568-30d7-408d-b4f3-789c068abc37"}
