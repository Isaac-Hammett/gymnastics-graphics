es();\n      }","originalFile":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=1920, height=1080\">\n  <title>Team Score Bug</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n\n  <!-- Firebase SDK -->\n  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js\"></script>\n  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js\"></script>\n\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n\n    body {\n      font-family: 'Inter', sans-serif;\n      width: 1920px;\n      height: 1080px;\n      overflow: hidden;\n      background: transparent;\n    }\n\n    /* Score bug container - positioned on right side of screen */\n    .score-bug {\n      position: absolute;\n      top: 50%;\n      right: 0;\n      transform: translateY(-50%) translateX(100%);\n      display: flex;\n      flex-direction: column;\n      min-width: 500px;\n      opacity: 0;\n      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n\n    .score-bug.visible {\n      transform: translateY(-50%) translateX(0);\n      opacity: 1;\n    }\n\n    /* Rotation tag at top */\n    .rotation-tag {\n      background: #27272a;\n      color: #fff;\n      font-size: 20px;\n      font-weight: 700;\n      padding: 10px 20px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n\n    /* Team rows container */\n    .team-rows {\n      display: flex;\n      flex-direction: column;\n    }\n\n    /* Individual team row */\n    .team-row {\n      display: flex;\n      flex-direction: row;\n      background: #1a1a1a;\n      border-bottom: 1px solid #333;\n      min-height: 70px;\n    }\n\n    .team-row:last-child {\n      border-bottom: none;\n    }\n\n    /* Multi-team scaling: 3 teams - slightly compact */\n    .teams-3 .team-row {\n      min-height: 65px;\n    }\n\n    /* Multi-team scaling: 4 teams - compact */\n    .teams-4 .team-row {\n      min-height: 60px;\n    }\n    .teams-4 .team-logo {\n      width: 36px;\n      height: 36px;\n    }\n    .teams-4 .team-total {\n      font-size: 20px;\n    }\n    .teams-4 .slot-headshot {\n      width: 32px;\n      height: 32px;\n    }\n    .teams-4 .slot-name {\n      font-size: 22px;\n    }\n    .teams-4 .slot-score {\n      font-size: 26px;\n    }\n\n    /* Multi-team scaling: 5 teams - more compact */\n    .teams-5 .team-row {\n      min-height: 55px;\n    }\n    .teams-5 .team-fixed {\n      padding: 8px 12px;\n      min-width: 90px;\n    }\n    .teams-5 .team-logo {\n      width: 32px;\n      height: 32px;\n    }\n    .teams-5 .team-total {\n      font-size: 18px;\n      margin-top: 2px;\n    }\n    .teams-5 .slot-headshot {\n      width: 28px;\n      height: 28px;\n    }\n    .teams-5 .slot-name {\n      font-size: 20px;\n    }\n    .teams-5 .slot-score {\n      font-size: 24px;\n    }\n    .teams-5 .slot-apparatus {\n      font-size: 16px;\n    }\n    .teams-5 .team-slot {\n      padding: 8px 16px;\n    }\n\n    /* Multi-team scaling: 6 teams - most compact */\n    .teams-6 .team-row {\n      min-height: 50px;\n    }\n    .teams-6 .team-fixed {\n      padding: 6px 10px;\n      min-width: 85px;\n    }\n    .teams-6 .team-logo {\n      width: 28px;\n      height: 28px;\n    }\n    .teams-6 .team-total {\n      font-size: 16px;\n      margin-top: 2px;\n    }\n    .teams-6 .slot-headshot {\n      width: 24px;\n      height: 24px;\n    }\n    .teams-6 .slot-name {\n      font-size: 18px;\n    }\n    .teams-6 .slot-score {\n      font-size: 22px;\n    }\n    .teams-6 .slot-apparatus {\n      font-size: 14px;\n    }\n    .teams-6 .slot-sv {\n      font-size: 14px;\n    }\n    .teams-6 .team-slot {\n      padding: 6px 14px;\n    }\n    .teams-6 .rotation-tag {\n      font-size: 18px;\n      padding: 8px 16px;\n    }\n\n    /* Multi-team scaling: 7 teams - ultra compact */\n    .teams-7 .team-row {\n      min-height: 44px;\n    }\n    .teams-7 .team-fixed {\n      padding: 4px 8px;\n      min-width: 80px;\n    }\n    .teams-7 .team-logo {\n      width: 24px;\n      height: 24px;\n    }\n    .teams-7 .team-total {\n      font-size: 14px;\n      margin-top: 1px;\n    }\n    .teams-7 .slot-headshot {\n      width: 22px;\n      height: 22px;\n    }\n    .teams-7 .slot-name {\n      font-size: 16px;\n    }\n    .teams-7 .slot-score {\n      font-size: 20px;\n    }\n    .teams-7 .slot-apparatus {\n      font-size: 12px;\n    }\n    .teams-7 .slot-sv {\n      font-size: 12px;\n    }\n    .teams-7 .team-slot {\n      padding: 4px 12px;\n    }\n    .teams-7 .rotation-tag {\n      font-size: 16px;\n      padding: 6px 14px;\n    }\n\n    /* BYE state styling (BUG-009) */\n    .team-row.on-bye {\n      opacity: 0.4;\n      filter: grayscale(50%);\n    }\n\n    .team-row.on-bye .team-total {\n      color: #71717a;\n    }\n\n    .team-row.on-bye .slot-content {\n      color: #71717a;\n    }\n\n    .bye-indicator {\n      font-size: 16px;\n      font-weight: 600;\n      color: #71717a;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n    }\n\n    /* Fixed left section: logo + total */\n    .team-fixed {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 10px 15px;\n      min-width: 100px;\n      background: #000;\n    }\n\n    .team-logo {\n      width: 40px;\n      height: 40px;\n      object-fit: contain;\n    }\n\n    .team-total {\n      font-size: 22px;\n      font-weight: 900;\n      color: #fff;\n      margin-top: 4px;\n    }\n\n    .team-total.highlight {\n      animation: totalPulse 0.5s ease;\n    }\n\n    @keyframes totalPulse {\n      0%, 100% { transform: scale(1); color: #fff; }\n      50% { transform: scale(1.1); color: #22d3ee; }\n    }\n\n    /* Slot area for score flash / now competing */\n    .team-slot {\n      flex: 1;\n      display: flex;\n      align-items: center;\n      padding: 10px 20px;\n      overflow: hidden;\n      position: relative;\n    }\n\n    /* Slot content (animates up/down) */\n    .slot-content {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      transform: translateY(0);\n      transition: transform 0.4s ease, opacity 0.4s ease;\n      opacity: 0;\n    }\n\n    .slot-content.visible {\n      opacity: 1;\n    }\n\n    .slot-content.exit-up {\n      transform: translateY(-100%);\n      opacity: 0;\n    }\n\n    .slot-content.enter-from-below {\n      transform: translateY(100%);\n      opacity: 0;\n    }\n\n    /* Slot machine animation - new content spins up from below */\n    @keyframes slotSpinIn {\n      0% {\n        transform: translateY(100%);\n        opacity: 0;\n      }\n      20% {\n        opacity: 1;\n      }\n      100% {\n        transform: translateY(0);\n        opacity: 1;\n      }\n    }\n\n    /* Slot machine animation - old content spins up and out */\n    @keyframes slotSpinOut {\n      0% {\n        transform: translateY(0);\n        opacity: 1;\n      }\n      80% {\n        opacity: 0;\n      }\n      100% {\n        transform: translateY(-100%);\n        opacity: 0;\n      }\n    }\n\n    .slot-content.spin-in {\n      animation: slotSpinIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n    }\n\n    .slot-content.spin-out {\n      animation: slotSpinOut 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n    }\n\n    /* Headshot in slot */\n    .slot-headshot {\n      width: 36px;\n      height: 36px;\n      border-radius: 50%;\n      object-fit: cover;\n      flex-shrink: 0;\n    }\n\n    /* Athlete name in slot */\n    .slot-name {\n      font-size: 24px;\n      font-weight: 700;\n      color: #fff;\n      white-space: nowrap;\n    }\n\n    /* Score in slot */\n    .slot-score {\n      font-size: 28px;\n      font-weight: 900;\n      color: #fff;\n    }\n\n    /* Apparatus code */\n    .slot-apparatus {\n      font-size: 18px;\n      font-weight: 600;\n      color: #a1a1aa;\n      text-transform: uppercase;\n    }\n\n    /* Start value */\n    .slot-sv {\n      font-size: 16px;\n      font-weight: 400;\n      color: #71717a;\n    }\n\n    /* Stick indicator */\n    .slot-stick {\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      background: #22c55e;\n      color: #fff;\n      font-size: 14px;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    /* Separator dot */\n    .slot-separator {\n      color: #52525b;\n      font-size: 20px;\n    }\n\n    /* Correction indicator (score was changed) */\n    .slot-correction {\n      font-size: 14px;\n      font-weight: 500;\n      color: #f59e0b;\n      font-style: italic;\n    }\n\n    /* Stick indicator (bonus landing - men's only) */\n    .slot-stick {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      background: linear-gradient(135deg, #10b981 0%, #059669 100%);\n      color: white;\n      font-size: 12px;\n      font-weight: 700;\n      padding: 2px 8px;\n      border-radius: 4px;\n      margin-left: 8px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n      box-shadow: 0 2px 4px rgba(16, 185, 129, 0.3);\n    }\n\n    /* Lineup card (above bug) */\n    .lineup-card {\n      position: absolute;\n      bottom: 100%;\n      right: 0;\n      width: 100%;\n      background: #1a1a1a;\n      transform: translateY(100%);\n      opacity: 0;\n      transition: transform 0.4s ease, opacity 0.4s ease;\n      margin-bottom: 8px;\n    }\n\n    .lineup-card.visible {\n      transform: translateY(0);\n      opacity: 1;\n    }\n\n    .lineup-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 20px;\n      background: #27272a;\n    }\n\n    .lineup-team-name {\n      font-size: 22px;\n      font-weight: 800;\n      color: #fff;\n      text-transform: uppercase;\n    }\n\n    .lineup-logo {\n      width: 32px;\n      height: 32px;\n      object-fit: contain;\n    }\n\n    .lineup-athletes {\n      padding: 8px 0;\n    }\n\n    .lineup-athlete {\n      display: flex;\n      align-items: center;\n      padding: 8px 20px;\n      gap: 12px;\n    }\n\n    .lineup-order {\n      font-size: 16px;\n      font-weight: 600;\n      color: #71717a;\n      min-width: 24px;\n    }\n\n    .lineup-name {\n      flex: 1;\n      font-size: 20px;\n      font-weight: 600;\n      color: #fff;\n    }\n\n    .lineup-sv {\n      font-size: 16px;\n      font-weight: 400;\n      color: #71717a;\n      min-width: 40px;\n      text-align: right;\n    }\n\n    .lineup-score {\n      font-size: 22px;\n      font-weight: 700;\n      color: #fff;\n      min-width: 70px;\n      text-align: right;\n    }\n\n    .lineup-score.pending {\n      color: #52525b;\n    }\n\n    .lineup-footer {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 20px;\n      background: #27272a;\n    }\n\n    .lineup-event {\n      font-size: 18px;\n      font-weight: 600;\n      color: #a1a1aa;\n      text-transform: uppercase;\n    }\n\n    .lineup-total {\n      font-size: 26px;\n      font-weight: 800;\n      color: #fff;\n    }\n\n    /* Loading / error states */\n    .loading-state {\n      color: #71717a;\n      font-size: 18px;\n      padding: 20px;\n      text-align: center;\n    }\n\n    .error-state {\n      color: #ef4444;\n      font-size: 18px;\n      padding: 20px;\n      text-align: center;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"score-bug\" id=\"scoreBug\">\n    <div class=\"lineup-card\" id=\"lineupCard\">\n      <!-- Lineup card content populated dynamically -->\n    </div>\n    <div class=\"rotation-tag\" id=\"rotationTag\">Rotation 1 of 6</div>\n    <div class=\"team-rows\" id=\"teamRows\">\n      <!-- Team rows populated dynamically -->\n    </div>\n  </div>\n\n  <script>\n    // Firebase configuration\n    const firebaseConfig = {\n      apiKey: \"AIzaSyCh0aZUvKl6Qvqsva3hvOgJJlleP1OwcTY\",\n      authDomain: \"gymnastics-graphics.firebaseapp.com\",\n      databaseURL: \"https://gymnastics-graphics-default-rtdb.firebaseio.com\",\n      projectId: \"gymnastics-graphics\",\n      storageBucket: \"gymnastics-graphics.firebasestorage.app\",\n      messagingSenderId: \"702072609550\",\n      appId: \"1:702072609550:web:ac74a811186d3ff45b955f\"\n    };\n\n    // Initialize Firebase\n    firebase.initializeApp(firebaseConfig);\n    const db = firebase.database();\n\n    // Parse URL parameters\n    const params = new URLSearchParams(window.location.search);\n    const compId = params.get('compId');\n\n    if (!compId) {\n      console.error('Missing compId parameter');\n      document.body.innerHTML = '<div class=\"error-state\">Missing compId parameter</div>';\n    }\n\n    // State management\n    const state = {\n      enabled: false,\n      polling: false,\n      automationMode: 'auto',\n      showLineup: null,\n      teams: [],\n      rotation: { current: 1, total: 6, isFinal: false },\n      previousScores: {},        // { \"gymnast_id\": \"finalScore\" (string) }\n      previousTeamTotals: {},    // { \"teamKey\": \"finalScore\" (string) }\n      flashQueues: {},           // Per-team flash queues\n      activeFlashes: {},         // Currently active flashes per team\n      nowCompeting: [],          // Currently competing athletes per team (B1)\n      manualNowCompeting: {},    // Manual overrides from producer { teamIndex: true/false } (B4/B7)\n      pollInterval: 5000,\n      flashDuration: 10000,\n      stalePollCount: 0,         // Consecutive polls with no data changes\n      // Competition config (loaded from Firebase)\n      competitionConfig: null,\n      virtiusSessionId: null,\n      gender: 'mens',\n      // Error handling state (A3c)\n      consecutiveErrors: 0,      // Count of consecutive poll failures\n      lastError: null,           // Last error message\n      lastErrorTime: null,       // Timestamp of last error\n      maxBackoffMs: 60000,       // Max backoff delay (60 seconds)\n      // Offline/reconnect state (A3d)\n      firebaseConnected: true,   // Firebase connection state\n      pendingWrites: [],         // Writes queued during offline\n      reconnectAttempts: 0       // Count of reconnect attempts\n    };\n\n    // Headshot storage (E1)\n    let firebaseHeadshots = {};\n    let headshotsLoaded = false;\n\n    /**\n     * Normalize accented characters to ASCII equivalents (E1).\n     * Handles German/Swedish umlauts, French/Spanish/Portuguese accents, ligatures.\n     */\n    function normalizeAccentsUnified(str) {\n      if (!str) return '';\n      return str\n        // German/Swedish umlauts - convert to two-letter equivalents\n        .replace(/ö/g, 'oe').replace(/Ö/g, 'oe')\n        .replace(/ä/g, 'ae').replace(/Ä/g, 'ae')\n        .replace(/ü/g, 'ue').replace(/Ü/g, 'ue')\n        .replace(/ß/g, 'ss')\n        // French/Spanish/Portuguese accents - convert to base letter\n        .replace(/[éèêë]/g, 'e').replace(/[ÉÈÊË]/g, 'e')\n        .replace(/[áàâãå]/g, 'a').replace(/[ÁÀÂÃÅ]/g, 'a')\n        .replace(/[íìîï]/g, 'i').replace(/[ÍÌÎÏ]/g, 'i')\n        .replace(/[óòôõø]/g, 'o').replace(/[ÓÒÔÕØ]/g, 'o')\n        .replace(/[úùûü]/g, 'u').replace(/[ÚÙÛÜ]/g, 'u')\n        .replace(/ñ/g, 'n').replace(/Ñ/g, 'n')\n        .replace(/ç/g, 'c').replace(/Ç/g, 'c')\n        .replace(/ÿ/g, 'y').replace(/Ÿ/g, 'y')\n        // Ligatures\n        .replace(/æ/g, 'ae').replace(/Æ/g, 'ae')\n        .replace(/œ/g, 'oe').replace(/Œ/g, 'oe');\n    }\n\n    /**\n     * Remove common name suffixes (Jr., Sr., III, etc.) (E1).\n     */\n    function removeSuffixesUnified(name) {\n      if (!name) return '';\n      return name\n        .replace(/,?\\s*(jr\\.?|junior|sr\\.?|senior|[iv]+|[1-5](?:st|nd|rd|th))$/i, '')\n        .trim();\n    }\n\n    /**\n     * Unified name normalization (E1).\n     * Handles accents, suffixes, hyphens, apostrophes.\n     */\n    function normalizeNameUnified(name) {\n      if (!name) return '';\n      return normalizeAccentsUnified(removeSuffixesUnified(name))\n        .toLowerCase()\n        .replace(/[-_]/g, ' ')      // Hyphens and underscores to spaces\n        .replace(/[''`]/g, '')      // Remove apostrophes (curly and straight)\n        .replace(/\\s+/g, ' ')       // Collapse multiple spaces\n        .trim();\n    }\n\n    /**\n     * Load headshots from Firebase teamsDatabase (E1).\n     * Creates multiple lookup keys for each headshot to maximize matching.\n     */\n    function loadFirebaseHeadshots() {\n      db.ref('teamsDatabase/headshots').on('value', (snapshot) => {\n        const data = snapshot.val() || {};\n        firebaseHeadshots = {};\n\n        // Convert Firebase structure to simple name -> url map\n        // Store multiple keys for each headshot to maximize matching\n        for (const [key, value] of Object.entries(data)) {\n          if (value && value.url) {\n            // 1. Store by Firebase key (underscores → spaces)\n            const keyWithSpaces = key.toLowerCase().trim().replace(/_/g, ' ').replace(/\\s+/g, ' ');\n            firebaseHeadshots[keyWithSpaces] = value.url;\n\n            // 2. Store by fully normalized key (handles accents, hyphens, etc.)\n            const normalizedKey = normalizeNameUnified(key);\n            firebaseHeadshots[normalizedKey] = value.url;\n\n            // 3. Store by name field (original stored name)\n            if (value.name) {\n              const nameNormalized = normalizeNameUnified(value.name);\n              firebaseHeadshots[nameNormalized] = value.url;\n\n              // Also store just lowercased version (in case accents are already normalized)\n              const nameLower = value.name.toLowerCase().trim().replace(/\\s+/g, ' ');\n              firebaseHeadshots[nameLower] = value.url;\n            }\n\n            // 4. Store stripped version (only letters and spaces - handles unknown chars)\n            const strippedKey = normalizedKey.replace(/[^a-z\\s]/g, '').replace(/\\s+/g, ' ').trim();\n            if (strippedKey && strippedKey.length > 2) {\n              firebaseHeadshots[strippedKey] = value.url;\n            }\n\n            // 5. Handle 3+ part names - store variants for reverse lookup\n            // e.g., \"benjamin thurlow lam\" also stored as \"benjamin lam\", \"benjamin t lam\"\n            const parts = normalizedKey.split(' ').filter(Boolean);\n            if (parts.length >= 3) {\n              // First + Last only (skip middle name)\n              const firstLast = `${parts[0]} ${parts[parts.length - 1]}`;\n              firebaseHeadshots[firstLast] = value.url;\n\n              // First + Middle initial + Last\n              const firstInitialLast = `${parts[0]} ${parts[1][0]} ${parts[parts.length - 1]}`;\n              firebaseHeadshots[firstInitialLast] = value.url;\n\n              // For 4+ parts, first two + last\n              if (parts.length >= 4) {\n                const firstTwoLast = `${parts[0]} ${parts[1]} ${parts[parts.length - 1]}`;\n                firebaseHeadshots[firstTwoLast] = value.url;\n              }\n            }\n          }\n        }\n        headshotsLoaded = true;\n        console.log(`Loaded ${Object.keys(firebaseHeadshots).length} headshot entries from Firebase`);\n      });\n    }\n\n    /**\n     * Get athlete headshot URL (E1).\n     * Handles 3+ part names, accented characters, and various name formats.\n     * Falls back to API headshot if no Firebase match found.\n     */\n    function getAthleteHeadshot(firstName, lastName, apiHeadshot) {\n      if (!firstName && !lastName) return apiHeadshot || '';\n\n      // Build full name for lookup\n      const rawFullName = `${firstName || ''} ${lastName || ''}`.trim();\n      const normalized = normalizeNameUnified(rawFullName);\n      const stripped = normalized.replace(/[^a-z\\s]/g, '').replace(/\\s+/g, ' ').trim();\n\n      // Generate multiple lookup keys to maximize matching\n      const lookupKeys = [\n        // 1. Original lowercase (exact match)\n        rawFullName.toLowerCase().replace(/\\s+/g, ' ').trim(),\n        // 2. Fully normalized (unified normalization)\n        normalized,\n        // 3. Stripped (only letters and spaces)\n        stripped,\n      ];\n\n      // 4. Handle 3+ part names (e.g., \"Benjamin Thurlow Lam\")\n      const parts = normalized.split(' ').filter(Boolean);\n      if (parts.length >= 3) {\n        // First + Last only (skip middle name)\n        lookupKeys.push(`${parts[0]} ${parts[parts.length - 1]}`);\n        // First + Middle initial + Last\n        lookupKeys.push(`${parts[0]} ${parts[1][0]} ${parts[parts.length - 1]}`);\n        // For 4+ parts, try first two + last\n        if (parts.length >= 4) {\n          lookupKeys.push(`${parts[0]} ${parts[1]} ${parts[parts.length - 1]}`);\n        }\n      }\n\n      // 5. Handle case where firstName contains multiple parts\n      const firstParts = (firstName || '').trim().split(/\\s+/).filter(Boolean);\n      if (firstParts.length >= 2 && lastName) {\n        // Just first part of firstName + lastName\n        lookupKeys.push(`${normalizeNameUnified(firstParts[0])} ${normalizeNameUnified(lastName)}`);\n        // First part + initial + lastName\n        lookupKeys.push(`${normalizeNameUnified(firstParts[0])} ${firstParts[1][0].toLowerCase()} ${normalizeNameUnified(lastName)}`);\n      }\n\n      // Remove duplicates and empty strings\n      const uniqueKeys = [...new Set(lookupKeys.filter(Boolean))];\n\n      // Try each key against Firebase headshots\n      for (const key of uniqueKeys) {\n        if (firebaseHeadshots[key]) {\n          return firebaseHeadshots[key];\n        }\n      }\n\n      // Fall back to API headshot\n      return apiHeadshot || '';\n    }\n\n    // Initialize headshot loading\n    loadFirebaseHeadshots();\n\n    /**\n     * Handle headshot load error by replacing with initials placeholder (E5).\n     * Called via onerror=\"handleHeadshotError(this, 'First', 'Last')\"\n     * @param {HTMLImageElement} img - The image element that failed\n     * @param {string} firstName - Athlete first name\n     * @param {string} lastName - Athlete last name\n     */\n    function handleHeadshotError(img, firstName, lastName) {\n      // Hide the broken image\n      img.style.display = 'none';\n\n      // Build initials (first letter of first name + first letter of last name)\n      const firstInitial = (firstName || '').charAt(0).toUpperCase();\n      const lastInitial = (lastName || '').charAt(0).toUpperCase();\n      const initials = `${firstInitial}${lastInitial}` || '?';\n\n      // Create placeholder div with initials\n      const placeholder = document.createElement('div');\n      placeholder.className = 'slot-headshot-fallback';\n      placeholder.textContent = initials;\n      placeholder.style.cssText = `\n        width: 36px;\n        height: 36px;\n        border-radius: 50%;\n        background: linear-gradient(135deg, #374151 0%, #1f2937 100%);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        font-size: 14px;\n        font-weight: 700;\n        color: #9ca3af;\n        flex-shrink: 0;\n      `;\n\n      // Insert before the hidden image\n      img.parentNode.insertBefore(placeholder, img);\n    }\n\n    // Firebase paths\n    const scoreBugRef = db.ref(`competitions/${compId}/scoreBug`);\n    const configRef = db.ref(`competitions/${compId}/config`);\n    const connectedRef = db.ref('.info/connected');\n\n    /**\n     * Initialize Firebase connection monitoring (A3d).\n     * Detects offline/online state and handles reconnection.\n     */\n    function initConnectionMonitor() {\n      connectedRef.on('value', (snapshot) => {\n        const connected = snapshot.val() === true;\n        const wasConnected = state.firebaseConnected;\n        state.firebaseConnected = connected;\n\n        if (connected && !wasConnected) {\n          // Just reconnected\n          console.log('Firebase connected - processing pending writes');\n          state.reconnectAttempts = 0;\n          processPendingWrites();\n\n          // Write reconnect event to Firebase\n          scoreBugRef.child('connectionStatus').set({\n            connected: true,\n            reconnectedAt: Date.now(),\n            pendingWritesProcessed: state.pendingWrites.length\n          });\n        } else if (!connected && wasConnected) {\n          // Just went offline\n          console.warn('Firebase disconnected - writes will be queued');\n          state.reconnectAttempts++;\n\n          // Note: Firebase SDK has offline persistence by default\n          // Writes are automatically queued and synced on reconnect\n        }\n\n        console.log('Firebase connection state:', connected ? 'ONLINE' : 'OFFLINE');\n      });\n    }\n\n    /**\n     * Process any pending writes that were queued during offline.\n     * Firebase SDK handles this automatically, but we log for visibility.\n     */\n    function processPendingWrites() {\n      if (state.pendingWrites.length === 0) return;\n\n      console.log('Processing', state.pendingWrites.length, 'pending writes');\n\n      // Firebase SDK automatically syncs queued writes\n      // Clear our tracking array\n      state.pendingWrites = [];\n    }\n\n    /**\n     * Safe write to Firebase with offline queueing (A3d).\n     * Wraps Firebase write operations to track pending writes during offline.\n     * @param {firebase.database.Reference} ref - Firebase reference\n     * @param {string} method - 'set', 'update', or 'remove'\n     * @param {*} data - Data to write (for set/update)\n     * @returns {Promise}\n     */\n    async function safeWrite(ref, method, data) {\n      const writeOp = { path: ref.toString(), method, data, timestamp: Date.now() };\n\n      if (!state.firebaseConnected) {\n        // Queue the write for tracking (Firebase SDK queues automatically)\n        state.pendingWrites.push(writeOp);\n        console.log('Queued offline write:', writeOp.path, method);\n      }\n\n      try {\n        if (method === 'set') {\n          await ref.set(data);\n        } else if (method === 'update') {\n          await ref.update(data);\n        } else if (method === 'remove') {\n          await ref.remove();\n        }\n        return true;\n      } catch (err) {\n        // Firebase SDK will retry on reconnect\n        console.error('Write failed (will retry on reconnect):', err.message);\n        if (!state.pendingWrites.includes(writeOp)) {\n          state.pendingWrites.push(writeOp);\n        }\n        return false;\n      }\n    }\n\n    /**\n     * Load competition config from Firebase.\n     * Gets virtiusSessionId, team names/logos, gender, and compType.\n     * Must be called before initializing Firebase listeners.\n     */\n    async function loadCompetitionConfig() {\n      try {\n        const snapshot = await configRef.once('value');\n        const config = snapshot.val();\n\n        if (!config) {\n          console.error('No competition config found for compId:', compId);\n          document.body.innerHTML = '<div class=\"error-state\">Competition not found</div>';\n          return false;\n        }\n\n        state.competitionConfig = config;\n        state.virtiusSessionId = config.virtiusSessionId || null;\n        state.gender = config.gender || 'mens';\n\n        // Build teams array from config (up to 7 teams)\n        state.teams = [];\n        for (let i = 1; i <= 7; i++) {\n          const teamName = config[`team${i}Name`];\n          if (teamName) {\n            state.teams.push({\n              index: i,\n              name: teamName,\n              logo: config[`team${i}Logo`] || '',\n              tricode: config[`team${i}Tricode`] || '',\n              total: '--'  // Initial state before first API poll\n            });\n          }\n        }\n\n        // Determine total rotations based on gender and team count\n        // For women's: normally 4, but more if team count exceeds apparatus count\n        // For men's: normally 6, but more if team count exceeds apparatus count\n        const eventCount = state.gender === 'womens' ? 4 : 6;\n        state.rotation.total = Math.max(eventCount, state.teams.length);\n\n        console.log('Competition config loaded:', {\n          compId,\n          virtiusSessionId: state.virtiusSessionId,\n          gender: state.gender,\n          teamCount: state.teams.length,\n          teams: state.teams.map(t => t.name)\n        });\n\n        // Check if Virtius session ID is configured\n        if (!state.virtiusSessionId) {\n          console.warn('No Virtius session ID configured - API polling will not work');\n        }\n\n        return true;\n      } catch (err) {\n        console.error('Failed to load competition config:', err);\n        document.body.innerHTML = '<div class=\"error-state\">Failed to load competition config</div>';\n        return false;\n      }\n    }\n\n    /**\n     * Render initial team rows based on competition config.\n     * Called after loadCompetitionConfig() to show teams before API polling starts.\n     * Adds team-count class for responsive scaling (G1/G2/G3).\n     */\n    function renderTeamRows() {\n      const container = document.getElementById('teamRows');\n      if (!container) return;\n\n      // Add team count class to score-bug for responsive scaling\n      const scoreBug = document.getElementById('scoreBug');\n      if (scoreBug) {\n        // Remove any existing team count classes\n        scoreBug.classList.remove('teams-2', 'teams-3', 'teams-4', 'teams-5', 'teams-6', 'teams-7');\n        // Add class based on team count\n        const teamCount = state.teams.length;\n        if (teamCount >= 2 && teamCount <= 7) {\n          scoreBug.classList.add(`teams-${teamCount}`);\n        }\n      }\n\n      container.innerHTML = state.teams.map((team, idx) => `\n        <div class=\"team-row\" data-team-index=\"${team.index}\">\n          <div class=\"team-fixed\">\n            <img class=\"team-logo\" src=\"${team.logo}\" alt=\"${team.name}\" onerror=\"this.style.display='none'\">\n            <div class=\"team-total\" id=\"teamTotal${team.index}\">${team.total}</div>\n          </div>\n          <div class=\"team-slot\" id=\"teamSlot${team.index}\">\n            <div class=\"slot-content\" id=\"slotContent${team.index}\">\n              <!-- Score flash / now competing content populated dynamically -->\n            </div>\n          </div>\n        </div>\n      `).join('');\n\n      console.log('Team rows rendered:', state.teams.length, 'teams');\n    }\n\n    /**\n     * Update team total display element (A4).\n     * Called when API polling detects a change in team.final_score.\n     * Adds highlight animation on value change.\n     * @param {number} teamIndex - 1-based team index\n     * @param {string} newTotal - Formatted score string (e.g., \"196.450\")\n     */\n    function updateTeamTotal(teamIndex, newTotal) {\n      const totalEl = document.getElementById(`teamTotal${teamIndex}`);\n      if (!totalEl) return;\n\n      const prevTotal = totalEl.textContent;\n\n      // Only update if value changed\n      if (prevTotal === newTotal) return;\n\n      totalEl.textContent = newTotal;\n\n      // Trigger highlight animation on change (skip for initial load)\n      if (prevTotal !== '--') {\n        totalEl.classList.remove('highlight');\n        // Force reflow to restart animation\n        void totalEl.offsetWidth;\n        totalEl.classList.add('highlight');\n      }\n    }\n\n    /**\n     * Update all team totals from state (A4).\n     * Called after API poll updates state.teams[].total values.\n     */\n    function updateAllTeamTotals() {\n      state.teams.forEach((team) => {\n        updateTeamTotal(team.index, team.total);\n      });\n    }\n\n    // Initialize Firebase listeners\n    function initFirebaseListeners() {\n      // Listen for enabled state\n      scoreBugRef.child('enabled').on('value', (snapshot) => {\n        state.enabled = snapshot.val() === true;\n        updateBugVisibility();\n      });\n\n      // Listen for polling state\n      scoreBugRef.child('polling').on('value', (snapshot) => {\n        const wasPolling = state.polling;\n        state.polling = snapshot.val() === true;\n        if (state.polling && !wasPolling) {\n          startPolling();\n        } else if (!state.polling && wasPolling) {\n          stopPolling();\n        }\n      });\n\n      // Listen for automation mode changes\n      scoreBugRef.child('automationMode').on('value', (snapshot) => {\n        const newMode = snapshot.val() || 'auto';\n        const modeChanged = state.automationMode !== newMode;\n        state.automationMode = newMode;\n\n        // When mode changes, update now-competing display accordingly\n        if (modeChanged) {\n          console.log('Automation mode changed to:', newMode);\n          updateAllNowCompeting();\n        }\n      });\n\n      // Listen for manual now-competing overrides (B7)\n      // Producer can show/hide now-competing per team in manual mode\n      scoreBugRef.child('nowCompeting').on('value', (snapshot) => {\n        const overrides = snapshot.val() || {};\n        state.manualNowCompeting = {};\n\n        // Convert team keys to indices: { \"team1\": true } → { 1: true }\n        Object.entries(overrides).forEach(([teamKey, value]) => {\n          // teamKey is \"team1\", \"team2\", etc.\n          const match = teamKey.match(/team(\\d+)/);\n          if (match) {\n            const teamIndex = parseInt(match[1], 10);\n            state.manualNowCompeting[teamIndex] = value;\n          }\n        });\n\n        console.log('Manual now-competing overrides updated:', state.manualNowCompeting);\n        updateAllNowCompeting();\n      });\n\n      // Listen for lineup card toggle\n      scoreBugRef.child('showLineup').on('value', (snapshot) => {\n        state.showLineup = snapshot.val();\n        updateLineupCard();\n      });\n\n      // Listen for flash dismissals\n      scoreBugRef.child('dismissFlash').on('value', (snapshot) => {\n        const dismissals = snapshot.val() || {};\n        handleFlashDismissals(dismissals);\n      });\n\n      // Listen for poll interval changes - restart polling with new interval\n      scoreBugRef.child('config/pollInterval').on('value', (snapshot) => {\n        const newInterval = snapshot.val() || 5000;\n        const wasPolling = state.polling && pollTimer !== null;\n        state.pollInterval = newInterval;\n\n        // Restart polling with new interval if currently polling\n        if (wasPolling) {\n          console.log('Poll interval changed to', newInterval, 'ms - restarting polling');\n          stopPolling();\n          startPolling();\n        }\n      });\n\n      // Listen for flash duration changes\n      scoreBugRef.child('config/flashDuration').on('value', (snapshot) => {\n        state.flashDuration = snapshot.val() || 10000;\n      });\n\n      console.log('Firebase listeners initialized');\n    }\n\n    // Update bug visibility based on enabled state\n    function updateBugVisibility() {\n      const bugEl = document.getElementById('scoreBug');\n      if (state.enabled) {\n        bugEl.classList.add('visible');\n      } else {\n        bugEl.classList.remove('visible');\n      }\n    }\n\n    // Update lineup card visibility\n    function updateLineupCard() {\n      const cardEl = document.getElementById('lineupCard');\n      if (!state.showLineup) {\n        cardEl.classList.remove('visible');\n        return;\n      }\n\n      // Find the team matching state.showLineup (teamKey like \"navy-mens\")\n      const apiTeams = state.lastApiTeams || [];\n      const teamData = apiTeams.find(t => {\n        const teamKey = t.short_name || `team${apiTeams.indexOf(t) + 1}`;\n        return teamKey === state.showLineup;\n      });\n\n      if (!teamData) {\n        console.warn('Lineup card: team not found for key:', state.showLineup);\n        cardEl.classList.remove('visible');\n        return;\n      }\n\n      // Find the config team to get logo and display name\n      const configTeamIndex = apiTeams.indexOf(teamData);\n      const configTeam = state.teams[configTeamIndex] || {};\n\n      // Find the current event (in progress or most recent)\n      const currentEvent = findCurrentEventForLineup(teamData);\n      if (!currentEvent) {\n        console.warn('Lineup card: no current event found');\n        cardEl.classList.remove('visible');\n        return;\n      }\n\n      // Populate the lineup card content\n      cardEl.innerHTML = renderLineupCardContent(teamData, configTeam, currentEvent);\n      cardEl.classList.add('visible');\n    }\n\n    /**\n     * Find the current event for lineup card display.\n     * Prioritizes: (1) event in progress, (2) last completed event, (3) first event.\n     * @param {Object} teamData - Team data from Virtius API\n     * @returns {Object|null} Event object or null\n     */\n    function findCurrentEventForLineup(teamData) {\n      if (!teamData || !teamData.events) return null;\n\n      const events = teamData.events;\n      if (events.length === 0) return null;\n\n      // Look for event in progress (some scores, but not all)\n      for (const event of events) {\n        const gymnasts = event.gymnasts || [];\n        if (gymnasts.length === 0) continue;\n\n        const scored = gymnasts.filter(g => g.final_score != null);\n        const unscored = gymnasts.filter(g => g.final_score == null);\n\n        // Event in progress: has some scores but not complete\n        if (scored.length > 0 && unscored.length > 0) {\n          return event;\n        }\n      }\n\n      // No event in progress - find the last event with scores\n      for (let i = events.length - 1; i >= 0; i--) {\n        const event = events[i];\n        const gymnasts = event.gymnasts || [];\n        const scored = gymnasts.filter(g => g.final_score != null);\n        if (scored.length > 0) {\n          return event;\n        }\n      }\n\n      // No events have scores yet - return first event\n      return events[0];\n    }\n\n    /**\n     * Render lineup card HTML content.\n     * @param {Object} teamData - Team data from Virtius API\n     * @param {Object} configTeam - Team config with logo/name\n     * @param {Object} event - Current event to display\n     * @returns {string} HTML content\n     */\n    function renderLineupCardContent(teamData, configTeam, event) {\n      const teamName = configTeam.name || teamData.name || 'Team';\n      const teamLogo = configTeam.logo || '';\n      const eventName = getEventShortCode(event.event_name || event.name || '');\n      const eventTotal = formatScore(event.event_score);\n\n      // Sort gymnasts by lineup order\n      const gymnasts = [...(event.gymnasts || [])].sort((a, b) => (a.order || 0) - (b.order || 0));\n\n      // Build athlete rows\n      const athleteRows = gymnasts.map((g, idx) => {\n        const order = g.order || (idx + 1);\n        const name = g.full_name || 'Unknown';\n        // Get start value from scores array if available\n        const startValue = (g.scores && g.scores[0] && g.scores[0].start)\n          ? parseFloat(g.scores[0].start).toFixed(1)\n          : '';\n        const score = g.final_score != null ? formatScore(g.final_score) : '--';\n        const pendingClass = g.final_score == null ? 'pending' : '';\n\n        return `\n          <div class=\"lineup-athlete\">\n            <span class=\"lineup-order\">${order}.</span>\n            <span class=\"lineup-name\">${name}</span>\n            <span class=\"lineup-sv\">${startValue}</span>\n            <span class=\"lineup-score ${pendingClass}\">${score}</span>\n          </div>\n        `;\n      }).join('');\n\n      return `\n        <div class=\"lineup-header\">\n          <span class=\"lineup-team-name\">${teamName}</span>\n          <img class=\"lineup-logo\" src=\"${teamLogo}\" alt=\"\" onerror=\"this.style.display='none'\">\n        </div>\n        <div class=\"lineup-athletes\">\n          ${athleteRows}\n        </div>\n        <div class=\"lineup-footer\">\n          <span class=\"lineup-event\">${eventName}</span>\n          <span class=\"lineup-total\">${eventTotal}</span>\n        </div>\n      `;\n    }\n\n    /**\n     * Format score for display (3 decimal places).\n     * @param {string|number|null} score - Score value\n     * @returns {string} Formatted score or \"--\"\n     */\n    function formatScore(score) {\n      if (score == null || score === '') return '--';\n      const num = parseFloat(score);\n      if (isNaN(num)) return '--';\n      return num.toFixed(3);\n    }\n\n    /**\n     * Handle flash dismissals from producer panel (Task A12c).\n     * When producer clicks \"dismiss\" for a team, immediately clears\n     * the active flash and advances to next in queue.\n     * @param {Object} dismissals - Map of teamIndex -> timestamp\n     */\n    function handleFlashDismissals(dismissals) {\n      if (!dismissals || typeof dismissals !== 'object') return;\n\n      Object.keys(dismissals).forEach((teamIndexStr) => {\n        const teamIndex = parseInt(teamIndexStr, 10);\n        const dismissTimestamp = dismissals[teamIndex];\n\n        // Skip if no active flash for this team\n        if (!state.activeFlashes[teamIndex]) return;\n\n        // Skip if already processed this dismissal (compare timestamps)\n        const activeFlash = state.activeFlashes[teamIndex];\n        if (activeFlash.dismissedAt === dismissTimestamp) return;\n\n        console.log('Processing flash dismissal:', {\n          team: teamIndex,\n          gymnast: activeFlash.name,\n          dismissTimestamp\n        });\n\n        // Mark as processed\n        activeFlash.dismissedAt = dismissTimestamp;\n\n        // Clear the timer for current flash\n        if (activeFlash.timer) {\n          clearTimeout(activeFlash.timer);\n        }\n\n        // Advance to next flash (or clear if queue empty)\n        advanceFlashQueue(teamIndex);\n\n        // Clear the dismissal flag in Firebase after processing\n        scoreBugRef.child(`dismissFlash/${teamIndex}`).remove();\n      });\n    }\n\n    // Polling management\n    let pollTimer = null;\n\n    function startPolling() {\n      if (pollTimer) return;\n      console.log('Starting API polling');\n      poll();  // Initial poll\n      pollTimer = setInterval(poll, state.pollInterval);\n    }\n\n    function stopPolling() {\n      if (pollTimer) {\n        clearInterval(pollTimer);\n        pollTimer = null;\n        console.log('Stopped API polling');\n      }\n    }\n\n    // Main poll function - fetches data from Virtius API\n    async function poll() {\n      // Check if we have a valid session ID\n      if (!state.virtiusSessionId) {\n        console.warn('No Virtius session ID - skipping poll');\n        return;\n      }\n\n      const pollStartTime = Date.now();\n\n      try {\n        // Fetch from Virtius API\n        const response = await fetch(`https://api.virti.us/session/${state.virtiusSessionId}/json`);\n\n        if (!response.ok) {\n          throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n        }\n\n        const data = await response.json();\n\n        // Store raw API data for score diff engine (Task A5)\n        // Extract teams array from meet data\n        const teams = data.meet?.teams || [];\n\n        if (teams.length === 0) {\n          console.warn('No teams found in API response');\n        }\n\n        // Store the latest API data in state\n        state.lastApiData = data;\n        state.lastApiTeams = teams;\n\n        // Extract team totals and update state.teams with actual data\n        // final_score comes as a string from API - convert to float for display\n        teams.forEach((apiTeam, idx) => {\n          // Match API team to our configured teams by index or name\n          const stateTeam = state.teams[idx];\n          if (stateTeam) {\n            // Convert string final_score to formatted number\n            const rawScore = apiTeam.final_score;\n            if (rawScore !== null && rawScore !== undefined) {\n              const numScore = parseFloat(rawScore);\n              stateTeam.total = isNaN(numScore) ? '--' : numScore.toFixed(3);\n            }\n            // Store API team reference for score diff engine\n            stateTeam.apiTeam = apiTeam;\n          }\n        });\n\n        // Write heartbeat to Firebase on successful poll (using safeWrite for offline resilience)\n        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n\n        console.log('Poll successful:', {\n          sessionId: state.virtiusSessionId,\n          teamCount: teams.length,\n          teams: state.teams.map(t => ({ name: t.name, total: t.total }))\n        });\n\n        // Process API data - detect changes and write deltas to Firebase\n        await processApiData(teams, pollStartTime);\n\n        // Update team total displays (A4)\n        updateAllTeamTotals();\n\n      } catch (err) {\n        // Error handling with exponential backoff (A3c)\n        state.consecutiveErrors++;\n        state.lastError = err.message;\n        state.lastErrorTime = pollStartTime;\n\n        // Calculate backoff delay: 5s, 10s, 20s, 40s, 60s (max)\n        const backoffDelay = Math.min(\n          state.pollInterval * Math.pow(2, state.consecutiveErrors - 1),\n          state.maxBackoffMs\n        );\n\n        console.error('Poll failed:', {\n          error: err.message,\n          consecutiveErrors: state.consecutiveErrors,\n          nextRetryIn: `${backoffDelay / 1000}s`\n        });\n\n        // Write error state to Firebase for producer panel visibility (D5b)\n        // Using safeWrite for offline resilience\n        await safeWrite(scoreBugRef.child('apiError'), 'set', {\n          message: err.message,\n          consecutiveErrors: state.consecutiveErrors,\n          timestamp: pollStartTime,\n          nextRetryMs: backoffDelay\n        });\n        // Still write heartbeat to indicate overlay is running\n        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n\n        // Schedule next poll with backoff delay if we're still supposed to be polling\n        if (state.polling && pollTimer) {\n          clearInterval(pollTimer);\n          pollTimer = setTimeout(() => {\n            if (state.polling) {\n              poll();\n              // If poll succeeds, startPolling() will be called to restore normal interval\n            }\n          }, backoffDelay);\n        }\n        return; // Skip normal completion\n      }\n\n      // Success - reset error state\n      if (state.consecutiveErrors > 0) {\n        console.log('Poll recovered after', state.consecutiveErrors, 'consecutive errors');\n        state.consecutiveErrors = 0;\n        state.lastError = null;\n        state.lastErrorTime = null;\n\n        // Clear error state in Firebase\n        await safeWrite(scoreBugRef.child('apiError'), 'remove');\n\n        // Restore normal polling interval (we might be on backoff timeout)\n        if (state.polling && pollTimer) {\n          clearTimeout(pollTimer);\n          clearInterval(pollTimer);\n          pollTimer = setInterval(poll, state.pollInterval);\n        }\n      }\n    }\n\n    /**\n     * Process API data - detect score changes and write incremental deltas to Firebase.\n     * Only writes changed paths, not full data rewrite.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @param {number} pollTimestamp - Timestamp of this poll\n     */\n    async function processApiData(apiTeams, pollTimestamp) {\n      const changedPaths = {};\n      let hasChanges = false;\n\n      // Process each team\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n\n        // Check if team total changed\n        const prevTeamTotal = state.previousTeamTotals[teamKey];\n        const currTeamTotal = team.final_score;  // string or null\n\n        if (currTeamTotal !== prevTeamTotal) {\n          changedPaths[`teams/${teamKey}/finalScore`] = currTeamTotal;\n          changedPaths[`teams/${teamKey}/name`] = team.name || teamKey;\n          hasChanges = true;\n        }\n\n        // Process each event's gymnasts for score changes\n        const events = team.events || [];\n        events.forEach((event) => {\n          const eventKey = event.short_name || event.name || 'unknown';\n          const gymnasts = event.gymnasts || [];\n\n          gymnasts.forEach((gymnast) => {\n            // Primary key: gymnast_id. Fallback: teamKey|normalizedName\n            const gymnastKey = gymnast.gymnast_id ||\n              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n\n            const prevScore = state.previousScores[gymnastKey];\n            const currScore = gymnast.final_score;  // string or null\n\n            // Score changed (new score OR corrected score)\n            if (currScore != null && prevScore !== currScore) {\n              // Build gymnast data for Firebase and flash queue\n              // Stick bonus is indicated by bonus > 0 in the API (men's gymnastics only)\n              const bonusValue = parseFloat(gymnast.bonus) || 0;\n              const hasStick = bonusValue > 0;\n\n              const gymnastData = {\n                name: gymnast.full_name,\n                firstName: gymnast.first_name || '',\n                lastName: gymnast.last_name || '',\n                apiHeadshot: gymnast.headshot || '',\n                score: currScore,\n                startValue: gymnast.start_value || null,\n                execution: gymnast.execution || null,\n                difficulty: gymnast.difficulty || null,\n                bonus: bonusValue,\n                hasStick: hasStick,\n                order: gymnast.order,\n                event: eventKey,\n                team: teamKey,\n                gymnastKey: gymnastKey,\n                timestamp: pollTimestamp,\n                isCorrection: prevScore != null  // True if score was changed (not new)\n              };\n\n              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}`] = gymnastData;\n              hasChanges = true;\n\n              console.log('Score change detected:', {\n                gymnast: gymnast.full_name,\n                event: eventKey,\n                team: teamKey,\n                prev: prevScore,\n                curr: currScore,\n                isCorrection: prevScore != null\n              });\n\n              // Trigger flash for this score change (A5)\n              const teamIndex = teamIdx + 1;  // Convert 0-based to 1-based index\n              if (isFlashActive(teamIndex, gymnastKey)) {\n                // Correction during active flash - interrupt and replace\n                interruptFlash(teamIndex, gymnastData);\n              } else {\n                // Queue new flash for this team\n                triggerScoreFlash(teamIndex, gymnastData);\n              }\n            }\n\n            // Score removed (rare - inquiry pending)\n            if (currScore == null && prevScore != null) {\n              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}/score`] = null;\n              hasChanges = true;\n              console.log('Score removed:', { gymnast: gymnast.full_name, event: eventKey });\n            }\n          });\n        });\n      });\n\n      // Write to Firebase (using safeWrite for offline resilience)\n      if (hasChanges) {\n        // Write changed paths and reset stale counter\n        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n          ...changedPaths,\n          lastDataChangeTimestamp: pollTimestamp,\n          stalePollCount: 0\n        });\n        state.stalePollCount = 0;\n\n        console.log('Wrote incremental deltas to Firebase:', Object.keys(changedPaths).length, 'paths');\n      } else {\n        // No changes - increment stale counter\n        state.stalePollCount++;\n        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n          lastPollTimestamp: pollTimestamp,\n          stalePollCount: state.stalePollCount\n        });\n      }\n\n      // Update previous state for next comparison\n      state.previousScores = buildScoreMap(apiTeams);\n      state.previousTeamTotals = buildTeamTotalMap(apiTeams);\n\n      // Detect and update rotation (A10)\n      const newRotation = detectRotation(apiTeams);\n      if (newRotation.current !== state.rotation.current ||\n          newRotation.isFinal !== state.rotation.isFinal) {\n        state.rotation = newRotation;\n        updateRotationTag();\n\n        // Write rotation to Firebase for producer panel visibility\n        await safeWrite(scoreBugRef.child('liveData/rotation'), 'set', newRotation.current);\n        await safeWrite(scoreBugRef.child('liveData/totalRotations'), 'set', newRotation.total);\n        await safeWrite(scoreBugRef.child('liveData/isFinal'), 'set', newRotation.isFinal);\n\n        console.log('Rotation updated:', newRotation);\n      }\n\n      // Detect now-competing athletes (B1)\n      const nowCompeting = detectAllNowCompeting(apiTeams);\n      const prevNowCompeting = state.nowCompeting || [];\n\n      // Check if now-competing has changed\n      const nowCompetingChanged = JSON.stringify(nowCompeting) !== JSON.stringify(prevNowCompeting);\n\n      if (nowCompetingChanged) {\n        state.nowCompeting = nowCompeting;\n\n        // Write detected state to Firebase for producer panel visibility\n        await safeWrite(scoreBugRef.child('detected/nowCompeting'), 'set', nowCompeting);\n\n        console.log('Now competing updated:', nowCompeting);\n\n        // Update now-competing slot displays (B2)\n        updateAllNowCompeting();\n      }\n\n      // Write detected teams list for lineup card controls (D7)\n      const detectedTeams = apiTeams.map((team, idx) => ({\n        teamIndex: idx,\n        teamKey: team.short_name || `team${idx + 1}`,\n        teamName: team.name,\n        tricode: team.tricode\n      }));\n      const prevDetectedTeams = state.detectedTeams || [];\n      if (JSON.stringify(detectedTeams) !== JSON.stringify(prevDetectedTeams)) {\n        state.detectedTeams = detectedTeams;\n        await safeWrite(scoreBugRef.child('detected/teams'), 'set', detectedTeams);\n      }\n\n      // Update lineup card if visible (C5 - live update with new scores)\n      if (state.showLineup) {\n        updateLineupCard();\n      }\n    }\n\n    /**\n     * Build score map from API teams data.\n     * @returns {Object} Map of gymnastKey -> finalScore (string)\n     */\n    function buildScoreMap(apiTeams) {\n      const map = {};\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n        const events = team.events || [];\n\n        events.forEach((event) => {\n          const gymnasts = event.gymnasts || [];\n          gymnasts.forEach((gymnast) => {\n            const gymnastKey = gymnast.gymnast_id ||\n              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n            map[gymnastKey] = gymnast.final_score;  // string or null\n          });\n        });\n      });\n      return map;\n    }\n\n    /**\n     * Build team total map from API teams data.\n     * @returns {Object} Map of teamKey -> finalScore (string)\n     */\n    function buildTeamTotalMap(apiTeams) {\n      const map = {};\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n        map[teamKey] = team.final_score;  // string or null\n      });\n      return map;\n    }\n\n    // ============================================================\n    // SCORE DIFF ENGINE - Flash Queue Management (Task A5)\n    // ============================================================\n\n    /**\n     * Check if a flash is currently active for a given team and gymnast.\n     * Used to detect score corrections during active flash display.\n     * @param {number} teamIndex - 1-based team index\n     * @param {string} gymnastKey - Unique gymnast identifier\n     * @returns {boolean} True if flash is active for this gymnast\n     */\n    function isFlashActive(teamIndex, gymnastKey) {\n      const activeFlash = state.activeFlashes[teamIndex];\n      return activeFlash && activeFlash.gymnastKey === gymnastKey;\n    }\n\n    /**\n     * Interrupt current flash with a new one (score correction case).\n     * Immediately replaces the active flash and resets timer.\n     * @param {number} teamIndex - 1-based team index\n     * @param {Object} gymnastData - New score data to display\n     */\n    function interruptFlash(teamIndex, gymnastData) {\n      console.log('Interrupting active flash with correction:', {\n        team: teamIndex,\n        gymnast: gymnastData.name,\n        newScore: gymnastData.score\n      });\n\n      // Clear existing flash timer\n      if (state.activeFlashes[teamIndex]?.timer) {\n        clearTimeout(state.activeFlashes[teamIndex].timer);\n      }\n\n      // Replace with new flash data\n      state.activeFlashes[teamIndex] = {\n        ...gymnastData,\n        startTime: Date.now(),\n        timer: null\n      };\n\n      // Render the updated flash immediately\n      renderFlash(teamIndex, gymnastData);\n\n      // Set new timer\n      state.activeFlashes[teamIndex].timer = setTimeout(() => {\n        advanceFlashQueue(teamIndex);\n      }, state.flashDuration);\n    }\n\n    /**\n     * Queue a new score flash for a team.\n     * If no flash is active, displays immediately. Otherwise queued.\n     * @param {number} teamIndex - 1-based team index\n     * @param {Object} gymnastData - Score data to display\n     */\n    function triggerScoreFlash(teamIndex, gymnastData) {\n      // Initialize queue if needed\n      if (!state.flashQueues[teamIndex]) {\n        state.flashQueues[teamIndex] = [];\n      }\n\n      const queue = state.flashQueues[teamIndex];\n\n      // Edge case: Check if this gymnast is already in the queue (correction before display)\n      const existingIndex = queue.findIndex(item => item.gymnastKey === gymnastData.gymnastKey);\n      if (existingIndex !== -1) {\n        // Update existing queue entry with corrected score (A13: corrections in queue)\n        console.log('Updating queued flash with correction:', {\n          team: teamIndex,\n          gymnast: gymnastData.name,\n          oldScore: queue[existingIndex].score,\n          newScore: gymnastData.score\n        });\n        queue[existingIndex] = { ...gymnastData, isCorrection: true };\n        return;\n      }\n\n      // Edge case: Cap queue length to prevent runaway (A13: rapid scores)\n      const MAX_QUEUE_SIZE = 6;  // Max gymnasts per rotation\n      if (queue.length >= MAX_QUEUE_SIZE) {\n        console.warn('Flash queue full, dropping oldest entry:', {\n          team: teamIndex,\n          dropped: queue[0].name,\n          newEntry: gymnastData.name\n        });\n        queue.shift();\n      }\n\n      console.log('Queuing score flash:', {\n        team: teamIndex,\n        gymnast: gymnastData.name,\n        score: gymnastData.score,\n        queueLength: queue.length\n      });\n\n      // Add to queue\n      queue.push(gymnastData);\n\n      // If no active flash, start displaying\n      if (!state.activeFlashes[teamIndex]) {\n        displayNextFlash(teamIndex);\n      }\n    }\n\n    /**\n     * Display the next flash from the queue.\n     * Called when starting or advancing the queue.\n     * @param {number} teamIndex - 1-based team index\n     */\n    function displayNextFlash(teamIndex) {\n      const queue = state.flashQueues[teamIndex] || [];\n\n      if (queue.length === 0) {\n        // No more flashes - clear active state\n        state.activeFlashes[teamIndex] = null;\n        clearFlashDisplay(teamIndex);\n        return;\n      }\n\n      // Get next flash from queue\n      const gymnastData = queue.shift();\n\n      // Set as active\n      state.activeFlashes[teamIndex] = {\n        ...gymnastData,\n        startTime: Date.now(),\n        timer: setTimeout(() => {\n          advanceFlashQueue(teamIndex);\n        }, state.flashDuration)\n      };\n\n      // Render the flash\n      renderFlash(teamIndex, gymnastData);\n    }\n\n    /**\n     * Advance to next flash in queue (called when timer expires).\n     * @param {number} teamIndex - 1-based team index\n     */\n    function advanceFlashQueue(teamIndex) {\n      // Clear current flash timer\n      if (state.activeFlashes[teamIndex]?.timer) {\n        clearTimeout(state.activeFlashes[teamIndex].timer);\n      }\n\n      // Display next or clear\n      displayNextFlash(teamIndex);\n    }\n\n    /**\n     * Render a score flash in a team's slot area with slot machine animation.\n     * TODO: Task A7 will enhance rendering with headshots/apparatus.\n     * @param {number} teamIndex - 1-based team index\n     * @param {Object} gymnastData - Score data to render\n     */\n    function renderFlash(teamIndex, gymnastData) {\n      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n      if (!slotContent) return;\n\n      // Check if there's existing content to animate out\n      const hasExistingContent = slotContent.innerHTML.trim() !== '';\n\n      if (hasExistingContent) {\n        // Spin out existing content first\n        slotContent.classList.remove('spin-in', 'visible');\n        slotContent.classList.add('spin-out');\n\n        // After spin-out completes, insert new content and spin in\n        setTimeout(() => {\n          insertFlashContent(slotContent, gymnastData);\n          triggerSpinIn(slotContent);\n        }, 400);  // Match spin-out animation duration\n      } else {\n        // No existing content - insert and spin in directly\n        insertFlashContent(slotContent, gymnastData);\n        triggerSpinIn(slotContent);\n      }\n\n      console.log('Rendered flash:', {\n        team: teamIndex,\n        gymnast: gymnastData.name,\n        score: gymnastData.score,\n        animated: hasExistingContent ? 'spin-transition' : 'spin-in'\n      });\n    }\n\n    /**\n     * Insert flash content HTML into slot element (Task A7).\n     * Renders: apparatus | name | SV | separator | score | correction indicator\n     * @param {HTMLElement} slotContent - The slot content container\n     * @param {Object} gymnastData - Score data to render\n     */\n    function insertFlashContent(slotContent, gymnastData) {\n      // Get headshot URL (E3) with fallback (E5)\n      const headshotUrl = getAthleteHeadshot(\n        gymnastData.firstName,\n        gymnastData.lastName,\n        gymnastData.apiHeadshot\n      );\n      // Escape names for use in onerror attribute\n      const escapedFirst = (gymnastData.firstName || '').replace(/'/g, \"\\\\'\");\n      const escapedLast = (gymnastData.lastName || '').replace(/'/g, \"\\\\'\");\n      const headshotHtml = headshotUrl\n        ? `<img class=\"slot-headshot\" src=\"${headshotUrl}\" alt=\"\" onerror=\"handleHeadshotError(this, '${escapedFirst}', '${escapedLast}')\">`\n        : `<div class=\"slot-headshot-fallback\" style=\"width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#374151 0%,#1f2937 100%);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#9ca3af;flex-shrink:0;\">${(gymnastData.firstName || '').charAt(0).toUpperCase()}${(gymnastData.lastName || '').charAt(0).toUpperCase() || '?'}</div>`;\n\n      // Format start value for display (e.g., \"5.0\" or \"5.2\")\n      const svDisplay = gymnastData.startValue\n        ? `<span class=\"slot-sv\">SV ${parseFloat(gymnastData.startValue).toFixed(1)}</span>`\n        : '';\n\n      // Format score for display (e.g., \"13.450\")\n      const scoreValue = parseFloat(gymnastData.score);\n      const scoreDisplay = isNaN(scoreValue) ? gymnastData.score : scoreValue.toFixed(3);\n\n      // Stick indicator for bonus landings (men's gymnastics only)\n      const stickIndicator = (state.gender === 'mens' && gymnastData.hasStick) ? '<span class=\"slot-stick\">Stick</span>' : '';\n\n      slotContent.innerHTML = `\n        ${headshotHtml}\n        <span class=\"slot-apparatus\">${gymnastData.event}</span>\n        <span class=\"slot-name\">${gymnastData.name}</span>\n        ${svDisplay}\n        <span class=\"slot-separator\">•</span>\n        <span class=\"slot-score\">${scoreDisplay}</span>\n        ${stickIndicator}\n        ${gymnastData.isCorrection ? '<span class=\"slot-correction\">(corrected)</span>' : ''}\n      `;\n    }\n\n    /**\n     * Trigger spin-in animation on slot content.\n     * @param {HTMLElement} slotContent - The slot content container\n     */\n    function triggerSpinIn(slotContent) {\n      // Reset animation state\n      slotContent.classList.remove('spin-out', 'exit-up', 'enter-from-below');\n\n      // Force reflow to ensure animation restarts\n      void slotContent.offsetWidth;\n\n      // Trigger spin-in animation\n      slotContent.classList.add('spin-in', 'visible');\n    }\n\n    /**\n     * Clear flash display for a team (return to idle state) with spin-out animation.\n     * After flash ends, checks if there's a now-competing state to restore (B5).\n     * @param {number} teamIndex - 1-based team index\n     */\n    function clearFlashDisplay(teamIndex) {\n      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n      if (!slotContent) return;\n\n      // Only animate if there's content to clear\n      if (slotContent.innerHTML.trim() === '') return;\n\n      // Trigger spin-out animation\n      slotContent.classList.remove('spin-in', 'visible');\n      slotContent.classList.add('spin-out');\n\n      // After animation completes, either restore now-competing or clear (B5)\n      setTimeout(() => {\n        if (state.activeFlashes[teamIndex]) return;  // New flash started during animation\n\n        // Check if there's a now-competing state to restore\n        const nowCompetingToRestore = getNowCompetingForTeam(teamIndex);\n\n        if (nowCompetingToRestore) {\n          // Restore now-competing display\n          insertNowCompetingContent(slotContent, nowCompetingToRestore);\n          triggerSpinIn(slotContent);\n          console.log('Restored now-competing after flash:', {\n            team: teamIndex,\n            athlete: nowCompetingToRestore.athlete?.name\n          });\n        } else {\n          // No now-competing to show - clear the slot\n          slotContent.innerHTML = '';\n          slotContent.classList.remove('spin-out');\n        }\n      }, 400);  // Match CSS animation duration\n    }\n\n    /**\n     * Get the current now-competing data for a team (B5).\n     * Respects auto/manual mode settings.\n     * @param {number} teamIndex - 1-based team index\n     * @returns {Object|null} Now-competing data or null\n     */\n    function getNowCompetingForTeam(teamIndex) {\n      // Find the team by index\n      const teamArrayIdx = state.teams.findIndex(t => t.index === teamIndex);\n      if (teamArrayIdx === -1) return null;\n\n      const nowCompeting = state.nowCompeting.find(nc => nc.teamIndex === teamArrayIdx);\n      if (!nowCompeting) return null;\n\n      // Check if we should show based on mode\n      if (state.automationMode === 'auto') {\n        return nowCompeting;\n      } else {\n        // Manual mode - only if producer has enabled\n        return state.manualNowCompeting[teamIndex] ? nowCompeting : null;\n      }\n    }\n\n    // ============================================================\n    // NOW-COMPETING SLOT STATE (Task B2)\n    // ============================================================\n\n    /**\n     * Render \"now competing\" state in a team's slot area.\n     * Shows: athlete name + apparatus (no start value - not known until after)\n     * Uses same slot animation system as score flashes.\n     * @param {number} teamIndex - 1-based team index\n     * @param {Object} nowCompetingData - { athlete: { name }, eventName }\n     */\n    function renderNowCompeting(teamIndex, nowCompetingData) {\n      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n      if (!slotContent) return;\n\n      // Don't show now-competing if there's an active score flash\n      if (state.activeFlashes[teamIndex]) {\n        console.log('Skipping now-competing render - score flash active', { team: teamIndex });\n        return;\n      }\n\n      // Check if there's existing content to animate out\n      const hasExistingContent = slotContent.innerHTML.trim() !== '';\n\n      if (hasExistingContent) {\n        // Spin out existing content first\n        slotContent.classList.remove('spin-in', 'visible');\n        slotContent.classList.add('spin-out');\n\n        // After spin-out completes, insert new content and spin in\n        setTimeout(() => {\n          insertNowCompetingContent(slotContent, nowCompetingData);\n          triggerSpinIn(slotContent);\n        }, 400);  // Match spin-out animation duration\n      } else {\n        // No existing content - insert and spin in directly\n        insertNowCompetingContent(slotContent, nowCompetingData);\n        triggerSpinIn(slotContent);\n      }\n\n      console.log('Rendered now-competing:', {\n        team: teamIndex,\n        athlete: nowCompetingData.athlete.name,\n        event: nowCompetingData.eventName\n      });\n    }\n\n    /**\n     * Insert now-competing content HTML into slot element.\n     * Renders: apparatus | \"UP NOW\" label | athlete name\n     * @param {HTMLElement} slotContent - The slot content container\n     * @param {Object} nowCompetingData - { athlete: { name }, eventName }\n     */\n    function insertNowCompetingContent(slotContent, nowCompetingData) {\n      const athlete = nowCompetingData.athlete || {};\n      const athleteName = athlete.name || 'Unknown';\n      const eventName = nowCompetingData.eventName || '';\n\n      // Format event name to short code if possible (e.g., \"Floor Exercise\" -> \"FX\")\n      const eventShort = getEventShortCode(eventName) || eventName;\n\n      // Get headshot URL (E4) with fallback (E5)\n      const headshotUrl = getAthleteHeadshot(\n        athlete.firstName,\n        athlete.lastName,\n        athlete.apiHeadshot\n      );\n      // Escape names for use in onerror attribute\n      const escapedFirst = (athlete.firstName || '').replace(/'/g, \"\\\\'\");\n      const escapedLast = (athlete.lastName || '').replace(/'/g, \"\\\\'\");\n      const headshotHtml = headshotUrl\n        ? `<img class=\"slot-headshot\" src=\"${headshotUrl}\" alt=\"\" onerror=\"handleHeadshotError(this, '${escapedFirst}', '${escapedLast}')\">`\n        : `<div class=\"slot-headshot-fallback\" style=\"width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#374151 0%,#1f2937 100%);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#9ca3af;flex-shrink:0;\">${(athlete.firstName || '').charAt(0).toUpperCase()}${(athlete.lastName || '').charAt(0).toUpperCase() || '?'}</div>`;\n\n      slotContent.innerHTML = `\n        ${headshotHtml}\n        <span class=\"slot-apparatus\">${eventShort}</span>\n        <span class=\"slot-sv\" style=\"color: #22d3ee;\">UP NOW</span>\n        <span class=\"slot-name\">${athleteName}</span>\n      `;\n    }\n\n    /**\n     * Convert event name to short code (e.g., \"Floor Exercise\" -> \"FX\").\n     * @param {string} eventName - Full event name from API\n     * @returns {string} Short code or original name\n     */\n    function getEventShortCode(eventName) {\n      if (!eventName) return '';\n\n      const name = eventName.toLowerCase();\n\n      // Men's events\n      if (name.includes('floor')) return 'FX';\n      if (name.includes('pommel') || name.includes('horse')) return 'PH';\n      if (name.includes('ring')) return 'SR';\n      if (name.includes('vault')) return 'VT';\n      if (name.includes('parallel')) return 'PB';\n      if (name.includes('high bar') || name.includes('horizontal')) return 'HB';\n\n      // Women's events\n      if (name.includes('uneven') || name.includes('bars')) return 'UB';\n      if (name.includes('beam') || name.includes('balance')) return 'BB';\n\n      return eventName;\n    }\n\n    /**\n     * Clear now-competing display for a team (when they finish or move to flash).\n     * @param {number} teamIndex - 1-based team index\n     */\n    function clearNowCompeting(teamIndex) {\n      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n      if (!slotContent) return;\n\n      // Don't clear if a score flash is showing\n      if (state.activeFlashes[teamIndex]) return;\n\n      // Only animate if there's content to clear\n      if (slotContent.innerHTML.trim() === '') return;\n\n      // Check if showing now-competing content (has \"UP NOW\" label)\n      if (!slotContent.innerHTML.includes('UP NOW')) return;\n\n      // Trigger spin-out animation\n      slotContent.classList.remove('spin-in', 'visible');\n      slotContent.classList.add('spin-out');\n\n      // Clear content after animation completes\n      setTimeout(() => {\n        if (!state.activeFlashes[teamIndex]) {\n          slotContent.innerHTML = '';\n          slotContent.classList.remove('spin-out');\n        }\n      }, 400);  // Match CSS animation duration\n    }\n\n    /**\n     * Update now-competing displays for all teams based on current state.\n     * Called after processApiData detects now-competing changes.\n     *\n     * Behavior differs by mode:\n     * - Auto mode (B3): Automatically show all detected now-competing athletes\n     * - Manual mode (B4): Only show when producer explicitly enables via Firebase nowCompeting\n     */\n    function updateAllNowCompeting() {\n      state.teams.forEach((team, idx) => {\n        const teamIndex = team.index;\n        const nowCompeting = state.nowCompeting.find(nc => nc.teamIndex === idx);\n\n        // Determine if we should show now-competing for this team\n        let shouldShow = false;\n\n        if (state.automationMode === 'auto') {\n          // Auto mode (B3): Show if detected\n          shouldShow = !!nowCompeting;\n        } else {\n          // Manual mode (B4): Only show if producer has enabled AND we have data\n          shouldShow = !!nowCompeting && state.manualNowCompeting[teamIndex] === true;\n        }\n\n        if (shouldShow && nowCompeting) {\n          renderNowCompeting(teamIndex, nowCompeting);\n        } else {\n          clearNowCompeting(teamIndex);\n        }\n      });\n    }\n\n    /**\n     * Get current flash queue status for debugging/producer panel.\n     * @returns {Object} Queue status by team\n     */\n    function getFlashQueueStatus() {\n      const status = {};\n      state.teams.forEach((team) => {\n        const queue = state.flashQueues[team.index] || [];\n        const active = state.activeFlashes[team.index];\n        status[team.index] = {\n          teamName: team.name,\n          queueLength: queue.length,\n          activeFlash: active ? {\n            gymnast: active.name,\n            score: active.score,\n            timeRemaining: active.startTime ?\n              Math.max(0, state.flashDuration - (Date.now() - active.startTime)) : 0\n          } : null\n        };\n      });\n      return status;\n    }\n\n    // ============================================================\n    // ROTATION DETECTION (Task A10)\n    // ============================================================\n\n    /**\n     * Determine if a team is on BYE for the current rotation (BUG-009).\n     * A team is on bye if they have no event scheduled for the current rotation.\n     * This only applies to meets with more teams than apparatus (e.g., 7-team women's).\n     * @param {Object} apiTeam - Team data from Virtius API\n     * @param {number} currentRotation - Current rotation number (1-based)\n     * @returns {boolean} True if team is on bye\n     */\n    function isTeamOnBye(apiTeam, currentRotation) {\n      if (!apiTeam || !apiTeam.events) return false;\n\n      // Check if any event is scheduled for this rotation\n      const eventThisRotation = apiTeam.events.find(e => e.rotation === currentRotation);\n      return !eventThisRotation;\n    }\n\n    /**\n     * Update team row bye states based on current rotation.\n     * Called after rotation is detected from API data.\n     */\n    function updateTeamByeStates() {\n      const apiTeams = state.lastApiTeams || [];\n      const currentRotation = state.rotation.current;\n      const eventCount = state.gender === 'womens' ? 4 : 6;\n      const hasByes = state.teams.length > eventCount;\n\n      // Only process bye states for meets with byes\n      if (!hasByes) {\n        // Remove any stale bye classes\n        state.teams.forEach((team) => {\n          const rowEl = document.querySelector(`.team-row[data-team-index=\"${team.index}\"]`);\n          if (rowEl) rowEl.classList.remove('on-bye');\n        });\n        return;\n      }\n\n      state.teams.forEach((team, idx) => {\n        const apiTeam = apiTeams[idx];\n        const rowEl = document.querySelector(`.team-row[data-team-index=\"${team.index}\"]`);\n        if (!rowEl) return;\n\n        const onBye = isTeamOnBye(apiTeam, currentRotation);\n\n        if (onBye) {\n          rowEl.classList.add('on-bye');\n          // Show BYE indicator in slot if no active flash\n          if (!state.activeFlashes[team.index]) {\n            const slotContent = document.getElementById(`slotContent${team.index}`);\n            if (slotContent && !slotContent.innerHTML.includes('bye-indicator')) {\n              slotContent.innerHTML = '<span class=\"bye-indicator\">BYE</span>';\n              slotContent.classList.add('visible');\n            }\n          }\n        } else {\n          rowEl.classList.remove('on-bye');\n          // Clear BYE indicator if it was showing\n          const slotContent = document.getElementById(`slotContent${team.index}`);\n          if (slotContent && slotContent.innerHTML.includes('bye-indicator')) {\n            slotContent.innerHTML = '';\n            slotContent.classList.remove('visible');\n          }\n        }\n      });\n    }\n\n    /**\n     * Detect current rotation from API data using ALL teams.\n     * For standard meets (teams <= apparatus): rotation advances when ALL teams\n     * have completed their current event.\n     * For meets with byes (teams > apparatus, e.g., 7-team women's): uses the\n     * API's rotation field on events to determine the current rotation.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @returns {Object} { current: number, total: number, isFinal: boolean }\n     */\n    function detectRotation(apiTeams) {\n      if (!apiTeams || apiTeams.length === 0) {\n        return state.rotation;  // Keep existing state if no data\n      }\n\n      const totalRotations = state.rotation.total;\n      const eventCount = state.gender === 'womens' ? 4 : 6;\n      const hasByes = state.teams.length > eventCount;\n\n      if (hasByes) {\n        // For meets with byes, use the API's rotation field on events\n        // to detect which rotation is currently in progress or most recently completed\n        return detectRotationFromApiFields(apiTeams, totalRotations);\n      }\n\n      // Standard detection: min completed events across ALL teams\n      let minCompletedAcrossTeams = totalRotations;\n\n      apiTeams.forEach((team) => {\n        const events = team.events || [];\n        let completedEvents = 0;\n\n        events.forEach((event) => {\n          const gymnasts = event.gymnasts || [];\n          // An event is \"complete\" if all gymnasts have scores\n          const scored = gymnasts.filter(g => g.final_score != null);\n          if (scored.length === gymnasts.length && gymnasts.length > 0) {\n            completedEvents++;\n          }\n        });\n\n        minCompletedAcrossTeams = Math.min(minCompletedAcrossTeams, completedEvents);\n      });\n\n      // All events complete for all teams = Final\n      if (minCompletedAcrossTeams === totalRotations) {\n        return { current: totalRotations, total: totalRotations, isFinal: true };\n      }\n\n      // Current rotation = completed events + 1\n      const currentRotation = minCompletedAcrossTeams + 1;\n      return { current: currentRotation, total: totalRotations, isFinal: false };\n    }\n\n    /**\n     * Detect rotation for meets with byes using the API's rotation field.\n     * Finds the highest rotation number that has at least one score in progress.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @param {number} totalRotations - Total rotation count for this meet\n     * @returns {Object} { current: number, total: number, isFinal: boolean }\n     */\n    function detectRotationFromApiFields(apiTeams, totalRotations) {\n      let maxRotationWithScores = 0;\n      let allEventsComplete = true;\n\n      apiTeams.forEach((team) => {\n        (team.events || []).forEach((event) => {\n          const rotation = event.rotation;\n          if (!rotation) return;\n\n          const gymnasts = event.gymnasts || [];\n          const scored = gymnasts.filter(g => g.final_score != null);\n\n          if (scored.length > 0) {\n            maxRotationWithScores = Math.max(maxRotationWithScores, rotation);\n          }\n          // Check if any event is still incomplete\n          if (scored.length < gymnasts.length) {\n            allEventsComplete = false;\n          }\n        });\n      });\n\n      if (allEventsComplete && maxRotationWithScores > 0) {\n        return { current: totalRotations, total: totalRotations, isFinal: true };\n      }\n\n      const currentRotation = Math.max(1, maxRotationWithScores);\n      return { current: currentRotation, total: totalRotations, isFinal: false };\n    }\n\n    /**\n     * Detect the currently competing athlete for a team.\n     * Finds the next athlete without a score in an event that has some scores.\n     * Based on logic from GraphicsControl.jsx:216-269.\n     * @param {Object} team - Team object from Virtius API\n     * @returns {Object|null} { athlete: Object, event: Object } or null\n     */\n    function detectNowCompeting(team) {\n      if (!team || !team.events) return null;\n\n      // Olympic order for events (already sorted in API, but just in case)\n      const events = team.events;\n\n      for (const event of events) {\n        const gymnasts = event.gymnasts || [];\n        if (gymnasts.length === 0) continue;\n\n        // Sort by order (lineup position)\n        const sortedGymnasts = [...gymnasts].sort((a, b) => (a.order || 0) - (b.order || 0));\n\n        // Find scored and unscored athletes\n        const scored = sortedGymnasts.filter(g => g.final_score != null);\n        const unscored = sortedGymnasts.filter(g => g.final_score == null);\n\n        // If this event has some scores but not all, it's in progress\n        if (scored.length > 0 && unscored.length > 0) {\n          return {\n            athlete: unscored[0],\n            event: event\n          };\n        }\n      }\n\n      return null; // No one currently competing (between rotations or complete)\n    }\n\n    /**\n     * Detect now-competing athletes for all teams and return results.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @returns {Array} Array of { teamIndex, teamName, tricode, athlete, eventName }\n     */\n    function detectAllNowCompeting(apiTeams) {\n      if (!apiTeams || apiTeams.length === 0) return [];\n\n      const results = [];\n\n      apiTeams.forEach((team, teamIndex) => {\n        const nowCompeting = detectNowCompeting(team);\n        if (nowCompeting) {\n          results.push({\n            teamIndex: teamIndex,\n            teamKey: team.short_name || `team${teamIndex + 1}`,\n            teamName: team.name,\n            tricode: team.tricode,\n            athlete: {\n              id: nowCompeting.athlete.gymnast_id,\n              name: nowCompeting.athlete.full_name,\n              firstName: nowCompeting.athlete.first_name || '',\n              lastName: nowCompeting.athlete.last_name || '',\n              apiHeadshot: nowCompeting.athlete.headshot || '',\n              order: nowCompeting.athlete.order,\n              type: nowCompeting.athlete.type // 0=competing, 1=exhibition, etc.\n            },\n            eventName: nowCompeting.event.event_name\n          });\n        }\n      });\n\n      return results;\n    }\n\n    /**\n     * Update the rotation tag display in the DOM.\n     * Shows \"Rotation X of Y\" or \"Final\" when complete.\n     */\n    function updateRotationTag() {\n      const tagEl = document.getElementById('rotationTag');\n      if (!tagEl) return;\n\n      const { current, total, isFinal } = state.rotation;\n\n      if (isFinal) {\n        tagEl.textContent = 'Final';\n      } else {\n        tagEl.textContent = `Rotation ${current} of ${total}`;\n      }\n    }\n\n    // Initialize Firebase schema with default values (prevents race conditions)\n    // Uses update() with null checks - only sets values that don't exist\n    async function initializeSchema() {\n      const defaultSchema = {\n        enabled: false,\n        polling: false,\n        automationMode: 'auto',\n        showLineup: null,\n        dismissFlash: {},\n        nowCompeting: {},\n        detected: {},\n        heartbeat: null,\n        liveData: {\n          lastPollTimestamp: null,\n          lastDataChangeTimestamp: null,\n          stalePollCount: 0,\n          rotation: null,\n          totalRotations: null,\n          teams: {}\n        },\n        lastError: null,\n        config: {\n          pollInterval: 5000,\n          flashDuration: 10000,\n          showStickIndicator: true\n        }\n      };\n\n      try {\n        // Use transaction to safely initialize schema without overwriting existing values\n        await scoreBugRef.transaction((currentData) => {\n          if (currentData === null) {\n            // No data exists - write full schema\n            console.log('Initializing scoreBug schema with defaults');\n            return defaultSchema;\n          }\n          // Data exists - merge defaults for any missing fields only\n          const merged = { ...defaultSchema };\n          Object.keys(currentData).forEach(key => {\n            if (currentData[key] !== undefined) {\n              // Keep existing value\n              merged[key] = currentData[key];\n            }\n          });\n          // Deep merge for nested objects (config, liveData)\n          if (currentData.config) {\n            merged.config = { ...defaultSchema.config, ...currentData.config };\n          }\n          if (currentData.liveData) {\n            merged.liveData = { ...defaultSchema.liveData, ...currentData.liveData };\n          }\n          console.log('Merged existing scoreBug data with defaults');\n          return merged;\n        });\n        console.log('Firebase schema initialized');\n      } catch (err) {\n        console.error('Failed to initialize schema:', err);\n      }\n    }\n\n    // Initialize on load\n    if (compId) {\n      // Start connection monitor immediately (A3d)\n      initConnectionMonitor();\n\n      // Order: load config -> render teams -> initialize schema -> start listeners\n      loadCompetitionConfig().then(async (success) => {\n        if (!success) return;  // Exit early, don't initialize listeners\n\n        // Render team rows with initial state (before API data)\n        renderTeamRows();\n\n        // Update rotation tag for correct total (4 for women, 6 for men)\n        updateRotationTag();\n\n        // Initialize Firebase schema (safe defaults)\n        await initializeSchema();\n\n        // Start listening for Firebase changes (only after successful config load)\n        initFirebaseListeners();\n      });\n    }\n  </script>\n  <script src=\"theme-loader.js\"></script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":1609,"oldLines":6,"newStart":1609,"newLines":9,"lines":["         await safeWrite(scoreBugRef.child('liveData/isFinal'), 'set', newRotation.isFinal);"," ","         console.log('Rotation updated:', newRotation);","+","+        // Update team bye states when rotation changes (BUG-009)","+        updateTeamByeStates();","       }"," ","       // Detect now-competing athletes (B1)"]}],"userModified":false,"replaceAll":false}}
