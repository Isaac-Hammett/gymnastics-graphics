e: 'FINAL SCORES' },\n    35→];\n    36→\n    37→// Leaderboard button mapping (uses short names for display)\n    38→const leaderboardButtonConfig = {\n    39→  floor: { id: 'leaderboard-fx', label: 'FX Leaders', leaderboardEvent: 'fx' },\n    40→  pommel: { id: 'leaderboard-ph', label: 'PH Leaders', leaderboardEvent: 'ph' },\n    41→  rings: { id: 'leaderboard-sr', label: 'SR Leaders', leaderboardEvent: 'sr' },\n    42→  vault: { id: 'leaderboard-vt', label: 'VT Leaders', leaderboardEvent: 'vt' },\n    43→  pBars: { id: 'leaderboard-pb', label: 'PB Leaders', leaderboardEvent: 'pb' },\n    44→  hBar: { id: 'leaderboard-hb', label: 'HB Leaders', leaderboardEvent: 'hb' },\n    45→  bars: { id: 'leaderboard-ub', label: 'UB Leaders', leaderboardEvent: 'ub' },\n    46→  beam: { id: 'leaderboard-bb', label: 'BB Leaders', leaderboardEvent: 'bb' },\n    47→};\n    48→\n    49→// AA leaderboard is always available\n    50→const commonLeaderboardButtons = [\n    51→  { id: 'leaderboard-aa', label: 'AA Leaders', leaderboardEvent: 'aa' },\n    52→];\n    53→\n    54→// All possible event frame IDs (for both genders)\n    55→const eventFrames = ['floor', 'pommel', 'rings', 'vault', 'pbars', 'hbar', 'ubars', 'beam', 'allaround', 'final'];\n    56→\n    57→const OUTPUT_BASE_URL = 'https://commentarygraphic.com/output.html';\n    58→const LOCAL_OUTPUT_URL = 'http://localhost:3003/output.html';\n    59→\n    60→const teamCounts = {\n    61→  'mens-dual': 2, 'womens-dual': 2,\n    62→  'mens-tri': 3, 'womens-tri': 3,\n    63→  'mens-quad': 4, 'womens-quad': 4,\n    64→  'mens-5': 5, 'womens-5': 5,\n    65→  'mens-6': 6, 'womens-6': 6,\n    66→  'womens-7': 7\n    67→};\n    68→\n    69→// Available themes for Event Summary\n    70→// Layout themes (start with 'layout-') change the entire structure\n    71→// Color themes just change colors of the default layout\n    72→const summaryThemes = [\n    73→  // LAYOUTS - Different structural designs\n    74→  { id: 'layout-broadcast-table