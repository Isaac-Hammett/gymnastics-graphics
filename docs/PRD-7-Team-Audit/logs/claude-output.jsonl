{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TxDMAgsWjfT1AvHesimuHK","type":"tool_result","content":"     1→#!/usr/bin/env node\n     2→/**\n     3→ * Alert System End-to-End Test Script\n     4→ *\n     5→ * Tests the complete alert flow:\n     6→ * - Alert creation via alertService\n     7→ * - Alert storage in Firebase\n     8→ * - Alert acknowledgement\n     9→ * - Alert auto-resolution\n    10→ *\n    11→ * Run with: node server/scripts/test-alert-system.js\n    12→ *\n    13→ * Requires server running on localhost:3003\n    14→ */\n    15→\n    16→const BASE_URL = process.env.SERVER_URL || 'http://localhost:3003';\n    17→\n    18→// Test results tracking\n    19→const results = {\n    20→  passed: 0,\n    21→  failed: 0,\n    22→  skipped: 0,\n    23→  tests: []\n    24→};\n    25→\n    26→/**\n    27→ * Run a test case\n    28→ */\n    29→async function test(name, fn) {\n    30→  try {\n    31→    await fn();\n    32→    results.passed++;\n    33→    results.tests.push({ name, status: 'passed' });\n    34→    console.log(`✓ ${name}`);\n    35→  } catch (error) {\n    36→    results.failed++;\n    37→    results.tests.push({ name, status: 'failed', error: error.message });\n    38→    console.log(`✗ ${name}: ${error.message}`);\n    39→  }\n    40→}\n    41→\n    42→/**\n    43→ * Skip a test with reason\n    44→ */\n    45→function skip(name, reason) {\n    46→  results.skipped++;\n    47→  results.tests.push({ name, status: 'skipped', reason });\n    48→  console.log(`○ ${name} (skipped: ${reason})`);\n    49→}\n    50→\n    51→/**\n    52→ * Assert helper\n    53→ */\n    54→function assert(condition, message) {\n    55→  if (!condition) {\n    56→    throw new Error(message);\n    57→  }\n    58→}\n    59→\n    60→/**\n    61→ * Make an API request\n    62→ */\n    63→async function api(method, path, body = null) {\n    64→  const options = {\n    65→    method,\n    66→    headers: {\n    67→      'Content-Type': 'application/json'\n    68→    }\n    69→  };\n    70→\n    71→  if (body) {\n    72→    options.body = JSON.stringify(body);\n    73→  }\n    74→\n    75→  const response = await fetch(`${BASE_URL}${path}`, options);\n    76→  const data = await response.json().catch(() => ({}));\n    77→\n    78→  return { status: response.status, ok: response.ok, data };\n    79→}\n    80→\n    81→/**\n    82→ * Wait for a condition to be true\n    83→ */\n    84→async function waitFor(condition, timeoutMs = 5000, intervalMs = 100) {\n    85→  const startTime = Date.now();\n    86→  while (Date.now() - startTime < timeoutMs) {\n    87→    if (await condition()) {\n    88→      return true;\n    89→    }\n    90→    await new Promise(resolve => setTimeout(resolve, intervalMs));\n    91→  }\n    92→  return false;\n    93→}\n    94→\n    95→// ============================================================\n    96→// Test Cases\n    97→// ============================================================\n    98→\n    99→async function runTests() {\n   100→  console.log('\\n========================================');\n   101→  console.log('Alert System End-to-End Tests');\n   102→  console.log('========================================\\n');\n   103→  console.log(`Server URL: ${BASE_URL}\\n`);\n   104→\n   105→  // Check server is running\n   106→  try {\n   107→    const { ok } = await api('GET', '/api/status');\n   108→    if (!ok) throw new Error('Server not responding');\n   109→  } catch (error) {\n   110→    console.error(`\\n❌ Server not running at ${BASE_URL}`);\n   111→    console.error('Start the server with: cd server && npm run dev\\n');\n   112→    process.exit(1);\n   113→  }\n   114→\n   115→  const testCompId = 'alert-test-' + Date.now();\n   116→  let createdAlertId = null;\n   117→  let firebaseAvailable = false;\n   118→\n   119→  // ------------------------------------------------------------\n   120→  // Server Status Tests\n   121→  // ------------------------------------------------------------\n   122→  console.log('\\n--- Server Status Tests ---\\n');\n   123→\n   124→  await test('Server is running and healthy', async () => {\n   125→    const { ok, data } = await api('GET', '/api/status');\n   126→    assert(ok, 'Server should respond with 200 OK');\n   127→    assert(typeof data === 'object', 'Server should return status object');\n   128→  });\n   129→\n   130→  // ------------------------------------------------------------\n   131→  // Alert API Tests\n   132→  // ------------------------------------------------------------\n   133→  console.log('\\n--- Alert API Tests ---\\n');\n   134→\n   135→  // Test alert creation endpoint (if available)\n   136→  await test('POST /api/alerts/:compId creates alert', async () => {\n   137→    const alertData = {\n   138→      level: 'critical',\n   139→      category: 'vm',\n   140→      title: 'Test Alert - VM Offline',\n   141→      message: 'Test VM is not responding. This is a test alert.',\n   142→      sourceId: `test-alert-${testCompId}`,\n   143→      metadata: {\n   144→        vmId: 'test-vm-001',\n   145→        publicIp: '192.168.1.1',\n   146→        reason: 'Test failure simulation'\n   147→      }\n   148→    };\n   149→\n   150→    const { status, ok, data } = await api('POST', `/api/alerts/${testCompId}`, alertData);\n   151→\n   152→    // If endpoint doesn't exist (404), this feature isn't exposed via REST\n   153→    if (status === 404) {\n   154→      throw new Error('Alert API endpoint not found - alerts created via vmHealthMonitor only');\n   155→    }\n   156→\n   157→    // If Firebase isn't configured, we get a 500 error\n   158→    if (status === 500) {\n   159→      if (data.error?.includes('Firebase') || data.error?.includes('not initialized')) {\n   160→        throw new Error('Firebase credentials not configured');\n   161→      }\n   162→      throw new Error(data.error || 'Server error');\n   163→    }\n   164→\n   165→    assert(ok, `Expected 200 OK, got ${status}: ${JSON.stringify(data)}`);\n   166→    assert(data.success || data.id, 'Response should indicate success or return alert ID');\n   167→    createdAlertId = data.id || data.alertId;\n   168→    firebaseAvailable = true;\n   169→  });\n   170→\n   171→  // If alert creation worked, test the rest of the flow\n   172→  if (createdAlertId && firebaseAvailable) {\n   173→    await test('GET /api/alerts/:compId returns active alerts', async () => {\n   174→      const { ok, data } = await api('GET', `/api/alerts/${testCompId}`);\n   175→      assert(ok, 'Should get alerts successfully');\n   176→      assert(Array.isArray(data.alerts || data), 'Should return alerts array');\n   177→\n   178→      const alerts = data.alerts || data;\n   179→      const testAlert = alerts.find(a => a.id === createdAlertId);\n   180→      assert(testAlert, 'Created alert should be in active alerts');\n   181→      assert(testAlert.level === 'critical', 'Alert level should be critical');\n   182→      assert(testAlert.resolved === false, 'Alert should not be resolved');\n   183→    });\n   184→\n   185→    await test('POST /api/alerts/:compId/:alertId/acknowledge acknowledges alert', async () => {\n   186→      const { ok, data } = await api('POST', `/api/alerts/${testCompId}/${createdAlertId}/acknowledge`);\n   187→      assert(ok, 'Should acknowledge alert successfully');\n   188→      assert(data.success || data.acknowledged, 'Response should indicate success');\n   189→    });\n   190→\n   191→    await test('Alert is acknowledged but not resolved', async () => {\n   192→      const { ok, data } = await api('GET', `/api/alerts/${testCompId}`);\n   193→      assert(ok, 'Should get alerts');\n   194→\n   195→      const alerts = data.alerts || data;\n   196→      const testAlert = alerts.find(a => a.id === createdAlertId);\n   197→      assert(testAlert, 'Alert should still exist');\n   198→      assert(testAlert.acknowledged === true, 'Alert should be acknowledged');\n   199→      assert(testAlert.resolved === false, 'Alert should not be resolved yet');\n   200→    });\n   201→\n   202→    await test('POST /api/alerts/:compId/:alertId/resolve resolves alert', async () => {\n   203→      const { ok, data } = await api('POST', `/api/alerts/${testCompId}/${createdAlertId}/resolve`);\n   204→      assert(ok, 'Should resolve alert successfully');\n   205→      assert(data.success || data.resolved, 'Response should indicate success');\n   206→    });\n   207→\n   208→    await test('Resolved alert is filtered from active alerts', async () => {\n   209→      const { ok, data } = await api('GET', `/api/alerts/${testCompId}`);\n   210→      assert(ok, 'Should get alerts');\n   211→\n   212→      const alerts = data.alerts || data;\n   213→      const testAlert = alerts.find(a => a.id === createdAlertId);\n   214→      assert(!testAlert, 'Resolved alert should not appear in active alerts');\n   215→    });\n   216→  } else {\n   217→    skip('GET /api/alerts/:compId', 'Alert creation failed or Firebase unavailable');\n   218→    skip('POST /api/alerts/:compId/:alertId/acknowledge', 'No alert to acknowledge');\n   219→    skip('Alert is acknowledged but not resolved', 'No alert to check');\n   220→    skip('POST /api/alerts/:compId/:alertId/resolve', 'No alert to resolve');\n   221→    skip('Resolved alert is filtered from active alerts', 'No alert to check');\n   222→  }\n   223→\n   224→  // ------------------------------------------------------------\n   225→  // Alert Service Module Tests (via direct require)\n   226→  // ------------------------------------------------------------\n   227→  console.log('\\n--- Alert Service Module Tests ---\\n');\n   228→\n   229→  await test('Alert service module exports correctly', async () => {\n   230→    // Test that the module can be imported\n   231→    const { status, data } = await api('GET', '/api/status');\n   232→    assert(status === 200, 'Server should be running with alert service loaded');\n   233→    // If we get here, the server started which means alertService loaded\n   234→  });\n   235→\n   236→  // ------------------------------------------------------------\n   237→  // Auto-Resolution Tests\n   238→  // ------------------------------------------------------------\n   239→  console.log('\\n--- Auto-Resolution Tests ---\\n');\n   240→\n   241→  // Create a new alert for auto-resolution testing\n   242→  let autoResolveAlertId = null;\n   243→\n   244→  await test('Create alert for auto-resolution test', async () => {\n   245→    if (!firebaseAvailable) {\n   246→      throw new Error('Firebase not available');\n   247→    }\n   248→\n   249→    const alertData = {\n   250→      level: 'warning',\n   251→      category: 'service',\n   252→      title: 'Test Alert - Service Degraded',\n   253→      message: 'Test service is experiencing issues. Will auto-resolve.',\n   254→      sourceId: `auto-resolve-test-${testCompId}`,\n   255→      metadata: {\n   256→        testId: testCompId\n   257→      }\n   258→    };\n   259→\n   260→    const { ok, data } = await api('POST', `/api/alerts/${testCompId}`, alertData);\n   261→    if (!ok) throw new Error('Failed to create alert');\n   262→    autoResolveAlertId = data.id || data.alertId;\n   263→    assert(autoResolveAlertId, 'Should get alert ID');\n   264→  });\n   265→\n   266→  if (autoResolveAlertId && firebaseAvailable) {\n   267→    await test('POST /api/alerts/:compId/resolve-by-source resolves by sourceId', async () => {\n   268→      const { ok, data } = await api('POST', `/api/alerts/${testCompId}/resolve-by-source`, {\n   269→        sourceId: `auto-resolve-test-${testCompId}`\n   270→      });\n   271→\n   272→      // If endpoint doesn't exist, skip\n   273→      if (!ok && data.error?.includes('not found')) {\n   274→        throw new Error('Endpoint not implemented - auto-resolution via vmHealthMonitor');\n   275→      }\n   276→\n   277→      assert(ok, `Should resolve by sourceId: ${JSON.stringify(data)}`);\n   278→      assert(data.count >= 0 || data.success, 'Should indicate resolution count or success');\n   279→    });\n   280→  } else {\n   281→    skip('POST /api/alerts/:compId/resolve-by-source', 'No alert to auto-resolve');\n   282→  }\n   283→\n   284→  // ------------------------------------------------------------\n   285→  // Alert Counts Tests\n   286→  // ------------------------------------------------------------\n   287→  console.log('\\n--- Alert Counts Tests ---\\n');\n   288→\n   289→  await test('GET /api/alerts/:compId/counts returns alert counts', async () => {\n   290→    if (!firebaseAvailable) {\n   291→      throw new Error('Firebase not available');\n   292→    }\n   293→\n   294→    const { status, ok, data } = await api('GET', `/api/alerts/${testCompId}/counts`);\n   295→\n   296→    // If endpoint doesn't exist\n   297→    if (status === 404) {\n   298→      throw new Error('Counts endpoint not implemented');\n   299→    }\n   300→\n   301→    assert(ok, `Should get counts: ${JSON.stringify(data)}`);\n   302→    assert(typeof data.total === 'number', 'Should have total count');\n   303→    assert(typeof data.critical === 'number', 'Should have critical count');\n   304→    assert(typeof data.warning === 'number', 'Should have warning count');\n   305→    assert(typeof data.info === 'number', 'Should have info count');\n   306→  });\n   307→\n   308→  // ------------------------------------------------------------\n   309→  // UI Integration Verification\n   310→  // ------------------------------------------------------------\n   311→  console.log('\\n--- UI Integration Verification ---\\n');\n   312→\n   313→  await test('Producer view loads without errors', async () => {\n   314→    // This tests that the client can load (if dev server is running)\n   315→    // We'll just verify the server side is ready for the client\n   316→    const { ok } = await api('GET', '/api/status');\n   317→    assert(ok, 'Server should be ready for client connections');\n   318→  });\n   319→\n   320→  // ------------------------------------------------------------\n   321→  // Cleanup\n   322→  // ------------------------------------------------------------\n   323→  console.log('\\n--- Cleanup ---\\n');\n   324→\n   325→  if (firebaseAvailable) {\n   326→    await test('Cleanup test alerts', async () => {\n   327→      // Try to clean up any remaining test alerts\n   328→      const { data } = await api('GET', `/api/alerts/${testCompId}`);\n   329→      const alerts = data.alerts || data || [];\n   330→\n   331→      let cleanedCount = 0;\n   332→      for (const alert of alerts) {\n   333→        if (alert && alert.id) {\n   334→          await api('POST', `/api/alerts/${testCompId}/${alert.id}/resolve`);\n   335→          cleanedCount++;\n   336→        }\n   337→      }\n   338→\n   339→      console.log(`  Cleaned up ${cleanedCount} test alerts`);\n   340→    });\n   341→  } else {\n   342→    skip('Cleanup test alerts', 'Firebase not available');\n   343→  }\n   344→\n   345→  // ------------------------------------------------------------\n   346→  // Results Summary\n   347→  // ------------------------------------------------------------\n   348→  console.log('\\n========================================');\n   349→  console.log('Test Results Summary');\n   350→  console.log('========================================\\n');\n   351→  console.log(`Passed:  ${results.passed}`);\n   352→  console.log(`Failed:  ${results.failed}`);\n   353→  console.log(`Skipped: ${results.skipped}`);\n   354→  console.log(`Total:   ${results.tests.length}`);\n   355→\n   356→  if (results.failed > 0) {\n   357→    console.log('\\nFailed Tests:');\n   358→    results.tests\n   359→      .filter(t => t.status === 'failed')\n   360→      .forEach(t => console.log(`  - ${t.name}: ${t.error}`));\n   361→  }\n   362→\n   363→  // Note about what this validates\n   364→  console.log('\\n========================================');\n   365→  console.log('Alert System Verification Summary');\n   366→  console.log('========================================\\n');\n   367→  console.log('This test validates the alert system components:');\n   368→  console.log('');\n   369→  console.log('✓ Server-side alertService.js:');\n   370→  console.log('  - Creates alerts with auto-generated IDs');\n   371→  console.log('  - Stores alerts in Firebase at alerts/{competitionId}/');\n   372→  console.log('  - Acknowledges alerts (marks as seen)');\n   373→  console.log('  - Resolves alerts (marks as resolved)');\n   374→  console.log('  - Auto-resolves alerts by sourceId');\n   375→  console.log('  - Emits socket events for real-time updates');\n   376→  console.log('');\n   377→  console.log('✓ Server-side vmHealthMonitor.js:');\n   378→  console.log('  - Creates critical alerts when VM is unreachable');\n   379→  console.log('  - Creates critical alerts when OBS disconnects');\n   380→  console.log('  - Auto-resolves alerts when VM recovers');\n   381→  console.log('  - Creates info alerts on idle timeout');\n   382→  console.log('');\n   383→  console.log('✓ Client-side useAlerts hook:');\n   384→  console.log('  - Subscribes to Firebase alerts/{competitionId}/');\n   385→  console.log('  - Filters to unresolved alerts');\n   386→  console.log('  - Sorts by level (critical > warning > info) then timestamp');\n   387→  console.log('  - Returns counts: criticalCount, warningCount, infoCount');\n   388→  console.log('  - Returns hasUnacknowledgedCritical boolean');\n   389→  console.log('  - Actions: acknowledgeAlert, acknowledgeAll');\n   390→  console.log('');\n   391→  console.log('✓ Client-side AlertPanel component:');\n   392→  console.log('  - Collapsible panel design');\n   393→  console.log('  - Groups alerts by level');\n   394→  console.log('  - Shows timestamp, title, message');\n   395→  console.log('  - Acknowledge button per alert');\n   396→  console.log('  - Acknowledge All button');\n   397→  console.log('  - Empty state when no alerts');\n   398→  console.log('');\n   399→  console.log('✓ ProducerView integration:');\n   400→  console.log('  - Critical alert banner at top (always visible)');\n   401→  console.log('  - AlertPanel in right column');\n   402→  console.log('  - Alert count badges in header');\n   403→  console.log('');\n   404→\n   405→  // Return results for programmatic use\n   406→  return {\n   407→    success: results.failed === 0,\n   408→    ...results\n   409→  };\n   410→}\n   411→\n   412→// Run tests\n   413→runTests()\n   414→  .then(results => {\n   415→    process.exit(results.success ? 0 : 1);\n   416→  })\n   417→  .catch(error => {\n   418→    console.error('\\n❌ Test runner error:', error.message);\n   419→    process.exit(1);\n   420→  });\n   421→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f403b4ff-09b5-4afb-92d0-74c6f663a833","uuid":"d08f83f1-8cb5-4ee2-9495-3d264d137181","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/server/scripts/test-alert-system.js","content":"#!/usr/bin/env node\n/**\n * Alert System End-to-End Test Script\n *\n * Tests the complete alert flow:\n * - Alert creation via alertService\n * - Alert storage in Firebase\n * - Alert acknowledgement\n * - Alert auto-resolution\n *\n * Run with: node server/scripts/test-alert-system.js\n *\n * Requires server running on localhost:3003\n */\n\nconst BASE_URL = process.env.SERVER_URL || 'http://localhost:3003';\n\n// Test results tracking\nconst results = {\n  passed: 0,\n  failed: 0,\n  skipped: 0,\n  tests: []\n};\n\n/**\n * Run a test case\n */\nasync function test(name, fn) {\n  try {\n    await fn();\n    results.passed++;\n    results.tests.push({ name, status: 'passed' });\n    console.log(`✓ ${name}`);\n  } catch (error) {\n    results.failed++;\n    results.tests.push({ name, status: 'failed', error: error.message });\n    console.log(`✗ ${name}: ${error.message}`);\n  }\n}\n\n/**\n * Skip a test with reason\n */\nfunction skip(name, reason) {\n  results.skipped++;\n  results.tests.push({ name, status: 'skipped', reason });\n  console.log(`○ ${name} (skipped: ${reason})`);\n}\n\n/**\n * Assert helper\n */\nfunction assert(condition, message) {\n  if (!condition) {\n    throw new Error(message);\n  }\n}\n\n/**\n * Make an API request\n */\nasync function api(method, path, body = null) {\n  const options = {\n    method,\n    headers: {\n      'Content-Type': 'application/json'\n    }\n  };\n\n  if (body) {\n    options.body = JSON.stringify(body);\n  }\n\n  const response = await fetch(`${BASE_URL}${path}`, options);\n  const data = await response.json().catch(() => ({}));\n\n  return { status: response.status, ok: response.ok, data };\n}\n\n/**\n * Wait for a condition to be true\n */\nasync function waitFor(condition, timeoutMs = 5000, intervalMs = 100) {\n  const startTime = Date.now();\n  while (Date.now() - startTime < timeoutMs) {\n    if (await condition()) {\n      return true;\n    }\n    await new Promise(resolve => setTimeout(resolve, intervalMs));\n  }\n  return false;\n}\n\n// ============================================================\n// Test Cases\n// ============================================================\n\nasync function runTests() {\n  console.log('\\n========================================');\n  console.log('Alert System End-to-End Tests');\n  console.log('========================================\\n');\n  console.log(`Server URL: ${BASE_URL}\\n`);\n\n  // Check server is running\n  try {\n    const { ok } = await api('GET', '/api/status');\n    if (!ok) throw new Error('Server not responding');\n  } catch (error) {\n    console.error(`\\n❌ Server not running at ${BASE_URL}`);\n    console.error('Start the server with: cd server && npm run dev\\n');\n    process.exit(1);\n  }\n\n  const testCompId = 'alert-test-' + Date.now();\n  let createdAlertId = null;\n  let firebaseAvailable = false;\n\n  // ------------------------------------------------------------\n  // Server Status Tests\n  // ------------------------------------------------------------\n  console.log('\\n--- Server Status Tests ---\\n');\n\n  await test('Server is running and healthy', async () => {\n    const { ok, data } = await api('GET', '/api/status');\n    assert(ok, 'Server should respond with 200 OK');\n    assert(typeof data === 'object', 'Server should return status object');\n  });\n\n  // ------------------------------------------------------------\n  // Alert API Tests\n  // ------------------------------------------------------------\n  console.log('\\n--- Alert API Tests ---\\n');\n\n  // Test alert creation endpoint (if available)\n  await test('POST /api/alerts/:compId creates alert', async () => {\n    const alertData = {\n      level: 'critical',\n      category: 'vm',\n      title: 'Test Alert - VM Offline',\n      message: 'Test VM is not responding. This is a test alert.',\n      sourceId: `test-alert-${testCompId}`,\n      metadata: {\n        vmId: 'test-vm-001',\n        publicIp: '192.168.1.1',\n        reason: 'Test failure simulation'\n      }\n    };\n\n    const { status, ok, data } = await api('POST', `/api/alerts/${testCompId}`, alertData);\n\n    // If endpoint doesn't exist (404), this feature isn't exposed via REST\n    if (status === 404) {\n      throw new Error('Alert API endpoint not found - alerts created via vmHealthMonitor only');\n    }\n\n    // If Firebase isn't configured, we get a 500 error\n    if (status === 500) {\n      if (data.error?.includes('Firebase') || data.error?.includes('not initialized')) {\n        throw new Error('Firebase credentials not configured');\n      }\n      throw new Error(data.error || 'Server error');\n    }\n\n    assert(ok, `Expected 200 OK, got ${status}: ${JSON.stringify(data)}`);\n    assert(data.success || data.id, 'Response should indicate success or return alert ID');\n    createdAlertId = data.id || data.alertId;\n    firebaseAvailable = true;\n  });\n\n  // If alert creation worked, test the rest of the flow\n  if (createdAlertId && firebaseAvailable) {\n    await test('GET /api/alerts/:compId returns active alerts', async () => {\n      const { ok, data } = await api('GET', `/api/alerts/${testCompId}`);\n      assert(ok, 'Should get alerts successfully');\n      assert(Array.isArray(data.alerts || data), 'Should return alerts array');\n\n      const alerts = data.alerts || data;\n      const testAlert = alerts.find(a => a.id === createdAlertId);\n      assert(testAlert, 'Created alert should be in active alerts');\n      assert(testAlert.level === 'critical', 'Alert level should be critical');\n      assert(testAlert.resolved === false, 'Alert should not be resolved');\n    });\n\n    await test('POST /api/alerts/:compId/:alertId/acknowledge acknowledges alert', async () => {\n      const { ok, data } = await api('POST', `/api/alerts/${testCompId}/${createdAlertId}/acknowledge`);\n      assert(ok, 'Should acknowledge alert successfully');\n      assert(data.success || data.acknowledged, 'Response should indicate success');\n    });\n\n    await test('Alert is acknowledged but not resolved', async () => {\n      const { ok, data } = await api('GET', `/api/alerts/${testCompId}`);\n      assert(ok, 'Should get alerts');\n\n      const alerts = data.alerts || data;\n      const testAlert = alerts.find(a => a.id === createdAlertId);\n      assert(testAlert, 'Alert should still exist');\n      assert(testAlert.acknowledged === true, 'Alert should be acknowledged');\n      assert(testAlert.resolved === false, 'Alert should not be resolved yet');\n    });\n\n    await test('POST /api/alerts/:compId/:alertId/resolve resolves alert', async () => {\n      const { ok, data } = await api('POST', `/api/alerts/${testCompId}/${createdAlertId}/resolve`);\n      assert(ok, 'Should resolve alert successfully');\n      assert(data.success || data.resolved, 'Response should indicate success');\n    });\n\n    await test('Resolved alert is filtered from active alerts', async () => {\n      const { ok, data } = await api('GET', `/api/alerts/${testCompId}`);\n      assert(ok, 'Should get alerts');\n\n      const alerts = data.alerts || data;\n      const testAlert = alerts.find(a => a.id === createdAlertId);\n      assert(!testAlert, 'Resolved alert should not appear in active alerts');\n    });\n  } else {\n    skip('GET /api/alerts/:compId', 'Alert creation failed or Firebase unavailable');\n    skip('POST /api/alerts/:compId/:alertId/acknowledge', 'No alert to acknowledge');\n    skip('Alert is acknowledged but not resolved', 'No alert to check');\n    skip('POST /api/alerts/:compId/:alertId/resolve', 'No alert to resolve');\n    skip('Resolved alert is filtered from active alerts', 'No alert to check');\n  }\n\n  // ------------------------------------------------------------\n  // Alert Service Module Tests (via direct require)\n  // ------------------------------------------------------------\n  console.log('\\n--- Alert Service Module Tests ---\\n');\n\n  await test('Alert service module exports correctly', async () => {\n    // Test that the module can be imported\n    const { status, data } = await api('GET', '/api/status');\n    assert(status === 200, 'Server should be running with alert service loaded');\n    // If we get here, the server started which means alertService loaded\n  });\n\n  // ------------------------------------------------------------\n  // Auto-Resolution Tests\n  // ------------------------------------------------------------\n  console.log('\\n--- Auto-Resolution Tests ---\\n');\n\n  // Create a new alert for auto-resolution testing\n  let autoResolveAlertId = null;\n\n  await test('Create alert for auto-resolution test', async () => {\n    if (!firebaseAvailable) {\n      throw new Error('Firebase not available');\n    }\n\n    const alertData = {\n      level: 'warning',\n      category: 'service',\n      title: 'Test Alert - Service Degraded',\n      message: 'Test service is experiencing issues. Will auto-resolve.',\n      sourceId: `auto-resolve-test-${testCompId}`,\n      metadata: {\n        testId: testCompId\n      }\n    };\n\n    const { ok, data } = await api('POST', `/api/alerts/${testCompId}`, alertData);\n    if (!ok) throw new Error('Failed to create alert');\n    autoResolveAlertId = data.id || data.alertId;\n    assert(autoResolveAlertId, 'Should get alert ID');\n  });\n\n  if (autoResolveAlertId && firebaseAvailable) {\n    await test('POST /api/alerts/:compId/resolve-by-source resolves by sourceId', async () => {\n      const { ok, data } = await api('POST', `/api/alerts/${testCompId}/resolve-by-source`, {\n        sourceId: `auto-resolve-test-${testCompId}`\n      });\n\n      // If endpoint doesn't exist, skip\n      if (!ok && data.error?.includes('not found')) {\n        throw new Error('Endpoint not implemented - auto-resolution via vmHealthMonitor');\n      }\n\n      assert(ok, `Should resolve by sourceId: ${JSON.stringify(data)}`);\n      assert(data.count >= 0 || data.success, 'Should indicate resolution count or success');\n    });\n  } else {\n    skip('POST /api/alerts/:compId/resolve-by-source', 'No alert to auto-resolve');\n  }\n\n  // ------------------------------------------------------------\n  // Alert Counts Tests\n  // ------------------------------------------------------------\n  console.log('\\n--- Alert Counts Tests ---\\n');\n\n  await test('GET /api/alerts/:compId/counts returns alert counts', async () => {\n    if (!firebaseAvailable) {\n      throw new Error('Firebase not available');\n    }\n\n    const { status, ok, data } = await api('GET', `/api/alerts/${testCompId}/counts`);\n\n    // If endpoint doesn't exist\n    if (status === 404) {\n      throw new Error('Counts endpoint not implemented');\n    }\n\n    assert(ok, `Should get counts: ${JSON.stringify(data)}`);\n    assert(typeof data.total === 'number', 'Should have total count');\n    assert(typeof data.critical === 'number', 'Should have critical count');\n    assert(typeof data.warning === 'number', 'Should have warning count');\n    assert(typeof data.info === 'number', 'Should have info count');\n  });\n\n  // ------------------------------------------------------------\n  // UI Integration Verification\n  // ------------------------------------------------------------\n  console.log('\\n--- UI Integration Verification ---\\n');\n\n  await test('Producer view loads without errors', async () => {\n    // This tests that the client can load (if dev server is running)\n    // We'll just verify the server side is ready for the client\n    const { ok } = await api('GET', '/api/status');\n    assert(ok, 'Server should be ready for client connections');\n  });\n\n  // ------------------------------------------------------------\n  // Cleanup\n  // ------------------------------------------------------------\n  console.log('\\n--- Cleanup ---\\n');\n\n  if (firebaseAvailable) {\n    await test('Cleanup test alerts', async () => {\n      // Try to clean up any remaining test alerts\n      const { data } = await api('GET', `/api/alerts/${testCompId}`);\n      const alerts = data.alerts || data || [];\n\n      let cleanedCount = 0;\n      for (const alert of alerts) {\n        if (alert && alert.id) {\n          await api('POST', `/api/alerts/${testCompId}/${alert.id}/resolve`);\n          cleanedCount++;\n        }\n      }\n\n      console.log(`  Cleaned up ${cleanedCount} test alerts`);\n    });\n  } else {\n    skip('Cleanup test alerts', 'Firebase not available');\n  }\n\n  // ------------------------------------------------------------\n  // Results Summary\n  // ------------------------------------------------------------\n  console.log('\\n========================================');\n  console.log('Test Results Summary');\n  console.log('========================================\\n');\n  console.log(`Passed:  ${results.passed}`);\n  console.log(`Failed:  ${results.failed}`);\n  console.log(`Skipped: ${results.skipped}`);\n  console.log(`Total:   ${results.tests.length}`);\n\n  if (results.failed > 0) {\n    console.log('\\nFailed Tests:');\n    results.tests\n      .filter(t => t.status === 'failed')\n      .forEach(t => console.log(`  - ${t.name}: ${t.error}`));\n  }\n\n  // Note about what this validates\n  console.log('\\n========================================');\n  console.log('Alert System Verification Summary');\n  console.log('========================================\\n');\n  console.log('This test validates the alert system components:');\n  console.log('');\n  console.log('✓ Server-side alertService.js:');\n  console.log('  - Creates alerts with auto-generated IDs');\n  console.log('  - Stores alerts in Firebase at alerts/{competitionId}/');\n  console.log('  - Acknowledges alerts (marks as seen)');\n  console.log('  - Resolves alerts (marks as resolved)');\n  console.log('  - Auto-resolves alerts by sourceId');\n  console.log('  - Emits socket events for real-time updates');\n  console.log('');\n  console.log('✓ Server-side vmHealthMonitor.js:');\n  console.log('  - Creates critical alerts when VM is unreachable');\n  console.log('  - Creates critical alerts when OBS disconnects');\n  console.log('  - Auto-resolves alerts when VM recovers');\n  console.log('  - Creates info alerts on idle timeout');\n  console.log('');\n  console.log('✓ Client-side useAlerts hook:');\n  console.log('  - Subscribes to Firebase alerts/{competitionId}/');\n  console.log('  - Filters to unresolved alerts');\n  console.log('  - Sorts by level (critical > warning > info) then timestamp');\n  console.log('  - Returns counts: criticalCount, warningCount, infoCount');\n  console.log('  - Returns hasUnacknowledgedCritical boolean');\n  console.log('  - Actions: acknowledgeAlert, acknowledgeAll');\n  console.log('');\n  console.log('✓ Client-side AlertPanel component:');\n  console.log('  - Collapsible panel design');\n  console.log('  - Groups alerts by level');\n  console.log('  - Shows timestamp, title, message');\n  console.log('  - Acknowledge button per alert');\n  console.log('  - Acknowledge All button');\n  console.log('  - Empty state when no alerts');\n  console.log('');\n  console.log('✓ ProducerView integration:');\n  console.log('  - Critical alert banner at top (always visible)');\n  console.log('  - AlertPanel in right column');\n  console.log('  - Alert count badges in header');\n  console.log('');\n\n  // Return results for programmatic use\n  return {\n    success: results.failed === 0,\n    ...results\n  };\n}\n\n// Run tests\nrunTests()\n  .then(results => {\n    process.exit(results.success ? 0 : 1);\n  })\n  .catch(error => {\n    console.error('\\n❌ Test runner error:', error.message);\n    process.exit(1);\n  });\n","numLines":421,"startLine":1,"totalLines":421}}}
