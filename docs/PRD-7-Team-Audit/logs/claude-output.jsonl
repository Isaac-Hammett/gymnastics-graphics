ank(eventName, g.gymnast_id, score) : null;\n            const athleteRankHtml = athleteRank && athleteRank <= 3\n              ? `<div class=\"athlete-rank rank-${athleteRank}\">${athleteRank}</div>`\n              : '';\n\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                ${athleteRankHtml}\n                <div class=\"athlete-sv\">${startValue > 0 ? startValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-left\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${eventDisplayName}</div>\n              </div>\n              <div class=\"header-right\">\n                <div class=\"rank-badge${rankClass}\">${rank}</div>\n                <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-v21 teams-${numTeams}\">${columnsHtml}</div>`;\n    }\n\n    function renderMultiTeamSummaryV22(contentEl, rotationData, rotation, numTeams, apparatusRankings = {}) {\n      // V22: Same as V21 but ranking is integrated into the order bubble\n      // For 5-team layouts, rankings are hidden to reduce clutter\n      const showRankings = numTeams !== 5;\n\n      const maxAthletes = Math.min(\n        Math.max(...rotationData.map(t => t.gymnasts.length)),\n        10\n      );\n\n      // Calculate ranks based on totalScore\n      const rankedTeams = rotationData\n        .map((t, idx) => ({ idx, score: t.totalScore || 0 }))\n        .sort((a, b) => b.score - a.score);\n\n      // Helper to check if athlete is in top 3 for their apparatus across entire meet\n      function getAthleteApparatusRank(eventName, gymnastId, score) {\n        const rankings = apparatusRankings[eventName] || [];\n        const found = rankings.find(r => r.gymnastId === gymnastId || r.score === score);\n        return found ? found.rank : null;\n      }\n\n      // Medal icons for top 3\n      const medalIcons = { 1: '🥇', 2: '🥈', 3: '🥉' };\n\n      let columnsHtml = '';\n\n      rotationData.forEach((teamData, teamIndex) => {\n        const { team, eventName, eventDisplayName, gymnasts, eventScore, totalScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n\n        // Get rank for this team\n        const rank = rankedTeams.findIndex(t => t.idx === teamIndex) + 1;\n        const rankClass = rank <= 3 ? ` rank-${rank}` : '';\n\n        // Build athlete rows\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n\n            // Get start value (difficulty score)\n            const startValue = g.scores && g.scores.length > 0\n              ? parseFloat(g.scores[0].start) || 0\n              : 0;\n\n            // Check if this athlete is in top 3 for this apparatus (only if showing rankings)\n            const athleteRank = showRankings && score > 0 ? getAthleteApparatusRank(eventName, g.gymnast_id, score) : null;\n            const orderRankClass = athleteRank && athleteRank <= 3 ? ` rank-${athleteRank}` : '';\n            const medalIcon = athleteRank && athleteRank <= 3\n              ? `<span class=\"medal-icon\">${medalIcons[athleteRank]}</span>`\n              : '';\n\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order${orderRankClass}\">${i + 1}${medalIcon}</div>\n                <div class=\"athlete-name\">${name}</div>\n                <div class=\"athlete-sv\">${startValue > 0 ? startValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-left\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${eventDisplayName}</div>\n              </div>\n              <div class=\"header-right\">\n                ${showRankings 