n\n    @keyframes slideRight {\n      from { opacity: 0; transform: translateX(-60px); }\n      to { opacity: 1; transform: translateX(0); }\n    }\n\n    .team-logo {\n      width: 500px;\n      height: 500px;\n      object-fit: contain;\n    }\n\n    .content-section {\n      flex: 1;\n      height: 100%;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      padding: 100px 120px;\n      background-color: var(--meet-overlay-bg, #E5E5E5);\n      animation: fadeIn 0.6s ease-out 0.2s both;\n    }\n\n    @keyframes fadeIn {\n      from { opacity: 0; }\n      to { opacity: 1; }\n    }\n\n    .meet-name {\n      font-size: 86px;\n      font-weight: 700;\n      color: var(--meet-overlay-text, #222);\n      text-transform: uppercase;\n      letter-spacing: 3px;\n      margin-bottom: 50px;\n      line-height: 1.1;\n    }\n\n    .divider {\n      width: 200px;\n      height: 10px;\n      background: var(--meet-border-color, #111);\n      border-radius: 5px;\n      margin-bottom: 50px;\n    }\n\n    .rotation-label {\n      font-size: 64px;\n      font-weight: 600;\n      color: var(--meet-overlay-text, #666);\n      text-transform: uppercase;\n      letter-spacing: 16px;\n      margin-bottom: 10px;\n    }\n\n    .rotation-number {\n      font-size: 500px;\n      font-weight: 900;\n      color: var(--meet-overlay-text, #111);\n      line-height: 0.75;\n      letter-spacing: -20px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"logo-section\">\n    <img id=\"logo\" class=\"team-logo\" src=\"\" alt=\"Team Logo\">\n  </div>\n  <div class=\"content-section\">\n    <div id=\"meetName\" class=\"meet-name\">MEET NAME</div>\n    <div class=\"divider\"></div>\n    <div class=\"rotation-label\">Rotation</div>\n    <div id=\"rotationNumber\" class=\"rotation-number\">1</div>\n  </div>\n\n  <script>\n    const params = new URLSearchParams(window.location.search);\n\n    // Get parameters\n    const logo = params.get('logo') || params.get('team1Logo') || '';\n    const meetName = params.get('meetName') || params.get('eventName') || 'GYMNASTICS';\n    const rotation = params.get('rotation') || '1';\n\n    // Set logo\n    const logoEl = document.getElementById('logo');\n    if (logo) {\n      logoEl.src = logo;\n    } else {\n      logoEl.style.display = 'none';\n    }\n\n    // Set meet name\n    document.getElementById('meetName').textContent = meetName;\n\n    // Set rotation number\n    document.getElementById('rotationNumber').textContent = rotation;\n  </script>\n  <script src=\"theme-loader.js\"></script>\n</body>\n</html>\n","numLines":129,"startLine":1,"totalLines":129}}}
