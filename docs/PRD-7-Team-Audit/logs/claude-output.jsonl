→    // Initialize Firebase\n   546→    firebase.initializeApp(firebaseConfig);\n   547→    const db = firebase.database();\n   548→\n   549→    // Parse URL parameters\n   550→    const params = new URLSearchParams(window.location.search);\n   551→    const compId = params.get('compId');\n   552→\n   553→    if (!compId) {\n   554→      console.error('Missing compId parameter');\n   555→      document.body.innerHTML = '<div class=\"error-state\">Missing compId parameter</div>';\n   556→    }\n   557→\n   558→    // State management\n   559→    const state = {\n   560→      enabled: false,\n   561→      polling: false,\n   562→      automationMode: 'auto',\n   563→      showLineup: null,\n   564→      teams: [],\n   565→      rotation: { current: 1, total: 6, isFinal: false },\n   566→      previousScores: {},        // { \"gymnast_id\": \"finalScore\" (string) }\n   567→      previousTeamTotals: {},    // { \"teamKey\": \"finalScore\" (string) }\n   568→      flashQueues: {},           // Per-team flash queues\n   569→      activeFlashes: {},         // Currently active flashes per team\n   570→      nowCompeting: [],          // Currently competing athletes per team (B1)\n   571→      manualNowCompeting: {},    // Manual overrides from producer { teamIndex: true/false } (B4/B7)\n   572→      pollInterval: 5000,\n   573→      flashDuration: 10000,\n   574→      stalePollCount: 0,         // Consecutive polls with no data changes\n   575→      // Competition config (loaded from Firebase)\n   576→      competitionConfig: null,\n   577→      virtiusSessionId: null,\n   578→      gender: 'mens',\n   579→      // Error handling state (A3c)\n   580→      consecutiveErrors: 0,      // Count of consecutive poll failures\n   581→      lastError: null,           // Last error message\n   582→      lastErrorTime: null,       // Timestamp of last error\n   583→      maxBackoffMs: 60000,       // Max backoff delay (60 seconds)\n   584→      // Offline/reconnect state (A3d)\n   585→      firebaseConnected: true,   // Firebase connection state\n   586→      pendingWrites: [],         // Writes queued during offline\n   587→      reconnectAttempts: 0       // Count of reconnect attempts\n   588→    };\n   589→\n   590→    // Headshot storage (E1)\n   591→    let firebaseHeadshots = {};\n   592→    let headshotsLoaded = false;\n   593→\n   594→    /**\n   595→     * Normalize accented characters to ASCII equivalents (E1).\n   596→     * Handles German/Swedish umlauts, French/Spanish/Portuguese accents, ligatures.\n   597→     */\n   598→    function normalizeAccentsUnified(str) {\n   599→      if (!str) return '';\n   600→      return str\n   601→        // German/Swedish umlauts - convert to two-letter equivalents\n   602→        .replace(/ö/g, 'oe').replace(/Ö/g, 'oe')\n   603→        .replace(/ä/g, 'ae').replace(/Ä/g, 'ae')\n   604→        .replace(/ü/g, 'ue').replace(/Ü/g, 'ue')\n   605→        .replace(/ß/g, 'ss')\n   606→        // French/Spanish/Portuguese accents - convert to base letter\n   607→        .replace(/[éèêë]/g, 'e').replace(/[ÉÈÊË]/g, 'e')\n   608→        .replace(/[áàâãå]/g, 'a').replace(/[ÁÀÂÃÅ]/g, 'a')\n   609→        .replace(/[íìîï]/g, 'i').replace(/[ÍÌÎÏ]/g, 'i')\n   610→        .replace(/[óòôõø]/g, 'o').replace(/[ÓÒÔÕØ]/g, 'o')\n   611→        .replace(/[úùûü]/g, 'u').replace(/[ÚÙÛÜ]/g, 'u')\n   612→        .replace(/ñ/g, 'n').replace(/Ñ/g, 'n')\n   613→        .replace(/ç/g, 'c').replace(/Ç/g, 'c')\n   614→        .replace(/ÿ/g, 'y').replace(/Ÿ/g, 'y')\n   615→        // Ligatures\n   616→        .replace(/æ/g, 'ae').replace(/Æ/g, 'ae')\n   617→        .replace(/œ/g, 'oe').replace(/Œ/g, 'oe');\n   618→    }\n   619→\n   620→    /**\n   621→     * Remove common name suffixes (Jr., Sr., III, etc.) (E1).\n   622→     */\n   623→    function removeSuffixesUnified(name) {\n   624→      if (!name) return '';\n   625→      return name\n   626→        .replace(/,?\\s*(jr\\.?|junior|sr\\.?|senior|[iv]+|[1-5](?:st|nd|rd|th))$/i, '')\n   627→        .trim();\n   628→    }\n   629→\n   630→    /**\n   631→     * Unified name normalization (E1).\n   632→     * Handles accents, suffixes, hyphens, apostrophes.\n   633→     */\n   634→    function normalizeNameUnified(name) {\n   635→      if (!name) return '';\n   636→      return normalizeAccentsUnified(removeSuffixesUnified(name))\n   637→        .toLowerCase()\n   638→        .replace(/[-_]/g, ' ')      // Hyphens and underscores to spaces\n   639→        .replace(/[''`]/g, '')      // Remove apostrophes (curly and straight)\n   640→        .replace(/\\s+/g, ' ')       // Collapse multiple spaces\n   641→        .trim();\n   642→    }\n   643→\n   644→    /**\n   645→     * Load headshots from Firebase teamsDatabase (E1).\n   646→     * Creates multiple lookup keys for each headshot to maximize matching.\n   647→     */\n   648→    function loadFirebaseHeadshots() {\n   649→      db.ref('teamsDatabase/headshots').on('value', (snapshot) => {\n   650→        const data = snapshot.val() || {};\n   651→        firebaseHeadshots = {};\n   652→\n   653→        // Convert Firebase structure to simple name -> url map\n   654→        // Store multiple keys for each headshot to maximize matching\n   655→        for (const [key, value] of Object.entries(data)) {\n   656→          if (value && value.url) {\n   657→            // 1. Store by Firebase key (underscores → spaces)\n   658→            const keyWithSpaces = key.toLowerCase().trim().replace(/_/g, ' ').replace(/\\s+/g, ' ');\n   659→            firebaseHeadshots[keyWithSpaces] = value.url;\n   660→\n   661→            // 2. Store by fully normalized key (handles accents, hyphens, etc.)\n   662→            const normalizedKey = normalizeNameUnified(key);\n   663→            firebaseHeadshots[normalizedKey] = value.url;\n   664→\n   665→            // 3. Store by name field (original stored name)\n   666→            if (value.name) {\n   667→              const nameNormalized = normalizeNameUnified(value.name);\n   668→              firebaseHeadshots[nameNormalized] = value.url;\n   669→\n   670→              // Also store just lowercased version (in case accents are already normalized)\n   671→              const nameLower = value.name.toLowerCase().trim().replace(/\\s+/g, ' ');\n   672→              firebaseHeadshots[nameLower] = value.url;\n   673→            }\n   674→\n   675→            // 4. Store stripped version (only letters and spaces - handles unknown chars)\n   676→            const strippedKey = normalizedKey.replace(/[^a-z\\s]/g, '').replace(/\\s+/g, ' ').trim();\n   677→            if (strippedKey && strippedKey.length > 2) {\n   678→              firebaseHeadshots[strippedKey] = value.url;\n   679→            }\n   680→\n   681→            // 5. Handle 3+ part names - store variants for reverse lookup\n   682→            // e.g., \"benjamin thurlow lam\" also stored as \"benjamin lam\", \"benjamin t lam\"\n   683→            const parts = normalizedKey.split(' ').filter(Boolean);\n   684→            if (parts.length >= 3) {\n   685→              // First + Last only (skip middle name)\n   686→              const firstLast = `${parts[0]} ${parts[parts.length - 1]}`;\n   687→              firebaseHeadshots[firstLast] = value.url;\n   688→\n   689→              // First + Middle initial + Last\n   690→              const firstInitialLast = `${parts[0]} ${parts[1][0]} ${parts[parts.length - 1]}`;\n   691→              firebaseHeadshots[firstInitialLast] = value.url;\n   692→\n   693→              // For 4+ parts, first two + last\n   694→              if (parts.length >= 4) {\n   695→                const firstTwoLast = `${parts[0]} ${parts[1]} ${parts[parts.length - 1]}`;\n   696→                firebaseHeadshots[firstTwoLast] = value.url;\n   697→              }\n   698→            }\n   699→          }\n   700→        }\n   701→        headshotsLoaded = true;\n   702→        console.log(`Loaded ${Object.keys(firebaseHeadshots).length} headshot entries from Firebase`);\n   703→      });\n   704→    }\n   705→\n   706→    /**\n   707→     * Get athlete headshot URL (E1).\n   708→     * Handles 3+ part names, accented characters, and various name formats.\n   709→     * Falls back to API headshot if no Firebase match found.\n   710→     */\n   711→    function getAthleteHeadshot(firstName, lastName, apiHeadshot) {\n   712→      if (!firstName && !lastName) return apiHeadshot || '';\n   713→\n   714→      // Build full name for lookup\n   715→      const rawFullName = `${firstName || ''} ${lastName || ''}`.trim();\n   716→      const normalized = normalizeNameUnified(rawFullName);\n   717→      const stripped = normalized.replace(/[^a-z\\s]/g, '').replace(/\\s+/g, ' ').trim();\n   718→\n   719→      // Generate multiple lookup keys to maximize matching\n   720→      const lookupKeys = [\n   721→        // 1. Original lowercase (exact match)\n   722→        rawFullName.toLowerCase().replace(/\\s+/g, ' ').trim(),\n   723→        // 2. Fully normalized (unified normalization)\n   724→        normalized,\n   725→        // 3. Stripped (only letters and spaces)\n   726→        stripped,\n   727→      ];\n   728→\n   729→      // 4. Handle 3+ part names (e.g., \"Benjamin Thurlow Lam\")\n   730→      const parts = normalized.split(' ').filter(Boolean);\n   731→      if (parts.length >= 3) {\n   732→        // First + Last only (skip middle name)\n   733→        lookupKeys.push(`${parts[0]} ${parts[parts.length - 1]}`);\n   734→        // First + Middle initial + Last\n   735→        lookupKeys.push(`${parts[0]} ${parts[1][0]} ${parts[parts.length - 1]}`);\n   736→        // For 4+ parts, try first two + last\n   737→        if (parts.length >= 4) {\n   738→          lookupKeys.push(`${parts[0]} ${parts[1]} ${parts[parts.length - 1]}`);\n   739→        }\n   740→      }\n   741→\n   742→      // 5. Handle case where firstName contains multiple parts\n   743→      const firstParts = (firstName || '').trim().split(/\\s+/).filter(Boolean);\n   744→      if (firstParts.length >= 2 && lastName) {\n   745→        // Just first part of firstName + lastName\n   746→        lookupKeys.push(`${normalizeNameUnified(firstParts[0])} ${normalizeNameUnified(lastName)}`);\n   747→        // First part + initial + lastName\n   748→        lookupKeys.push(`${normalizeNameUnified(firstParts[0])} ${firstParts[1][0].toLowerCase()} ${normalizeNameUnified(lastName)}`);\n   749→      }\n   750→\n   751→      // Remove duplicates and empty strings\n   752→      const uniqueKeys = [...new Set(lookupKeys.filter(Boolean))];\n   753→\n   754→      // Try each key against Firebase headshots\n   755→      for (const key of uniqueKeys) {\n   756→        if (firebaseHeadshots[key]) {\n   757→          return firebaseHeadshots[key];\n   758→        }\n   759→      }\n   760→\n   761→      // Fall back to API headshot\n   762→      return apiHeadshot || '';\n   763→    }\n   764→\n   765→    // Initialize headshot loading\n   766→    loadFirebaseHeadshots();\n   767→\n   768→    /**\n   769→     * Handle headshot load error by replacing with initials placeholder (E5).\n   770→     * Called via onerror=\"handleHeadshotError(this, 'First', 'Last')\"\n   771→     * @param {HTMLImageElement} img - The image element that failed\n   772→     * @param {string} firstName - Athlete first name\n   773→     * @param {string} lastName - Athlete last name\n   774→     */\n   775→    function handleHeadshotError(img, firstName, lastName) {\n   776→      // Hide the broken image\n   777→      img.style.display = 'none';\n   778→\n   779→      // Build initials (first letter of first name + first letter of last name)\n   780→      const firstInitial = (firstName || '').charAt(0).toUpperCase();\n   781→      const lastInitial = (lastName || '').charAt(0).toUpperCase();\n   782→      const initials = `${firstInitial}${lastInitial}` || '?';\n   783→\n   784→      // Create placeholder div with initials\n   785→      const placeholder = document.createElement('div');\n   786→      placeholder.className = 'slot-headshot-fallback';\n   787→      placeholder.textContent = initials;\n   788→      placeholder.style.cssText = `\n   789→        width: 36px;\n   790→        height: 36px;\n   791→        border-radius: 50%;\n   792→        background: linear-gradient(135deg, #374151 0%, #1f2937 100%);\n   793→        display: flex;\n   794→        align-items: center;\n   795→        justify-content: center;\n   796→        font-size: 14px;\n   797→        font-weight: 700;\n   798→        color: #9ca3af;\n   799→        flex-shrink: 0;\n   800→      `;\n   801→\n   802→      // Insert before the hidden image\n   803→      img.parentNode.insertBefore(placeholder, img);\n   804→    }\n   805→\n   806→    // Firebase paths\n   807→    const scoreBugRef = db.ref(`competitions/${compId}/scoreBug`);\n   808→    const configRef = db.ref(`competitions/${compId}/config`);\n   809→    const connectedRef = db.ref('.info/connected');\n   810→\n   811→    /**\n   812→     * Initialize Firebase connection monitoring (A3d).\n   813→     * Detects offline/online state and handles reconnection.\n   814→     */\n   815→    function initConnectionMonitor() {\n   816→      connectedRef.on('value', (snapshot) => {\n   817→        const connected = snapshot.val() === true;\n   818→        const wasConnected = state.firebaseConnected;\n   819→        state.firebaseConnected = connected;\n   820→\n   821→        if (connected && !wasConnected) {\n   822→          // Just reconnected\n   823→          console.log('Firebase connected - processing pending writes');\n   824→          state.reconnectAttempts = 0;\n   825→          processPendingWrites();\n   826→\n   827→          // Write reconnect event to Firebase\n   828→          scoreBugRef.child('connectionStatus').set({\n   829→            connected: true,\n   830→            reconnectedAt: Date.now(),\n   831→            pendingWritesProcessed: state.pendingWrites.length\n   832→          });\n   833→        } else if (!connected && wasConnected) {\n   834→          // Just went offline\n   835→          console.warn('Firebase disconnected - writes will be queued');\n   836→          state.reconnectAttempts++;\n   837→\n   838→          // Note: Firebase SDK has offline persistence by default\n   839→          // Writes are automatically queued and synced on reconnect\n   840→        }\n   841→\n   842→        console.log('Firebase connection state:', connected ? 'ONLINE' : 'OFFLINE');\n   843→      });\n   844→    }\n   845→\n   846→    /**\n   847→     * Process any pending writes that were queued during offline.\n   848→     * Firebase SDK handles this automatically, but we log for visibility.\n   849→     */\n   850→    function processPendingWrites() {\n   851→      if (state.pendingWrites.length === 0) return;\n   852→\n   853→      console.log('Processing', state.pendingWrites.length, 'pending writes');\n   854→\n   855→      // Firebase SDK automatically syncs queued writes\n   856→      // Clear our tracking array\n   857→      state.pendingWrites = [];\n   858→    }\n   859→\n   860→    /**\n   861→     * Safe write to Firebase with offline queueing (A3d).\n   862→     * Wraps Firebase write operations to track pending writes during offline.\n   863→     * @param {firebase.database.Reference} ref - Firebase reference\n   864→     * @param {string} method - 'set', 'update', or 'remove'\n   865→     * @param {*} data - Data to write (for set/update)\n   866→     * @returns {Promise}\n   867→     */\n   868→    async function safeWrite(ref, method, data) {\n   869→      const writeOp = { path: ref.toString(), method, data, timestamp: Date.now() };\n   870→\n   871→      if (!state.firebaseConnected) {\n   872→        // Queue the write for tracking (Firebase SDK queues automatically)\n   873→        state.pendingWrites.push(writeOp);\n   874→        console.log('Queued offline write:', writeOp.path, method);\n   875→      }\n   876→\n   877→      try {\n   878→        if (method === 'set') {\n   879→          await ref.set(data);\n   880→        } else if (method === 'update') {\n   881→          await ref.update(data);\n   882→        } else if (method === 'remove') {\n   883→          await ref.remove();\n   884→        }\n   885→        return true;\n   886→      } catch (err) {\n   887→        // Firebase SDK will retry on reconnect\n   888→        console.error('Write failed (will retry on reconnect):', err.message);\n   889→        if (!state.pendingWrites.includes(writeOp)) {\n   890→          state.pendingWrites.push(writeOp);\n   891→        }\n   892→        return false;\n   893→      }\n   894→    }\n   895→\n   896→    /**\n   897→     * Load competition config from Firebase.\n   898→     * Gets virtiusSessionId, team names/logos, gender, and compType.\n   899→     * Must be called before initializing Firebase listeners.\n   900→     */\n   901→    async function loadCompetitionConfig() {\n   902→      try {\n   903→        const snapshot = await configRef.once('value');\n   904→        const config = snapshot.val();\n   905→\n   906→        if (!config) {\n   907→          console.error('No competition config found for compId:', compId);\n   908→          document.body.innerHTML = '<div class=\"error-state\">Competition not found</div>';\n   909→          return false;\n   910→        }\n   911→\n   912→        state.competitionConfig = config;\n   913→        state.virtiusSessionId = config.virtiusSessionId || null;\n   914→        state.gender = config.gender || 'mens';\n   915→\n   916→        // Build teams array from config (up to 7 teams)\n   917→        state.teams = [];\n   918→        for (let i = 1; i <= 7; i++) {\n   919→          const teamName = config[`team${i}Name`];\n   920→          if (teamName) {\n   921→            state.teams.push({\n   922→              index: i,\n   923→              name: teamName,\n   924→              logo: config[`team${i}Logo`] || '',\n   925→              tricode: config[`team${i}Tricode`] || '',\n   926→              total: '--'  // Initial state before first API poll\n   927→            });\n   928→          }\n   929→        }\n   930→\n   931→        // Determine total rotations based on gender and team count\n   932→        // For women's: normally 4, but more if team count exceeds apparatus count\n   933→        // For men's: normally 6, but more if team count exceeds apparatus count\n   934→        const eventCount = state.gender === 'womens' ? 4 : 6;\n   935→        state.rotation.total = Math.max(eventCount, state.teams.length);\n   936→\n   937→        console.log('Competition config loaded:', {\n   938→          compId,\n   939→          virtiusSessionId: state.virtiusSessionId,\n   940→          gender: state.gender,\n   941→          teamCount: state.teams.length,\n   942→          teams: state.teams.map(t => t.name)\n   943→        });\n   944→\n   945→        // Check if Virtius session ID is configured\n   946→        if (!state.virtiusSessionId) {\n   947→          console.warn('No Virtius session ID configured - API polling will not work');\n   948→        }\n   949→\n   950→        return true;\n   951→      } catch (err) {\n   952→        console.error('Failed to load competition config:', err);\n   953→        document.body.innerHTML = '<div class=\"error-state\">Failed to load competition config</div>';\n   954→        return false;\n   955→      }\n   956→    }\n   957→\n   958→    /**\n   959→     * Render initial team rows based on competition config.\n   960→     * Called after loadCompetitionConfig() to show teams before API polling starts.\n   961→     * Adds team-count class for responsive scaling (G1/G2/G3).\n   962→     */\n   963→    function renderTeamRows() {\n   964→      const container = document.getElementById('teamRows');\n   965→      if (!container) return;\n   966→\n   967→      // Add team count class to score-bug for responsive scaling\n   968→      const scoreBug = document.getElementById('scoreBug');\n   969→      if (scoreBug) {\n   970→        // Remove any existing team count classes\n   971→        scoreBug.classList.remove('teams-2', 'teams-3', 'teams-4', 'teams-5', 'teams-6', 'teams-7');\n   972→        // Add class based on team count\n   973→        const teamCount = state.teams.length;\n   974→        if (teamCount >= 2 && teamCount <= 7) {\n   975→          scoreBug.classList.add(`teams-${teamCount}`);\n   976→        }\n   977→      }\n   978→\n   979→      container.innerHTML = state.teams.map((team, idx) => `\n   980→        <div class=\"team-row\" data-team-index=\"${team.index}\">\n   981→          <div class=\"team-fixed\">\n   982→            <img class=\"team-logo\" src=\"${team.logo}\" alt=\"${team.name}\" onerror=\"this.style.display='none'\">\n   983→            <div class=\"team-total\" id=\"teamTotal${team.index}\">${team.total}</div>\n   984→          </div>\n   985→          <div class=\"team-slot\" id=\"teamSlot${team.index}\">\n   986→            <div class=\"slot-content\" id=\"slotContent${team.index}\">\n   987→              <!-- Score flash / now competing content populated dynamically -->\n   988→            </div>\n   989→          </div>\n   990→        </div>\n   991→      `).join('');\n   992→\n   993→      console.log('Team rows rendered:', state.teams.length, 'teams');\n   994→    }\n   995→\n   996→    /**\n   997→     * Update team total display element (A4).\n   998→     * Called when API polling detects a change in team.final_score.\n   999→     * Adds highlight animation on value change.\n  1000→     * @param {number} teamIndex - 1-based team index\n  1001→     * @param {string} newTotal - Formatted score string (e.g., \"196.450\")\n  1002→     */\n  1003→    function updateTeamTotal(teamIndex, newTotal) {\n  1004→      const totalEl = document.getElementById(`teamTotal${teamIndex}`);\n  1005→      if (!totalEl) return;\n  1006→\n  1007→      const prevTotal = totalEl.textContent;\n  1008→\n  1009→      // Only update if value changed\n  1010→      if (prevTotal === newTotal) return;\n  1011→\n  1012→      totalEl.textContent = newTotal;\n  1013→\n  1014→      // Trigger highlight animation on change (skip for initial load)\n  1015→      if (prevTotal !== '--') {\n  1016→        totalEl.classList.remove('highlight');\n  1017→        // Force reflow to restart animation\n  1018→        void totalEl.offsetWidth;\n  1019→        totalEl.classList.add('highlight');\n  1020→      }\n  1021→    }\n  1022→\n  1023→    /**\n  1024→     * Update all team totals from state (A4).\n  1025→     * Called after API poll updates state.teams[].total values.\n  1026→     */\n  1027→    function updateAllTeamTotals() {\n  1028→      state.teams.forEach((team) => {\n  1029→        updateTeamTotal(team.index, team.total);\n  1030→      });\n  1031→    }\n  1032→\n  1033→    // Initialize Firebase listeners\n  1034→    function initFirebaseListeners() {\n  1035→      // Listen for enabled state\n  1036→      scoreBugRef.child('enabled').on('value', (snapshot) => {\n  1037→        state.enabled = snapshot.val() === true;\n  1038→        updateBugVisibility();\n  1039→      });\n  1040→\n  1041→      // Listen for polling state\n  1042→      scoreBugRef.child('polling').on('value', (snapshot) => {\n  1043→        const wasPolling = state.polling;\n  1044→        state.polling = snapshot.val() === true;\n  1045→        if (state.polling && !wasPolling) {\n  1046→          startPolling();\n  1047→        } else if (!state.polling && wasPolling) {\n  1048→          stopPolling();\n  1049→        }\n  1050→      });\n  1051→\n  1052→      // Listen for automation mode changes\n  1053→      scoreBugRef.child('automationMode').on('value', (snapshot) => {\n  1054→        const newMode = snapshot.val() || 'auto';\n  1055→        const modeChanged = state.automationMode !== newMode;\n  1056→        state.automationMode = newMode;\n  1057→\n  1058→        // When mode changes, update now-competing display accordingly\n  1059→        if (modeChanged) {\n  1060→          console.log('Automation mode changed to:', newMode);\n  1061→          updateAllNowCompeting();\n  1062→        }\n  1063→      });\n  1064→\n  1065→      // Listen for manual now-competing overrides (B7)\n  1066→      // Producer can show/hide now-competing per team in manual mode\n  1067→      scoreBugRef.child('nowCompeting').on('value', (snapshot) => {\n  1068→        const overrides = snapshot.val() || {};\n  1069→        state.manualNowCompeting = {};\n  1070→\n  1071→        // Convert team keys to indices: { \"team1\": true } → { 1: true }\n  1072→        Object.entries(overrides).forEach(([teamKey, value]) => {\n  1073→          // teamKey is \"team1\", \"team2\", etc.\n  1074→          const match = teamKey.match(/team(\\d+)/);\n  1075→          if (match) {\n  1076→            const teamIndex = parseInt(match[1], 10);\n  1077→            state.manualNowCompeting[teamIndex] = value;\n  1078→          }\n  1079→        });\n  1080→\n  1081→        console.log('Manual now-competing overrides updated:', state.manualNowCompeting);\n  1082→        updateAllNowCompeting();\n  1083→      });\n  1084→\n  1085→      // Listen for lineup card toggle\n  1086→      scoreBugRef.child('showLineup').on('value', (snapshot) => {\n  1087→        state.showLineup = snapshot.val();\n  1088→        updateLineupCard();\n  1089→      });\n  1090→\n  1091→      // Listen for flash dismissals\n  1092→      scoreBugRef.child('dismissFlash').on('value', (snapshot) => {\n  1093→        const dismissals = snapshot.val() || {};\n  1094→        handleFlashDismissals(dismissals);\n  1095→      });\n  1096→\n  1097→      // Listen for poll interval changes - restart polling with new interval\n  1098→      scoreBugRef.child('config/pollInterval').on('value', (snapshot) => {\n  1099→        const newInterval = snapshot.val() || 5000;\n  1100→        const wasPolling = state.polling && pollTimer !== null;\n  1101→        state.pollInterval = newInterval;\n  1102→\n  1103→        // Restart polling with new interval if currently polling\n  1104→        if (wasPolling) {\n  1105→          console.log('Poll interval changed to', newInterval, 'ms - restarting polling');\n  1106→          stopPolling();\n  1107→          startPolling();\n  1108→        }\n  1109→      });\n  1110→\n  1111→      // Listen for flash duration changes\n  1112→      scoreBugRef.child('config/flashDuration').on('value', (snapshot) => {\n  1113→        state.flashDuration = snapshot.val() || 10000;\n  1114→      });\n  1115→\n  1116→      console.log('Firebase listeners initialized');\n  1117→    }\n  1118→\n  1119→    // Update bug visibility based on enabled state\n  1120→    function updateBugVisibility() {\n  1121→      const bugEl = document.getElementById('scoreBug');\n  1122→      if (state.enabled) {\n  1123→        bugEl.classList.add('visible');\n  1124→      } else {\n  1125→        bugEl.classList.remove('visible');\n  1126→      }\n  1127→    }\n  1128→\n  1129→    // Update lineup card visibility\n  1130→    function updateLineupCard() {\n  1131→      const cardEl = document.getElementById('lineupCard');\n  1132→      if (!state.showLineup) {\n  1133→        cardEl.classList.remove('visible');\n  1134→        return;\n  1135→      }\n  1136→\n  1137→      // Find the team matching state.showLineup (teamKey like \"navy-mens\")\n  1138→      const apiTeams = state.lastApiTeams || [];\n  1139→      const teamData = apiTeams.find(t => {\n  1140→        const teamKey = t.short_name || `team${apiTeams.indexOf(t) + 1}`;\n  1141→        return teamKey === state.showLineup;\n  1142→      });\n  1143→\n  1144→      if (!teamData) {\n  1145→        console.warn('Lineup card: team not found for key:', state.showLineup);\n  1146→        cardEl.classList.remove('visible');\n  1147→        return;\n  1148→      }\n  1149→\n  1150→      // Find the config team to get logo and display name\n  1151→      const configTeamIndex = apiTeams.indexOf(teamData);\n  1152→      const configTeam = state.teams[configTeamIndex] || {};\n  1153→\n  1154→      // Find the current event (in progress or most recent)\n  1155→      const currentEvent = findCurrentEventForLineup(teamData);\n  1156→      if (!currentEvent) {\n  1157→        console.warn('Lineup card: no current event found');\n  1158→        cardEl.classList.remove('visible');\n  1159→        return;\n  1160→      }\n  1161→\n  1162→      // Populate the lineup card content\n  1163→      cardEl.innerHTML = renderLineupCardContent(teamData, configTeam, currentEvent);\n  1164→      cardEl.classList.add('visible');\n  1165→    }\n  1166→\n  1167→    /**\n  1168→     * Find the current event for lineup card display.\n  1169→     * Prioritizes: (1) event in progress, (2) last completed event, (3) first event.\n  1170→     * @param {Object} teamData - Team data from Virtius API\n  1171→     * @returns {Object|null} Event object or null\n  1172→     */\n  1173→    function findCurrentEventForLineup(teamData) {\n  1174→      if (!teamData || !teamData.events) return null;\n  1175→\n  1176→      const events = teamData.events;\n  1177→      if (events.length === 0) return null;\n  1178→\n  1179→      // Look for event in progress (some scores, but not all)\n  1180→      for (const event of events) {\n  1181→        const gymnasts = event.gymnasts || [];\n  1182→        if (gymnasts.length === 0) continue;\n  1183→\n  1184→        const scored = gymnasts.filter(g => g.final_score != null);\n  1185→        const unscored = gymnasts.filter(g => g.final_score == null);\n  1186→\n  1187→        // Event in progress: has some scores but not complete\n  1188→        if (scored.length > 0 && unscored.length > 0) {\n  1189→          return event;\n  1190→        }\n  1191→      }\n  1192→\n  1193→      // No event in progress - find the last event with scores\n  1194→      for (let i = events.length - 1; i >= 0; i--) {\n  1195→        const event = events[i];\n  1196→        const gymnasts = event.gymnasts || [];\n  1197→        const scored = gymnasts.filter(g => g.final_score != null);\n  1198→        if (scored.length > 0) {\n  1199→          return event;\n  1200→        }\n  1201→      }\n  1202→\n  1203→      // No events have scores yet - return first event\n  1204→      return events[0];\n  1205→    }\n  1206→\n  1207→    /**\n  1208→     * Render lineup card HTML content.\n  1209→     * @param {Object} teamData - Team data from Virtius API\n  1210→     * @param {Object} configTeam - Team config with logo/name\n  1211→     * @param {Object} event - Current event to display\n  1212→     * @returns {string} HTML content\n  1213→     */\n  1214→    function renderLineupCardContent(teamData, configTeam, event) {\n  1215→      const teamName = configTeam.name || teamData.name || 'Team';\n  1216→      const teamLogo = configTeam.logo || '';\n  1217→      const eventName = getEventShortCode(event.event_name || event.name || '');\n  1218→      const eventTotal = formatScore(event.event_score);\n  1219→\n  1220→      // Sort gymnasts by lineup order\n  1221→      const gymnasts = [...(event.gymnasts || [])].sort((a, b) => (a.order || 0) - (b.order || 0));\n  1222→\n  1223→      // Build athlete rows\n  1224→      const athleteRows = gymnasts.map((g, idx) => {\n  1225→        const order = g.order || (idx + 1);\n  1226→        const name = g.full_name || 'Unknown';\n  1227→        // Get start value from scores array if available\n  1228→        const startValue = (g.scores && g.scores[0] && g.scores[0].start)\n  1229→          ? parseFloat(g.scores[0].start).toFixed(1)\n  1230→          : '';\n  1231→        const score = g.final_score != null ? formatScore(g.final_score) : '--';\n  1232→        const pendingClass = g.final_score == null ? 'pending' : '';\n  1233→\n  1234→        return `\n  1235→          <div class=\"lineup-athlete\">\n  1236→            <span class=\"lineup-order\">${order}.</span>\n  1237→            <span class=\"lineup-name\">${name}</span>\n  1238→            <span class=\"lineup-sv\">${startValue}</span>\n  1239→            <span class=\"lineup-score ${pendingClass}\">${score}</span>\n  1240→          </div>\n  1241→        `;\n  1242→      }).join('');\n  1243→\n  1244→      return `\n  1245→        <div class=\"lineup-header\">\n  1246→          <span class=\"lineup-team-name\">${teamName}</span>\n  1247→          <img class=\"lineup-logo\" src=\"${teamLogo}\" alt=\"\" onerror=\"this.style.display='none'\">\n  1248→        </div>\n  1249→        <div class=\"lineup-athletes\">\n  1250→          ${athleteRows}\n  1251→        </div>\n  1252→        <div class=\"lineup-footer\">\n  1253→          <span class=\"lineup-event\">${eventName}</span>\n  1254→          <span class=\"lineup-total\">${eventTotal}</span>\n  1255→        </div>\n  1256→      `;\n  1257→    }\n  1258→\n  1259→    /**\n  1260→     * Format score for display (3 decimal places).\n  1261→     * @param {string|number|null} score - Score value\n  1262→     * @returns {string} Formatted score or \"--\"\n  1263→     */\n  1264→    function formatScore(score) {\n  1265→      if (score == null || score === '') return '--';\n  1266→      const num = parseFloat(score);\n  1267→      if (isNaN(num)) return '--';\n  1268→      return num.toFixed(3);\n  1269→    }\n  1270→\n  1271→    /**\n  1272→     * Handle flash dismissals from producer panel (Task A12c).\n  1273→     * When producer clicks \"dismiss\" for a team, immediately clears\n  1274→     * the active flash and advances to next in queue.\n  1275→     * @param {Object} dismissals - Map of teamIndex -> timestamp\n  1276→     */\n  1277→    function handleFlashDismissals(dismissals) {\n  1278→      if (!dismissals || typeof dismissals !== 'object') return;\n  1279→\n  1280→      Object.keys(dismissals).forEach((teamIndexStr) => {\n  1281→        const teamIndex = parseInt(teamIndexStr, 10);\n  1282→        const dismissTimestamp = dismissals[teamIndex];\n  1283→\n  1284→        // Skip if no active flash for this team\n  1285→        if (!state.activeFlashes[teamIndex]) return;\n  1286→\n  1287→        // Skip if already processed this dismissal (compare timestamps)\n  1288→        const activeFlash = state.activeFlashes[teamIndex];\n  1289→        if (activeFlash.dismissedAt === dismissTimestamp) return;\n  1290→\n  1291→        console.log('Processing flash dismissal:', {\n  1292→          team: teamIndex,\n  1293→          gymnast: activeFlash.name,\n  1294→          dismissTimestamp\n  1295→        });\n  1296→\n  1297→        // Mark as processed\n  1298→        activeFlash.dismissedAt = dismissTimestamp;\n  1299→\n  1300→        // Clear the timer for current flash\n  1301→        if (activeFlash.timer) {\n  1302→          clearTimeout(activeFlash.timer);\n  1303→        }\n  1304→\n  1305→        // Advance to next flash (or clear if queue empty)\n  1306→        advanceFlashQueue(teamIndex);\n  1307→\n  1308→        // Clear the dismissal flag in Firebase after processing\n  1309→        scoreBugRef.child(`dismissFlash/${teamIndex}`).remove();\n  1310→      });\n  1311→    }\n  1312→\n  1313→    // Polling management\n  1314→    let pollTimer = null;\n  1315→\n  1316→    function startPolling() {\n  1317→      if (pollTimer) return;\n  1318→      console.log('Starting API polling');\n  1319→      poll();  // Initial poll\n  1320→      pollTimer = setInterval(poll, state.pollInterval);\n  1321→    }\n  1322→\n  1323→    function stopPolling() {\n  1324→      if (pollTimer) {\n  1325→        clearInterval(pollTimer);\n  1326→        pollTimer = null;\n  1327→        console.log('Stopped API polling');\n  1328→      }\n  1329→    }\n  1330→\n  1331→    // Main poll function - fetches data from Virtius API\n  1332→    async function poll() {\n  1333→      // Check if we have a valid session ID\n  1334→      if (!state.virtiusSessionId) {\n  1335→        console.warn('No Virtius session ID - skipping poll');\n  1336→        return;\n  1337→      }\n  1338→\n  1339→      const pollStartTime = Date.now();\n  1340→\n  1341→      try {\n  1342→        // Fetch from Virtius API\n  1343→        const response = await fetch(`https://api.virti.us/session/${state.virtiusSessionId}/json`);\n  1344→\n  1345→        if (!response.ok) {\n  1346→          throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n  1347→        }\n  1348→\n  1349→        const data = await response.json();\n  1350→\n  1351→        // Store raw API data for score diff engine (Task A5)\n  1352→        // Extract teams array from meet data\n  1353→        const teams = data.meet?.teams || [];\n  1354→\n  1355→        if (teams.length === 0) {\n  1356→          console.warn('No teams found in API response');\n  1357→        }\n  1358→\n  1359→        // Store the latest API data in state\n  1360→        state.lastApiData = data;\n  1361→        state.lastApiTeams = teams;\n  1362→\n  1363→        // Extract team totals and update state.teams with actual data\n  1364→        // final_score comes as a string from API - convert to float for display\n  1365→        teams.forEach((apiTeam, idx) => {\n  1366→          // Match API team to our configured teams by index or name\n  1367→          const stateTeam = state.teams[idx];\n  1368→          if (stateTeam) {\n  1369→            // Convert string final_score to formatted number\n  1370→            const rawScore = apiTeam.final_score;\n  1371→            if (rawScore !== null && rawScore !== undefined) {\n  1372→              const numScore = parseFloat(rawScore);\n  1373→              stateTeam.total = isNaN(numScore) ? '--' : numScore.toFixed(3);\n  1374→            }\n  1375→            // Store API team reference for score diff engine\n  1376→            stateTeam.apiTeam = apiTeam;\n  1377→          }\n  1378→        });\n  1379→\n  1380→        // Write heartbeat to Firebase on successful poll (using safeWrite for offline resilience)\n  1381→        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n  1382→\n  1383→        console.log('Poll successful:', {\n  1384→          sessionId: state.virtiusSessionId,\n  1385→          teamCount: teams.length,\n  1386→          teams: state.teams.map(t => ({ name: t.name, total: t.total }))\n  1387→        });\n  1388→\n  1389→        // Process API data - detect changes and write deltas to Firebase\n  1390→        await processApiData(teams, pollStartTime);\n  1391→\n  1392→        // Update team total displays (A4)\n  1393→        updateAllTeamTotals();\n  1394→\n  1395→      } catch (err) {\n  1396→        // Error handling with exponential backoff (A3c)\n  1397→        state.consecutiveErrors++;\n  1398→        state.lastError = err.message;\n  1399→        state.lastErrorTime = pollStartTime;\n  1400→\n  1401→        // Calculate backoff delay: 5s, 10s, 20s, 40s, 60s (max)\n  1402→        const backoffDelay = Math.min(\n  1403→          state.pollInterval * Math.pow(2, state.consecutiveErrors - 1),\n  1404→          state.maxBackoffMs\n  1405→        );\n  1406→\n  1407→        console.error('Poll failed:', {\n  1408→          error: err.message,\n  1409→          consecutiveErrors: state.consecutiveErrors,\n  1410→          nextRetryIn: `${backoffDelay / 1000}s`\n  1411→        });\n  1412→\n  1413→        // Write error state to Firebase for producer panel visibility (D5b)\n  1414→        // Using safeWrite for offline resilience\n  1415→        await safeWrite(scoreBugRef.child('apiError'), 'set', {\n  1416→          message: err.message,\n  1417→          consecutiveErrors: state.consecutiveErrors,\n  1418→          timestamp: pollStartTime,\n  1419→          nextRetryMs: backoffDelay\n  1420→        });\n  1421→        // Still write heartbeat to indicate overlay is running\n  1422→        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n  1423→\n  1424→        // Schedule next poll with backoff delay if we're still supposed to be polling\n  1425→        if (state.polling && pollTimer) {\n  1426→          clearInterval(pollTimer);\n  1427→          pollTimer = setTimeout(() => {\n  1428→            if (state.polling) {\n  1429→              poll();\n  1430→              // If poll succeeds, startPolling() will be called to restore normal interval\n  1431→            }\n  1432→          }, backoffDelay);\n  1433→        }\n  1434→        return; // Skip normal completion\n  1435→      }\n  1436→\n  1437→      // Success - reset error state\n  1438→      if (state.consecutiveErrors > 0) {\n  1439→        console.log('Poll recovered after', state.consecutiveErrors, 'consecutive errors');\n  1440→        state.consecutiveErrors = 0;\n  1441→        state.lastError = null;\n  1442→        state.lastErrorTime = null;\n  1443→\n  1444→        // Clear error state in Firebase\n  1445→        await safeWrite(scoreBugRef.child('apiError'), 'remove');\n  1446→\n  1447→        // Restore normal polling interval (we might be on backoff timeout)\n  1448→        if (state.polling && pollTimer) {\n  1449→          clearTimeout(pollTimer);\n  1450→          clearInterval(pollTimer);\n  1451→          pollTimer = setInterval(poll, state.pollInterval);\n  1452→        }\n  1453→      }\n  1454→    }\n  1455→\n  1456→    /**\n  1457→     * Process API data - detect score changes and write incremental deltas to Firebase.\n  1458→     * Only writes changed paths, not full data rewrite.\n  1459→     * @param {Array} apiTeams - Teams array from Virtius API\n  1460→     * @param {number} pollTimestamp - Timestamp of this poll\n  1461→     */\n  1462→    async function processApiData(apiTeams, pollTimestamp) {\n  1463→      const changedPaths = {};\n  1464→      let hasChanges = false;\n  1465→\n  1466→      // Process each team\n  1467→      apiTeams.forEach((team, teamIdx) => {\n  1468→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n  1469→\n  1470→        // Check if team total changed\n  1471→        const prevTeamTotal = state.previousTeamTotals[teamKey];\n  1472→        const currTeamTotal = team.final_score;  // string or null\n  1473→\n  1474→        if (currTeamTotal !== prevTeamTotal) {\n  1475→          changedPaths[`teams/${teamKey}/finalScore`] = currTeamTotal;\n  1476→          changedPaths[`teams/${teamKey}/name`] = team.name || teamKey;\n  1477→          hasChanges = true;\n  1478→        }\n  1479→\n  1480→        // Process each event's gymnasts for score changes\n  1481→        const events = team.events || [];\n  1482→        events.forEach((event) => {\n  1483→          const eventKey = event.short_name || event.name || 'unknown';\n  1484→          const gymnasts = event.gymnasts || [];\n  1485→\n  1486→          gymnasts.forEach((gymnast) => {\n  1487→            // Primary key: gymnast_id. Fallback: teamKey|normalizedName\n  1488→            const gymnastKey = gymnast.gymnast_id ||\n  1489→              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n  1490→\n  1491→            const prevScore = state.previousScores[gymnastKey];\n  1492→            const currScore = gymnast.final_score;  // string or null\n  1493→\n  1494→            // Score changed (new score OR corrected score)\n  1495→            if (currScore != null && prevScore !== currScore) {\n  1496→              // Build gymnast data for Firebase and flash queue\n  1497→              // Stick bonus is indicated by bonus > 0 in the API (men's gymnastics only)\n  1498→              const bonusValue = parseFloat(gymnast.bonus) || 0;\n  1499→              const hasStick = bonusValue > 0;\n  1500→\n  1501→              const gymnastData = {\n  1502→                name: gymnast.full_name,\n  1503→                firstName: gymnast.first_name || '',\n  1504→                lastName: gymnast.last_name || '',\n  1505→                apiHeadshot: gymnast.headshot || '',\n  1506→                score: currScore,\n  1507→                startValue: gymnast.start_value || null,\n  1508→                execution: gymnast.execution || null,\n  1509→                difficulty: gymnast.difficulty || null,\n  1510→                bonus: bonusValue,\n  1511→                hasStick: hasStick,\n  1512→                order: gymnast.order,\n  1513→                event: eventKey,\n  1514→                team: teamKey,\n  1515→                gymnastKey: gymnastKey,\n  1516→                timestamp: pollTimestamp,\n  1517→                isCorrection: prevScore != null  // True if score was changed (not new)\n  1518→              };\n  1519→\n  1520→              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}`] = gymnastData;\n  1521→              hasChanges = true;\n  1522→\n  1523→              console.log('Score change detected:', {\n  1524→                gymnast: gymnast.full_name,\n  1525→                event: eventKey,\n  1526→                team: teamKey,\n  1527→                prev: prevScore,\n  1528→                curr: currScore,\n  1529→                isCorrection: prevScore != null\n  1530→              });\n  1531→\n  1532→              // Trigger flash for this score change (A5)\n  1533→              const teamIndex = teamIdx + 1;  // Convert 0-based to 1-based index\n  1534→              if (isFlashActive(teamIndex, gymnastKey)) {\n  1535→                // Correction during active flash - interrupt and replace\n  1536→                interruptFlash(teamIndex, gymnastData);\n  1537→              } else {\n  1538→                // Queue new flash for this team\n  1539→                triggerScoreFlash(teamIndex, gymnastData);\n  1540→              }\n  1541→            }\n  1542→\n  1543→            // Score removed (rare - inquiry pending)\n  1544→            if (currScore == null && prevScore != null) {\n  1545→              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}/score`] = null;\n  1546→              hasChanges = true;\n  1547→              console.log('Score removed:', { gymnast: gymnast.full_name, event: eventKey });\n  1548→            }\n  1549→          });\n  1550→        });\n  1551→      });\n  1552→\n  1553→      // Write to Firebase (using safeWrite for offline resilience)\n  1554→      if (hasChanges) {\n  1555→        // Write changed paths and reset stale counter\n  1556→        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n  1557→          ...changedPaths,\n  1558→          lastDataChangeTimestamp: pollTimestamp,\n  1559→          stalePollCount: 0\n  1560→        });\n  1561→        state.stalePollCount = 0;\n  1562→\n  1563→        console.log('Wrote incremental deltas to Firebase:', Object.keys(changedPaths).length, 'paths');\n  1564→      } else {\n  1565→        // No changes - increment stale counter\n  1566→        state.stalePollCount++;\n  1567→        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n  1568→          lastPollTimestamp: pollTimestamp,\n  1569→          stalePollCount: state.stalePollCount\n  1570→        });\n  1571→      }\n  1572→\n  1573→      // Update previous state for next comparison\n  1574→      state.previousScores = buildScoreMap(apiTeams);\n  1575→      state.previousTeamTotals = buildTeamTotalMap(apiTeams);\n  1576→\n  1577→      // Detect and update rotation (A10)\n  1578→      const newRotation = detectRotation(apiTeams);\n  1579→      if (newRotation.current !== state.rotation.current ||\n  1580→          newRotation.isFinal !== state.rotation.isFinal) {\n  1581→        state.rotation = newRotation;\n  1582→        updateRotationTag();\n  1583→\n  1584→        // Write rotation to Firebase for producer panel visibility\n  1585→        await safeWrite(scoreBugRef.child('liveData/rotation'), 'set', newRotation.current);\n  1586→        await safeWrite(scoreBugRef.child('liveData/totalRotations'), 'set', newRotation.total);\n  1587→        await safeWrite(scoreBugRef.child('liveData/isFinal'), 'set', newRotation.isFinal);\n  1588→\n  1589→        console.log('Rotation updated:', newRotation);\n  1590→      }\n  1591→\n  1592→      // Detect now-competing athletes (B1)\n  1593→      const nowCompeting = detectAllNowCompeting(apiTeams);\n  1594→      const prevNowCompeting = state.nowCompeting || [];\n  1595→\n  1596→      // Check if now-competing has changed\n  1597→      const nowCompetingChanged = JSON.stringify(nowCompeting) !== JSON.stringify(prevNowCompeting);\n  1598→\n  1599→      if (nowCompetingChanged) {\n  1600→        state.nowCompeting = nowCompeting;\n  1601→\n  1602→        // Write detected state to Firebase for producer panel visibility\n  1603→        await safeWrite(scoreBugRef.child('detected/nowCompeting'), 'set', nowCompeting);\n  1604→\n  1605→        console.log('Now competing updated:', nowCompeting);\n  1606→\n  1607→        // Update now-competing slot displays (B2)\n  1608→        updateAllNowCompeting();\n  1609→      }\n  1610→\n  1611→      // Write detected teams list for lineup card controls (D7)\n  1612→      const detectedTeams = apiTeams.map((team, idx) => ({\n  1613→        teamIndex: idx,\n  1614→        teamKey: team.short_name || `team${idx + 1}`,\n  1615→        teamName: team.name,\n  1616→        tricode: team.tricode\n  1617→      }));\n  1618→      const prevDetectedTeams = state.detectedTeams || [];\n  1619→      if (JSON.stringify(detectedTeams) !== JSON.stringify(prevDetectedTeams)) {\n  1620→        state.detectedTeams = detectedTeams;\n  1621→        await safeWrite(scoreBugRef.child('detected/teams'), 'set', detectedTeams);\n  1622→      }\n  1623→\n  1624→      // Update lineup card if visible (C5 - live update with new scores)\n  1625→      if (state.showLineup) {\n  1626→        updateLineupCard();\n  1627→      }\n  1628→    }\n  1629→\n  1630→    /**\n  1631→     * Build score map from API teams data.\n  1632→     * @returns {Object} Map of gymnastKey -> finalScore (string)\n  1633→     */\n  1634→    function buildScoreMap(apiTeams) {\n  1635→      const map = {};\n  1636→      apiTeams.forEach((team, teamIdx) => {\n  1637→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n  1638→        const events = team.events || [];\n  1639→\n  1640→        events.forEach((event) => {\n  1641→          const gymnasts = event.gymnasts || [];\n  1642→          gymnasts.forEach((gymnast) => {\n  1643→            const gymnastKey = gymnast.gymnast_id ||\n  1644→              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n  1645→            map[gymnastKey] = gymnast.final_score;  // string or null\n  1646→          });\n  1647→        });\n  1648→      });\n  1649→      return map;\n  1650→    }\n  1651→\n  1652→    /**\n  1653→     * Build team total map from API teams data.\n  1654→     * @returns {Object} Map of teamKey -> finalScore (string)\n  1655→     */\n  1656→    function buildTeamTotalMap(apiTeams) {\n  1657→      const map = {};\n  1658→      apiTeams.forEach((team, teamIdx) => {\n  1659→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n  1660→        map[teamKey] = team.final_score;  // string or null\n  1661→      });\n  1662→      return map;\n  1663→    }\n  1664→\n  1665→    // ============================================================\n  1666→    // SCORE DIFF ENGINE - Flash Queue Management (Task A5)\n  1667→    // ============================================================\n  1668→\n  1669→    /**\n  1670→     * Check if a flash is currently active for a given team and gymnast.\n  1671→     * Used to detect score corrections during active flash display.\n  1672→     * @param {number} teamIndex - 1-based team index\n  1673→     * @param {string} gymnastKey - Unique gymnast identifier\n  1674→     * @returns {boolean} True if flash is active for this gymnast\n  1675→     */\n  1676→    function isFlashActive(teamIndex, gymnastKey) {\n  1677→      const activeFlash = state.activeFlashes[teamIndex];\n  1678→      return activeFlash && activeFlash.gymnastKey === gymnastKey;\n  1679→    }\n  1680→\n  1681→    /**\n  1682→     * Interrupt current flash with a new one (score correction case).\n  1683→     * Immediately replaces the active flash and resets timer.\n  1684→     * @param {number} teamIndex - 1-based team index\n  1685→     * @param {Object} gymnastData - New score data to display\n  1686→     */\n  1687→    function interruptFlash(teamIndex, gymnastData) {\n  1688→      console.log('Interrupting active flash with correction:', {\n  1689→        team: teamIndex,\n  1690→        gymnast: gymnastData.name,\n  1691→        newScore: gymnastData.score\n  1692→      });\n  1693→\n  1694→      // Clear existing flash timer\n  1695→      if (state.activeFlashes[teamIndex]?.timer) {\n  1696→        clearTimeout(state.activeFlashes[teamIndex].timer);\n  1697→      }\n  1698→\n  1699→      // Replace with new flash data\n  1700→      state.activeFlashes[teamIndex] = {\n  1701→        ...gymnastData,\n  1702→        startTime: Date.now(),\n  1703→        timer: null\n  1704→      };\n  1705→\n  1706→      // Render the updated flash immediately\n  1707→      renderFlash(teamIndex, gymnastData);\n  1708→\n  1709→      // Set new timer\n  1710→      state.activeFlashes[teamIndex].timer = setTimeout(() => {\n  1711→        advanceFlashQueue(teamIndex);\n  1712→      }, state.flashDuration);\n  1713→    }\n  1714→\n  1715→    /**\n  1716→     * Queue a new score flash for a team.\n  1717→     * If no flash is active, displays immediately. Otherwise queued.\n  1718→     * @param {number} teamIndex - 1-based team index\n  1719→     * @param {Object} gymnastData - Score data to display\n  1720→     */\n  1721→    function triggerScoreFlash(teamIndex, gymnastData) {\n  1722→      // Initialize queue if needed\n  1723→      if (!state.flashQueues[teamIndex]) {\n  1724→        state.flashQueues[teamIndex] = [];\n  1725→      }\n  1726→\n  1727→      const queue = state.flashQueues[teamIndex];\n  1728→\n  1729→      // Edge case: Check if this gymnast is already in the queue (correction before display)\n  1730→      const existingIndex = queue.findIndex(item => item.gymnastKey === gymnastData.gymnastKey);\n  1731→      if (existingIndex !== -1) {\n  1732→        // Update existing queue entry with corrected score (A13: corrections in queue)\n  1733→        console.log('Updating queued flash with correction:', {\n  1734→          team: teamIndex,\n  1735→          gymnast: gymnastData.name,\n  1736→          oldScore: queue[existingIndex].score,\n  1737→          newScore: gymnastData.score\n  1738→        });\n  1739→        queue[existingIndex] = { ...gymnastData, isCorrection: true };\n  1740→        return;\n  1741→      }\n  1742→\n  1743→      // Edge case: Cap queue length to prevent runaway (A13: rapid scores)\n  1744→      const MAX_QUEUE_SIZE = 6;  // Max gymnasts per rotation\n  1745→      if (queue.length >= MAX_QUEUE_SIZE) {\n  1746→        console.warn('Flash queue full, dropping oldest entry:', {\n  1747→          team: teamIndex,\n  1748→          dropped: queue[0].name,\n  1749→          newEntry: gymnastData.name\n  1750→        });\n  1751→        queue.shift();\n  1752→      }\n  1753→\n  1754→      console.log('Queuing score flash:', {\n  1755→        team: teamIndex,\n  1756→        gymnast: gymnastData.name,\n  1757→        score: gymnastData.score,\n  1758→        queueLength: queue.length\n  1759→      });\n  1760→\n  1761→      // Add to queue\n  1762→      queue.push(gymnastData);\n  1763→\n  1764→      // If no active flash, start displaying\n  1765→      if (!state.activeFlashes[teamIndex]) {\n  1766→        displayNextFlash(teamIndex);\n  1767→      }\n  1768→    }\n  1769→\n  1770→    /**\n  1771→     * Display the next flash from the queue.\n  1772→     * Called when starting or advancing the queue.\n  1773→     * @param {number} teamIndex - 1-based team index\n  1774→     */\n  1775→    function displayNextFlash(teamIndex) {\n  1776→      const queue = state.flashQueues[teamIndex] || [];\n  1777→\n  1778→      if (queue.length === 0) {\n  1779→        // No more flashes - clear active state\n  1780→        state.activeFlashes[teamIndex] = null;\n  1781→        clearFlashDisplay(teamIndex);\n  1782→        return;\n  1783→      }\n  1784→\n  1785→      // Get next flash from queue\n  1786→      const gymnastData = queue.shift();\n  1787→\n  1788→      // Set as active\n  1789→      state.activeFlashes[teamIndex] = {\n  1790→        ...gymnastData,\n  1791→        startTime: Date.now(),\n  1792→        timer: setTimeout(() => {\n  1793→          advanceFlashQueue(teamIndex);\n  1794→        }, state.flashDuration)\n  1795→      };\n  1796→\n  1797→      // Render the flash\n  1798→      renderFlash(teamIndex, gymnastData);\n  1799→    }\n  1800→\n  1801→    /**\n  1802→     * Advance to next flash in queue (called when timer expires).\n  1803→     * @param {number} teamIndex - 1-based team index\n  1804→     */\n  1805→    function advanceFlashQueue(teamIndex) {\n  1806→      // Clear current flash timer\n  1807→      if (state.activeFlashes[teamIndex]?.timer) {\n  1808→        clearTimeout(state.activeFlashes[teamIndex].timer);\n  1809→      }\n  1810→\n  1811→      // Display next or clear\n  1812→      displayNextFlash(teamIndex);\n  1813→    }\n  1814→\n  1815→    /**\n  1816→     * Render a score flash in a team's slot area with slot machine animation.\n  1817→     * TODO: Task A7 will enhance rendering with headshots/apparatus.\n  1818→     * @param {number} teamIndex - 1-based team index\n  1819→     * @param {Object} gymnastData - Score data to render\n  1820→     */\n  1821→    function renderFlash(teamIndex, gymnastData) {\n  1822→      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n  1823→      if (!slotContent) return;\n  1824→\n  1825→      // Check if there's existing content to animate out\n  1826→      const hasExistingContent = slotContent.innerHTML.trim() !== '';\n  1827→\n  1828→      if (hasExistingContent) {\n  1829→        // Spin out existing content first\n  1830→        slotContent.classList.remove('spin-in', 'visible');\n  1831→        slotContent.classList.add('spin-out');\n  1832→\n  1833→        // After spin-out completes, insert new content and spin in\n  1834→        setTimeout(() => {\n  1835→          insertFlashContent(slotContent, gymnastData);\n  1836→          triggerSpinIn(slotContent);\n  1837→        }, 400);  // Match spin-out animation duration\n  1838→      } else {\n  1839→        // No existing content - insert and spin in directly\n  1840→        insertFlashContent(slotContent, gymnastData);\n  1841→        triggerSpinIn(slotContent);\n  1842→      }\n  1843→\n  1844→      console.log('Rendered flash:', {\n  1845→        team: teamIndex,\n  1846→        gymnast: gymnastData.name,\n  1847→        score: gymnastData.score,\n  1848→        animated: hasExistingContent ? 'spin-transition' : 'spin-in'\n  1849→      });\n  1850→    }\n  1851→\n  1852→    /**\n  1853→     * Insert flash content HTML into slot element (Task A7).\n  1854→     * Renders: apparatus | name | SV | separator | score | correction indicator\n  1855→     * @param {HTMLElement} slotContent - The slot content container\n  1856→     * @param {Object} gymnastData - Score data to render\n  1857→     */\n  1858→    function insertFlashContent(slotContent, gymnastData) {\n  1859→      // Get headshot URL (E3) with fallback (E5)\n  1860→      const headshotUrl = getAthleteHeadshot(\n  1861→        gymnastData.firstName,\n  1862→        gymnastData.lastName,\n  1863→        gymnastData.apiHeadshot\n  1864→      );\n  1865→      // Escape names for use in onerror attribute\n  1866→      const escapedFirst = (gymnastData.firstName || '').replace(/'/g, \"\\\\'\");\n  1867→      const escapedLast = (gymnastData.lastName || '').replace(/'/g, \"\\\\'\");\n  1868→      const headshotHtml = headshotUrl\n  1869→        ? `<img class=\"slot-headshot\" src=\"${headshotUrl}\" alt=\"\" onerror=\"handleHeadshotError(this, '${escapedFirst}', '${escapedLast}')\">`\n  1870→        : `<div class=\"slot-headshot-fallback\" style=\"width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#374151 0%,#1f2937 100%);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#9ca3af;flex-shrink:0;\">${(gymnastData.firstName || '').charAt(0).toUpperCase()}${(gymnastData.lastName || '').charAt(0).toUpperCase() || '?'}</div>`;\n  1871→\n  1872→      // Format start value for display (e.g., \"5.0\" or \"5.2\")\n  1873→      const svDisplay = gymnastData.startValue\n  1874→        ? `<span class=\"slot-sv\">SV ${parseFloat(gymnastData.startValue).toFixed(1)}</span>`\n  1875→        : '';\n  1876→\n  1877→      // Format score for display (e.g., \"13.450\")\n  1878→      const scoreValue = parseFloat(gymnastData.score);\n  1879→      const scoreDisplay = isNaN(scoreValue) ? gymnastData.score : scoreValue.toFixed(3);\n  1880→\n  1881→      // Stick indicator for bonus landings (men's gymnastics only)\n  1882→      const stickIndicator = (state.gender === 'mens' && gymnastData.hasStick) ? '<span class=\"slot-stick\">Stick</span>' : '';\n  1883→\n  1884→      slotContent.innerHTML = `\n  1885→        ${headshotHtml}\n  1886→        <span class=\"slot-apparatus\">${gymnastData.event}</span>\n  1887→        <span class=\"slot-name\">${gymnastData.name}</span>\n  1888→        ${svDisplay}\n  1889→        <span class=\"slot-separator\">•</span>\n  1890→        <span class=\"slot-score\">${scoreDisplay}</span>\n  1891→        ${stickIndicator}\n  1892→        ${gymnastData.isCorrection ? '<span class=\"slot-correction\">(corrected)</span>' : ''}\n  1893→      `;\n  1894→    }\n  1895→\n  1896→    /**\n  1897→     * Trigger spin-in animation on slot content.\n  1898→     * @param {HTMLElement} slotContent - The slot content container\n  1899→     */\n  1900→    function triggerSpinIn(slotContent) {\n  1901→      // Reset animation state\n  1902→      slotContent.classList.remove('spin-out', 'exit-up', 'enter-from-below');\n  1903→\n  1904→      // Force reflow to ensure animation restarts\n  1905→      void slotContent.offsetWidth;\n  1906→\n  1907→      // Trigger spin-in animation\n  1908→      slotContent.classList.add('spin-in', 'visible');\n  1909→    }\n  1910→\n  1911→    /**\n  1912→     * Clear flash display for a team (return to idle state) with spin-out animation.\n  1913→     * After flash ends, checks if there's a now-competing state to restore (B5).\n  1914→     * @param {number} teamIndex - 1-based team index\n  1915→     */\n  1916→    function clearFlashDisplay(teamIndex) {\n  1917→      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n  1918→      if (!slotContent) return;\n  1919→\n  1920→      // Only animate if there's content to clear\n  1921→      if (slotContent.innerHTML.trim() === '') return;\n  1922→\n  1923→      // Trigger spin-out animation\n  1924→      slotContent.classList.remove('spin-in', 'visible');\n  1925→      slotContent.classList.add('spin-out');\n  1926→\n  1927→      // After animation completes, either restore now-competing or clear (B5)\n  1928→      setTimeout(() => {\n  1929→        if (state.activeFlashes[teamIndex]) return;  // New flash started during animation\n  1930→\n  1931→        // Check if there's a now-competing state to restore\n  1932→        const nowCompetingToRestore = getNowCompetingForTeam(teamIndex);\n  1933→\n  1934→        if (nowCompetingToRestore) {\n  1935→          // Restore now-competing display\n  1936→          insertNowCompetingContent(slotContent, nowCompetingToRestore);\n  1937→          triggerSpinIn(slotContent);\n  1938→          console.log('Restored now-competing after flash:', {\n  1939→            team: teamIndex,\n  1940→            athlete: nowCompetingToRestore.athlete?.name\n  1941→          });\n  1942→        } else {\n  1943→          // No now-competing to show - clear the slot\n  1944→          slotContent.innerHTML = '';\n  1945→          slotContent.classList.remove('spin-out');\n  1946→        }\n  1947→      }, 400);  // Match CSS animation duration\n  1948→    }\n  1949→\n  1950→    /**\n  1951→     * Get the current now-competing data for a team (B5).\n  1952→     * Respects auto/manual mode settings.\n  1953→     * @param {number} teamIndex - 1-based team index\n  1954→     * @returns {Object|null} Now-competing data or null\n  1955→     */\n  1956→    function getNowCompetingForTeam(teamIndex) {\n  1957→      // Find the team by index\n  1958→      const teamArrayIdx = state.teams.findIndex(t => t.index === teamIndex);\n  1959→      if (teamArrayIdx === -1) return null;\n  1960→\n  1961→      const nowCompeting = state.nowCompeting.find(nc => nc.teamIndex === teamArrayIdx);\n  1962→      if (!nowCompeting) return null;\n  1963→\n  1964→      // Check if we should show based on mode\n  1965→      if (state.automationMode === 'auto') {\n  1966→        return nowCompeting;\n  1967→      } else {\n  1968→        // Manual mode - only if producer has enabled\n  1969→        return state.manualNowCompeting[teamIndex] ? nowCompeting : null;\n  1970→      }\n  1971→    }\n  1972→\n  1973→    // ============================================================\n  1974→    // NOW-COMPETING SLOT STATE (Task B2)\n  1975→    // ============================================================\n  1976→\n  1977→    /**\n  1978→     * Render \"now competing\" state in a team's slot area.\n  1979→     * Shows: athlete name + apparatus (no start value - not known until after)\n  1980→     * Uses same slot animation system as score flashes.\n  1981→     * @param {number} teamIndex - 1-based team index\n  1982→     * @param {Object} nowCompetingData - { athlete: { name }, eventName }\n  1983→     */\n  1984→    function renderNowCompeting(teamIndex, nowCompetingData) {\n  1985→      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n  1986→      if (!slotContent) return;\n  1987→\n  1988→      // Don't show now-competing if there's an active score flash\n  1989→      if (state.activeFlashes[teamIndex]) {\n  1990→        console.log('Skipping now-competing render - score flash active', { team: teamIndex });\n  1991→        return;\n  1992→      }\n  1993→\n  1994→      // Check if there's existing content to animate out\n  1995→      const hasExistingContent = slotContent.innerHTML.trim() !== '';\n  1996→\n  1997→      if (hasExistingContent) {\n  1998→        // Spin out existing content first\n  1999→        slotContent.classList.remove('spin-in', 'visible');\n  2000→        slotContent.classList.add('spin-out');\n  2001→\n  2002→        // After spin-out completes, insert new content and spin in\n  2003→        setTimeout(() => {\n  2004→          insertNowCompetingContent(slotContent, nowCompetingData);\n  2005→          triggerSpinIn(slotContent);\n  2006→        }, 400);  // Match spin-out animation duration\n  2007→      } else {\n  2008→        // No existing content - insert and spin in directly\n  2009→        insertNowCompetingContent(slotContent, nowCompetingData);\n  2010→        triggerSpinIn(slotContent);\n  2011→      }\n  2012→\n  2013→      console.log('Rendered now-competing:', {\n  2014→        team: teamIndex,\n  2015→        athlete: nowCompetingData.athlete.name,\n  2016→        event: nowCompetingData.eventName\n  2017→      });\n  2018→    }\n  2019→\n  2020→    /**\n  2021→     * Insert now-competing content HTML into slot element.\n  2022→     * Renders: apparatus | \"UP NOW\" label | athlete name\n  2023→     * @param {HTMLElement} slotContent - The slot content container\n  2024→     * @param {Object} nowCompetingData - { athlete: { name }, eventName }\n  2025→     */\n  2026→    function insertNowCompetingContent(slotContent, nowCompetingData) {\n  2027→      const athlete = nowCompetingData.athlete || {};\n  2028→      const athleteName = athlete.name || 'Unknown';\n  2029→      const eventName = nowCompetingData.eventName || '';\n  2030→\n  2031→      // Format event name to short code if possible (e.g., \"Floor Exercise\" -> \"FX\")\n  2032→      const eventShort = getEventShortCode(eventName) || eventName;\n  2033→\n  2034→      // Get headshot URL (E4) with fallback (E5)\n  2035→      const headshotUrl = getAthleteHeadshot(\n  2036→        athlete.firstName,\n  2037→        athlete.lastName,\n  2038→        athlete.apiHeadshot\n  2039→      );\n  2040→      // Escape names for use in onerror attribute\n  2041→      const escapedFirst = (athlete.firstName || '').replace(/'/g, \"\\\\'\");\n  2042→      const escapedLast = (athlete.lastName || '').replace(/'/g, \"\\\\'\");\n  2043→      const headshotHtml = headshotUrl\n  2044→        ? `<img class=\"slot-headshot\" src=\"${headshotUrl}\" alt=\"\" onerror=\"handleHeadshotError(this, '${escapedFirst}', '${escapedLast}')\">`\n  2045→        : `<div class=\"slot-headshot-fallback\" style=\"width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#374151 0%,#1f2937 100%);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#9ca3af;flex-shrink:0;\">${(athlete.firstName || '').charAt(0).toUpperCase()}${(athlete.lastName || '').charAt(0).toUpperCase() || '?'}</div>`;\n  2046→\n  2047→      slotContent.innerHTML = `\n  2048→        ${headshotHtml}\n  2049→        <span class=\"slot-apparatus\">${eventShort}</span>\n  2050→        <span class=\"slot-sv\" style=\"color: #22d3ee;\">UP NOW</span>\n  2051→        <span class=\"slot-name\">${athleteName}</span>\n  2052→      `;\n  2053→    }\n  2054→\n  2055→    /**\n  2056→     * Convert event name to short code (e.g., \"Floor Exercise\" -> \"FX\").\n  2057→     * @param {string} eventName - Full event name from API\n  2058→     * @returns {string} Short code or original name\n  2059→     */\n  2060→    function getEventShortCode(eventName) {\n  2061→      if (!eventName) return '';\n  2062→\n  2063→      const name = eventName.toLowerCase();\n  2064→\n  2065→      // Men's events\n  2066→      if (name.includes('floor')) return 'FX';\n  2067→      if (name.includes('pommel') || name.includes('horse')) return 'PH';\n  2068→      if (name.includes('ring')) return 'SR';\n  2069→      if (name.includes('vault')) return 'VT';\n  2070→      if (name.includes('parallel')) return 'PB';\n  2071→      if (name.includes('high bar') || name.includes('horizontal')) return 'HB';\n  2072→\n  2073→      // Women's events\n  2074→      if (name.includes('uneven') || name.includes('bars')) return 'UB';\n  2075→      if (name.includes('beam') || name.includes('balance')) return 'BB';\n  2076→\n  2077→      return eventName;\n  2078→    }\n  2079→\n  2080→    /**\n  2081→     * Clear now-competing display for a team (when they finish or move to flash).\n  2082→     * @param {number} teamIndex - 1-based team index\n  2083→     */\n  2084→    function clearNowCompeting(teamIndex) {\n  2085→      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n  2086→      if (!slotContent) return;\n  2087→\n  2088→      // Don't clear if a score flash is showing\n  2089→      if (state.activeFlashes[teamIndex]) return;\n  2090→\n  2091→      // Only animate if there's content to clear\n  2092→      if (slotContent.innerHTML.trim() === '') return;\n  2093→\n  2094→      // Check if showing now-competing content (has \"UP NOW\" label)\n  2095→      if (!slotContent.innerHTML.includes('UP NOW')) return;\n  2096→\n  2097→      // Trigger spin-out animation\n  2098→      slotContent.classList.remove('spin-in', 'visible');\n  2099→      slotContent.classList.add('spin-out');\n  2100→\n  2101→      // Clear content after animation completes\n  2102→      setTimeout(() => {\n  2103→        if (!state.activeFlashes[teamIndex]) {\n  2104→          slotContent.innerHTML = '';\n  2105→          slotContent.classList.remove('spin-out');\n  2106→        }\n  2107→      }, 400);  // Match CSS animation duration\n  2108→    }\n  2109→\n  2110→    /**\n  2111→     * Update now-competing displays for all teams based on current state.\n  2112→     * Called after processApiData detects now-competing changes.\n  2113→     *\n  2114→     * Behavior differs by mode:\n  2115→     * - Auto mode (B3): Automatically show all detected now-competing athletes\n  2116→     * - Manual mode (B4): Only show when producer explicitly enables via Firebase nowCompeting\n  2117→     */\n  2118→    function updateAllNowCompeting() {\n  2119→      state.teams.forEach((team, idx) => {\n  2120→        const teamIndex = team.index;\n  2121→        const nowCompeting = state.nowCompeting.find(nc => nc.teamIndex === idx);\n  2122→\n  2123→        // Determine if we should show now-competing for this team\n  2124→        let shouldShow = false;\n  2125→\n  2126→        if (state.automationMode === 'auto') {\n  2127→          // Auto mode (B3): Show if detected\n  2128→          shouldShow = !!nowCompeting;\n  2129→        } else {\n  2130→          // Manual mode (B4): Only show if producer has enabled AND we have data\n  2131→          shouldShow = !!nowCompeting && state.manualNowCompeting[teamIndex] === true;\n  2132→        }\n  2133→\n  2134→        if (shouldShow && nowCompeting) {\n  2135→          renderNowCompeting(teamIndex, nowCompeting);\n  2136→        } else {\n  2137→          clearNowCompeting(teamIndex);\n  2138→        }\n  2139→      });\n  2140→    }\n  2141→\n  2142→    /**\n  2143→     * Get current flash queue status for debugging/producer panel.\n  2144→     * @returns {Object} Queue status by team\n  2145→     */\n  2146→    function getFlashQueueStatus() {\n  2147→      const status = {};\n  2148→      state.teams.forEach((team) => {\n  2149→        const queue = state.flashQueues[team.index] || [];\n  2150→        const active = state.activeFlashes[team.index];\n  2151→        status[team.index] = {\n  2152→          teamName: team.name,\n  2153→          queueLength: queue.length,\n  2154→          activeFlash: active ? {\n  2155→            gymnast: active.name,\n  2156→            score: active.score,\n  2157→            timeRemaining: active.startTime ?\n  2158→              Math.max(0, state.flashDuration - (Date.now() - active.startTime)) : 0\n  2159→          } : null\n  2160→        };\n  2161→      });\n  2162→      return status;\n  2163→    }\n  2164→\n  2165→    // ============================================================\n  2166→    // ROTATION DETECTION (Task A10)\n  2167→    // ============================================================\n  2168→\n  2169→    /**\n  2170→     * Detect current rotation from API data using ALL teams.\n  2171→     * For standard meets (teams <= apparatus): rotation advances when ALL teams\n  2172→     * have completed their current event.\n  2173→     * For meets with byes (teams > apparatus, e.g., 7-team women's): uses the\n  2174→     * API's rotation field on events to determine the current rotation.\n  2175→     * @param {Array} apiTeams - Teams array from Virtius API\n  2176→     * @returns {Object} { current: number, total: number, isFinal: boolean }\n  2177→     */\n  2178→    function detectRotation(apiTeams) {\n  2179→      if (!apiTeams || apiTeams.length === 0) {\n  2180→        return state.rotation;  // Keep existing state if no data\n  2181→      }\n  2182→\n  2183→      const totalRotations = state.rotation.total;\n  2184→      const eventCount = state.gender === 'womens' ? 4 : 6;\n  2185→      const hasByes = state.teams.length > eventCount;\n  2186→\n  2187→      if (hasByes) {\n  2188→        // For meets with byes, use the API's rotation field on events\n  2189→        // to detect which rotation is currently in progress or most recently completed\n  2190→        return detectRotationFromApiFields(apiTeams, totalRotations);\n  2191→      }\n  2192→\n  2193→      // Standard detection: min completed events across ALL teams\n  2194→      let minCompletedAcrossTeams = totalRotations;\n  2195→\n  2196→      apiTeams.forEach((team) => {\n  2197→        const events = team.events || [];\n  2198→        let completedEvents = 0;\n  2199→\n  2200→        events.forEach((event) => {\n  2201→          const gymnasts = event.gymnasts || [];\n  2202→          // An event is \"complete\" if all gymnasts have scores\n  2203→          const scored = gymnasts.filter(g => g.final_score != null);\n  2204→          if (scored.length === gymnasts.length && gymnasts.length > 0) {\n  2205→            completedEvents++;\n  2206→          }\n  2207→        });\n  2208→\n  2209→        minCompletedAcrossTeams = Math.min(minCompletedAcrossTeams, completedEvents);\n  2210→      });\n  2211→\n  2212→      // All events complete for all teams = Final\n  2213→      if (minCompletedAcrossTeams === totalRotations) {\n  2214→        return { current: totalRotations, total: totalRotations, isFinal: true };\n  2215→      }\n  2216→\n  2217→      // Current rotation = completed events + 1\n  2218→      const currentRotation = minCompletedAcrossTeams + 1;\n  2219→      return { current: currentRotation, total: totalRotations, isFinal: false };\n  2220→    }\n  2221→\n  2222→    /**\n  2223→     * Detect rotation for meets with byes using the API's rotation field.\n  2224→     * Finds the highest rotation number that has at least one score in progress.\n  2225→     * @param {Array} apiTeams - Teams array from Virtius API\n  2226→     * @param {number} totalRotations - Total rotation count for this meet\n  2227→     * @returns {Object} { current: number, total: number, isFinal: boolean }\n  2228→     */\n  2229→    function detectRotationFromApiFields(apiTeams, totalRotations) {\n  2230→      let maxRotationWithScores = 0;\n  2231→      let allEventsComplete = true;\n  2232→\n  2233→      apiTeams.forEach((team) => {\n  2234→        (team.events || []).forEach((event) => {\n  2235→          const rotation = event.rotation;\n  2236→          if (!rotation) return;\n  2237→\n  2238→          const gymnasts = event.gymnasts || [];\n  2239→          const scored = gymnasts.filter(g => g.final_score != null);\n  2240→\n  2241→          if (scored.length > 0) {\n  2242→            maxRotationWithScores = Math.max(maxRotationWithScores, rotation);\n  2243→          }\n  2244→          // Check if any event is still incomplete\n  2245→          if (scored.length < gymnasts.length) {\n  2246→            allEventsComplete = false;\n  2247→          }\n  2248→        });\n  2249→      });\n  2250→\n  2251→      if (allEventsComplete && maxRotationWithScores > 0) {\n  2252→        return { current: totalRotations, total: totalRotations, isFinal: true };\n  2253→      }\n  2254→\n  2255→      const currentRotation = Math.max(1, maxRotationWithScores);\n  2256→      return { current: currentRotation, total: totalRotations, isFinal: false };\n  2257→    }\n  2258→\n  2259→    /**\n  2260→     * Detect the currently competing athlete for a team.\n  2261→     * Finds the next athlete without a score in an event that has some scores.\n  2262→     * Based on logic from GraphicsControl.jsx:216-269.\n  2263→     * @param {Object} team - Team object from Virtius API\n  2264→     * @returns {Object|null} { athlete: Object, event: Object } or null\n  2265→     */\n  2266→    function detectNowCompeting(team) {\n  2267→      if (!team || !team.events) return null;\n  2268→\n  2269→      // Olympic order for events (already sorted in API, but just in case)\n  2270→      const events = team.events;\n  2271→\n  2272→      for (const event of events) {\n  2273→        const gymnasts = event.gymnasts || [];\n  2274→        if (gymnasts.length === 0) continue;\n  2275→\n  2276→        // Sort by order (lineup position)\n  2277→        const sortedGymnasts = [...gymnasts].sort((a, b) => (a.order || 0) - (b.order || 0));\n  2278→\n  2279→        // Find scored and unscored athletes\n  2280→        const scored = sortedGymnasts.filter(g => g.final_score != null);\n  2281→        const unscored = sortedGymnasts.filter(g => g.final_score == null);\n  2282→\n  2283→        // If this event has some scores but not all, it's in progress\n  2284→        if (scored.length > 0 && unscored.length > 0) {\n  2285→          return {\n  2286→            athlete: unscored[0],\n  2287→            event: event\n  2288→          };\n  2289→        }\n  2290→      }\n  2291→\n  2292→      return null; // No one currently competing (between rotations or complete)\n  2293→    }\n  2294→\n  2295→    /**\n  2296→     * Detect now-competing athletes for all teams and return results.\n  2297→     * @param {Array} apiTeams - Teams array from Virtius API\n  2298→     * @returns {Array} Array of { teamIndex, teamName, tricode, athlete, eventName }\n  2299→     */\n  2300→    function detectAllNowCompeting(apiTeams) {\n  2301→      if (!apiTeams || apiTeams.length === 0) return [];\n  2302→\n  2303→      const results = [];\n  2304→\n  2305→      apiTeams.forEach((team, teamIndex) => {\n  2306→        const nowCompeting = detectNowCompeting(team);\n  2307→        if (nowCompeting) {\n  2308→          results.push({\n  2309→            teamIndex: teamIndex,\n  2310→            teamKey: team.short_name || `team${teamIndex + 1}`,\n  2311→            teamName: team.name,\n  2312→            tricode: team.tricode,\n  2313→            athlete: {\n  2314→              id: nowCompeting.athlete.gymnast_id,\n  2315→              name: nowCompeting.athlete.full_name,\n  2316→              firstName: nowCompeting.athlete.first_name || '',\n  2317→              lastName: nowCompeting.athlete.last_name || '',\n  2318→              apiHeadshot: nowCompeting.athlete.headshot || '',\n  2319→              order: nowCompeting.athlete.order,\n  2320→              type: nowCompeting.athlete.type // 0=competing, 1=exhibition, etc.\n  2321→            },\n  2322→            eventName: nowCompeting.event.event_name\n  2323→          });\n  2324→        }\n  2325→      });\n  2326→\n  2327→      return results;\n  2328→    }\n  2329→\n  2330→    /**\n  2331→     * Update the rotation tag display in the DOM.\n  2332→     * Shows \"Rotation X of Y\" or \"Final\" when complete.\n  2333→     */\n  2334→    function updateRotationTag() {\n  2335→      const tagEl = document.getElementById('rotationTag');\n  2336→      if (!tagEl) return;\n  2337→\n  2338→      const { current, total, isFinal } = state.rotation;\n  2339→\n  2340→      if (isFinal) {\n  2341→        tagEl.textContent = 'Final';\n  2342→      } else {\n  2343→        tagEl.textContent = `Rotation ${current} of ${total}`;\n  2344→      }\n  2345→    }\n  2346→\n  2347→    // Initialize Firebase schema with default values (prevents race conditions)\n  2348→    // Uses update() with null checks - only sets values that don't exist\n  2349→    async function initializeSchema() {\n  2350→      const defaultSchema = {\n  2351→        enabled: false,\n  2352→        polling: false,\n  2353→        automationMode: 'auto',\n  2354→        showLineup: null,\n  2355→        dismissFlash: {},\n  2356→        nowCompeting: {},\n  2357→        detected: {},\n  2358→        heartbeat: null,\n  2359→        liveData: {\n  2360→          lastPollTimestamp: null,\n  2361→          lastDataChangeTimestamp: null,\n  2362→          stalePollCount: 0,\n  2363→          rotation: null,\n  2364→          totalRotations: null,\n  2365→          teams: {}\n  2366→        },\n  2367→        lastError: null,\n  2368→        config: {\n  2369→          pollInterval: 5000,\n  2370→          flashDuration: 10000,\n  2371→          showStickIndicator: true\n  2372→        }\n  2373→      };\n  2374→\n  2375→      try {\n  2376→        // Use transaction to safely initialize schema without overwriting existing values\n  2377→        await scoreBugRef.transaction((currentData) => {\n  2378→          if (currentData === null) {\n  2379→            // No data exists - write full schema\n  2380→            console.log('Initializing scoreBug schema with defaults');\n  2381→            return defaultSchema;\n  2382→          }\n  2383→          // Data exists - merge defaults for any missing fields only\n  2384→          const merged = { ...defaultSchema };\n  2385→          Object.keys(currentData).forEach(key => {\n  2386→            if (currentData[key] !== undefined) {\n  2387→              // Keep existing value\n  2388→              merged[key] = currentData[key];\n  2389→            }\n  2390→          });\n  2391→          // Deep merge for nested objects (config, liveData)\n  2392→          if (currentData.config) {\n  2393→            merged.config = { ...defaultSchema.config, ...currentData.config };\n  2394→          }\n  2395→          if (currentData.liveData) {\n  2396→            merged.liveData = { ...defaultSchema.liveData, ...currentData.liveData };\n  2397→          }\n  2398→          console.log('Merged existing scoreBug data with defaults');\n  2399→          return merged;\n  2400→        });\n  2401→        console.log('Firebase schema initialized');\n  2402→      } catch (err) {\n  2403→        console.error('Failed to initialize schema:', err);\n  2404→      }\n  2405→    }\n  2406→\n  2407→    // Initialize on load\n  2408→    if (compId) {\n  2409→      // Start connection monitor immediately (A3d)\n  2410→      initConnectionMonitor();\n  2411→\n  2412→      // Order: load config -> render teams -> initialize schema -> start listeners\n  2413→      loadCompetitionConfig().then(async (success) => {\n  2414→        if (!success) return;  // Exit early, don't initialize listeners\n  2415→\n  2416→        // Render team rows with initial state (before API data)\n  2417→        renderTeamRows();\n  2418→\n  2419→        // Update rotation tag for correct total (4 for women, 6 for men)\n  2420→        updateRotationTag();\n  2421→\n  2422→        // Initialize Firebase schema (safe defaults)\n  2423→        await initializeSchema();\n  2424→\n  2425→        // Start listening for Firebase changes (only after successful config load)\n  2426→        initFirebaseListeners();\n  2427→      });\n  2428→    }\n  2429→  </script>\n  2430→  <script src=\"theme-loader.js\"></script>\n  2431→</body>\n  2432→</html>\n  2433→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5b031880-c959-4e00-9afb-faf8081cc469","uuid":"4348f015-e220-4239-b3a0-5fb5d04138b3","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/overlays/team-bug.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=1920, height=1080\">\n  <title>Team Score Bug</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n\n  <!-- Firebase SDK -->\n  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js\"></script>\n  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js\"></script>\n\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n\n    body {\n      font-family: 'Inter', sans-serif;\n      width: 1920px;\n      height: 1080px;\n      overflow: hidden;\n      background: transparent;\n    }\n\n    /* Score bug container - positioned on right side of screen */\n    .score-bug {\n      position: absolute;\n      top: 50%;\n      right: 0;\n      transform: translateY(-50%) translateX(100%);\n      display: flex;\n      flex-direction: column;\n      min-width: 500px;\n      opacity: 0;\n      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n\n    .score-bug.visible {\n      transform: translateY(-50%) translateX(0);\n      opacity: 1;\n    }\n\n    /* Rotation tag at top */\n    .rotation-tag {\n      background: #27272a;\n      color: #fff;\n      font-size: 20px;\n      font-weight: 700;\n      padding: 10px 20px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n\n    /* Team rows container */\n    .team-rows {\n      display: flex;\n      flex-direction: column;\n    }\n\n    /* Individual team row */\n    .team-row {\n      display: flex;\n      flex-direction: row;\n      background: #1a1a1a;\n      border-bottom: 1px solid #333;\n      min-height: 70px;\n    }\n\n    .team-row:last-child {\n      border-bottom: none;\n    }\n\n    /* Multi-team scaling: 3 teams - slightly compact */\n    .teams-3 .team-row {\n      min-height: 65px;\n    }\n\n    /* Multi-team scaling: 4 teams - compact */\n    .teams-4 .team-row {\n      min-height: 60px;\n    }\n    .teams-4 .team-logo {\n      width: 36px;\n      height: 36px;\n    }\n    .teams-4 .team-total {\n      font-size: 20px;\n    }\n    .teams-4 .slot-headshot {\n      width: 32px;\n      height: 32px;\n    }\n    .teams-4 .slot-name {\n      font-size: 22px;\n    }\n    .teams-4 .slot-score {\n      font-size: 26px;\n    }\n\n    /* Multi-team scaling: 5 teams - more compact */\n    .teams-5 .team-row {\n      min-height: 55px;\n    }\n    .teams-5 .team-fixed {\n      padding: 8px 12px;\n      min-width: 90px;\n    }\n    .teams-5 .team-logo {\n      width: 32px;\n      height: 32px;\n    }\n    .teams-5 .team-total {\n      font-size: 18px;\n      margin-top: 2px;\n    }\n    .teams-5 .slot-headshot {\n      width: 28px;\n      height: 28px;\n    }\n    .teams-5 .slot-name {\n      font-size: 20px;\n    }\n    .teams-5 .slot-score {\n      font-size: 24px;\n    }\n    .teams-5 .slot-apparatus {\n      font-size: 16px;\n    }\n    .teams-5 .team-slot {\n      padding: 8px 16px;\n    }\n\n    /* Multi-team scaling: 6 teams - most compact */\n    .teams-6 .team-row {\n      min-height: 50px;\n    }\n    .teams-6 .team-fixed {\n      padding: 6px 10px;\n      min-width: 85px;\n    }\n    .teams-6 .team-logo {\n      width: 28px;\n      height: 28px;\n    }\n    .teams-6 .team-total {\n      font-size: 16px;\n      margin-top: 2px;\n    }\n    .teams-6 .slot-headshot {\n      width: 24px;\n      height: 24px;\n    }\n    .teams-6 .slot-name {\n      font-size: 18px;\n    }\n    .teams-6 .slot-score {\n      font-size: 22px;\n    }\n    .teams-6 .slot-apparatus {\n      font-size: 14px;\n    }\n    .teams-6 .slot-sv {\n      font-size: 14px;\n    }\n    .teams-6 .team-slot {\n      padding: 6px 14px;\n    }\n    .teams-6 .rotation-tag {\n      font-size: 18px;\n      padding: 8px 16px;\n    }\n\n    /* Multi-team scaling: 7 teams - ultra compact */\n    .teams-7 .team-row {\n      min-height: 44px;\n    }\n    .teams-7 .team-fixed {\n      padding: 4px 8px;\n      min-width: 80px;\n    }\n    .teams-7 .team-logo {\n      width: 24px;\n      height: 24px;\n    }\n    .teams-7 .team-total {\n      font-size: 14px;\n      margin-top: 1px;\n    }\n    .teams-7 .slot-headshot {\n      width: 22px;\n      height: 22px;\n    }\n    .teams-7 .slot-name {\n      font-size: 16px;\n    }\n    .teams-7 .slot-score {\n      font-size: 20px;\n    }\n    .teams-7 .slot-apparatus {\n      font-size: 12px;\n    }\n    .teams-7 .slot-sv {\n      font-size: 12px;\n    }\n    .teams-7 .team-slot {\n      padding: 4px 12px;\n    }\n    .teams-7 .rotation-tag {\n      font-size: 16px;\n      padding: 6px 14px;\n    }\n\n    /* Fixed left section: logo + total */\n    .team-fixed {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 10px 15px;\n      min-width: 100px;\n      background: #000;\n    }\n\n    .team-logo {\n      width: 40px;\n      height: 40px;\n      object-fit: contain;\n    }\n\n    .team-total {\n      font-size: 22px;\n      font-weight: 900;\n      color: #fff;\n      margin-top: 4px;\n    }\n\n    .team-total.highlight {\n      animation: totalPulse 0.5s ease;\n    }\n\n    @keyframes totalPulse {\n      0%, 100% { transform: scale(1); color: #fff; }\n      50% { transform: scale(1.1); color: #22d3ee; }\n    }\n\n    /* Slot area for score flash / now competing */\n    .team-slot {\n      flex: 1;\n      display: flex;\n      align-items: center;\n      padding: 10px 20px;\n      overflow: hidden;\n      position: relative;\n    }\n\n    /* Slot content (animates up/down) */\n    .slot-content {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      transform: translateY(0);\n      transition: transform 0.4s ease, opacity 0.4s ease;\n      opacity: 0;\n    }\n\n    .slot-content.visible {\n      opacity: 1;\n    }\n\n    .slot-content.exit-up {\n      transform: translateY(-100%);\n      opacity: 0;\n    }\n\n    .slot-content.enter-from-below {\n      transform: translateY(100%);\n      opacity: 0;\n    }\n\n    /* Slot machine animation - new content spins up from below */\n    @keyframes slotSpinIn {\n      0% {\n        transform: translateY(100%);\n        opacity: 0;\n      }\n      20% {\n        opacity: 1;\n      }\n      100% {\n        transform: translateY(0);\n        opacity: 1;\n      }\n    }\n\n    /* Slot machine animation - old content spins up and out */\n    @keyframes slotSpinOut {\n      0% {\n        transform: translateY(0);\n        opacity: 1;\n      }\n      80% {\n        opacity: 0;\n      }\n      100% {\n        transform: translateY(-100%);\n        opacity: 0;\n      }\n    }\n\n    .slot-content.spin-in {\n      animation: slotSpinIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n    }\n\n    .slot-content.spin-out {\n      animation: slotSpinOut 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n    }\n\n    /* Headshot in slot */\n    .slot-headshot {\n      width: 36px;\n      height: 36px;\n      border-radius: 50%;\n      object-fit: cover;\n      flex-shrink: 0;\n    }\n\n    /* Athlete name in slot */\n    .slot-name {\n      font-size: 24px;\n      font-weight: 700;\n      color: #fff;\n      white-space: nowrap;\n    }\n\n    /* Score in slot */\n    .slot-score {\n      font-size: 28px;\n      font-weight: 900;\n      color: #fff;\n    }\n\n    /* Apparatus code */\n    .slot-apparatus {\n      font-size: 18px;\n      font-weight: 600;\n      color: #a1a1aa;\n      text-transform: uppercase;\n    }\n\n    /* Start value */\n    .slot-sv {\n      font-size: 16px;\n      font-weight: 400;\n      color: #71717a;\n    }\n\n    /* Stick indicator */\n    .slot-stick {\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      background: #22c55e;\n      color: #fff;\n      font-size: 14px;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    /* Separator dot */\n    .slot-separator {\n      color: #52525b;\n      font-size: 20px;\n    }\n\n    /* Correction indicator (score was changed) */\n    .slot-correction {\n      font-size: 14px;\n      font-weight: 500;\n      color: #f59e0b;\n      font-style: italic;\n    }\n\n    /* Stick indicator (bonus landing - men's only) */\n    .slot-stick {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      background: linear-gradient(135deg, #10b981 0%, #059669 100%);\n      color: white;\n      font-size: 12px;\n      font-weight: 700;\n      padding: 2px 8px;\n      border-radius: 4px;\n      margin-left: 8px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n      box-shadow: 0 2px 4px rgba(16, 185, 129, 0.3);\n    }\n\n    /* Lineup card (above bug) */\n    .lineup-card {\n      position: absolute;\n      bottom: 100%;\n      right: 0;\n      width: 100%;\n      background: #1a1a1a;\n      transform: translateY(100%);\n      opacity: 0;\n      transition: transform 0.4s ease, opacity 0.4s ease;\n      margin-bottom: 8px;\n    }\n\n    .lineup-card.visible {\n      transform: translateY(0);\n      opacity: 1;\n    }\n\n    .lineup-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 20px;\n      background: #27272a;\n    }\n\n    .lineup-team-name {\n      font-size: 22px;\n      font-weight: 800;\n      color: #fff;\n      text-transform: uppercase;\n    }\n\n    .lineup-logo {\n      width: 32px;\n      height: 32px;\n      object-fit: contain;\n    }\n\n    .lineup-athletes {\n      padding: 8px 0;\n    }\n\n    .lineup-athlete {\n      display: flex;\n      align-items: center;\n      padding: 8px 20px;\n      gap: 12px;\n    }\n\n    .lineup-order {\n      font-size: 16px;\n      font-weight: 600;\n      color: #71717a;\n      min-width: 24px;\n    }\n\n    .lineup-name {\n      flex: 1;\n      font-size: 20px;\n      font-weight: 600;\n      color: #fff;\n    }\n\n    .lineup-sv {\n      font-size: 16px;\n      font-weight: 400;\n      color: #71717a;\n      min-width: 40px;\n      text-align: right;\n    }\n\n    .lineup-score {\n      font-size: 22px;\n      font-weight: 700;\n      color: #fff;\n      min-width: 70px;\n      text-align: right;\n    }\n\n    .lineup-score.pending {\n      color: #52525b;\n    }\n\n    .lineup-footer {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 20px;\n      background: #27272a;\n    }\n\n    .lineup-event {\n      font-size: 18px;\n      font-weight: 600;\n      color: #a1a1aa;\n      text-transform: uppercase;\n    }\n\n    .lineup-total {\n      font-size: 26px;\n      font-weight: 800;\n      color: #fff;\n    }\n\n    /* Loading / error states */\n    .loading-state {\n      color: #71717a;\n      font-size: 18px;\n      padding: 20px;\n      text-align: center;\n    }\n\n    .error-state {\n      color: #ef4444;\n      font-size: 18px;\n      padding: 20px;\n      text-align: center;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"score-bug\" id=\"scoreBug\">\n    <div class=\"lineup-card\" id=\"lineupCard\">\n      <!-- Lineup card content populated dynamically -->\n    </div>\n    <div class=\"rotation-tag\" id=\"rotationTag\">Rotation 1 of 6</div>\n    <div class=\"team-rows\" id=\"teamRows\">\n      <!-- Team rows populated dynamically -->\n    </div>\n  </div>\n\n  <script>\n    // Firebase configuration\n    const firebaseConfig = {\n      apiKey: \"AIzaSyCh0aZUvKl6Qvqsva3hvOgJJlleP1OwcTY\",\n      authDomain: \"gymnastics-graphics.firebaseapp.com\",\n      databaseURL: \"https://gymnastics-graphics-default-rtdb.firebaseio.com\",\n      projectId: \"gymnastics-graphics\",\n      storageBucket: \"gymnastics-graphics.firebasestorage.app\",\n      messagingSenderId: \"702072609550\",\n      appId: \"1:702072609550:web:ac74a811186d3ff45b955f\"\n    };\n\n    // Initialize Firebase\n    firebase.initializeApp(firebaseConfig);\n    const db = firebase.database();\n\n    // Parse URL parameters\n    const params = new URLSearchParams(window.location.search);\n    const compId = params.get('compId');\n\n    if (!compId) {\n      console.error('Missing compId parameter');\n      document.body.innerHTML = '<div class=\"error-state\">Missing compId parameter</div>';\n    }\n\n    // State management\n    const state = {\n      enabled: false,\n      polling: false,\n      automationMode: 'auto',\n      showLineup: null,\n      teams: [],\n      rotation: { current: 1, total: 6, isFinal: false },\n      previousScores: {},        // { \"gymnast_id\": \"finalScore\" (string) }\n      previousTeamTotals: {},    // { \"teamKey\": \"finalScore\" (string) }\n      flashQueues: {},           // Per-team flash queues\n      activeFlashes: {},         // Currently active flashes per team\n      nowCompeting: [],          // Currently competing athletes per team (B1)\n      manualNowCompeting: {},    // Manual overrides from producer { teamIndex: true/false } (B4/B7)\n      pollInterval: 5000,\n      flashDuration: 10000,\n      stalePollCount: 0,         // Consecutive polls with no data changes\n      // Competition config (loaded from Firebase)\n      competitionConfig: null,\n      virtiusSessionId: null,\n      gender: 'mens',\n      // Error handling state (A3c)\n      consecutiveErrors: 0,      // Count of consecutive poll failures\n      lastError: null,           // Last error message\n      lastErrorTime: null,       // Timestamp of last error\n      maxBackoffMs: 60000,       // Max backoff delay (60 seconds)\n      // Offline/reconnect state (A3d)\n      firebaseConnected: true,   // Firebase connection state\n      pendingWrites: [],         // Writes queued during offline\n      reconnectAttempts: 0       // Count of reconnect attempts\n    };\n\n    // Headshot storage (E1)\n    let firebaseHeadshots = {};\n    let headshotsLoaded = false;\n\n    /**\n     * Normalize accented characters to ASCII equivalents (E1).\n     * Handles German/Swedish umlauts, French/Spanish/Portuguese accents, ligatures.\n     */\n    function normalizeAccentsUnified(str) {\n      if (!str) return '';\n      return str\n        // German/Swedish umlauts - convert to two-letter equivalents\n        .replace(/ö/g, 'oe').replace(/Ö/g, 'oe')\n        .replace(/ä/g, 'ae').replace(/Ä/g, 'ae')\n        .replace(/ü/g, 'ue').replace(/Ü/g, 'ue')\n        .replace(/ß/g, 'ss')\n        // French/Spanish/Portuguese accents - convert to base letter\n        .replace(/[éèêë]/g, 'e').replace(/[ÉÈÊË]/g, 'e')\n        .replace(/[áàâãå]/g, 'a').replace(/[ÁÀÂÃÅ]/g, 'a')\n        .replace(/[íìîï]/g, 'i').replace(/[ÍÌÎÏ]/g, 'i')\n        .replace(/[óòôõø]/g, 'o').replace(/[ÓÒÔÕØ]/g, 'o')\n        .replace(/[úùûü]/g, 'u').replace(/[ÚÙÛÜ]/g, 'u')\n        .replace(/ñ/g, 'n').replace(/Ñ/g, 'n')\n        .replace(/ç/g, 'c').replace(/Ç/g, 'c')\n        .replace(/ÿ/g, 'y').replace(/Ÿ/g, 'y')\n        // Ligatures\n        .replace(/æ/g, 'ae').replace(/Æ/g, 'ae')\n        .replace(/œ/g, 'oe').replace(/Œ/g, 'oe');\n    }\n\n    /**\n     * Remove common name suffixes (Jr., Sr., III, etc.) (E1).\n     */\n    function removeSuffixesUnified(name) {\n      if (!name) return '';\n      return name\n        .replace(/,?\\s*(jr\\.?|junior|sr\\.?|senior|[iv]+|[1-5](?:st|nd|rd|th))$/i, '')\n        .trim();\n    }\n\n    /**\n     * Unified name normalization (E1).\n     * Handles accents, suffixes, hyphens, apostrophes.\n     */\n    function normalizeNameUnified(name) {\n      if (!name) return '';\n      return normalizeAccentsUnified(removeSuffixesUnified(name))\n        .toLowerCase()\n        .replace(/[-_]/g, ' ')      // Hyphens and underscores to spaces\n        .replace(/[''`]/g, '')      // Remove apostrophes (curly and straight)\n        .replace(/\\s+/g, ' ')       // Collapse multiple spaces\n        .trim();\n    }\n\n    /**\n     * Load headshots from Firebase teamsDatabase (E1).\n     * Creates multiple lookup keys for each headshot to maximize matching.\n     */\n    function loadFirebaseHeadshots() {\n      db.ref('teamsDatabase/headshots').on('value', (snapshot) => {\n        const data = snapshot.val() || {};\n        firebaseHeadshots = {};\n\n        // Convert Firebase structure to simple name -> url map\n        // Store multiple keys for each headshot to maximize matching\n        for (const [key, value] of Object.entries(data)) {\n          if (value && value.url) {\n            // 1. Store by Firebase key (underscores → spaces)\n            const keyWithSpaces = key.toLowerCase().trim().replace(/_/g, ' ').replace(/\\s+/g, ' ');\n            firebaseHeadshots[keyWithSpaces] = value.url;\n\n            // 2. Store by fully normalized key (handles accents, hyphens, etc.)\n            const normalizedKey = normalizeNameUnified(key);\n            firebaseHeadshots[normalizedKey] = value.url;\n\n            // 3. Store by name field (original stored name)\n            if (value.name) {\n              const nameNormalized = normalizeNameUnified(value.name);\n              firebaseHeadshots[nameNormalized] = value.url;\n\n              // Also store just lowercased version (in case accents are already normalized)\n              const nameLower = value.name.toLowerCase().trim().replace(/\\s+/g, ' ');\n              firebaseHeadshots[nameLower] = value.url;\n            }\n\n            // 4. Store stripped version (only letters and spaces - handles unknown chars)\n            const strippedKey = normalizedKey.replace(/[^a-z\\s]/g, '').replace(/\\s+/g, ' ').trim();\n            if (strippedKey && strippedKey.length > 2) {\n              firebaseHeadshots[strippedKey] = value.url;\n            }\n\n            // 5. Handle 3+ part names - store variants for reverse lookup\n            // e.g., \"benjamin thurlow lam\" also stored as \"benjamin lam\", \"benjamin t lam\"\n            const parts = normalizedKey.split(' ').filter(Boolean);\n            if (parts.length >= 3) {\n              // First + Last only (skip middle name)\n              const firstLast = `${parts[0]} ${parts[parts.length - 1]}`;\n              firebaseHeadshots[firstLast] = value.url;\n\n              // First + Middle initial + Last\n              const firstInitialLast = `${parts[0]} ${parts[1][0]} ${parts[parts.length - 1]}`;\n              firebaseHeadshots[firstInitialLast] = value.url;\n\n              // For 4+ parts, first two + last\n              if (parts.length >= 4) {\n                const firstTwoLast = `${parts[0]} ${parts[1]} ${parts[parts.length - 1]}`;\n                firebaseHeadshots[firstTwoLast] = value.url;\n              }\n            }\n          }\n        }\n        headshotsLoaded = true;\n        console.log(`Loaded ${Object.keys(firebaseHeadshots).length} headshot entries from Firebase`);\n      });\n    }\n\n    /**\n     * Get athlete headshot URL (E1).\n     * Handles 3+ part names, accented characters, and various name formats.\n     * Falls back to API headshot if no Firebase match found.\n     */\n    function getAthleteHeadshot(firstName, lastName, apiHeadshot) {\n      if (!firstName && !lastName) return apiHeadshot || '';\n\n      // Build full name for lookup\n      const rawFullName = `${firstName || ''} ${lastName || ''}`.trim();\n      const normalized = normalizeNameUnified(rawFullName);\n      const stripped = normalized.replace(/[^a-z\\s]/g, '').replace(/\\s+/g, ' ').trim();\n\n      // Generate multiple lookup keys to maximize matching\n      const lookupKeys = [\n        // 1. Original lowercase (exact match)\n        rawFullName.toLowerCase().replace(/\\s+/g, ' ').trim(),\n        // 2. Fully normalized (unified normalization)\n        normalized,\n        // 3. Stripped (only letters and spaces)\n        stripped,\n      ];\n\n      // 4. Handle 3+ part names (e.g., \"Benjamin Thurlow Lam\")\n      const parts = normalized.split(' ').filter(Boolean);\n      if (parts.length >= 3) {\n        // First + Last only (skip middle name)\n        lookupKeys.push(`${parts[0]} ${parts[parts.length - 1]}`);\n        // First + Middle initial + Last\n        lookupKeys.push(`${parts[0]} ${parts[1][0]} ${parts[parts.length - 1]}`);\n        // For 4+ parts, try first two + last\n        if (parts.length >= 4) {\n          lookupKeys.push(`${parts[0]} ${parts[1]} ${parts[parts.length - 1]}`);\n        }\n      }\n\n      // 5. Handle case where firstName contains multiple parts\n      const firstParts = (firstName || '').trim().split(/\\s+/).filter(Boolean);\n      if (firstParts.length >= 2 && lastName) {\n        // Just first part of firstName + lastName\n        lookupKeys.push(`${normalizeNameUnified(firstParts[0])} ${normalizeNameUnified(lastName)}`);\n        // First part + initial + lastName\n        lookupKeys.push(`${normalizeNameUnified(firstParts[0])} ${firstParts[1][0].toLowerCase()} ${normalizeNameUnified(lastName)}`);\n      }\n\n      // Remove duplicates and empty strings\n      const uniqueKeys = [...new Set(lookupKeys.filter(Boolean))];\n\n      // Try each key against Firebase headshots\n      for (const key of uniqueKeys) {\n        if (firebaseHeadshots[key]) {\n          return firebaseHeadshots[key];\n        }\n      }\n\n      // Fall back to API headshot\n      return apiHeadshot || '';\n    }\n\n    // Initialize headshot loading\n    loadFirebaseHeadshots();\n\n    /**\n     * Handle headshot load error by replacing with initials placeholder (E5).\n     * Called via onerror=\"handleHeadshotError(this, 'First', 'Last')\"\n     * @param {HTMLImageElement} img - The image element that failed\n     * @param {string} firstName - Athlete first name\n     * @param {string} lastName - Athlete last name\n     */\n    function handleHeadshotError(img, firstName, lastName) {\n      // Hide the broken image\n      img.style.display = 'none';\n\n      // Build initials (first letter of first name + first letter of last name)\n      const firstInitial = (firstName || '').charAt(0).toUpperCase();\n      const lastInitial = (lastName || '').charAt(0).toUpperCase();\n      const initials = `${firstInitial}${lastInitial}` || '?';\n\n      // Create placeholder div with initials\n      const placeholder = document.createElement('div');\n      placeholder.className = 'slot-headshot-fallback';\n      placeholder.textContent = initials;\n      placeholder.style.cssText = `\n        width: 36px;\n        height: 36px;\n        border-radius: 50%;\n        background: linear-gradient(135deg, #374151 0%, #1f2937 100%);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        font-size: 14px;\n        font-weight: 700;\n        color: #9ca3af;\n        flex-shrink: 0;\n      `;\n\n      // Insert before the hidden image\n      img.parentNode.insertBefore(placeholder, img);\n    }\n\n    // Firebase paths\n    const scoreBugRef = db.ref(`competitions/${compId}/scoreBug`);\n    const configRef = db.ref(`competitions/${compId}/config`);\n    const connectedRef = db.ref('.info/connected');\n\n    /**\n     * Initialize Firebase connection monitoring (A3d).\n     * Detects offline/online state and handles reconnection.\n     */\n    function initConnectionMonitor() {\n      connectedRef.on('value', (snapshot) => {\n        const connected = snapshot.val() === true;\n        const wasConnected = state.firebaseConnected;\n        state.firebaseConnected = connected;\n\n        if (connected && !wasConnected) {\n          // Just reconnected\n          console.log('Firebase connected - processing pending writes');\n          state.reconnectAttempts = 0;\n          processPendingWrites();\n\n          // Write reconnect event to Firebase\n          scoreBugRef.child('connectionStatus').set({\n            connected: true,\n            reconnectedAt: Date.now(),\n            pendingWritesProcessed: state.pendingWrites.length\n          });\n        } else if (!connected && wasConnected) {\n          // Just went offline\n          console.warn('Firebase disconnected - writes will be queued');\n          state.reconnectAttempts++;\n\n          // Note: Firebase SDK has offline persistence by default\n          // Writes are automatically queued and synced on reconnect\n        }\n\n        console.log('Firebase connection state:', connected ? 'ONLINE' : 'OFFLINE');\n      });\n    }\n\n    /**\n     * Process any pending writes that were queued during offline.\n     * Firebase SDK handles this automatically, but we log for visibility.\n     */\n    function processPendingWrites() {\n      if (state.pendingWrites.length === 0) return;\n\n      console.log('Processing', state.pendingWrites.length, 'pending writes');\n\n      // Firebase SDK automatically syncs queued writes\n      // Clear our tracking array\n      state.pendingWrites = [];\n    }\n\n    /**\n     * Safe write to Firebase with offline queueing (A3d).\n     * Wraps Firebase write operations to track pending writes during offline.\n     * @param {firebase.database.Reference} ref - Firebase reference\n     * @param {string} method - 'set', 'update', or 'remove'\n     * @param {*} data - Data to write (for set/update)\n     * @returns {Promise}\n     */\n    async function safeWrite(ref, method, data) {\n      const writeOp = { path: ref.toString(), method, data, timestamp: Date.now() };\n\n      if (!state.firebaseConnected) {\n        // Queue the write for tracking (Firebase SDK queues automatically)\n        state.pendingWrites.push(writeOp);\n        console.log('Queued offline write:', writeOp.path, method);\n      }\n\n      try {\n        if (method === 'set') {\n          await ref.set(data);\n        } else if (method === 'update') {\n          await ref.update(data);\n        } else if (method === 'remove') {\n          await ref.remove();\n        }\n        return true;\n      } catch (err) {\n        // Firebase SDK will retry on reconnect\n        console.error('Write failed (will retry on reconnect):', err.message);\n        if (!state.pendingWrites.includes(writeOp)) {\n          state.pendingWrites.push(writeOp);\n        }\n        return false;\n      }\n    }\n\n    /**\n     * Load competition config from Firebase.\n     * Gets virtiusSessionId, team names/logos, gender, and compType.\n     * Must be called before initializing Firebase listeners.\n     */\n    async function loadCompetitionConfig() {\n      try {\n        const snapshot = await configRef.once('value');\n        const config = snapshot.val();\n\n        if (!config) {\n          console.error('No competition config found for compId:', compId);\n          document.body.innerHTML = '<div class=\"error-state\">Competition not found</div>';\n          return false;\n        }\n\n        state.competitionConfig = config;\n        state.virtiusSessionId = config.virtiusSessionId || null;\n        state.gender = config.gender || 'mens';\n\n        // Build teams array from config (up to 7 teams)\n        state.teams = [];\n        for (let i = 1; i <= 7; i++) {\n          const teamName = config[`team${i}Name`];\n          if (teamName) {\n            state.teams.push({\n              index: i,\n              name: teamName,\n              logo: config[`team${i}Logo`] || '',\n              tricode: config[`team${i}Tricode`] || '',\n              total: '--'  // Initial state before first API poll\n            });\n          }\n        }\n\n        // Determine total rotations based on gender and team count\n        // For women's: normally 4, but more if team count exceeds apparatus count\n        // For men's: normally 6, but more if team count exceeds apparatus count\n        const eventCount = state.gender === 'womens' ? 4 : 6;\n        state.rotation.total = Math.max(eventCount, state.teams.length);\n\n        console.log('Competition config loaded:', {\n          compId,\n          virtiusSessionId: state.virtiusSessionId,\n          gender: state.gender,\n          teamCount: state.teams.length,\n          teams: state.teams.map(t => t.name)\n        });\n\n        // Check if Virtius session ID is configured\n        if (!state.virtiusSessionId) {\n          console.warn('No Virtius session ID configured - API polling will not work');\n        }\n\n        return true;\n      } catch (err) {\n        console.error('Failed to load competition config:', err);\n        document.body.innerHTML = '<div class=\"error-state\">Failed to load competition config</div>';\n        return false;\n      }\n    }\n\n    /**\n     * Render initial team rows based on competition config.\n     * Called after loadCompetitionConfig() to show teams before API polling starts.\n     * Adds team-count class for responsive scaling (G1/G2/G3).\n     */\n    function renderTeamRows() {\n      const container = document.getElementById('teamRows');\n      if (!container) return;\n\n      // Add team count class to score-bug for responsive scaling\n      const scoreBug = document.getElementById('scoreBug');\n      if (scoreBug) {\n        // Remove any existing team count classes\n        scoreBug.classList.remove('teams-2', 'teams-3', 'teams-4', 'teams-5', 'teams-6', 'teams-7');\n        // Add class based on team count\n        const teamCount = state.teams.length;\n        if (teamCount >= 2 && teamCount <= 7) {\n          scoreBug.classList.add(`teams-${teamCount}`);\n        }\n      }\n\n      container.innerHTML = state.teams.map((team, idx) => `\n        <div class=\"team-row\" data-team-index=\"${team.index}\">\n          <div class=\"team-fixed\">\n            <img class=\"team-logo\" src=\"${team.logo}\" alt=\"${team.name}\" onerror=\"this.style.display='none'\">\n            <div class=\"team-total\" id=\"teamTotal${team.index}\">${team.total}</div>\n          </div>\n          <div class=\"team-slot\" id=\"teamSlot${team.index}\">\n            <div class=\"slot-content\" id=\"slotContent${team.index}\">\n              <!-- Score flash / now competing content populated dynamically -->\n            </div>\n          </div>\n        </div>\n      `).join('');\n\n      console.log('Team rows rendered:', state.teams.length, 'teams');\n    }\n\n    /**\n     * Update team total display element (A4).\n     * Called when API polling detects a change in team.final_score.\n     * Adds highlight animation on value change.\n     * @param {number} teamIndex - 1-based team index\n     * @param {string} newTotal - Formatted score string (e.g., \"196.450\")\n     */\n    function updateTeamTotal(teamIndex, newTotal) {\n      const totalEl = document.getElementById(`teamTotal${teamIndex}`);\n      if (!totalEl) return;\n\n      const prevTotal = totalEl.textContent;\n\n      // Only update if value changed\n      if (prevTotal === newTotal) return;\n\n      totalEl.textContent = newTotal;\n\n      // Trigger highlight animation on change (skip for initial load)\n      if (prevTotal !== '--') {\n        totalEl.classList.remove('highlight');\n        // Force reflow to restart animation\n        void totalEl.offsetWidth;\n        totalEl.classList.add('highlight');\n      }\n    }\n\n    /**\n     * Update all team totals from state (A4).\n     * Called after API poll updates state.teams[].total values.\n     */\n    function updateAllTeamTotals() {\n      state.teams.forEach((team) => {\n        updateTeamTotal(team.index, team.total);\n      });\n    }\n\n    // Initialize Firebase listeners\n    function initFirebaseListeners() {\n      // Listen for enabled state\n      scoreBugRef.child('enabled').on('value', (snapshot) => {\n        state.enabled = snapshot.val() === true;\n        updateBugVisibility();\n      });\n\n      // Listen for polling state\n      scoreBugRef.child('polling').on('value', (snapshot) => {\n        const wasPolling = state.polling;\n        state.polling = snapshot.val() === true;\n        if (state.polling && !wasPolling) {\n          startPolling();\n        } else if (!state.polling && wasPolling) {\n          stopPolling();\n        }\n      });\n\n      // Listen for automation mode changes\n      scoreBugRef.child('automationMode').on('value', (snapshot) => {\n        const newMode = snapshot.val() || 'auto';\n        const modeChanged = state.automationMode !== newMode;\n        state.automationMode = newMode;\n\n        // When mode changes, update now-competing display accordingly\n        if (modeChanged) {\n          console.log('Automation mode changed to:', newMode);\n          updateAllNowCompeting();\n        }\n      });\n\n      // Listen for manual now-competing overrides (B7)\n      // Producer can show/hide now-competing per team in manual mode\n      scoreBugRef.child('nowCompeting').on('value', (snapshot) => {\n        const overrides = snapshot.val() || {};\n        state.manualNowCompeting = {};\n\n        // Convert team keys to indices: { \"team1\": true } → { 1: true }\n        Object.entries(overrides).forEach(([teamKey, value]) => {\n          // teamKey is \"team1\", \"team2\", etc.\n          const match = teamKey.match(/team(\\d+)/);\n          if (match) {\n            const teamIndex = parseInt(match[1], 10);\n            state.manualNowCompeting[teamIndex] = value;\n          }\n        });\n\n        console.log('Manual now-competing overrides updated:', state.manualNowCompeting);\n        updateAllNowCompeting();\n      });\n\n      // Listen for lineup card toggle\n      scoreBugRef.child('showLineup').on('value', (snapshot) => {\n        state.showLineup = snapshot.val();\n        updateLineupCard();\n      });\n\n      // Listen for flash dismissals\n      scoreBugRef.child('dismissFlash').on('value', (snapshot) => {\n        const dismissals = snapshot.val() || {};\n        handleFlashDismissals(dismissals);\n      });\n\n      // Listen for poll interval changes - restart polling with new interval\n      scoreBugRef.child('config/pollInterval').on('value', (snapshot) => {\n        const newInterval = snapshot.val() || 5000;\n        const wasPolling = state.polling && pollTimer !== null;\n        state.pollInterval = newInterval;\n\n        // Restart polling with new interval if currently polling\n        if (wasPolling) {\n          console.log('Poll interval changed to', newInterval, 'ms - restarting polling');\n          stopPolling();\n          startPolling();\n        }\n      });\n\n      // Listen for flash duration changes\n      scoreBugRef.child('config/flashDuration').on('value', (snapshot) => {\n        state.flashDuration = snapshot.val() || 10000;\n      });\n\n      console.log('Firebase listeners initialized');\n    }\n\n    // Update bug visibility based on enabled state\n    function updateBugVisibility() {\n      const bugEl = document.getElementById('scoreBug');\n      if (state.enabled) {\n        bugEl.classList.add('visible');\n      } else {\n        bugEl.classList.remove('visible');\n      }\n    }\n\n    // Update lineup card visibility\n    function updateLineupCard() {\n      const cardEl = document.getElementById('lineupCard');\n      if (!state.showLineup) {\n        cardEl.classList.remove('visible');\n        return;\n      }\n\n      // Find the team matching state.showLineup (teamKey like \"navy-mens\")\n      const apiTeams = state.lastApiTeams || [];\n      const teamData = apiTeams.find(t => {\n        const teamKey = t.short_name || `team${apiTeams.indexOf(t) + 1}`;\n        return teamKey === state.showLineup;\n      });\n\n      if (!teamData) {\n        console.warn('Lineup card: team not found for key:', state.showLineup);\n        cardEl.classList.remove('visible');\n        return;\n      }\n\n      // Find the config team to get logo and display name\n      const configTeamIndex = apiTeams.indexOf(teamData);\n      const configTeam = state.teams[configTeamIndex] || {};\n\n      // Find the current event (in progress or most recent)\n      const currentEvent = findCurrentEventForLineup(teamData);\n      if (!currentEvent) {\n        console.warn('Lineup card: no current event found');\n        cardEl.classList.remove('visible');\n        return;\n      }\n\n      // Populate the lineup card content\n      cardEl.innerHTML = renderLineupCardContent(teamData, configTeam, currentEvent);\n      cardEl.classList.add('visible');\n    }\n\n    /**\n     * Find the current event for lineup card display.\n     * Prioritizes: (1) event in progress, (2) last completed event, (3) first event.\n     * @param {Object} teamData - Team data from Virtius API\n     * @returns {Object|null} Event object or null\n     */\n    function findCurrentEventForLineup(teamData) {\n      if (!teamData || !teamData.events) return null;\n\n      const events = teamData.events;\n      if (events.length === 0) return null;\n\n      // Look for event in progress (some scores, but not all)\n      for (const event of events) {\n        const gymnasts = event.gymnasts || [];\n        if (gymnasts.length === 0) continue;\n\n        const scored = gymnasts.filter(g => g.final_score != null);\n        const unscored = gymnasts.filter(g => g.final_score == null);\n\n        // Event in progress: has some scores but not complete\n        if (scored.length > 0 && unscored.length > 0) {\n          return event;\n        }\n      }\n\n      // No event in progress - find the last event with scores\n      for (let i = events.length - 1; i >= 0; i--) {\n        const event = events[i];\n        const gymnasts = event.gymnasts || [];\n        const scored = gymnasts.filter(g => g.final_score != null);\n        if (scored.length > 0) {\n          return event;\n        }\n      }\n\n      // No events have scores yet - return first event\n      return events[0];\n    }\n\n    /**\n     * Render lineup card HTML content.\n     * @param {Object} teamData - Team data from Virtius API\n     * @param {Object} configTeam - Team config with logo/name\n     * @param {Object} event - Current event to display\n     * @returns {string} HTML content\n     */\n    function renderLineupCardContent(teamData, configTeam, event) {\n      const teamName = configTeam.name || teamData.name || 'Team';\n      const teamLogo = configTeam.logo || '';\n      const eventName = getEventShortCode(event.event_name || event.name || '');\n      const eventTotal = formatScore(event.event_score);\n\n      // Sort gymnasts by lineup order\n      const gymnasts = [...(event.gymnasts || [])].sort((a, b) => (a.order || 0) - (b.order || 0));\n\n      // Build athlete rows\n      const athleteRows = gymnasts.map((g, idx) => {\n        const order = g.order || (idx + 1);\n        const name = g.full_name || 'Unknown';\n        // Get start value from scores array if available\n        const startValue = (g.scores && g.scores[0] && g.scores[0].start)\n          ? parseFloat(g.scores[0].start).toFixed(1)\n          : '';\n        const score = g.final_score != null ? formatScore(g.final_score) : '--';\n        const pendingClass = g.final_score == null ? 'pending' : '';\n\n        return `\n          <div class=\"lineup-athlete\">\n            <span class=\"lineup-order\">${order}.</span>\n            <span class=\"lineup-name\">${name}</span>\n            <span class=\"lineup-sv\">${startValue}</span>\n            <span class=\"lineup-score ${pendingClass}\">${score}</span>\n          </div>\n        `;\n      }).join('');\n\n      return `\n        <div class=\"lineup-header\">\n          <span class=\"lineup-team-name\">${teamName}</span>\n          <img class=\"lineup-logo\" src=\"${teamLogo}\" alt=\"\" onerror=\"this.style.display='none'\">\n        </div>\n        <div class=\"lineup-athletes\">\n          ${athleteRows}\n        </div>\n        <div class=\"lineup-footer\">\n          <span class=\"lineup-event\">${eventName}</span>\n          <span class=\"lineup-total\">${eventTotal}</span>\n        </div>\n      `;\n    }\n\n    /**\n     * Format score for display (3 decimal places).\n     * @param {string|number|null} score - Score value\n     * @returns {string} Formatted score or \"--\"\n     */\n    function formatScore(score) {\n      if (score == null || score === '') return '--';\n      const num = parseFloat(score);\n      if (isNaN(num)) return '--';\n      return num.toFixed(3);\n    }\n\n    /**\n     * Handle flash dismissals from producer panel (Task A12c).\n     * When producer clicks \"dismiss\" for a team, immediately clears\n     * the active flash and advances to next in queue.\n     * @param {Object} dismissals - Map of teamIndex -> timestamp\n     */\n    function handleFlashDismissals(dismissals) {\n      if (!dismissals || typeof dismissals !== 'object') return;\n\n      Object.keys(dismissals).forEach((teamIndexStr) => {\n        const teamIndex = parseInt(teamIndexStr, 10);\n        const dismissTimestamp = dismissals[teamIndex];\n\n        // Skip if no active flash for this team\n        if (!state.activeFlashes[teamIndex]) return;\n\n        // Skip if already processed this dismissal (compare timestamps)\n        const activeFlash = state.activeFlashes[teamIndex];\n        if (activeFlash.dismissedAt === dismissTimestamp) return;\n\n        console.log('Processing flash dismissal:', {\n          team: teamIndex,\n          gymnast: activeFlash.name,\n          dismissTimestamp\n        });\n\n        // Mark as processed\n        activeFlash.dismissedAt = dismissTimestamp;\n\n        // Clear the timer for current flash\n        if (activeFlash.timer) {\n          clearTimeout(activeFlash.timer);\n        }\n\n        // Advance to next flash (or clear if queue empty)\n        advanceFlashQueue(teamIndex);\n\n        // Clear the dismissal flag in Firebase after processing\n        scoreBugRef.child(`dismissFlash/${teamIndex}`).remove();\n      });\n    }\n\n    // Polling management\n    let pollTimer = null;\n\n    function startPolling() {\n      if (pollTimer) return;\n      console.log('Starting API polling');\n      poll();  // Initial poll\n      pollTimer = setInterval(poll, state.pollInterval);\n    }\n\n    function stopPolling() {\n      if (pollTimer) {\n        clearInterval(pollTimer);\n        pollTimer = null;\n        console.log('Stopped API polling');\n      }\n    }\n\n    // Main poll function - fetches data from Virtius API\n    async function poll() {\n      // Check if we have a valid session ID\n      if (!state.virtiusSessionId) {\n        console.warn('No Virtius session ID - skipping poll');\n        return;\n      }\n\n      const pollStartTime = Date.now();\n\n      try {\n        // Fetch from Virtius API\n        const response = await fetch(`https://api.virti.us/session/${state.virtiusSessionId}/json`);\n\n        if (!response.ok) {\n          throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n        }\n\n        const data = await response.json();\n\n        // Store raw API data for score diff engine (Task A5)\n        // Extract teams array from meet data\n        const teams = data.meet?.teams || [];\n\n        if (teams.length === 0) {\n          console.warn('No teams found in API response');\n        }\n\n        // Store the latest API data in state\n        state.lastApiData = data;\n        state.lastApiTeams = teams;\n\n        // Extract team totals and update state.teams with actual data\n        // final_score comes as a string from API - convert to float for display\n        teams.forEach((apiTeam, idx) => {\n          // Match API team to our configured teams by index or name\n          const stateTeam = state.teams[idx];\n          if (stateTeam) {\n            // Convert string final_score to formatted number\n            const rawScore = apiTeam.final_score;\n            if (rawScore !== null && rawScore !== undefined) {\n              const numScore = parseFloat(rawScore);\n              stateTeam.total = isNaN(numScore) ? '--' : numScore.toFixed(3);\n            }\n            // Store API team reference for score diff engine\n            stateTeam.apiTeam = apiTeam;\n          }\n        });\n\n        // Write heartbeat to Firebase on successful poll (using safeWrite for offline resilience)\n        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n\n        console.log('Poll successful:', {\n          sessionId: state.virtiusSessionId,\n          teamCount: teams.length,\n          teams: state.teams.map(t => ({ name: t.name, total: t.total }))\n        });\n\n        // Process API data - detect changes and write deltas to Firebase\n        await processApiData(teams, pollStartTime);\n\n        // Update team total displays (A4)\n        updateAllTeamTotals();\n\n      } catch (err) {\n        // Error handling with exponential backoff (A3c)\n        state.consecutiveErrors++;\n        state.lastError = err.message;\n        state.lastErrorTime = pollStartTime;\n\n        // Calculate backoff delay: 5s, 10s, 20s, 40s, 60s (max)\n        const backoffDelay = Math.min(\n          state.pollInterval * Math.pow(2, state.consecutiveErrors - 1),\n          state.maxBackoffMs\n        );\n\n        console.error('Poll failed:', {\n          error: err.message,\n          consecutiveErrors: state.consecutiveErrors,\n          nextRetryIn: `${backoffDelay / 1000}s`\n        });\n\n        // Write error state to Firebase for producer panel visibility (D5b)\n        // Using safeWrite for offline resilience\n        await safeWrite(scoreBugRef.child('apiError'), 'set', {\n          message: err.message,\n          consecutiveErrors: state.consecutiveErrors,\n          timestamp: pollStartTime,\n          nextRetryMs: backoffDelay\n        });\n        // Still write heartbeat to indicate overlay is running\n        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n\n        // Schedule next poll with backoff delay if we're still supposed to be polling\n        if (state.polling && pollTimer) {\n          clearInterval(pollTimer);\n          pollTimer = setTimeout(() => {\n            if (state.polling) {\n              poll();\n              // If poll succeeds, startPolling() will be called to restore normal interval\n            }\n          }, backoffDelay);\n        }\n        return; // Skip normal completion\n      }\n\n      // Success - reset error state\n      if (state.consecutiveErrors > 0) {\n        console.log('Poll recovered after', state.consecutiveErrors, 'consecutive errors');\n        state.consecutiveErrors = 0;\n        state.lastError = null;\n        state.lastErrorTime = null;\n\n        // Clear error state in Firebase\n        await safeWrite(scoreBugRef.child('apiError'), 'remove');\n\n        // Restore normal polling interval (we might be on backoff timeout)\n        if (state.polling && pollTimer) {\n          clearTimeout(pollTimer);\n          clearInterval(pollTimer);\n          pollTimer = setInterval(poll, state.pollInterval);\n        }\n      }\n    }\n\n    /**\n     * Process API data - detect score changes and write incremental deltas to Firebase.\n     * Only writes changed paths, not full data rewrite.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @param {number} pollTimestamp - Timestamp of this poll\n     */\n    async function processApiData(apiTeams, pollTimestamp) {\n      const changedPaths = {};\n      let hasChanges = false;\n\n      // Process each team\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n\n        // Check if team total changed\n        const prevTeamTotal = state.previousTeamTotals[teamKey];\n        const currTeamTotal = team.final_score;  // string or null\n\n        if (currTeamTotal !== prevTeamTotal) {\n          changedPaths[`teams/${teamKey}/finalScore`] = currTeamTotal;\n          changedPaths[`teams/${teamKey}/name`] = team.name || teamKey;\n          hasChanges = true;\n        }\n\n        // Process each event's gymnasts for score changes\n        const events = team.events || [];\n        events.forEach((event) => {\n          const eventKey = event.short_name || event.name || 'unknown';\n          const gymnasts = event.gymnasts || [];\n\n          gymnasts.forEach((gymnast) => {\n            // Primary key: gymnast_id. Fallback: teamKey|normalizedName\n            const gymnastKey = gymnast.gymnast_id ||\n              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n\n            const prevScore = state.previousScores[gymnastKey];\n            const currScore = gymnast.final_score;  // string or null\n\n            // Score changed (new score OR corrected score)\n            if (currScore != null && prevScore !== currScore) {\n              // Build gymnast data for Firebase and flash queue\n              // Stick bonus is indicated by bonus > 0 in the API (men's gymnastics only)\n              const bonusValue = parseFloat(gymnast.bonus) || 0;\n              const hasStick = bonusValue > 0;\n\n              const gymnastData = {\n                name: gymnast.full_name,\n                firstName: gymnast.first_name || '',\n                lastName: gymnast.last_name || '',\n                apiHeadshot: gymnast.headshot || '',\n                score: currScore,\n                startValue: gymnast.start_value || null,\n                execution: gymnast.execution || null,\n                difficulty: gymnast.difficulty || null,\n                bonus: bonusValue,\n                hasStick: hasStick,\n                order: gymnast.order,\n                event: eventKey,\n                team: teamKey,\n                gymnastKey: gymnastKey,\n                timestamp: pollTimestamp,\n                isCorrection: prevScore != null  // True if score was changed (not new)\n              };\n\n              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}`] = gymnastData;\n              hasChanges = true;\n\n              console.log('Score change detected:', {\n                gymnast: gymnast.full_name,\n                event: eventKey,\n                team: teamKey,\n                prev: prevScore,\n                curr: currScore,\n                isCorrection: prevScore != null\n              });\n\n              // Trigger flash for this score change (A5)\n              const teamIndex = teamIdx + 1;  // Convert 0-based to 1-based index\n              if (isFlashActive(teamIndex, gymnastKey)) {\n                // Correction during active flash - interrupt and replace\n                interruptFlash(teamIndex, gymnastData);\n              } else {\n                // Queue new flash for this team\n                triggerScoreFlash(teamIndex, gymnastData);\n              }\n            }\n\n            // Score removed (rare - inquiry pending)\n            if (currScore == null && prevScore != null) {\n              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}/score`] = null;\n              hasChanges = true;\n              console.log('Score removed:', { gymnast: gymnast.full_name, event: eventKey });\n            }\n          });\n        });\n      });\n\n      // Write to Firebase (using safeWrite for offline resilience)\n      if (hasChanges) {\n        // Write changed paths and reset stale counter\n        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n          ...changedPaths,\n          lastDataChangeTimestamp: pollTimestamp,\n          stalePollCount: 0\n        });\n        state.stalePollCount = 0;\n\n        console.log('Wrote incremental deltas to Firebase:', Object.keys(changedPaths).length, 'paths');\n      } else {\n        // No changes - increment stale counter\n        state.stalePollCount++;\n        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n          lastPollTimestamp: pollTimestamp,\n          stalePollCount: state.stalePollCount\n        });\n      }\n\n      // Update previous state for next comparison\n      state.previousScores = buildScoreMap(apiTeams);\n      state.previousTeamTotals = buildTeamTotalMap(apiTeams);\n\n      // Detect and update rotation (A10)\n      const newRotation = detectRotation(apiTeams);\n      if (newRotation.current !== state.rotation.current ||\n          newRotation.isFinal !== state.rotation.isFinal) {\n        state.rotation = newRotation;\n        updateRotationTag();\n\n        // Write rotation to Firebase for producer panel visibility\n        await safeWrite(scoreBugRef.child('liveData/rotation'), 'set', newRotation.current);\n        await safeWrite(scoreBugRef.child('liveData/totalRotations'), 'set', newRotation.total);\n        await safeWrite(scoreBugRef.child('liveData/isFinal'), 'set', newRotation.isFinal);\n\n        console.log('Rotation updated:', newRotation);\n      }\n\n      // Detect now-competing athletes (B1)\n      const nowCompeting = detectAllNowCompeting(apiTeams);\n      const prevNowCompeting = state.nowCompeting || [];\n\n      // Check if now-competing has changed\n      const nowCompetingChanged = JSON.stringify(nowCompeting) !== JSON.stringify(prevNowCompeting);\n\n      if (nowCompetingChanged) {\n        state.nowCompeting = nowCompeting;\n\n        // Write detected state to Firebase for producer panel visibility\n        await safeWrite(scoreBugRef.child('detected/nowCompeting'), 'set', nowCompeting);\n\n        console.log('Now competing updated:', nowCompeting);\n\n        // Update now-competing slot displays (B2)\n        updateAllNowCompeting();\n      }\n\n      // Write detected teams list for lineup card controls (D7)\n      const detectedTeams = apiTeams.map((team, idx) => ({\n        teamIndex: idx,\n        teamKey: team.short_name || `team${idx + 1}`,\n        teamName: team.name,\n        tricode: team.tricode\n      }));\n      const prevDetectedTeams = state.detectedTeams || [];\n      if (JSON.stringify(detectedTeams) !== JSON.stringify(prevDetectedTeams)) {\n        state.detectedTeams = detectedTeams;\n        await safeWrite(scoreBugRef.child('detected/teams'), 'set', detectedTeams);\n      }\n\n      // Update lineup card if visible (C5 - live update with new scores)\n      if (state.showLineup) {\n        updateLineupCard();\n      }\n    }\n\n    /**\n     * Build score map from API teams data.\n     * @returns {Object} Map of gymnastKey -> finalScore (string)\n     */\n    function buildScoreMap(apiTeams) {\n      const map = {};\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n        const events = team.events || [];\n\n        events.forEach((event) => {\n          const gymnasts = event.gymnasts || [];\n          gymnasts.forEach((gymnast) => {\n            const gymnastKey = gymnast.gymnast_id ||\n              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n            map[gymnastKey] = gymnast.final_score;  // string or null\n          });\n        });\n      });\n      return map;\n    }\n\n    /**\n     * Build team total map from API teams data.\n     * @returns {Object} Map of teamKey -> finalScore (string)\n     */\n    function buildTeamTotalMap(apiTeams) {\n      const map = {};\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n        map[teamKey] = team.final_score;  // string or null\n      });\n      return map;\n    }\n\n    // ============================================================\n    // SCORE DIFF ENGINE - Flash Queue Management (Task A5)\n    // ============================================================\n\n    /**\n     * Check if a flash is currently active for a given team and gymnast.\n     * Used to detect score corrections during active flash display.\n     * @param {number} teamIndex - 1-based team index\n     * @param {string} gymnastKey - Unique gymnast identifier\n     * @returns {boolean} True if flash is active for this gymnast\n     */\n    function isFlashActive(teamIndex, gymnastKey) {\n      const activeFlash = state.activeFlashes[teamIndex];\n      return activeFlash && activeFlash.gymnastKey === gymnastKey;\n    }\n\n    /**\n     * Interrupt current flash with a new one (score correction case).\n     * Immediately replaces the active flash and resets timer.\n     * @param {number} teamIndex - 1-based team index\n     * @param {Object} gymnastData - New score data to display\n     */\n    function interruptFlash(teamIndex, gymnastData) {\n      console.log('Interrupting active flash with correction:', {\n        team: teamIndex,\n        gymnast: gymnastData.name,\n        newScore: gymnastData.score\n      });\n\n      // Clear existing flash timer\n      if (state.activeFlashes[teamIndex]?.timer) {\n        clearTimeout(state.activeFlashes[teamIndex].timer);\n      }\n\n      // Replace with new flash data\n      state.activeFlashes[teamIndex] = {\n        ...gymnastData,\n        startTime: Date.now(),\n        timer: null\n      };\n\n      // Render the updated flash immediately\n      renderFlash(teamIndex, gymnastData);\n\n      // Set new timer\n      state.activeFlashes[teamIndex].timer = setTimeout(() => {\n        advanceFlashQueue(teamIndex);\n      }, state.flashDuration);\n    }\n\n    /**\n     * Queue a new score flash for a team.\n     * If no flash is active, displays immediately. Otherwise queued.\n     * @param {number} teamIndex - 1-based team index\n     * @param {Object} gymnastData - Score data to display\n     */\n    function triggerScoreFlash(teamIndex, gymnastData) {\n      // Initialize queue if needed\n      if (!state.flashQueues[teamIndex]) {\n        state.flashQueues[teamIndex] = [];\n      }\n\n      const queue = state.flashQueues[teamIndex];\n\n      // Edge case: Check if this gymnast is already in the queue (correction before display)\n      const existingIndex = queue.findIndex(item => item.gymnastKey === gymnastData.gymnastKey);\n      if (existingIndex !== -1) {\n        // Update existing queue entry with corrected score (A13: corrections in queue)\n        console.log('Updating queued flash with correction:', {\n          team: teamIndex,\n          gymnast: gymnastData.name,\n          oldScore: queue[existingIndex].score,\n          newScore: gymnastData.score\n        });\n        queue[existingIndex] = { ...gymnastData, isCorrection: true };\n        return;\n      }\n\n      // Edge case: Cap queue length to prevent runaway (A13: rapid scores)\n      const MAX_QUEUE_SIZE = 6;  // Max gymnasts per rotation\n      if (queue.length >= MAX_QUEUE_SIZE) {\n        console.warn('Flash queue full, dropping oldest entry:', {\n          team: teamIndex,\n          dropped: queue[0].name,\n          newEntry: gymnastData.name\n        });\n        queue.shift();\n      }\n\n      console.log('Queuing score flash:', {\n        team: teamIndex,\n        gymnast: gymnastData.name,\n        score: gymnastData.score,\n        queueLength: queue.length\n      });\n\n      // Add to queue\n      queue.push(gymnastData);\n\n      // If no active flash, start displaying\n      if (!state.activeFlashes[teamIndex]) {\n        displayNextFlash(teamIndex);\n      }\n    }\n\n    /**\n     * Display the next flash from the queue.\n     * Called when starting or advancing the queue.\n     * @param {number} teamIndex - 1-based team index\n     */\n    function displayNextFlash(teamIndex) {\n      const queue = state.flashQueues[teamIndex] || [];\n\n      if (queue.length === 0) {\n        // No more flashes - clear active state\n        state.activeFlashes[teamIndex] = null;\n        clearFlashDisplay(teamIndex);\n        return;\n      }\n\n      // Get next flash from queue\n      const gymnastData = queue.shift();\n\n      // Set as active\n      state.activeFlashes[teamIndex] = {\n        ...gymnastData,\n        startTime: Date.now(),\n        timer: setTimeout(() => {\n          advanceFlashQueue(teamIndex);\n        }, state.flashDuration)\n      };\n\n      // Render the flash\n      renderFlash(teamIndex, gymnastData);\n    }\n\n    /**\n     * Advance to next flash in queue (called when timer expires).\n     * @param {number} teamIndex - 1-based team index\n     */\n    function advanceFlashQueue(teamIndex) {\n      // Clear current flash timer\n      if (state.activeFlashes[teamIndex]?.timer) {\n        clearTimeout(state.activeFlashes[teamIndex].timer);\n      }\n\n      // Display next or clear\n      displayNextFlash(teamIndex);\n    }\n\n    /**\n     * Render a score flash in a team's slot area with slot machine animation.\n     * TODO: Task A7 will enhance rendering with headshots/apparatus.\n     * @param {number} teamIndex - 1-based team index\n     * @param {Object} gymnastData - Score data to render\n     */\n    function renderFlash(teamIndex, gymnastData) {\n      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n      if (!slotContent) return;\n\n      // Check if there's existing content to animate out\n      const hasExistingContent = slotContent.innerHTML.trim() !== '';\n\n      if (hasExistingContent) {\n        // Spin out existing content first\n        slotContent.classList.remove('spin-in', 'visible');\n        slotContent.classList.add('spin-out');\n\n        // After spin-out completes, insert new content and spin in\n        setTimeout(() => {\n          insertFlashContent(slotContent, gymnastData);\n          triggerSpinIn(slotContent);\n        }, 400);  // Match spin-out animation duration\n      } else {\n        // No existing content - insert and spin in directly\n        insertFlashContent(slotContent, gymnastData);\n        triggerSpinIn(slotContent);\n      }\n\n      console.log('Rendered flash:', {\n        team: teamIndex,\n        gymnast: gymnastData.name,\n        score: gymnastData.score,\n        animated: hasExistingContent ? 'spin-transition' : 'spin-in'\n      });\n    }\n\n    /**\n     * Insert flash content HTML into slot element (Task A7).\n     * Renders: apparatus | name | SV | separator | score | correction indicator\n     * @param {HTMLElement} slotContent - The slot content container\n     * @param {Object} gymnastData - Score data to render\n     */\n    function insertFlashContent(slotContent, gymnastData) {\n      // Get headshot URL (E3) with fallback (E5)\n      const headshotUrl = getAthleteHeadshot(\n        gymnastData.firstName,\n        gymnastData.lastName,\n        gymnastData.apiHeadshot\n      );\n      // Escape names for use in onerror attribute\n      const escapedFirst = (gymnastData.firstName || '').replace(/'/g, \"\\\\'\");\n      const escapedLast = (gymnastData.lastName || '').replace(/'/g, \"\\\\'\");\n      const headshotHtml = headshotUrl\n        ? `<img class=\"slot-headshot\" src=\"${headshotUrl}\" alt=\"\" onerror=\"handleHeadshotError(this, '${escapedFirst}', '${escapedLast}')\">`\n        : `<div class=\"slot-headshot-fallback\" style=\"width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#374151 0%,#1f2937 100%);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#9ca3af;flex-shrink:0;\">${(gymnastData.firstName || '').charAt(0).toUpperCase()}${(gymnastData.lastName || '').charAt(0).toUpperCase() || '?'}</div>`;\n\n      // Format start value for display (e.g., \"5.0\" or \"5.2\")\n      const svDisplay = gymnastData.startValue\n        ? `<span class=\"slot-sv\">SV ${parseFloat(gymnastData.startValue).toFixed(1)}</span>`\n        : '';\n\n      // Format score for display (e.g., \"13.450\")\n      const scoreValue = parseFloat(gymnastData.score);\n      const scoreDisplay = isNaN(scoreValue) ? gymnastData.score : scoreValue.toFixed(3);\n\n      // Stick indicator for bonus landings (men's gymnastics only)\n      const stickIndicator = (state.gender === 'mens' && gymnastData.hasStick) ? '<span class=\"slot-stick\">Stick</span>' : '';\n\n      slotContent.innerHTML = `\n        ${headshotHtml}\n        <span class=\"slot-apparatus\">${gymnastData.event}</span>\n        <span class=\"slot-name\">${gymnastData.name}</span>\n        ${svDisplay}\n        <span class=\"slot-separator\">•</span>\n        <span class=\"slot-score\">${scoreDisplay}</span>\n        ${stickIndicator}\n        ${gymnastData.isCorrection ? '<span class=\"slot-correction\">(corrected)</span>' : ''}\n      `;\n    }\n\n    /**\n     * Trigger spin-in animation on slot content.\n     * @param {HTMLElement} slotContent - The slot content container\n     */\n    function triggerSpinIn(slotContent) {\n      // Reset animation state\n      slotContent.classList.remove('spin-out', 'exit-up', 'enter-from-below');\n\n      // Force reflow to ensure animation restarts\n      void slotContent.offsetWidth;\n\n      // Trigger spin-in animation\n      slotContent.classList.add('spin-in', 'visible');\n    }\n\n    /**\n     * Clear flash display for a team (return to idle state) with spin-out animation.\n     * After flash ends, checks if there's a now-competing state to restore (B5).\n     * @param {number} teamIndex - 1-based team index\n     */\n    function clearFlashDisplay(teamIndex) {\n      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n      if (!slotContent) return;\n\n      // Only animate if there's content to clear\n      if (slotContent.innerHTML.trim() === '') return;\n\n      // Trigger spin-out animation\n      slotContent.classList.remove('spin-in', 'visible');\n      slotContent.classList.add('spin-out');\n\n      // After animation completes, either restore now-competing or clear (B5)\n      setTimeout(() => {\n        if (state.activeFlashes[teamIndex]) return;  // New flash started during animation\n\n        // Check if there's a now-competing state to restore\n        const nowCompetingToRestore = getNowCompetingForTeam(teamIndex);\n\n        if (nowCompetingToRestore) {\n          // Restore now-competing display\n          insertNowCompetingContent(slotContent, nowCompetingToRestore);\n          triggerSpinIn(slotContent);\n          console.log('Restored now-competing after flash:', {\n            team: teamIndex,\n            athlete: nowCompetingToRestore.athlete?.name\n          });\n        } else {\n          // No now-competing to show - clear the slot\n          slotContent.innerHTML = '';\n          slotContent.classList.remove('spin-out');\n        }\n      }, 400);  // Match CSS animation duration\n    }\n\n    /**\n     * Get the current now-competing data for a team (B5).\n     * Respects auto/manual mode settings.\n     * @param {number} teamIndex - 1-based team index\n     * @returns {Object|null} Now-competing data or null\n     */\n    function getNowCompetingForTeam(teamIndex) {\n      // Find the team by index\n      const teamArrayIdx = state.teams.findIndex(t => t.index === teamIndex);\n      if (teamArrayIdx === -1) return null;\n\n      const nowCompeting = state.nowCompeting.find(nc => nc.teamIndex === teamArrayIdx);\n      if (!nowCompeting) return null;\n\n      // Check if we should show based on mode\n      if (state.automationMode === 'auto') {\n        return nowCompeting;\n      } else {\n        // Manual mode - only if producer has enabled\n        return state.manualNowCompeting[teamIndex] ? nowCompeting : null;\n      }\n    }\n\n    // ============================================================\n    // NOW-COMPETING SLOT STATE (Task B2)\n    // ============================================================\n\n    /**\n     * Render \"now competing\" state in a team's slot area.\n     * Shows: athlete name + apparatus (no start value - not known until after)\n     * Uses same slot animation system as score flashes.\n     * @param {number} teamIndex - 1-based team index\n     * @param {Object} nowCompetingData - { athlete: { name }, eventName }\n     */\n    function renderNowCompeting(teamIndex, nowCompetingData) {\n      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n      if (!slotContent) return;\n\n      // Don't show now-competing if there's an active score flash\n      if (state.activeFlashes[teamIndex]) {\n        console.log('Skipping now-competing render - score flash active', { team: teamIndex });\n        return;\n      }\n\n      // Check if there's existing content to animate out\n      const hasExistingContent = slotContent.innerHTML.trim() !== '';\n\n      if (hasExistingContent) {\n        // Spin out existing content first\n        slotContent.classList.remove('spin-in', 'visible');\n        slotContent.classList.add('spin-out');\n\n        // After spin-out completes, insert new content and spin in\n        setTimeout(() => {\n          insertNowCompetingContent(slotContent, nowCompetingData);\n          triggerSpinIn(slotContent);\n        }, 400);  // Match spin-out animation duration\n      } else {\n        // No existing content - insert and spin in directly\n        insertNowCompetingContent(slotContent, nowCompetingData);\n        triggerSpinIn(slotContent);\n      }\n\n      console.log('Rendered now-competing:', {\n        team: teamIndex,\n        athlete: nowCompetingData.athlete.name,\n        event: nowCompetingData.eventName\n      });\n    }\n\n    /**\n     * Insert now-competing content HTML into slot element.\n     * Renders: apparatus | \"UP NOW\" label | athlete name\n     * @param {HTMLElement} slotContent - The slot content container\n     * @param {Object} nowCompetingData - { athlete: { name }, eventName }\n     */\n    function insertNowCompetingContent(slotContent, nowCompetingData) {\n      const athlete = nowCompetingData.athlete || {};\n      const athleteName = athlete.name || 'Unknown';\n      const eventName = nowCompetingData.eventName || '';\n\n      // Format event name to short code if possible (e.g., \"Floor Exercise\" -> \"FX\")\n      const eventShort = getEventShortCode(eventName) || eventName;\n\n      // Get headshot URL (E4) with fallback (E5)\n      const headshotUrl = getAthleteHeadshot(\n        athlete.firstName,\n        athlete.lastName,\n        athlete.apiHeadshot\n      );\n      // Escape names for use in onerror attribute\n      const escapedFirst = (athlete.firstName || '').replace(/'/g, \"\\\\'\");\n      const escapedLast = (athlete.lastName || '').replace(/'/g, \"\\\\'\");\n      const headshotHtml = headshotUrl\n        ? `<img class=\"slot-headshot\" src=\"${headshotUrl}\" alt=\"\" onerror=\"handleHeadshotError(this, '${escapedFirst}', '${escapedLast}')\">`\n        : `<div class=\"slot-headshot-fallback\" style=\"width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#374151 0%,#1f2937 100%);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#9ca3af;flex-shrink:0;\">${(athlete.firstName || '').charAt(0).toUpperCase()}${(athlete.lastName || '').charAt(0).toUpperCase() || '?'}</div>`;\n\n      slotContent.innerHTML = `\n        ${headshotHtml}\n        <span class=\"slot-apparatus\">${eventShort}</span>\n        <span class=\"slot-sv\" style=\"color: #22d3ee;\">UP NOW</span>\n        <span class=\"slot-name\">${athleteName}</span>\n      `;\n    }\n\n    /**\n     * Convert event name to short code (e.g., \"Floor Exercise\" -> \"FX\").\n     * @param {string} eventName - Full event name from API\n     * @returns {string} Short code or original name\n     */\n    function getEventShortCode(eventName) {\n      if (!eventName) return '';\n\n      const name = eventName.toLowerCase();\n\n      // Men's events\n      if (name.includes('floor')) return 'FX';\n      if (name.includes('pommel') || name.includes('horse')) return 'PH';\n      if (name.includes('ring')) return 'SR';\n      if (name.includes('vault')) return 'VT';\n      if (name.includes('parallel')) return 'PB';\n      if (name.includes('high bar') || name.includes('horizontal')) return 'HB';\n\n      // Women's events\n      if (name.includes('uneven') || name.includes('bars')) return 'UB';\n      if (name.includes('beam') || name.includes('balance')) return 'BB';\n\n      return eventName;\n    }\n\n    /**\n     * Clear now-competing display for a team (when they finish or move to flash).\n     * @param {number} teamIndex - 1-based team index\n     */\n    function clearNowCompeting(teamIndex) {\n      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n      if (!slotContent) return;\n\n      // Don't clear if a score flash is showing\n      if (state.activeFlashes[teamIndex]) return;\n\n      // Only animate if there's content to clear\n      if (slotContent.innerHTML.trim() === '') return;\n\n      // Check if showing now-competing content (has \"UP NOW\" label)\n      if (!slotContent.innerHTML.includes('UP NOW')) return;\n\n      // Trigger spin-out animation\n      slotContent.classList.remove('spin-in', 'visible');\n      slotContent.classList.add('spin-out');\n\n      // Clear content after animation completes\n      setTimeout(() => {\n        if (!state.activeFlashes[teamIndex]) {\n          slotContent.innerHTML = '';\n          slotContent.classList.remove('spin-out');\n        }\n      }, 400);  // Match CSS animation duration\n    }\n\n    /**\n     * Update now-competing displays for all teams based on current state.\n     * Called after processApiData detects now-competing changes.\n     *\n     * Behavior differs by mode:\n     * - Auto mode (B3): Automatically show all detected now-competing athletes\n     * - Manual mode (B4): Only show when producer explicitly enables via Firebase nowCompeting\n     */\n    function updateAllNowCompeting() {\n      state.teams.forEach((team, idx) => {\n        const teamIndex = team.index;\n        const nowCompeting = state.nowCompeting.find(nc => nc.teamIndex === idx);\n\n        // Determine if we should show now-competing for this team\n        let shouldShow = false;\n\n        if (state.automationMode === 'auto') {\n          // Auto mode (B3): Show if detected\n          shouldShow = !!nowCompeting;\n        } else {\n          // Manual mode (B4): Only show if producer has enabled AND we have data\n          shouldShow = !!nowCompeting && state.manualNowCompeting[teamIndex] === true;\n        }\n\n        if (shouldShow && nowCompeting) {\n          renderNowCompeting(teamIndex, nowCompeting);\n        } else {\n          clearNowCompeting(teamIndex);\n        }\n      });\n    }\n\n    /**\n     * Get current flash queue status for debugging/producer panel.\n     * @returns {Object} Queue status by team\n     */\n    function getFlashQueueStatus() {\n      const status = {};\n      state.teams.forEach((team) => {\n        const queue = state.flashQueues[team.index] || [];\n        const active = state.activeFlashes[team.index];\n        status[team.index] = {\n          teamName: team.name,\n          queueLength: queue.length,\n          activeFlash: active ? {\n            gymnast: active.name,\n            score: active.score,\n            timeRemaining: active.startTime ?\n              Math.max(0, state.flashDuration - (Date.now() - active.startTime)) : 0\n          } : null\n        };\n      });\n      return status;\n    }\n\n    // ============================================================\n    // ROTATION DETECTION (Task A10)\n    // ============================================================\n\n    /**\n     * Detect current rotation from API data using ALL teams.\n     * For standard meets (teams <= apparatus): rotation advances when ALL teams\n     * have completed their current event.\n     * For meets with byes (teams > apparatus, e.g., 7-team women's): uses the\n     * API's rotation field on events to determine the current rotation.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @returns {Object} { current: number, total: number, isFinal: boolean }\n     */\n    function detectRotation(apiTeams) {\n      if (!apiTeams || apiTeams.length === 0) {\n        return state.rotation;  // Keep existing state if no data\n      }\n\n      const totalRotations = state.rotation.total;\n      const eventCount = state.gender === 'womens' ? 4 : 6;\n      const hasByes = state.teams.length > eventCount;\n\n      if (hasByes) {\n        // For meets with byes, use the API's rotation field on events\n        // to detect which rotation is currently in progress or most recently completed\n        return detectRotationFromApiFields(apiTeams, totalRotations);\n      }\n\n      // Standard detection: min completed events across ALL teams\n      let minCompletedAcrossTeams = totalRotations;\n\n      apiTeams.forEach((team) => {\n        const events = team.events || [];\n        let completedEvents = 0;\n\n        events.forEach((event) => {\n          const gymnasts = event.gymnasts || [];\n          // An event is \"complete\" if all gymnasts have scores\n          const scored = gymnasts.filter(g => g.final_score != null);\n          if (scored.length === gymnasts.length && gymnasts.length > 0) {\n            completedEvents++;\n          }\n        });\n\n        minCompletedAcrossTeams = Math.min(minCompletedAcrossTeams, completedEvents);\n      });\n\n      // All events complete for all teams = Final\n      if (minCompletedAcrossTeams === totalRotations) {\n        return { current: totalRotations, total: totalRotations, isFinal: true };\n      }\n\n      // Current rotation = completed events + 1\n      const currentRotation = minCompletedAcrossTeams + 1;\n      return { current: currentRotation, total: totalRotations, isFinal: false };\n    }\n\n    /**\n     * Detect rotation for meets with byes using the API's rotation field.\n     * Finds the highest rotation number that has at least one score in progress.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @param {number} totalRotations - Total rotation count for this meet\n     * @returns {Object} { current: number, total: number, isFinal: boolean }\n     */\n    function detectRotationFromApiFields(apiTeams, totalRotations) {\n      let maxRotationWithScores = 0;\n      let allEventsComplete = true;\n\n      apiTeams.forEach((team) => {\n        (team.events || []).forEach((event) => {\n          const rotation = event.rotation;\n          if (!rotation) return;\n\n          const gymnasts = event.gymnasts || [];\n          const scored = gymnasts.filter(g => g.final_score != null);\n\n          if (scored.length > 0) {\n            maxRotationWithScores = Math.max(maxRotationWithScores, rotation);\n          }\n          // Check if any event is still incomplete\n          if (scored.length < gymnasts.length) {\n            allEventsComplete = false;\n          }\n        });\n      });\n\n      if (allEventsComplete && maxRotationWithScores > 0) {\n        return { current: totalRotations, total: totalRotations, isFinal: true };\n      }\n\n      const currentRotation = Math.max(1, maxRotationWithScores);\n      return { current: currentRotation, total: totalRotations, isFinal: false };\n    }\n\n    /**\n     * Detect the currently competing athlete for a team.\n     * Finds the next athlete without a score in an event that has some scores.\n     * Based on logic from GraphicsControl.jsx:216-269.\n     * @param {Object} team - Team object from Virtius API\n     * @returns {Object|null} { athlete: Object, event: Object } or null\n     */\n    function detectNowCompeting(team) {\n      if (!team || !team.events) return null;\n\n      // Olympic order for events (already sorted in API, but just in case)\n      const events = team.events;\n\n      for (const event of events) {\n        const gymnasts = event.gymnasts || [];\n        if (gymnasts.length === 0) continue;\n\n        // Sort by order (lineup position)\n        const sortedGymnasts = [...gymnasts].sort((a, b) => (a.order || 0) - (b.order || 0));\n\n        // Find scored and unscored athletes\n        const scored = sortedGymnasts.filter(g => g.final_score != null);\n        const unscored = sortedGymnasts.filter(g => g.final_score == null);\n\n        // If this event has some scores but not all, it's in progress\n        if (scored.length > 0 && unscored.length > 0) {\n          return {\n            athlete: unscored[0],\n            event: event\n          };\n        }\n      }\n\n      return null; // No one currently competing (between rotations or complete)\n    }\n\n    /**\n     * Detect now-competing athletes for all teams and return results.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @returns {Array} Array of { teamIndex, teamName, tricode, athlete, eventName }\n     */\n    function detectAllNowCompeting(apiTeams) {\n      if (!apiTeams || apiTeams.length === 0) return [];\n\n      const results = [];\n\n      apiTeams.forEach((team, teamIndex) => {\n        const nowCompeting = detectNowCompeting(team);\n        if (nowCompeting) {\n          results.push({\n            teamIndex: teamIndex,\n            teamKey: team.short_name || `team${teamIndex + 1}`,\n            teamName: team.name,\n            tricode: team.tricode,\n            athlete: {\n              id: nowCompeting.athlete.gymnast_id,\n              name: nowCompeting.athlete.full_name,\n              firstName: nowCompeting.athlete.first_name || '',\n              lastName: nowCompeting.athlete.last_name || '',\n              apiHeadshot: nowCompeting.athlete.headshot || '',\n              order: nowCompeting.athlete.order,\n              type: nowCompeting.athlete.type // 0=competing, 1=exhibition, etc.\n            },\n            eventName: nowCompeting.event.event_name\n          });\n        }\n      });\n\n      return results;\n    }\n\n    /**\n     * Update the rotation tag display in the DOM.\n     * Shows \"Rotation X of Y\" or \"Final\" when complete.\n     */\n    function updateRotationTag() {\n      const tagEl = document.getElementById('rotationTag');\n      if (!tagEl) return;\n\n      const { current, total, isFinal } = state.rotation;\n\n      if (isFinal) {\n        tagEl.textContent = 'Final';\n      } else {\n        tagEl.textContent = `Rotation ${current} of ${total}`;\n      }\n    }\n\n    // Initialize Firebase schema with default values (prevents race conditions)\n    // Uses update() with null checks - only sets values that don't exist\n    async function initializeSchema() {\n      const defaultSchema = {\n        enabled: false,\n        polling: false,\n        automationMode: 'auto',\n        showLineup: null,\n        dismissFlash: {},\n        nowCompeting: {},\n        detected: {},\n        heartbeat: null,\n        liveData: {\n          lastPollTimestamp: null,\n          lastDataChangeTimestamp: null,\n          stalePollCount: 0,\n          rotation: null,\n          totalRotations: null,\n          teams: {}\n        },\n        lastError: null,\n        config: {\n          pollInterval: 5000,\n          flashDuration: 10000,\n          showStickIndicator: true\n        }\n      };\n\n      try {\n        // Use transaction to safely initialize schema without overwriting existing values\n        await scoreBugRef.transaction((currentData) => {\n          if (currentData === null) {\n            // No data exists - write full schema\n            console.log('Initializing scoreBug schema with defaults');\n            return defaultSchema;\n          }\n          // Data exists - merge defaults for any missing fields only\n          const merged = { ...defaultSchema };\n          Object.keys(currentData).forEach(key => {\n            if (currentData[key] !== undefined) {\n              // Keep existing value\n              merged[key] = currentData[key];\n            }\n          });\n          // Deep merge for nested objects (config, liveData)\n          if (currentData.config) {\n            merged.config = { ...defaultSchema.config, ...currentData.config };\n          }\n          if (currentData.liveData) {\n            merged.liveData = { ...defaultSchema.liveData, ...currentData.liveData };\n          }\n          console.log('Merged existing scoreBug data with defaults');\n          return merged;\n        });\n        console.log('Firebase schema initialized');\n      } catch (err) {\n        console.error('Failed to initialize schema:', err);\n      }\n    }\n\n    // Initialize on load\n    if (compId) {\n      // Start connection monitor immediately (A3d)\n      initConnectionMonitor();\n\n      // Order: load config -> render teams -> initialize schema -> start listeners\n      loadCompetitionConfig().then(async (success) => {\n        if (!success) return;  // Exit early, don't initialize listeners\n\n        // Render team rows with initial state (before API data)\n        renderTeamRows();\n\n        // Update rotation tag for correct total (4 for women, 6 for men)\n        updateRotationTag();\n\n        // Initialize Firebase schema (safe defaults)\n        await initializeSchema();\n\n        // Start listening for Firebase changes (only after successful config load)\n        initFirebaseListeners();\n      });\n    }\n  </script>\n  <script src=\"theme-loader.js\"></script>\n</body>\n</html>\n","numLines":2433,"startLine":1,"totalLines":2433}}}
