-v24', label: '🎨 V24 Meet Theme', isLayout: true },\n    99→  { id: 'layout-split-row', label: '📊 Split Row (5-team)', isLayout: true },\n   100→  { id: 'layout-dual-dynamic-v1', label: '📏 Dual Dynamic V1', isLayout: true },\n   101→  // COLOR THEMES - Same structure, different colors\n   102→  { id: 'default', label: 'Default (Original)' },\n   103→  { id: 'espn', label: 'ESPN Colors' },\n   104→  { id: 'nbc', label: 'NBC Olympics' },\n   105→  { id: 'btn', label: 'Big Ten' },\n   106→  { id: 'pac12', label: 'Pac-12' },\n   107→  { id: 'virtius', label: 'Virtius' },\n   108→  { id: 'neon', label: 'Neon' },\n   109→  { id: 'classic', label: 'Classic' },\n   110→  { id: 'light', label: 'Light' },\n   111→  { id: 'home', label: 'Team Colors' },\n   112→  { id: 'gradient', label: 'Gradient' },\n   113→];\n   114→\n   115→// Map Virtius event names to display names\n   116→const eventDisplayNames = {\n   117→  'FLOOR': 'Floor Exercise',\n   118→  'HORSE': 'Pommel Horse',\n   119→  'RINGS': 'Still Rings',\n   120→  'VAULT': 'Vault',\n   121→  'PBARS': 'Parallel Bars',\n   122→  'BAR': 'High Bar',\n   123→};\n   124→\n   125→export default function GraphicsControl({ competitionId }) {\n   126→  const [currentGraphic, setCurrentGraphic] = useState(null);\n   127→  const [currentGraphicId, setCurrentGraphicId] = useState(null); // Track the specific button ID (e.g., 'floor', 'pommel')\n   128→  const [config, setConfig] = useState(null);\n   129→  const [copied, setCopied] = useState(false);\n   130→  const [copiedTheme, setCopiedTheme] = useState(false);\n   131→  const [summaryTheme, setSummaryTheme] = useState('default');\n   132→  const [liveAthletes, setLiveAthletes] = useState([]); // Athletes currently competing - now read from Firebase\n   133→  const [scoreBugPolling, setScoreBugPolling] = useState(false); // Whether scoreBug overlay is polling\n   134→\n   135→  // Use competitionId directly from props (no local state needed)\n   136→  const compId = competitionId || '';\n   137→\n   138→  // Get gender-specific event configuration\n   139→  const { events, eventIds, rotationCount, gender } = useEventConfig(config?.compType);\n   140→\n   141→  // Get teams database for sponsor data\n   142→  const { getTeamSponsors, resolveSchoolKey } = useTeamsDatabase();\n   143→\n   144→  // Build dynamic graphic buttons based on competition gender and team names\n   145→  const graphicButtons = useMemo(() => {\n   146→    const maxTeams = teamCounts[config?.compType] || 2;\n   147→\n   148→    // Build team names object from config\n   149→    const teamNames = {};\n   150→    for (let i = 1; i <= maxTeams; i++) {\n   151→      teamNames[i] = config?.[`team${i}Name`] || `Team ${i}`;\n   152→    }\n   153→\n   154→    // Get graphics from registry with dynamic labels\n   155→    const registryGraphics = getGraphicsForCompetition(config?.compType, teamNames);\n   156→\n   157→    // Build base graphic buttons from registry (pre-meet, in-meet, frame-overlays, stream, sponsors)\n   158→    const baseGraphicButtons = registryGraphics\n   159→      .filter(g => ['pre-meet', 'in-meet', 'frame-overlays', 'stream', 'sponsors'].includes(g.category))\n   160→      .map(g => ({\n   161→        id: g.id,\n   162→        label: g.label,\n   163→        section: CATEGORY_TO_SECTION[g.category] || g.category,\n   164→        team: g.team,\n   165→      }));\n   166→\n   167→    // Build leaderboard buttons from gender-specific events\n   168→    const leaderboardButtons = eventIds\n   169→      .map(eventId => leaderboardButtonConfig[eventId])\n   170→      .filter(Boolean)\n   171→      .map(btn => ({ ...btn, section: 'Leaderboards' }));\n   172→\n   173→    return [\n   174→      ...baseGraphicButtons,\n   175→      ...leaderboardButtons,\n   176→      ...commonLeaderboardButtons.map(btn => ({ ...btn, section: 'Leaderboards' })),\n   177→    ];\n   178→  }, [eventIds, config]);\n   179→\n   180→  // Build apparatus buttons for Event Summary (gender-specific)\n   181→  const apparatusButtons = useMemo(() => {\n   182→    return events.map(event => ({\n   183→      id: event.shortName.toLowerCase(),\n   184→      label: event.shortName,\n   185→    }));\n   186→  }, [events]);\n   187→\n   188→  // Load competition config\n   189→  useEffect(() => {\n   190→    if (!compId) return;\n   191→\n   192→    const configRef = ref(db, `competitions/${compId}/config`);\n   193→    const unsubscribe = onValue(configRef, (snapshot) => {\n   194→      setConfig(snapshot.val());\n   195→    });\n   196→\n   197→    return () => unsubscribe();\n   198→  }, [compId]);\n   199→\n   200→  // Listen for current graphic state\n   201→  useEffect(() => {\n   202→    if (!compId) return;\n   203→\n   204→    const graphicRef = ref(db, `competitions/${compId}/currentGraphic`);\n   205→    const unsubscribe = onValue(graphicRef, (snapshot) => {\n   206→      const data = snapshot.val();\n   207→      if (data?.graphic === 'clear') {\n   208→        setCurrentGraphic(null);\n   209→        setCurrentGraphicId(null);\n   210→      } else {\n   211→        setCurrentGraphic(data?.graphic);\n   212→        // For event-frame, extract the specific event from graphicId or frameTitle\n   213→        setCurrentGraphicId(data?.graphicId || null);\n   214→      }\n   215→    });\n   216→\n   217→    return () => unsubscribe();\n   218→  }, [compId]);\n   219→\n   220→  // Listen to Firebase for now-competing athletes (written by team-bug.html overlay)\n   221→  useEffect(() => {\n   222→    if (!compId) {\n   223→      setLiveAthletes([]);\n   224→      setScoreBugPolling(false);\n   225→      return;\n   226→    }\n   227→\n   228→    // Listen for detected now-competing athletes from scoreBug overlay\n   229→    const nowCompetingRef = ref(db, `competitions/${compId}/scoreBug/detected/nowCompeting`);\n   230→    const unsubscribeNowCompeting = onValue(nowCompetingRef, (snapshot) => {\n   231→      const data = snapshot.val();\n   232→      if (data && Array.isArray(data)) {\n   233→        // Transform to match existing liveAthletes format\n   234→        const athletes = data.map(entry => ({\n   235→          id: entry.athlete?.id,\n   236→          name: entry.athlete?.name,\n   237→          team: entry.teamName,\n   238→          teamTricode: entry.tricode,\n   239→          event: entry.eventName,\n   240→          eventDisplay: eventDisplayNames[entry.eventName] || entry.eventName,\n   241→          order: entry.athlete?.order,\n   242→        }));\n   243→        setLiveAthletes(athletes);\n   244→      } else {\n   245→        setLiveAthletes([]);\n   246→      }\n   247→    });\n   248→\n   249→    // Listen for scoreBug polling state to show status indicator\n   250→    const pollingRef = ref(db, `competitions/${compId}/scoreBug/config/polling`);\n   251→    const unsubscribePolling = onValue(pollingRef, (snapshot) => {\n   252→      setScoreBugPolling(snapshot.val() === true);\n   253→    });\n   254→\n   255→    return () => {\n   256→      unsubscribeNowCompeting();\n   257→      unsubscribePolling();\n   258→    };\n   259→  }, [compId]);\n   260→\n   261→  const sendGraphic = async (graphicId, frameTitle = null, leaderboardEvent = null) => {\n   262→    if (!compId || !config) return;\n   263→\n   264→    const data = {\n   265→      eventName: config.eventName || '',\n   266→      meetDate: config.meetDate || '',\n   267→      venue: config.venue || '',\n   268→      location: config.location || '',\n   269→      hosts: config.hosts || '',\n   270→      virtiusSessionId: config.virtiusSessionId || '',\n   271→      // Team 1\n   272→      team1Name: config.team1Name || '',\n   273→      team1Logo: config.team1Logo || '',\n   274→      team1Ave: config.team1Ave || '',\n   275→      team1High: config.team1High || '',\n   276→      team1Con: config.team1Con || '',\n   277→      team1Coaches: config.team1Coaches || '',\n   278→      // Team 2\n   279→      team2Name: config.team2Name || '',\n   280→      team2Logo: config.team2Logo || '',\n   281→      team2Ave: config.team2Ave || '',\n   282→      team2High: config.team2High || '',\n   283→      team2Con: config.team2Con || '',\n   284→      team2Coaches: config.team2Coaches || '',\n   285→      // Team 3\n   286→      team3Name: config.team3Name || '',\n   287→      team3Logo: config.team3Logo || '',\n   288→      team3Ave: config.team3Ave || '',\n   289→      team3High: config.team3High || '',\n   290→      team3Con: config.team3Con || '',\n   291→      team3Coaches: config.team3Coaches || '',\n   292→      // Team 4\n   293→      team4Name: config.team4Name || '',\n   294→      team4Logo: config.team4Logo || '',\n   295→      team4Ave: config.team4Ave || '',\n   296→      team4High: config.team4High || '',\n   297→      team4Con: config.team4Con || '',\n   298→      team4Coaches: config.team4Coaches || '',\n   299→      // Team 5\n   300→      team5Name: config.team5Name || '',\n   301→      team5Logo: config.team5Logo || '',\n   302→      team5Ave: config.team5Ave || '',\n   303→      team5High: config.team5High || '',\n   304→      team5Con: config.team5Con || '',\n   305→      team5Coaches: config.team5Coaches || '',\n   306→      // Team 6\n   307→      team6Name: config.team6Name || '',\n   308→      team6Logo: config.team6Logo || '',\n   309→      team6Ave: config.team6Ave || '',\n   310→      team6High: config.team6High || '',\n   311→      team6Con: config.team6Con || '',\n   312→      team6Coaches: config.team6Coaches || '',\n   313→      // Team 7\n   314→      team7Name: config.team7Name || '',\n   315→      team7Logo: config.team7Logo || '',\n   316→      team7Ave: config.team7Ave || '',\n   317→      team7High: config.team7High || '',\n   318→      team7Con: config.team7Con || '',\n   319→      team7Coaches: config.team7Coaches || '',\n   320→    };\n   321→\n   322→    if (frameTitle) {\n   323→      data.frameTitle = frameTitle;\n   324→    }\n   325→\n   326→    if (leaderboardEvent) {\n   327→      data.leaderboardEvent = leaderboardEvent;\n   328→      data.leaderboardGender = gender; // Pass gender for column visibility (women don't have Exec/SB)\n   329→    }\n   330→\n   331→    // Handle sponsor graphics - check for event sponsors from theme first, then fall back to team sponsors\n   332→    if (graphicId.startsWith('sponsors-')) {\n   333→      let sponsorsFound = false;\n   334→\n   335→      // Check if competition has a theme with event sponsors\n   336→      if (config.meetTheme) {\n   337→        try {\n   338→          const themeRef = ref(db, `themes/${config.meetTheme}/sponsors`);\n   339→          const snapshot = await get(themeRef);\n   340→          const eventSponsors = snapshot.val();\n   341→          if (eventSponsors && Array.isArray(eventSponsors) && eventSponsors.length > 0) {\n   342→            // Use event sponsors from theme\n   343→            data.sponsors = JSON.stringify(eventSponsors.slice(0, 8).map(s => ({\n   344→              name: s.name || '',\n   345→              url: s.url || ''\n   346→            })));\n   347→            sponsorsFound = true;\n   348→          }\n   349→        } catch (err) {\n   350→          console.error('Error fetching theme sponsors:', err);\n   351→        }\n   352→      }\n   353→\n   354→      // Fallback to team sponsors if no event sponsors\n   355→      if (!sponsorsFound) {\n   356→        // Resolve home team key from team name (includes gender suffix)\n   357→        const schoolKey = resolveSchoolKey(config.team1Name);\n   358→        // Add gender suffix to get full team key (e.g., \"west-chester\" -> \"west-chester-womens\")\n   359→        const homeTeamKey = schoolKey ? `${schoolKey}-${gender}` : null;\n   360→        if (homeTeamKey) {\n   361→          const teamSponsors = getTeamSponsors(homeTeamKey);\n   362→          // Convert to JSON for the overlay\n   363→          data.sponsors = JSON.stringify(teamSponsors.slice(0, 8).map(s => ({\n   364→            name: s.name,\n   365→            url: s.url\n   366→          })));\n   367→        } else {\n   368→          data.sponsors = '[]';\n   369→        }\n   370→      }\n   371→    }\n   372→\n   373→    // Determine graphic type\n   374→    let graphicType = graphicId;\n   375→    if (eventFrames.includes(graphicId)) {\n   376→      graphicType = 'event-frame';\n   377→    } else if (graphicId.startsWith('leaderboard-')) {\n   378→      graphicType = 'virtius-leaderboard';\n   379→    } else if (graphicId.match(/^team\\d+-roster$/)) {\n   380→      graphicType = 'team-roster';\n   381→    }\n   382→\n   383→    // Include graphicId in data for renderers that need it\n   384→    data.graphicId = graphicId;\n   385→\n   386→    set(ref(db, `competitions/${compId}/currentGraphic`), {\n   387→      graphic: graphicType,\n   388→      graphicId: graphicId, // Store the specific button ID for highlighting\n   389→      data: data,\n   390→      timestamp: Date.now()\n   391→    });\n   392→  };\n   393→\n   394→  // Send event summary graphic - can be rotation-based (R1-R4/R1-R6) or apparatus-based (gender-specific events)\n   395→  const sendEventSummary = (mode, value) => {\n   396→    if (!compId || !config) return;\n   397→\n   398→    const maxTeams = teamCounts[config.compType] || 2;\n   399→\n   400→    // Dual meets use alternating format for rotation-based view\n   401→    // (home team on one event, away team on adjacent event, swapping each rotation)\n   402→    const isDual = config.compType?.includes('dual');\n   403→\n   404→    let graphicId, data;\n   405→\n   406→    if (mode === 'rotation') {\n   407→      // Rotation mode: for dual meets, use alternating format (teams on different events)\n   408→      // Men's: R1: Home=FX, Away=PH | R2: swap | R3: Home=SR, Away=VT | etc.\n   409→      // Women's: R1: Home=VT, Away=UB | R2: swap | R3: Home=BB, Away=FX | R4: swap\n   410→      // For multi-team meets (tri, quad), each team is on a different event per rotation\n   411→      graphicId = `summary-r${value}`;\n   412→      data = {\n   413→        virtiusSessionId: config.virtiusSessionId || '',\n   414→        summaryMode: 'rotation',\n   415→        summaryRotation: value,\n   416→        summaryNumTeams: maxTeams,\n   417→        summaryFormat: isDual ? 'alternating' : 'rotation', // 'alternating' for dual, 'rotation' for multi-team\n   418→        summaryTheme: summaryTheme,\n   419→        summaryGender: gender, // Gender for determining correct events\n   420→        team1Logo: config.team1Logo || '',\n   421→        team1Name: config.team1Name || '',\n   422→        team2Name: config.team2Name || '',\n   423→      };\n   424→    } else {\n   425→      // Apparatus mode: show both teams' scores for the same event (head-to-head view)\n   426→      graphicId = `summary-${value}`;\n   427→      data = {\n   428→        virtiusSessionId: config.virtiusSessionId || '',\n   429→        summaryMode: 'apparatus',\n   430→        summaryApparatus: value, // e.g., 'fx', 'ph', 'sr', 'vt', 'pb', 'hb', 'ub', 'bb'\n   431→        summaryNumTeams: maxTeams,\n   432→        summaryFormat: 'head-to-head', // Always head-to-head for apparatus mode\n   433→        summaryTheme: summaryTheme,\n   434→        summaryGender: gender, // Gender for determining correct events\n   435→        team1Logo: config.team1Logo || '',\n   436→        team1Name: config.team1Name || '',\n   437→        team2Name: config.team2Name || '',\n   438→      };\n   439→    }\n   440→\n   441→    set(ref(db, `competitions/${compId}/currentGraphic`), {\n   442→      graphic: 'event-summary',\n   443→      graphicId: graphicId,\n   444→      data: data,\n   445→      timestamp: Date.now()\n   446→    });\n   447→  };\n   448→\n   449→  const clearGraphic = () => {\n   450→    if (!compId) return;\n   451→\n   452→    set(ref(db, `competitions/${compId}/currentGraphic`), {\n   453→      graphic: 'clear',\n   454→      data: {},\n   455→      timestamp: Date.now()\n   456→    });\n   457→  };\n   458→\n   459→  // Send \"Now Competing\" graphic for a specific athlete\n   460→  const sendNowCompeting = (athlete) => {\n   461→    if (!compId || !config) return;\n   462→\n   463→    // Find the team logo based on the athlete's team\n   464→    let athleteLogo = config.team1Logo || '';\n   465→    for (let i = 1; i <= 6; i++) {\n   466→      if (config[`team${i}Name`] === athlete.team ||\n   467→          config[`team${i}Tricode`]?.toUpperCase() === athlete.teamTricode?.toUpperCase()) {\n   468→        athleteLogo = config[`team${i}Logo`] || '';\n   469→        break;\n   470→      }\n   471→    }\n   472→\n   473→    set(ref(db, `competitions/${compId}/currentGraphic`), {\n   474→      graphic: 'now-competing',\n   475→      graphicId: `now-competing-${athlete.id}`,\n   476→      data: {\n   477→        athleteName: athlete.name,\n   478→        athleteTeam: athlete.team,\n   479→        athleteEvent: athlete.eventDisplay,\n   480→        athleteLogo: athleteLogo,\n   481→        team1Logo: config.team1Logo || '',\n   482→      },\n   483→      timestamp: Date.now()\n   484→    });\n   485→  };\n   486→\n   487→  const sections = ['Pre-Meet', 'In-Meet', 'Frame Overlays', 'Leaderboards', 'Stream', 'Sponsors'];\n   488→\n   489→  const outputUrl = compId ? `${OUTPUT_BASE_URL}?comp=${compId}` : '';\n   490→  const localOutputUrl = compId ? `${LOCAL_OUTPUT_URL}?comp=${compId}` : '';\n   491→\n   492→  const copyOutputUrl = () => {\n   493→    if (!outputUrl) return;\n   494→    navigator.clipboard.writeText(outputUrl);\n   495→    setCopied(true);\n   496→    setTimeout(() => setCopied(false), 2000);\n   497→  };\n   498→\n   499→  const themeOutputUrl = compId && config?.meetTheme ? `${OUTPUT_BASE_URL}?comp=${compId}&meetTheme=${config.meetTheme}` : '';\n   500→\n   501→  const copyThemeUrl = () => {\n   502→    if (!themeOutputUrl) return;\n   503→    navigator.clipboard.writeText(themeOutputUrl);\n   504→    setCopiedTheme(true);\n   505→    setTimeout(() => setCopiedTheme(false), 2000);\n   506→  };\n   507→\n   508→  return (\n   509→    <div className=\"bg-zinc-800 rounded-xl p-4\">\n   510→      <div className=\"flex items-center justify-between mb-3\">\n   511→        <div className=\"flex items-center gap-2 text-sm text-zinc-400 uppercase tracking-wide\">\n   512→          <PhotoIcon className=\"w-4 h-4\" />\n   513→          Web Graphics\n   514→        </div>\n   515→        {currentGraphic && (\n   516→          <span className=\"text-xs bg-blue-500/20 text-blue-400 px-2 py-1 rounded\">\n   517→            {currentGraphic}\n   518→          </span>\n   519→        )}\n   520→      </div>\n   521→\n   522→      {/* Copy Output URL & URL Generator */}\n   523→      {compId && (\n   524→        <div className=\"mb-4 space-y-2\">\n   525→          <button\n   526→            onClick={copyOutputUrl}\n   527→            className={`w-full flex items-center justify-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition-colors ${\n   528→              copied\n   529→                ? 'bg-green-600 text-white'\n   530→                : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-300'\n   531→            }`}\n   532→          >\n   533→            {copied ? (\n   534→              <>\n   535→                <CheckIcon className=\"w-4 h-4\" />\n   536→                Copied!\n   537→              </>\n   538→            ) : (\n   539→              <>\n   540→                <ClipboardDocumentIcon className=\"w-4 h-4\" />\n   541→                Copy Output URL\n   542→              </>\n   543→            )}\n   544→          </button>\n   545→          {config?.meetTheme && (\n   546→            <button\n   547→              onClick={copyThemeUrl}\n   548→              className={`w-full flex items-center justify-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition-colors ${\n   549→                copiedTheme\n   550→                  ? 'bg-green-600 text-white'\n   551→                  : 'bg-purple-700 hover:bg-purple-600 text-zinc-100'\n   552→              }`}\n   553→            >\n   554→              {copiedTheme ? (\n   555→                <>\n   556→                  <CheckIcon className=\"w-4 h-4\" />\n   557→                  Copied!\n   558→                </>\n   559→              ) : (\n   560→                <>\n   561→                  <ClipboardDocumentIcon className=\"w-4 h-4\" />\n   562→                  Copy Theme URL\n   563→                </>\n   564→              )}\n   565→            </button>\n   566→          )}\n   567→          <a\n   568→            href={localOutputUrl}\n   569→            target=\"_blank\"\n   570→            rel=\"noopener noreferrer\"\n   571→            className=\"w-full flex items-center justify-center gap-2 px-3 py-2 bg-amber-700 hover:bg-amber-600 text-zinc-100 rounded-lg text-sm font-medium transition-colors\"\n   572→          >\n   573→            Local Output\n   574→          </a>\n   575→          <Link\n   576→            to={`/url-generator?comp=${compId}`}\n   577→            className=\"w-full flex items-center justify-center gap-2 px-3 py-2 bg-zinc-700 hover:bg-zinc-600 text-zinc-300 rounded-lg text-sm font-medium transition-colors\"\n   578→          >\n   579→            <Cog6ToothIcon className=\"w-4 h-4\" />\n   580→            URL Generator\n   581→          </Link>\n   582→        </div>\n   583→      )}\n   584→\n   585→      {compId && config ? (\n   586→        <>\n   587→          {/* Graphic Buttons by Section */}\n   588→          {sections.map((section) => {\n   589→            // Get max teams for this competition type\n   590→            const maxTeams = teamCounts[config.compType] || 2;\n   591→\n   592→            // Filter buttons by section and team count\n   593→            const sectionButtons = graphicButtons.filter((btn) => {\n   594→              if (btn.section !== section) return false;\n   595→              // If button has a team number, only show if within max teams\n   596→              if (btn.team && btn.team > maxTeams) return false;\n   597→              return true;\n   598→            });\n   599→\n   600→            return (\n   601→              <div key={section} className=\"mb-4\">\n   602→                <div className=\"text-xs text-zinc-500 uppercase mb-2\">{section}</div>\n   603→                <div className=\"grid grid-cols-3 gap-1.5\">\n   604→                  {sectionButtons.map((btn) => (\n   605→                    <button\n   606→                      key={btn.id}\n   607→                      onClick={() => sendGraphic(btn.id, btn.title, btn.leaderboardEvent)}\n   608→                      className={`px-2 py-2 rounded text-xs font-medium transition-colors ${\n   609→                        currentGraphicId === btn.id\n   610→                          ? 'bg-blue-600 text-white'\n   611→                          : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-300'\n   612→                      }`}\n   613→                    >\n   614→                      {btn.label}\n   615→                    </button>\n   616→                  ))}\n   617→                </div>\n   618→              </div>\n   619→            );\n   620→          })}\n   621→\n   622→          {/* Event Summary Section - Rotation and Apparatus buttons */}\n   623→          {config.virtiusSessionId && (\n   624→            <div className=\"mb-4\">\n   625→              <div className=\"flex items-center justify-between mb-2\">\n   626→                <div className=\"text-xs text-zinc-500 uppercase\">Event Summary</div>\n   627→                <select\n   628→                  value={summaryTheme}\n   629→                  onChange={(e) => setSummaryTheme(e.target.value)}\n   630→                  className=\"text-xs bg-zinc-700 text-zinc-300 border border-zinc-600 rounded px-2 py-1 focus:outline-none focus:border-blue-500\"\n   631→                >\n   632→                  {summaryThemes.map((theme) => (\n   633→                    <option key={theme.id} value={theme.id}>{theme.label}</option>\n   634→                  ))}\n   635→                </select>\n   636→              </div>\n   637→              {/* Rotation buttons - dynamic based on gender (R1-R6 for mens, R1-R4 for womens) */}\n   638→              <div className=\"text-xs text-zinc-600 mb-1\">By Rotation (Alternating)</div>\n   639→              <div className={`grid gap-1.5 mb-2 ${rotationCount === 4 ? 'grid-cols-4' : 'grid-cols-6'}`}>\n   640→                {Array.from({ length: rotationCount }, (_, i) => i + 1).map((rotation) => {\n   641→                  const graphicId = `summary-r${rotation}`;\n   642→                  return (\n   643→                    <button\n   644→                      key={rotation}\n   645→                      onClick={() => sendEventSummary('rotation', rotation)}\n   646→                      className={`px-2 py-2 rounded text-xs font-medium transition-colors ${\n   647→                        currentGraphicId === graphicId\n   648→                          ? 'bg-blue-600 text-white'\n   649→                          : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-300'\n   650→                      }`}\n   651→                    >\n   652→                      R{rotation}\n   653→                    </button>\n   654→                  );\n   655→                })}\n   656→              </div>\n   657→              {/* Apparatus buttons - dynamic based on gender */}\n   658→              <div className=\"text-xs text-zinc-600 mb-1\">By Apparatus</div>\n   659→              <div className={`grid gap-1.5 ${apparatusButtons.length === 4 ? 'grid-cols-4' : 'grid-cols-6'}`}>\n   660→                {apparatusButtons.map((apparatus) => {\n   661→                  const graphicId = `summary-${apparatus.id}`;\n   662→                  return (\n   663→                    <button\n   664→                      key={apparatus.id}\n   665→                      onClick={() => sendEventSummary('apparatus', apparatus.id)}\n   666→                      className={`px-2 py-2 rounded text-xs font-medium transition-colors ${\n   667→                        currentGraphicId === graphicId\n   668→                          ? 'bg-blue-600 text-white'\n   669→                          : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-300'\n   670→                      }`}\n   671→                    >\n   672→                      {apparatus.label}\n   673→                    </button>\n   674→                  );\n   675→                })}\n   676→              </div>\n   677→            </div>\n   678→          )}\n   679→\n   680→          {/* Now Competing Section - Live athletes from Firebase (via team-bug overlay) */}\n   681→          {config.virtiusSessionId && (\n   682→            <div className=\"mb-4\">\n   683→              <div className=\"flex items-center justify-between mb-2\">\n   684→                <div className=\"text-xs text-zinc-500 uppercase\">Now Competing</div>\n   685→                <span\n   686→                  className={`text-xs px-2 py-1 rounded font-medium ${\n   687→                    scoreBugPolling\n   688→                      ? 'bg-green-600 text-white'\n   689→                      : 'bg-zinc-700 text-zinc-400'\n   690→                  }`}\n   691→                >\n   692→                  {scoreBugPolling ? 'Live' : 'Polling Off'}\n   693→                </span>\n   694→              </div>\n   695→              {scoreBugPolling ? (\n   696→                liveAthletes.length > 0 ? (\n   697→                  <div className=\"space-y-1.5\">\n   698→                    {liveAthletes.map((athlete) => (\n   699→                      <button\n   700→                        key={athlete.id}\n   701→                        onClick={() => sendNowCompeting(athlete)}\n   702→                        className={`w-full text-left px-3 py-2 rounded text-xs transition-colors ${\n   703→                          currentGraphicId === `now-competing-${athlete.id}`\n   704→                            ? 'bg-green-600 text-white'\n   705→                            : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-300'\n   706→                        }`}\n   707→                      >\n   708→                        <div className=\"flex items-center justify-between\">\n   709→                          <div>\n   710→                            <span className=\"font-semibold\">{athlete.name}</span>\n   711→                            <span className=\"text-zinc-400 ml-2\">({athlete.teamTricode || athlete.team})</span>\n   712→                          </div>\n   713→                          <span className=\"text-zinc-400\">{athlete.eventDisplay}</span>\n   714→                        </div>\n   715→                      </button>\n   716→                    ))}\n   717→                  </div>\n   718→                ) : (\n   719→                  <div className=\"text-xs text-zinc-500 text-center py-3 bg-zinc-700/50 rounded\">\n   720→                    No athletes currently competing\n   721→                  </div>\n   722→                )\n   723→              ) : (\n   724→                <div className=\"text-xs text-zinc-500 text-center py-3 bg-zinc-700/50 rounded\">\n   725→                  Enable polling in Score Bug panel\n   726→                </div>\n   727→              )}\n   728→            </div>\n   729→          )}\n   730→\n   731→          {/* Clear Button */}\n   732→          <button\n   733→            onClick={clearGraphic}\n   734→            className=\"w-full flex items-center justify-center gap-2 px-4 py-3 bg-red-600 hover:bg-red-500 text-white font-bold rounded-lg transition-colors\"\n   735→          >\n   736→            <XMarkIcon className=\"w-5 h-5\" />\n   737→            Clear Graphic\n   738→          </button>\n   739→        </>\n   740→      ) : (\n   741→        <div className=\"text-zinc-500 text-sm text-center py-4\">\n   742→          {compId ? 'Loading config...' : 'Select a competition to control graphics'}\n   743→        </div>\n   744→      )}\n   745→    </div>\n   746→  );\n   747→}\n   748→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5bfe1f31-57da-47fa-9c5e-a9fed104140c","uuid":"d1319921-976b-409a-9c64-fe46bb3ccab9","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/components/GraphicsControl.jsx","content":"import { useState, useEffect, useMemo } from 'react';\nimport { Link } from 'react-router-dom';\nimport { db, ref, set, get, onValue } from '../lib/firebase';\nimport { PhotoIcon, XMarkIcon, ClipboardDocumentIcon, CheckIcon, Cog6ToothIcon } from '@heroicons/react/24/solid';\nimport useEventConfig from '../hooks/useEventConfig';\nimport useTeamsDatabase from '../hooks/useTeamsDatabase';\nimport { getGraphicsForCompetition, getGraphicsByCategory } from '../lib/graphicsRegistry';\n\n// Category to section mapping for display\nconst CATEGORY_TO_SECTION = {\n  'pre-meet': 'Pre-Meet',\n  'in-meet': 'In-Meet',\n  'frame-overlays': 'Frame Overlays',\n  'stream': 'Stream',\n  'sponsors': 'Sponsors',\n};\n\n// Event button mapping for different genders (uses eventConfig IDs)\n// These map internal event IDs to display-friendly button configs\nconst eventButtonConfig = {\n  floor: { id: 'floor', label: 'Floor', title: 'FLOOR EXERCISE' },\n  pommel: { id: 'pommel', label: 'Pommel Horse', title: 'POMMEL HORSE' },\n  rings: { id: 'rings', label: 'Still Rings', title: 'STILL RINGS' },\n  vault: { id: 'vault', label: 'Vault', title: 'VAULT' },\n  pBars: { id: 'pbars', label: 'Parallel Bars', title: 'PARALLEL BARS' },\n  hBar: { id: 'hbar', label: 'High Bar', title: 'HORIZONTAL BAR' },\n  bars: { id: 'ubars', label: 'Uneven Bars', title: 'UNEVEN BARS' },\n  beam: { id: 'beam', label: 'Balance Beam', title: 'BALANCE BEAM' },\n};\n\n// Common event buttons that appear for all genders\nconst commonEventButtons = [\n  { id: 'allaround', label: 'All Around', title: 'ALL AROUND' },\n  { id: 'final', label: 'Final Scores', title: 'FINAL SCORES' },\n];\n\n// Leaderboard button mapping (uses short names for display)\nconst leaderboardButtonConfig = {\n  floor: { id: 'leaderboard-fx', label: 'FX Leaders', leaderboardEvent: 'fx' },\n  pommel: { id: 'leaderboard-ph', label: 'PH Leaders', leaderboardEvent: 'ph' },\n  rings: { id: 'leaderboard-sr', label: 'SR Leaders', leaderboardEvent: 'sr' },\n  vault: { id: 'leaderboard-vt', label: 'VT Leaders', leaderboardEvent: 'vt' },\n  pBars: { id: 'leaderboard-pb', label: 'PB Leaders', leaderboardEvent: 'pb' },\n  hBar: { id: 'leaderboard-hb', label: 'HB Leaders', leaderboardEvent: 'hb' },\n  bars: { id: 'leaderboard-ub', label: 'UB Leaders', leaderboardEvent: 'ub' },\n  beam: { id: 'leaderboard-bb', label: 'BB Leaders', leaderboardEvent: 'bb' },\n};\n\n// AA leaderboard is always available\nconst commonLeaderboardButtons = [\n  { id: 'leaderboard-aa', label: 'AA Leaders', leaderboardEvent: 'aa' },\n];\n\n// All possible event frame IDs (for both genders)\nconst eventFrames = ['floor', 'pommel', 'rings', 'vault', 'pbars', 'hbar', 'ubars', 'beam', 'allaround', 'final'];\n\nconst OUTPUT_BASE_URL = 'https://commentarygraphic.com/output.html';\nconst LOCAL_OUTPUT_URL = 'http://localhost:3003/output.html';\n\nconst teamCounts = {\n  'mens-dual': 2, 'womens-dual': 2,\n  'mens-tri': 3, 'womens-tri': 3,\n  'mens-quad': 4, 'womens-quad': 4,\n  'mens-5': 5, 'womens-5': 5,\n  'mens-6': 6, 'womens-6': 6,\n  'womens-7': 7\n};\n\n// Available themes for Event Summary\n// Layout themes (start with 'layout-') change the entire structure\n// Color themes just change colors of the default layout\nconst summaryThemes = [\n  // LAYOUTS - Different structural designs\n  { id: 'layout-broadcast-table', label: '🎴 Hero Cards', isLayout: true },\n  { id: 'layout-classic-broadcast', label: '📺 Classic Broadcast', isLayout: true },\n  { id: 'layout-default-v2', label: '✨ Default V2', isLayout: true },\n  { id: 'layout-default-v3', label: '📊 V3 Full Height', isLayout: true },\n  { id: 'layout-default-v4', label: '🏆 V4 Rankings', isLayout: true },\n  { id: 'layout-default-v5', label: '📦 V5 Compact', isLayout: true },\n  { id: 'layout-default-v6', label: '🃏 V6 Cards', isLayout: true },\n  { id: 'layout-default-v7', label: '📊 V7 Progress Bars', isLayout: true },\n  { id: 'layout-default-v8', label: '⬜ V8 Light Minimal', isLayout: true },\n  { id: 'layout-default-v9', label: '🔵 V9 Bold Blue', isLayout: true },\n  { id: 'layout-default-v10', label: '🔢 V10 Score Focus', isLayout: true },\n  { id: 'layout-default-v11', label: '📋 V11 Blue Accent', isLayout: true },\n  { id: 'layout-default-v12', label: '🌈 V12 Gradient Rows', isLayout: true },\n  { id: 'layout-default-v13', label: '🖼️ V13 Split Header', isLayout: true },\n  { id: 'layout-default-v14', label: '⬇️ V14 Big Footer', isLayout: true },\n  { id: 'layout-default-v15', label: '🔶 V15 Orange Badges', isLayout: true },\n  { id: 'layout-default-v16', label: '🟣 V16 Purple Theme', isLayout: true },\n  { id: 'layout-default-v17', label: '💚 V17 Green Scores', isLayout: true },\n  { id: 'layout-default-v18', label: '🎨 V18 Team Colors', isLayout: true },\n  { id: 'layout-default-v19', label: '📐 V19 Dense Compact', isLayout: true },\n  { id: 'layout-default-v20', label: '⭐ V20 Combined Best', isLayout: true },\n  { id: 'layout-default-v21', label: '📺 V21 Extra Large', isLayout: true },\n  { id: 'layout-default-v22', label: '🏅 V22 Integrated Rank', isLayout: true },\n  { id: 'layout-default-v23', label: '📋 V23 No Rankings', isLayout: true },\n  { id: 'layout-default-v24', label: '🎨 V24 Meet Theme', isLayout: true },\n  { id: 'layout-split-row', label: '📊 Split Row (5-team)', isLayout: true },\n  { id: 'layout-dual-dynamic-v1', label: '📏 Dual Dynamic V1', isLayout: true },\n  // COLOR THEMES - Same structure, different colors\n  { id: 'default', label: 'Default (Original)' },\n  { id: 'espn', label: 'ESPN Colors' },\n  { id: 'nbc', label: 'NBC Olympics' },\n  { id: 'btn', label: 'Big Ten' },\n  { id: 'pac12', label: 'Pac-12' },\n  { id: 'virtius', label: 'Virtius' },\n  { id: 'neon', label: 'Neon' },\n  { id: 'classic', label: 'Classic' },\n  { id: 'light', label: 'Light' },\n  { id: 'home', label: 'Team Colors' },\n  { id: 'gradient', label: 'Gradient' },\n];\n\n// Map Virtius event names to display names\nconst eventDisplayNames = {\n  'FLOOR': 'Floor Exercise',\n  'HORSE': 'Pommel Horse',\n  'RINGS': 'Still Rings',\n  'VAULT': 'Vault',\n  'PBARS': 'Parallel Bars',\n  'BAR': 'High Bar',\n};\n\nexport default function GraphicsControl({ competitionId }) {\n  const [currentGraphic, setCurrentGraphic] = useState(null);\n  const [currentGraphicId, setCurrentGraphicId] = useState(null); // Track the specific button ID (e.g., 'floor', 'pommel')\n  const [config, setConfig] = useState(null);\n  const [copied, setCopied] = useState(false);\n  const [copiedTheme, setCopiedTheme] = useState(false);\n  const [summaryTheme, setSummaryTheme] = useState('default');\n  const [liveAthletes, setLiveAthletes] = useState([]); // Athletes currently competing - now read from Firebase\n  const [scoreBugPolling, setScoreBugPolling] = useState(false); // Whether scoreBug overlay is polling\n\n  // Use competitionId directly from props (no local state needed)\n  const compId = competitionId || '';\n\n  // Get gender-specific event configuration\n  const { events, eventIds, rotationCount, gender } = useEventConfig(config?.compType);\n\n  // Get teams database for sponsor data\n  const { getTeamSponsors, resolveSchoolKey } = useTeamsDatabase();\n\n  // Build dynamic graphic buttons based on competition gender and team names\n  const graphicButtons = useMemo(() => {\n    const maxTeams = teamCounts[config?.compType] || 2;\n\n    // Build team names object from config\n    const teamNames = {};\n    for (let i = 1; i <= maxTeams; i++) {\n      teamNames[i] = config?.[`team${i}Name`] || `Team ${i}`;\n    }\n\n    // Get graphics from registry with dynamic labels\n    const registryGraphics = getGraphicsForCompetition(config?.compType, teamNames);\n\n    // Build base graphic buttons from registry (pre-meet, in-meet, frame-overlays, stream, sponsors)\n    const baseGraphicButtons = registryGraphics\n      .filter(g => ['pre-meet', 'in-meet', 'frame-overlays', 'stream', 'sponsors'].includes(g.category))\n      .map(g => ({\n        id: g.id,\n        label: g.label,\n        section: CATEGORY_TO_SECTION[g.category] || g.category,\n        team: g.team,\n      }));\n\n    // Build leaderboard buttons from gender-specific events\n    const leaderboardButtons = eventIds\n      .map(eventId => leaderboardButtonConfig[eventId])\n      .filter(Boolean)\n      .map(btn => ({ ...btn, section: 'Leaderboards' }));\n\n    return [\n      ...baseGraphicButtons,\n      ...leaderboardButtons,\n      ...commonLeaderboardButtons.map(btn => ({ ...btn, section: 'Leaderboards' })),\n    ];\n  }, [eventIds, config]);\n\n  // Build apparatus buttons for Event Summary (gender-specific)\n  const apparatusButtons = useMemo(() => {\n    return events.map(event => ({\n      id: event.shortName.toLowerCase(),\n      label: event.shortName,\n    }));\n  }, [events]);\n\n  // Load competition config\n  useEffect(() => {\n    if (!compId) return;\n\n    const configRef = ref(db, `competitions/${compId}/config`);\n    const unsubscribe = onValue(configRef, (snapshot) => {\n      setConfig(snapshot.val());\n    });\n\n    return () => unsubscribe();\n  }, [compId]);\n\n  // Listen for current graphic state\n  useEffect(() => {\n    if (!compId) return;\n\n    const graphicRef = ref(db, `competitions/${compId}/currentGraphic`);\n    const unsubscribe = onValue(graphicRef, (snapshot) => {\n      const data = snapshot.val();\n      if (data?.graphic === 'clear') {\n        setCurrentGraphic(null);\n        setCurrentGraphicId(null);\n      } else {\n        setCurrentGraphic(data?.graphic);\n        // For event-frame, extract the specific event from graphicId or frameTitle\n        setCurrentGraphicId(data?.graphicId || null);\n      }\n    });\n\n    return () => unsubscribe();\n  }, [compId]);\n\n  // Listen to Firebase for now-competing athletes (written by team-bug.html overlay)\n  useEffect(() => {\n    if (!compId) {\n      setLiveAthletes([]);\n      setScoreBugPolling(false);\n      return;\n    }\n\n    // Listen for detected now-competing athletes from scoreBug overlay\n    const nowCompetingRef = ref(db, `competitions/${compId}/scoreBug/detected/nowCompeting`);\n    const unsubscribeNowCompeting = onValue(nowCompetingRef, (snapshot) => {\n      const data = snapshot.val();\n      if (data && Array.isArray(data)) {\n        // Transform to match existing liveAthletes format\n        const athletes = data.map(entry => ({\n          id: entry.athlete?.id,\n          name: entry.athlete?.name,\n          team: entry.teamName,\n          teamTricode: entry.tricode,\n          event: entry.eventName,\n          eventDisplay: eventDisplayNames[entry.eventName] || entry.eventName,\n          order: entry.athlete?.order,\n        }));\n        setLiveAthletes(athletes);\n      } else {\n        setLiveAthletes([]);\n      }\n    });\n\n    // Listen for scoreBug polling state to show status indicator\n    const pollingRef = ref(db, `competitions/${compId}/scoreBug/config/polling`);\n    const unsubscribePolling = onValue(pollingRef, (snapshot) => {\n      setScoreBugPolling(snapshot.val() === true);\n    });\n\n    return () => {\n      unsubscribeNowCompeting();\n      unsubscribePolling();\n    };\n  }, [compId]);\n\n  const sendGraphic = async (graphicId, frameTitle = null, leaderboardEvent = null) => {\n    if (!compId || !config) return;\n\n    const data = {\n      eventName: config.eventName || '',\n      meetDate: config.meetDate || '',\n      venue: config.venue || '',\n      location: config.location || '',\n      hosts: config.hosts || '',\n      virtiusSessionId: config.virtiusSessionId || '',\n      // Team 1\n      team1Name: config.team1Name || '',\n      team1Logo: config.team1Logo || '',\n      team1Ave: config.team1Ave || '',\n      team1High: config.team1High || '',\n      team1Con: config.team1Con || '',\n      team1Coaches: config.team1Coaches || '',\n      // Team 2\n      team2Name: config.team2Name || '',\n      team2Logo: config.team2Logo || '',\n      team2Ave: config.team2Ave || '',\n      team2High: config.team2High || '',\n      team2Con: config.team2Con || '',\n      team2Coaches: config.team2Coaches || '',\n      // Team 3\n      team3Name: config.team3Name || '',\n      team3Logo: config.team3Logo || '',\n      team3Ave: config.team3Ave || '',\n      team3High: config.team3High || '',\n      team3Con: config.team3Con || '',\n      team3Coaches: config.team3Coaches || '',\n      // Team 4\n      team4Name: config.team4Name || '',\n      team4Logo: config.team4Logo || '',\n      team4Ave: config.team4Ave || '',\n      team4High: config.team4High || '',\n      team4Con: config.team4Con || '',\n      team4Coaches: config.team4Coaches || '',\n      // Team 5\n      team5Name: config.team5Name || '',\n      team5Logo: config.team5Logo || '',\n      team5Ave: config.team5Ave || '',\n      team5High: config.team5High || '',\n      team5Con: config.team5Con || '',\n      team5Coaches: config.team5Coaches || '',\n      // Team 6\n      team6Name: config.team6Name || '',\n      team6Logo: config.team6Logo || '',\n      team6Ave: config.team6Ave || '',\n      team6High: config.team6High || '',\n      team6Con: config.team6Con || '',\n      team6Coaches: config.team6Coaches || '',\n      // Team 7\n      team7Name: config.team7Name || '',\n      team7Logo: config.team7Logo || '',\n      team7Ave: config.team7Ave || '',\n      team7High: config.team7High || '',\n      team7Con: config.team7Con || '',\n      team7Coaches: config.team7Coaches || '',\n    };\n\n    if (frameTitle) {\n      data.frameTitle = frameTitle;\n    }\n\n    if (leaderboardEvent) {\n      data.leaderboardEvent = leaderboardEvent;\n      data.leaderboardGender = gender; // Pass gender for column visibility (women don't have Exec/SB)\n    }\n\n    // Handle sponsor graphics - check for event sponsors from theme first, then fall back to team sponsors\n    if (graphicId.startsWith('sponsors-')) {\n      let sponsorsFound = false;\n\n      // Check if competition has a theme with event sponsors\n      if (config.meetTheme) {\n        try {\n          const themeRef = ref(db, `themes/${config.meetTheme}/sponsors`);\n          const snapshot = await get(themeRef);\n          const eventSponsors = snapshot.val();\n          if (eventSponsors && Array.isArray(eventSponsors) && eventSponsors.length > 0) {\n            // Use event sponsors from theme\n            data.sponsors = JSON.stringify(eventSponsors.slice(0, 8).map(s => ({\n              name: s.name || '',\n              url: s.url || ''\n            })));\n            sponsorsFound = true;\n          }\n        } catch (err) {\n          console.error('Error fetching theme sponsors:', err);\n        }\n      }\n\n      // Fallback to team sponsors if no event sponsors\n      if (!sponsorsFound) {\n        // Resolve home team key from team name (includes gender suffix)\n        const schoolKey = resolveSchoolKey(config.team1Name);\n        // Add gender suffix to get full team key (e.g., \"west-chester\" -> \"west-chester-womens\")\n        const homeTeamKey = schoolKey ? `${schoolKey}-${gender}` : null;\n        if (homeTeamKey) {\n          const teamSponsors = getTeamSponsors(homeTeamKey);\n          // Convert to JSON for the overlay\n          data.sponsors = JSON.stringify(teamSponsors.slice(0, 8).map(s => ({\n            name: s.name,\n            url: s.url\n          })));\n        } else {\n          data.sponsors = '[]';\n        }\n      }\n    }\n\n    // Determine graphic type\n    let graphicType = graphicId;\n    if (eventFrames.includes(graphicId)) {\n      graphicType = 'event-frame';\n    } else if (graphicId.startsWith('leaderboard-')) {\n      graphicType = 'virtius-leaderboard';\n    } else if (graphicId.match(/^team\\d+-roster$/)) {\n      graphicType = 'team-roster';\n    }\n\n    // Include graphicId in data for renderers that need it\n    data.graphicId = graphicId;\n\n    set(ref(db, `competitions/${compId}/currentGraphic`), {\n      graphic: graphicType,\n      graphicId: graphicId, // Store the specific button ID for highlighting\n      data: data,\n      timestamp: Date.now()\n    });\n  };\n\n  // Send event summary graphic - can be rotation-based (R1-R4/R1-R6) or apparatus-based (gender-specific events)\n  const sendEventSummary = (mode, value) => {\n    if (!compId || !config) return;\n\n    const maxTeams = teamCounts[config.compType] || 2;\n\n    // Dual meets use alternating format for rotation-based view\n    // (home team on one event, away team on adjacent event, swapping each rotation)\n    const isDual = config.compType?.includes('dual');\n\n    let graphicId, data;\n\n    if (mode === 'rotation') {\n      // Rotation mode: for dual meets, use alternating format (teams on different events)\n      // Men's: R1: Home=FX, Away=PH | R2: swap | R3: Home=SR, Away=VT | etc.\n      // Women's: R1: Home=VT, Away=UB | R2: swap | R3: Home=BB, Away=FX | R4: swap\n      // For multi-team meets (tri, quad), each team is on a different event per rotation\n      graphicId = `summary-r${value}`;\n      data = {\n        virtiusSessionId: config.virtiusSessionId || '',\n        summaryMode: 'rotation',\n        summaryRotation: value,\n        summaryNumTeams: maxTeams,\n        summaryFormat: isDual ? 'alternating' : 'rotation', // 'alternating' for dual, 'rotation' for multi-team\n        summaryTheme: summaryTheme,\n        summaryGender: gender, // Gender for determining correct events\n        team1Logo: config.team1Logo || '',\n        team1Name: config.team1Name || '',\n        team2Name: config.team2Name || '',\n      };\n    } else {\n      // Apparatus mode: show both teams' scores for the same event (head-to-head view)\n      graphicId = `summary-${value}`;\n      data = {\n        virtiusSessionId: config.virtiusSessionId || '',\n        summaryMode: 'apparatus',\n        summaryApparatus: value, // e.g., 'fx', 'ph', 'sr', 'vt', 'pb', 'hb', 'ub', 'bb'\n        summaryNumTeams: maxTeams,\n        summaryFormat: 'head-to-head', // Always head-to-head for apparatus mode\n        summaryTheme: summaryTheme,\n        summaryGender: gender, // Gender for determining correct events\n        team1Logo: config.team1Logo || '',\n        team1Name: config.team1Name || '',\n        team2Name: config.team2Name || '',\n      };\n    }\n\n    set(ref(db, `competitions/${compId}/currentGraphic`), {\n      graphic: 'event-summary',\n      graphicId: graphicId,\n      data: data,\n      timestamp: Date.now()\n    });\n  };\n\n  const clearGraphic = () => {\n    if (!compId) return;\n\n    set(ref(db, `competitions/${compId}/currentGraphic`), {\n      graphic: 'clear',\n      data: {},\n      timestamp: Date.now()\n    });\n  };\n\n  // Send \"Now Competing\" graphic for a specific athlete\n  const sendNowCompeting = (athlete) => {\n    if (!compId || !config) return;\n\n    // Find the team logo based on the athlete's team\n    let athleteLogo = config.team1Logo || '';\n    for (let i = 1; i <= 6; i++) {\n      if (config[`team${i}Name`] === athlete.team ||\n          config[`team${i}Tricode`]?.toUpperCase() === athlete.teamTricode?.toUpperCase()) {\n        athleteLogo = config[`team${i}Logo`] || '';\n        break;\n      }\n    }\n\n    set(ref(db, `competitions/${compId}/currentGraphic`), {\n      graphic: 'now-competing',\n      graphicId: `now-competing-${athlete.id}`,\n      data: {\n        athleteName: athlete.name,\n        athleteTeam: athlete.team,\n        athleteEvent: athlete.eventDisplay,\n        athleteLogo: athleteLogo,\n        team1Logo: config.team1Logo || '',\n      },\n      timestamp: Date.now()\n    });\n  };\n\n  const sections = ['Pre-Meet', 'In-Meet', 'Frame Overlays', 'Leaderboards', 'Stream', 'Sponsors'];\n\n  const outputUrl = compId ? `${OUTPUT_BASE_URL}?comp=${compId}` : '';\n  const localOutputUrl = compId ? `${LOCAL_OUTPUT_URL}?comp=${compId}` : '';\n\n  const copyOutputUrl = () => {\n    if (!outputUrl) return;\n    navigator.clipboard.writeText(outputUrl);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const themeOutputUrl = compId && config?.meetTheme ? `${OUTPUT_BASE_URL}?comp=${compId}&meetTheme=${config.meetTheme}` : '';\n\n  const copyThemeUrl = () => {\n    if (!themeOutputUrl) return;\n    navigator.clipboard.writeText(themeOutputUrl);\n    setCopiedTheme(true);\n    setTimeout(() => setCopiedTheme(false), 2000);\n  };\n\n  return (\n    <div className=\"bg-zinc-800 rounded-xl p-4\">\n      <div className=\"flex items-center justify-between mb-3\">\n        <div className=\"flex items-center gap-2 text-sm text-zinc-400 uppercase tracking-wide\">\n          <PhotoIcon className=\"w-4 h-4\" />\n          Web Graphics\n        </div>\n        {currentGraphic && (\n          <span className=\"text-xs bg-blue-500/20 text-blue-400 px-2 py-1 rounded\">\n            {currentGraphic}\n          </span>\n        )}\n      </div>\n\n      {/* Copy Output URL & URL Generator */}\n      {compId && (\n        <div className=\"mb-4 space-y-2\">\n          <button\n            onClick={copyOutputUrl}\n            className={`w-full flex items-center justify-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition-colors ${\n              copied\n                ? 'bg-green-600 text-white'\n                : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-300'\n            }`}\n          >\n            {copied ? (\n              <>\n                <CheckIcon className=\"w-4 h-4\" />\n                Copied!\n              </>\n            ) : (\n              <>\n                <ClipboardDocumentIcon className=\"w-4 h-4\" />\n                Copy Output URL\n              </>\n            )}\n          </button>\n          {config?.meetTheme && (\n            <button\n              onClick={copyThemeUrl}\n              className={`w-full flex items-center justify-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition-colors ${\n                copiedTheme\n                  ? 'bg-green-600 text-white'\n                  : 'bg-purple-700 hover:bg-purple-600 text-zinc-100'\n              }`}\n            >\n              {copiedTheme ? (\n                <>\n                  <CheckIcon className=\"w-4 h-4\" />\n                  Copied!\n                </>\n              ) : (\n                <>\n                  <ClipboardDocumentIcon className=\"w-4 h-4\" />\n                  Copy Theme URL\n                </>\n              )}\n            </button>\n          )}\n          <a\n            href={localOutputUrl}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"w-full flex items-center justify-center gap-2 px-3 py-2 bg-amber-700 hover:bg-amber-600 text-zinc-100 rounded-lg text-sm font-medium transition-colors\"\n          >\n            Local Output\n          </a>\n          <Link\n            to={`/url-generator?comp=${compId}`}\n            className=\"w-full flex items-center justify-center gap-2 px-3 py-2 bg-zinc-700 hover:bg-zinc-600 text-zinc-300 rounded-lg text-sm font-medium transition-colors\"\n          >\n            <Cog6ToothIcon className=\"w-4 h-4\" />\n            URL Generator\n          </Link>\n        </div>\n      )}\n\n      {compId && config ? (\n        <>\n          {/* Graphic Buttons by Section */}\n          {sections.map((section) => {\n            // Get max teams for this competition type\n            const maxTeams = teamCounts[config.compType] || 2;\n\n            // Filter buttons by section and team count\n            const sectionButtons = graphicButtons.filter((btn) => {\n              if (btn.section !== section) return false;\n              // If button has a team number, only show if within max teams\n              if (btn.team && btn.team > maxTeams) return false;\n              return true;\n            });\n\n            return (\n              <div key={section} className=\"mb-4\">\n                <div className=\"text-xs text-zinc-500 uppercase mb-2\">{section}</div>\n                <div className=\"grid grid-cols-3 gap-1.5\">\n                  {sectionButtons.map((btn) => (\n                    <button\n                      key={btn.id}\n                      onClick={() => sendGraphic(btn.id, btn.title, btn.leaderboardEvent)}\n                      className={`px-2 py-2 rounded text-xs font-medium transition-colors ${\n                        currentGraphicId === btn.id\n                          ? 'bg-blue-600 text-white'\n                          : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-300'\n                      }`}\n                    >\n                      {btn.label}\n                    </button>\n                  ))}\n                </div>\n              </div>\n            );\n          })}\n\n          {/* Event Summary Section - Rotation and Apparatus buttons */}\n          {config.virtiusSessionId && (\n            <div className=\"mb-4\">\n              <div className=\"flex items-center justify-between mb-2\">\n                <div className=\"text-xs text-zinc-500 uppercase\">Event Summary</div>\n                <select\n                  value={summaryTheme}\n                  onChange={(e) => setSummaryTheme(e.target.value)}\n                  className=\"text-xs bg-zinc-700 text-zinc-300 border border-zinc-600 rounded px-2 py-1 focus:outline-none focus:border-blue-500\"\n                >\n                  {summaryThemes.map((theme) => (\n                    <option key={theme.id} value={theme.id}>{theme.label}</option>\n                  ))}\n                </select>\n              </div>\n              {/* Rotation buttons - dynamic based on gender (R1-R6 for mens, R1-R4 for womens) */}\n              <div className=\"text-xs text-zinc-600 mb-1\">By Rotation (Alternating)</div>\n              <div className={`grid gap-1.5 mb-2 ${rotationCount === 4 ? 'grid-cols-4' : 'grid-cols-6'}`}>\n                {Array.from({ length: rotationCount }, (_, i) => i + 1).map((rotation) => {\n                  const graphicId = `summary-r${rotation}`;\n                  return (\n                    <button\n                      key={rotation}\n                      onClick={() => sendEventSummary('rotation', rotation)}\n                      className={`px-2 py-2 rounded text-xs font-medium transition-colors ${\n                        currentGraphicId === graphicId\n                          ? 'bg-blue-600 text-white'\n                          : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-300'\n                      }`}\n                    >\n                      R{rotation}\n                    </button>\n                  );\n                })}\n              </div>\n              {/* Apparatus buttons - dynamic based on gender */}\n              <div className=\"text-xs text-zinc-600 mb-1\">By Apparatus</div>\n              <div className={`grid gap-1.5 ${apparatusButtons.length === 4 ? 'grid-cols-4' : 'grid-cols-6'}`}>\n                {apparatusButtons.map((apparatus) => {\n                  const graphicId = `summary-${apparatus.id}`;\n                  return (\n                    <button\n                      key={apparatus.id}\n                      onClick={() => sendEventSummary('apparatus', apparatus.id)}\n                      className={`px-2 py-2 rounded text-xs font-medium transition-colors ${\n                        currentGraphicId === graphicId\n                          ? 'bg-blue-600 text-white'\n                          : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-300'\n                      }`}\n                    >\n                      {apparatus.label}\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n          )}\n\n          {/* Now Competing Section - Live athletes from Firebase (via team-bug overlay) */}\n          {config.virtiusSessionId && (\n            <div className=\"mb-4\">\n              <div className=\"flex items-center justify-between mb-2\">\n                <div className=\"text-xs text-zinc-500 uppercase\">Now Competing</div>\n                <span\n                  className={`text-xs px-2 py-1 rounded font-medium ${\n                    scoreBugPolling\n                      ? 'bg-green-600 text-white'\n                      : 'bg-zinc-700 text-zinc-400'\n                  }`}\n                >\n                  {scoreBugPolling ? 'Live' : 'Polling Off'}\n                </span>\n              </div>\n              {scoreBugPolling ? (\n                liveAthletes.length > 0 ? (\n                  <div className=\"space-y-1.5\">\n                    {liveAthletes.map((athlete) => (\n                      <button\n                        key={athlete.id}\n                        onClick={() => sendNowCompeting(athlete)}\n                        className={`w-full text-left px-3 py-2 rounded text-xs transition-colors ${\n                          currentGraphicId === `now-competing-${athlete.id}`\n                            ? 'bg-green-600 text-white'\n                            : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-300'\n                        }`}\n                      >\n                        <div className=\"flex items-center justify-between\">\n                          <div>\n                            <span className=\"font-semibold\">{athlete.name}</span>\n                            <span className=\"text-zinc-400 ml-2\">({athlete.teamTricode || athlete.team})</span>\n                          </div>\n                          <span className=\"text-zinc-400\">{athlete.eventDisplay}</span>\n                        </div>\n                      </button>\n                    ))}\n                  </div>\n                ) : (\n                  <div className=\"text-xs text-zinc-500 text-center py-3 bg-zinc-700/50 rounded\">\n                    No athletes currently competing\n                  </div>\n                )\n              ) : (\n                <div className=\"text-xs text-zinc-500 text-center py-3 bg-zinc-700/50 rounded\">\n                  Enable polling in Score Bug panel\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* Clear Button */}\n          <button\n            onClick={clearGraphic}\n            className=\"w-full flex items-center justify-center gap-2 px-4 py-3 bg-red-600 hover:bg-red-500 text-white font-bold rounded-lg transition-colors\"\n          >\n            <XMarkIcon className=\"w-5 h-5\" />\n            Clear Graphic\n          </button>\n        </>\n      ) : (\n        <div className=\"text-zinc-500 text-sm text-center py-4\">\n          {compId ? 'Loading config...' : 'Select a competition to control graphics'}\n        </div>\n      )}\n    </div>\n  );\n}\n","numLines":748,"startLine":1,"totalLines":748}}}
