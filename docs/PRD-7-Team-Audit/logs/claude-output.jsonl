   'rotation-slate': (data) => {","+        const logo = encodeURIComponent(data.team1Logo || '');","+        const meetName = encodeURIComponent(data.eventName || 'GYMNASTICS');","+        const rotation = data.rotation || '1';","+        const meetTheme = data.meetTheme ? `&meetTheme=${encodeURIComponent(data.meetTheme)}` : '';","+        const overlayUrl = `/overlays/rotation-slate.html?logo=${logo}&meetName=${meetName}&rotation=${rotation}${meetTheme}`;","+        return `<iframe src=\"${overlayUrl}\" style=\"width: 1920px; height: 1080px; border: none; overflow: hidden;\"></iframe>`;","+      },","+","       // Frame Overlays for OBS","       'frame-quad': () => `","         <div class=\"graphic-frame-overlay frame-quad\">"]}],"userModified":false,"replaceAll":false}}
