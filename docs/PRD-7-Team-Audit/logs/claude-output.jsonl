artValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-left\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${eventDisplayName}</div>\n              </div>\n              <div class=\"header-right\">\n                <div class=\"rank-badge${rankClass}\">${rank}</div>\n                <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-v24 teams-${numTeams}\">${columnsHtml}</div>`;\n    }\n\n    function renderMultiTeamSummarySplitRow(contentEl, rotationData, rotation, numTeams, apparatusRankings = {}) {\n      // Split Row Layout: 3 teams on top row, 2 teams on bottom row (centered)\n      // Provides more horizontal space per team for 5-team competitions\n      // No rankings shown in this layout for cleaner appearance\n      const maxAthletes = Math.min(\n        Math.max(...rotationData.map(t => t.gymnasts.length)),\n        6 // Limit to 6 athletes per team for split row to fit better\n      );\n\n      let columnsHtml = '';\n\n      rotationData.forEach((teamData, teamIndex) => {\n        const { team, eventName, eventDisplayName, gymnasts, eventScore, totalScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n\n        // Build athlete rows (no rankings)\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n\n            // Get start value (difficulty score)\n            const startValue = g.scores && g.scores.length > 0\n              ? parseFloat(g.scores[0].start) || 0\n              : 0;\n\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                <div class=\"athlete-sv\">${startValue > 0 ? startValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-left\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${eventDisplayName}</div>\n              </div>\n              <div class=\"header-right\">\n                <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-split-row\">${columnsHtml}</div>`;\n    }\n\n    function renderMultiTeamSummaryApparatusSplitRow(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams, apparatusRankings = {}) {\n      // Split Row Layout for apparatus view: 3 teams on top, 2 on bottom\n      const maxAthletes = Math.min(\n        Math.max(...apparatusData.map(t => t.gymnasts.length)),\n        6\n      );\n\n      // Calculate ranks based on eventScore (apparatus total)\n      const rankedTeams = apparatusData\n        .map((t, idx) => ({ idx, score: t.eventScore || 0 }))\n        .sort((a, b) => b.score - a.score);\n\n      // Helper to check if athlete is in top 3 for this apparatus across entire meet\n      function getAthleteApparatusRank(gymnastId, score) {\n        const rankings = apparatusRankings[eventShortCode?.toUpperCase()] || [];\n        const found = rankings.find(r => r.gymnastId === gymnastId || r.score === score);\n        return found ? found.rank : null;\n      }\n\n      let columnsHtml = '';\n\n      apparatusData.forEach((teamData, teamIndex) => {\n        const { team, gymnasts, eventScore, totalScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n\n        // Get rank for this team on this apparatus\n        const rank = rankedTeams.findIndex(t => t.idx === teamIndex) + 1;\n        const rankClass = rank <= 3 ? ` rank-${rank}` : '';\n\n        // Build athlete rows\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n\n            const startValue = g.scores && g.scores.length > 0\n              ? parseFloat(g.scores[0].start) || 0\n              : 0;\n\n            const athleteRank = score > 0 ? getAthleteApparatusRank(g.gymnast_id, score) : null;\n            const athleteRankHtml = athleteRank && athleteRank <= 3\n              ? `<div class=\"athlete-rank rank-${athleteRank}\">${athleteRank}</div>`\n              : '';\n\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                ${athleteRankHtml}\n                <div class=\"athlete-sv\">${startValue > 0 ? startValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div