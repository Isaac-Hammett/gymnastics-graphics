{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SWbwpjXKcrDhn33WTQdhZ7","type":"tool_result","content":"   680→    </div>\n   681→  );\n   682→}\n   683→\n   684→function SponsorsView({ teamKey, getTeamSponsors, saveSponsor, deleteSponsor, reorderSponsors }) {\n   685→  const [newName, setNewName] = useState('');\n   686→  const [newUrl, setNewUrl] = useState('');\n   687→  const [newTier, setNewTier] = useState('official');\n   688→  const [error, setError] = useState(null);\n   689→  const [saving, setSaving] = useState(false);\n   690→  const [logoError, setLogoError] = useState(false);\n   691→\n   692→  const sponsors = getTeamSponsors(teamKey);\n   693→\n   694→  // Convert name to URL-safe key\n   695→  const slugify = (name) => {\n   696→    return name\n   697→      .toLowerCase()\n   698→      .replace(/[^a-z0-9]+/g, '-')\n   699→      .replace(/^-|-$/g, '');\n   700→  };\n   701→\n   702→  const handleAdd = async () => {\n   703→    if (!newName.trim() || !newUrl.trim()) return;\n   704→\n   705→    const sponsorKey = slugify(newName.trim());\n   706→\n   707→    // Check for duplicate\n   708→    if (sponsors.some(s => s.key === sponsorKey)) {\n   709→      setError(`A sponsor named '${newName.trim()}' already exists for this team`);\n   710→      return;\n   711→    }\n   712→\n   713→    setSaving(true);\n   714→    setError(null);\n   715→\n   716→    const result = await saveSponsor(teamKey, sponsorKey, {\n   717→      name: newName.trim(),\n   718→      url: newUrl.trim(),\n   719→      tier: newTier,\n   720→      order: sponsors.length,\n   721→    });\n   722→\n   723→    setSaving(false);\n   724→\n   725→    if (result.success) {\n   726→      setNewName('');\n   727→      setNewUrl('');\n   728→      setNewTier('official');\n   729→      setLogoError(false);\n   730→    } else {\n   731→      setError(result.error);\n   732→    }\n   733→  };\n   734→\n   735→  const handleDelete = async (sponsorKey) => {\n   736→    await deleteSponsor(teamKey, sponsorKey);\n   737→  };\n   738→\n   739→  const handleMove = async (index, direction) => {\n   740→    const newIndex = index + direction;\n   741→    if (newIndex < 0 || newIndex >= sponsors.length) return;\n   742→\n   743→    const newOrder = [...sponsors];\n   744→    const [moved] = newOrder.splice(index, 1);\n   745→    newOrder.splice(newIndex, 0, moved);\n   746→\n   747→    const orderedKeys = newOrder.map(s => s.key);\n   748→    await reorderSponsors(teamKey, orderedKeys);\n   749→  };\n   750→\n   751→  const tierColors = {\n   752→    presenting: 'bg-purple-600/20 text-purple-400',\n   753→    official: 'bg-blue-600/20 text-blue-400',\n   754→    supporting: 'bg-zinc-600/20 text-zinc-400',\n   755→  };\n   756→\n   757→  return (\n   758→    <div className=\"p-4 border-t border-zinc-700\">\n   759→      {/* Section Header */}\n   760→      <div className=\"flex items-center gap-2 mb-3\">\n   761→        <SparklesIcon className=\"w-4 h-4 text-amber-400\" />\n   762→        <span className=\"text-sm font-medium text-zinc-300\">Sponsors ({sponsors.length})</span>\n   763→      </div>\n   764→\n   765→      {/* Sponsor List */}\n   766→      {sponsors.length > 0 ? (\n   767→        <div className=\"space-y-2 mb-4\">\n   768→          {sponsors.map((sponsor, idx) => (\n   769→            <div\n   770→              key={sponsor.key}\n   771→              className=\"flex items-center gap-3 p-2 bg-zinc-700/50 rounded\"\n   772→            >\n   773→              {/* Logo thumbnail */}\n   774→              <div className=\"w-12 h-12 bg-zinc-600 rounded flex items-center justify-center overflow-hidden flex-shrink-0\">\n   775→                <img\n   776→                  src={sponsor.url}\n   777→                  alt={sponsor.name}\n   778→                  className=\"w-12 h-12 object-contain\"\n   779→                  onError={(e) => {\n   780→                    e.target.style.display = 'none';\n   781→                    e.target.nextSibling.style.display = 'flex';\n   782→                  }}\n   783→                />\n   784→                <div className=\"w-12 h-12 items-center justify-center text-zinc-500 text-xs hidden\">\n   785→                  No img\n   786→                </div>\n   787→              </div>\n   788→\n   789→              {/* Name */}\n   790→              <span className=\"text-sm text-zinc-200 flex-1 truncate\">{sponsor.name}</span>\n   791→\n   792→              {/* Tier badge */}\n   793→              <span className={`px-2 py-0.5 rounded text-xs font-medium ${tierColors[sponsor.tier] || tierColors.official}`}>\n   794→                {sponsor.tier}\n   795→              </span>\n   796→\n   797→              {/* URL (truncated) */}\n   798→              {sponsor.url ? (\n   799→                <a\n   800→                  href={sponsor.url}\n   801→                  target=\"_blank\"\n   802→                  rel=\"noopener noreferrer\"\n   803→                  className=\"text-xs text-zinc-500 hover:text-zinc-300 truncate max-w-[120px]\"\n   804→                  title={sponsor.url}\n   805→                >\n   806→                  {sponsor.url.replace(/^https?:\\/\\//, '').slice(0, 20)}...\n   807→                </a>\n   808→              ) : (\n   809→                <span className=\"text-xs text-zinc-600\">No URL</span>\n   810→              )}\n   811→\n   812→              {/* Reorder buttons */}\n   813→              <button\n   814→                onClick={() => handleMove(idx, -1)}\n   815→                disabled={idx === 0}\n   816→                className=\"p-1 text-zinc-500 hover:text-zinc-300 disabled:opacity-30\"\n   817→                title=\"Move up\"\n   818→              >\n   819→                <ArrowUpIcon className=\"w-4 h-4\" />\n   820→              </button>\n   821→              <button\n   822→                onClick={() => handleMove(idx, 1)}\n   823→                disabled={idx === sponsors.length - 1}\n   824→ 