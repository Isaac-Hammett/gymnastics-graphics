  .sponsor-logo {\n      max-width: 600px;\n      max-height: 500px;\n      object-fit: contain;\n    }\n\n    .sponsor-name {\n      font-size: 36px;\n      font-weight: 700;\n      color: #000;\n      text-align: center;\n      max-width: 800px;\n    }\n\n    .sponsor-fallback {\n      width: 600px;\n      height: 400px;\n      background: #E5E5E5;\n      border-radius: 24px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 32px;\n    }\n\n    .sponsor-fallback-text {\n      font-size: 48px;\n      font-weight: 700;\n      color: #666;\n      text-align: center;\n      word-wrap: break-word;\n    }\n\n    .no-sponsors-message {\n      font-size: 36px;\n      font-weight: 700;\n      color: #666;\n      text-align: center;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"header-bar\">\n    <div class=\"header-title\">OUR SPONSORS</div>\n    <img id=\"headerLogo\" class=\"header-logo\" src=\"\" alt=\"Team Logo\">\n  </div>\n  <div id=\"sponsorDisplay\" class=\"sponsor-display\"></div>\n\n  <script>\n    const params = new URLSearchParams(window.location.search);\n    const logoUrl = params.get('logo') || '';\n    const sponsorsParam = params.get('sponsors') || '';\n\n    // Handle header logo\n    const headerLogo = document.getElementById('headerLogo');\n    if (logoUrl) {\n      headerLogo.src = logoUrl;\n      headerLogo.onerror = () => {\n        headerLogo.style.display = 'none';\n      };\n    } else {\n      headerLogo.style.display = 'none';\n    }\n\n    // Parse sponsors\n    let sponsors = [];\n    if (sponsorsParam) {\n      try {\n        sponsors = JSON.parse(sponsorsParam);\n        if (!Array.isArray(sponsors)) {\n          sponsors = [];\n        }\n      } catch (e) {\n        sponsors = [];\n      }\n    }\n\n    const display = document.getElementById('sponsorDisplay');\n    let currentIndex = 0;\n    let brokenCount = 0;\n    let textOnlyMode = false;\n    let slides = [];\n    let cycleInterval = null;\n\n    // Show message if no sponsors\n    if (sponsors.length === 0) {\n      display.innerHTML = '<div class=\"no-sponsors-message\">No sponsors configured</div>';\n    } else {\n      // Create slide for each sponsor\n      sponsors.forEach((sponsor, index) => {\n        const slide = document.createElement('div');\n        slide.className = 'sponsor-slide';\n        slide.dataset.index = index;\n\n        const name = sponsor.name || 'Sponsor';\n        const url = sponsor.url || '';\n\n        if (url) {\n          const img = document.createElement('img');\n          img.className = 'sponsor-logo';\n          img.src = url;\n          img.alt = name;\n          img.dataset.index = index;\n          img.onerror = () => {\n            brokenCount++;\n            // Check if ALL logos are broken\n            if (brokenCount >= sponsors.length) {\n              switchToTextOnlyMode();\n            } else if (slide.classList.contains('active')) {\n              // This was the active slide - skip to next immediately\n              advanceToNext();\n            }\n            // Mark this slide as broken\n            slide.dataset.broken = 'true';\n          };\n          slide.appendChild(img);\n        } else {\n          // No URL provided - show fallback\n          const fallback = document.createElement('div');\n          fallback.className = 'sponsor-fallback';\n          const fallbackText = document.createElement('div');\n          fallbackText.className = 'sponsor-fallback-text';\n          fallbackText.textContent = name;\n          fallback.appendChild(fallbackText);\n          slide.appendChild(fallback);\n        }\n\n        const nameEl = document.createElement('div');\n        nameEl.className = 'sponsor-name';\n        nameEl.textContent = name;\n        slide.appendChild(nameEl);\n\n        display.appendChild(slide);\n        slides.push(slide);\n      });\n\n      // Show first slide\n      showSlide(0);\n\n      // Only start cycling if more than 1 sponsor\n      if (sponsors.length > 1) {\n        cycleInterval = setInterval(advanceToNext, 3000);\n      }\n    }\n\n    function showSlide(index) {\n      // Skip broken slides unless we're in text-only mode\n      if (!textOnlyMode && slides[index].dataset.broken === 'true') {\n        currentIndex = (index + 1) % slides.length;\n        showSlide(currentIndex);\n        return;\n      }\n\n      slides.forEach((slide, i) => {\n        if (i === index) {\n          slide.classList.add('active');\n        } else {\n          slide.classList.remove('active');\n        }\n      });\n      currentIndex = index;\n    }\n\n    function advanceToNext() {\n      let nextIndex = (currentIndex + 1) % slides.length;\n      let attempts = 0;\n\n      // Find next non-broken slide (unless text-only mode)\n      while (!textOnlyMode && slides[nextIndex].dataset.broken === 'true' && attempts < slides.length) {\n        nextIndex = (nextIndex + 1) % slides.length;\n        attempts++;\n      }\n\n      // If all slides are broken, we'll switch to text-only mode\n      if (attempts >= slides.length) {\n        switchToTextOnlyMode();\n        return;\n      }\n\n      showSlide(nextIndex);\n    }\n\n    function switchToTextOnlyMode() {\n      textOnlyMode = true;\n\n      // Rebuild slides with text-only fallbacks\n      slides.forEach((slide, index) => {\n        const name = sponsors[index].name || 'Sponsor';\n        slide.innerHTML = '';\n        slide.dataset.broken = 'false';\n\n        const fallback = document.createElement('div');\n        fallback.className = 'sponsor-fallback';\n        const fallbackText = document.createElement('div');\n        fallbackText.className = 'sponsor-fallback-text';\n        fallbackText.textContent = name;\n        fallback.appendChild(fallbackText);\n        slide.appendChild(fallback);\n\n        const nameEl = document.createElement('div');\n        nameEl.className = 'sponsor-name';\n        nameEl.textContent = name;\n        slide.appendChild(nameEl);\n      });\n\n      // Resume from current position\n      showSlide(currentIndex);\n    }\n  </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
