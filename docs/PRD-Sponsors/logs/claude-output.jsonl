oBounds.x},${autoBounds.y} ${autoBounds.w}×${autoBounds.h}`;\n   339→        boundsDiv.appendChild(boundsLabel);\n   340→        slide.appendChild(boundsDiv);\n   341→      }\n   342→    }\n   343→\n   344→    if (sponsors.length === 0) {\n   345→      container.innerHTML = '<div class=\"no-sponsors-message\">No sponsors configured</div>';\n   346→    } else {\n   347→      sponsors.forEach((sponsor, idx) => {\n   348→        const url = sponsor.url || '';\n   349→        if (!url) return;\n   350→\n   351→        // If locked to a specific index, skip others\n   352→        if (lockedIndex >= 0 && idx !== lockedIndex) {\n   353→          slides.push(null); // placeholder to keep indices aligned\n   354→          return;\n   355→        }\n   356→\n   357→        const slide = document.createElement('div');\n   358→        slide.className = 'sponsor-slide';\n   359→        slide.style.position = 'relative'; // for bounds overlay positioning\n   360→\n   361→        const img = new Image();\n   362→        img.crossOrigin = 'anonymous';\n   363→        img.onload = () => {\n   364→          const { canvas, autoBounds, usedBounds } = renderTrimmedLogo(img, sponsor);\n   365→          applyOverrides(canvas, sponsor);\n   366→          slide.appendChild(canvas);\n   367→          if (showBounds) {\n   368→            drawBoundsOverlay(slide, canvas, autoBounds, usedBounds, sponsor);\n   369→          }\n   370→        };\n   371→        img.onerror = () => {\n   372→          // Try without CORS (won't trim but will display)\n   373→          const fallback = new Image();\n   374→          fallback.onload = () => {\n   375→            const { canvas, autoBounds, usedBounds } = renderTrimmedLogo(fallback, sponsor);\n   376→            applyOverrides(canvas, sponsor);\n   377→            slide.appendChild(canvas);\n   378→            if (showBounds) {\n   379→              drawBoundsOverlay(slide, canvas, autoBounds, usedBounds, sponsor);\n   380→            }\n   381→   