dth: 1600px;\n      max-height: 950px;\n    }\n\n    .no-sponsors-message {\n      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n      font-size: 48px;\n      font-weight: 600;\n      color: #999;\n      text-align: center;\n    }\n\n    /* Bounding box overlay for debugging */\n    .bounds-overlay {\n      position: absolute;\n      border: 3px dashed #ff00ff;\n      pointer-events: none;\n      z-index: 10;\n    }\n    .bounds-label {\n      position: absolute;\n      top: -24px;\n      left: 0;\n      font-family: monospace;\n      font-size: 14px;\n      color: #ff00ff;\n      background: rgba(0,0,0,0.7);\n      padding: 2px 6px;\n      border-radius: 3px;\n      white-space: nowrap;\n    }\n    .crop-overlay {\n      position: absolute;\n      border: 3px solid #00ff00;\n      pointer-events: none;\n      z-index: 11;\n    }\n    .crop-label {\n      position: absolute;\n      bottom: -24px;\n      left: 0;\n      font-family: monospace;\n      font-size: 14px;\n      color: #00ff00;\n      background: rgba(0,0,0,0.7);\n      padding: 2px 6px;\n      border-radius: 3px;\n      white-space: nowrap;\n    }\n    /* Guide overlays: center lines + safe margins */\n    #guides-overlay {\n      position: absolute;\n      top: 0; left: 0;\n      width: 1920px;\n      height: 1080px;\n      pointer-events: none;\n      z-index: 20;\n      display: none;\n    }\n    #guides-overlay.visible { display: block; }\n\n    /* Center crosshair lines */\n    .guide-center-h, .guide-center-v {\n      position: absolute;\n      background: rgba(255, 255, 0, 0.4);\n    }\n    .guide-center-h {\n      top: 540px; left: 0;\n      width: 1920px; height: 1px;\n    }\n    .guide-center-v {\n      top: 0; left: 960px;\n      width: 1px; height: 1080px;\n    }\n    /* Center crosshair dot */\n    .guide-center-dot {\n      position: absolute;\n      top: 536px; left: 956px;\n      width: 8px; height: 8px;\n      border-radius: 50%;\n      background: rgba(255, 255, 0, 0.6);\n    }\n\n    /* Action safe (93% - standard broadcast) */\n    .guide-action-safe {\n      position: absolute;\n      top: 37px; left: 67px;       /* 3.5% inset */\n      width: 1786px; height: 1006px;\n      border: 1px solid rgba(255, 100, 100, 0.5);\n    }\n    .guide-action-safe-label {\n      position: absolute;\n      top: 2px; right: 4px;\n      font-family: monospace;\n      font-size: 11px;\n      color: rgba(255, 100, 100, 0.7);\n    }\n\n    /* Title safe (80%) */\n    .guide-title-safe {\n      position: absolute;\n      top: 108px; left: 192px;     /* 10% inset */\n      width: 1536px; height: 864px;\n      border: 1px dashed rgba(100, 180, 255, 0.5);\n    }\n    .guide-title-safe-label {\n      position: absolute;\n      top: 2px; right: 4px;\n      font-family: monospace;\n      font-size: 11px;\n      color: rgba(100, 180, 255, 0.7);\n    }\n  </style>\n</head>\n<body>\n  <div id=\"container\"></div>\n\n  <!-- Guide overlay: center lines + safe margins -->\n  <div id=\"guides-overlay\">\n    <div class=\"guide-center-h\"></div>\n    <div class=\"guide-center-v\"></div>\n    <div class=\"guide-center-dot\"></div>\n    <div class=\"guide-action-safe\"><span class=\"guide-action-safe-label\">Action Safe</span></div>\n    <div class=\"guide-title-safe\"><span class=\"guide-title-safe-label\">Title Safe</span></div>\n  </div>\n\n  <script>\n    const TARGET_HEIGHT = 900; // All logos render at this height\n    const params = new URLSearchParams(window.location.search);\n    const sponsorsParam = params.get('sponsors') || '';\n    const lockedIndex = params.has('lockedIndex') ? parseInt(params.get('lockedIndex'), 10) : -1;\n    const showBounds = params.get('showBounds') === 'true';\n    const showGuides = params.get('showGuides') === 'true';\n\n    // Show guide overlay if requested\n    if (showGuides) {\n      document.getElementById('guides-overlay').classList.add('visible');\n    }\n\n    let sponsors = [];\n    if (sponsorsParam) {\n      try {\n        sponsors = JSON.parse(sponsorsParam);\n        if (!Array.isArray(sponsors)) sponsors = [];\n      } catch (e) { sponsors = []; }\n    }\n\n    const container = document.getElementById('container');\n    let currentIndex = 0;\n    let slides = [];\n\n    // Detect content bounding box by scanning for non-transparent pixels\n    function getContentBounds(imageData, w, h) {\n      const d = imageData.data;\n      let top = h, bottom = 0, left = w, right = 0;\n      const alphaThreshold = 20;\n\n      for (let y = 0; y < h; y++) {\n        for (let x = 0; x < w; x++) {\n          const a = d[(y * w + x) * 4 + 3];\n          if (a > alphaThreshold) {\n            if (y < top) top = y;\n            if (y > bottom) bottom = y;\n            if (x < left) left = x;\n            if (x > right) right = x;\n          }\n        }\n      }\n\n      if (top > bottom || left > right) {\n        return { x: 0, y: 0, w, h }; // Fallback: use entire image\n      }\n\n      // Add small padding (2% of content size)\n      const padX = Math.round((right - left) * 0.02);\n      const padY = Math.round((bottom - top) * 0.02);\n      return {\n        x: Math.max(0, left - padX),\n        y: Math.max(0, top - padY),\n        w: Math.min(w, right - left + padX * 2),\n        h: Math.min(h, bottom - top + padY * 2),\n      };\n    }\n\n    // Get effective bounds: use crop overrides if provided, otherwise auto-detect\n    function getEffectiveBounds(img, sponsor, autoBounds) {\n      // If sponsor has crop overrides, use them (values are in pixels relative to original image)\n      if (sponsor.cropX != null || sponsor.cropY != null || sponsor.cropW != null || sponsor.cropH != null) {\n        return {\n          x: sponsor.cropX ?? autoBounds.x,\n          y: sponsor.cropY ?? autoBounds.y,\n          w: sponsor.cropW ?? autoBounds.w,\n          h: sponsor.cropH ?? autoBounds.h,\n        };\n      }\n      return autoBounds;\n    }\n\n    // Render a trimmed, uniformly-sized logo onto a canvas\n    // Returns { canvas, autoBounds, usedBounds } for bounds visualization\n    function renderTrimmedLogo(img, sponsor) {\n      // Draw full image to offscreen canvas for pixel scanning\n      const offscreen = document.createElement('canvas');\n      offscreen.width = img.naturalWidth;\n      offscreen.height = img.naturalHeight;\n      const octx = offscreen.getContext('2d');\n      octx.drawImage(img, 0, 0);\n\n      let autoBounds;\n      try {\n        const imageData = octx.getImageData(0, 0, offscreen.width, offscreen.height);\n        autoBounds = getContentBounds(imageData, offscreen.width, offscreen.height);\n      } catch (e) {\n        // CORS blocked — fall back to full image\n        autoBounds = { x: 0, y: 0, w: img.naturalWidth, h: img.naturalHeight };\n      }\n\n      const usedBounds = getEffectiveBounds(img, sponsor || {}, autoBounds);\n\n      // Scale content to TARGET_HEIGHT, maintaining aspect ratio\n      const scale = TARGET_HEIGHT / usedBounds.h;\n      const outW = Math.round(usedBounds.w * scale);\n      const outH = TARGET_HEIGHT;\n\n      const canvas = document.createElement('canvas');\n      canvas.width = outW;\n      canvas.height = outH;\n      const ctx = canvas.getContext('2d');\n      ctx.imageSmoothingEnabled = true;\n      ctx.imageSmoothingQuality = 'high';\n      ctx.drawImage(img, usedBounds.x, usedBounds.y, usedBounds.w, usedBounds.h, 0, 0, outW, outH);\n\n      return { canvas, autoBounds, usedBounds };\n    }\n\n    // Apply per-sponsor overrides (scale, offsetX, offsetY) to a canvas element\n    function applyOverrides(canvas, sponsor) {\n      const scale = (sponsor.scale || 100) / 100;\n      const ox = sponsor.offsetX || 0;\n      const oy = sponsor.offsetY || 0;\n      if (scale !== 1) {\n        canvas.style.width = Math.round(canvas.width * scale) + 'px';\n        canvas.style.height = Math.round(canvas.height * scale) + 'px';\n      }\n      if (ox || oy) {\n        canvas.style.transform = `translate(${ox}px, ${oy}px)`;\n      }\n    }\n\n    // Draw bounding box overlays on a slide\n    function drawBoundsOverlay(slide, canvas, autoBounds, usedBounds, sponsor) {\n      // We need to show bounds relative to the rendered canvas position\n      // The canvas is centered in the slide, so compute its position\n      const scale = (sponsor.scale || 100) / 100;\n      const canvasDisplayW = canvas.width * scale;\n      const canvasDisplayH = canvas.height * scale;\n      const ox = sponsor.offsetX || 0;\n      const oy = sponsor.offsetY || 0;\n\n      // Canvas is centered in the 1920x1080 slide\n      const canvasLeft = (1920 - canvasDisplayW) / 2 + ox;\n      const canvasTop = (1080 - canvasDisplayH) / 2 + oy;\n\n      // Show the full rendered canvas boundary (green = what's being used)\n      const cropDiv = document.createElement('div');\n      cropDiv.className = 'crop-overlay';\n      cropDiv.style.left = canvasLeft + 'px';\n      cropDiv.style.top = canvasTop + 'px';\n      cropDiv.style.width = canvasDisplayW + 'px';\n      cropDiv.style.height = canvasDisplayH + 'px';\n      const cropLabel = document.createElement('div');\n      cropLabel.className = 'crop-label';\n      cropLabel.textContent = `Rendered: ${Math.round(canvasDisplayW)}×${Math.round(canvasDisplayH)}px (crop: ${usedBounds.x},${usedBounds.y} ${usedBounds.w}×${usedBounds.h})`;\n      cropDiv.appendChild(cropLabel);\n      slide.appendChild(cropDiv);\n\n      // Show auto-detected bounds as magenta dashed (for comparison)\n      if (autoBounds.x !== usedBounds.x || autoBounds.y !== usedBounds.y ||\n          autoBounds.w !== usedBounds.w || autoBounds.h !== usedBounds.h) {\n        // Map auto bounds into rendered space\n        const renderScale = TARGET_HEIGHT / usedBounds.h * scale;\n        const autoLeft = canvasLeft + (autoBounds.x - usedBounds.x) * renderScale;\n        const autoTop = canvasTop + (autoBounds.y - usedBounds.y) * renderScale;\n        const autoW = autoBounds.w * renderScale;\n        const autoH = autoBounds.h * renderScale;\n\n        const boundsDiv = document.createElement('div');\n        boundsDiv.className = 'bounds-overlay';\n        boundsDiv.style.left = autoLeft + 'px';\n        boundsDiv.style.top = autoTop + 'px';\n        boundsDiv.style.width = autoW + 'px';\n        boundsDiv.style.height = autoH + 'px';\n        const boundsLabel = document.createElement('div');\n        boundsLabel.className = 'bounds-label';\n        boundsLabel.textContent = `Auto-detect: ${autoBounds.x},${autoBounds.y} ${autoBounds.w}×${autoBounds.h}`;\n        boundsDiv.appendChild(boundsLabel);\n        slide.appendChild(boundsDiv);\n      }\n    }\n\n    if (sponsors.length === 0) {\n      container.innerHTML = '<div class=\"no-sponsors-message\">No sponsors configured</div>';\n    } else {\n      sponsors.forEach((sponsor, idx) => {\n        const url = sponsor.url || '';\n        if (!url) return;\n\n        // If locked to a specific index, skip others\n        if (lockedIndex >= 0 && idx !== lockedIndex) {\n          slides.push(null); // placeholder to keep indices aligned\n          return;\n        }\n\n        const slide = document.createElement('div');\n        slide.className = 'sponsor-slide';\n        slide.style.position = 'relative'; // for bounds overlay positioning\n\n        const img = new Image();\n        img.crossOrigin = 'anonymous';\n        img.onload = () => {\n          const { canvas, autoBounds, usedBounds } = renderTrimmedLogo(img, sponsor);\n          applyOverrides(canvas, sponsor);\n          slide.appendChild(canvas);\n          if (showBounds) {\n            drawBoundsOverlay(slide, canvas, autoBounds, usedBounds, sponsor);\n          }\n        };\n        img.onerror = () => {\n          // Try without CORS (won't trim but will display)\n          const fallback = new Image();\n          fallback.onload = () => {\n            const { canvas, autoBounds, usedBounds } = renderTrimmedLogo(fallback, sponsor);\n            applyOverrides(canvas, sponsor);\n            slide.appendChild(canvas);\n            if (showBounds) {\n              drawBoundsOverlay(slide, canvas, autoBounds, usedBounds, sponsor);\n            }\n          };\n          fallback.onerror = () => {\n            slide.dataset.broken = 'true';\n            if (slide.classList.contains('active')) advanceToNext();\n          };\n          fallback.src = url;\n        };\n        img.src = url;\n\n        container.appendChild(slide);\n        slides.push(slide);\n      });\n\n      // Filter out null placeholders for locked mode\n      const activeSlides = slides.filter(s => s !== null);\n\n      if (activeSlides.length > 0) {\n        if (lockedIndex >= 0) {\n          // Locked mode: show only the locked slide, no cycling\n          activeSlides[0].classList.add('active');\n        } else {\n          showSlide(0);\n          if (activeSlides.length > 1) {\n            setInterval(advanceToNext, 3000);\n          }\n        }\n      } else {\n        container.innerHTML = '<div class=\"no-sponsors-message\">No sponsors configured</div>';\n      }\n    }\n\n    function showSlide(index) {\n      const activeSlides = slides.filter(s => s !== null);\n      if (!activeSlides[index]) return;\n      if (activeSlides[index].dataset.broken === 'true') {\n        currentIndex = (index + 1) % activeSlides.length;\n        if (currentIndex !== index) showSlide(currentIndex);\n        return;\n      }\n      activeSlides.forEach((slide, i) => {\n        slide.classList.toggle('active', i === index);\n      });\n      currentIndex = index;\n    }\n\n    function advanceToNext() {\n      if (lockedIndex >= 0) return; // Don't cycle in locked mode\n      const activeSlides = slides.filter(s => s !== null);\n      let nextIndex = (currentIndex + 1) % activeSlides.length;\n      let attempts = 0;\n      while (activeSlides[nextIndex].dataset.broken === 'true' && attempts < activeSlides.length) {\n        nextIndex = (nextIndex + 1) % activeSlides.length;\n        attempts++;\n      }\n      if (attempts < activeSlides.length) showSlide(nextIndex);\n    }\n  </script>\n  <script src=\"theme-loader.js?v=2\"></script>\n</body>\n</html>\n","numLines":441,"startLine":1,"totalLines":441}}}
