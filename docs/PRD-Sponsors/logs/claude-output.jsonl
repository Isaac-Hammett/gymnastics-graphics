 0;\n    let brokenCount = 0;\n    let images = [];\n    let cycleInterval = null;\n\n    // If no sponsors, hide container entirely\n    if (sponsors.length === 0) {\n      container.style.display = 'none';\n    } else {\n      // Create image for each sponsor\n      sponsors.forEach((sponsor, index) => {\n        const url = sponsor.url || '';\n        if (!url) {\n          brokenCount++;\n          images.push(null);\n          return;\n        }\n\n        const img = document.createElement('img');\n        img.className = 'sponsor-logo';\n        img.src = url;\n        img.alt = sponsor.name || 'Sponsor';\n        img.dataset.index = index;\n        img.onerror = () => {\n          brokenCount++;\n          img.dataset.broken = 'true';\n          img.style.display = 'none';\n\n          // Check if ALL logos are broken\n          if (brokenCount >= sponsors.length) {\n            container.style.display = 'none';\n            if (cycleInterval) {\n              clearInterval(cycleInterval);\n            }\n          } else if (img.classList.contains('active')) {\n            // This was the active image - skip to next immediately\n            advanceToNext();\n          }\n        };\n        container.appendChild(img);\n        images.push(img);\n      });\n\n      // Filter out null entries (no URL provided)\n      const validImages = images.filter(img => img !== null);\n\n      // If all entries had no URLs, hide container\n      if (validImages.length === 0) {\n        container.style.display = 'none';\n      } else {\n        // Show first valid image\n        showImage(0);\n\n        // Only start cycling if more than 1 sponsor\n        if (sponsors.length > 1) {\n          cycleInterval = setInterval(advanceToNext, 10000);\n        }\n      }\n    }\n\n    function showImage(index) {\n      // Skip null entries or broken images\n      if (images[index] === null || (images[index] && images[index].dataset.broken === 'true')) {\n        currentIndex = (index + 1) % images.length;\n        // Avoid infinite loop if all are broken\n        if (currentIndex === index) {\n          container.style.display = 'none';\n          return;\n        }\n        showImage(currentIndex);\n        return;\n      }\n\n      images.forEach((img, i) => {\n        if (img === null) return;\n        if (i === index) {\n          img.classList.add('active');\n        } else {\n          img.classList.remove('active');\n        }\n      });\n      currentIndex = index;\n    }\n\n    function advanceToNext() {\n      let nextIndex = (currentIndex + 1) % images.length;\n      let attempts = 0;\n\n      // Find next valid, non-broken image\n      while (attempts < images.length) {\n        if (images[nextIndex] !== null && images[nextIndex].dataset.broken !== 'true') {\n          break;\n        }\n        nextIndex = (nextIndex + 1) % images.length;\n        attempts++;\n      }\n\n      // If all images are broken or null, hide container\n      if (attempts >= images.length) {\n        container.style.display = 'none';\n        if (cycleInterval) {\n          clearInterval(cycleInterval);\n        }\n        return;\n      }\n\n      showImage(nextIndex);\n    }\n  </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
