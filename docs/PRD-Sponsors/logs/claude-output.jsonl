or Leaderboard',\n    77→  'leaderboard-ph': 'Pommel Horse Leaderboard',\n    78→  'leaderboard-sr': 'Still Rings Leaderboard',\n    79→  'leaderboard-vt': 'Vault Leaderboard',\n    80→  'leaderboard-pb': 'Parallel Bars Leaderboard',\n    81→  'leaderboard-hb': 'High Bar Leaderboard',\n    82→  'leaderboard-ub': 'Uneven Bars Leaderboard',\n    83→  'leaderboard-bb': 'Balance Beam Leaderboard',\n    84→  'leaderboard-aa': 'All-Around Leaderboard',\n    85→  // Event Summary Rotations\n    86→  'summary-r1': 'Event Summary - Rotation 1',\n    87→  'summary-r2': 'Event Summary - Rotation 2',\n    88→  'summary-r3': 'Event Summary - Rotation 3',\n    89→  'summary-r4': 'Event Summary - Rotation 4',\n    90→  'summary-r5': 'Event Summary - Rotation 5',\n    91→  'summary-r6': 'Event Summary - Rotation 6',\n    92→  // Event Summary Apparatus\n    93→  'summary-fx': 'Event Summary - Floor',\n    94→  'summary-ph': 'Event Summary - Pommel Horse',\n    95→  'summary-sr': 'Event Summary - Still Rings',\n    96→  'summary-vt': 'Event Summary - Vault',\n    97→  'summary-pb': 'Event Summary - Parallel Bars',\n    98→  'summary-hb': 'Event Summary - High Bar',\n    99→  'summary-ub': 'Event Summary - Uneven Bars',\n   100→  'summary-bb': 'Event Summary - Balance Beam',\n   101→};\n   102→\n   103→// Generate team-specific graphic titles dynamically\n   104→function getGraphicTitles(teamCount) {\n   105→  const titles = { ...baseGraphicTitles };\n   106→  for (let i = 1; i <= teamCount; i++) {\n   107→    titles[`team${i}-stats`] = `Team ${i} Stats`;\n   108→    titles[`team${i}-coaches`] = `Team ${i} Coaches`;\n   109→  }\n   110→  return titles;\n   111→}\n   112→\n   113→export default function UrlGeneratorPage() {\n   114→  const [searchParams] = useSearchParams();\n   115→  const compId = searchParams.get('comp');\n   116→\n   117→  const { config } = useCompetition(compId);\n   118→  const { updateCompetition, refreshTeamData } = useCompetitions();\n   119→  const [hasChanges, setHasChanges] = useState(false);\n   120→  const [saving, setSaving] = useState(false);\n   121→  const [refreshing, setRefreshing] = useState(false);\n   122→\n   123→  const [currentGraphic, setCurrentGraphic] = useState('logos');\n   124→  const [activeTab, setActiveTab] = useState('meet');\n   125→  const [toast, setToast] = useState('');\n   126→  const [summaryTheme, setSummaryTheme] = useState('layout-default-v4');\n   127→\n   128→  // Get team count from competition type (supports 2-6 teams)\n   129→  const teamCount = useMemo(() => getTeamCount(config?.compType), [config?.compType]);\n   130→\n   131→  // Initialize form data with support for up to 6 teams\n   132→  const [formData, setFormData] = useState({\n   133→    eventName: 'Big Ten Dual Meet',\n   134→    meetDate: 'January 15, 2025',\n   135→    venue: 'Crisler Center',\n   136→    location: 'Ann Arbor, MI',\n   137→    hosts: 'John Smith\\nSarah Johnson',\n   138→    // Team 1\n   139→    team1Name: 'Michigan',\n   140→    team1Logo: '',\n   141→    team1Ave: '406.850',\n   142→    team1High: '409.200',\n   143→    team1Coaches: 'Kurt Golder\\nBrian Coddington\\nTyler Balthazor',\n   144→    // Team 2\n   145→    team2Name: 'Ohio State',\n   146→    team2Logo: '',\n   147→    team2Ave: '403.450',\n   148→    team2High: '406.100',\n   149→    team2Coaches: 'Rustam Sharipov\\nSergio Santana\\nJames Moore',\n   150→    // Team 3 (for tri/quad meets)\n   151→    team3Name: '',\n   152→    team3Logo: '',\n   153→    team3Ave: '',\n   154→    team3High: '',\n   155→    team3Coaches: '',\n   156→    // Team 4 (for quad meets)\n   157→    team4Name: '',\n   158→    team4Logo: '',\n   159→    team4Ave: '',\n   160→    team4High: '',\n   161→    team4Coaches: '',\n   162→    // Team 5\n   163→    team5Name: '',\n   164→    team5Logo: '',\n   165→    team5Ave: '',\n   166→    team5High: '',\n   167→    team5Coaches: '',\n   168→    // Team 6\n   169→    team6Name: '',\n   170→    team6Logo: '',\n   171→    team6Ave: '',\n   172→    team6High: '',\n   173→    team6Coaches: '',\n   174→  });\n   175→\n   176→  // Load config from Firebase if competition is selected\n   177→  // Coaches are now auto-synced to config when RTN data is fetched\n   178→  useEffect(() => {\n   179→    if (config) {\n   180→      // Build form data dynamically for all teams (up to 6)\n   181→      const newFormData = {\n   182→        eventName: config.eventName || '',\n   183→        meetDate: config.meetDate || '',\n   184→        venue: config.venue || '',\n   185→        location: config.location || '',\n   186→        hosts: config.hosts || '',\n   187→      };\n   188→\n   189→      // Load all team data (1-6)\n   190→      for (let i = 1; i <= 6; i++) {\n   191→        newFormData[`team${i}Name`] = config[`team${i}Name`] || '';\n   192→        newFormData[`team${i}Logo`] = config[`team${i}Logo`] || '';\n   193→        newFormData[`team${i}Ave`] = config[`team${i}Ave`] || '';\n   194→        newFormData[`team${i}High`] = config[`team${i}High`] || '';\n   195→        newFormData[`team${i}Coaches`] = config[`team${i}Coaches`] || '';\n   196→      }\n   197→\n   198→      setFormData(newFormData);\n   199→      setHasChanges(false);\n   200→    }\n   201→  }, [config]);\n   202→\n   203→  // Update form data and track changes\n   204→  const updateFormData = (updates) => {\n   205→    setFormData(prev => ({ ...prev, ...updates }));\n   206→    setHasChanges(true);\n   207→  };\n   208→\n   209→  // Save changes to Firebase\n   210→  const saveToFirebase = async () => {\n   211→    if (!compId) {\n   212→      showToast('No competition selected!');\n   213→      return;\n   214→    }\n   215→    setSaving(true);\n   216→    try {\n   217→      await updateCompetition(compId, formData);\n   218→      setHasChanges(false);\n   219→      showToast('Saved to competition!');\n   220→    } catch (error) {\n   221→      console.error('Error saving:', error);\n   222→      showToast('Error saving changes');\n   223→    }\n   224→    setSaving(false);\n   225→  };\n   226→\n   227→  // Fetch fresh team data from RTN\n   228→  const handleRefreshTeamData = async () => {\n   229→    if (!compId) {\n   230→      showToast('No competition selected!');\n   231→      return;\n   232→    }\n   233→    setRefreshing(true);\n   234→    try {\n   235→      const result = await refreshTeamData(compId);\n   236→      if (result.success) {\n   237→        showToast(`Refreshed ${result.teamsEnriched} team(s) from RTN!`);\n   238→      } else {\n   239→        showToast('Error: ' + (result.error || 'Unknown error'));\n   240→      }\n   241→    } catch (error) {\n   242→      console.error('Error refreshing team data:', error);\n   243→      showToast('Error refreshing team data');\n   244→    }\n   245→    setRefreshing(false);\n   246→  };\n   247→\n   248→  // Get dynamic graphic titles based on team count\n   249→  const graphicTitles = useMemo(() => getGraphicTitles(teamCount), [teamCount]);\n   250→\n   251→  const showToast = (message) => {\n   252→    setToast(message);\n   253→    setTimeout(() => setToast(''), 2000);\n   254→  };\n   255→\n   256→  const copyUrl = async (graphic) => {\n   257→    const success = await copyToClipboard(generateURL(graphic));\n   258→    showToast(success ? `Copied: ${graphicTitles[graphic]}` : 'Failed to copy');\n   259→  };\n   260→\n   261→  const copyAllUrls = async () => {\n   262→    const allUrls = Object.keys(graphicTitles)\n   263→      .map((g) => `${graphicTitles[g]}:\\n${generateURL(g)}`)\n   264→      .join('\\n\\n');\n   265→    const success = await copyToClipboard(allUrls);\n   266→    showToast(success ? 'All URLs copied!' : 'Failed to copy');\n   267→  };\n   268→\n   269→  const isTransparent = isTransparentGraphic(currentGraphic);\n   270→\n   271→  const apparatusButtons = getApparatusButtons(config?.compType || 'mens-dual');\n   272→\n   273→  // Generate dynamic pre-meet buttons based on team count and names\n   274→  const teamNames = useMemo(() => {\n   275→    const names = {};\n   276→    for (let i = 1; i <= teamCount; i++) {\n   277→      if (formData[`team${i}Name`]) {\n   278→        names[i] = formData[`team${i}Name`];\n   279→      }\n   280→    }\n   281→    return names;\n   282→  }, [formData, teamCount]);\n   283→\n   284→  const preMeetButtons = useMemo(() => getPreMeetButtons(teamCount, teamNames), [teamCount, teamNames]);\n   285→\n   286→  // Generate frame overlay buttons\n   287→  const frameOverlayButtons = graphicButtons.frameOverlays;\n   288→\n   289→  // Generate leaderboard buttons (gender-aware)\n   290→  const leaderboardButtons = useMemo(() => getLeaderboardButtons(config?.compType), [config?.compType]);\n   291→\n   292→  // Generate event summary buttons (gender-aware)\n   293→  const summaryRotationButtons = useMemo(() => getEventSummaryRotationButtons(config?.compType), [config?.compType]);\n   294→  const summaryApparatusButtons = useMemo(() => getEventSummaryApparatusButtons(config?.compType), [config?.compType]);\n   295→\n   296→  // Generate URL with options for new graphic types\n   297→  const generateURLWithOptions = (graphic) => {\n   298→    return generateGraphicURL(graphic, formData, teamCount, undefined, {\n   299→      compType: config?.compType,\n   300→      virtiusSessionId: config?.virtiusSessionId,\n   301→      compId: compId,\n   302→      summaryTheme: summaryTheme,\n   303→    });\n   304→  };\n   305→\n   306→  // Override generateURL to use options\n   307→  const generateURL = (graphic) => {\n   308→    return generateURLWithOptions(graphic);\n   309→  };\n   310→\n   311→  const currentUrl = useMemo(() => generateURL(currentGraphic), [currentGraphic, formData, teamCount, config?.compType, config?.virtiusSessionId, summaryTheme]);\n   312→\n   313→  return (\n   314→    <div className=\"h-screen bg-zinc-950 flex\">\n   315→      {/* Sidebar */}\n   316→      <div className=\"w-72 bg-zinc-900 border-r border-zinc-800 p-5 overflow-y-auto flex-shrink-0\">\n   317→        <Link\n   318→          to=\"/\"\n   319→          className=\"flex items-center gap-2 px-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-zinc-300 text-xs hover:bg-zinc-700 transition-colors mb-4\"\n   320→        >\n   321→          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"><path d=\"m15 18-6-6 6-6\"/></svg>\n   322→          Back to Hub\n   323→        </Link>\n   324→\n   325→        <h1 className=\"text-xl font-bold text-white mb-1\">Graphics Generator</h1>\n   326→        <p className=\"text-xs text-zinc-500 mb-6\">\n   327→          {compId ? (\n   328→            <span className=\"text-blue-500 font-semibold\">Competition: {compId.toUpperCase()}</span>\n   329→          ) : (\n   330→            'OBS Overlay System'\n   331→          )}\n   332→        </p>\n   333→\n   334→        <GraphicSection title=\"Pre-Meet\">\n   335→          {preMeetButtons.map((btn) => (\n   336→            <GraphicSidebarButton\n   337→              key={btn.id}\n   338→              {...btn}\n   339→              active={currentGraphic === btn.id}\n   340→              onClick={() => setCurrentGraphic(btn.id)}\n   341→            />\n   342→          ))}\n   343→        </GraphicSection>\n   344→\n   345→        <GraphicSection title=\"In-Meet\">\n   346→          {graphicButtons.inMeet.map((btn) => (\n   347→            <GraphicSidebarButton\n   348→              key={btn.id}\n   349→              id={btn.id}\n   350→              label={btn.label}\n   351→              number={btn.number}\n   352→              active={currentGraphic === btn.id}\n   353→              onClick={() => setCurrentGraphic(btn.id)}\n   354→            />\n   355→          ))}\n   356→        </GraphicSection>\n   357→\n   358→        <GraphicSection title=\"Event Frames\">\n   359→          {apparatusButtons.map((btn) => (\n   360→            <GraphicSidebarButton\n   361→              key={btn.id}\n   362→              id={btn.id}\n   363→              label={btn.label}\n   364→              number={btn.number}\n   365→              active={currentGraphic === btn.id}\n   366→              onClick={() => setCurrentGraphic(btn.id)}\n   367→            />\n   368→          ))}\n   369→        </GraphicSection>\n   370→\n   371→        <GraphicSection title=\"Frame Overlays\">\n   372→          {frameOverlayButtons.map((btn) => (\n   373→            <GraphicSidebarButton\n   374→              key={btn.id}\n   375→              id={btn.id}\n   376→              label={btn.label}\n   377→              number={btn.number}\n   378→              active={currentGraphic === btn.id}\n   379→              onClick={() => setCurrentGraphic(btn.id)}\n   380→            />\n   381→          ))}\n   382→        </GraphicSection>\n   383→\n   384→        <GraphicSection title=\"Leaderboards\">\n   385→          {leaderboardButtons.map((btn) => (\n   386→            <GraphicSidebarButton\n   387→              key={btn.id}\n   388→              id={btn.id}\n   389→              label={btn.label}\n   390→              active={currentGraphic === btn.id}\n   391→              onClick={() => setCurrentGraphic(btn.id)}\n   392→            />\n   393→          ))}\n   394→        </GraphicSection>\n   395→\n   396→        <GraphicSection title=\"Event Summary\">\n   397→          <div className=\"mb-3\">\n   398→            <select\n   399→              value={summaryTheme}\n   400→              onChange={(e) => setSummaryTheme(e.target.value)}\n   401→              className=\"w-full text-xs bg-zinc-800 text-zinc-300 border border-zinc-700 rounded px-2 py-1.5 focus:outline-none focus:border-blue-500\"\n   402→            >\n   403→              {summaryThemes.map((theme) => (\n   404→                <option key={theme.id} value={theme.id}>{theme.label}</option>\n   405→              ))}\n   406→            </select>\n   407→          </div>\n   408→          <div className=\"text-xs text-zinc-600 mb-1\">By Rotation (Alternating)</div>\n   409→          <div className=\"grid grid-cols-4 gap-1 mb-2\">\n   410→            {summaryRotationButtons.map((btn) => (\n   411→              <button\n   412→                key={btn.id}\n   413→                onClick={() => setCurrentGraphic(btn.id)}\n   414→                className={`px-2 py-1.5 rounded text-xs font-medium transition-colors ${\n   415→                  currentGraphic === btn.id\n   416→                    ? 'bg-blue-600 text-white'\n   417→                    : 'bg-zinc-800 border border-zinc-700 text-zinc-300 hover:bg-zinc-700'\n   418→                }`}\n   419→              >\n   420→                {btn.label}\n   421→              </button>\n   422→            ))}\n   423→          </div>\n   424→          <div className=\"text-xs text-zinc-600 mb-1\">By Apparatus</div>\n   425→          <div className=\"grid grid-cols-4 gap-1\">\n   426→            {summaryApparatusButtons.map((btn) => (\n   427→              <button\n   428→                key={btn.id}\n   429→                onClick={() => setCurrentGraphic(btn.id)}\n   430→                className={`px-2 py-1.5 rounded text-xs font-medium transition-colors ${\n   431→                  currentGraphic === btn.id\n   432→                    ? 'bg-blue-600 text-white'\n   433→                    : 'bg-zinc-800 border border-zinc-700 text-zinc-300 hover:bg-zinc-700'\n   434→                }`}\n   435→              >\n   436→                {btn.label}\n   437→              </button>\n   438→            ))}\n   439→          </div>\n   440→        </GraphicSection>\n   441→\n   442→        <GraphicSection title=\"Stream\">\n   443→          <GraphicSidebarButton\n   444→            id=\"starting\"\n   445→            label=\"Stream Starting\"\n   446→            number={19}\n   447→            active={currentGraphic === 'starting'}\n   448→            onClick={() => setCurrentGraphic('starting')}\n   449→          />\n   450→          <GraphicSidebarButton\n   451→            id=\"thanks\"\n   452→            label=\"Thanks for Watching\"\n   453→            number={20}\n   454→            active={currentGraphic === 'thanks'}\n   455→            onClick={() => setCurrentGraphic('thanks')}\n   456→          />\n   457→        </GraphicSection>\n   458→      </div>\n   459→\n   460→      {/* Main Preview */}\n   461→      <div className=\"flex-1 flex flex-col overflow-hidden\">\n   462→        <div className=\"px-6 py-4 bg-zinc-900 border-b border-zinc-800 flex items-center gap-4\">\n   463→          <h2 className=\"text-lg font-semibold text-white flex-1\">{graphicTitles[currentGraphic]}</h2>\n   464→          <button\n   465→            onClick={() => window.open(currentUrl, '_blank')}\n   466→            className=\"px-4 py-2 bg-zinc-800 text-zinc-300 text-sm rounded-lg hover:bg-zinc-700 transition-colors\"\n   467→          >\n   468→            Open Full Size\n   469→          </button>\n   470→          <button\n   471→            onClick={() => copyUrl(currentGraphic)}\n   472→            className=\"px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-500 transition-colors\"\n   473→          >\n   474→            Copy URL\n   475→          </button>\n   476→        </div>\n   477→\n   478→        <div className=\"flex-1 flex items-center justify-center bg-zinc-950 p-6\">\n   479→          <div\n   480→            className={`relative w-[960px] h-[540px] rounded-lg overflow-hidden shadow-2xl ${\n   481→              isTransparent ? 'bg-checkered' : 'bg-black'\n   482→            }`}\n   483→            style={isTransparent ? {\n   484→              background: 'repeating-conic-gradient(#222 0% 25%, #1a1a1a 0% 50%) 50% / 20px 20px'\n   485→            } : {}}\n   486→          >\n   487→            <iframe\n   488→              src={currentUrl}\n   489→              className=\"w-[1920px] h-[1080px] origin-top-left\"\n   490→              style={{ transform: 'scale(0.5)' }}\n   491→            />\n   492→          </div>\n   493→        </div>\n   494→      </div>\n   495→\n   496→      {/* Config Panel */}\n   497→      <div className=\"w-80 bg-zinc-900 border-l border-zinc-800 p-5 overflow-y-auto flex-shrink-0\">\n   498→        {/* Dynamic tabs based on team count */}\n   499→        <div className=\"flex flex-wrap gap-1 mb-4\">\n   500→          <button\n   501→            onClick={() => setActiveTab('meet')}\n   502→            className={`px-3 py-2 text-xs font-medium rounded-lg transition-colors ${\n   503→              activeTab === 'meet'\n   504→                ? 'bg-blue-600 text-white'\n   505→                : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'\n   506→            }`}\n   507→          >\n   508→            Meet\n   509→          </button>\n   510→          {/* Generate team tabs dynamically based on teamCount */}\n   511→          {Array.from({ length: teamCount }, (_, i) => i + 1).map((num) => (\n   512→            <button\n   513→              key={`team${num}`}\n   514→              onClick={() => setActiveTab(`team${num}`)}\n   515→              className={`px-3 py-2 text-xs font-medium rounded-lg transition-colors ${\n   516→                activeTab === `team${num}`\n   517→                  ? 'bg-blue-600 text-white'\n   518→                  : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'\n   519→              }`}\n   520→            >\n   521→              T{num}\n   522→            </button>\n   523→          ))}\n   524→          <button\n   525→            onClick={() => setActiveTab('urls')}\n   526→            className={`px-3 py-2 text-xs font-medium rounded-lg transition-colors ${\n   527→              activeTab === 'urls'\n   528→                ? 'bg-blue-600 text-white'\n   529→                : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'\n   530→            }`}\n   531→          >\n   532→            URLs\n   533→          </button>\n   534→        </div>\n   535→\n   536→        {/* Competition type indicator */}\n   537→        {config?.compType && (\n   538→          <div className=\"mb-4 px-2 py-1.5 bg-zinc-800 rounded text-xs text-zinc-400\">\n   539→            {config.compType.replace('-', ' ').replace(/\\b\\w/g, l => l.toUpperCase())} ({teamCount} teams)\n   540→          </div>\n   541→        )}\n   542→\n   543→        {activeTab === 'meet' && (\n   544→          <div>\n   545→            <ConfigInput label=\"Event Name\" value={formData.eventName} onChange={(v) => updateFormData({ eventName: v })} />\n   546→            <ConfigInput label=\"Meet Date\" value={formData.meetDate} onChange={(v) => updateFormData({ meetDate: v })} />\n   547→            <ConfigInput label=\"Venue\" value={formData.venue} onChange={(v) => updateFormData({ venue: v })} />\n   548→            <ConfigInput label=\"Location\" value={formData.location} onChange={(v) => updateFormData({ location: v })} />\n   549→            <ConfigTextarea label=\"Hosts (one per line)\" value={formData.hosts} onChange={(v) => updateFormData({ hosts: v })} />\n   550→          </div>\n   551→        )}\n   552→\n   553→        {/* Dynamic team tabs - render for each team in the competition */}\n   554→        {Array.from({ length: teamCount }, (_, i) => i + 1).map((num) => (\n   555→          activeTab === `team${num}` && (\n   556→            <div key={`team${num}-content`}>\n   557→              <h3 className=\"text-sm font-semibold text-zinc-300 mb-3\">Team {num}</h3>\n   558→              <ConfigInput\n   559→                label=\"Team Name\"\n   560→                value={formData[`team${num}Name`]}\n   561→                onChange={(v) => updateFormData({ [`team${num}Name`]: v })}\n   562→              />\n   563→              <ConfigInput\n   564→                label=\"Logo URL\"\n   565→                value={formData[`team${num}Logo`]}\n   566→                onChange={(v) => updateFormData({ [`team${num}Logo`]: v })}\n   567→                placeholder=\"https://...\"\n   568→              />\n   569→              <div className=\"grid grid-cols-2 gap-2\">\n   570→                <ConfigInput\n   571→                  label=\"AVE\"\n   572→                  value={formData[`team${num}Ave`]}\n   573→                  onChange={(v) => updateFormData({ [`team${num}Ave`]: v })}\n   574→                />\n   575→                <ConfigInput\n   576→                  label=\"HIGH\"\n   577→                  value={formData[`team${num}High`]}\n   578→                  onChange={(v) => updateFormData({ [`team${num}High`]: v })}\n   579→                />\n   580→              </div>\n   581→              <ConfigTextarea\n   582→                label=\"Coaches (one per line)\"\n   583→                value={formData[`team${num}Coaches`]}\n   584→                onChange={(v) => updateFormData({ [`team${num}Coaches`]: v })}\n   585→                rows={3}\n   586→              />\n   587→              {compId && num <= 2 && (\n   588→                <button\n   589→                  onClick={handleRefreshTeamData}\n   590→                  disabled={refreshing}\n   591→                  className=\"w-full px-3 py-2 text-xs bg-zinc-700 text-zinc-300 rounded-lg hover:bg-zinc-600 transition-colors disabled:opacity-50\"\n   592→                >\n   593→                  {refreshing ? 'Fetching...' : 'Fetch Team Data from RTN'}\n   594→                </button>\n   595→              )}\n   596→            </div>\n   597→          )\n   598→        ))}\n   599→\n   600→        {activeTab === 'urls' && (\n   601→          <div>\n   602→            <p className=\"text-xs text-zinc-500 mb-4\">Copy these URLs into OBS as Browser Sources (1920x1080)</p>\n   603→            <div className=\"space-y-2 max-h-[400px] overflow-y-auto\">\n   604→              {Object.keys(graphicTitles).map((g) => (\n   605→                <div key={g} className=\"bg-zinc-950 border border-zinc-800 rounded-lg p-3\">\n   606→                  <div className=\"flex justify-between items-center mb-1\">\n   607→                    <span className=\"text-xs font-semibold text-zinc-300\">{graphicTitles[g]}</span>\n   608→                    <button\n   609→                      onClick={() => copyUrl(g)}\n   610→                      className=\"px-2 py-1 text-xs bg-blue-600 text-white rounded hover:bg-blue-500 transition-colors\"\n   611→                    >\n   612→                      Copy\n   613→                    </button>\n   614→                  </div>\n   615→                  <div className=\"text-[10px] text-zinc-600 break-all\">{generateURL(g)}</div>\n   616→                </div>\n   617→              ))}\n   618→            </div>\n   619→            <button\n   620→              onClick={copyAllUrls}\n   621→              className=\"w-full mt-4 px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-500 transition-colors\"\n   622→            >\n   623→              Copy All URLs\n   624→            </button>\n   625→          </div>\n   626→        )}\n   627→\n   628→        {/* Save to Competition Button */}\n   629→        {compId && (\n   630→          <div className=\"mt-4 pt-4 border-t border-zinc-800\">\n   631→            <button\n   632→              onClick={saveToFirebase}\n   633→              disabled={saving || !hasChanges}\n   634→              className={`w-full px-4 py-3 text-sm font-semibold rounded-lg transition-colors ${\n   635→                hasChanges\n   636→                  ? 'bg-green-600 text-white hover:bg-green-500'\n   637→                  : 'bg-zinc-700 text-zinc-400 cursor-not-allowed'\n   638→              }`}\n   639→            >\n   640→              {saving ? 'Saving...' : hasChanges ? 'Save to Competition' : 'No Changes'}\n   641→            </button>\n   642→            {hasChanges && (\n   643→              <p className=\"text-xs text-yellow-500 mt-2 text-center\">Unsaved changes</p>\n   644→            )}\n   645→          </div>\n   646→        )}\n   647→\n   648→        <div className=\"mt-6 pt-4 border-t border-zinc-800\">\n   649→          <div className=\"text-xs text-zinc-400 mb-2\">Current Graphic URL</div>\n   650→          <div className=\"bg-zinc-950 border border-zinc-800 rounded-lg p-3 font-mono text-[10px] text-zinc-500 break-all max-h-24 overflow-y-auto\">\n   651→            {currentUrl}\n   652→          </div>\n   653→          <button\n   654→            onClick={() => copyUrl(currentGraphic)}\n   655→            className=\"w-full mt-3 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-500 transition-colors\"\n   656→          >\n   657→            Copy URL for OBS\n   658→          </button>\n   659→        </div>\n   660→      </div>\n   661→\n   662→      {/* Toast */}\n   663→      {toast && (\n   664→        <div className=\"fixed bottom-5 right-5 px-5 py-3 bg-green-500 text-white rounded-lg font-medium shadow-lg\">\n   665→          {toast}\n   666→        </div>\n   667→      )}\n   668→    </div>\n   669→  );\n   670→}\n   671→\n   672→function GraphicSection({ title, children }) {\n   673→  return (\n   674→    <div className=\"mb-5\">\n   675→      <div className=\"text-xs font-semibold text-zinc-400 uppercase tracking-wide mb-2\">{title}</div>\n   676→      <div className=\"space-y-1\">{children}</div>\n   677→    </div>\n   678→  );\n   679→}\n   680→\n   681→function GraphicSidebarButton({ id, label, number, active, onClick }) {\n   682→  return (\n   683→    <button\n   684→      onClick={onClick}\n   685→      className={`w-full px-3 py-2.5 rounded-lg text-left text-sm transition-colors flex items-center gap-2 ${\n   686→        active\n   687→          ? 'bg-blue-600 text-white'\n   688→          : 'bg-transparent border border-zinc-800 text-zinc-300 hover:bg-zinc-800'\n   689→      }`}\n   690→    >\n   691→      <span className={`text-xs w-5 ${active ? 'text-blue-200' : 'text-zinc-500'}`}>{number}</span>\n   692→      {label}\n   693→    </button>\n   694→  );\n   695→}\n   696→\n   697→function ConfigInput({ label, value, onChange, placeholder }) {\n   698→  return (\n   699→    <div className=\"mb-4\">\n   700→      <label className=\"block text-xs text-zinc-400 mb-1.5\">{label}</label>\n   701→      <input\n   702→        type=\"text\"\n   703→        value={value || ''}\n   704→        onChange={(e) => onChange(e.target.value)}\n   705→        placeholder={placeholder}\n   706→        className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n   707→      />\n   708→    </div>\n   709→  );\n   710→}\n   711→\n   712→function ConfigTextarea({ label, value, onChange, rows = 2 }) {\n   713→  return (\n   714→    <div className=\"mb-4\">\n   715→      <label className=\"block text-xs text-zinc-400 mb-1.5\">{label}</label>\n   716→      <textarea\n   717→        value={value || ''}\n   718→        onChange={(e) => onChange(e.target.value)}\n   719→        rows={rows}\n   720→        className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500 resize-none\"\n   721→      />\n   722→    </div>\n   723→  );\n   724→}\n   725→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e4de8b66-3803-4327-8dd8-d489c6260f11","uuid":"bacccf43-021f-439f-aee7-92ec27a7c27e","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/pages/UrlGeneratorPage.jsx","content":"import { useState, useEffect, useMemo } from 'react';\nimport { Link, useSearchParams } from 'react-router-dom';\nimport { useCompetition, useCompetitions } from '../hooks/useCompetitions';\nimport { graphicButtons, getApparatusButtons, getPreMeetButtons, getLeaderboardButtons, getEventSummaryRotationButtons, getEventSummaryApparatusButtons, transparentGraphics, isTransparentGraphic } from '../lib/graphicButtons';\nimport { getTeamCount, getGenderFromCompType } from '../lib/competitionUtils';\nimport { generateGraphicURL, copyToClipboard } from '../lib/urlBuilder';\n\n// Available themes for Event Summary (same as GraphicsControl.jsx)\nconst summaryThemes = [\n  // LAYOUTS - Different structural designs\n  { id: 'layout-broadcast-table', label: 'Hero Cards' },\n  { id: 'layout-classic-broadcast', label: 'Classic Broadcast' },\n  { id: 'layout-default-v2', label: 'Default V2' },\n  { id: 'layout-default-v3', label: 'V3 Full Height' },\n  { id: 'layout-default-v4', label: 'V4 Rankings' },\n  { id: 'layout-default-v5', label: 'V5 Compact' },\n  { id: 'layout-default-v6', label: 'V6 Cards' },\n  { id: 'layout-default-v7', label: 'V7 Progress Bars' },\n  { id: 'layout-default-v8', label: 'V8 Light Minimal' },\n  { id: 'layout-default-v9', label: 'V9 Bold Blue' },\n  { id: 'layout-default-v10', label: 'V10 Score Focus' },\n  { id: 'layout-default-v11', label: 'V11 Blue Accent' },\n  { id: 'layout-default-v12', label: 'V12 Gradient Rows' },\n  { id: 'layout-default-v13', label: 'V13 Split Header' },\n  { id: 'layout-default-v14', label: 'V14 Big Footer' },\n  { id: 'layout-default-v15', label: 'V15 Orange Badges' },\n  { id: 'layout-default-v16', label: 'V16 Purple Theme' },\n  { id: 'layout-default-v17', label: 'V17 Green Scores' },\n  { id: 'layout-default-v18', label: 'V18 Team Colors' },\n  { id: 'layout-default-v19', label: 'V19 Dense Compact' },\n  { id: 'layout-default-v20', label: 'V20 Combined Best' },\n  // COLOR THEMES - Same structure, different colors\n  { id: 'default', label: 'Default (Original)' },\n  { id: 'espn', label: 'ESPN Colors' },\n  { id: 'nbc', label: 'NBC Olympics' },\n  { id: 'btn', label: 'Big Ten' },\n  { id: 'pac12', label: 'Pac-12' },\n  { id: 'virtius', label: 'Virtius' },\n  { id: 'neon', label: 'Neon' },\n  { id: 'classic', label: 'Classic' },\n  { id: 'light', label: 'Light' },\n  { id: 'home', label: 'Team Colors' },\n  { id: 'gradient', label: 'Gradient' },\n];\n\n// Base graphic titles (team-specific ones are generated dynamically)\nconst baseGraphicTitles = {\n  logos: 'Team Logos',\n  'event-bar': 'Event Info Bar',\n  'warm-up': 'Warm Up',\n  hosts: 'Hosts',\n  floor: 'Floor Exercise',\n  pommel: 'Pommel Horse',\n  rings: 'Still Rings',\n  vault: 'Vault',\n  pbars: 'Parallel Bars',\n  hbar: 'Horizontal Bar',\n  ubars: 'Uneven Bars',\n  beam: 'Balance Beam',\n  allaround: 'All Around',\n  final: 'Final Scores',\n  order: 'Competition Order',\n  lineups: 'Next Event Lineups',\n  summary: 'Event Summary',\n  starting: 'Stream Starting Soon',\n  thanks: 'Thanks for Watching',\n  // In-Meet\n  replay: 'Instant Replay',\n  // Frame Overlays\n  'frame-quad': 'Quad View',\n  'frame-tri-center': 'Tri Center',\n  'frame-tri-wide': 'Tri Wide',\n  'frame-team-header': 'Team Header',\n  'frame-single': 'Single',\n  // Leaderboards\n  'leaderboard-fx': 'Floor Leaderboard',\n  'leaderboard-ph': 'Pommel Horse Leaderboard',\n  'leaderboard-sr': 'Still Rings Leaderboard',\n  'leaderboard-vt': 'Vault Leaderboard',\n  'leaderboard-pb': 'Parallel Bars Leaderboard',\n  'leaderboard-hb': 'High Bar Leaderboard',\n  'leaderboard-ub': 'Uneven Bars Leaderboard',\n  'leaderboard-bb': 'Balance Beam Leaderboard',\n  'leaderboard-aa': 'All-Around Leaderboard',\n  // Event Summary Rotations\n  'summary-r1': 'Event Summary - Rotation 1',\n  'summary-r2': 'Event Summary - Rotation 2',\n  'summary-r3': 'Event Summary - Rotation 3',\n  'summary-r4': 'Event Summary - Rotation 4',\n  'summary-r5': 'Event Summary - Rotation 5',\n  'summary-r6': 'Event Summary - Rotation 6',\n  // Event Summary Apparatus\n  'summary-fx': 'Event Summary - Floor',\n  'summary-ph': 'Event Summary - Pommel Horse',\n  'summary-sr': 'Event Summary - Still Rings',\n  'summary-vt': 'Event Summary - Vault',\n  'summary-pb': 'Event Summary - Parallel Bars',\n  'summary-hb': 'Event Summary - High Bar',\n  'summary-ub': 'Event Summary - Uneven Bars',\n  'summary-bb': 'Event Summary - Balance Beam',\n};\n\n// Generate team-specific graphic titles dynamically\nfunction getGraphicTitles(teamCount) {\n  const titles = { ...baseGraphicTitles };\n  for (let i = 1; i <= teamCount; i++) {\n    titles[`team${i}-stats`] = `Team ${i} Stats`;\n    titles[`team${i}-coaches`] = `Team ${i} Coaches`;\n  }\n  return titles;\n}\n\nexport default function UrlGeneratorPage() {\n  const [searchParams] = useSearchParams();\n  const compId = searchParams.get('comp');\n\n  const { config } = useCompetition(compId);\n  const { updateCompetition, refreshTeamData } = useCompetitions();\n  const [hasChanges, setHasChanges] = useState(false);\n  const [saving, setSaving] = useState(false);\n  const [refreshing, setRefreshing] = useState(false);\n\n  const [currentGraphic, setCurrentGraphic] = useState('logos');\n  const [activeTab, setActiveTab] = useState('meet');\n  const [toast, setToast] = useState('');\n  const [summaryTheme, setSummaryTheme] = useState('layout-default-v4');\n\n  // Get team count from competition type (supports 2-6 teams)\n  const teamCount = useMemo(() => getTeamCount(config?.compType), [config?.compType]);\n\n  // Initialize form data with support for up to 6 teams\n  const [formData, setFormData] = useState({\n    eventName: 'Big Ten Dual Meet',\n    meetDate: 'January 15, 2025',\n    venue: 'Crisler Center',\n    location: 'Ann Arbor, MI',\n    hosts: 'John Smith\\nSarah Johnson',\n    // Team 1\n    team1Name: 'Michigan',\n    team1Logo: '',\n    team1Ave: '406.850',\n    team1High: '409.200',\n    team1Coaches: 'Kurt Golder\\nBrian Coddington\\nTyler Balthazor',\n    // Team 2\n    team2Name: 'Ohio State',\n    team2Logo: '',\n    team2Ave: '403.450',\n    team2High: '406.100',\n    team2Coaches: 'Rustam Sharipov\\nSergio Santana\\nJames Moore',\n    // Team 3 (for tri/quad meets)\n    team3Name: '',\n    team3Logo: '',\n    team3Ave: '',\n    team3High: '',\n    team3Coaches: '',\n    // Team 4 (for quad meets)\n    team4Name: '',\n    team4Logo: '',\n    team4Ave: '',\n    team4High: '',\n    team4Coaches: '',\n    // Team 5\n    team5Name: '',\n    team5Logo: '',\n    team5Ave: '',\n    team5High: '',\n    team5Coaches: '',\n    // Team 6\n    team6Name: '',\n    team6Logo: '',\n    team6Ave: '',\n    team6High: '',\n    team6Coaches: '',\n  });\n\n  // Load config from Firebase if competition is selected\n  // Coaches are now auto-synced to config when RTN data is fetched\n  useEffect(() => {\n    if (config) {\n      // Build form data dynamically for all teams (up to 6)\n      const newFormData = {\n        eventName: config.eventName || '',\n        meetDate: config.meetDate || '',\n        venue: config.venue || '',\n        location: config.location || '',\n        hosts: config.hosts || '',\n      };\n\n      // Load all team data (1-6)\n      for (let i = 1; i <= 6; i++) {\n        newFormData[`team${i}Name`] = config[`team${i}Name`] || '';\n        newFormData[`team${i}Logo`] = config[`team${i}Logo`] || '';\n        newFormData[`team${i}Ave`] = config[`team${i}Ave`] || '';\n        newFormData[`team${i}High`] = config[`team${i}High`] || '';\n        newFormData[`team${i}Coaches`] = config[`team${i}Coaches`] || '';\n      }\n\n      setFormData(newFormData);\n      setHasChanges(false);\n    }\n  }, [config]);\n\n  // Update form data and track changes\n  const updateFormData = (updates) => {\n    setFormData(prev => ({ ...prev, ...updates }));\n    setHasChanges(true);\n  };\n\n  // Save changes to Firebase\n  const saveToFirebase = async () => {\n    if (!compId) {\n      showToast('No competition selected!');\n      return;\n    }\n    setSaving(true);\n    try {\n      await updateCompetition(compId, formData);\n      setHasChanges(false);\n      showToast('Saved to competition!');\n    } catch (error) {\n      console.error('Error saving:', error);\n      showToast('Error saving changes');\n    }\n    setSaving(false);\n  };\n\n  // Fetch fresh team data from RTN\n  const handleRefreshTeamData = async () => {\n    if (!compId) {\n      showToast('No competition selected!');\n      return;\n    }\n    setRefreshing(true);\n    try {\n      const result = await refreshTeamData(compId);\n      if (result.success) {\n        showToast(`Refreshed ${result.teamsEnriched} team(s) from RTN!`);\n      } else {\n        showToast('Error: ' + (result.error || 'Unknown error'));\n      }\n    } catch (error) {\n      console.error('Error refreshing team data:', error);\n      showToast('Error refreshing team data');\n    }\n    setRefreshing(false);\n  };\n\n  // Get dynamic graphic titles based on team count\n  const graphicTitles = useMemo(() => getGraphicTitles(teamCount), [teamCount]);\n\n  const showToast = (message) => {\n    setToast(message);\n    setTimeout(() => setToast(''), 2000);\n  };\n\n  const copyUrl = async (graphic) => {\n    const success = await copyToClipboard(generateURL(graphic));\n    showToast(success ? `Copied: ${graphicTitles[graphic]}` : 'Failed to copy');\n  };\n\n  const copyAllUrls = async () => {\n    const allUrls = Object.keys(graphicTitles)\n      .map((g) => `${graphicTitles[g]}:\\n${generateURL(g)}`)\n      .join('\\n\\n');\n    const success = await copyToClipboard(allUrls);\n    showToast(success ? 'All URLs copied!' : 'Failed to copy');\n  };\n\n  const isTransparent = isTransparentGraphic(currentGraphic);\n\n  const apparatusButtons = getApparatusButtons(config?.compType || 'mens-dual');\n\n  // Generate dynamic pre-meet buttons based on team count and names\n  const teamNames = useMemo(() => {\n    const names = {};\n    for (let i = 1; i <= teamCount; i++) {\n      if (formData[`team${i}Name`]) {\n        names[i] = formData[`team${i}Name`];\n      }\n    }\n    return names;\n  }, [formData, teamCount]);\n\n  const preMeetButtons = useMemo(() => getPreMeetButtons(teamCount, teamNames), [teamCount, teamNames]);\n\n  // Generate frame overlay buttons\n  const frameOverlayButtons = graphicButtons.frameOverlays;\n\n  // Generate leaderboard buttons (gender-aware)\n  const leaderboardButtons = useMemo(() => getLeaderboardButtons(config?.compType), [config?.compType]);\n\n  // Generate event summary buttons (gender-aware)\n  const summaryRotationButtons = useMemo(() => getEventSummaryRotationButtons(config?.compType), [config?.compType]);\n  const summaryApparatusButtons = useMemo(() => getEventSummaryApparatusButtons(config?.compType), [config?.compType]);\n\n  // Generate URL with options for new graphic types\n  const generateURLWithOptions = (graphic) => {\n    return generateGraphicURL(graphic, formData, teamCount, undefined, {\n      compType: config?.compType,\n      virtiusSessionId: config?.virtiusSessionId,\n      compId: compId,\n      summaryTheme: summaryTheme,\n    });\n  };\n\n  // Override generateURL to use options\n  const generateURL = (graphic) => {\n    return generateURLWithOptions(graphic);\n  };\n\n  const currentUrl = useMemo(() => generateURL(currentGraphic), [currentGraphic, formData, teamCount, config?.compType, config?.virtiusSessionId, summaryTheme]);\n\n  return (\n    <div className=\"h-screen bg-zinc-950 flex\">\n      {/* Sidebar */}\n      <div className=\"w-72 bg-zinc-900 border-r border-zinc-800 p-5 overflow-y-auto flex-shrink-0\">\n        <Link\n          to=\"/\"\n          className=\"flex items-center gap-2 px-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-zinc-300 text-xs hover:bg-zinc-700 transition-colors mb-4\"\n        >\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"><path d=\"m15 18-6-6 6-6\"/></svg>\n          Back to Hub\n        </Link>\n\n        <h1 className=\"text-xl font-bold text-white mb-1\">Graphics Generator</h1>\n        <p className=\"text-xs text-zinc-500 mb-6\">\n          {compId ? (\n            <span className=\"text-blue-500 font-semibold\">Competition: {compId.toUpperCase()}</span>\n          ) : (\n            'OBS Overlay System'\n          )}\n        </p>\n\n        <GraphicSection title=\"Pre-Meet\">\n          {preMeetButtons.map((btn) => (\n            <GraphicSidebarButton\n              key={btn.id}\n              {...btn}\n              active={currentGraphic === btn.id}\n              onClick={() => setCurrentGraphic(btn.id)}\n            />\n          ))}\n        </GraphicSection>\n\n        <GraphicSection title=\"In-Meet\">\n          {graphicButtons.inMeet.map((btn) => (\n            <GraphicSidebarButton\n              key={btn.id}\n              id={btn.id}\n              label={btn.label}\n              number={btn.number}\n              active={currentGraphic === btn.id}\n              onClick={() => setCurrentGraphic(btn.id)}\n            />\n          ))}\n        </GraphicSection>\n\n        <GraphicSection title=\"Event Frames\">\n          {apparatusButtons.map((btn) => (\n            <GraphicSidebarButton\n              key={btn.id}\n              id={btn.id}\n              label={btn.label}\n              number={btn.number}\n              active={currentGraphic === btn.id}\n              onClick={() => setCurrentGraphic(btn.id)}\n            />\n          ))}\n        </GraphicSection>\n\n        <GraphicSection title=\"Frame Overlays\">\n          {frameOverlayButtons.map((btn) => (\n            <GraphicSidebarButton\n              key={btn.id}\n              id={btn.id}\n              label={btn.label}\n              number={btn.number}\n              active={currentGraphic === btn.id}\n              onClick={() => setCurrentGraphic(btn.id)}\n            />\n          ))}\n        </GraphicSection>\n\n        <GraphicSection title=\"Leaderboards\">\n          {leaderboardButtons.map((btn) => (\n            <GraphicSidebarButton\n              key={btn.id}\n              id={btn.id}\n              label={btn.label}\n              active={currentGraphic === btn.id}\n              onClick={() => setCurrentGraphic(btn.id)}\n            />\n          ))}\n        </GraphicSection>\n\n        <GraphicSection title=\"Event Summary\">\n          <div className=\"mb-3\">\n            <select\n              value={summaryTheme}\n              onChange={(e) => setSummaryTheme(e.target.value)}\n              className=\"w-full text-xs bg-zinc-800 text-zinc-300 border border-zinc-700 rounded px-2 py-1.5 focus:outline-none focus:border-blue-500\"\n            >\n              {summaryThemes.map((theme) => (\n                <option key={theme.id} value={theme.id}>{theme.label}</option>\n              ))}\n            </select>\n          </div>\n          <div className=\"text-xs text-zinc-600 mb-1\">By Rotation (Alternating)</div>\n          <div className=\"grid grid-cols-4 gap-1 mb-2\">\n            {summaryRotationButtons.map((btn) => (\n              <button\n                key={btn.id}\n                onClick={() => setCurrentGraphic(btn.id)}\n                className={`px-2 py-1.5 rounded text-xs font-medium transition-colors ${\n                  currentGraphic === btn.id\n                    ? 'bg-blue-600 text-white'\n                    : 'bg-zinc-800 border border-zinc-700 text-zinc-300 hover:bg-zinc-700'\n                }`}\n              >\n                {btn.label}\n              </button>\n            ))}\n          </div>\n          <div className=\"text-xs text-zinc-600 mb-1\">By Apparatus</div>\n          <div className=\"grid grid-cols-4 gap-1\">\n            {summaryApparatusButtons.map((btn) => (\n              <button\n                key={btn.id}\n                onClick={() => setCurrentGraphic(btn.id)}\n                className={`px-2 py-1.5 rounded text-xs font-medium transition-colors ${\n                  currentGraphic === btn.id\n                    ? 'bg-blue-600 text-white'\n                    : 'bg-zinc-800 border border-zinc-700 text-zinc-300 hover:bg-zinc-700'\n                }`}\n              >\n                {btn.label}\n              </button>\n            ))}\n          </div>\n        </GraphicSection>\n\n        <GraphicSection title=\"Stream\">\n          <GraphicSidebarButton\n            id=\"starting\"\n            label=\"Stream Starting\"\n            number={19}\n            active={currentGraphic === 'starting'}\n            onClick={() => setCurrentGraphic('starting')}\n          />\n          <GraphicSidebarButton\n            id=\"thanks\"\n            label=\"Thanks for Watching\"\n            number={20}\n            active={currentGraphic === 'thanks'}\n            onClick={() => setCurrentGraphic('thanks')}\n          />\n        </GraphicSection>\n      </div>\n\n      {/* Main Preview */}\n      <div className=\"flex-1 flex flex-col overflow-hidden\">\n        <div className=\"px-6 py-4 bg-zinc-900 border-b border-zinc-800 flex items-center gap-4\">\n          <h2 className=\"text-lg font-semibold text-white flex-1\">{graphicTitles[currentGraphic]}</h2>\n          <button\n            onClick={() => window.open(currentUrl, '_blank')}\n            className=\"px-4 py-2 bg-zinc-800 text-zinc-300 text-sm rounded-lg hover:bg-zinc-700 transition-colors\"\n          >\n            Open Full Size\n          </button>\n          <button\n            onClick={() => copyUrl(currentGraphic)}\n            className=\"px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-500 transition-colors\"\n          >\n            Copy URL\n          </button>\n        </div>\n\n        <div className=\"flex-1 flex items-center justify-center bg-zinc-950 p-6\">\n          <div\n            className={`relative w-[960px] h-[540px] rounded-lg overflow-hidden shadow-2xl ${\n              isTransparent ? 'bg-checkered' : 'bg-black'\n            }`}\n            style={isTransparent ? {\n              background: 'repeating-conic-gradient(#222 0% 25%, #1a1a1a 0% 50%) 50% / 20px 20px'\n            } : {}}\n          >\n            <iframe\n              src={currentUrl}\n              className=\"w-[1920px] h-[1080px] origin-top-left\"\n              style={{ transform: 'scale(0.5)' }}\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Config Panel */}\n      <div className=\"w-80 bg-zinc-900 border-l border-zinc-800 p-5 overflow-y-auto flex-shrink-0\">\n        {/* Dynamic tabs based on team count */}\n        <div className=\"flex flex-wrap gap-1 mb-4\">\n          <button\n            onClick={() => setActiveTab('meet')}\n            className={`px-3 py-2 text-xs font-medium rounded-lg transition-colors ${\n              activeTab === 'meet'\n                ? 'bg-blue-600 text-white'\n                : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'\n            }`}\n          >\n            Meet\n          </button>\n          {/* Generate team tabs dynamically based on teamCount */}\n          {Array.from({ length: teamCount }, (_, i) => i + 1).map((num) => (\n            <button\n              key={`team${num}`}\n              onClick={() => setActiveTab(`team${num}`)}\n              className={`px-3 py-2 text-xs font-medium rounded-lg transition-colors ${\n                activeTab === `team${num}`\n                  ? 'bg-blue-600 text-white'\n                  : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'\n              }`}\n            >\n              T{num}\n            </button>\n          ))}\n          <button\n            onClick={() => setActiveTab('urls')}\n            className={`px-3 py-2 text-xs font-medium rounded-lg transition-colors ${\n              activeTab === 'urls'\n                ? 'bg-blue-600 text-white'\n                : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'\n            }`}\n          >\n            URLs\n          </button>\n        </div>\n\n        {/* Competition type indicator */}\n        {config?.compType && (\n          <div className=\"mb-4 px-2 py-1.5 bg-zinc-800 rounded text-xs text-zinc-400\">\n            {config.compType.replace('-', ' ').replace(/\\b\\w/g, l => l.toUpperCase())} ({teamCount} teams)\n          </div>\n        )}\n\n        {activeTab === 'meet' && (\n          <div>\n            <ConfigInput label=\"Event Name\" value={formData.eventName} onChange={(v) => updateFormData({ eventName: v })} />\n            <ConfigInput label=\"Meet Date\" value={formData.meetDate} onChange={(v) => updateFormData({ meetDate: v })} />\n            <ConfigInput label=\"Venue\" value={formData.venue} onChange={(v) => updateFormData({ venue: v })} />\n            <ConfigInput label=\"Location\" value={formData.location} onChange={(v) => updateFormData({ location: v })} />\n            <ConfigTextarea label=\"Hosts (one per line)\" value={formData.hosts} onChange={(v) => updateFormData({ hosts: v })} />\n          </div>\n        )}\n\n        {/* Dynamic team tabs - render for each team in the competition */}\n        {Array.from({ length: teamCount }, (_, i) => i + 1).map((num) => (\n          activeTab === `team${num}` && (\n            <div key={`team${num}-content`}>\n              <h3 className=\"text-sm font-semibold text-zinc-300 mb-3\">Team {num}</h3>\n              <ConfigInput\n                label=\"Team Name\"\n                value={formData[`team${num}Name`]}\n                onChange={(v) => updateFormData({ [`team${num}Name`]: v })}\n              />\n              <ConfigInput\n                label=\"Logo URL\"\n                value={formData[`team${num}Logo`]}\n                onChange={(v) => updateFormData({ [`team${num}Logo`]: v })}\n                placeholder=\"https://...\"\n              />\n              <div className=\"grid grid-cols-2 gap-2\">\n                <ConfigInput\n                  label=\"AVE\"\n                  value={formData[`team${num}Ave`]}\n                  onChange={(v) => updateFormData({ [`team${num}Ave`]: v })}\n                />\n                <ConfigInput\n                  label=\"HIGH\"\n                  value={formData[`team${num}High`]}\n                  onChange={(v) => updateFormData({ [`team${num}High`]: v })}\n                />\n              </div>\n              <ConfigTextarea\n                label=\"Coaches (one per line)\"\n                value={formData[`team${num}Coaches`]}\n                onChange={(v) => updateFormData({ [`team${num}Coaches`]: v })}\n                rows={3}\n              />\n              {compId && num <= 2 && (\n                <button\n                  onClick={handleRefreshTeamData}\n                  disabled={refreshing}\n                  className=\"w-full px-3 py-2 text-xs bg-zinc-700 text-zinc-300 rounded-lg hover:bg-zinc-600 transition-colors disabled:opacity-50\"\n                >\n                  {refreshing ? 'Fetching...' : 'Fetch Team Data from RTN'}\n                </button>\n              )}\n            </div>\n          )\n        ))}\n\n        {activeTab === 'urls' && (\n          <div>\n            <p className=\"text-xs text-zinc-500 mb-4\">Copy these URLs into OBS as Browser Sources (1920x1080)</p>\n            <div className=\"space-y-2 max-h-[400px] overflow-y-auto\">\n              {Object.keys(graphicTitles).map((g) => (\n                <div key={g} className=\"bg-zinc-950 border border-zinc-800 rounded-lg p-3\">\n                  <div className=\"flex justify-between items-center mb-1\">\n                    <span className=\"text-xs font-semibold text-zinc-300\">{graphicTitles[g]}</span>\n                    <button\n                      onClick={() => copyUrl(g)}\n                      className=\"px-2 py-1 text-xs bg-blue-600 text-white rounded hover:bg-blue-500 transition-colors\"\n                    >\n                      Copy\n                    </button>\n                  </div>\n                  <div className=\"text-[10px] text-zinc-600 break-all\">{generateURL(g)}</div>\n                </div>\n              ))}\n            </div>\n            <button\n              onClick={copyAllUrls}\n              className=\"w-full mt-4 px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-500 transition-colors\"\n            >\n              Copy All URLs\n            </button>\n          </div>\n        )}\n\n        {/* Save to Competition Button */}\n        {compId && (\n          <div className=\"mt-4 pt-4 border-t border-zinc-800\">\n            <button\n              onClick={saveToFirebase}\n              disabled={saving || !hasChanges}\n              className={`w-full px-4 py-3 text-sm font-semibold rounded-lg transition-colors ${\n                hasChanges\n                  ? 'bg-green-600 text-white hover:bg-green-500'\n                  : 'bg-zinc-700 text-zinc-400 cursor-not-allowed'\n              }`}\n            >\n              {saving ? 'Saving...' : hasChanges ? 'Save to Competition' : 'No Changes'}\n            </button>\n            {hasChanges && (\n              <p className=\"text-xs text-yellow-500 mt-2 text-center\">Unsaved changes</p>\n            )}\n          </div>\n        )}\n\n        <div className=\"mt-6 pt-4 border-t border-zinc-800\">\n          <div className=\"text-xs text-zinc-400 mb-2\">Current Graphic URL</div>\n          <div className=\"bg-zinc-950 border border-zinc-800 rounded-lg p-3 font-mono text-[10px] text-zinc-500 break-all max-h-24 overflow-y-auto\">\n            {currentUrl}\n          </div>\n          <button\n            onClick={() => copyUrl(currentGraphic)}\n            className=\"w-full mt-3 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-500 transition-colors\"\n          >\n            Copy URL for OBS\n          </button>\n        </div>\n      </div>\n\n      {/* Toast */}\n      {toast && (\n        <div className=\"fixed bottom-5 right-5 px-5 py-3 bg-green-500 text-white rounded-lg font-medium shadow-lg\">\n          {toast}\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction GraphicSection({ title, children }) {\n  return (\n    <div className=\"mb-5\">\n      <div className=\"text-xs font-semibold text-zinc-400 uppercase tracking-wide mb-2\">{title}</div>\n      <div className=\"space-y-1\">{children}</div>\n    </div>\n  );\n}\n\nfunction GraphicSidebarButton({ id, label, number, active, onClick }) {\n  return (\n    <button\n      onClick={onClick}\n      className={`w-full px-3 py-2.5 rounded-lg text-left text-sm transition-colors flex items-center gap-2 ${\n        active\n          ? 'bg-blue-600 text-white'\n          : 'bg-transparent border border-zinc-800 text-zinc-300 hover:bg-zinc-800'\n      }`}\n    >\n      <span className={`text-xs w-5 ${active ? 'text-blue-200' : 'text-zinc-500'}`}>{number}</span>\n      {label}\n    </button>\n  );\n}\n\nfunction ConfigInput({ label, value, onChange, placeholder }) {\n  return (\n    <div className=\"mb-4\">\n      <label className=\"block text-xs text-zinc-400 mb-1.5\">{label}</label>\n      <input\n        type=\"text\"\n        value={value || ''}\n        onChange={(e) => onChange(e.target.value)}\n        placeholder={placeholder}\n        className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n      />\n    </div>\n  );\n}\n\nfunction ConfigTextarea({ label, value, onChange, rows = 2 }) {\n  return (\n    <div className=\"mb-4\">\n      <label className=\"block text-xs text-zinc-400 mb-1.5\">{label}</label>\n      <textarea\n        value={value || ''}\n        onChange={(e) => onChange(e.target.value)}\n        rows={rows}\n        className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500 resize-none\"\n      />\n    </div>\n  );\n}\n","numLines":725,"startLine":1,"totalLines":725}}}
{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01RJWrVsKMARxiNexKjFh5r2","type":"message","role":"assistant","content":[{"type":"text","text":"Now I have a complete picture. Let me create the todo list and start implementing T6.\n\n```\n2.4 Target Code Read\n- Current code does: UrlGeneratorPage displays graphic selector sidebar, preview iframe, and config panel. Uses generateGraphicURL to build URLs with formData.\n- Change needed: \n  1. Import useTeamsDatabase hook\n  2. Add 3 sponsor entries to baseGraphicTitles\n  3. Add Sponsors sidebar section after Stream section (line 457)\n  4. Add resolveHomeTeamKey helper function\n  5. Modify generateURLWithOptions to thread sponsors JSON through options\n- Lines affected: imports (~7), baseGraphicTitles (101), sidebar (457), generateURLWithOptions (297-304)\n```"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":11278,"cache_read_input_tokens":31135,"cache_creation":{"ephemeral_5m_input_tokens":11278,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e4de8b66-3803-4327-8dd8-d489c6260f11","uuid":"a4ec23d7-2188-4c69-b6fc-002352aff5e9"}
