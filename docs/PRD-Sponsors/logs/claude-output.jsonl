y < h; y++) {\n        for (let x = 0; x < w; x++) {\n          const a = d[(y * w + x) * 4 + 3];\n          if (a > alphaThreshold) {\n            if (y < top) top = y;\n            if (y > bottom) bottom = y;\n            if (x < left) left = x;\n            if (x > right) right = x;\n          }\n        }\n      }\n\n      // Check if Pass 1 found meaningful content (smaller than full image)\n      const pass1Found = top <= bottom && left <= right;\n      const pass1IsFullImage = pass1Found && top === 0 && left === 0 && bottom === h - 1 && right === w - 1;\n\n      // If Pass 1 found content smaller than full image, use it (logo has transparency)\n      if (pass1Found && !pass1IsFullImage) {\n        const padX = Math.round((right - left) * 0.02);\n        const padY = Math.round((bottom - top) * 0.02);\n        return {\n          x: Math.max(0, left - padX),\n          y: Math.max(0, top - padY),\n          w: Math.min(w, right - left + padX * 2),\n          h: Math.min(h, bottom - top + padY * 2),\n        };\n      }\n\n      // Pass 2: Full opaque image detected - scan for non-white pixels\n      // This handles JPEGs and PNGs with white backgrounds\n      top = h; bottom = 0; left = w; right = 0;\n      for (let y = 0; y < h; y++) {\n        for (let x = 0; x < w; x++) {\n          const idx = (y * w + x) * 4;\n          const r = d[idx];\n          const g = d[idx + 1];\n          const b = d[idx + 2];\n          // Pixel is \"content\" if it's NOT near-white\n          const isNearWhite = r > whiteThreshold && g > whiteThreshold && b > whiteThreshold;\n          if (!isNearWhite) {\n            if (y < top) top = y;\n            if (y > bottom) bottom = y;\n            if (x < left) left = x;\n            if (x > right) right = x;\n          }\n        }\n      }\n\n      // Check if Pass 2 found content smaller than full image\n      const pass2Found = top <= bottom && left <= right;\n      const pass2IsFullImage = pass2Found && top === 0 && left === 0 && bottom === h - 1 && right === w - 1;\n\n      // If Pass 2 found meaningful content (smaller than full), use it\n      if (pass2Found && !pass2IsFullImage) {\n        const padX = Math.round((right - left) * 0.02);\n        const padY = Math.round((bottom - top) * 0.02);\n        return {\n          x: Math.max(0, left - padX),\n          y: Math.max(0, top - padY),\n          w: Math.min(w, right - left + padX * 2),\n          h: Math.min(h, bottom - top + padY * 2),\n        };\n      }\n\n      // Fallback: no trimming possible (colored background or all-white image)\n      return { x: 0, y: 0, w, h };\n    }"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":344,"cache_read_input_tokens":42978,"cache_creation":{"ephemeral_5m_input_tokens":344,"ephemeral_1h_input_tokens":0},"output_tokens":1549,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"7ea1db2c-89c7-412f-b1f0-dadd8edabc6c","uuid":"7b2bb91b-3c47-455c-b1f5-1573432b0209"}
