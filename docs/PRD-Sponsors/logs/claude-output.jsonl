5→    const showBounds = params.get('showBounds') === 'true';\n   176→    const showGuides = params.get('showGuides') === 'true';\n   177→\n   178→    // Show guide overlay if requested\n   179→    if (showGuides) {\n   180→      document.getElementById('guides-overlay').classList.add('visible');\n   181→    }\n   182→\n   183→    let sponsors = [];\n   184→    if (sponsorsParam) {\n   185→      try {\n   186→        sponsors = JSON.parse(sponsorsParam);\n   187→        if (!Array.isArray(sponsors)) sponsors = [];\n   188→      } catch (e) { sponsors = []; }\n   189→    }\n   190→\n   191→    const container = document.getElementById('container');\n   192→    let currentIndex = 0;\n   193→    let slides = [];\n   194→\n   195→    // Detect content bounding box by scanning for non-transparent pixels\n   196→    function getContentBounds(imageData, w, h) {\n   197→      const d = imageData.data;\n   198→      let top = h, bottom = 0, left = w, right = 0;\n   199→      const alphaThreshold = 20;\n   200→\n   201→      for (let y = 0; y < h; y++) {\n   202→        for (let x = 0; x < w; x++) {\n   203→          const a = d[(y * w + x) * 4 + 3];\n   204→          if (a > alphaThreshold) {\n   205→            if (y < top) top = y;\n   206→            if (y > bottom) bottom = y;\n   207→            if (x < left) left = x;\n   208→            if (x > right) right = x;\n   209→          }\n   210→        }\n   211→      }\n   212→\n   213→      if (top > bottom || left > right) {\n   214→        return { x: 0, y: 0, w, h }; // Fallback: use entire image\n   215→      }\n   216→\n   217→      // Add small padding (2% of content size)\n   218→      const padX = Math.round((right - left) * 0.02);\n   219→      const padY = Math.round((bottom - top) * 0.02);\n   220→      return {\n   221→        x: Math.max(0, left - padX),\n   222→        y: Math.max(0, top - padY),\n   223→        w: Math.min(w, right - left + padX * 2),\n   224→        h: Math.min(h, bottom - top + padY * 2),\n   225→      };\n   226→    }\n   227→\n   228→    // Get effective bounds: use crop overrides if provided, otherwise auto-detect\n   229→    function getEffectiveBounds(img, sponsor, autoBounds) {\n   230→      // If sponsor has crop overrides, use them (values are in pixels relative to original image)\n   231→      if (sponsor.cropX != null || sponsor.cropY != null || sponsor.cropW != null || sponsor.cropH != null) {\n   232→        return {\n   233→          x: sponsor.cropX ?? autoBounds.x,\n   234→          y: sponsor.cropY ?? autoBounds.y,\n   235→          w: sponsor.cropW ?? autoBounds.w,\n   236→          h: sponsor.cropH ?? autoBounds.h,\n   237→        };\n   238→      }\n   239→      return autoBounds;\n   240→    }\n   241→\n   242→    // Render a trimmed, uniformly-sized logo onto a canvas\n   243→    // Returns { canvas, autoBounds, usedBounds } for bounds visualization\n   244→    function renderTrimmedLogo(img, sponsor) {\n   245→      // Draw full image to offscreen canvas for pixel scanning\n   246→      const offscreen = document.createElement('canvas');\n   247→      offscreen.width = img.naturalWidth;\n   248→      offscreen.height = img.naturalHeight;\n   249→      const octx = offscreen.getContext('2d');\n   250→      octx.drawImage(img, 0, 0);\n   251→\n   252→      let autoBounds;\n   253→      try {\n   254→        const imageData = octx.getImageData(0, 0, offscreen.width, offscreen.height);\n   255→        autoBounds = getContentBounds(imageData, offscreen.width, offscreen.height);\n   256→      } catch (e) {\n   257→        // CORS blocked — fall back to full image\n   258→        autoBounds = { x: 0, y: 0, w: img.naturalWidth, h: img.naturalHeight };\n   259→      }\n   260→\n   261→      const usedBounds = getEffectiveBounds(img, sponsor || {}, autoBounds);\n   262→\n   263→      // Scale content to TARGET_HEIGHT, maintaining aspect ratio\n   264→      const scale = TARGET_HEIGHT / usedBounds.h;\n   265→      const outW = Math.round(usedBounds.w * scale);\n   266→      const outH = TARGET_HEIGHT;\n   267→\n   268→      const canvas = document.createElement('canvas');\n   269→      canvas.width = outW;\n   270→      canvas.height = outH;\n   271→      const ctx = canvas.getContext('2d');\n   272→      ctx.imageSmoothingEnabled = true;\n   273→      ctx.imageSmoothingQuality = 'high';\n   274→      ctx.drawImage(img, usedBounds.x, usedBounds.y, usedBounds.w, usedBounds.h, 0, 0, outW, outH);\n   275→\n   276→      return { canvas, autoBounds, usedBounds };\n   277→    }\n   278→\n   279→    // Apply per-sponsor overrides (scale, offsetX, offsetY) to a canvas element\n   280→    function applyOverrides(canvas, sponsor) {\n   281→      const scale = (sponsor.scale || 100) / 100;\n   282→      const ox = sponsor.offsetX || 0;\n   283→      const oy = sponsor.offsetY || 0;\n   284→      if (scale !== 1) {\n   285→        canvas.style.width = Math.round(canvas.width * scale) + 'px';\n   286→        canvas.style.height = Math.round(canvas.height * scale) + 'px';\n   287→      }\n   288→      if (ox || oy) {\n   289→        canvas.style.transform = `translate(${ox}px, ${oy}px)`;\n   290→      }\n   291→    }\n   292→\n   293→    // Draw bounding box overlays on a slide\n   294→    function drawBoundsOverlay(slide, canvas, autoBounds, usedBounds, sponsor) {\n   295→      // We need to show bounds relative to the rendered canvas position\n   296→      // The canvas is centered in the slide, so compute its position\n   297→      const scale = (sponsor.scale || 100) / 100;\n   298→      const canvasDisplayW = canvas.width * scale;\n   299→      const canvasDisplayH = canvas.height * scale;\n   300→      const ox = sponsor.offsetX || 0;\n   301→      const oy = sponsor.offsetY || 0;\n   302→\n   303→      // Canvas is centered in the 1920x1080 slide\n   304→      const canvasLeft = (1920 - canvasDisplayW) / 2 + ox;\n   305→      const canvasTop = (1080 - canvasDisplayH) / 2 + oy;\n   306→\n   307→      // Sh