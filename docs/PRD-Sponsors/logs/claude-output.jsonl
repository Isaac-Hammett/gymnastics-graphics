{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013uEKmw6oaY9S7J3JHTD7o4","type":"tool_result","content":"     1→import { useEffect, useState, useCallback } from 'react';\n     2→import { db, ref, onValue, set, update, get } from '../lib/firebase';\n     3→import {\n     4→  normalizeName,\n     5→  getSafeFirebaseKey,\n     6→  getLookupKeys,\n     7→} from '../lib/nameNormalization';\n     8→\n     9→/**\n    10→ * Firebase-backed teams database hook\n    11→ * Stores team logos, rosters, and athlete headshots in Firebase\n    12→ *\n    13→ * Firebase structure:\n    14→ * teamsDatabase/\n    15→ *   teams/\n    16→ *     {teamKey}/  (e.g., 'army-mens', 'cal-womens')\n    17→ *       displayName: \"Army Men's\"\n    18→ *       school: \"Army\"\n    19→ *       gender: \"mens\"\n    20→ *       logo: \"https://media.virti.us/...\"\n    21→ *       roster: [\"Ben Aguilar\", \"Carter Beck\", ...]\n    22→ *   headshots/\n    23→ *     {normalizedName}/  (e.g., 'ben aguilar')\n    24→ *       url: \"https://media.virti.us/...\"\n    25→ *       teamKey: \"army-mens\"  (optional, for reference)\n    26→ *   aliases/\n    27→ *     {alias}: {schoolKey}  (e.g., 'california': 'cal')\n    28→ *\n    29→ * Name normalization is handled by the shared nameNormalization.js utility\n    30→ * to ensure consistent matching across all components.\n    31→ */\n    32→\n    33→/**\n    34→ * Hook to access and manage the teams database in Firebase\n    35→ */\n    36→export function useTeamsDatabase() {\n    37→  const [teams, setTeams] = useState({});\n    38→  const [headshots, setHeadshots] = useState({});\n    39→  const [aliases, setAliases] = useState({});\n    40→  const [sponsors, setSponsors] = useState({});\n    41→  const [loading, setLoading] = useState(true);\n    42→  const [error, setError] = useState(null);\n    43→\n    44→  // Subscribe to teams database\n    45→  useEffect(() => {\n    46→    const teamsRef = ref(db, 'teamsDatabase/teams');\n    47→    const headshotsRef = ref(db, 'teamsDatabase/headshots');\n    48→    const aliasesRef = ref(db, 'teamsDatabase/aliases');\n    49→    const sponsorsRef = ref(db, 'teamsDatabase/sponsors');\n    50→\n    51→    let loadedCount = 0;\n    52→    const checkLoaded = () => {\n    53→      loadedCount++;\n    54→      if (loadedCount >= 4) setLoading(false);\n    55→    };\n    56→\n    57→    const unsubTeams = onValue(teamsRef, (snapshot) => {\n    58→      setTeams(snapshot.val() || {});\n    59→      checkLoaded();\n    60→    }, (err) => {\n    61→      setError(err.message);\n    62→      checkLoaded();\n    63→    });\n    64→\n    65→    const unsubHeadshots = onValue(headshotsRef, (snapshot) => {\n    66→      setHeadshots(snapshot.val() || {});\n    67→      checkLoaded();\n    68→    }, (err) => {\n    69→      setError(err.message);\n    70→      checkLoaded();\n    71→    });\n    72→\n    73→    const unsubAliases = onValue(aliasesRef, (snapshot) => {\n    74→      setAliases(snapshot.val() || {});\n    75→      checkLoaded();\n    76→    }, (err) => {\n    77→      setError(err.message);\n    78→      checkLoaded();\n    79→    });\n    80→\n    81→    const unsubSponsors = onValue(sponsorsRef, (snapshot) => {\n    82→      setSponsors(snapshot.val() || {});\n    83→      checkLoaded();\n    84→    }, (err) => {\n    85→      setError(err.message);\n    86→      checkLoaded();\n    87→    });\n    88→\n    89→    return () => {\n    90→      unsubTeams();\n    91→      unsubHeadshots();\n    92→      unsubAliases();\n    93→      unsubSponsors();\n    94→    };\n    95→  }, []);\n    96→\n    97→  // ============================================\n    98→  // TEAM OPERATIONS\n    99→  // ============================================\n   100→  // IMPORTANT: Team keys use hyphens (e.g., \"army-mens\") and should NOT be\n   101→  // run through normalizeName() which converts hyphens to spaces.\n   102→  // Team keys are stored as-is in Firebase.\n   103→\n   104→  /**\n   105→   * Add or update a team\n   106→   * @param {string} teamKey - Team key with hyphens (e.g., \"army-mens\")\n   107→   */\n   108→  const saveTeam = useCallback(async (teamKey, teamData) => {\n   109→    try {\n   110→      // Use teamKey directly - do NOT normalize (hyphens are intentional)\n   111→      await set(ref(db, `teamsDatabase/teams/${teamKey}`), {\n   112→        displayName: teamData.displayName,\n   113→        school: teamData.school,\n   114→        gender: teamData.gender,\n   115→        logo: teamData.logo || '',\n   116→        roster: teamData.roster || [],\n   117→        updatedAt: new Date().toISOString(),\n   118→      });\n   119→      return { success: true };\n   120→    } catch (err) {\n   121→      return { success: false, error: err.message };\n   122→    }\n   123→  }, []);\n   124→\n   125→  /**\n   126→   * Update team logo\n   127→   * @param {string} teamKey - Team key with hyphens (e.g., \"army-mens\")\n   128→   */\n   129→  const updateTeamLogo = useCallback(async (teamKey, logoUrl) => {\n   130→    try {\n   131→      // Use teamKey directly - do NOT normalize\n   132→      await update(ref(db, `teamsDatabase/teams/${teamKey}`), {\n   133→        logo: logoUrl,\n   134→        updatedAt: new Date().toISOString(),\n   135→      });\n   136→      return { success: true };\n   137→    } catch (err) {\n   138→      return { success: false, error: err.message };\n   139→    }\n   140→  }, []);\n   141→\n   142→  /**\n   143→   * Update team roster (array of athlete names)\n   144→   * @param {string} teamKey - Team key with hyphens (e.g., \"army-mens\")\n   145→   */\n   146→  const updateTeamRoster = useCallback(async (teamKey, roster) => {\n   147→    try {\n   148→      // Use teamKey directly - do NOT normalize\n   149→      await update(ref(db, `teamsDatabase/teams/${teamKey}`), {\n   150→        roster: roster,\n   151→        updatedAt: new Date().toISOString(),\n   152→      });\n   153→      return { success: true };\n   154→    } catch (err) {\n   155→      return { success: false, error: err.message };\n   156→    }\n   157→  }, []);\n   158→\n   159→  // ============================================\n   160→  // HEADSHOT OPERATIONS\n   161→  // ============================================\n   162→\n   163→  /**\n   164→   * Save a single athlete headshot\n   165→   * Uses unified normalization from nameNormalization.js\n   166→   */\n   167→  const saveHeadshot = useCallback(async (athleteName, headshotUrl, teamKey = null) => {\n   168→    try {\n   169→      const normalized = normalizeName(athleteName);\n   170→      // Firebase keys can't contain . # $ [ ] / so we encode them\n   171→      const safeKey = getSafeFirebaseKey(normalized);\n   172→      await set(ref(db, `teamsDatabase/headshots/${safeKey}`), {\n   173→        name: athleteName,  // Store original name for display\n   174→        url: headshotUrl,\n   175→        teamKey: teamKey,\n   176→        updatedAt: new Date().toISOString(),\n   177→      });\n   178→      return { success: true };\n   179→    } catch (err) {\n   180→      return { success: false, error: err.message };\n   181→    }\n   182→  }, []);\n   183→\n   184→  /**\n   185→   * Save multiple headshots at once (batch operation)\n   186→   * Uses unified normalization from nameNormalization.js\n   187→   */\n   188→  const saveHeadshots = useCallback(async (headshotsArray, teamKey = null) => {\n   189→    try {\n   190→      const updates = {};\n   191→      for (const { name, headshotUrl, rtnId } of headshotsArray) {\n   192→        const normalized = normalizeName(name);\n   193→        const safeKey = getSafeFirebaseKey(normalized);\n   194→        const entry = {\n   195→          name: name,  // Store original name for display\n   196→          url: headshotUrl,\n   197→          teamKey: teamKey,\n   198→          updatedAt: new Date().toISOString(),\n   199→        };\n   200→        if (rtnId) {\n   201→          entry.rtnId = String(rtnId);\n   202→        }\n   203→        updates[`teamsDatabase/headshots/${safeKey}`] = entry;\n   204→      }\n   205→\n   206→      // Use update with full paths for atomic batch write\n   207→      const rootRef = ref(db);\n   208→      await update(rootRef, updates);\n   209→      return { success: true, count: headshotsArray.length };\n   210→    } catch (err) {\n   211→      return { success: false, error: err.message };\n   212→    }\n   213→  }, []);\n   214→\n   215→  /**\n   216→   * Import a full roster with headshots from parsed Virtius data\n   217→   * Note: Team key is used as-is (not normalized) since Firebase stores\n   218→   * team keys with hyphens (e.g., \"army-mens\")\n   219→   */\n   220→  const importRoster = useCallback(async (teamKey, athletes) => {\n   221→    try {\n   222→      // Team key is used directly - do NOT normalize (hyphens are intentional)\n   223→      // 1. Update team roster with athlete names\n   224→      const rosterNames = athletes.map(a => a.name);\n   225→      await update(ref(db, `teamsDatabase/teams/${teamKey}`), {\n   226→        roster: rosterNames,\n   227→        updatedAt: new Date().toISOString(),\n   228→      });\n   229→\n   230→      // 2. Save all headshots (including RTN IDs if available from Virtius)\n   231→      const headshotsToSave = athletes.map(a => ({\n   232→        name: a.name,\n   233→        headshotUrl: a.headshotUrl,\n   234→        rtnId: a.rtnId || null,\n   235→      }));\n   236→      await saveHeadshots(headshotsToSave, teamKey);\n   237→\n   238→      // Log warnings for athletes missing RTN IDs\n   239→      const missingRtnIds = athletes.filter(a => !a.rtnId);\n   240→      if (missingRtnIds.length > 0) {\n   241→        console.warn(`[importRoster] ${missingRtnIds.length}/${athletes.length} athletes missing RTN IDs for ${teamKey}:`, missingRtnIds.map(a => a.name));\n   242→      }\n   243→\n   244→      return { success: true, athleteCount: athletes.length };\n   245→    } catch (err) {\n   246→      return { success: false, error: err.message };\n   247→    }\n   248→  }, [saveHeadshots]);\n   249→\n   250→  // ============================================\n   251→  // SPONSOR OPERATIONS\n   252→  // ============================================\n   253→\n   254→  /**\n   255→   * Add or update a sponsor for a specific team\n   256→   * @param {string} teamKey - Team key (e.g., \"penn-state-mens\")\n   257→   * @param {string} sponsorKey - URL-safe key (e.g., \"nike\", \"state-farm\")\n   258→   * @param {Object} sponsorData - { name, url, tier, order }\n   259→   */\n   260→  const saveSponsor = useCallback(async (teamKey, sponsorKey, sponsorData) => {\n   261→    try {\n   262→      await set(ref(db, `teamsDatabase/sponsors/${teamKey}/${sponsorKey}`), {\n   263→        name: sponsorData.name,\n   264→        url: sponsorData.url,\n   265→        tier: sponsorData.tier || 'official',\n   266→        order: sponsorData.order ?? 0,\n   267→        updatedAt: new Date().toISOString(),\n   268→      });\n   269→      return { success: true };\n   270→    } catch (err) {\n   271→      return { success: false, error: err.message };\n   272→    }\n   273→  }, []);\n   274→\n   275→  /**\n   276→   * Delete a sponsor for a specific team\n   277→   * @param {string} teamKey - Team key (e.g., \"penn-state-mens\")\n   278→   * @param {string} sponsorKey - Sponsor key to delete\n   279→   */\n   280→  const deleteSponsor = useCallback(async (teamKey, sponsorKey) => {\n   281→    try {\n   282→      await set(ref(db, `teamsDatabase/sponsors/${teamKey}/${sponsorKey}`), null);\n   283→      return { success: true };\n   284→    } catch (err) {\n   285→      return { success: false, error: err.message };\n   286→    }\n   287→  }, []);\n   288→\n   289→  /**\n   290→   * Reorder sponsors for a specific team by updating their order values\n   291→   * @param {string} teamKey - Team key (e.g., \"penn-state-mens\")\n   292→   * @param {string[]} orderedKeys - Array of sponsor keys in desired order\n   293→   */\n   294→  const reorderSponsors = useCallback(async (teamKey, orderedKeys) => {\n   295→    try {\n   296→      const updates = {};\n   297→      orderedKeys.forEach((key, index) => {\n   298→        updates[`teamsDatabase/sponsors/${teamKey}/${key}/order`] = index;\n   299→        updates[`teamsDatabase/sponsors/${teamKey}/${key}/updatedAt`] = new Date().toISOString();\n   300→      });\n   301→      const rootRef = ref(db);\n   302→      await update(rootRef, updates);\n   303→      return { success: true };\n   304→    } catch (err) {\n   305→      return { success: false, error: err.message };\n   306→    }\n   307→  }, []);\n   308→\n   309→  // ============================================\n   310→  // QUERY HELPERS\n   311→  // ============================================\n   312→\n   313→  /**\n   314→   * Get team by key\n   315→   * Note: Team keys should NOT be normalized - they use hyphens (e.g., \"army-mens\")\n   316→   * and are stored as-is in Firebase\n   317→   */\n   318→  const getTeam = useCallback((teamKey) => {\n   319→    if (!teamKey) return null;\n   320→    // Direct lookup - team keys are stored with hyphens, not normalized\n   321→    return teams[teamKey] || null;\n   322→  }, [teams]);\n   323→\n   324→  /**\n   325→   * Get team logo with flexible matching\n   326→   * @param {string} teamName - Team name in any format\n   327→   * @param {'womens' | 'mens' | null} preferredGender - Preferred gender for fallback lookup\n   328→   */\n   329→  const getTeamLogo = useCallback((teamName, preferredGender = null) => {\n   330→    if (!teamName) return '';\n   331→\n   332→    const normalized = normalizeName(teamName);\n   333→\n   334→    // Direct match\n   335→    if (teams[normalized]) return teams[normalized].logo || '';\n   336→\n   337→    // Try with -mens/-womens suffix removed\n   338→    const withoutGender = normalized\n   339→      .replace(/-mens$/, '')\n   340→      .replace(/-womens$/, '')\n   341→      .replace(/ men'?s?$/i, '')\n   342→      .replace(/ women'?s?$/i, '');\n   343→\n   344→    // Determine lookup order based on preferredGender\n   345→    const genderOrder = preferredGender === 'womens'\n   346→      ? ['womens', 'mens']\n   347→      : ['mens', 'womens'];\n   348→\n   349→    // Check aliases\n   350→    const aliasKey = aliases[withoutGender];\n   351→    if (aliasKey) {\n   352→      for (const gender of genderOrder) {\n   353→        const team = teams[`${aliasKey}-${gender}`];\n   354→        if (team?.logo) return team.logo;\n   355→      }\n   356→    }\n   357→\n   358→    // Try direct school match with gender preference\n   359→    for (const gender of genderOrder) {\n   360→      if (teams[`${withoutGender}-${gender}`]?.logo) {\n   361→        return teams[`${withoutGender}-${gender}`].logo;\n   362→      }\n   363→    }\n   364→\n   365→    return '';\n   366→  }, [teams, aliases]);\n   367→\n   368→  /**\n   369→   * Get athlete headshot URL using flexible lookup\n   370→   * Tries multiple normalized keys to handle accents, hyphens, etc.\n   371→   *\n   372→   * Lookup order (optimized for speed):\n   373→   * 1. Safe Firebase key (most likely match - this is how we save)\n   374→   * 2. Normalized name (fallback for legacy data)\n   375→   * 3. Extended keys for edge cases (accents, middle names, etc.)\n   376→   */\n   377→  const getHeadshot = useCallback((athleteName) => {\n   378→    if (!athleteName) return '';\n   379→\n   380→    // Primary lookup: normalize name and convert to safe Firebase key\n   381→    // This matches how saveHeadshot() stores the data\n   382→    const normalized = normalizeName(athleteName);\n   383→    const safeKey = getSafeFirebaseKey(normalized);\n   384→\n   385→    // Try safe key first (this is how we save headshots)\n   386→    if (headshots[safeKey]?.url) {\n   387→      return headshots[safeKey].url;\n   388→    }\n   389→\n   390→    // Fallback: try normalized name without safe key transformation\n   391→    // (handles legacy data or data imported differently)\n   392→    if (headshots[normalized]?.url) {\n   393→      return headshots[normalized].url;\n   394→    }\n   395→\n   396→    // Extended fallback: use getLookupKeys for edge cases (accents, middle names, etc.)\n   397→    const parts = athleteName.trim().split(/\\s+/);\n   398→    const firstName = parts[0] || '';\n   399→    const lastName = parts.slice(1).join(' ') || '';\n   400→    const keys = getLookupKeys(firstName, lastName);\n   401→\n   402→    for (const key of keys) {\n   403→      const keySafe = getSafeFirebaseKey(key);\n   404→      if (headshots[keySafe]?.url) {\n   405→        return headshots[keySafe].url;\n   406→      }\n   407→      if (headshots[key]?.url) {\n   408→        return headshots[key].url;\n   409→      }\n   410→    }\n   411→\n   412→    return '';\n   413→  }, [headshots]);\n   414→\n   415→  /**\n   416→   * Check if athlete has a headshot\n   417→   */\n   418→  const hasHeadshot = useCallback((athleteName) => {\n   419→    return !!getHeadshot(athleteName);\n   420→  }, [getHeadshot]);\n   421→\n   422→  /**\n   423→   * Get roster with headshot info for a team\n   424→   */\n   425→  const getTeamRosterWithHeadshots = useCallback((teamKey) => {\n   426→    const team = getTeam(teamKey);\n   427→    if (!team?.roster) return [];\n   428→\n   429→    return team.roster.map(name => {\n   430→      const normalized = normalizeName(name);\n   431→      const safeKey = getSafeFirebaseKey(normalized);\n   432→      const headshotEntry = headshots[safeKey];\n   433→      return {\n   434→        name,\n   435→        hasHeadshot: hasHeadshot(name),\n   436→        headshotUrl: getHeadshot(name),\n   437→        rtnId: headshotEntry?.rtnId || null,\n   438→      };\n   439→    });\n   440→  }, [getTeam, hasHeadshot, getHeadshot, headshots]);\n   441→\n   442→  /**\n   443→   * Get roster stats for a team\n   444→   */\n   445→  const getTeamRosterStats = useCallback((teamKey) => {\n   446→    const roster = getTeamRosterWithHeadshots(teamKey);\n   447→    const withHeadshots = roster.filter(a => a.hasHeadshot).length;\n   448→    return {\n   449→      total: roster.length,\n   450→      withHeadshots,\n   451→      percentage: roster.length > 0 ? Math.round((withHeadshots / roster.length) * 100) : 0,\n   452→    };\n   453→  }, [getTeamRosterWithHeadshots]);\n   454→\n   455→  /**\n   456→   * Resolve a team name to a school key (handles aliases and variations)\n   457→   * E.g., \"California\" -> \"cal\", \"Penn State\" -> \"penn-state\"\n   458→   */\n   459→  const resolveSchoolKey = useCallback((teamName) => {\n   460→    if (!teamName) return null;\n   461→\n   462→    const normalized = normalizeName(teamName)\n   463→      .replace(/ men'?s?$/i, '')\n   464→      .replace(/ women'?s?$/i, '')\n   465→      .replace(/-mens$/, '')\n   466→      .replace(/-womens$/, '');\n   467→\n   468→    // Check aliases first\n   469→    if (aliases[normalized]) {\n   470→      return aliases[normalized];\n   471→    }\n   472→\n   473→    // Check if any team key starts with this school name\n   474→    const possibleKeys = Object.keys(teams).filter(key =>\n   475→      key.startsWith(normalized + '-') ||\n   476→      key === normalized\n   477→    );\n   478→\n   479→    if (possibleKeys.length > 0) {\n   480→      // Extract school part from key (e.g., \"penn-state-mens\" -> \"penn-state\")\n   481→      return possibleKeys[0].replace(/-mens$/, '').replace(/-womens$/, '');\n   482→    }\n   483→\n   484→    // Try converting spaces to dashes\n   485→    const dashedName = normalized.replace(/ /g, '-');\n   486→    if (aliases[dashedName]) {\n   487→      return aliases[dashedName];\n   488→    }\n   489→\n   490→    const dashedPossibleKeys = Object.keys(teams).filter(key =>\n   491→      key.startsWith(dashedName + '-') ||\n   492→      key === dashedName\n   493→    );\n   494→\n   495→    if (dashedPossibleKeys.length > 0) {\n   496→      return dashedPossibleKeys[0].replace(/-mens$/, '').replace(/-womens$/, '');\n   497→    }\n   498→\n   499→    return null;\n   500→  }, [teams, aliases]);\n   501→\n   502→  /**\n   503→   * Get sorted sponsors for a specific team\n   504→   * @param {string} teamKey - Team key (e.g., \"penn-state-mens\")\n   505→   * @returns {Array<{key: string, name: string, url: string, tier: string, order: number}>}\n   506→   */\n   507→  const getTeamSponsors = useCallback((teamKey) => {\n   508→    if (!teamKey || !sponsors[teamKey]) return [];\n   509→    return Object.entries(sponsors[teamKey])\n   510→      .map(([key, data]) => ({\n   511→        key,\n   512→        name: data.name,\n   513→        url: data.logoUrl || data.url,\n   514→        tier: data.tier || 'official',\n   515→        order: data.order ?? 0,\n   516→      }))\n   517→      .sort((a, b) => a.order - b.order);\n   518→  }, [sponsors]);\n   519→\n   520→  /**\n   521→   * Get count of sponsors for a specific team\n   522→   * @param {string} teamKey - Team key (e.g., \"penn-state-mens\")\n   523→   * @returns {number}\n   524→   */\n   525→  const getTeamSponsorCount = useCallback((teamKey) => {\n   526→    if (!teamKey || !sponsors[teamKey]) return 0;\n   527→    return Object.keys(sponsors[teamKey]).length;\n   528→  }, [sponsors]);\n   529→\n   530→  /**\n   531→   * Get team with flexible matching (handles various name formats)\n   532→   * @param {string} teamName - Team name in any format (e.g., \"Penn State\", \"California Men's\")\n   533→   * @param {string} gender - Optional gender: 'mens' or 'womens'\n   534→   */\n   535→  const getTeamFlexible = useCallback((teamName, gender = null) => {\n   536→    if (!teamName) return null;\n   537→\n   538→    // First try exact match\n   539→    const exactMatch = getTeam(teamName);\n   540→    if (exactMatch) return exactMatch;\n   541→\n   542→    // Resolve to school key\n   543→    const schoolKey = resolveSchoolKey(teamName);\n   544→    if (!schoolKey) return null;\n   545→\n   546→    // Determine gender from input\n   547→    const normalized = normalizeName(teamName);\n   548→    let targetGender = gender;\n   549→    if (!targetGender) {\n   550→      if (normalized.includes('women') || normalized.includes('womens')) {\n   551→        targetGender = 'womens';\n   552→      } else if (normalized.includes('men') || normalized.includes('mens')) {\n   553→        targetGender = 'mens';\n   554→      }\n   555→    }\n   556→\n   557→    // Try to get team with specific gender\n   558→    if (targetGender) {\n   559→      const teamWithGender = teams[`${schoolKey}-${targetGender}`];\n   560→      if (teamWithGender) return teamWithGender;\n   561→    }\n   562→\n   563→    // Try mens first, then womens\n   564→    if (teams[`${schoolKey}-mens`]) return teams[`${schoolKey}-mens`];\n   565→    if (teams[`${schoolKey}-womens`]) return teams[`${schoolKey}-womens`];\n   566→\n   567→    return null;\n   568→  }, [teams, getTeam, resolveSchoolKey]);\n   569→\n   570→  /**\n   571→   * Get roster stats with flexible matching\n   572→   * @param {string} teamName - Team name in any format\n   573→   * @param {string} gender - Optional gender\n   574→   */\n   575→  const getTeamRosterStatsFlexible = useCallback((teamName, gender = null) => {\n   576→    const team = getTeamFlexible(teamName, gender);\n   577→    if (!team?.roster?.length) {\n   578→      return { total: 0, withHeadshots: 0, percentage: 0 };\n   579→    }\n   580→\n   581→    const withHeadshots = team.roster.filter(name => hasHeadshot(name)).length;\n   582→    return {\n   583→      total: team.roster.length,\n   584→      withHeadshots,\n   585→      percentage: Math.round((withHeadshots / team.roster.length) * 100),\n   586→    };\n   587→  }, [getTeamFlexible, hasHeadshot]);\n   588→\n   589→  /**\n   590→   * Check if team has a roster (with flexible matching)\n   591→   */\n   592→  const hasTeamRoster = useCallback((teamName, gender = null) => {\n   593→    const team = getTeamFlexible(teamName, gender);\n   594→    return team?.roster?.length > 0;\n   595→  }, [getTeamFlexible]);\n   596→\n   597→  /**\n   598→   * Get all team keys\n   599→   */\n   600→  const getAllTeamKeys = useCallback(() => {\n   601→    return Object.keys(teams);\n   602→  }, [teams]);\n   603→\n   604→  /**\n   605→   * Get all schools (unique)\n   606→   */\n   607→  const getAllSchools = useCallback(() => {\n   608→    const schools = new Set();\n   609→    for (const team of Object.values(teams)) {\n   610→      if (team.school) schools.add(team.school);\n   611→    }\n   612→    return Array.from(schools).sort();\n   613→  }, [teams]);\n   614→\n   615→  /**\n   616→   * Get teams grouped by school\n   617→   */\n   618→  const getTeamsBySchool = useCallback(() => {\n   619→    const bySchool = {};\n   620→    for (const [key, team] of Object.entries(teams)) {\n   621→      if (!team.school) continue;\n   622→      if (!bySchool[team.school]) {\n   623→        bySchool[team.school] = [];\n   624→      }\n   625→      bySchool[team.school].push({ key, ...team });\n   626→    }\n   627→    return bySchool;\n   628→  }, [teams]);\n   629→\n   630→  // ============================================\n   631→  // MIGRATION HELPER\n   632→  // ============================================\n   633→\n   634→  /**\n   635→   * Migrate data from static teamsDatabase.js to Firebase\n   636→   * Call this once to populate Firebase with existing data\n   637→   */\n   638→  const migrateFromStatic = useCallback(async (staticTeams, staticHeadshots, staticAliases) => {\n   639→    try {\n   640→      // Migrate teams\n   641→      for (const [key, team] of Object.entries(staticTeams)) {\n   642→        await saveTeam(key, team);\n   643→      }\n   644→\n   645→      // Migrate headshots\n   646→      const headshotsArray = Object.entries(staticHeadshots).map(([name, url]) => ({\n   647→        name,\n   648→        headshotUrl: url,\n   649→      }));\n   650→      await saveHeadshots(headshotsArray);\n   651→\n   652→      // Migrate aliases\n   653→      if (staticAliases) {\n   654→        await set(ref(db, 'teamsDatabase/aliases'), staticAliases);\n   655→      }\n   656→\n   657→      return { success: true };\n   658→    } catch (err) {\n   659→      return { success: false, error: err.message };\n   660→    }\n   661→  }, [saveTeam, saveHeadshots]);\n   662→\n   663→  // ============================================\n   664→  // DIAGNOSTICS\n   665→  // ============================================\n   666→\n   667→  /**\n   668→   * Run data integrity diagnostics\n   669→   * Checks for common issues like orphaned headshots, missing data, etc.\n   670→   * @returns {Object} Diagnostic results with issues found\n   671→   */\n   672→  const runDiagnostics = useCallback(() => {\n   673→    const issues = [];\n   674→    const stats = {\n   675→      totalTeams: Object.keys(teams).length,\n   676→      totalHeadshots: Object.keys(headshots).length,\n   677→      teamsWithRosters: 0,\n   678→      teamsWithLogos: 0,\n   679→      totalRosterEntries: 0,\n   680→      headshotsMatched: 0,\n   681→      headshotsOrphaned: 0,\n   682→    };\n   683→\n   684→    // Check each team\n   685→    for (const [teamKey, team] of Object.entries(teams)) {\n   686→      if (team.logo) stats.teamsWithLogos++;\n   687→      if (team.roster?.length > 0) {\n   688→        stats.teamsWithRosters++;\n   689→        stats.totalRosterEntries += team.roster.length;\n   690→\n   691→        // Check each roster entry for headshot\n   692→        for (const name of team.roster) {\n   693→          const headshotUrl = getHeadshot(name);\n   694→          if (!headshotUrl) {\n   695→            issues.push({\n   696→              type: 'missing_headshot',\n   697→              severity: 'warning',\n   698→              teamKey,\n   699→              athleteName: name,\n   700→              message: `No headshot found for \"${name}\" on ${team.displayName || teamKey}`,\n   701→            });\n   702→          } else {\n   703→            stats.headshotsMatched++;\n   704→          }\n   705→        }\n   706→      }\n   707→\n   708→      // Check for missing required fields\n   709→      if (!team.displayName) {\n   710→        issues.push({\n   711→          type: 'missing_field',\n   712→          severity: 'error',\n   713→          teamKey,\n   714→          field: 'displayName',\n   715→          message: `Team \"${teamKey}\" is missing displayName`,\n   716→        });\n   717→      }\n   718→      if (!team.school) {\n   719→        issues.push({\n   720→          type: 'missing_field',\n   721→          severity: 'error',\n   722→          teamKey,\n   723→          field: 'school',\n   724→          message: `Team \"${teamKey}\" is missing school name`,\n   725→        });\n   726→      }\n   727→      if (!team.gender) {\n   728→        issues.push({\n   729→          type: 'missing_field',\n   730→          severity: 'error',\n   731→          teamKey,\n   732→          field: 'gender',\n   733→          message: `Team \"${teamKey}\" is missing gender`,\n   734→        });\n   735→      }\n   736→    }\n   737→\n   738→    // Check for headshots with invalid teamKey references\n   739→    for (const [key, headshot] of Object.entries(headshots)) {\n   740→      if (headshot.teamKey && !teams[headshot.teamKey]) {\n   741→        issues.push({\n   742→          type: 'orphaned_headshot',\n   743→          severity: 'warning',\n   744→          headshotKey: key,\n   745→          athleteName: headshot.name,\n   746→          referencedTeam: headshot.teamKey,\n   747→          message: `Headshot for \"${headshot.name}\" references non-existent team \"${headshot.teamKey}\"`,\n   748→        });\n   749→        stats.headshotsOrphaned++;\n   750→      }\n   751→    }\n   752→\n   753→    // Calculate unmatched headshots (headshots not in any roster)\n   754→    const rosterNames = new Set();\n   755→    for (const team of Object.values(teams)) {\n   756→      if (team.roster) {\n   757→        for (const name of team.roster) {\n   758→          const normalized = normalizeName(name);\n   759→          const safeKey = getSafeFirebaseKey(normalized);\n   760→          rosterNames.add(normalized);\n   761→          rosterNames.add(safeKey);\n   762→        }\n   763→      }\n   764→    }\n   765→\n   766→    return {\n   767→      stats,\n   768→      issues,\n   769→      summary: {\n   770→        totalIssues: issues.length,\n   771→        errors: issues.filter(i => i.severity === 'error').length,\n   772→        warnings: issues.filter(i => i.severity === 'warning').length,\n   773→        missingHeadshots: issues.filter(i => i.type === 'missing_headshot').length,\n   774→        orphanedHeadshots: issues.filter(i => i.type === 'orphaned_headshot').length,\n   775→        missingFields: issues.filter(i => i.type === 'missing_field').length,\n   776→      },\n   777→    };\n   778→  }, [teams, headshots, getHeadshot]);\n   779→\n   780→  return {\n   781→    // State\n   782→    teams,\n   783→    headshots,\n   784→    aliases,\n   785→    sponsors,\n   786→    loading,\n   787→    error,\n   788→\n   789→    // Team operations\n   790→    saveTeam,\n   791→    updateTeamLogo,\n   792→    updateTeamRoster,\n   793→    getTeam,\n   794→    getTeamLogo,\n   795→    getAllTeamKeys,\n   796→    getAllSchools,\n   797→    getTeamsBySchool,\n   798→\n   799→    // Flexible team lookups (handle various name formats)\n   800→    getTeamFlexible,\n   801→    getTeamRosterStatsFlexible,\n   802→    hasTeamRoster,\n   803→    resolveSchoolKey,\n   804→\n   805→    // Headshot operations\n   806→    saveHeadshot,\n   807→    saveHeadshots,\n   808→    getHeadshot,\n   809→    hasHeadshot,\n   810→\n   811→    // Combined operations\n   812→    importRoster,\n   813→    getTeamRosterWithHeadshots,\n   814→    getTeamRosterStats,\n   815→\n   816→    // Sponsor operations\n   817→    saveSponsor,\n   818→    deleteSponsor,\n   819→    reorderSponsors,\n   820→    getTeamSponsors,\n   821→    getTeamSponsorCount,\n   822→\n   823→    // Migration\n   824→    migrateFromStatic,\n   825→\n   826→    // Diagnostics\n   827→    runDiagnostics,\n   828→  };\n   829→}\n   830→\n   831→export default useTeamsDatabase;\n   832→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d60d5b13-37ee-4f03-b5f2-8b0c33544a30","uuid":"1e78952e-9570-4d82-b6f4-86ada0e6ccc2","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/hooks/useTeamsDatabase.js","content":"import { useEffect, useState, useCallback } from 'react';\nimport { db, ref, onValue, set, update, get } from '../lib/firebase';\nimport {\n  normalizeName,\n  getSafeFirebaseKey,\n  getLookupKeys,\n} from '../lib/nameNormalization';\n\n/**\n * Firebase-backed teams database hook\n * Stores team logos, rosters, and athlete headshots in Firebase\n *\n * Firebase structure:\n * teamsDatabase/\n *   teams/\n *     {teamKey}/  (e.g., 'army-mens', 'cal-womens')\n *       displayName: \"Army Men's\"\n *       school: \"Army\"\n *       gender: \"mens\"\n *       logo: \"https://media.virti.us/...\"\n *       roster: [\"Ben Aguilar\", \"Carter Beck\", ...]\n *   headshots/\n *     {normalizedName}/  (e.g., 'ben aguilar')\n *       url: \"https://media.virti.us/...\"\n *       teamKey: \"army-mens\"  (optional, for reference)\n *   aliases/\n *     {alias}: {schoolKey}  (e.g., 'california': 'cal')\n *\n * Name normalization is handled by the shared nameNormalization.js utility\n * to ensure consistent matching across all components.\n */\n\n/**\n * Hook to access and manage the teams database in Firebase\n */\nexport function useTeamsDatabase() {\n  const [teams, setTeams] = useState({});\n  const [headshots, setHeadshots] = useState({});\n  const [aliases, setAliases] = useState({});\n  const [sponsors, setSponsors] = useState({});\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(null);\n\n  // Subscribe to teams database\n  useEffect(() => {\n    const teamsRef = ref(db, 'teamsDatabase/teams');\n    const headshotsRef = ref(db, 'teamsDatabase/headshots');\n    const aliasesRef = ref(db, 'teamsDatabase/aliases');\n    const sponsorsRef = ref(db, 'teamsDatabase/sponsors');\n\n    let loadedCount = 0;\n    const checkLoaded = () => {\n      loadedCount++;\n      if (loadedCount >= 4) setLoading(false);\n    };\n\n    const unsubTeams = onValue(teamsRef, (snapshot) => {\n      setTeams(snapshot.val() || {});\n      checkLoaded();\n    }, (err) => {\n      setError(err.message);\n      checkLoaded();\n    });\n\n    const unsubHeadshots = onValue(headshotsRef, (snapshot) => {\n      setHeadshots(snapshot.val() || {});\n      checkLoaded();\n    }, (err) => {\n      setError(err.message);\n      checkLoaded();\n    });\n\n    const unsubAliases = onValue(aliasesRef, (snapshot) => {\n      setAliases(snapshot.val() || {});\n      checkLoaded();\n    }, (err) => {\n      setError(err.message);\n      checkLoaded();\n    });\n\n    const unsubSponsors = onValue(sponsorsRef, (snapshot) => {\n      setSponsors(snapshot.val() || {});\n      checkLoaded();\n    }, (err) => {\n      setError(err.message);\n      checkLoaded();\n    });\n\n    return () => {\n      unsubTeams();\n      unsubHeadshots();\n      unsubAliases();\n      unsubSponsors();\n    };\n  }, []);\n\n  // ============================================\n  // TEAM OPERATIONS\n  // ============================================\n  // IMPORTANT: Team keys use hyphens (e.g., \"army-mens\") and should NOT be\n  // run through normalizeName() which converts hyphens to spaces.\n  // Team keys are stored as-is in Firebase.\n\n  /**\n   * Add or update a team\n   * @param {string} teamKey - Team key with hyphens (e.g., \"army-mens\")\n   */\n  const saveTeam = useCallback(async (teamKey, teamData) => {\n    try {\n      // Use teamKey directly - do NOT normalize (hyphens are intentional)\n      await set(ref(db, `teamsDatabase/teams/${teamKey}`), {\n        displayName: teamData.displayName,\n        school: teamData.school,\n        gender: teamData.gender,\n        logo: teamData.logo || '',\n        roster: teamData.roster || [],\n        updatedAt: new Date().toISOString(),\n      });\n      return { success: true };\n    } catch (err) {\n      return { success: false, error: err.message };\n    }\n  }, []);\n\n  /**\n   * Update team logo\n   * @param {string} teamKey - Team key with hyphens (e.g., \"army-mens\")\n   */\n  const updateTeamLogo = useCallback(async (teamKey, logoUrl) => {\n    try {\n      // Use teamKey directly - do NOT normalize\n      await update(ref(db, `teamsDatabase/teams/${teamKey}`), {\n        logo: logoUrl,\n        updatedAt: new Date().toISOString(),\n      });\n      return { success: true };\n    } catch (err) {\n      return { success: false, error: err.message };\n    }\n  }, []);\n\n  /**\n   * Update team roster (array of athlete names)\n   * @param {string} teamKey - Team key with hyphens (e.g., \"army-mens\")\n   */\n  const updateTeamRoster = useCallback(async (teamKey, roster) => {\n    try {\n      // Use teamKey directly - do NOT normalize\n      await update(ref(db, `teamsDatabase/teams/${teamKey}`), {\n        roster: roster,\n        updatedAt: new Date().toISOString(),\n      });\n      return { success: true };\n    } catch (err) {\n      return { success: false, error: err.message };\n    }\n  }, []);\n\n  // ============================================\n  // HEADSHOT OPERATIONS\n  // ============================================\n\n  /**\n   * Save a single athlete headshot\n   * Uses unified normalization from nameNormalization.js\n   */\n  const saveHeadshot = useCallback(async (athleteName, headshotUrl, teamKey = null) => {\n    try {\n      const normalized = normalizeName(athleteName);\n      // Firebase keys can't contain . # $ [ ] / so we encode them\n      const safeKey = getSafeFirebaseKey(normalized);\n      await set(ref(db, `teamsDatabase/headshots/${safeKey}`), {\n        name: athleteName,  // Store original name for display\n        url: headshotUrl,\n        teamKey: teamKey,\n        updatedAt: new Date().toISOString(),\n      });\n      return { success: true };\n    } catch (err) {\n      return { success: false, error: err.message };\n    }\n  }, []);\n\n  /**\n   * Save multiple headshots at once (batch operation)\n   * Uses unified normalization from nameNormalization.js\n   */\n  const saveHeadshots = useCallback(async (headshotsArray, teamKey = null) => {\n    try {\n      const updates = {};\n      for (const { name, headshotUrl, rtnId } of headshotsArray) {\n        const normalized = normalizeName(name);\n        const safeKey = getSafeFirebaseKey(normalized);\n        const entry = {\n          name: name,  // Store original name for display\n          url: headshotUrl,\n          teamKey: teamKey,\n          updatedAt: new Date().toISOString(),\n        };\n        if (rtnId) {\n          entry.rtnId = String(rtnId);\n        }\n        updates[`teamsDatabase/headshots/${safeKey}`] = entry;\n      }\n\n      // Use update with full paths for atomic batch write\n      const rootRef = ref(db);\n      await update(rootRef, updates);\n      return { success: true, count: headshotsArray.length };\n    } catch (err) {\n      return { success: false, error: err.message };\n    }\n  }, []);\n\n  /**\n   * Import a full roster with headshots from parsed Virtius data\n   * Note: Team key is used as-is (not normalized) since Firebase stores\n   * team keys with hyphens (e.g., \"army-mens\")\n   */\n  const importRoster = useCallback(async (teamKey, athletes) => {\n    try {\n      // Team key is used directly - do NOT normalize (hyphens are intentional)\n      // 1. Update team roster with athlete names\n      const rosterNames = athletes.map(a => a.name);\n      await update(ref(db, `teamsDatabase/teams/${teamKey}`), {\n        roster: rosterNames,\n        updatedAt: new Date().toISOString(),\n      });\n\n      // 2. Save all headshots (including RTN IDs if available from Virtius)\n      const headshotsToSave = athletes.map(a => ({\n        name: a.name,\n        headshotUrl: a.headshotUrl,\n        rtnId: a.rtnId || null,\n      }));\n      await saveHeadshots(headshotsToSave, teamKey);\n\n      // Log warnings for athletes missing RTN IDs\n      const missingRtnIds = athletes.filter(a => !a.rtnId);\n      if (missingRtnIds.length > 0) {\n        console.warn(`[importRoster] ${missingRtnIds.length}/${athletes.length} athletes missing RTN IDs for ${teamKey}:`, missingRtnIds.map(a => a.name));\n      }\n\n      return { success: true, athleteCount: athletes.length };\n    } catch (err) {\n      return { success: false, error: err.message };\n    }\n  }, [saveHeadshots]);\n\n  // ============================================\n  // SPONSOR OPERATIONS\n  // ============================================\n\n  /**\n   * Add or update a sponsor for a specific team\n   * @param {string} teamKey - Team key (e.g., \"penn-state-mens\")\n   * @param {string} sponsorKey - URL-safe key (e.g., \"nike\", \"state-farm\")\n   * @param {Object} sponsorData - { name, url, tier, order }\n   */\n  const saveSponsor = useCallback(async (teamKey, sponsorKey, sponsorData) => {\n    try {\n      await set(ref(db, `teamsDatabase/sponsors/${teamKey}/${sponsorKey}`), {\n        name: sponsorData.name,\n        url: sponsorData.url,\n        tier: sponsorData.tier || 'official',\n        order: sponsorData.order ?? 0,\n        updatedAt: new Date().toISOString(),\n      });\n      return { success: true };\n    } catch (err) {\n      return { success: false, error: err.message };\n    }\n  }, []);\n\n  /**\n   * Delete a sponsor for a specific team\n   * @param {string} teamKey - Team key (e.g., \"penn-state-mens\")\n   * @param {string} sponsorKey - Sponsor key to delete\n   */\n  const deleteSponsor = useCallback(async (teamKey, sponsorKey) => {\n    try {\n      await set(ref(db, `teamsDatabase/sponsors/${teamKey}/${sponsorKey}`), null);\n      return { success: true };\n    } catch (err) {\n      return { success: false, error: err.message };\n    }\n  }, []);\n\n  /**\n   * Reorder sponsors for a specific team by updating their order values\n   * @param {string} teamKey - Team key (e.g., \"penn-state-mens\")\n   * @param {string[]} orderedKeys - Array of sponsor keys in desired order\n   */\n  const reorderSponsors = useCallback(async (teamKey, orderedKeys) => {\n    try {\n      const updates = {};\n      orderedKeys.forEach((key, index) => {\n        updates[`teamsDatabase/sponsors/${teamKey}/${key}/order`] = index;\n        updates[`teamsDatabase/sponsors/${teamKey}/${key}/updatedAt`] = new Date().toISOString();\n      });\n      const rootRef = ref(db);\n      await update(rootRef, updates);\n      return { success: true };\n    } catch (err) {\n      return { success: false, error: err.message };\n    }\n  }, []);\n\n  // ============================================\n  // QUERY HELPERS\n  // ============================================\n\n  /**\n   * Get team by key\n   * Note: Team keys should NOT be normalized - they use hyphens (e.g., \"army-mens\")\n   * and are stored as-is in Firebase\n   */\n  const getTeam = useCallback((teamKey) => {\n    if (!teamKey) return null;\n    // Direct lookup - team keys are stored with hyphens, not normalized\n    return teams[teamKey] || null;\n  }, [teams]);\n\n  /**\n   * Get team logo with flexible matching\n   * @param {string} teamName - Team name in any format\n   * @param {'womens' | 'mens' | null} preferredGender - Preferred gender for fallback lookup\n   */\n  const getTeamLogo = useCallback((teamName, preferredGender = null) => {\n    if (!teamName) return '';\n\n    const normalized = normalizeName(teamName);\n\n    // Direct match\n    if (teams[normalized]) return teams[normalized].logo || '';\n\n    // Try with -mens/-womens suffix removed\n    const withoutGender = normalized\n      .replace(/-mens$/, '')\n      .replace(/-womens$/, '')\n      .replace(/ men'?s?$/i, '')\n      .replace(/ women'?s?$/i, '');\n\n    // Determine lookup order based on preferredGender\n    const genderOrder = preferredGender === 'womens'\n      ? ['womens', 'mens']\n      : ['mens', 'womens'];\n\n    // Check aliases\n    const aliasKey = aliases[withoutGender];\n    if (aliasKey) {\n      for (const gender of genderOrder) {\n        const team = teams[`${aliasKey}-${gender}`];\n        if (team?.logo) return team.logo;\n      }\n    }\n\n    // Try direct school match with gender preference\n    for (const gender of genderOrder) {\n      if (teams[`${withoutGender}-${gender}`]?.logo) {\n        return teams[`${withoutGender}-${gender}`].logo;\n      }\n    }\n\n    return '';\n  }, [teams, aliases]);\n\n  /**\n   * Get athlete headshot URL using flexible lookup\n   * Tries multiple normalized keys to handle accents, hyphens, etc.\n   *\n   * Lookup order (optimized for speed):\n   * 1. Safe Firebase key (most likely match - this is how we save)\n   * 2. Normalized name (fallback for legacy data)\n   * 3. Extended keys for edge cases (accents, middle names, etc.)\n   */\n  const getHeadshot = useCallback((athleteName) => {\n    if (!athleteName) return '';\n\n    // Primary lookup: normalize name and convert to safe Firebase key\n    // This matches how saveHeadshot() stores the data\n    const normalized = normalizeName(athleteName);\n    const safeKey = getSafeFirebaseKey(normalized);\n\n    // Try safe key first (this is how we save headshots)\n    if (headshots[safeKey]?.url) {\n      return headshots[safeKey].url;\n    }\n\n    // Fallback: try normalized name without safe key transformation\n    // (handles legacy data or data imported differently)\n    if (headshots[normalized]?.url) {\n      return headshots[normalized].url;\n    }\n\n    // Extended fallback: use getLookupKeys for edge cases (accents, middle names, etc.)\n    const parts = athleteName.trim().split(/\\s+/);\n    const firstName = parts[0] || '';\n    const lastName = parts.slice(1).join(' ') || '';\n    const keys = getLookupKeys(firstName, lastName);\n\n    for (const key of keys) {\n      const keySafe = getSafeFirebaseKey(key);\n      if (headshots[keySafe]?.url) {\n        return headshots[keySafe].url;\n      }\n      if (headshots[key]?.url) {\n        return headshots[key].url;\n      }\n    }\n\n    return '';\n  }, [headshots]);\n\n  /**\n   * Check if athlete has a headshot\n   */\n  const hasHeadshot = useCallback((athleteName) => {\n    return !!getHeadshot(athleteName);\n  }, [getHeadshot]);\n\n  /**\n   * Get roster with headshot info for a team\n   */\n  const getTeamRosterWithHeadshots = useCallback((teamKey) => {\n    const team = getTeam(teamKey);\n    if (!team?.roster) return [];\n\n    return team.roster.map(name => {\n      const normalized = normalizeName(name);\n      const safeKey = getSafeFirebaseKey(normalized);\n      const headshotEntry = headshots[safeKey];\n      return {\n        name,\n        hasHeadshot: hasHeadshot(name),\n        headshotUrl: getHeadshot(name),\n        rtnId: headshotEntry?.rtnId || null,\n      };\n    });\n  }, [getTeam, hasHeadshot, getHeadshot, headshots]);\n\n  /**\n   * Get roster stats for a team\n   */\n  const getTeamRosterStats = useCallback((teamKey) => {\n    const roster = getTeamRosterWithHeadshots(teamKey);\n    const withHeadshots = roster.filter(a => a.hasHeadshot).length;\n    return {\n      total: roster.length,\n      withHeadshots,\n      percentage: roster.length > 0 ? Math.round((withHeadshots / roster.length) * 100) : 0,\n    };\n  }, [getTeamRosterWithHeadshots]);\n\n  /**\n   * Resolve a team name to a school key (handles aliases and variations)\n   * E.g., \"California\" -> \"cal\", \"Penn State\" -> \"penn-state\"\n   */\n  const resolveSchoolKey = useCallback((teamName) => {\n    if (!teamName) return null;\n\n    const normalized = normalizeName(teamName)\n      .replace(/ men'?s?$/i, '')\n      .replace(/ women'?s?$/i, '')\n      .replace(/-mens$/, '')\n      .replace(/-womens$/, '');\n\n    // Check aliases first\n    if (aliases[normalized]) {\n      return aliases[normalized];\n    }\n\n    // Check if any team key starts with this school name\n    const possibleKeys = Object.keys(teams).filter(key =>\n      key.startsWith(normalized + '-') ||\n      key === normalized\n    );\n\n    if (possibleKeys.length > 0) {\n      // Extract school part from key (e.g., \"penn-state-mens\" -> \"penn-state\")\n      return possibleKeys[0].replace(/-mens$/, '').replace(/-womens$/, '');\n    }\n\n    // Try converting spaces to dashes\n    const dashedName = normalized.replace(/ /g, '-');\n    if (aliases[dashedName]) {\n      return aliases[dashedName];\n    }\n\n    const dashedPossibleKeys = Object.keys(teams).filter(key =>\n      key.startsWith(dashedName + '-') ||\n      key === dashedName\n    );\n\n    if (dashedPossibleKeys.length > 0) {\n      return dashedPossibleKeys[0].replace(/-mens$/, '').replace(/-womens$/, '');\n    }\n\n    return null;\n  }, [teams, aliases]);\n\n  /**\n   * Get sorted sponsors for a specific team\n   * @param {string} teamKey - Team key (e.g., \"penn-state-mens\")\n   * @returns {Array<{key: string, name: string, url: string, tier: string, order: number}>}\n   */\n  const getTeamSponsors = useCallback((teamKey) => {\n    if (!teamKey || !sponsors[teamKey]) return [];\n    return Object.entries(sponsors[teamKey])\n      .map(([key, data]) => ({\n        key,\n        name: data.name,\n        url: data.logoUrl || data.url,\n        tier: data.tier || 'official',\n        order: data.order ?? 0,\n      }))\n      .sort((a, b) => a.order - b.order);\n  }, [sponsors]);\n\n  /**\n   * Get count of sponsors for a specific team\n   * @param {string} teamKey - Team key (e.g., \"penn-state-mens\")\n   * @returns {number}\n   */\n  const getTeamSponsorCount = useCallback((teamKey) => {\n    if (!teamKey || !sponsors[teamKey]) return 0;\n    return Object.keys(sponsors[teamKey]).length;\n  }, [sponsors]);\n\n  /**\n   * Get team with flexible matching (handles various name formats)\n   * @param {string} teamName - Team name in any format (e.g., \"Penn State\", \"California Men's\")\n   * @param {string} gender - Optional gender: 'mens' or 'womens'\n   */\n  const getTeamFlexible = useCallback((teamName, gender = null) => {\n    if (!teamName) return null;\n\n    // First try exact match\n    const exactMatch = getTeam(teamName);\n    if (exactMatch) return exactMatch;\n\n    // Resolve to school key\n    const schoolKey = resolveSchoolKey(teamName);\n    if (!schoolKey) return null;\n\n    // Determine gender from input\n    const normalized = normalizeName(teamName);\n    let targetGender = gender;\n    if (!targetGender) {\n      if (normalized.includes('women') || normalized.includes('womens')) {\n        targetGender = 'womens';\n      } else if (normalized.includes('men') || normalized.includes('mens')) {\n        targetGender = 'mens';\n      }\n    }\n\n    // Try to get team with specific gender\n    if (targetGender) {\n      const teamWithGender = teams[`${schoolKey}-${targetGender}`];\n      if (teamWithGender) return teamWithGender;\n    }\n\n    // Try mens first, then womens\n    if (teams[`${schoolKey}-mens`]) return teams[`${schoolKey}-mens`];\n    if (teams[`${schoolKey}-womens`]) return teams[`${schoolKey}-womens`];\n\n    return null;\n  }, [teams, getTeam, resolveSchoolKey]);\n\n  /**\n   * Get roster stats with flexible matching\n   * @param {string} teamName - Team name in any format\n   * @param {string} gender - Optional gender\n   */\n  const getTeamRosterStatsFlexible = useCallback((teamName, gender = null) => {\n    const team = getTeamFlexible(teamName, gender);\n    if (!team?.roster?.length) {\n      return { total: 0, withHeadshots: 0, percentage: 0 };\n    }\n\n    const withHeadshots = team.roster.filter(name => hasHeadshot(name)).length;\n    return {\n      total: team.roster.length,\n      withHeadshots,\n      percentage: Math.round((withHeadshots / team.roster.length) * 100),\n    };\n  }, [getTeamFlexible, hasHeadshot]);\n\n  /**\n   * Check if team has a roster (with flexible matching)\n   */\n  const hasTeamRoster = useCallback((teamName, gender = null) => {\n    const team = getTeamFlexible(teamName, gender);\n    return team?.roster?.length > 0;\n  }, [getTeamFlexible]);\n\n  /**\n   * Get all team keys\n   */\n  const getAllTeamKeys = useCallback(() => {\n    return Object.keys(teams);\n  }, [teams]);\n\n  /**\n   * Get all schools (unique)\n   */\n  const getAllSchools = useCallback(() => {\n    const schools = new Set();\n    for (const team of Object.values(teams)) {\n      if (team.school) schools.add(team.school);\n    }\n    return Array.from(schools).sort();\n  }, [teams]);\n\n  /**\n   * Get teams grouped by school\n   */\n  const getTeamsBySchool = useCallback(() => {\n    const bySchool = {};\n    for (const [key, team] of Object.entries(teams)) {\n      if (!team.school) continue;\n      if (!bySchool[team.school]) {\n        bySchool[team.school] = [];\n      }\n      bySchool[team.school].push({ key, ...team });\n    }\n    return bySchool;\n  }, [teams]);\n\n  // ============================================\n  // MIGRATION HELPER\n  // ============================================\n\n  /**\n   * Migrate data from static teamsDatabase.js to Firebase\n   * Call this once to populate Firebase with existing data\n   */\n  const migrateFromStatic = useCallback(async (staticTeams, staticHeadshots, staticAliases) => {\n    try {\n      // Migrate teams\n      for (const [key, team] of Object.entries(staticTeams)) {\n        await saveTeam(key, team);\n      }\n\n      // Migrate headshots\n      const headshotsArray = Object.entries(staticHeadshots).map(([name, url]) => ({\n        name,\n        headshotUrl: url,\n      }));\n      await saveHeadshots(headshotsArray);\n\n      // Migrate aliases\n      if (staticAliases) {\n        await set(ref(db, 'teamsDatabase/aliases'), staticAliases);\n      }\n\n      return { success: true };\n    } catch (err) {\n      return { success: false, error: err.message };\n    }\n  }, [saveTeam, saveHeadshots]);\n\n  // ============================================\n  // DIAGNOSTICS\n  // ============================================\n\n  /**\n   * Run data integrity diagnostics\n   * Checks for common issues like orphaned headshots, missing data, etc.\n   * @returns {Object} Diagnostic results with issues found\n   */\n  const runDiagnostics = useCallback(() => {\n    const issues = [];\n    const stats = {\n      totalTeams: Object.keys(teams).length,\n      totalHeadshots: Object.keys(headshots).length,\n      teamsWithRosters: 0,\n      teamsWithLogos: 0,\n      totalRosterEntries: 0,\n      headshotsMatched: 0,\n      headshotsOrphaned: 0,\n    };\n\n    // Check each team\n    for (const [teamKey, team] of Object.entries(teams)) {\n      if (team.logo) stats.teamsWithLogos++;\n      if (team.roster?.length > 0) {\n        stats.teamsWithRosters++;\n        stats.totalRosterEntries += team.roster.length;\n\n        // Check each roster entry for headshot\n        for (const name of team.roster) {\n          const headshotUrl = getHeadshot(name);\n          if (!headshotUrl) {\n            issues.push({\n              type: 'missing_headshot',\n              severity: 'warning',\n              teamKey,\n              athleteName: name,\n              message: `No headshot found for \"${name}\" on ${team.displayName || teamKey}`,\n            });\n          } else {\n            stats.headshotsMatched++;\n          }\n        }\n      }\n\n      // Check for missing required fields\n      if (!team.displayName) {\n        issues.push({\n          type: 'missing_field',\n          severity: 'error',\n          teamKey,\n          field: 'displayName',\n          message: `Team \"${teamKey}\" is missing displayName`,\n        });\n      }\n      if (!team.school) {\n        issues.push({\n          type: 'missing_field',\n          severity: 'error',\n          teamKey,\n          field: 'school',\n          message: `Team \"${teamKey}\" is missing school name`,\n        });\n      }\n      if (!team.gender) {\n        issues.push({\n          type: 'missing_field',\n          severity: 'error',\n          teamKey,\n          field: 'gender',\n          message: `Team \"${teamKey}\" is missing gender`,\n        });\n      }\n    }\n\n    // Check for headshots with invalid teamKey references\n    for (const [key, headshot] of Object.entries(headshots)) {\n      if (headshot.teamKey && !teams[headshot.teamKey]) {\n        issues.push({\n          type: 'orphaned_headshot',\n          severity: 'warning',\n          headshotKey: key,\n          athleteName: headshot.name,\n          referencedTeam: headshot.teamKey,\n          message: `Headshot for \"${headshot.name}\" references non-existent team \"${headshot.teamKey}\"`,\n        });\n        stats.headshotsOrphaned++;\n      }\n    }\n\n    // Calculate unmatched headshots (headshots not in any roster)\n    const rosterNames = new Set();\n    for (const team of Object.values(teams)) {\n      if (team.roster) {\n        for (const name of team.roster) {\n          const normalized = normalizeName(name);\n          const safeKey = getSafeFirebaseKey(normalized);\n          rosterNames.add(normalized);\n          rosterNames.add(safeKey);\n        }\n      }\n    }\n\n    return {\n      stats,\n      issues,\n      summary: {\n        totalIssues: issues.length,\n        errors: issues.filter(i => i.severity === 'error').length,\n        warnings: issues.filter(i => i.severity === 'warning').length,\n        missingHeadshots: issues.filter(i => i.type === 'missing_headshot').length,\n        orphanedHeadshots: issues.filter(i => i.type === 'orphaned_headshot').length,\n        missingFields: issues.filter(i => i.type === 'missing_field').length,\n      },\n    };\n  }, [teams, headshots, getHeadshot]);\n\n  return {\n    // State\n    teams,\n    headshots,\n    aliases,\n    sponsors,\n    loading,\n    error,\n\n    // Team operations\n    saveTeam,\n    updateTeamLogo,\n    updateTeamRoster,\n    getTeam,\n    getTeamLogo,\n    getAllTeamKeys,\n    getAllSchools,\n    getTeamsBySchool,\n\n    // Flexible team lookups (handle various name formats)\n    getTeamFlexible,\n    getTeamRosterStatsFlexible,\n    hasTeamRoster,\n    resolveSchoolKey,\n\n    // Headshot operations\n    saveHeadshot,\n    saveHeadshots,\n    getHeadshot,\n    hasHeadshot,\n\n    // Combined operations\n    importRoster,\n    getTeamRosterWithHeadshots,\n    getTeamRosterStats,\n\n    // Sponsor operations\n    saveSponsor,\n    deleteSponsor,\n    reorderSponsors,\n    getTeamSponsors,\n    getTeamSponsorCount,\n\n    // Migration\n    migrateFromStatic,\n\n    // Diagnostics\n    runDiagnostics,\n  };\n}\n\nexport default useTeamsDatabase;\n","numLines":832,"startLine":1,"totalLines":832}}}
