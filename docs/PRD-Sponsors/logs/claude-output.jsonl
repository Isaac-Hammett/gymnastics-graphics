{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014tSyK6b3Kv1n63mhsGq13v","type":"tool_result","content":"     1→/**\n     2→ * URL Builder for Virtius Graphics Engine\n     3→ * Generates properly formatted URLs for all graphics overlays\n     4→ *\n     5→ * Production: https://commentarygraphic.com\n     6→ * Local: Uses window.location.origin\n     7→ */\n     8→\n     9→import { getGraphicById, isTransparentGraphic as registryIsTransparent } from './graphicsRegistry';\n    10→\n    11→/**\n    12→ * Get the base URL for graphics\n    13→ * Uses current origin for local development, can be overridden for production\n    14→ */\n    15→export function getBaseURL() {\n    16→  // In production this could be: 'https://virtiusgraphicsenginev001.netlify.app'\n    17→  // For local dev, use the current origin\n    18→  return typeof window !== 'undefined' ? window.location.origin : '';\n    19→}\n    20→\n    21→/**\n    22→ * Graphics path mapping\n    23→ * Maps internal graphic IDs to their HTML file paths\n    24→ */\n    25→const GRAPHIC_PATHS = {\n    26→  // PRE-MEET\n    27→  'logos': 'logos.html',\n    28→  'event-bar': 'event-bar.html',\n    29→  'warm-up': 'warm-up.html',\n    30→  'hosts': 'hosts.html',\n    31→  'team-stats': 'team-stats.html',\n    32→  'coaches': 'coaches.html',\n    33→\n    34→  // EVENT FRAMES\n    35→  'event-frame': 'event-frame.html',\n    36→\n    37→  // STREAM\n    38→  'stream': 'stream.html',\n    39→};\n    40→\n    41→/**\n    42→ * Event titles mapping for event frames\n    43→ */\n    44→const EVENT_TITLES = {\n    45→  floor: 'FLOOR EXERCISE',\n    46→  pommel: 'POMMEL HORSE',\n    47→  rings: 'STILL RINGS',\n    48→  vault: 'VAULT',\n    49→  pbars: 'PARALLEL BARS',\n    50→  hbar: 'HORIZONTAL BAR',\n    51→  ubars: 'UNEVEN BARS',\n    52→  beam: 'BALANCE BEAM',\n    53→  allaround: 'ALL AROUND',\n    54→  final: 'FINAL SCORES',\n    55→  order: 'COMPETITION ORDER',\n    56→  lineups: 'NEXT EVENT LINEUPS',\n    57→  summary: 'EVENT SUMMARY',\n    58→};\n    59→\n    60→/**\n    61→ * Encode a URL parameter value safely\n    62→ * @param {string} value - Value to encode\n    63→ * @returns {string} Encoded value\n    64→ */\n    65→function encode(value) {\n    66→  return encodeURIComponent(value || '');\n    67→}\n    68→\n    69→/**\n    70→ * Build URL for Team Logos graphic\n    71→ * @param {Object} options\n    72→ * @param {Object} options.teams - Team data keyed by team number (team1Name, team1Logo, etc.)\n    73→ * @param {number} options.teamCount - Number of teams to include\n    74→ * @param {string} [options.baseUrl] - Override base URL\n    75→ * @returns {string} Complete URL\n    76→ */\n    77→export function buildLogosURL({ teams, teamCount, baseUrl }) {\n    78→  const base = baseUrl || getBaseURL();\n    79→  const params = new URLSearchParams();\n    80→\n    81→  for (let i = 1; i <= teamCount; i++) {\n    82→    const logo = teams[`team${i}Logo`];\n    83→    if (logo) {\n    84→      params.set(`team${i}Logo`, logo);\n    85→    }\n    86→  }\n    87→\n    88→  return `${base}/overlays/logos.html?${params.toString()}`;\n    89→}\n    90→\n    91→/**\n    92→ * Build URL for Event Bar graphic\n    93→ * @param {Object} options\n    94→ * @param {string} options.team1Logo - Team 1 logo URL\n    95→ * @param {string} options.venue - Venue name\n    96→ * @param {string} options.eventName - Event/meet name\n    97→ * @param {string} options.location - Location\n    98→ * @param {string} [options.baseUrl] - Override base URL\n    99→ * @returns {string} Complete URL\n   100→ */\n   101→export function buildEventBarURL({ team1Logo, venue, eventName, location, baseUrl }) {\n   102→  const base = baseUrl || getBaseURL();\n   103→  const params = new URLSearchParams();\n   104→\n   105→  if (team1Logo) params.set('team1Logo', team1Logo);\n   106→  if (venue) params.set('venue', venue);\n   107→  if (eventName) params.set('eventName', eventName);\n   108→  if (location) params.set('location', location);\n   109→\n   110→  return `${base}/overlays/event-bar.html?${params.toString()}`;\n   111→}\n   112→\n   113→/**\n   114→ * Build URL for Hosts graphic\n   115→ * @param {Object} options\n   116→ * @param {string} options.hosts - Hosts (newline or pipe separated)\n   117→ * @param {string} [options.baseUrl] - Override base URL\n   118→ * @returns {string} Complete URL\n   119→ */\n   120→export function buildHostsURL({ hosts, baseUrl }) {\n   121→  const base = baseUrl || getBaseURL();\n   122→  // Convert newlines to pipes for URL\n   123→  const hostsFormatted = hosts?.split('\\n').join('|') || '';\n   124→  return `${base}/overlays/hosts.html?hosts=${encode(hostsFormatted)}`;\n   125→}\n   126→\n   127→/**\n   128→ * Build URL for Team Stats graphic\n   129→ * @param {Object} options\n   130→ * @param {string} options.teamName - Team name\n   131→ * @param {string} options.logo - Team logo URL\n   132→ * @param {string} options.ave - Average score\n   133→ * @param {string} options.high - High score\n   134→ * @param {string} [options.baseUrl] - Override base URL\n   135→ * @returns {string} Complete URL\n   136→ */\n   137→export function buildTeamStatsURL({ teamName, logo, ave, high, baseUrl }) {\n   138→  const base = baseUrl || getBaseURL();\n   139→  const params = new URLSearchParams();\n   140→\n   141→  if (teamName) params.set('teamName', teamName);\n   142→  if (logo) params.set('logo', logo);\n   143→  if (ave) params.set('ave', ave);\n   144→  if (high) params.set('high', high);\n   145→\n   146→  return `${base}/overlays/team-stats.html?${params.toString()}`;\n   147→}\n   148→\n   149→/**\n   150→ * Build URL for Coaches graphic\n   151→ * @param {Object} options\n   152→ * @param {string} options.logo - Team logo URL\n   153→ * @param {string} options.coaches - Coaches (newline or pipe separated)\n   154→ * @param {string} [options.baseUrl] - Override base URL\n   155→ * @returns {string} Complete URL\n   156→ */\n   157→export function buildCoachesURL({ logo, coaches, baseUrl }) {\n   158→  const base = baseUrl || getBaseURL();\n   159→  // Convert newlines to pipes for URL\n   160→  const coachesFormatted = coaches?.split('\\n').join('|') || '';\n   161→  const params = new URLSearchParams();\n   162→\n   163→  if (logo) params.set('logo', logo);\n   164→  if (coachesFormatted) params.set('coaches', coachesFormatted);\n   165→\n   166→  return `${base}/overlays/coaches.html?${params.toString()}`;\n   167→}\n   168→\n   169→/**\n   170→ * Build URL for Event Frame graphic\n   171→ * @param {Object} options\n   172→ * @param {string} options.eventId - Event ID (floor, vault, etc.)\n   173→ * @param {string} options.logo - Team logo URL\n   174→ * @param {string} [options.baseUrl] - Override base URL\n   175→ * @returns {string} Complete URL\n   176→ */\n   177→export function buildEventFrameURL({ eventId, logo, baseUrl }) {\n   178→  const base = baseUrl || getBaseURL();\n   179→  const title = EVENT_TITLES[eventId] || eventId?.toUpperCase() || '';\n   180→  const params = new URLSearchParams();\n   181→\n   182→  if (title) params.set('title', title);\n   183→  if (logo) params.set('logo', logo);\n   184→\n   185→  return `${base}/overlays/event-frame.html?${params.toString()}`;\n   186→}\n   187→\n   188→/**\n   189→ * Build URL for Stream graphic (Starting/Thanks)\n   190→ * @param {Object} options\n   191→ * @param {string} options.type - 'starting' or 'thanks'\n   192→ * @param {string} options.logo - Team logo URL\n   193→ * @param {string} options.eventName - Event/meet name\n   194→ * @param {string} options.meetDate - Date of the meet\n   195→ * @param {string} [options.baseUrl] - Override base URL\n   196→ * @returns {string} Complete URL\n   197→ */\n   198→export function buildStreamURL({ type, logo, eventName, meetDate, baseUrl }) {\n   199→  const base = baseUrl || getBaseURL();\n   200→  const title = type === 'starting' ? 'STREAM STARTING SOON' : 'THANKS FOR WATCHING';\n   201→  const params = new URLSearchParams();\n   202→\n   203→  params.set('title', title);\n   204→  if (logo) params.set('logo', logo);\n   205→  if (eventName) params.set('eventName', eventName);\n   206→  if (meetDate) params.set('meetDate', meetDate);\n   207→\n   208→  return `${base}/overlays/stream.html?${params.toString()}`;\n   209→}\n   210→\n   211→/**\n   212→ * Build URL for Frame Overlay graphics\n   213→ * @param {Object} options\n   214→ * @param {string} options.frameType - Frame type (quad, tri-center, tri-wide, team-header, single)\n   215→ * @param {Object} options.teams - Team data keyed by team number\n   216→ * @param {number} options.teamCount - Number of teams\n   217→ * @param {string} [options.baseUrl] - Override base URL\n   218→ * @returns {string} Complete URL\n   219→ */\n   220→export function buildFrameOverlayURL({ frameType, teams, teamCount, baseUrl }) {\n   221→  const base = baseUrl || getBaseURL();\n   222→  const params = new URLSearchParams();\n   223→\n   224→  // Add team logos for frame overlays\n   225→  for (let i = 1; i <= teamCount; i++) {\n   226→    const logo = teams[`team${i}Logo`];\n   227→    if (logo) {\n   228→      params.set(`team${i}Logo`, logo);\n   229→    }\n   230→  }\n   231→\n   232→  return `${base}/overlays/frame-${frameType}.html?${params.toString()}`;\n   233→}\n   234→\n   235→/**\n   236→ * Build URL for Leaderboard graphic\n   237→ * @param {Object} options\n   238→ * @param {string} options.event - Event ID (floor, vault, etc. or 'all-around')\n   239→ * @param {string} options.virtiusSessionId - Virtius session ID for live data\n   240→ * @param {string} options.gender - Gender ('mens' or 'womens') for column visibility\n   241→ * @param {Object} options.teams - Team data keyed by team number\n   242→ * @param {number} options.teamCount - Number of teams\n   243→ * @param {string} [options.baseUrl] - Override base URL\n   244→ * @returns {string} Complete URL\n   245→ */\n   246→export function buildLeaderboardURL({ event, virtiusSessionId, gender, teams, teamCount, compId, baseUrl }) {\n   247→  const base = baseUrl || getBaseURL();\n   248→  const params = new URLSearchParams();\n   249→\n   250→  // Competition ID is required for leaderboards (needs live Virtius data)\n   251→  if (compId) params.set('comp', compId);\n   252→  // Use leaderboardEvent to match output.html renderer expectation\n   253→  if (event) params.set('leaderboardEvent', event);\n   254→  if (virtiusSessionId) params.set('virtiusSessionId', virtiusSessionId);\n   255→  if (gender) params.set('leaderboardGender', gender);\n   256→\n   257→  // Add team data for display\n   258→  for (let i = 1; i <= teamCount; i++) {\n   259→    const name = teams[`team${i}Name`];\n   260→    const logo = teams[`team${i}Logo`];\n   261→    if (name) params.set(`team${i}Name`, name);\n   262→    if (logo) params.set(`team${i}Logo`, logo);\n   263→  }\n   264→\n   265→  return `${base}/output.html?graphic=virtius-leaderboard&${params.toString()}`;\n   266→}\n   267→\n   268→/**\n   269→ * Build URL for Event Summary graphic\n   270→ * @param {Object} options\n   271→ * @param {string} options.mode - 'rotation' or 'apparatus'\n   272→ * @param {number} [options.rotation] - Rotation number (1-6) if mode is 'rotation'\n   273→ * @param {string} [options.apparatus] - Apparatus ID (fx, ph, etc.) if mode is 'apparatus'\n   274→ * @param {string} options.virtiusSessionId - Virtius session ID for live data\n   275→ * @param {string} options.compType - Competition type for format determination\n   276→ * @param {string} options.gender - Gender ('mens' or 'womens')\n   277→ * @param {Object} options.teams - Team data keyed by team number\n   278→ * @param {number} options.teamCount - Number of teams\n   279→ * @param {string} [options.theme] - Summary theme ID\n   280→ * @param {string} [options.baseUrl] - Override base URL\n   281→ * @returns {string} Complete URL\n   282→ */\n   283→export function buildEventSummaryURL({ mode, rotation, apparatus, virtiusSessionId, compType, gender, teams, teamCount, theme, compId, baseUrl }) {\n   284→  const base = baseUrl || getBaseURL();\n   285→  const params = new URLSearchParams();\n   286→\n   287→  // Competition ID is required for event summary (needs live Virtius data)\n   288→  if (compId) params.set('comp', compId);\n   289→  params.set('graphic', 'event-summary');\n   290→\n   291→  // Use virtiusSessionId to match output.html renderer expectation\n   292→  if (virtiusSessionId) params.set('virtiusSessionId', virtiusSessionId);\n   293→  if (theme) params.set('summaryTheme', theme);\n   294→  if (gender) params.set('summaryGender', gender);\n   295→\n   296→  // Determine format based on competition type\n   297→  const isDual = compType?.includes('dual');\n   298→\n   299→  if (mode === 'rotation') {\n   300→    params.set('summaryMode', 'rotation');\n   301→    params.set('summaryRotation', rotation);\n   302→    params.set('summaryFormat', isDual ? 'alternating' : 'rotation');\n   303→  } else if (mode === 'apparatus') {\n   304→    params.set('summaryMode', 'apparatus');\n   305→    params.set('summaryApparatus', apparatus);\n   306→    params.set('summaryFormat', 'head-to-head');\n   307→  }\n   308→\n   309→  params.set('summaryNumTeams', teamCount);\n   310→\n   311→  // Add team data\n   312→  for (let i = 1; i <= teamCount; i++) {\n   313→    const name = teams[`team${i}Name`];\n   314→    const logo = teams[`team${i}Logo`];\n   315→    if (name) params.set(`team${i}Name`, name);\n   316→    if (logo) params.set(`team${i}Logo`, logo);\n   317→  }\n   318→\n   319→  return `${base}/output.html?${params.toString()}`;\n   320→}\n   321→\n   322→/**\n   323→ * Generate URL for any graphic based on ID\n   324→ * @param {string} graphicId - Graphic identifier\n   325→ * @param {Object} formData - Form data with team info, event details, etc.\n   326→ * @param {number} teamCount - Number of teams in competition\n   327→ * @param {string} [baseUrl] - Override base URL\n   328→ * @param {Object} [options] - Additional options (compType, virtiusSessionId, etc.)\n   329→ * @returns {string} Complete URL or empty string if unknown graphic\n   330→ */\n   331→export function generateGraphicURL(graphicId, formData, teamCount, baseUrl, options = {}) {\n   332→  const base = baseUrl || getBaseURL();\n   333→  const { compType, virtiusSessionId, compId, summaryTheme } = options;\n   334→\n   335→  // Helper to get team logo with placeholder fallback\n   336→  const getTeamLogo = (teamNum) => {\n   337→    const colors = ['00274C/FFCB05', 'BB0000/FFFFFF', '003087/FFFFFF', '228B22/FFFFFF', '800080/FFFFFF', 'FF8C00/FFFFFF'];\n   338→    return formData[`team${teamNum}Logo`] || `https://via.placeholder.com/200/${colors[(teamNum - 1) % colors.length]}?text=T${teamNum}`;\n   339→  };\n   340→\n   341→  // Helper to get all team data\n   342→  const getTeamsData = () => {\n   343→    const teams = { ...formData };\n   344→    for (let i = 1; i <= teamCount; i++) {\n   345→      if (!teams[`team${i}Logo`]) {\n   346→        teams[`team${i}Logo`] = getTeamLogo(i);\n   347→      }\n   348→    }\n   349→    return teams;\n   350→  };\n   351→\n   352→  // Handle dynamic team stats/coaches graphics\n   353→  const teamStatsMatch = graphicId.match(/^team(\\d+)-stats$/);\n   354→  if (teamStatsMatch) {\n   355→    const num = parseInt(teamStatsMatch[1]);\n   356→    return buildTeamStatsURL({\n   357→      teamName: formData[`team${num}Name`],\n   358→      logo: getTeamLogo(num),\n   359→      ave: formData[`team${num}Ave`],\n   360→      high: formData[`team${num}High`],\n   361→      baseUrl: base,\n   362→    });\n   363→  }\n   364→\n   365→  const teamCoachesMatch = graphicId.match(/^team(\\d+)-coaches$/);\n   366→  if (teamCoachesMatch) {\n   367→    const num = parseInt(teamCoachesMatch[1]);\n   368→    return buildCoachesURL({\n   369→      logo: getTeamLogo(num),\n   370→      coaches: formData[`team${num}Coaches`],\n   371→      baseUrl: base,\n   372→    });\n   373→  }\n   374→\n   375→  // Handle frame overlay graphics\n   376→  const frameMatch = graphicId.match(/^frame-(quad|tri-center|tri-wide|team-header|single|dual)$/);\n   377→  if (frameMatch) {\n   378→    return buildFrameOverlayURL({\n   379→      frameType: frameMatch[1],\n   380→      teams: getTeamsData(),\n   381→      teamCount,\n   382→      baseUrl: base,\n   383→    });\n   384→  }\n   385→\n   386→  // Handle leaderboard graphics\n   387→  const leaderboardMatch = graphicId.match(/^leaderboard-(.+)$/);\n   388→  if (leaderboardMatch) {\n   389→    // eventCode is already the short code (fx, ph, sr, vt, pb, hb, ub, bb, aa)\n   390→    const eventCode = leaderboardMatch[1];\n   391→    const gender = compType?.startsWith('mens') ? 'mens' : 'womens';\n   392→    return buildLeaderboardURL({\n   393→      event: eventCode, // Pass short code directly - renderer expects fx, ph, etc.\n   394→      virtiusSessionId,\n   395→      gender,\n   396→      teams: getTeamsData(),\n   397→      teamCount,\n   398→      compId,\n   399→      baseUrl: base,\n   400→    });\n   401→  }\n   402→\n   403→  // Handle event summary graphics\n   404→  const summaryRotationMatch = graphicId.match(/^summary-r(\\d+)$/);\n   405→  if (summaryRotationMatch) {\n   406→    const rotation = parseInt(summaryRotationMatch[1]);\n   407→    const gender = compType?.startsWith('mens') ? 'mens' : 'womens';\n   408→    return buildEventSummaryURL({\n   409→      mode: 'rotation',\n   410→      rotation,\n   411→      virtiusSessionId,\n   412→      compType,\n   413→      gender,\n   414→      teams: getTeamsData(),\n   415→      teamCount,\n   416→      theme: summaryTheme,\n   417→      compId,\n   418→      baseUrl: base,\n   419→    });\n   420→  }\n   421→\n   422→  const summaryApparatusMatch = graphicId.match(/^summary-(fx|ph|sr|vt|pb|hb|ub|bb)$/);\n   423→  if (summaryApparatusMatch) {\n   424→    const apparatus = summaryApparatusMatch[1];\n   425→    const gender = compType?.startsWith('mens') ? 'mens' : 'womens';\n   426→    return buildEventSummaryURL({\n   427→      mode: 'apparatus',\n   428→      apparatus,\n   429→      virtiusSessionId,\n   430→      compType,\n   431→      gender,\n   432→      teams: getTeamsData(),\n   433→      teamCount,\n   434→      theme: summaryTheme,\n   435→      compId,\n   436→      baseUrl: base,\n   437→    });\n   438→  }\n   439→\n   440→  // Handle standard graphics\n   441→  switch (graphicId) {\n   442→    case 'logos':\n   443→      return buildLogosURL({\n   444→        teams: {\n   445→          ...formData,\n   446→          // Ensure all team logos have values (with fallbacks)\n   447→          ...Object.fromEntries(\n   448→            Array.from({ length: teamCount }, (_, i) => [\n   449→              `team${i + 1}Logo`,\n   450→              getTeamLogo(i + 1)\n   451→            ])\n   452→          ),\n   453→        },\n   454→        teamCount,\n   455→        baseUrl: base,\n   456→      });\n   457→\n   458→    case 'event-bar':\n   459→      return buildEventBarURL({\n   460→        team1Logo: getTeamLogo(1),\n   461→        venue: formData.venue,\n   462→        eventName: formData.eventName,\n   463→        location: formData.location,\n   464→        baseUrl: base,\n   465→      });\n   466→\n   467→    case 'warm-up':\n   468→      // Warm-up graphic uses event-bar.html with warm-up title\n   469→      const warmUpParams = new URLSearchParams();\n   470→      warmUpParams.set('title', 'WARM UP');\n   471→      warmUpParams.set('team1Logo', getTeamLogo(1));\n   472→      if (formData.venue) warmUpParams.set('venue', formData.venue);\n   473→      return `${base}/overlays/warm-up.html?${warmUpParams.toString()}`;\n   474→\n   475→    case 'replay':\n   476→      // Replay graphic - simple instant replay indicator\n   477→      const replayParams = new URLSearchParams();\n   478→      replayParams.set('team1Logo', getTeamLogo(1));\n   479→      return `${base}/overlays/replay.html?${replayParams.toString()}`;\n   480→\n   481→    case 'hosts':\n   482→      return buildHostsURL({\n   483→        hosts: formData.hosts,\n   484→        baseUrl: base,\n   485→      });\n   486→\n   487→    case 'floor':\n   488→    case 'pommel':\n   489→    case 'rings':\n   490→    case 'vault':\n   491→    case 'pbars':\n   492→    case 'hbar':\n   493→    case 'ubars':\n   494→    case 'beam':\n   495→    case 'allaround':\n   496→    case 'final':\n   497→    case 'order':\n   498→    case 'lineups':\n   499→    case 'summary':\n   500→      return buildEventFrameURL({\n   501→        eventId: graphicId,\n   502→        logo: getTeamLogo(1),\n   503→        baseUrl: base,\n   504→      });\n   505→\n   506→    case 'starting':\n   507→      return buildStreamURL({\n   508→        type: 'starting',\n   509→        logo: getTeamLogo(1),\n   510→        eventName: formData.eventName,\n   511→        meetDate: formData.meetDate,\n   512→        baseUrl: base,\n   513→      });\n   514→\n   515→    case 'thanks':\n   516→      return buildStreamURL({\n   517→        type: 'thanks',\n   518→        logo: getTeamLogo(1),\n   519→        eventName: formData.eventName,\n   520→        meetDate: formData.meetDate,\n   521→        baseUrl: base,\n   522→      });\n   523→\n   524→    default:\n   525→      return '';\n   526→  }\n   527→}\n   528→\n   529→/**\n   530→ * Copy text to clipboard with fallback\n   531→ * @param {string} text - Text to copy\n   532→ * @returns {Promise<boolean>} Success status\n   533→ */\n   534→export async function copyToClipboard(text) {\n   535→  // Try modern clipboard API first\n   536→  if (navigator.clipboard && window.isSecureContext) {\n   537→    try {\n   538→      await navigator.clipboard.writeText(text);\n   539→      return true;\n   540→    } catch (err) {\n   541→      console.warn('Clipboard API failed, trying fallback:', err);\n   542→    }\n   543→  }\n   544→\n   545→  // Fallback for older browsers or non-secure contexts\n   546→  try {\n   547→    const textArea = document.createElement('textarea');\n   548→    textArea.value = text;\n   549→    textArea.style.cssText = 'position:fixed;left:-9999px;top:-9999px;';\n   550→    document.body.appendChild(textArea);\n   551→    textArea.focus();\n   552→    textArea.select();\n   553→    const success = document.execCommand('copy');\n   554→    document.body.removeChild(textArea);\n   555→    return success;\n   556→  } catch (err) {\n   557→    console.error('Fallback copy failed:', err);\n   558→    return false;\n   559→  }\n   560→}\n   561→\n   562→/**\n   563→ * Get the file path for a graphic\n   564→ * @param {string} graphicId - Graphic identifier\n   565→ * @returns {string} HTML file path\n   566→ */\n   567→export function getGraphicPath(graphicId) {\n   568→  // Check registry first\n   569→  const graphic = getGraphicById(graphicId);\n   570→  if (graphic?.file) {\n   571→    return graphic.file;\n   572→  }\n   573→  // Fallback to old mapping\n   574→  return GRAPHIC_PATHS[graphicId] || `${graphicId}.html`;\n   575→}\n   576→\n   577→/**\n   578→ * Build URL from registry schema (for simple overlay graphics)\n   579→ * This function uses the registry schema to build URLs for graphics that follow\n   580→ * the standard pattern: overlays/{file}?{params}\n   581→ *\n   582→ * Complex graphics (leaderboards, event-summary, etc.) still use their dedicated\n   583→ * builder functions as they have special logic.\n   584→ *\n   585→ * @param {string} graphicId - Graphic ID\n   586→ * @param {Object} formData - Form data with values\n   587→ * @param {number} teamCount - Number of teams\n   588→ * @param {Object} [options] - Additional options\n   589→ * @returns {string|null} URL or null if graphic not found or not supported\n   590→ */\n   591→export function buildGraphicUrlFromRegistry(graphicId, formData, teamCount, options = {}) {\n   592→  const graphic = getGraphicById(graphicId);\n   593→  if (!graphic) return null;\n   594→\n   595→  const base = options.baseUrl || getBaseURL();\n   596→\n   597→  // Only handle simple overlay graphics for now\n   598→  // Complex graphics (leaderboards, event-summary) use dedicated builders\n   599→  if (graphic.renderer !== 'overlay') return null;\n   600→\n   601→  const params = new URLSearchParams();\n   602→\n   603→  // Build params from schema\n   604→  if (graphic.params) {\n   605→    for (const [paramKey, paramSchema] of Object.entries(graphic.params)) {\n   606→      let value = null;\n   607→\n   608→      if (paramSchema.source === 'competition') {\n   609→        // Auto-fill from formData based on param name\n   610→        // Handle team-specific params like team1Logo\n   611→        if (paramKey in formData) {\n   612→          value = formData[paramKey];\n   613→        }\n   614→      } else if (paramSchema.default !== undefined) {\n   615→        // Use default value\n   616→        value = paramSchema.default;\n   617→      }\n   618→\n   619→      if (value !== null && value !== undefined && value !== '') {\n   620→        params.set(paramKey, value);\n   621→      }\n   622→    }\n   623→  }\n   624→\n   625→  const queryString = params.toString();\n   626→  const path = graphic.file.endsWith('.html')\n   627→    ? `overlays/${graphic.file}`\n   628→    : `overlays/${graphic.file}.html`;\n   629→\n   630→  return queryString ? `${base}/${path}?${queryString}` : `${base}/${path}`;\n   631→}\n   632→\n   633→/**\n   634→ * Check if a graphic is transparent based on registry\n   635→ * Re-exports the registry function for backwards compatibility\n   636→ */\n   637→export { registryIsTransparent as isTransparentGraphicFromRegistry };\n   638→\n   639→export default {\n   640→  getBaseURL,\n   641→  buildLogosURL,\n   642→  buildEventBarURL,\n   643→  buildHostsURL,\n   644→  buildTeamStatsURL,\n   645→  buildCoachesURL,\n   646→  buildEventFrameURL,\n   647→  buildStreamURL,\n   648→  buildFrameOverlayURL,\n   649→  buildLeaderboardURL,\n   650→  buildEventSummaryURL,\n   651→  generateGraphicURL,\n   652→  buildGraphicUrlFromRegistry,\n   653→  copyToClipboard,\n   654→  getGraphicPath,\n   655→};\n   656→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5ae4dc4b-8f70-4625-96cd-664a3664adc7","uuid":"d0cf5cad-e7dd-455b-976c-4bace640372e","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/lib/urlBuilder.js","content":"/**\n * URL Builder for Virtius Graphics Engine\n * Generates properly formatted URLs for all graphics overlays\n *\n * Production: https://commentarygraphic.com\n * Local: Uses window.location.origin\n */\n\nimport { getGraphicById, isTransparentGraphic as registryIsTransparent } from './graphicsRegistry';\n\n/**\n * Get the base URL for graphics\n * Uses current origin for local development, can be overridden for production\n */\nexport function getBaseURL() {\n  // In production this could be: 'https://virtiusgraphicsenginev001.netlify.app'\n  // For local dev, use the current origin\n  return typeof window !== 'undefined' ? window.location.origin : '';\n}\n\n/**\n * Graphics path mapping\n * Maps internal graphic IDs to their HTML file paths\n */\nconst GRAPHIC_PATHS = {\n  // PRE-MEET\n  'logos': 'logos.html',\n  'event-bar': 'event-bar.html',\n  'warm-up': 'warm-up.html',\n  'hosts': 'hosts.html',\n  'team-stats': 'team-stats.html',\n  'coaches': 'coaches.html',\n\n  // EVENT FRAMES\n  'event-frame': 'event-frame.html',\n\n  // STREAM\n  'stream': 'stream.html',\n};\n\n/**\n * Event titles mapping for event frames\n */\nconst EVENT_TITLES = {\n  floor: 'FLOOR EXERCISE',\n  pommel: 'POMMEL HORSE',\n  rings: 'STILL RINGS',\n  vault: 'VAULT',\n  pbars: 'PARALLEL BARS',\n  hbar: 'HORIZONTAL BAR',\n  ubars: 'UNEVEN BARS',\n  beam: 'BALANCE BEAM',\n  allaround: 'ALL AROUND',\n  final: 'FINAL SCORES',\n  order: 'COMPETITION ORDER',\n  lineups: 'NEXT EVENT LINEUPS',\n  summary: 'EVENT SUMMARY',\n};\n\n/**\n * Encode a URL parameter value safely\n * @param {string} value - Value to encode\n * @returns {string} Encoded value\n */\nfunction encode(value) {\n  return encodeURIComponent(value || '');\n}\n\n/**\n * Build URL for Team Logos graphic\n * @param {Object} options\n * @param {Object} options.teams - Team data keyed by team number (team1Name, team1Logo, etc.)\n * @param {number} options.teamCount - Number of teams to include\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildLogosURL({ teams, teamCount, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  for (let i = 1; i <= teamCount; i++) {\n    const logo = teams[`team${i}Logo`];\n    if (logo) {\n      params.set(`team${i}Logo`, logo);\n    }\n  }\n\n  return `${base}/overlays/logos.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Event Bar graphic\n * @param {Object} options\n * @param {string} options.team1Logo - Team 1 logo URL\n * @param {string} options.venue - Venue name\n * @param {string} options.eventName - Event/meet name\n * @param {string} options.location - Location\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildEventBarURL({ team1Logo, venue, eventName, location, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  if (team1Logo) params.set('team1Logo', team1Logo);\n  if (venue) params.set('venue', venue);\n  if (eventName) params.set('eventName', eventName);\n  if (location) params.set('location', location);\n\n  return `${base}/overlays/event-bar.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Hosts graphic\n * @param {Object} options\n * @param {string} options.hosts - Hosts (newline or pipe separated)\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildHostsURL({ hosts, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  // Convert newlines to pipes for URL\n  const hostsFormatted = hosts?.split('\\n').join('|') || '';\n  return `${base}/overlays/hosts.html?hosts=${encode(hostsFormatted)}`;\n}\n\n/**\n * Build URL for Team Stats graphic\n * @param {Object} options\n * @param {string} options.teamName - Team name\n * @param {string} options.logo - Team logo URL\n * @param {string} options.ave - Average score\n * @param {string} options.high - High score\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildTeamStatsURL({ teamName, logo, ave, high, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  if (teamName) params.set('teamName', teamName);\n  if (logo) params.set('logo', logo);\n  if (ave) params.set('ave', ave);\n  if (high) params.set('high', high);\n\n  return `${base}/overlays/team-stats.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Coaches graphic\n * @param {Object} options\n * @param {string} options.logo - Team logo URL\n * @param {string} options.coaches - Coaches (newline or pipe separated)\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildCoachesURL({ logo, coaches, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  // Convert newlines to pipes for URL\n  const coachesFormatted = coaches?.split('\\n').join('|') || '';\n  const params = new URLSearchParams();\n\n  if (logo) params.set('logo', logo);\n  if (coachesFormatted) params.set('coaches', coachesFormatted);\n\n  return `${base}/overlays/coaches.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Event Frame graphic\n * @param {Object} options\n * @param {string} options.eventId - Event ID (floor, vault, etc.)\n * @param {string} options.logo - Team logo URL\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildEventFrameURL({ eventId, logo, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const title = EVENT_TITLES[eventId] || eventId?.toUpperCase() || '';\n  const params = new URLSearchParams();\n\n  if (title) params.set('title', title);\n  if (logo) params.set('logo', logo);\n\n  return `${base}/overlays/event-frame.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Stream graphic (Starting/Thanks)\n * @param {Object} options\n * @param {string} options.type - 'starting' or 'thanks'\n * @param {string} options.logo - Team logo URL\n * @param {string} options.eventName - Event/meet name\n * @param {string} options.meetDate - Date of the meet\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildStreamURL({ type, logo, eventName, meetDate, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const title = type === 'starting' ? 'STREAM STARTING SOON' : 'THANKS FOR WATCHING';\n  const params = new URLSearchParams();\n\n  params.set('title', title);\n  if (logo) params.set('logo', logo);\n  if (eventName) params.set('eventName', eventName);\n  if (meetDate) params.set('meetDate', meetDate);\n\n  return `${base}/overlays/stream.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Frame Overlay graphics\n * @param {Object} options\n * @param {string} options.frameType - Frame type (quad, tri-center, tri-wide, team-header, single)\n * @param {Object} options.teams - Team data keyed by team number\n * @param {number} options.teamCount - Number of teams\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildFrameOverlayURL({ frameType, teams, teamCount, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  // Add team logos for frame overlays\n  for (let i = 1; i <= teamCount; i++) {\n    const logo = teams[`team${i}Logo`];\n    if (logo) {\n      params.set(`team${i}Logo`, logo);\n    }\n  }\n\n  return `${base}/overlays/frame-${frameType}.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Leaderboard graphic\n * @param {Object} options\n * @param {string} options.event - Event ID (floor, vault, etc. or 'all-around')\n * @param {string} options.virtiusSessionId - Virtius session ID for live data\n * @param {string} options.gender - Gender ('mens' or 'womens') for column visibility\n * @param {Object} options.teams - Team data keyed by team number\n * @param {number} options.teamCount - Number of teams\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildLeaderboardURL({ event, virtiusSessionId, gender, teams, teamCount, compId, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  // Competition ID is required for leaderboards (needs live Virtius data)\n  if (compId) params.set('comp', compId);\n  // Use leaderboardEvent to match output.html renderer expectation\n  if (event) params.set('leaderboardEvent', event);\n  if (virtiusSessionId) params.set('virtiusSessionId', virtiusSessionId);\n  if (gender) params.set('leaderboardGender', gender);\n\n  // Add team data for display\n  for (let i = 1; i <= teamCount; i++) {\n    const name = teams[`team${i}Name`];\n    const logo = teams[`team${i}Logo`];\n    if (name) params.set(`team${i}Name`, name);\n    if (logo) params.set(`team${i}Logo`, logo);\n  }\n\n  return `${base}/output.html?graphic=virtius-leaderboard&${params.toString()}`;\n}\n\n/**\n * Build URL for Event Summary graphic\n * @param {Object} options\n * @param {string} options.mode - 'rotation' or 'apparatus'\n * @param {number} [options.rotation] - Rotation number (1-6) if mode is 'rotation'\n * @param {string} [options.apparatus] - Apparatus ID (fx, ph, etc.) if mode is 'apparatus'\n * @param {string} options.virtiusSessionId - Virtius session ID for live data\n * @param {string} options.compType - Competition type for format determination\n * @param {string} options.gender - Gender ('mens' or 'womens')\n * @param {Object} options.teams - Team data keyed by team number\n * @param {number} options.teamCount - Number of teams\n * @param {string} [options.theme] - Summary theme ID\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildEventSummaryURL({ mode, rotation, apparatus, virtiusSessionId, compType, gender, teams, teamCount, theme, compId, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  // Competition ID is required for event summary (needs live Virtius data)\n  if (compId) params.set('comp', compId);\n  params.set('graphic', 'event-summary');\n\n  // Use virtiusSessionId to match output.html renderer expectation\n  if (virtiusSessionId) params.set('virtiusSessionId', virtiusSessionId);\n  if (theme) params.set('summaryTheme', theme);\n  if (gender) params.set('summaryGender', gender);\n\n  // Determine format based on competition type\n  const isDual = compType?.includes('dual');\n\n  if (mode === 'rotation') {\n    params.set('summaryMode', 'rotation');\n    params.set('summaryRotation', rotation);\n    params.set('summaryFormat', isDual ? 'alternating' : 'rotation');\n  } else if (mode === 'apparatus') {\n    params.set('summaryMode', 'apparatus');\n    params.set('summaryApparatus', apparatus);\n    params.set('summaryFormat', 'head-to-head');\n  }\n\n  params.set('summaryNumTeams', teamCount);\n\n  // Add team data\n  for (let i = 1; i <= teamCount; i++) {\n    const name = teams[`team${i}Name`];\n    const logo = teams[`team${i}Logo`];\n    if (name) params.set(`team${i}Name`, name);\n    if (logo) params.set(`team${i}Logo`, logo);\n  }\n\n  return `${base}/output.html?${params.toString()}`;\n}\n\n/**\n * Generate URL for any graphic based on ID\n * @param {string} graphicId - Graphic identifier\n * @param {Object} formData - Form data with team info, event details, etc.\n * @param {number} teamCount - Number of teams in competition\n * @param {string} [baseUrl] - Override base URL\n * @param {Object} [options] - Additional options (compType, virtiusSessionId, etc.)\n * @returns {string} Complete URL or empty string if unknown graphic\n */\nexport function generateGraphicURL(graphicId, formData, teamCount, baseUrl, options = {}) {\n  const base = baseUrl || getBaseURL();\n  const { compType, virtiusSessionId, compId, summaryTheme } = options;\n\n  // Helper to get team logo with placeholder fallback\n  const getTeamLogo = (teamNum) => {\n    const colors = ['00274C/FFCB05', 'BB0000/FFFFFF', '003087/FFFFFF', '228B22/FFFFFF', '800080/FFFFFF', 'FF8C00/FFFFFF'];\n    return formData[`team${teamNum}Logo`] || `https://via.placeholder.com/200/${colors[(teamNum - 1) % colors.length]}?text=T${teamNum}`;\n  };\n\n  // Helper to get all team data\n  const getTeamsData = () => {\n    const teams = { ...formData };\n    for (let i = 1; i <= teamCount; i++) {\n      if (!teams[`team${i}Logo`]) {\n        teams[`team${i}Logo`] = getTeamLogo(i);\n      }\n    }\n    return teams;\n  };\n\n  // Handle dynamic team stats/coaches graphics\n  const teamStatsMatch = graphicId.match(/^team(\\d+)-stats$/);\n  if (teamStatsMatch) {\n    const num = parseInt(teamStatsMatch[1]);\n    return buildTeamStatsURL({\n      teamName: formData[`team${num}Name`],\n      logo: getTeamLogo(num),\n      ave: formData[`team${num}Ave`],\n      high: formData[`team${num}High`],\n      baseUrl: base,\n    });\n  }\n\n  const teamCoachesMatch = graphicId.match(/^team(\\d+)-coaches$/);\n  if (teamCoachesMatch) {\n    const num = parseInt(teamCoachesMatch[1]);\n    return buildCoachesURL({\n      logo: getTeamLogo(num),\n      coaches: formData[`team${num}Coaches`],\n      baseUrl: base,\n    });\n  }\n\n  // Handle frame overlay graphics\n  const frameMatch = graphicId.match(/^frame-(quad|tri-center|tri-wide|team-header|single|dual)$/);\n  if (frameMatch) {\n    return buildFrameOverlayURL({\n      frameType: frameMatch[1],\n      teams: getTeamsData(),\n      teamCount,\n      baseUrl: base,\n    });\n  }\n\n  // Handle leaderboard graphics\n  const leaderboardMatch = graphicId.match(/^leaderboard-(.+)$/);\n  if (leaderboardMatch) {\n    // eventCode is already the short code (fx, ph, sr, vt, pb, hb, ub, bb, aa)\n    const eventCode = leaderboardMatch[1];\n    const gender = compType?.startsWith('mens') ? 'mens' : 'womens';\n    return buildLeaderboardURL({\n      event: eventCode, // Pass short code directly - renderer expects fx, ph, etc.\n      virtiusSessionId,\n      gender,\n      teams: getTeamsData(),\n      teamCount,\n      compId,\n      baseUrl: base,\n    });\n  }\n\n  // Handle event summary graphics\n  const summaryRotationMatch = graphicId.match(/^summary-r(\\d+)$/);\n  if (summaryRotationMatch) {\n    const rotation = parseInt(summaryRotationMatch[1]);\n    const gender = compType?.startsWith('mens') ? 'mens' : 'womens';\n    return buildEventSummaryURL({\n      mode: 'rotation',\n      rotation,\n      virtiusSessionId,\n      compType,\n      gender,\n      teams: getTeamsData(),\n      teamCount,\n      theme: summaryTheme,\n      compId,\n      baseUrl: base,\n    });\n  }\n\n  const summaryApparatusMatch = graphicId.match(/^summary-(fx|ph|sr|vt|pb|hb|ub|bb)$/);\n  if (summaryApparatusMatch) {\n    const apparatus = summaryApparatusMatch[1];\n    const gender = compType?.startsWith('mens') ? 'mens' : 'womens';\n    return buildEventSummaryURL({\n      mode: 'apparatus',\n      apparatus,\n      virtiusSessionId,\n      compType,\n      gender,\n      teams: getTeamsData(),\n      teamCount,\n      theme: summaryTheme,\n      compId,\n      baseUrl: base,\n    });\n  }\n\n  // Handle standard graphics\n  switch (graphicId) {\n    case 'logos':\n      return buildLogosURL({\n        teams: {\n          ...formData,\n          // Ensure all team logos have values (with fallbacks)\n          ...Object.fromEntries(\n            Array.from({ length: teamCount }, (_, i) => [\n              `team${i + 1}Logo`,\n              getTeamLogo(i + 1)\n            ])\n          ),\n        },\n        teamCount,\n        baseUrl: base,\n      });\n\n    case 'event-bar':\n      return buildEventBarURL({\n        team1Logo: getTeamLogo(1),\n        venue: formData.venue,\n        eventName: formData.eventName,\n        location: formData.location,\n        baseUrl: base,\n      });\n\n    case 'warm-up':\n      // Warm-up graphic uses event-bar.html with warm-up title\n      const warmUpParams = new URLSearchParams();\n      warmUpParams.set('title', 'WARM UP');\n      warmUpParams.set('team1Logo', getTeamLogo(1));\n      if (formData.venue) warmUpParams.set('venue', formData.venue);\n      return `${base}/overlays/warm-up.html?${warmUpParams.toString()}`;\n\n    case 'replay':\n      // Replay graphic - simple instant replay indicator\n      const replayParams = new URLSearchParams();\n      replayParams.set('team1Logo', getTeamLogo(1));\n      return `${base}/overlays/replay.html?${replayParams.toString()}`;\n\n    case 'hosts':\n      return buildHostsURL({\n        hosts: formData.hosts,\n        baseUrl: base,\n      });\n\n    case 'floor':\n    case 'pommel':\n    case 'rings':\n    case 'vault':\n    case 'pbars':\n    case 'hbar':\n    case 'ubars':\n    case 'beam':\n    case 'allaround':\n    case 'final':\n    case 'order':\n    case 'lineups':\n    case 'summary':\n      return buildEventFrameURL({\n        eventId: graphicId,\n        logo: getTeamLogo(1),\n        baseUrl: base,\n      });\n\n    case 'starting':\n      return buildStreamURL({\n        type: 'starting',\n        logo: getTeamLogo(1),\n        eventName: formData.eventName,\n        meetDate: formData.meetDate,\n        baseUrl: base,\n      });\n\n    case 'thanks':\n      return buildStreamURL({\n        type: 'thanks',\n        logo: getTeamLogo(1),\n        eventName: formData.eventName,\n        meetDate: formData.meetDate,\n        baseUrl: base,\n      });\n\n    default:\n      return '';\n  }\n}\n\n/**\n * Copy text to clipboard with fallback\n * @param {string} text - Text to copy\n * @returns {Promise<boolean>} Success status\n */\nexport async function copyToClipboard(text) {\n  // Try modern clipboard API first\n  if (navigator.clipboard && window.isSecureContext) {\n    try {\n      await navigator.clipboard.writeText(text);\n      return true;\n    } catch (err) {\n      console.warn('Clipboard API failed, trying fallback:', err);\n    }\n  }\n\n  // Fallback for older browsers or non-secure contexts\n  try {\n    const textArea = document.createElement('textarea');\n    textArea.value = text;\n    textArea.style.cssText = 'position:fixed;left:-9999px;top:-9999px;';\n    document.body.appendChild(textArea);\n    textArea.focus();\n    textArea.select();\n    const success = document.execCommand('copy');\n    document.body.removeChild(textArea);\n    return success;\n  } catch (err) {\n    console.error('Fallback copy failed:', err);\n    return false;\n  }\n}\n\n/**\n * Get the file path for a graphic\n * @param {string} graphicId - Graphic identifier\n * @returns {string} HTML file path\n */\nexport function getGraphicPath(graphicId) {\n  // Check registry first\n  const graphic = getGraphicById(graphicId);\n  if (graphic?.file) {\n    return graphic.file;\n  }\n  // Fallback to old mapping\n  return GRAPHIC_PATHS[graphicId] || `${graphicId}.html`;\n}\n\n/**\n * Build URL from registry schema (for simple overlay graphics)\n * This function uses the registry schema to build URLs for graphics that follow\n * the standard pattern: overlays/{file}?{params}\n *\n * Complex graphics (leaderboards, event-summary, etc.) still use their dedicated\n * builder functions as they have special logic.\n *\n * @param {string} graphicId - Graphic ID\n * @param {Object} formData - Form data with values\n * @param {number} teamCount - Number of teams\n * @param {Object} [options] - Additional options\n * @returns {string|null} URL or null if graphic not found or not supported\n */\nexport function buildGraphicUrlFromRegistry(graphicId, formData, teamCount, options = {}) {\n  const graphic = getGraphicById(graphicId);\n  if (!graphic) return null;\n\n  const base = options.baseUrl || getBaseURL();\n\n  // Only handle simple overlay graphics for now\n  // Complex graphics (leaderboards, event-summary) use dedicated builders\n  if (graphic.renderer !== 'overlay') return null;\n\n  const params = new URLSearchParams();\n\n  // Build params from schema\n  if (graphic.params) {\n    for (const [paramKey, paramSchema] of Object.entries(graphic.params)) {\n      let value = null;\n\n      if (paramSchema.source === 'competition') {\n        // Auto-fill from formData based on param name\n        // Handle team-specific params like team1Logo\n        if (paramKey in formData) {\n          value = formData[paramKey];\n        }\n      } else if (paramSchema.default !== undefined) {\n        // Use default value\n        value = paramSchema.default;\n      }\n\n      if (value !== null && value !== undefined && value !== '') {\n        params.set(paramKey, value);\n      }\n    }\n  }\n\n  const queryString = params.toString();\n  const path = graphic.file.endsWith('.html')\n    ? `overlays/${graphic.file}`\n    : `overlays/${graphic.file}.html`;\n\n  return queryString ? `${base}/${path}?${queryString}` : `${base}/${path}`;\n}\n\n/**\n * Check if a graphic is transparent based on registry\n * Re-exports the registry function for backwards compatibility\n */\nexport { registryIsTransparent as isTransparentGraphicFromRegistry };\n\nexport default {\n  getBaseURL,\n  buildLogosURL,\n  buildEventBarURL,\n  buildHostsURL,\n  buildTeamStatsURL,\n  buildCoachesURL,\n  buildEventFrameURL,\n  buildStreamURL,\n  buildFrameOverlayURL,\n  buildLeaderboardURL,\n  buildEventSummaryURL,\n  generateGraphicURL,\n  buildGraphicUrlFromRegistry,\n  copyToClipboard,\n  getGraphicPath,\n};\n","numLines":656,"startLine":1,"totalLines":656}}}
