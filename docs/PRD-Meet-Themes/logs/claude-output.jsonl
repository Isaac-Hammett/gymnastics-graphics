\n  1077→ * @returns {Array} Array of category names\n  1078→ */\n  1079→export function getCategories() {\n  1080→  const categories = new Set(getAllGraphics().map(g => g.category));\n  1081→  return Array.from(categories);\n  1082→}\n  1083→\n  1084→/**\n  1085→ * Check if a graphic is available for a given competition type\n  1086→ * @param {Object} graphic - Graphic definition\n  1087→ * @param {string} compType - Competition type (e.g., 'womens-quad', 'mens-dual')\n  1088→ * @param {number} teamCount - Number of teams\n  1089→ * @returns {boolean} True if graphic is available\n  1090→ */\n  1091→export function isGraphicAvailable(graphic, compType, teamCount) {\n  1092→  // Check gender filter\n  1093→  const isMens = compType?.startsWith('mens');\n  1094→  if (graphic.gender === 'mens' && !isMens) return false;\n  1095→  if (graphic.gender === 'womens' && isMens) return false;\n  1096→\n  1097→  // Check team count constraints\n  1098→  if (graphic.minTeams && teamCount < graphic.minTeams) return false;\n  1099→  if (graphic.maxTeams && teamCount > graphic.maxTeams) return false;\n  1100→\n  1101→  return true;\n  1102→}\n  1103→\n  1104→/**\n  1105→ * Get graphics available for a specific competition, with dynamic labels\n  1106→ * @param {string} compType - Competition type (e.g., 'womens-quad', 'mens-dual')\n  1107→ * @param {Object} teamNames - Team names keyed by number (e.g., { 1: 'UCLA', 2: 'Oregon' })\n  1108→ * @param {string} [category] - Optional category filter\n  1109→ * @returns {Array} Array of graphic definitions with resolved labels\n  1110→ */\n  1111→export function getGraphicsForCompetition(compType, teamNames = {}, category = null) {\n  1112→  const isMens = compType?.startsWith('mens');\n  1113→  const teamCount = Object.keys(teamNames).length || 2;\n  1114→\n  1115→  const results = [];\n  1116→\n  1117→  for (const graphic of getAllGraphics()) {\n  1118→    // Filter by category if specified\n  1119→    if (category && graphic.category !== category) continue;\n  1120→\n  1121→    // Check availability\n  1122→    if (!isGraphicAvailable(graphic, compType, teamCount)) continue;\n  1123→\n  1124→    // Handle perTeam graphics - expand to team1-*, team2-*, etc.\n  1125→    if (graphic.perTeam) {\n  1126→      for (let i = 1; i <= teamCount; i++) {\n  1127→        const teamName = teamNames[i] || `Team ${i}`;\n  1128→        const expandedId = `team${i}-${graphic.id.replace('team-', '')}`;\n  1129→        const label = graphic.labelTemplate\n  1130→          ? graphic.labelTemplate.replace('{teamName}', teamName)\n  1131→          : `${teamName} ${graphic.label.replace('Team ', '')}`;\n  1132→\n  1133→        results.push({\n  1134→          ...graphic,\n  1135→          id: expandedId,\n  1136→          label,\n  1137→          team: i,\n  1138→        });\n  1139→      }\n  1140→    } else {\n  1141→      // Regular graphic - just add with optional label substitution\n  1142→      let label = graphic.label;\n  1143→      if (graphic.labelTemplate) {\n  1144→        // Replace any team name placeholders\n  1145→        for (const [num, name] of Object.entries(teamNames)) {\n  1146→          label = label.replace(`{team${num}Name}`, name);\n  1147→        }\n  1148→      }\n  1149→      results.push({ ...graphic, label });\n  1150→    }\n  1151→  }\n  1152→\n  1153→  return results;\n  1154→}\n  1155→\n  1156→/**\n  1157→ * Get recommended graphic based on segment name\n  1158→ * @param {string} segmentName - Name of the segment (e.g., \"UCLA Coaches Introduction\")\n  1159→ * @param {string} compType - Competition type\n  1160→ * @param {Object} teamNames - Team names keyed by number\n  1161→ * @returns {Object|null} Best matching graphic with confidence score, or null\n  1162→ */\n  1163→export function getRecommendedGraphic(segmentName, compType, teamNames = {}) {\n  1164→  if (!segmentName) return null;\n  1165→\n  1166→  const normalizedName = segmentName.toLowerCase();\n  1167→  const availableGraphics = getGraphicsForCompetition(compType, teamNames);\n  1168→\n  1169→  let bestMatch = null;\n  1170→  let bestScore = 0;\n  1171→\n  1172→  for (const graphic of availableGraphics) {\n  1173→    let score = 0;\n  1174→\n  1175→    // Check keywords\n  1176→    for (const keyword of graphic.keywords || []) {\n  1177→      if (normalizedName.includes(keyword.toLowerCase())) {\n  1178→        score += 10;\n  1179→      }\n  1180→    }\n  1181→\n  1182→    // Check label match\n  1183→    if (normalizedName.includes(graphic.label.toLowerCase())) {\n  1184→      score += 20;\n  1185→    }\n  1186→\n  1187→    // Check team name match for per-team graphics\n  1188→    if (graphic.team) {\n  1189→      const teamName = teamNames[graphic.team];\n  1190→      if (teamName && normalizedName.includes(teamName.toLowerCase())) {\n  1191→        score += 30;\n  1192→      }\n  1193→    }\n  1194→\n  1195→    if (score > bestScore) {\n  1196→      bestScore = score;\n  1197→      bestMatch = graphic;\n  1198→    }\n  1199→  }\n  1200→\n  1201→  if (bestMatch && bestScore > 0) {\n  1202→    // Calculate confidence (0-1)\n  1203→    const confidence = Math.min(1, bestScore / 50);\n  1204→    return { ...bestMatch, confidence };\n  1205→  }\n  1206→\n  1207→  return null;\n  1208→}\n  1209→\n  1210→/**\n  1211→ * Check if a graphic should have a transparent background\n  1212→ * @param {string} graphicId - Graphic ID\n  1213→ * @returns {boolean} True if transparent\n  1214→ */\n  1215→export function isTransparentGraphic(graphicId) {\n  1216→  // Handle team-specific graphics\n  1217→  if (/^team\\d+-(stats|coaches)$/.test(graphicId)) {\n  1218→    return true;\n  1219→  }\n  1220→\n  1221→  const graphic = getGraphicById(graphicId);\n  1222→  return graphic?.transparent ?? false;\n  1223→}\n  1224→\n  1225→export default {\n  1226→  GRAPHICS,\n  1227→  getAllGraphics,\n  1228→  getGraphicById,\n  1229→  getGraphicsByCategory,\n  1230→  getCategories,\n  1231→  isGraphicAvail