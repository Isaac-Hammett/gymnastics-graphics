-size: 36px;\n      font-weight: 800;\n      color: #fff;\n      margin-left: auto;\n    }\n    .layout-dual-dynamic-v1 .team-header.right .team-total {\n      margin-left: 0;\n      margin-right: auto;\n    }\n    .layout-dual-dynamic-v1 .athlete-list {\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      background: #18181b;\n      gap: 4px;\n      padding: 4px 0;\n      min-height: 0;\n    }\n    .layout-dual-dynamic-v1 .athlete-row {\n      display: flex;\n      align-items: center;\n      padding: 12px 20px;\n      flex: 1;\n      min-height: 0; /* KEY DIFFERENCE: No min-height, allows scaling for 9 athletes */\n      background: #27272a;\n      gap: 16px;\n    }\n    /* Left side layout - score then D-score */\n    .layout-dual-dynamic-v1 .team-column.left .athlete-row {\n      flex-direction: row;\n    }\n    .layout-dual-dynamic-v1 .team-column.left .athlete-score-block {\n      flex-direction: row-reverse;\n      justify-content: flex-end;\n    }\n    /* Right side - mirrored layout */\n    .layout-dual-dynamic-v1 .team-column.right .athlete-row {\n      flex-direction: row-reverse;\n    }\n    .layout-dual-dynamic-v1 .team-column.right .athlete-info {\n      text-align: right;\n    }\n    .layout-dual-dynamic-v1 .team-column.right .athlete-score-block {\n      flex-direction: row;\n      justify-content: flex-start;\n    }\n    .layout-dual-dynamic-v1 .athlete-order {\n      width: 52px;\n      height: 52px;\n      border-radius: 50%;\n      background: #52525b;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 24px;\n      font-weight: 700;\n      color: #fff;\n      flex-shrink: 0;\n    }\n    .layout-dual-dynamic-v1 .athlete-order.anchor {\n      background: #eab308;\n      color: #000;\n    }\n    .layout-dual-dynamic-v1 .athlete-photo {\n      width: 88px;\n      height: 88px;\n      border-radius: 8px;\n      object-fit: contain;\n      background: transparent;\n      flex-shrin