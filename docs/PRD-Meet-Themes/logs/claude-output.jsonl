ams);\n          } else if (layout === 'default-v19') {\n            renderMultiTeamSummaryV19(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v20') {\n            renderMultiTeamSummaryV20(contentEl, rotationData, rotation, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v21') {\n            renderMultiTeamSummaryV21(contentEl, rotationData, rotation, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v22') {\n            renderMultiTeamSummaryV22(contentEl, rotationData, rotation, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v23') {\n            renderMultiTeamSummaryV23(contentEl, rotationData, rotation, actualNumTeams, apparatusRankings);\n          } else if (layout === 'split-row') {\n            renderMultiTeamSummarySplitRow(contentEl, rotationData, rotation, actualNumTeams, apparatusRankings);\n          } else {\n            renderDualMeetSummary(contentEl, rotationData, rotation);\n          }\n        } else {\n          // Multi-team meet (3+ teams)\n          if (layout === 'default-v3') {\n            renderMultiTeamSummaryV3(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v4') {\n            renderMultiTeamSummaryV4(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v5') {\n            renderMultiTeamSummaryV5(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v6') {\n            renderMultiTeamSummaryV6(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v7') {\n            renderMultiTeamSummaryV7(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v8') {\n            renderMultiTeamSummaryV8(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v9') {\n            renderMultiTeamSummaryV9(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v10') {\n            renderMultiTeamSummaryV10(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v11') {\n            renderMultiTeamSummaryV11(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v12') {\n            renderMultiTeamSummaryV12(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v13') {\n            renderMultiTeamSummaryV13(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v14') {\n            renderMultiTeamSummaryV14(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v15') {\n            renderMultiTeamSummaryV15(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v16') {\n            renderMultiTeamSummaryV16(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v17') {\n            renderMultiTeamSummaryV17(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v18') {\n            renderMultiTeamSummaryV18(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v19') {\n            renderMultiTeamSummaryV19(contentEl, rotationData, rotation, actualNumTeams);\n          } else if (layout === 'default-v20') {\n            renderMultiTeamSummaryV20(contentEl, rotationData, rotation, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v21') {\n            renderMultiTeamSummaryV21(contentEl, rotationData, rotation, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v22') {\n            renderMultiTeamSummaryV22(contentEl, rotationData, rotation, actualNumTeams, apparatusRankings);\n          } else if (layout === 'default-v23') {\n            renderMultiTeamSummaryV23(contentEl, rotationData, rotation, actualNumTeams, apparatusRankings);\n          } else if (layout === 'split-row') {\n            renderMultiTeamSummarySplitRow(contentEl, rotationData, rotation, actualNumTeams, apparatusRankings);\n          } else {\n            renderMultiTeamSummary(contentEl, rotationData, rotation, actualNumTeams);\n          }\n        }\n\n      } catch (error) {\n        console.error('Event summary fetch error:', error);\n        contentEl.innerHTML = '<div class=\"event-summary-error\">Error loading event summary</div>';\n      }\n    }\n\n    // SVG icons for events\n    const EVENT_ICONS = {\n      'FX': `<svg class=\"event-icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><rect x=\"2\" y=\"18\" width=\"20\" height=\"4\" rx=\"1\"/><rect x=\"4\" y=\"14\" width=\"16\" height=\"2\" rx=\"0.5\"/></svg>`,\n      'PH': `<svg class=\"event-icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><ellipse cx=\"12\" cy=\"12\" rx=\"10\" ry=\"4\"/><rect x=\"6\" y=\"4\" width=\"2\" height=\"8\" rx=\"1\"/><rect x=\"16\" y=\"4\" width=\"2\" height=\"8\" rx=\"1\"/></svg>`,\n      'SR': `<svg class=\"event-icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"7\" cy=\"16\" r=\"4\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\"/><circle cx=\"17\" cy=\"16\" r=\"4\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\"/><line x1=\"7\" y1=\"12\" x2=\"7\" y2=\"4\" stroke=\"currentColor\" stroke-width=\"2\"/><line x1=\"17\" y1=\"12\" x2=\"17\" y2=\"4\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>`,\n      'VT': `<svg class=\"event-icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><rect x=\"8\" y=\"8\" width=\"8\" height=\"12\" rx=\"1\" transform=\"rotate(-15 12 14)\"/><rect x=\"2\" y=\"18\" width=\"6\" height=\"4\" rx=\"1\"/></svg>`,\n      'PB': `<svg class=\"event-icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><rect x=\"3\" y=\"10\" width=\"18\" height=\"2\" rx=\"1\"/><rect x=\"3\" y=\"16\" width=\"18\" height=\"2\" rx=\"1\"/><rect x=\"5\" y=\"8\" width=\"2\" height=\"12\" rx=\"0.5\"/><rect x=\"17\" y=\"8\" width=\"2\" height=\"12\" rx=\"0.5\"/></svg>`,\n      'HB': `<svg class=\"event-icon\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><rect x=\"2\" y=\"10\" width=\"20\" height=\"2\" rx=\"1\"/><rect x=\"4\" y=\"10\" width=\"2\" height=\"10\" rx=\"0.5\"/><rect x=\"18\" y=\"10\" width=\"2\" height=\"10\" rx=\"0.5\"/></svg>`,\n    };\n\n    // Render dual meet layout (2 teams side-by-side with center divider)\n    function renderDualMeetSummary(contentEl, rotationData, rotation) {\n      const team1 = rotationData[0];\n      const team2 = rotationData[1];\n\n      // Calculate score differences for each lineup position\n      const maxAthletes = Math.max(team1.gymnasts.length, team2.gymnasts.length);\n\n      // Build left team column\n      const leftColumn = buildTeamColumn(team1, 'left', maxAthletes);\n      const rightColumn = buildTeamColumn(team2, 'right', maxAthletes);\n\n      // Build center divider with visual diff bars\n      let centerHtml = `<div class=\"center-divider\"><div class=\"center-header\"><div class=\"rotation-badge\">R${rotation}</div></div>`;\n      for (let i = 0; i < maxAthletes; i++) {\n        const score1 = team1.gymnasts[i] ? parseFloat(team1.gymnasts[i].final_score) || 0 : 0;\n        const score2 = team2.gymnasts[i] ? parseFloat(team2.gymnasts[i].final_score) || 0 : 0;\n        const diff = score1 - score2;\n        const diffStr = (score1 === 0 && score2 === 0) ? '--' : diff.toFixed(3);\n\n        // Calculate bar width (max diff around 2.0 points maps to 50% width)\n        const barWidth = Math.min(Math.abs(diff) * 25, 50);\n        let barClass = 'tie';\n        if (diff > 0.001) barClass = 'left';\n        else if (diff < -0.001) barClass = 'right';\n\n        centerHtml += `\n          <div class=\"diff-row\">\n            <div class=\"diff-value\">${diffStr}</div>\n            <div class=\"diff-bar\">\n              <div class=\"diff-bar-fill ${barClass}\" style=\"width: ${barWidth}%;\"></div>\n            </div>\n          </div>\n        `;\n      }\n      centerHtml += '</div>';\n\n      // Calculate event total difference\n      const eventDiff = team1.eventScore - team2.eventScore;\n      const eventDiffStr = eventDiff.toFixed(3);\n      const eventBarWidth = Math.min(Math.abs(eventDiff) * 5, 50);\n      let eventBarClass = 'tie';\n      if (eventDiff > 0.001) eventBarClass = 'left';\n      else if (eventDiff < -0.001) eventBarClass = 'right';\n\n      // Build footer with event totals and icons\n      const footerHtml = `\n        <div class=\"event-summary-footer\">\n          <div class=\"footer-team left\">\n            <div class=\"event-abbr\">${team1.eventShortCode}</div>\n            ${EVENT_ICONS[team1.eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team1.eventScore > 0 ? team1.eventScore.toFixed(3) : '—'}</div>\n          </div>\n          <div class=\"footer-center\">\n            <div class=\"footer-diff\">${eventDiffStr}</div>\n            <div class=\"footer-diff-bar\">\n              <div class=\"footer-diff-fill ${eventBarClass}\" style=\"width: ${eventBarWidth}%;\"></div>\n            </div>\n          </div>\n          <div class=\"footer-team right\">\n            <div class=\"event-abbr\">${team2.eventShortCode}</div>\n            ${EVENT_ICONS[team2.eventShortCode] || ''}\n            <div class=\"event-label\">Event Total</div>\n            <div class=\"event-total\">${team2.eventScore > 0 ? team2.eventScore.toFixed(3) : '—'}</div>\n          </div>\n        </div>\n      `;\n\n      contentEl.innerHTML = `\n        <div class=\"event-summary-dual\">\n          ${leftColumn}\n          ${centerHtml}\n          ${rightColumn}\n        </div>\n        ${footerHtml}\n      `;\n    }\n\n    // Build a team column for dual meet layout\n    function buildTeamColumn(teamData, side, maxAthletes) {\n      const { team, gymnasts, totalScore, eventShortCode } = teamData;\n\n      let athletesHtml = '';\n      for (let i = 0; i < maxAthletes; i++) {\n        const g = gymnasts[i];\n        if (g) {\n          const score = parseFloat(g.final_score) || 0;\n          // Get start value from scores array\n          const startValue = g.scores && g.scores.length > 0 ? parseFloat(g.scores[0].start) || 0 : 0;\n          const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n          // Look up headshot from library first, fall back to API headshot\n          const photoUrl = getAthleteHeadshot(g.first_name, g.last_name, g.headshot);\n\n          athletesHtml += `\n            <div class=\"athlete-row\">\n              <div class=\"athlete-order\">${i + 1}</div>\n              ${renderAthletePhoto(photoUrl)}\n              <div class=\"athlete-name\">${name}</div>\n              <div class=\"athlete-score-block\">\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : 'On Eval'}</div>\n                ${startValue > 0 ? `<div class=\"athlete-start\">${startValue.toFixed(2)}</div>` : ''}\n              </div>\n            </div>\n          `;\n        } else {\n          athletesHtml += `<div class=\"athlete-row\" style=\"min-height: 72px;\"></div>`;\n        }\n      }\n\n      const logoUrl = getTeamLogoUrl(team.name, team.logo);\n      return `\n        <div class=\"team-column ${side}\">\n          <div class=\"team-header ${side}\">\n            ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n            <div class=\"team-name\">${team.name || team.tricode}</div>\n            <div class=\"team-total\">${totalScore > 0 ? totalScore.toFixed(3) : ''}</div>\n          </div>\n          <div class=\"athlete-list\">\n            ${athletesHtml}\n          </div>\n        </div>\n      `;\n    }\n\n    // Render multi-team layout (quad meet - 4 columns)\n    function renderMultiTeamSummary(contentEl, rotationData, rotation, numTeams) {\n      let columnsHtml = '';\n\n      rotationData.forEach(teamData => {\n        const { team, eventDisplayName, eventShortCode, gymnasts, eventScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n\n        let athletesHtml = '';\n        gymnasts.forEach((g, i) => {\n          const score = parseFloat(g.final_score) || 0;\n          const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n          athletesHtml += `\n            <div class=\"athlete-row\">\n              <div class=\"athlete-order\">${i + 1}</div>\n              <div class=\"athlete-name\">${name}</div>\n              <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : ''}</div>\n            </div>\n          `;\n        });\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              <div class=\"event-name\">${eventDisplayName}</div>\n              <div class=\"team-name\">\n                ${team.name || team.tricode}\n                ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-quad\">${columnsHtml}</div>`;\n    }\n\n    // Render multi-team layout V3 (full-height symmetric rows)\n    // Key features:\n    // - All columns have same number of rows (max across all teams, capped at 10)\n    // - Rows stretch to fill available height equally\n    // - Empty rows are styled consistently\n    // - No headshots, clean text-only design\n    function renderMultiTeamSummaryV3(contentEl, rotationData, rotation, numTeams) {\n      // Find max athletes across all teams (cap at 10)\n      const maxAthletes = Math.min(\n        Math.max(...rotationData.map(t => t.gymnasts.length)),\n        10\n      );\n\n      let columnsHtml = '';\n\n      rotationData.forEach(teamData => {\n        const { team, eventDisplayName, gymnasts, eventScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n\n        // Build athlete rows - pad to maxAthletes for symmetry\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            // Empty placeholder row for symmetry\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              <div class=\"event-name\">${eventDisplayName}</div>\n              <div class=\"team-name\">\n                ${team.name || team.tricode}\n                ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-quad-v3 teams-${numTeams}\">${columnsHtml}</div>`;\n    }\n\n    // Render multi-team apparatus layout V3 (all teams on same event, full-height)\n    function renderMultiTeamSummaryApparatusV3(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      // Find max athletes across all teams (cap at 10)\n      const maxAthletes = Math.min(\n        Math.max(...apparatusData.map(t => t.gymnasts.length)),\n        10\n      );\n\n      let columnsHtml = '';\n\n      apparatusData.forEach(teamData => {\n        const { team, gymnasts, eventScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n\n        // Build athlete rows - pad to maxAthletes for symmetry\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            // Empty placeholder row for symmetry\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              <div class=\"event-name\">${eventDisplayName}</div>\n              <div class=\"team-name\">\n                ${team.name || team.tricode}\n                ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-quad-v3 teams-${numTeams}\">${columnsHtml}</div>`;\n    }\n\n    // V4 Layout: Single header row with rank, logo, team, score, event\n    // Key features:\n    // - Each column header has all info in one row (rank badge, logo, team name, total score, event name)\n    // - No separate standings bar - all info integrated into column headers\n    // - All columns have same number of rows (max across all teams, capped at 10)\n    function renderMultiTeamSummaryV4(contentEl, rotationData, rotation, numTeams) {\n      // Find max athletes across all teams (cap at 10)\n      const maxAthletes = Math.min(\n        Math.max(...rotationData.map(t => t.gymnasts.length)),\n        10\n      );\n\n      // Calculate rankings based on total score\n      const sortedByScore = [...rotationData].sort((a, b) => (b.totalScore || 0) - (a.totalScore || 0));\n      const rankMap = new Map();\n      sortedByScore.forEach((t, idx) => {\n        rankMap.set(t.team.name || t.team.tricode, idx + 1);\n      });\n\n      // Build columns (in original team order, but with rankings)\n      let columnsHtml = '';\n      rotationData.forEach(teamData => {\n        const { team, eventDisplayName, gymnasts, eventScore, totalScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n        const rank = rankMap.get(teamName) || 0;\n        const rankSuffix = rank === 1 ? 'ST' : rank === 2 ? 'ND' : rank === 3 ? 'RD' : 'TH';\n        const rankClass = rank <= 3 && totalScore > 0 ? `rank-${rank}` : '';\n\n        // Build athlete rows - pad to maxAthletes for symmetry\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"column-header\">\n              <div class=\"rank-badge ${rankClass}\">${rank}${rankSuffix}</div>\n              ${logoUrl ? `<img class=\"header-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-team-name\">${teamName}</div>\n              <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              <div class=\"header-event\">${eventDisplayName}</div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `\n        <div class=\"event-summary-v4-wrapper\">\n          <div class=\"event-summary-quad-v4 teams-${numTeams}\">${columnsHtml}</div>\n        </div>\n      `;\n    }\n\n    // Render multi-team apparatus layout V4 (all teams on same event, single header row)\n    function renderMultiTeamSummaryApparatusV4(contentEl, apparatusData, eventDisplayName, eventShortCode, numTeams) {\n      // Find max athletes across all teams (cap at 10)\n      const maxAthletes = Math.min(\n        Math.max(...apparatusData.map(t => t.gymnasts.length)),\n        10\n      );\n\n      // Calculate rankings based on total score\n      const sortedByScore = [...apparatusData].sort((a, b) => (b.totalScore || 0) - (a.totalScore || 0));\n      const rankMap = new Map();\n      sortedByScore.forEach((t, idx) => {\n        rankMap.set(t.team.name || t.team.tricode, idx + 1);\n      });\n\n      // Build columns (in original team order, but with rankings)\n      let columnsHtml = '';\n      apparatusData.forEach(teamData => {\n        const { team, gymnasts, eventScore, totalScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n        const rank = rankMap.get(teamName) || 0;\n        const rankSuffix = rank === 1 ? 'ST' : rank === 2 ? 'ND' : rank === 3 ? 'RD' : 'TH';\n        const rankClass = rank <= 3 && totalScore > 0 ? `rank-${rank}` : '';\n\n        // Build athlete rows - pad to maxAthletes for symmetry\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"column-header\">\n              <div class=\"rank-badge ${rankClass}\">${rank}${rankSuffix}</div>\n              ${logoUrl ? `<img class=\"header-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-team-name\">${teamName}</div>\n              <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              <div class=\"header-event\">${eventDisplayName}</div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `\n        <div class=\"event-summary-v4-wrapper\">\n          <div class=\"event-summary-quad-v4 teams-${numTeams}\">${columnsHtml}</div>\n        </div>\n      `;\n    }\n\n    // Generic render function that works for all V5-V19 layouts\n    // Each layout uses different CSS class and may have unique HTML structure\n    function renderGenericLayout(contentEl, data, numTeams, layoutVersion, isApparatus = false, eventDisplayName = '') {\n      const maxAthletes = Math.min(Math.max(...data.map(t => t.gymnasts.length)), 10);\n\n      let columnsHtml = '';\n      data.forEach((teamData, teamIndex) => {\n        const { team, gymnasts, eventScore, totalScore } = teamData;\n        const evtName = isApparatus ? eventDisplayName : teamData.eventDisplayName;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n\n        // Build athlete rows\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          const score = g ? parseFloat(g.final_score) || 0 : 0;\n          const name = g ? `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}` : '—';\n          const emptyClass = g ? '' : ' empty';\n          const scoreDisplay = score > 0 ? score.toFixed(3) : '—';\n\n          // Different HTML structures based on layout version\n          switch(layoutVersion) {\n            case 'v7': // Progress bar layout\n              const barWidth = score > 0 ? ((score / 10) * 100) : 0;\n              athletesHtml += `\n                <div class=\"athlete-row${emptyClass}\">\n                  <div class=\"athlete-info\">\n                    <div class=\"athlete-name\">${name}</div>\n                    <div class=\"athlete-score\">${scoreDisplay}</div>\n                  </div>\n                  <div class=\"score-bar\"><div class=\"score-bar-fill\" style=\"width: ${barWidth}%;\"></div></div>\n                </div>\n              `;\n              break;\n            case 'v10': // Score focus (centered, score above name)\n              athletesHtml += `\n                <div class=\"athlete-row${emptyClass}\">\n                  <div class=\"athlete-score\">${scoreDisplay}</div>\n                  <div class=\"athlete-name\">${name}</div>\n                </div>\n              `;\n              break;\n            case 'v11': // Two-line with info div\n              athletesHtml += `\n                <div class=\"athlete-row${emptyClass}\">\n                  <div class=\"athlete-order\">${i + 1}</div>\n                  <div class=\"athlete-info\">\n                    <div class=\"athlete-name\">${name}</div>\n                  </div>\n                  <div class=\"athlete-score\">${scoreDisplay}</div>\n                </div>\n              `;\n              break;\n            case 'v17': // Inline scores (name + score together, then spacer)\n              athletesHtml += `\n                <div class=\"athlete-row${emptyClass}\">\n                  <div class=\"athlete-order\">${i + 1}</div>\n                  <div class=\"athlete-name\">${name}</div>\n                  <div class=\"athlete-score\">${scoreDisplay}</div>\n                  <div class=\"spacer\"></div>\n                </div>\n              `;\n              break;\n            default: // Standard layout\n              athletesHtml += `\n                <div class=\"athlete-row${emptyClass}\">\n                  <div class=\"athlete-order\">${i + 1}</div>\n                  <div class=\"athlete-name\">${name}</div>\n                  <div class=\"athlete-score\">${scoreDisplay}</div>\n                </div>\n              `;\n          }\n        }\n\n        // Different header structures based on layout version\n        let headerHtml = '';\n        switch(layoutVersion) {\n          case 'v5': // Compact gradient\n            headerHtml = `\n              <div class=\"team-header\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${evtName}</div>\n              </div>\n            `;\n            break;\n          case 'v6': // Cards with logo\n            headerHtml = `\n              <div class=\"team-header\">\n                ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n                <div class=\"header-info\">\n                  <div class=\"team-name\">${teamName}</div>\n                  <div class=\"event-name\">${evtName}</div>\n                </div>\n              </div>\n            `;\n            break;\n          case 'v7': // Horizontal bars - name left, event right\n            headerHtml = `\n              <div class=\"team-header\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${evtName}</div>\n              </div>\n            `;\n            break;\n          case 'v8': // Minimal light\n            headerHtml = `\n              <div class=\"team-header\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${evtName}</div>\n              </div>\n            `;\n            break;\n          case 'v9': // Bold blue gradient header\n            headerHtml = `\n              <div class=\"team-header\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${evtName}</div>\n              </div>\n            `;\n            break;\n          case 'v10': // Score focus with logo\n            headerHtml = `\n              <div class=\"team-header\">\n                ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${evtName}</div>\n              </div>\n            `;\n            break;\n          case 'v11': // Blue accent header\n            headerHtml = `\n              <div class=\"team-header\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${evtName}</div>\n              </div>\n            `;\n            break;\n          case 'v12': // Gradient rows with large logo\n            headerHtml = `\n              <div class=\"team-header\">\n                ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n                <div class=\"header-text\">\n                  <div class=\"team-name\">${teamName}</div>\n                  <div class=\"event-name\">${evtName}</div>\n                </div>\n              </div>\n            `;\n            break;\n          case 'v13': // Split header with logo area and total\n            headerHtml = `\n              <div class=\"team-header\">\n                <div class=\"header-logo-area\">\n                  ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n                </div>\n                <div class=\"header-info\">\n                  <div class=\"team-name\">${teamName}</div>\n                  <div class=\"event-name\">${evtName}</div>\n                  <div class=\"header-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n                </div>\n              </div>\n            `;\n            break;\n          case 'v14': // Bottom total - compact header\n            headerHtml = `\n              <div class=\"team-header\">\n                ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${evtName}</div>\n              </div>\n            `;\n            break;\n          case 'v15': // Numbered badges\n            headerHtml = `\n              <div class=\"team-header\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${evtName}</div>\n              </div>\n            `;\n            break;\n          case 'v16': // Purple theme\n            headerHtml = `\n              <div class=\"team-header\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${evtName}</div>\n              </div>\n            `;\n            break;\n          case 'v17': // Inline scores\n            headerHtml = `\n              <div class=\"team-header\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${evtName}</div>\n              </div>\n            `;\n            break;\n          case 'v18': // Team color header\n            const colors = getTeamColors(teamName);\n            headerHtml = `\n              <div class=\"team-header\" style=\"--team-color: ${colors.primary};\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${evtName}</div>\n              </div>\n            `;\n            break;\n          case 'v19': // Compact dense with total in header\n            headerHtml = `\n              <div class=\"team-header\">\n                <div class=\"team-info\">\n                  ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n                  <div class=\"team-name\">${teamName}</div>\n                </div>\n                <div class=\"event-name\">${evtName}</div>\n                <div class=\"header-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n              </div>\n            `;\n            break;\n          case 'v20': // Combined best: V12 header style + ranking/score on right + V14 footer\n            // Calculate rank based on totalScore (team total, higher is better)\n            const v20Rank = data\n              .map((t, idx) => ({ idx, score: t.totalScore || 0 }))\n              .sort((a, b) => b.score - a.score)\n              .findIndex(t => t.idx === teamIndex) + 1;\n            const v20RankClass = v20Rank <= 3 ? ` rank-${v20Rank}` : '';\n            headerHtml = `\n              <div class=\"team-header\">\n                ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n                <div class=\"header-left\">\n                  <div class=\"team-name\">${teamName}</div>\n                  <div class=\"event-name\">${evtName}</div>\n                </div>\n                <div class=\"header-right\">\n                  <div class=\"rank-badge${v20RankClass}\">${v20Rank}</div>\n                  <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n                </div>\n              </div>\n            `;\n            break;\n          default:\n            headerHtml = `\n              <div class=\"team-header\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${evtName}</div>\n              </div>\n            `;\n        }\n\n        // Different footer structures\n        let footerHtml = '';\n        switch(layoutVersion) {\n          case 'v5': // Compact green total\n            footerHtml = `\n              <div class=\"team-total\">\n                <div class=\"total-label\">Total</div>\n                <div class=\"total-value\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n              </div>\n            `;\n            break;\n          case 'v10': // Centered footer\n            footerHtml = `\n              <div class=\"team-footer\">\n                <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n                <div class=\"footer-label\">Event Total</div>\n              </div>\n            `;\n            break;\n          case 'v13': // No footer (total in header)\n            footerHtml = '';\n            break;\n          case 'v14': // Large centered total\n            footerHtml = `\n              <div class=\"team-footer\">\n                <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n                <div class=\"footer-label\">Event Total</div>\n              </div>\n            `;\n            break;\n          case 'v19': // No footer (total in header)\n            footerHtml = '';\n            break;\n          case 'v20': // Large centered total (V14 style)\n            footerHtml = `\n              <div class=\"team-footer\">\n                <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n                <div class=\"footer-label\">Event Total</div>\n              </div>\n            `;\n            break;\n          default:\n            footerHtml = `\n              <div class=\"team-footer\">\n                <div class=\"footer-label\">Event Total</div>\n                <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n              </div>\n            `;\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            ${headerHtml}\n            <div class=\"athlete-list\">${athletesHtml}</div>\n            ${footerHtml}\n          </div>\n        `;\n      });\n\n      const cssClass = `event-summary-${layoutVersion}`;\n      contentEl.innerHTML = `<div class=\"${cssClass} teams-${numTeams}\">${columnsHtml}</div>`;\n    }\n\n    // Render functions for V5-V19 (rotation view)\n    function renderMultiTeamSummaryV5(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v5', false);\n    }\n    function renderMultiTeamSummaryV6(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v6', false);\n    }\n    function renderMultiTeamSummaryV7(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v7', false);\n    }\n    function renderMultiTeamSummaryV8(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v8', false);\n    }\n    function renderMultiTeamSummaryV9(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v9', false);\n    }\n    function renderMultiTeamSummaryV10(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v10', false);\n    }\n    function renderMultiTeamSummaryV11(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v11', false);\n    }\n    function renderMultiTeamSummaryV12(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v12', false);\n    }\n    function renderMultiTeamSummaryV13(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v13', false);\n    }\n    function renderMultiTeamSummaryV14(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v14', false);\n    }\n    function renderMultiTeamSummaryV15(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v15', false);\n    }\n    function renderMultiTeamSummaryV16(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v16', false);\n    }\n    function renderMultiTeamSummaryV17(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v17', false);\n    }\n    function renderMultiTeamSummaryV18(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v18', false);\n    }\n    function renderMultiTeamSummaryV19(contentEl, rotationData, rotation, numTeams) {\n      renderGenericLayout(contentEl, rotationData, numTeams, 'v19', false);\n    }\n    function renderMultiTeamSummaryV20(contentEl, rotationData, rotation, numTeams, apparatusRankings = {}) {\n      // V20: V20 header (logo + team + event left, rank + total right) with V3 body/footer\n      // Now includes start values and meet-wide apparatus rankings for top 3 athletes\n      const maxAthletes = Math.min(\n        Math.max(...rotationData.map(t => t.gymnasts.length)),\n        10\n      );\n\n      // Calculate ranks based on totalScore\n      const rankedTeams = rotationData\n        .map((t, idx) => ({ idx, score: t.totalScore || 0 }))\n        .sort((a, b) => b.score - a.score);\n\n      // Helper to check if athlete is in top 3 for their apparatus across entire meet\n      function getAthleteApparatusRank(eventName, gymnastId, score) {\n        const rankings = apparatusRankings[eventName] || [];\n        // Find by gymnast_id first, then by score as fallback\n        const found = rankings.find(r => r.gymnastId === gymnastId || r.score === score);\n        return found ? found.rank : null;\n      }\n\n      let columnsHtml = '';\n\n      rotationData.forEach((teamData, teamIndex) => {\n        const { team, eventName, eventDisplayName, gymnasts, eventScore, totalScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n\n        // Get rank for this team\n        const rank = rankedTeams.findIndex(t => t.idx === teamIndex) + 1;\n        const rankClass = rank <= 3 ? ` rank-${rank}` : '';\n\n        // Build athlete rows with start values and meet rankings\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n\n            // Get start value (difficulty score)\n            const startValue = g.scores && g.scores.length > 0\n              ? parseFloat(g.scores[0].start) || 0\n              : 0;\n\n            // Check if this athlete is in top 3 for this apparatus across entire meet\n            const athleteRank = score > 0 ? getAthleteApparatusRank(eventName, g.gymnast_id, score) : null;\n            const athleteRankHtml = athleteRank && athleteRank <= 3\n              ? `<div class=\"athlete-rank rank-${athleteRank}\">${athleteRank}</div>`\n              : '';\n\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                ${athleteRankHtml}\n                <div class=\"athlete-sv\">${startValue > 0 ? startValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-left\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${eventDisplayName}</div>\n              </div>\n              <div class=\"header-right\">\n                <div class=\"rank-badge${rankClass}\">${rank}</div>\n                <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = `<div class=\"event-summary-v20 teams-${numTeams}\">${columnsHtml}</div>`;\n    }\n\n    function renderMultiTeamSummaryV21(contentEl, rotationData, rotation, numTeams, apparatusRankings = {}) {\n      // V21: Extra Large - Same as V20 but uses v21 CSS class for larger fonts\n      const maxAthletes = Math.min(\n        Math.max(...rotationData.map(t => t.gymnasts.length)),\n        10\n      );\n\n      // Calculate ranks based on totalScore\n      const rankedTeams = rotationData\n        .map((t, idx) => ({ idx, score: t.totalScore || 0 }))\n        .sort((a, b) => b.score - a.score);\n\n      // Helper to check if athlete is in top 3 for their apparatus across entire meet\n      function getAthleteApparatusRank(eventName, gymnastId, score) {\n        const rankings = apparatusRankings[eventName] || [];\n        const found = rankings.find(r => r.gymnastId === gymnastId || r.score === score);\n        return found ? found.rank : null;\n      }\n\n      let columnsHtml = '';\n\n      rotationData.forEach((teamData, teamIndex) => {\n        const { team, eventName, eventDisplayName, gymnasts, eventScore, totalScore } = teamData;\n        const logoUrl = getTeamLogoUrl(team.name, team.logo);\n        const teamName = team.name || team.tricode;\n\n        // Get rank for this team\n        const rank = rankedTeams.findIndex(t => t.idx === teamIndex) + 1;\n        const rankClass = rank <= 3 ? ` rank-${rank}` : '';\n\n        // Build athlete rows with start values and meet rankings\n        let athletesHtml = '';\n        for (let i = 0; i < maxAthletes; i++) {\n          const g = gymnasts[i];\n          if (g) {\n            const score = parseFloat(g.final_score) || 0;\n            const name = `${g.first_name?.charAt(0) || ''}. ${g.last_name || ''}`;\n\n            // Get start value (difficulty score)\n            const startValue = g.scores && g.scores.length > 0\n              ? parseFloat(g.scores[0].start) || 0\n              : 0;\n\n            // Check if this athlete is in top 3 for this apparatus across entire meet\n            const athleteRank = score > 0 ? getAthleteApparatusRank(eventName, g.gymnast_id, score) : null;\n            const athleteRankHtml = athleteRank && athleteRank <= 3\n              ? `<div class=\"athlete-rank rank-${athleteRank}\">${athleteRank}</div>`\n              : '';\n\n            athletesHtml += `\n              <div class=\"athlete-row\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">${name}</div>\n                ${athleteRankHtml}\n                <div class=\"athlete-sv\">${startValue > 0 ? startValue.toFixed(2) : ''}</div>\n                <div class=\"athlete-score\">${score > 0 ? score.toFixed(3) : '—'}</div>\n              </div>\n            `;\n          } else {\n            athletesHtml += `\n              <div class=\"athlete-row empty\">\n                <div class=\"athlete-order\">${i + 1}</div>\n                <div class=\"athlete-name\">—</div>\n                <div class=\"athlete-sv\"></div>\n                <div class=\"athlete-score\"></div>\n              </div>\n            `;\n          }\n        }\n\n        columnsHtml += `\n          <div class=\"team-column\">\n            <div class=\"team-header\">\n              ${logoUrl ? `<img class=\"team-logo\" src=\"${logoUrl}\" alt=\"\">` : ''}\n              <div class=\"header-left\">\n                <div class=\"team-name\">${teamName}</div>\n                <div class=\"event-name\">${eventDisplayName}</div>\n              </div>\n              <div class=\"header-right\">\n                <div class=\"rank-badge${rankClass}\">${rank}</div>\n                <div class=\"header-total\">${totalScore > 0 ? totalScore.toFixed(3) : '—'}</div>\n              </div>\n            </div>\n            <div class=\"athlete-list\">\n              ${athletesHtml}\n            </div>\n            <div class=\"team-footer\">\n              <div class=\"footer-label\">Event Total</div>\n              <div class=\"footer-total\">${eventScore > 0 ? eventScore.toFixed(3) : '—'}</div>\n            </div>\n          </div>\n        `;\n      });\n\n      contentEl.innerHTML = 