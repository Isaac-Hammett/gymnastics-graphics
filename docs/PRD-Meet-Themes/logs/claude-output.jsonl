{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0139FAxmdFVm74P8XnXz5qwt","type":"tool_result","content":"     1→/**\n     2→ * URL Builder for Virtius Graphics Engine\n     3→ * Generates properly formatted URLs for all graphics overlays\n     4→ *\n     5→ * Production: https://commentarygraphic.com\n     6→ * Local: Uses window.location.origin\n     7→ */\n     8→\n     9→import { getGraphicById, isTransparentGraphic as registryIsTransparent } from './graphicsRegistry';\n    10→\n    11→/**\n    12→ * Get the base URL for graphics\n    13→ * Uses current origin for local development, can be overridden for production\n    14→ */\n    15→export function getBaseURL() {\n    16→  // In production this could be: 'https://virtiusgraphicsenginev001.netlify.app'\n    17→  // For local dev, use the current origin\n    18→  return typeof window !== 'undefined' ? window.location.origin : '';\n    19→}\n    20→\n    21→/**\n    22→ * Graphics path mapping\n    23→ * Maps internal graphic IDs to their HTML file paths\n    24→ */\n    25→const GRAPHIC_PATHS = {\n    26→  // PRE-MEET\n    27→  'logos': 'logos.html',\n    28→  'event-bar': 'event-bar.html',\n    29→  'warm-up': 'warm-up.html',\n    30→  'hosts': 'hosts.html',\n    31→  'team-stats': 'team-stats.html',\n    32→  'coaches': 'coaches.html',\n    33→\n    34→  // EVENT FRAMES\n    35→  'event-frame': 'event-frame.html',\n    36→\n    37→  // STREAM\n    38→  'stream': 'stream.html',\n    39→};\n    40→\n    41→/**\n    42→ * Event titles mapping for event frames\n    43→ */\n    44→const EVENT_TITLES = {\n    45→  floor: 'FLOOR EXERCISE',\n    46→  pommel: 'POMMEL HORSE',\n    47→  rings: 'STILL RINGS',\n    48→  vault: 'VAULT',\n    49→  pbars: 'PARALLEL BARS',\n    50→  hbar: 'HORIZONTAL BAR',\n    51→  ubars: 'UNEVEN BARS',\n    52→  beam: 'BALANCE BEAM',\n    53→  allaround: 'ALL AROUND',\n    54→  final: 'FINAL SCORES',\n    55→  order: 'COMPETITION ORDER',\n    56→  lineups: 'NEXT EVENT LINEUPS',\n    57→  summary: 'EVENT SUMMARY',\n    58→};\n    59→\n    60→/**\n    61→ * Encode a URL parameter value safely\n    62→ * @param {string} value - Value to encode\n    63→ * @returns {string} Encoded value\n    64→ */\n    65→function encode(value) {\n    66→  return encodeURIComponent(value || '');\n    67→}\n    68→\n    69→/**\n    70→ * Build URL for Team Logos graphic\n    71→ * @param {Object} options\n    72→ * @param {Object} options.teams - Team data keyed by team number (team1Name, team1Logo, etc.)\n    73→ * @param {number} options.teamCount - Number of teams to include\n    74→ * @param {string} [options.baseUrl] - Override base URL\n    75→ * @returns {string} Complete URL\n    76→ */\n    77→export function buildLogosURL({ teams, teamCount, baseUrl }) {\n    78→  const base = baseUrl || getBaseURL();\n    79→  const params = new URLSearchParams();\n    80→\n    81→  for (let i = 1; i <= teamCount; i++) {\n    82→    const logo = teams[`team${i}Logo`];\n    83→    if (logo) {\n    84→      params.set(`team${i}Logo`, logo);\n    85→    }\n    86→  }\n    87→\n    88→  return `${base}/overlays/logos.html?${params.toString()}`;\n    89→}\n    90→\n    91→/**\n    92→ * Build URL for Event Bar graphic\n    93→ * @param {Object} options\n    94→ * @param {string} options.team1Logo - Team 1 logo URL\n    95→ * @param {string} options.venue - Venue name\n    96→ * @param {string} options.eventName - Event/meet name\n    97→ * @param {string} options.location - Location\n    98→ * @param {string} [options.baseUrl] - Override base URL\n    99→ * @returns {string} Complete URL\n   100→ */\n   101→export function buildEventBarURL({ team1Logo, venue, eventName, location, baseUrl }) {\n   102→  const base = baseUrl || getBaseURL();\n   103→  const params = new URLSearchParams();\n   104→\n   105→  if (team1Logo) params.set('team1Logo', team1Logo);\n   106→  if (venue) params.set('venue', venue);\n   107→  if (eventName) params.set('eventName', eventName);\n   108→  if (location) params.set('location', location);\n   109→\n   110→  return `${base}/overlays/event-bar.html?${params.toString()}`;\n   111→}\n   112→\n   113→/**\n   114→ * Build URL for Hosts graphic\n   115→ * @param {Object} options\n   116→ * @param {string} options.hosts - Hosts (newline or pipe separated)\n   117→ * @param {string} [options.baseUrl] - Override base URL\n   118→ * @returns {string} Complete URL\n   119→ */\n   120→export function buildHostsURL({ hosts, baseUrl }) {\n   121→  const base = baseUrl || getBaseURL();\n   122→  // Convert newlines to pipes for URL\n   123→  const hostsFormatted = hosts?.split('\\n').join('|') || '';\n   124→  return `${base}/overlays/hosts.html?hosts=${encode(hostsFormatted)}`;\n   125→}\n   126→\n   127→/**\n   128→ * Build URL for Team Stats graphic\n   129→ * @param {Object} options\n   130→ * @param {string} options.teamName - Team name\n   131→ * @param {string} options.logo - Team logo URL\n   132→ * @param {string} options.ave - Average score\n   133→ * @param {string} options.high - High score\n   134→ * @param {string} [options.baseUrl] - Override base URL\n   135→ * @returns {string} Complete URL\n   136→ */\n   137→export function buildTeamStatsURL({ teamName, logo, ave, high, baseUrl }) {\n   138→  const base = baseUrl || getBaseURL();\n   139→  const params = new URLSearchParams();\n   140→\n   141→  if (teamName) params.set('teamName', teamName);\n   142→  if (logo) params.set('logo', logo);\n   143→  if (ave) params.set('ave', ave);\n   144→  if (high) params.set('high', high);\n   145→\n   146→  return `${base}/overlays/team-stats.html?${params.toString()}`;\n   147→}\n   148→\n   149→/**\n   150→ * Build URL for Coaches graphic\n   151→ * @param {Object} options\n   152→ * @param {string} options.logo - Team logo URL\n   153→ * @param {string} options.coaches - Coaches (newline or pipe separated)\n   154→ * @param {string} [options.baseUrl] - Override base URL\n   155→ * @returns {string} Complete URL\n   156→ */\n   157→export function buildCoachesURL({ logo, coaches, baseUrl }) {\n   158→  const base = baseUrl || getBaseURL();\n   159→  // Convert newlines to pipes for URL\n   160→  const coachesFormatted = coaches?.split('\\n').join('|') || '';\n   161→  const params = new URLSearchParams();\n   162→\n   163→  if (logo) params.set('logo', logo);\n   164→  if (coachesFormatted) params.set('coaches', coachesFormatted);\n   165→\n   166→  return `${base}/overlays/coaches.html?${params.toString()}`;\n   167→}\n   168→\n   169→/**\n   170→ * Build URL for Team Roster graphic\n   171→ * @param {Object} options\n   172→ * @param {string} options.compId - Competition ID\n   173→ * @param {number} options.teamSlot - Team slot number (1-6)\n   174→ * @param {string} options.teamName - Team name (for preview)\n   175→ * @param {string} options.logo - Team logo URL (for preview)\n   176→ * @param {string} [options.baseUrl] - Override base URL\n   177→ * @returns {string} Complete URL\n   178→ */\n   179→export function buildTeamRosterURL({ compId, teamSlot, teamName, logo, baseUrl }) {\n   180→  const base = baseUrl || getBaseURL();\n   181→  const params = new URLSearchParams();\n   182→\n   183→  if (compId) params.set('compId', compId);\n   184→  if (teamSlot) params.set('teamSlot', teamSlot);\n   185→  if (teamName) params.set('teamName', teamName);\n   186→  if (logo) params.set('logo', logo);\n   187→\n   188→  return `${base}/overlays/team-roster.html?${params.toString()}`;\n   189→}\n   190→\n   191→/**\n   192→ * Build URL for Event Frame graphic\n   193→ * @param {Object} options\n   194→ * @param {string} options.eventId - Event ID (floor, vault, etc.)\n   195→ * @param {string} options.logo - Team logo URL\n   196→ * @param {string} [options.baseUrl] - Override base URL\n   197→ * @returns {string} Complete URL\n   198→ */\n   199→export function buildEventFrameURL({ eventId, logo, baseUrl }) {\n   200→  const base = baseUrl || getBaseURL();\n   201→  const title = EVENT_TITLES[eventId] || eventId?.toUpperCase() || '';\n   202→  const params = new URLSearchParams();\n   203→\n   204→  if (title) params.set('title', title);\n   205→  if (logo) params.set('logo', logo);\n   206→\n   207→  return `${base}/overlays/event-frame.html?${params.toString()}`;\n   208→}\n   209→\n   210→/**\n   211→ * Build URL for Stream graphic (Starting/Thanks)\n   212→ * @param {Object} options\n   213→ * @param {string} options.type - 'starting' or 'thanks'\n   214→ * @param {string} options.logo - Team logo URL\n   215→ * @param {string} options.eventName - Event/meet name\n   216→ * @param {string} options.meetDate - Date of the meet\n   217→ * @param {string} [options.baseUrl] - Override base URL\n   218→ * @returns {string} Complete URL\n   219→ */\n   220→export function buildStreamURL({ type, logo, eventName, meetDate, baseUrl }) {\n   221→  const base = baseUrl || getBaseURL();\n   222→  const title = type === 'starting' ? 'STREAM STARTING SOON' : 'THANKS FOR WATCHING';\n   223→  const params = new URLSearchParams();\n   224→\n   225→  params.set('title', title);\n   226→  if (logo) params.set('logo', logo);\n   227→  if (eventName) params.set('eventName', eventName);\n   228→  if (meetDate) params.set('meetDate', meetDate);\n   229→\n   230→  return `${base}/overlays/stream.html?${params.toString()}`;\n   231→}\n   232→\n   233→/**\n   234→ * Build URL for Sponsors Thanks graphic (full-screen grid)\n   235→ * @param {Object} options\n   236→ * @param {string} options.logo - Team logo URL\n   237→ * @param {string} options.sponsorsJson - JSON array of sponsors [{name, url}, ...]\n   238→ * @param {string} [options.baseUrl] - Override base URL\n   239→ * @returns {string} Complete URL\n   240→ */\n   241→export function buildSponsorsThanksURL({ logo, sponsorsJson, baseUrl }) {\n   242→  const base = baseUrl || getBaseURL();\n   243→  const params = new URLSearchParams();\n   244→\n   245→  if (logo) params.set('logo', logo);\n   246→  if (sponsorsJson) params.set('sponsors', sponsorsJson);\n   247→\n   248→  return `${base}/overlays/sponsors-thanks.html?${params.toString()}`;\n   249→}\n   250→\n   251→/**\n   252→ * Build URL for Sponsors Cycle graphic (full-screen cycling)\n   253→ * @param {Object} options\n   254→ * @param {string} options.logo - Team logo URL\n   255→ * @param {string} options.sponsorsJson - JSON array of sponsors [{name, url}, ...]\n   256→ * @param {string} [options.baseUrl] - Override base URL\n   257→ * @returns {string} Complete URL\n   258→ */\n   259→export function buildSponsorsCycleURL({ logo, sponsorsJson, baseUrl }) {\n   260→  const base = baseUrl || getBaseURL();\n   261→  const params = new URLSearchParams();\n   262→\n   263→  if (logo) params.set('logo', logo);\n   264→  if (sponsorsJson) params.set('sponsors', sponsorsJson);\n   265→\n   266→  return `${base}/overlays/sponsors-cycle.html?${params.toString()}`;\n   267→}\n   268→\n   269→/**\n   270→ * Build URL for Sponsors Bug graphic (corner bug overlay)\n   271→ * @param {Object} options\n   272→ * @param {string} options.sponsorsJson - JSON array of sponsors [{name, url}, ...]\n   273→ * @param {string} [options.baseUrl] - Override base URL\n   274→ * @returns {string} Complete URL\n   275→ */\n   276→export function buildSponsorsBugURL({ sponsorsJson, baseUrl }) {\n   277→  const base = baseUrl || getBaseURL();\n   278→  const params = new URLSearchParams();\n   279→\n   280→  if (sponsorsJson) params.set('sponsors', sponsorsJson);\n   281→\n   282→  return `${base}/overlays/sponsors-bug.html?${params.toString()}`;\n   283→}\n   284→\n   285→/**\n   286→ * Build URL for Frame Overlay graphics\n   287→ * @param {Object} options\n   288→ * @param {string} options.frameType - Frame type (quad, tri-center, tri-wide, team-header, single)\n   289→ * @param {Object} options.teams - Team data keyed by team number\n   290→ * @param {number} options.teamCount - Number of teams\n   291→ * @param {string} [options.baseUrl] - Override base URL\n   292→ * @returns {string} Complete URL\n   293→ */\n   294→export function buildFrameOverlayURL({ frameType, teams, teamCount, baseUrl }) {\n   295→  const base = baseUrl || getBaseURL();\n   296→  const params = new URLSearchParams();\n   297→\n   298→  // Add team logos for frame overlays\n   299→  for (let i = 1; i <= teamCount; i++) {\n   300→    const logo = teams[`team${i}Logo`];\n   301→    if (logo) {\n   302→      params.set(`team${i}Logo`, logo);\n   303→    }\n   304→  }\n   305→\n   306→  return `${base}/overlays/frame-${frameType}.html?${params.toString()}`;\n   307→}\n   308→\n   309→/**\n   310→ * Build URL for Leaderboard graphic\n   311→ * @param {Object} options\n   312→ * @param {string} options.event - Event ID (floor, vault, etc. or 'all-around')\n   313→ * @param {string} options.virtiusSessionId - Virtius session ID for live data\n   314→ * @param {string} options.gender - Gender ('mens' or 'womens') for column visibility\n   315→ * @param {Object} options.teams - Team data keyed by team number\n   316→ * @param {number} options.teamCount - Number of teams\n   317→ * @param {string} [options.baseUrl] - Override base URL\n   318→ * @returns {string} Complete URL\n   319→ */\n   320→export function buildLeaderboardURL({ event, virtiusSessionId, gender, teams, teamCount, compId, baseUrl }) {\n   321→  const base = baseUrl || getBaseURL();\n   322→  const params = new URLSearchParams();\n   323→\n   324→  // Competition ID is required for leaderboards (needs live Virtius data)\n   325→  if (compId) params.set('comp', compId);\n   326→  // Use leaderboardEvent to match output.html renderer expectation\n   327→  if (event) params.set('leaderboardEvent', event);\n   328→  if (virtiusSessionId) params.set('virtiusSessionId', virtiusSessionId);\n   329→  if (gender) params.set('leaderboardGender', gender);\n   330→\n   331→  // Add team data for display\n   332→  for (let i = 1; i <= teamCount; i++) {\n   333→    const name = teams[`team${i}Name`];\n   334→    const logo = teams[`team${i}Logo`];\n   335→    if (name) params.set(`team${i}Name`, name);\n   336→    if (logo) params.set(`team${i}Logo`, logo);\n   337→  }\n   338→\n   339→  return `${base}/output.html?graphic=virtius-leaderboard&${params.toString()}`;\n   340→}\n   341→\n   342→/**\n   343→ * Build URL for Event Summary graphic\n   344→ * @param {Object} options\n   345→ * @param {string} options.mode - 'rotation' or 'apparatus'\n   346→ * @param {number} [options.rotation] - Rotation number (1-6) if mode is 'rotation'\n   347→ * @param {string} [options.apparatus] - Apparatus ID (fx, ph, etc.) if mode is 'apparatus'\n   348→ * @param {string} options.virtiusSessionId - Virtius session ID for live data\n   349→ * @param {string} options.compType - Competition type for format determination\n   350→ * @param {string} options.gender - Gender ('mens' or 'womens')\n   351→ * @param {Object} options.teams - Team data keyed by team number\n   352→ * @param {number} options.teamCount - Number of teams\n   353→ * @param {string} [options.theme] - Summary theme ID\n   354→ * @param {string} [options.baseUrl] - Override base URL\n   355→ * @returns {string} Complete URL\n   356→ */\n   357→export function buildEventSummaryURL({ mode, rotation, apparatus, virtiusSessionId, compType, gender, teams, teamCount, theme, compId, baseUrl }) {\n   358→  const base = baseUrl || getBaseURL();\n   359→  const params = new URLSearchParams();\n   360→\n   361→  // Competition ID is required for event summary (needs live Virtius data)\n   362→  if (compId) params.set('comp', compId);\n   363→  params.set('graphic', 'event-summary');\n   364→\n   365→  // Use virtiusSessionId to match output.html renderer expectation\n   366→  if (virtiusSessionId) params.set('virtiusSessionId', virtiusSessionId);\n   367→  if (theme) params.set('summaryTheme', theme);\n   368→  if (gender) params.set('summaryGender', gender);\n   369→\n   370→  // Determine format based on competition type\n   371→  const isDual = compType?.includes('dual');\n   372→\n   373→  if (mode === 'rotation') {\n   374→    params.set('summaryMode', 'rotation');\n   375→    params.set('summaryRotation', rotation);\n   376→    params.set('summaryFormat', isDual ? 'alternating' : 'rotation');\n   377→  } else if (mode === 'apparatus') {\n   378→    params.set('summaryMode', 'apparatus');\n   379→    params.set('summaryApparatus', apparatus);\n   380→    params.set('summaryFormat', 'head-to-head');\n   381→  }\n   382→\n   383→  params.set('summaryNumTeams', teamCount);\n   384→\n   385→  // Add team data\n   386→  for (let i = 1; i <= teamCount; i++) {\n   387→    const name = teams[`team${i}Name`];\n   388→    const logo = teams[`team${i}Logo`];\n   389→    if (name) params.set(`team${i}Name`, name);\n   390→    if (logo) params.set(`team${i}Logo`, logo);\n   391→  }\n   392→\n   393→  return `${base}/output.html?${params.toString()}`;\n   394→}\n   395→\n   396→/**\n   397→ * Generate URL for any graphic based on ID\n   398→ * @param {string} graphicId - Graphic identifier\n   399→ * @param {Object} formData - Form data with team info, event details, etc.\n   400→ * @param {number} teamCount - Number of teams in competition\n   401→ * @param {string} [baseUrl] - Override base URL\n   402→ * @param {Object} [options] - Additional options (compType, virtiusSessionId, etc.)\n   403→ * @returns {string} Complete URL or empty string if unknown graphic\n   404→ */\n   405→export function generateGraphicURL(graphicId, formData, teamCount, baseUrl, options = {}) {\n   406→  const base = baseUrl || getBaseURL();\n   407→  const { compType, virtiusSessionId, compId, summaryTheme, sponsors } = options;\n   408→\n   409→  // Helper to get team logo with placeholder fallback\n   410→  const getTeamLogo = (teamNum) => {\n   411→    const colors = ['00274C/FFCB05', 'BB0000/FFFFFF', '003087/FFFFFF', '228B22/FFFFFF', '800080/FFFFFF', 'FF8C00/FFFFFF'];\n   412→    return formData[`team${teamNum}Logo`] || `https://via.placeholder.com/200/${colors[(teamNum - 1) % colors.length]}?text=T${teamNum}`;\n   413→  };\n   414→\n   415→  // Helper to get all team data\n   416→  const getTeamsData = () => {\n   417→    const teams = { ...formData };\n   418→    for (let i = 1; i <= teamCount; i++) {\n   419→      if (!teams[`team${i}Logo`]) {\n   420→        teams[`team${i}Logo`] = getTeamLogo(i);\n   421→      }\n   422→    }\n   423→    return teams;\n   424→  };\n   425→\n   426→  // Handle dynamic team stats/coaches graphics\n   427→  const teamStatsMatch = graphicId.match(/^team(\\d+)-stats$/);\n   428→  if (teamStatsMatch) {\n   429→    const num = parseInt(teamStatsMatch[1]);\n   430→    return buildTeamStatsURL({\n   431→      teamName: formData[`team${num}Name`],\n   432→      logo: getTeamLogo(num),\n   433→      ave: formData[`team${num}Ave`],\n   434→      high: formData[`team${num}High`],\n   435→      baseUrl: base,\n   436→    });\n   437→  }\n   438→\n   439→  const teamCoachesMatch = graphicId.match(/^team(\\d+)-coaches$/);\n   440→  if (teamCoachesMatch) {\n   441→    const num = parseInt(teamCoachesMatch[1]);\n   442→    return buildCoachesURL({\n   443→      logo: getTeamLogo(num),\n   444→      coaches: formData[`team${num}Coaches`],\n   445→      baseUrl: base,\n   446→    });\n   447→  }\n   448→\n   449→  const teamRosterMatch = graphicId.match(/^team(\\d+)-roster$/);\n   450→  if (teamRosterMatch) {\n   451→    const num = parseInt(teamRosterMatch[1]);\n   452→    return buildTeamRosterURL({\n   453→      compId,\n   454→      teamSlot: num,\n   455→      teamName: formData[`team${num}Name`],\n   456→      logo: getTeamLogo(num),\n   457→      baseUrl: base,\n   458→    });\n   459→  }\n   460→\n   461→  // Handle frame overlay graphics\n   462→  const frameMatch = graphicId.match(/^frame-(quad|tri-center|tri-wide|team-header|single|dual)$/);\n   463→  if (frameMatch) {\n   464→    return buildFrameOverlayURL({\n   465→      frameType: frameMatch[1],\n   466→      teams: getTeamsData(),\n   467→      teamCount,\n   468→      baseUrl: base,\n   469→    });\n   470→  }\n   471→\n   472→  // Handle leaderboard graphics\n   473→  const leaderboardMatch = graphicId.match(/^leaderboard-(.+)$/);\n   474→  if (leaderboardMatch) {\n   475→    // eventCode is already the short code (fx, ph, sr, vt, pb, hb, ub, bb, aa)\n   476→    const eventCode = leaderboardMatch[1];\n   477→    const gender = compType?.startsWith('mens') ? 'mens' : 'womens';\n   478→    return buildLeaderboardURL({\n   479→      event: eventCode, // Pass short code directly - renderer expects fx, ph, etc.\n   480→      virtiusSessionId,\n   481→      gender,\n   482→      teams: getTeamsData(),\n   483→      teamCount,\n   484→      compId,\n   485→      baseUrl: base,\n   486→    });\n   487→  }\n   488→\n   489→  // Handle event summary graphics\n   490→  const summaryRotationMatch = graphicId.match(/^summary-r(\\d+)$/);\n   491→  if (summaryRotationMatch) {\n   492→    const rotation = parseInt(summaryRotationMatch[1]);\n   493→    const gender = compType?.startsWith('mens') ? 'mens' : 'womens';\n   494→    return buildEventSummaryURL({\n   495→      mode: 'rotation',\n   496→      rotation,\n   497→      virtiusSessionId,\n   498→      compType,\n   499→      gender,\n   500→      teams: getTeamsData(),\n   501→      teamCount,\n   502→      theme: summaryTheme,\n   503→      compId,\n   504→      baseUrl: base,\n   505→    });\n   506→  }\n   507→\n   508→  const summaryApparatusMatch = graphicId.match(/^summary-(fx|ph|sr|vt|pb|hb|ub|bb)$/);\n   509→  if (summaryApparatusMatch) {\n   510→    const apparatus = summaryApparatusMatch[1];\n   511→    const gender = compType?.startsWith('mens') ? 'mens' : 'womens';\n   512→    return buildEventSummaryURL({\n   513→      mode: 'apparatus',\n   514→      apparatus,\n   515→      virtiusSessionId,\n   516→      compType,\n   517→      gender,\n   518→      teams: getTeamsData(),\n   519→      teamCount,\n   520→      theme: summaryTheme,\n   521→      compId,\n   522→      baseUrl: base,\n   523→    });\n   524→  }\n   525→\n   526→  // Handle standard graphics\n   527→  switch (graphicId) {\n   528→    case 'logos':\n   529→      return buildLogosURL({\n   530→        teams: {\n   531→          ...formData,\n   532→          // Ensure all team logos have values (with fallbacks)\n   533→          ...Object.fromEntries(\n   534→            Array.from({ length: teamCount }, (_, i) => [\n   535→              `team${i + 1}Logo`,\n   536→              getTeamLogo(i + 1)\n   537→            ])\n   538→          ),\n   539→        },\n   540→        teamCount,\n   541→        baseUrl: base,\n   542→      });\n   543→\n   544→    case 'event-bar':\n   545→      return buildEventBarURL({\n   546→        team1Logo: getTeamLogo(1),\n   547→        venue: formData.venue,\n   548→        eventName: formData.eventName,\n   549→        location: formData.location,\n   550→        baseUrl: base,\n   551→      });\n   552→\n   553→    case 'warm-up':\n   554→      // Warm-up graphic uses event-bar.html with warm-up title\n   555→      const warmUpParams = new URLSearchParams();\n   556→      warmUpParams.set('title', 'WARM UP');\n   557→      warmUpParams.set('team1Logo', getTeamLogo(1));\n   558→      if (formData.venue) warmUpParams.set('venue', formData.venue);\n   559→      return `${base}/overlays/warm-up.html?${warmUpParams.toString()}`;\n   560→\n   561→    case 'replay':\n   562→      // Replay graphic - simple instant replay indicator\n   563→      const replayParams = new URLSearchParams();\n   564→      replayParams.set('team1Logo', getTeamLogo(1));\n   565→      return `${base}/overlays/replay.html?${replayParams.toString()}`;\n   566→\n   567→    case 'hosts':\n   568→      return buildHostsURL({\n   569→        hosts: formData.hosts,\n   570→        baseUrl: base,\n   571→      });\n   572→\n   573→    case 'floor':\n   574→    case 'pommel':\n   575→    case 'rings':\n   576→    case 'vault':\n   577→    case 'pbars':\n   578→    case 'hbar':\n   579→    case 'ubars':\n   580→    case 'beam':\n   581→    case 'allaround':\n   582→    case 'final':\n   583→    case 'order':\n   584→    case 'lineups':\n   585→    case 'summary':\n   586→      return buildEventFrameURL({\n   587→        eventId: graphicId,\n   588→        logo: getTeamLogo(1),\n   589→        baseUrl: base,\n   590→      });\n   591→\n   592→    case 'starting':\n   593→      return buildStreamURL({\n   594→        type: 'starting',\n   595→        logo: getTeamLogo(1),\n   596→        eventName: formData.eventName,\n   597→        meetDate: formData.meetDate,\n   598→        baseUrl: base,\n   599→      });\n   600→\n   601→    case 'thanks':\n   602→      return buildStreamURL({\n   603→        type: 'thanks',\n   604→        logo: getTeamLogo(1),\n   605→        eventName: formData.eventName,\n   606→        meetDate: formData.meetDate,\n   607→        baseUrl: base,\n   608→      });\n   609→\n   610→    case 'sponsors-thanks':\n   611→      return buildSponsorsThanksURL({\n   612→        logo: getTeamLogo(1),\n   613→        sponsorsJson: sponsors || '[]',\n   614→        baseUrl: base,\n   615→      });\n   616→\n   617→    case 'sponsors-cycle':\n   618→      return buildSponsorsCycleURL({\n   619→        logo: getTeamLogo(1),\n   620→        sponsorsJson: sponsors || '[]',\n   621→        baseUrl: base,\n   622→      });\n   623→\n   624→    case 'sponsors-bug':\n   625→      return buildSponsorsBugURL({\n   626→        sponsorsJson: sponsors || '[]',\n   627→        baseUrl: base,\n   628→      });\n   629→\n   630→    case 'rotation-slate':\n   631→      // Rotation Slate - full screen with team logo, meet name, rotation number\n   632→      const rotationSlateParams = new URLSearchParams();\n   633→      rotationSlateParams.set('logo', getTeamLogo(1));\n   634→      rotationSlateParams.set('meetName', formData.eventName || 'GYMNASTICS');\n   635→      rotationSlateParams.set('rotation', options.rotation || '1');\n   636→      return `${base}/overlays/rotation-slate.html?${rotationSlateParams.toString()}`;\n   637→\n   638→    default:\n   639→      return '';\n   640→  }\n   641→}\n   642→\n   643→/**\n   644→ * Copy text to clipboard with fallback\n   645→ * @param {string} text - Text to copy\n   646→ * @returns {Promise<boolean>} Success status\n   647→ */\n   648→export async function copyToClipboard(text) {\n   649→  // Try modern clipboard API first\n   650→  if (navigator.clipboard && window.isSecureContext) {\n   651→    try {\n   652→      await navigator.clipboard.writeText(text);\n   653→      return true;\n   654→    } catch (err) {\n   655→      console.warn('Clipboard API failed, trying fallback:', err);\n   656→    }\n   657→  }\n   658→\n   659→  // Fallback for older browsers or non-secure contexts\n   660→  try {\n   661→    const textArea = document.createElement('textarea');\n   662→    textArea.value = text;\n   663→    textArea.style.cssText = 'position:fixed;left:-9999px;top:-9999px;';\n   664→    document.body.appendChild(textArea);\n   665→    textArea.focus();\n   666→    textArea.select();\n   667→    const success = document.execCommand('copy');\n   668→    document.body.removeChild(textArea);\n   669→    return success;\n   670→  } catch (err) {\n   671→    console.error('Fallback copy failed:', err);\n   672→    return false;\n   673→  }\n   674→}\n   675→\n   676→/**\n   677→ * Get the file path for a graphic\n   678→ * @param {string} graphicId - Graphic identifier\n   679→ * @returns {string} HTML file path\n   680→ */\n   681→export function getGraphicPath(graphicId) {\n   682→  // Check registry first\n   683→  const graphic = getGraphicById(graphicId);\n   684→  if (graphic?.file) {\n   685→    return graphic.file;\n   686→  }\n   687→  // Fallback to old mapping\n   688→  return GRAPHIC_PATHS[graphicId] || `${graphicId}.html`;\n   689→}\n   690→\n   691→/**\n   692→ * Build URL from registry schema (for simple overlay graphics)\n   693→ * This function uses the registry schema to build URLs for graphics that follow\n   694→ * the standard pattern: overlays/{file}?{params}\n   695→ *\n   696→ * Complex graphics (leaderboards, event-summary, etc.) still use their dedicated\n   697→ * builder functions as they have special logic.\n   698→ *\n   699→ * @param {string} graphicId - Graphic ID\n   700→ * @param {Object} formData - Form data with values\n   701→ * @param {number} teamCount - Number of teams\n   702→ * @param {Object} [options] - Additional options\n   703→ * @returns {string|null} URL or null if graphic not found or not supported\n   704→ */\n   705→export function buildGraphicUrlFromRegistry(graphicId, formData, teamCount, options = {}) {\n   706→  const graphic = getGraphicById(graphicId);\n   707→  if (!graphic) return null;\n   708→\n   709→  const base = options.baseUrl || getBaseURL();\n   710→\n   711→  // Only handle simple overlay graphics for now\n   712→  // Complex graphics (leaderboards, event-summary) use dedicated builders\n   713→  if (graphic.renderer !== 'overlay') return null;\n   714→\n   715→  const params = new URLSearchParams();\n   716→\n   717→  // Build params from schema\n   718→  if (graphic.params) {\n   719→    for (const [paramKey, paramSchema] of Object.entries(graphic.params)) {\n   720→      let value = null;\n   721→\n   722→      if (paramSchema.source === 'competition') {\n   723→        // Auto-fill from formData based on param name\n   724→        // Handle team-specific params like team1Logo\n   725→        if (paramKey in formData) {\n   726→          value = formData[paramKey];\n   727→        }\n   728→      } else if (paramSchema.default !== undefined) {\n   729→        // Use default value\n   730→        value = paramSchema.default;\n   731→      }\n   732→\n   733→      if (value !== null && value !== undefined && value !== '') {\n   734→        params.set(paramKey, value);\n   735→      }\n   736→    }\n   737→  }\n   738→\n   739→  const queryString = params.toString();\n   740→  const path = graphic.file.endsWith('.html')\n   741→    ? `overlays/${graphic.file}`\n   742→    : `overlays/${graphic.file}.html`;\n   743→\n   744→  return queryString ? `${base}/${path}?${queryString}` : `${base}/${path}`;\n   745→}\n   746→\n   747→/**\n   748→ * Check if a graphic is transparent based on registry\n   749→ * Re-exports the registry function for backwards compatibility\n   750→ */\n   751→export { registryIsTransparent as isTransparentGraphicFromRegistry };\n   752→\n   753→export default {\n   754→  getBaseURL,\n   755→  buildLogosURL,\n   756→  buildEventBarURL,\n   757→  buildHostsURL,\n   758→  buildTeamStatsURL,\n   759→  buildCoachesURL,\n   760→  buildTeamRosterURL,\n   761→  buildEventFrameURL,\n   762→  buildStreamURL,\n   763→  buildSponsorsThanksURL,\n   764→  buildSponsorsCycleURL,\n   765→  buildSponsorsBugURL,\n   766→  buildFrameOverlayURL,\n   767→  buildLeaderboardURL,\n   768→  buildEventSummaryURL,\n   769→  generateGraphicURL,\n   770→  buildGraphicUrlFromRegistry,\n   771→  copyToClipboard,\n   772→  getGraphicPath,\n   773→};\n   774→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d2520b6e-bc3d-4535-a209-ce6e3323e1d1","uuid":"c1960418-fc00-4a15-9199-ee7673fa30e7","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/lib/urlBuilder.js","content":"/**\n * URL Builder for Virtius Graphics Engine\n * Generates properly formatted URLs for all graphics overlays\n *\n * Production: https://commentarygraphic.com\n * Local: Uses window.location.origin\n */\n\nimport { getGraphicById, isTransparentGraphic as registryIsTransparent } from './graphicsRegistry';\n\n/**\n * Get the base URL for graphics\n * Uses current origin for local development, can be overridden for production\n */\nexport function getBaseURL() {\n  // In production this could be: 'https://virtiusgraphicsenginev001.netlify.app'\n  // For local dev, use the current origin\n  return typeof window !== 'undefined' ? window.location.origin : '';\n}\n\n/**\n * Graphics path mapping\n * Maps internal graphic IDs to their HTML file paths\n */\nconst GRAPHIC_PATHS = {\n  // PRE-MEET\n  'logos': 'logos.html',\n  'event-bar': 'event-bar.html',\n  'warm-up': 'warm-up.html',\n  'hosts': 'hosts.html',\n  'team-stats': 'team-stats.html',\n  'coaches': 'coaches.html',\n\n  // EVENT FRAMES\n  'event-frame': 'event-frame.html',\n\n  // STREAM\n  'stream': 'stream.html',\n};\n\n/**\n * Event titles mapping for event frames\n */\nconst EVENT_TITLES = {\n  floor: 'FLOOR EXERCISE',\n  pommel: 'POMMEL HORSE',\n  rings: 'STILL RINGS',\n  vault: 'VAULT',\n  pbars: 'PARALLEL BARS',\n  hbar: 'HORIZONTAL BAR',\n  ubars: 'UNEVEN BARS',\n  beam: 'BALANCE BEAM',\n  allaround: 'ALL AROUND',\n  final: 'FINAL SCORES',\n  order: 'COMPETITION ORDER',\n  lineups: 'NEXT EVENT LINEUPS',\n  summary: 'EVENT SUMMARY',\n};\n\n/**\n * Encode a URL parameter value safely\n * @param {string} value - Value to encode\n * @returns {string} Encoded value\n */\nfunction encode(value) {\n  return encodeURIComponent(value || '');\n}\n\n/**\n * Build URL for Team Logos graphic\n * @param {Object} options\n * @param {Object} options.teams - Team data keyed by team number (team1Name, team1Logo, etc.)\n * @param {number} options.teamCount - Number of teams to include\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildLogosURL({ teams, teamCount, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  for (let i = 1; i <= teamCount; i++) {\n    const logo = teams[`team${i}Logo`];\n    if (logo) {\n      params.set(`team${i}Logo`, logo);\n    }\n  }\n\n  return `${base}/overlays/logos.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Event Bar graphic\n * @param {Object} options\n * @param {string} options.team1Logo - Team 1 logo URL\n * @param {string} options.venue - Venue name\n * @param {string} options.eventName - Event/meet name\n * @param {string} options.location - Location\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildEventBarURL({ team1Logo, venue, eventName, location, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  if (team1Logo) params.set('team1Logo', team1Logo);\n  if (venue) params.set('venue', venue);\n  if (eventName) params.set('eventName', eventName);\n  if (location) params.set('location', location);\n\n  return `${base}/overlays/event-bar.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Hosts graphic\n * @param {Object} options\n * @param {string} options.hosts - Hosts (newline or pipe separated)\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildHostsURL({ hosts, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  // Convert newlines to pipes for URL\n  const hostsFormatted = hosts?.split('\\n').join('|') || '';\n  return `${base}/overlays/hosts.html?hosts=${encode(hostsFormatted)}`;\n}\n\n/**\n * Build URL for Team Stats graphic\n * @param {Object} options\n * @param {string} options.teamName - Team name\n * @param {string} options.logo - Team logo URL\n * @param {string} options.ave - Average score\n * @param {string} options.high - High score\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildTeamStatsURL({ teamName, logo, ave, high, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  if (teamName) params.set('teamName', teamName);\n  if (logo) params.set('logo', logo);\n  if (ave) params.set('ave', ave);\n  if (high) params.set('high', high);\n\n  return `${base}/overlays/team-stats.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Coaches graphic\n * @param {Object} options\n * @param {string} options.logo - Team logo URL\n * @param {string} options.coaches - Coaches (newline or pipe separated)\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildCoachesURL({ logo, coaches, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  // Convert newlines to pipes for URL\n  const coachesFormatted = coaches?.split('\\n').join('|') || '';\n  const params = new URLSearchParams();\n\n  if (logo) params.set('logo', logo);\n  if (coachesFormatted) params.set('coaches', coachesFormatted);\n\n  return `${base}/overlays/coaches.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Team Roster graphic\n * @param {Object} options\n * @param {string} options.compId - Competition ID\n * @param {number} options.teamSlot - Team slot number (1-6)\n * @param {string} options.teamName - Team name (for preview)\n * @param {string} options.logo - Team logo URL (for preview)\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildTeamRosterURL({ compId, teamSlot, teamName, logo, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  if (compId) params.set('compId', compId);\n  if (teamSlot) params.set('teamSlot', teamSlot);\n  if (teamName) params.set('teamName', teamName);\n  if (logo) params.set('logo', logo);\n\n  return `${base}/overlays/team-roster.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Event Frame graphic\n * @param {Object} options\n * @param {string} options.eventId - Event ID (floor, vault, etc.)\n * @param {string} options.logo - Team logo URL\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildEventFrameURL({ eventId, logo, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const title = EVENT_TITLES[eventId] || eventId?.toUpperCase() || '';\n  const params = new URLSearchParams();\n\n  if (title) params.set('title', title);\n  if (logo) params.set('logo', logo);\n\n  return `${base}/overlays/event-frame.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Stream graphic (Starting/Thanks)\n * @param {Object} options\n * @param {string} options.type - 'starting' or 'thanks'\n * @param {string} options.logo - Team logo URL\n * @param {string} options.eventName - Event/meet name\n * @param {string} options.meetDate - Date of the meet\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildStreamURL({ type, logo, eventName, meetDate, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const title = type === 'starting' ? 'STREAM STARTING SOON' : 'THANKS FOR WATCHING';\n  const params = new URLSearchParams();\n\n  params.set('title', title);\n  if (logo) params.set('logo', logo);\n  if (eventName) params.set('eventName', eventName);\n  if (meetDate) params.set('meetDate', meetDate);\n\n  return `${base}/overlays/stream.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Sponsors Thanks graphic (full-screen grid)\n * @param {Object} options\n * @param {string} options.logo - Team logo URL\n * @param {string} options.sponsorsJson - JSON array of sponsors [{name, url}, ...]\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildSponsorsThanksURL({ logo, sponsorsJson, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  if (logo) params.set('logo', logo);\n  if (sponsorsJson) params.set('sponsors', sponsorsJson);\n\n  return `${base}/overlays/sponsors-thanks.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Sponsors Cycle graphic (full-screen cycling)\n * @param {Object} options\n * @param {string} options.logo - Team logo URL\n * @param {string} options.sponsorsJson - JSON array of sponsors [{name, url}, ...]\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildSponsorsCycleURL({ logo, sponsorsJson, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  if (logo) params.set('logo', logo);\n  if (sponsorsJson) params.set('sponsors', sponsorsJson);\n\n  return `${base}/overlays/sponsors-cycle.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Sponsors Bug graphic (corner bug overlay)\n * @param {Object} options\n * @param {string} options.sponsorsJson - JSON array of sponsors [{name, url}, ...]\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildSponsorsBugURL({ sponsorsJson, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  if (sponsorsJson) params.set('sponsors', sponsorsJson);\n\n  return `${base}/overlays/sponsors-bug.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Frame Overlay graphics\n * @param {Object} options\n * @param {string} options.frameType - Frame type (quad, tri-center, tri-wide, team-header, single)\n * @param {Object} options.teams - Team data keyed by team number\n * @param {number} options.teamCount - Number of teams\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildFrameOverlayURL({ frameType, teams, teamCount, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  // Add team logos for frame overlays\n  for (let i = 1; i <= teamCount; i++) {\n    const logo = teams[`team${i}Logo`];\n    if (logo) {\n      params.set(`team${i}Logo`, logo);\n    }\n  }\n\n  return `${base}/overlays/frame-${frameType}.html?${params.toString()}`;\n}\n\n/**\n * Build URL for Leaderboard graphic\n * @param {Object} options\n * @param {string} options.event - Event ID (floor, vault, etc. or 'all-around')\n * @param {string} options.virtiusSessionId - Virtius session ID for live data\n * @param {string} options.gender - Gender ('mens' or 'womens') for column visibility\n * @param {Object} options.teams - Team data keyed by team number\n * @param {number} options.teamCount - Number of teams\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildLeaderboardURL({ event, virtiusSessionId, gender, teams, teamCount, compId, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  // Competition ID is required for leaderboards (needs live Virtius data)\n  if (compId) params.set('comp', compId);\n  // Use leaderboardEvent to match output.html renderer expectation\n  if (event) params.set('leaderboardEvent', event);\n  if (virtiusSessionId) params.set('virtiusSessionId', virtiusSessionId);\n  if (gender) params.set('leaderboardGender', gender);\n\n  // Add team data for display\n  for (let i = 1; i <= teamCount; i++) {\n    const name = teams[`team${i}Name`];\n    const logo = teams[`team${i}Logo`];\n    if (name) params.set(`team${i}Name`, name);\n    if (logo) params.set(`team${i}Logo`, logo);\n  }\n\n  return `${base}/output.html?graphic=virtius-leaderboard&${params.toString()}`;\n}\n\n/**\n * Build URL for Event Summary graphic\n * @param {Object} options\n * @param {string} options.mode - 'rotation' or 'apparatus'\n * @param {number} [options.rotation] - Rotation number (1-6) if mode is 'rotation'\n * @param {string} [options.apparatus] - Apparatus ID (fx, ph, etc.) if mode is 'apparatus'\n * @param {string} options.virtiusSessionId - Virtius session ID for live data\n * @param {string} options.compType - Competition type for format determination\n * @param {string} options.gender - Gender ('mens' or 'womens')\n * @param {Object} options.teams - Team data keyed by team number\n * @param {number} options.teamCount - Number of teams\n * @param {string} [options.theme] - Summary theme ID\n * @param {string} [options.baseUrl] - Override base URL\n * @returns {string} Complete URL\n */\nexport function buildEventSummaryURL({ mode, rotation, apparatus, virtiusSessionId, compType, gender, teams, teamCount, theme, compId, baseUrl }) {\n  const base = baseUrl || getBaseURL();\n  const params = new URLSearchParams();\n\n  // Competition ID is required for event summary (needs live Virtius data)\n  if (compId) params.set('comp', compId);\n  params.set('graphic', 'event-summary');\n\n  // Use virtiusSessionId to match output.html renderer expectation\n  if (virtiusSessionId) params.set('virtiusSessionId', virtiusSessionId);\n  if (theme) params.set('summaryTheme', theme);\n  if (gender) params.set('summaryGender', gender);\n\n  // Determine format based on competition type\n  const isDual = compType?.includes('dual');\n\n  if (mode === 'rotation') {\n    params.set('summaryMode', 'rotation');\n    params.set('summaryRotation', rotation);\n    params.set('summaryFormat', isDual ? 'alternating' : 'rotation');\n  } else if (mode === 'apparatus') {\n    params.set('summaryMode', 'apparatus');\n    params.set('summaryApparatus', apparatus);\n    params.set('summaryFormat', 'head-to-head');\n  }\n\n  params.set('summaryNumTeams', teamCount);\n\n  // Add team data\n  for (let i = 1; i <= teamCount; i++) {\n    const name = teams[`team${i}Name`];\n    const logo = teams[`team${i}Logo`];\n    if (name) params.set(`team${i}Name`, name);\n    if (logo) params.set(`team${i}Logo`, logo);\n  }\n\n  return `${base}/output.html?${params.toString()}`;\n}\n\n/**\n * Generate URL for any graphic based on ID\n * @param {string} graphicId - Graphic identifier\n * @param {Object} formData - Form data with team info, event details, etc.\n * @param {number} teamCount - Number of teams in competition\n * @param {string} [baseUrl] - Override base URL\n * @param {Object} [options] - Additional options (compType, virtiusSessionId, etc.)\n * @returns {string} Complete URL or empty string if unknown graphic\n */\nexport function generateGraphicURL(graphicId, formData, teamCount, baseUrl, options = {}) {\n  const base = baseUrl || getBaseURL();\n  const { compType, virtiusSessionId, compId, summaryTheme, sponsors } = options;\n\n  // Helper to get team logo with placeholder fallback\n  const getTeamLogo = (teamNum) => {\n    const colors = ['00274C/FFCB05', 'BB0000/FFFFFF', '003087/FFFFFF', '228B22/FFFFFF', '800080/FFFFFF', 'FF8C00/FFFFFF'];\n    return formData[`team${teamNum}Logo`] || `https://via.placeholder.com/200/${colors[(teamNum - 1) % colors.length]}?text=T${teamNum}`;\n  };\n\n  // Helper to get all team data\n  const getTeamsData = () => {\n    const teams = { ...formData };\n    for (let i = 1; i <= teamCount; i++) {\n      if (!teams[`team${i}Logo`]) {\n        teams[`team${i}Logo`] = getTeamLogo(i);\n      }\n    }\n    return teams;\n  };\n\n  // Handle dynamic team stats/coaches graphics\n  const teamStatsMatch = graphicId.match(/^team(\\d+)-stats$/);\n  if (teamStatsMatch) {\n    const num = parseInt(teamStatsMatch[1]);\n    return buildTeamStatsURL({\n      teamName: formData[`team${num}Name`],\n      logo: getTeamLogo(num),\n      ave: formData[`team${num}Ave`],\n      high: formData[`team${num}High`],\n      baseUrl: base,\n    });\n  }\n\n  const teamCoachesMatch = graphicId.match(/^team(\\d+)-coaches$/);\n  if (teamCoachesMatch) {\n    const num = parseInt(teamCoachesMatch[1]);\n    return buildCoachesURL({\n      logo: getTeamLogo(num),\n      coaches: formData[`team${num}Coaches`],\n      baseUrl: base,\n    });\n  }\n\n  const teamRosterMatch = graphicId.match(/^team(\\d+)-roster$/);\n  if (teamRosterMatch) {\n    const num = parseInt(teamRosterMatch[1]);\n    return buildTeamRosterURL({\n      compId,\n      teamSlot: num,\n      teamName: formData[`team${num}Name`],\n      logo: getTeamLogo(num),\n      baseUrl: base,\n    });\n  }\n\n  // Handle frame overlay graphics\n  const frameMatch = graphicId.match(/^frame-(quad|tri-center|tri-wide|team-header|single|dual)$/);\n  if (frameMatch) {\n    return buildFrameOverlayURL({\n      frameType: frameMatch[1],\n      teams: getTeamsData(),\n      teamCount,\n      baseUrl: base,\n    });\n  }\n\n  // Handle leaderboard graphics\n  const leaderboardMatch = graphicId.match(/^leaderboard-(.+)$/);\n  if (leaderboardMatch) {\n    // eventCode is already the short code (fx, ph, sr, vt, pb, hb, ub, bb, aa)\n    const eventCode = leaderboardMatch[1];\n    const gender = compType?.startsWith('mens') ? 'mens' : 'womens';\n    return buildLeaderboardURL({\n      event: eventCode, // Pass short code directly - renderer expects fx, ph, etc.\n      virtiusSessionId,\n      gender,\n      teams: getTeamsData(),\n      teamCount,\n      compId,\n      baseUrl: base,\n    });\n  }\n\n  // Handle event summary graphics\n  const summaryRotationMatch = graphicId.match(/^summary-r(\\d+)$/);\n  if (summaryRotationMatch) {\n    const rotation = parseInt(summaryRotationMatch[1]);\n    const gender = compType?.startsWith('mens') ? 'mens' : 'womens';\n    return buildEventSummaryURL({\n      mode: 'rotation',\n      rotation,\n      virtiusSessionId,\n      compType,\n      gender,\n      teams: getTeamsData(),\n      teamCount,\n      theme: summaryTheme,\n      compId,\n      baseUrl: base,\n    });\n  }\n\n  const summaryApparatusMatch = graphicId.match(/^summary-(fx|ph|sr|vt|pb|hb|ub|bb)$/);\n  if (summaryApparatusMatch) {\n    const apparatus = summaryApparatusMatch[1];\n    const gender = compType?.startsWith('mens') ? 'mens' : 'womens';\n    return buildEventSummaryURL({\n      mode: 'apparatus',\n      apparatus,\n      virtiusSessionId,\n      compType,\n      gender,\n      teams: getTeamsData(),\n      teamCount,\n      theme: summaryTheme,\n      compId,\n      baseUrl: base,\n    });\n  }\n\n  // Handle standard graphics\n  switch (graphicId) {\n    case 'logos':\n      return buildLogosURL({\n        teams: {\n          ...formData,\n          // Ensure all team logos have values (with fallbacks)\n          ...Object.fromEntries(\n            Array.from({ length: teamCount }, (_, i) => [\n              `team${i + 1}Logo`,\n              getTeamLogo(i + 1)\n            ])\n          ),\n        },\n        teamCount,\n        baseUrl: base,\n      });\n\n    case 'event-bar':\n      return buildEventBarURL({\n        team1Logo: getTeamLogo(1),\n        venue: formData.venue,\n        eventName: formData.eventName,\n        location: formData.location,\n        baseUrl: base,\n      });\n\n    case 'warm-up':\n      // Warm-up graphic uses event-bar.html with warm-up title\n      const warmUpParams = new URLSearchParams();\n      warmUpParams.set('title', 'WARM UP');\n      warmUpParams.set('team1Logo', getTeamLogo(1));\n      if (formData.venue) warmUpParams.set('venue', formData.venue);\n      return `${base}/overlays/warm-up.html?${warmUpParams.toString()}`;\n\n    case 'replay':\n      // Replay graphic - simple instant replay indicator\n      const replayParams = new URLSearchParams();\n      replayParams.set('team1Logo', getTeamLogo(1));\n      return `${base}/overlays/replay.html?${replayParams.toString()}`;\n\n    case 'hosts':\n      return buildHostsURL({\n        hosts: formData.hosts,\n        baseUrl: base,\n      });\n\n    case 'floor':\n    case 'pommel':\n    case 'rings':\n    case 'vault':\n    case 'pbars':\n    case 'hbar':\n    case 'ubars':\n    case 'beam':\n    case 'allaround':\n    case 'final':\n    case 'order':\n    case 'lineups':\n    case 'summary':\n      return buildEventFrameURL({\n        eventId: graphicId,\n        logo: getTeamLogo(1),\n        baseUrl: base,\n      });\n\n    case 'starting':\n      return buildStreamURL({\n        type: 'starting',\n        logo: getTeamLogo(1),\n        eventName: formData.eventName,\n        meetDate: formData.meetDate,\n        baseUrl: base,\n      });\n\n    case 'thanks':\n      return buildStreamURL({\n        type: 'thanks',\n        logo: getTeamLogo(1),\n        eventName: formData.eventName,\n        meetDate: formData.meetDate,\n        baseUrl: base,\n      });\n\n    case 'sponsors-thanks':\n      return buildSponsorsThanksURL({\n        logo: getTeamLogo(1),\n        sponsorsJson: sponsors || '[]',\n        baseUrl: base,\n      });\n\n    case 'sponsors-cycle':\n      return buildSponsorsCycleURL({\n        logo: getTeamLogo(1),\n        sponsorsJson: sponsors || '[]',\n        baseUrl: base,\n      });\n\n    case 'sponsors-bug':\n      return buildSponsorsBugURL({\n        sponsorsJson: sponsors || '[]',\n        baseUrl: base,\n      });\n\n    case 'rotation-slate':\n      // Rotation Slate - full screen with team logo, meet name, rotation number\n      const rotationSlateParams = new URLSearchParams();\n      rotationSlateParams.set('logo', getTeamLogo(1));\n      rotationSlateParams.set('meetName', formData.eventName || 'GYMNASTICS');\n      rotationSlateParams.set('rotation', options.rotation || '1');\n      return `${base}/overlays/rotation-slate.html?${rotationSlateParams.toString()}`;\n\n    default:\n      return '';\n  }\n}\n\n/**\n * Copy text to clipboard with fallback\n * @param {string} text - Text to copy\n * @returns {Promise<boolean>} Success status\n */\nexport async function copyToClipboard(text) {\n  // Try modern clipboard API first\n  if (navigator.clipboard && window.isSecureContext) {\n    try {\n      await navigator.clipboard.writeText(text);\n      return true;\n    } catch (err) {\n      console.warn('Clipboard API failed, trying fallback:', err);\n    }\n  }\n\n  // Fallback for older browsers or non-secure contexts\n  try {\n    const textArea = document.createElement('textarea');\n    textArea.value = text;\n    textArea.style.cssText = 'position:fixed;left:-9999px;top:-9999px;';\n    document.body.appendChild(textArea);\n    textArea.focus();\n    textArea.select();\n    const success = document.execCommand('copy');\n    document.body.removeChild(textArea);\n    return success;\n  } catch (err) {\n    console.error('Fallback copy failed:', err);\n    return false;\n  }\n}\n\n/**\n * Get the file path for a graphic\n * @param {string} graphicId - Graphic identifier\n * @returns {string} HTML file path\n */\nexport function getGraphicPath(graphicId) {\n  // Check registry first\n  const graphic = getGraphicById(graphicId);\n  if (graphic?.file) {\n    return graphic.file;\n  }\n  // Fallback to old mapping\n  return GRAPHIC_PATHS[graphicId] || `${graphicId}.html`;\n}\n\n/**\n * Build URL from registry schema (for simple overlay graphics)\n * This function uses the registry schema to build URLs for graphics that follow\n * the standard pattern: overlays/{file}?{params}\n *\n * Complex graphics (leaderboards, event-summary, etc.) still use their dedicated\n * builder functions as they have special logic.\n *\n * @param {string} graphicId - Graphic ID\n * @param {Object} formData - Form data with values\n * @param {number} teamCount - Number of teams\n * @param {Object} [options] - Additional options\n * @returns {string|null} URL or null if graphic not found or not supported\n */\nexport function buildGraphicUrlFromRegistry(graphicId, formData, teamCount, options = {}) {\n  const graphic = getGraphicById(graphicId);\n  if (!graphic) return null;\n\n  const base = options.baseUrl || getBaseURL();\n\n  // Only handle simple overlay graphics for now\n  // Complex graphics (leaderboards, event-summary) use dedicated builders\n  if (graphic.renderer !== 'overlay') return null;\n\n  const params = new URLSearchParams();\n\n  // Build params from schema\n  if (graphic.params) {\n    for (const [paramKey, paramSchema] of Object.entries(graphic.params)) {\n      let value = null;\n\n      if (paramSchema.source === 'competition') {\n        // Auto-fill from formData based on param name\n        // Handle team-specific params like team1Logo\n        if (paramKey in formData) {\n          value = formData[paramKey];\n        }\n      } else if (paramSchema.default !== undefined) {\n        // Use default value\n        value = paramSchema.default;\n      }\n\n      if (value !== null && value !== undefined && value !== '') {\n        params.set(paramKey, value);\n      }\n    }\n  }\n\n  const queryString = params.toString();\n  const path = graphic.file.endsWith('.html')\n    ? `overlays/${graphic.file}`\n    : `overlays/${graphic.file}.html`;\n\n  return queryString ? `${base}/${path}?${queryString}` : `${base}/${path}`;\n}\n\n/**\n * Check if a graphic is transparent based on registry\n * Re-exports the registry function for backwards compatibility\n */\nexport { registryIsTransparent as isTransparentGraphicFromRegistry };\n\nexport default {\n  getBaseURL,\n  buildLogosURL,\n  buildEventBarURL,\n  buildHostsURL,\n  buildTeamStatsURL,\n  buildCoachesURL,\n  buildTeamRosterURL,\n  buildEventFrameURL,\n  buildStreamURL,\n  buildSponsorsThanksURL,\n  buildSponsorsCycleURL,\n  buildSponsorsBugURL,\n  buildFrameOverlayURL,\n  buildLeaderboardURL,\n  buildEventSummaryURL,\n  generateGraphicURL,\n  buildGraphicUrlFromRegistry,\n  copyToClipboard,\n  getGraphicPath,\n};\n","numLines":774,"startLine":1,"totalLines":774}}}
