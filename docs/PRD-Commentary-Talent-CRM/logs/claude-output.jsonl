length === 0 ? (\n              <div className=\"bg-green-900/20 border-2 border-green-800/50 rounded-xl p-5\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-10 h-10 bg-green-900/50 rounded-full flex items-center justify-center\">\n                    <span className=\"text-xl text-green-400\">✓</span>\n                  </div>\n                  <div>\n                    <h3 className=\"text-lg font-bold text-white\">All Caught Up</h3>\n                    <p className=\"text-sm text-green-300/70\">\n                      No pre-production alerts at this time.\n                    </p>\n                  </div>\n                </div>\n              </div>\n            ) : (\n              <div className=\"space-y-3\">\n                <h2 className=\"text-sm font-semibold text-zinc-400 uppercase tracking-wide mb-2\">\n                  Pre-Production Alerts ({alerts.length})\n                </h2>\n                {alerts.map((alert) => (\n                  <AlertCard key={alert.id} alert={alert} navigate={navigate} />\n                ))}\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* Local Development Option */}\n        <div className=\"bg-gradient-to-r from-zinc-900 to-zinc-800 border-2 border-zinc-700 rounded-xl p-5 mb-8\">\n          <div className=\"flex items-center justify-between flex-wrap gap-4\">\n            <div>\n              <div className=\"flex items-center gap-2 mb-1\">\n                <span className=\"text-lg\">$</span>\n                <h3 className=\"text-lg font-bold text-white\">Local Development</h3>\n              </div>\n              <p className=\"text-sm text-zinc-400\">\n                Connect to local server at localhost:3003\n              </p>\n            </div>\n            <div className=\"flex gap-2\">\n              <Link\n                to=\"/local/producer\"\n                className=\"px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-500 transition-colors\"\n              >\n                Producer\n              </Link>\n              <Link\n                to=\"/local/talent\"\n                className=\"px-4 py-2 bg-zinc-700 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-600 transition-colors\"\n              >\n                Talent\n              </Link>\n              <Link\n                to=\"/local/camera-setup\"\n                className=\"px-4 py-2 bg-zinc-700 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-600 transition-colors\"\n              >\n                Cameras\n              </Link>\n            </div>\n          </div>\n        </div>"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":289,"cache_read_input_tokens":76362,"cache_creation":{"ephemeral_5m_input_tokens":289,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"93fbf748-dbe6-4fbe-9f9d-e937e5652744","uuid":"272957d0-b180-46bb-a612-a6c53ee5f114"}
