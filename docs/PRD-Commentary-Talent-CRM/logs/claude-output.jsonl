{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XhiU6S6GEZCrnDNwbXQQYN","type":"tool_result","content":"     1→import { useState } from 'react';\n     2→import { Link, useNavigate } from 'react-router-dom';\n     3→import { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\n     4→import {\n     5→  PlusIcon,\n     6→  MagnifyingGlassIcon,\n     7→  PhoneIcon,\n     8→  EnvelopeIcon,\n     9→  UserGroupIcon,\n    10→  SparklesIcon,\n    11→  XMarkIcon,\n    12→} from '@heroicons/react/24/solid';\n    13→\n    14→const STATUS_OPTIONS = [\n    15→  { value: '', label: 'All Statuses' },\n    16→  { value: 'ready', label: 'Ready' },\n    17→  { value: 'has-contact', label: 'Has Contact' },\n    18→  { value: 'did-2025', label: 'Did 2025' },\n    19→  { value: 'need-info', label: 'Need Info' },\n    20→];\n    21→\n    22→const WAG_MAG_OPTIONS = [\n    23→  { value: '', label: 'All' },\n    24→  { value: 'WAG', label: 'WAG' },\n    25→  { value: 'MAG', label: 'MAG' },\n    26→  { value: 'Both', label: 'Both' },\n    27→];\n    28→\n    29→const ROLE_OPTIONS = [\n    30→  { value: '', label: 'All Roles' },\n    31→  { value: 'Play by Play / Lead', label: 'Play by Play' },\n    32→  { value: 'Color / Analyst', label: 'Color / Analyst' },\n    33→  { value: 'Does not matter', label: 'Flexible' },\n    34→];\n    35→\n    36→/**\n    37→ * TalentPage - Global talent roster management page.\n    38→ * URL: /talent\n    39→ */\n    40→export default function TalentPage() {\n    41→  const { talentList, loading, error, createTalent } = useTalentRoster();\n    42→  const navigate = useNavigate();\n    43→\n    44→  const [search, setSearch] = useState('');\n    45→  const [statusFilter, setStatusFilter] = useState('');\n    46→  const [wagMagFilter, setWagMagFilter] = useState('');\n    47→  const [roleFilter, setRoleFilter] = useState('');\n    48→  const [showAddModal, setShowAddModal] = useState(false);\n    49→  const [saving, setSaving] = useState(false);\n    50→\n    51→  const [newTalent, setNewTalent] = useState({\n    52→    name: '',\n    53→    phone: '',\n    54→    email: '',\n    55→    wagMag: 'Both',\n    56→    commentaryRole: 'Does not matter',\n    57→    canProduce: false,\n    58→    affiliation: '',\n    59→    conference: '',\n    60→    status: 'has-contact',\n    61→    notes: '',\n    62→    otherInterests: [],\n    63→  });\n    64→\n    65→  const filtered = talentList.filter((t) => {\n    66→    if (search) {\n    67→      const q = search.toLowerCase();\n    68→      if (\n    69→        !t.name?.toLowerCase().includes(q) &&\n    70→        !t.affiliation?.toLowerCase().includes(q) &&\n    71→        !t.conference?.toLowerCase().includes(q) &&\n    72→        !t.notes?.toLowerCase().includes(q)\n    73→      ) return false;\n    74→    }\n    75→    if (statusFilter && t.status !== statusFilter) return false;\n    76→    if (wagMagFilter && t.wagMag !== wagMagFilter) return false;\n    77→    if (roleFilter && t.commentaryRole !== roleFilter) return false;\n    78→    return true;\n    79→  });\n    80→\n    81→  const counts = {\n    82→    ready: talentList.filter(t => t.status === 'ready').length,\n    83→    hasContact: talentList.filter(t => t.status === 'has-contact').length,\n    84→    didPrior: talentList.filter(t => t.status?.startsWith('did-')).length,\n    85→    needInfo: talentList.filter(t => t.status === 'need-info').length,\n    86→  };\n    87→\n    88→  async function handleCreate(e) {\n    89→    e.preventDefault();\n    90→    if (!newTalent.name.trim()) return;\n    91→    setSaving(true);\n    92→    try {\n    93→      const id = await createTalent(newTalent);\n    94→      setShowAddModal(false);\n    95→      setNewTalent({\n    96→        name: '', phone: '', email: '', wagMag: 'Both',\n    97→        commentaryRole: 'Does not matter', canProduce: false,\n    98→        affiliation: '', conference: '', status: 'has-contact', notes: '', otherInterests: [],\n    99→      });\n   100→      navigate(`/talent/${id}`);\n   101→    } finally {\n   102→      setSaving(false);\n   103→    }\n   104→  }\n   105→\n   106→  return (\n   107→    <div className=\"min-h-screen bg-gray-900 text-white\">\n   108→      {/* Header */}\n   109→      <div className=\"bg-gray-800 border-b border-gray-700 px-6 py-4\">\n   110→        <div className=\"max-w-7xl mx-auto flex items-center justify-between\">\n   111→          <div className=\"flex items-center gap-4\">\n   112→            <Link to=\"/\" className=\"text-gray-400 hover:text-white text-sm transition-colors\">\n   113→              ← Home\n   114→            </Link>\n   115→            <div>\n   116→              <h1 className=\"text-xl font-bold text-white flex items-center gap-2\">\n   117→                <UserGroupIcon className=\"w-6 h-6 text-blue-400\" />\n   118→                Talent Roster\n   119→              </h1>\n   120→              <p className=\"text-gray-400 text-sm\">{talentList.length} total contacts</p>\n   121→            </div>\n   122→          </div>\n   123→          <div className=\"flex items-center gap-3\">\n   124→            <Link\n   125→              to=\"/talent/discover\"\n   126→              className=\"flex items-center gap-2 px-3 py-2 bg-purple-700 hover:bg-purple-600 rounded-lg text-sm font-medium transition-colors\"\n   127→            >\n   128→              <SparklesIcon className=\"w-4 h-4\" />\n   129→              Discover Talent\n   130→            </Link>\n   131→            <button\n   132→              onClick={() => setShowAddModal(true)}\n   133→              className=\"flex items-center gap-2 px-3 py-2 bg-blue-600 hover:bg-blue-500 rounded-lg text-sm font-medium transition-colors\"\n   134→            >\n   135→              <PlusIcon className=\"w-4 h-4\" />\n   136→              Add Talent\n   137→            </button>\n   138→          </div>\n   139→        </div>\n   140→      </div>\n   141→\n   142→      <div className=\"max-w-7xl mx-auto px-6 py-6\">\n   143→        {/* Status summary strip */}\n   144→        <div className=\"grid grid-cols-4 gap-3 mb-6\">\n   145→          {[\n   146→            { label: 'Ready', count: counts.ready, color: 'border-green-600 bg-green-900/20', filter: 'ready' },\n   147→            { label: 'Has Contact', count: counts.hasContact, color: 'border-blue-600 bg-blue-900/20', filter: 'has-contact' },\n   148→            { label: 'Did Prior Season', count: counts.didPrior, color: 'border-amber-600 bg-amber-900/20', filter: 'did-2025' },\n   149→            { label: 'Need Info', count: counts.needInfo, color: 'border-gray-600 bg-gray-800/50', filter: 'need-info' },\n   150→          ].map(({ label, count, color, filter }) => (\n   151→            <button\n   152→              key={filter}\n   153→              onClick={() => setStatusFilter(statusFilter === filter ? '' : filter)}\n   154→              className={`rounded-lg border p-3 text-left transition-colors ${color} ${statusFilter === filter ? 'ring-2 ring-white/20' : 'hover:bg-opacity-30'}`}\n   155→            >\n   156→              <div className=\"text-2xl font-bold text-white\">{count}</div>\n   157→              <div className=\"text-xs text-gray-300 mt-0.5\">{label}</div>\n   158→            </button>\n   159→          ))}\n   160→        </div>\n   161→\n   162→        {/* Filter row */}\n   163→        <div className=\"flex items-center gap-3 mb-5 flex-wrap\">\n   164→          <div className=\"relative flex-1 min-w-48\">\n   165→            <MagnifyingGlassIcon className=\"w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n   166→            <input\n   167→              type=\"text\"\n   168→              placeholder=\"Search by name, affiliation, conference...\"\n   169→              value={search}\n   170→              onChange={(e) => setSearch(e.target.value)}\n   171→              className=\"w-full pl-9 pr-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500\"\n   172→            />\n   173→          </div>\n   174→          <select\n   175→            value={statusFilter}\n   176→            onChange={(e) => setStatusFilter(e.target.value)}\n   177→            className=\"px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   178→          >\n   179→            {STATUS_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}\n   180→          </select>\n   181→          <select\n   182→            value={wagMagFilter}\n   183→            onChange={(e) => setWagMagFilter(e.target.value)}\n   184→            className=\"px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   185→          >\n   186→            {WAG_MAG_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}\n   187→          </select>\n   188→          <select\n   189→            value={roleFilter}\n   190→            onChange={(e) => setRoleFilter(e.target.value)}\n   191→            className=\"px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   192→          >\n   193→            {ROLE_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}\n   194→          </select>\n   195→          {(search || statusFilter || wagMagFilter || roleFilter) && (\n   196→            <button\n   197→              onClick={() => { setSearch(''); setStatusFilter(''); setWagMagFilter(''); setRoleFilter(''); }}\n   198→              className=\"text-gray-400 hover:text-white text-sm flex items-center gap-1\"\n   199→            >\n   200→              <XMarkIcon className=\"w-4 h-4\" />\n   201→              Clear\n   202→            </button>\n   203→          )}\n   204→          <span className=\"text-gray-500 text-sm ml-auto\">{filtered.length} shown</span>\n   205→        </div>\n   206→\n   207→        {/* Talent list */}\n   208→        {loading ? (\n   209→          <div className=\"text-center py-20 text-gray-500\">Loading roster...</div>\n   210→        ) : error ? (\n   211→          <div className=\"text-center py-20 text-red-400\">{error}</div>\n   212→        ) : filtered.length === 0 ? (\n   213→          <div className=\"text-center py-20 text-gray-500\">\n   214→            {talentList.length === 0 ? 'No talent in roster yet. Add someone to get started.' : 'No results match your filters.'}\n   215→          </div>\n   216→        ) : (\n   217→          <div className=\"space-y-2\">\n   218→            {filtered.map((talent) => (\n   219→              <TalentCard key={talent.id} talent={talent} />\n   220→            ))}\n   221→          </div>\n   222→        )}\n   223→      </div>\n   224→\n   225→      {/* Add Talent Modal */}\n   226→      {showAddModal && (\n   227→        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n   228→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 w-full max-w-lg\">\n   229→            <div className=\"flex items-center justify-between px-5 py-4 border-b border-gray-700\">\n   230→              <h2 className=\"text-lg font-semibold text-white\">Add Talent</h2>\n   231→              <button onClick={() => setShowAddModal(false)} className=\"text-gray-400 hover:text-white\">\n   232→                <XMarkIcon className=\"w-5 h-5\" />\n   233→              </button>\n   234→            </div>\n   235→            <form onSubmit={handleCreate} className=\"p-5 space-y-4\">\n   236→              <div className=\"grid grid-cols-2 gap-4\">\n   237→                <div className=\"col-span-2\">\n   238→                  <label className=\"block text-xs text-gray-400 mb-1\">Name *</label>\n   239→                  <input\n   240→                    required\n   241→                    value={newTalent.name}\n   242→                    onChange={e => setNewTalent(p => ({ ...p, name: e.target.value }))}\n   243→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   244→                    placeholder=\"Full name\"\n   245→                  />\n   246→                </div>\n   247→                <div>\n   248→                  <label className=\"block text-xs text-gray-400 mb-1\">Phone</label>\n   249→                  <input\n   250→                    value={newTalent.phone}\n   251→                    onChange={e => setNewTalent(p => ({ ...p, phone: e.target.value }))}\n   252→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   253→                    placeholder=\"(555) 123-4567\"\n   254→                  />\n   255→                </div>\n   256→                <div>\n   257→                  <label className=\"block text-xs text-gray-400 mb-1\">Email</label>\n   258→                  <input\n   259→                    type=\"email\"\n   260→                    value={newTalent.email}\n   261→                    onChange={e => setNewTalent(p => ({ ...p, email: e.target.value }))}\n   262→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   263→                    placeholder=\"email@example.com\"\n   264→                  />\n   265→                </div>\n   266→                <div>\n   267→                  <label className=\"block text-xs text-gray-400 mb-1\">WAG / MAG</label>\n   268→                  <select\n   269→                    value={newTalent.wagMag}\n   270→                    onChange={e => setNewTalent(p => ({ ...p, wagMag: e.target.value }))}\n   271→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   272→                  >\n   273→                    <option value=\"WAG\">WAG</option>\n   274→                    <option value=\"MAG\">MAG</option>\n   275→                    <option value=\"Both\">Both</option>\n   276→                  </select>\n   277→                </div>\n   278→                <div>\n   279→                  <label className=\"block text-xs text-gray-400 mb-1\">Role</label>\n   280→                  <select\n   281→                    value={newTalent.commentaryRole}\n   282→                    onChange={e => setNewTalent(p => ({ ...p, commentaryRole: e.target.value }))}\n   283→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   284→                  >\n   285→                    <option value=\"Play by Play / Lead\">Play by Play / Lead</option>\n   286→                    <option value=\"Color / Analyst\">Color / Analyst</option>\n   287→                    <option value=\"Does not matter\">Does not matter</option>\n   288→                  </select>\n   289→                </div>\n   290→                <div>\n   291→                  <label className=\"block text-xs text-gray-400 mb-1\">Status</label>\n   292→                  <select\n   293→                    value={newTalent.status}\n   294→                    onChange={e => setNewTalent(p => ({ ...p, status: e.target.value }))}\n   295→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   296→                  >\n   297→                    <option value=\"ready\">Ready</option>\n   298→                    <option value=\"has-contact\">Has Contact</option>\n   299→                    <option value=\"did-2025\">Did 2025</option>\n   3