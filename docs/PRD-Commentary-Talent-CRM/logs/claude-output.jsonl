{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YLnf1hBrt88mVmJSJc5dHU","type":"tool_result","content":"     1→import { useState } from 'react';\n     2→import { Link } from 'react-router-dom';\n     3→import { useCompetition } from '../context/CompetitionContext';\n     4→import { useCommentaryStaff, getStaffStatusLabel, getStaffStatusColor, getRoleLabel, STAFF_STATUS } from '../hooks/useCommentaryStaff';\n     5→import { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\n     6→import {\n     7→  MagnifyingGlassIcon,\n     8→  PhoneIcon,\n     9→  EnvelopeIcon,\n    10→  PlusIcon,\n    11→  XMarkIcon,\n    12→  UserGroupIcon,\n    13→  ChevronRightIcon,\n    14→  CheckIcon,\n    15→  LinkIcon,\n    16→  PaperAirplaneIcon,\n    17→  CalendarIcon,\n    18→  DocumentTextIcon,\n    19→  ClipboardDocumentIcon,\n    20→} from '@heroicons/react/24/solid';\n    21→import toast from 'react-hot-toast';\n    22→\n    23→const STATUS_FLOW = [\n    24→  { status: STAFF_STATUS.ASSIGNED, label: 'Assigned', next: STAFF_STATUS.INVITED },\n    25→  { status: STAFF_STATUS.INVITED, label: 'Invited', next: STAFF_STATUS.CONFIRMED },\n    26→  { status: STAFF_STATUS.CONFIRMED, label: 'Confirmed', next: STAFF_STATUS.BRIEFED },\n    27→  { status: STAFF_STATUS.DECLINED, label: 'Declined', next: null },\n    28→  { status: STAFF_STATUS.BRIEFED, label: 'Briefed', next: null },\n    29→];\n    30→\n    31→const SLOT_ROLES = [\n    32→  { role: 'pbp', label: 'Play by Play / Lead', color: 'border-blue-600' },\n    33→  { role: 'analyst', label: 'Color / Analyst', color: 'border-purple-600' },\n    34→  { role: 'producer', label: 'Producer', color: 'border-teal-600' },\n    35→];\n    36→\n    37→/**\n    38→ * CommentaryPage - Per-competition commentary talent management.\n    39→ * URL: /:compId/commentary\n    40→ */\n    41→export default function CommentaryPage() {\n    42→  const { compId, competitionConfig } = useCompetition();\n    43→  const { staffList, loading: staffLoading, assignTalent, updateStatus, updateNotes, removeAssignment } = useCommentaryStaff(compId);\n    44→  const { talentList, loading: talentLoading } = useTalentRoster();\n    45→\n    46→  const gender = competitionConfig?.gender || 'womens';\n    47→  const [search, setSearch] = useState('');\n    48→  const [activeRole, setActiveRole] = useState('pbp');\n    49→  const [editingNotes, setEditingNotes] = useState(null);\n    50→  const [notesDraft, setNotesDraft] = useState('');\n    51→\n    52→  // Outreach modals\n    53→  const [briefingModalOpen, setBriefingModalOpen] = useState(null); // talentId when open\n    54→  const [briefingForm, setBriefingForm] = useState({ virtiusUrl: '', discordInfo: '', preProdTime: '' });\n    55→  const [preProdModalOpen, setPreProdModalOpen] = useState(null); // talentId when open\n    56→  const [preProdTime, setPreProdTime] = useState('');\n    57→  const [iMessageConfirmOpen, setIMessageConfirmOpen] = useState(null); // { talentId, type, message } when open\n    58→  const [sendingOutreach, setSendingOutreach] = useState(false);\n    59→\n    60→  // Filter talent list for the right panel — match gender and status\n    61→  const targetWagMag = gender === 'mens' ? 'MAG' : 'WAG';\n    62→  const assignedIds = new Set(staffList.map(s => s.talentId));\n    63→\n    64→  const availableTalent = talentList.filter(t => {\n    65→    // Already assigned to this competition\n    66→    if (assignedIds.has(t.id)) return false;\n    67→    // Must match gender or be \"Both\"\n    68→    if (t.wagMag && t.wagMag !== 'Both' && t.wagMag !== targetWagMag) return false;\n    69→    // Search\n    70→    if (search) {\n    71→      const q = search.toLowerCase();\n    72→      if (!t.name?.toLowerCase().includes(q) && !t.affiliation?.toLowerCase().includes(q)) return false;\n    73→    }\n    74→    return true;\n    75→  });\n    76→\n    77→  // Sort: ready first, then has-contact, then others\n    78→  const sortedAvailable = [...availableTalent].sort((a, b) => {\n    79→    const order = { ready: 0, 'has-contact': 1, 'did-2025': 2, 'need-info': 3 };\n    80→    return (order[a.status] ?? 4) - (order[b.status] ?? 4);\n    81→  });\n    82→\n    83→  async function handleAssign(talent) {\n    84→    try {\n    85→      await assignTalent(talent.id, activeRole);\n    86→      toast.success(`${talent.name} added as ${getRoleLabel(activeRole)}`);\n    87→    } catch (e) {\n    88→      toast.error('Failed to assign talent');\n    89→    }\n    90→  }\n    91→\n    92→  async function handleAdvanceStatus(talentId, currentStatus) {\n    93→    const flow = STATUS_FLOW.find(s => s.status === currentStatus);\n    94→    if (!flow?.next) return;\n    95→    try {\n    96→      await updateStatus(talentId, flow.next);\n    97→      toast.success(`Status updated to ${getStaffStatusLabel(flow.next)}`);\n    98→    } catch (e) {\n    99→      toast.error('Failed to update status');\n   100→    }\n   101→  }\n   102→\n   103→  async function handleDecline(talentId) {\n   104→    try {\n   105→      await updateStatus(talentId, STAFF_STATUS.DECLINED);\n   106→    } catch (e) {\n   107→      toast.error('Failed to update status');\n   108→    }\n   109→  }\n   110→\n   111→  async function handleRemove(talentId, name) {\n   112→    try {\n   113→      await removeAssignment(talentId);\n   114→      toast.success(`${name} removed`);\n   115→    } catch (e) {\n   116→      toast.error('Failed to remove');\n   117→    }\n   118→  }\n   119→\n   120→  async function handleSaveNotes(talentId) {\n   121→    await updateNotes(talentId, notesDraft);\n   122→    setEditingNotes(null);\n   123→    toast.success('Notes saved');\n   124→  }\n   125→\n   126→  async function handleCopyBookingLink(talentId, role) {\n   127→    try {\n   128→      const response = await fetch(`https://api.commentarygraphic.com/api/book/generate`, {\n   129→        method: 'POST',\n   130→        headers: { 'Content-Type': 'application/json' },\n   131→        body: JSON.stringify({ talentId, compId, role }),\n   132→      });\n   133→\n   134→      if (!response.ok) throw new Error('Failed to generate booking link');\n   135→\n   136→      const data = await response.json();\n   137→      await navigator.clipboard.writeText(data.url);\n   138→      toast.success('Booking link copied!', { duration: 2000 });\n   139→    } catch (e) {\n   140→      toast.error('Failed to generate link');\n   141→    }\n   142→  }\n   143→\n   144→  // Outreach handlers\n   145→  async function handleSendInvite(talentId, role) {\n   146→    setSendingOutreach(true);\n   147→    try {\n   148→      const response = await fetch(`https://api.commentarygraphic.com/api/commentary/${compId}/${talentId}/invite`, {\n   149→        method: 'POST',\n   150→        headers: { 'Content-Type': 'application/json' },\n   151→        body: JSON.stringify({ role }),\n   152→      });\n   153→\n   154→      if (!response.ok) throw new Error('Failed to send invite');\n   155→\n   156→      toast.success('Invite sent ✓');\n   157→    } catch (e) {\n   158→      toast.error(e.message || 'Failed to send invite');\n   159→    } finally {\n   160→      setSendingOutreach(false);\n   161→    }\n   162→  }\n   163→\n   164→  async function handleSendBriefing(talentId) {\n   165→    if (!briefingForm.virtiusUrl || !briefingForm.discordInfo || !briefingForm.preProdTime) {\n   166→      toast.error('All fields are required');\n   167→      return;\n   168→    }\n   169→\n   170→    setSendingOutreach(true);\n   171→    try {\n   172→      const response = await fetch(`https://api.commentarygraphic.com/api/commentary/${compId}/${talentId}/briefing`, {\n   173→        method: 'POST',\n   174→        headers: { 'Content-Type': 'application/json' },\n   175→        body: JSON.stringify(briefingForm),\n   176→      });\n   177→\n   178→      if (!response.ok) throw new Error('Failed to send briefing');\n   179→\n   180→      toast.success('Briefing sent ✓');\n   181→      setBriefingModalOpen(null);\n   182→      setBriefingForm({ virtiusUrl: '', discordInfo: '', preProdTime: '' });\n   183→    } catch (e) {\n   184→      toast.error(e.message || 'Failed to send briefing');\n   185→    } finally {\n   186→      setSendingOutreach(false);\n   187→    }\n   188→  }\n   189→\n   190→  async function handleSendCalendarInvite(talentId) {\n   191→    setSendingOutreach(true);\n   192→    try {\n   193→      const response = await fetch(`https://api.commentarygraphic.com/api/commentary/${compId}/${talentId}/calendar-invite`, {\n   194→        method: 'POST',\n   195→        headers: { 'Content-Type': 'application/json' },\n   196→      });\n   197→\n   198→      if (!response.ok) throw new Error('Failed to send calendar invite');\n   199→\n   200→      toast.success('Calendar invite sent ✓');\n   201→    } catch (e) {\n   202→      toast.error(e.message || 'Failed to send calendar invite');\n   203→    } finally {\n   204→      setSendingOutreach(false);\n   205→    }\n   206→  }\n   207→\n   208→  async function handleSchedulePreProd(talentId) {\n   209→    if (!preProdTime) {\n   210→      toast.error('Meeting time is required');\n   211→      return;\n   212→    }\n   213→\n   214→    setSendingOutreach(true);\n   215→    try {\n   216→      const response = await fetch(`https://api.commentarygraphic.com/api/commentary/${compId}/${talentId}/schedule-preproduction`, {\n   217→        method: 'POST',\n   218→        headers: { 'Content-Type': 'application/json' },\n   219→        body: JSON.stringify({ meetingTime: preProdTime }),\n   220→      });\n   221→\n   222→      if (!response.ok) throw new Error('Failed to schedule meeting');\n   223→\n   224→      toast.success('Pre-production meeting scheduled ✓');\n   225→      setPreProdModalOpen(null);\n   226→      setPreProdTime('');\n   227→    } catch (e) {\n   228→      toast.error(e.message || 'Failed to schedule meeting');\n   229→    } finally {\n   230→      setSendingOutreach(false);\n   231→    }\n   232→  }\n   233→\n   234→  function generateInviteMessage(talent, role) {\n   235→    const eventName = competitionConfig?.eventName || 'the competition';\n   236→    const meetDate = competitionConfig?.meetDate || 'TBD';\n   237→    return `Hi ${talent?.name?.split(' ')[0] || 'there'}! Would you be available for ${eventName} on ${meetDate}? You'd be joining as ${getRoleLabel(role)}. Let me know!`;\n   238→  }\n   239→\n   240→  function generateBriefingMessage(talent) {\n   241→    const eventName = competitionConfig?.eventName || 'the competition';\n   242→    return `Hi ${talent?.name?.split(' ')[0]}! Here's your briefing for ${eventName}:\\n\\nVirtius: ${briefingForm.virtiusUrl}\\nDiscord: ${briefingForm.discordInfo}\\nPre-production meeting: ${briefingForm.preProdTime}\\n\\nSee you soon!`;\n   243→  }\n   244→\n   245→  async function handleCopyForIMessage(talentId, type, message) {\n   246→    await navigator.clipboard.writeText(message);\n   247→    setIMessageConfirmOpen({ talentId, type, message });\n   248→  }\n   249→\n   250→  async function confirmIMessageSent(talentId, type) {\n   251→    try {\n   252→      const talent = talentList.find(t => t.id === talentId);\n   253→      const response = await fetch(`https://api.commentarygraphic.com/api/talent/${talentId}/communication-log`, {\n   254→        method: 'POST',\n   255→        headers: { 'Content-Type': 'application/json' },\n   256→        body: JSON.stringify({\n   257→          type: 'imessage',\n   258→          sentAt: new Date().toISOString(),\n   259→          note: `${type} sent via iMessage`,\n   260→        }),\n   261→      });\n   262→\n   263→      if (!response.ok) throw new Error('Failed to log iMessage');\n   264→\n   265→      toast.success('Logged as sent via iMessage ✓');\n   266→      setIMessageConfirmOpen(null);\n   267→    } catch (e) {\n   268→      toast.error('Failed to log message');\n   269→    }\n   270→  }\n   271→\n   272→  // Group staff by role\n   273→  const byRole = SLOT_ROLES.reduce((acc, { role }) => {\n   274→    acc[role] = staffList.filter(s => s.role === role);\n   275→    return acc;\n   276→  }, {});\n   277→\n   278→  const confirmedCount = staffList.filter(s => s.status === STAFF_STATUS.CONFIRMED || s.status === STAFF_STATUS.BRIEFED).length;\n   279→  const totalCount = staffList.length;\n   280→\n   281→  return (\n   282→    <>\n   283→      {/* Briefing Modal */}\n   284→      {briefingModalOpen && (\n   285→        <div className=\"fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 p-4\">\n   286→          <div className=\"bg-zinc-900 rounded-xl border border-zinc-800 p-6 w-full max-w-md\">\n   287→            <h3 className=\"text-lg font-bold mb-4\">Send Briefing</h3>\n   288→            <div className=\"space-y-3\">\n   289→              <div>\n   290→                <label className=\"block text-xs text-zinc-400 mb-1\">Virtius Session URL</label>\n   291→                <input\n   292→                  type=\"text\"\n   293→                  value={briefingForm.virtiusUrl}\n   294→                  onChange={(e) => setBriefingForm({ ...briefingForm, virtiusUrl: e.target.value })}\n   295→                  placeholder=\"https://...\"\n   296→                  className=\"w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   297→                />\n   298→              </div>\n   299→              <div>\n   300→                <label className=\"block text-xs text-zinc-400 mb-1\">Discord Info</label>\n   301→                <input\n   302→                  type=\"text\"\n   303→                  value={briefingForm.discordInfo}\n   304→                  onChange={(e) => setBriefingForm({ ...briefingForm, discordInfo: e.target.value })}\n   305→                  placeholder=\"Room name or link\"\n   306→                  className=\"w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   307→                />\n   308→              </div>\n   309→              <div>\n   310→                <label className=\"block text-xs text-zinc-400 mb-1\">Pre-Production Meeting Time</label>\n   311→                <input\n   312→                  type=\"datetime-local\"\n   313→                  value={briefingForm.preProdTime}\n   314→                  onChange={(e) => setBriefingForm({ ...briefingForm, preProdTime: e.target.value })}\n   315→                  className=\"w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   316→                />\n   317→              </div>\n   318→            </div>\n   319→            <div className=\"flex gap-2 mt-5\">\n   320→              <button\n   321→                onClick={() => handleSendBriefing(briefingModalOpen)}\n   322→                disabled={sendingOutreach}\n   323→                className=\"flex-1 py-2 bg-blue-600 hover:bg-blue-500 rounded font-medium text-sm disabled:opacity-50\"\n   324→              >\n   325→                {sendingOutreach ? 'Sending...' : 'Send Briefing'}\n   326→              </button>\n   327→              <button\n   328→                onClick={() => setBriefingModalOpen(null)}\n   329→                disabled={sendingOutreach}\n   330→                className=\"px-4 py-2 bg-zinc-800 hover:bg-zinc-700 rounded text-sm\"\n   331→              >\n   332→                Cancel\n   333→              </button>\n   334→            </div>\n   335→          </div>\n   336→        </div>\n   337→      )}\n   338→\n   339→      {/* Pre-Production Scheduling Modal */}\n   340→      {preProdModalOpen && (\n   341→        <div className=\"fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 p-4\">\n   342→          <div className=\"bg-zinc-900 rounded-xl border border-zinc-800 p-6 w-full max-w-md\">\n   343→            <h3 className=\"text-lg font-bold mb-4\">Schedule Pre-Production Meeting</h3>\n   344→            <div>\n   345→              <label className=\"block text-xs text-zinc-400 mb-1\">Meeting Time</label>\n   346→              <input\n   347→                type=\"datetime-local\"\n   348→                value={preProdTime}\n   349→                onChange={(e) => setPreProdTime(e.target.value)}\n   350→                className=\"w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   351→              />\n   352→            </div>\n   353→            <div className=\"flex gap-2 mt-5\">\n   354→              <button\n   355→                onClick={() => handleSchedulePreProd(preProdModalOpen)}\n   356→                disabled={sendingOutreach}\n   357→                className=\"flex-1 py-2 bg-blue-600 hover:bg-blue-500 rounded font-medium text-sm disabled:opacity-50\"\n   358→              >\n   359→                {sendingOutreach ? 'Scheduling...' : 'Schedule Meeting'}\n   360→              </button>\n   361→              <button\n   362→                onClick={() => setPreProdModalOpen(null)}\n   363→                disabled={sendingOutreach}\n   364→                className=\"px-4 py-2 bg-zinc-800 hover:bg-zinc-700 rounded text-sm\"\n   365→              >\n   366→                Cancel\n   367→              </button>\n   368→            </div>\n   369→          </div>\n   370→        </div>\n   371→      )}\n   372→\n   373→      {/* iMessage Confirmation Modal */}\n   374→      {iMessageConfirmOpen && (\n   375→        <div className=\"fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 p-4\">\n   376→          <div className=\"bg-zinc-900 rounded-xl border border-zinc-800 p-6 w-full max-w-md\">\n   377→            <h3 className=\"text-lg font-bold mb-3\">Message Copied!</h3>\n   378→            <p className=\"text-sm text-zinc-400 mb-4\">\n   379→              The message has been copied to your clipboard. After you send it via iMessage, click \"Yes\" to log it in the system.\n   380→            </p>\n   381→            <div className=\"bg-zinc-800 p-3 rounded text-xs text-zinc-300 mb-4 max-h-32 overflow-y-auto whitespace-pre-wrap\">\n   382→              {iMessageConfirmOpen.message}\n   383→            </div>\n   384→            <div className=\"flex gap-2\">\n   385→              <button\n   386→                onClick={() => confirmIMessageSent(iMessageConfirmOpen.talentId, iMessageConfirmOpen.type)}\n   387→                className=\"flex-1 py-2 bg-green-600 hover:bg-green-500 rounded font-medium text-sm\"\n   388→              >\n   389→                Yes, I sent it\n   390→              </button>\n   391→              <button\n   392→                onClick={() => setIMessageConfirmOpen(null)}\n   393→                className=\"px-4 py-2 bg-zinc-800 hover:bg-zinc-700 rounded text-sm\"\n   394→              >\n   395→                Cancel\n   396→              </button>\n   397→            </div>\n   398→          </div>\n   399→        </div>\n   400→      )}\n   401→\n   402→    <div className=\"min-h-screen bg-zinc-950 text-white\">\n   403→      {/* Header */}\n   404→      <div className=\"bg-zinc-900 border-b border-zinc-800 px-6 py-4\">\n   405→        <div className=\"flex items-center justify-between\">\n   406→          <div className=\"flex items-center gap-4\">\n   407→            <div>\n   408→              <h1 className=\"text-lg font-bold text-white flex items-center gap-2\">\n   409→                <UserGroupIcon className=\"w-5 h-5 text-blue-400\" />\n   410→                Commentary\n   411→              </h1>\n   412→              <p className=\"text-xs text-zinc-500\">\n   413→                {competitionConfig?.eventName || compId} ·{' '}\n   414→                {totalCount === 0\n   415→                  ? 'No talent assigned'\n   416→                  : `${confirmedCount}/${totalCount} confirmed`}\n   417→              </p>\n   418→            </div>\n   419→          </div>\n   420→          <Link\n   421→            to=\"/talent\"\n   422→            className=\"text-xs text-zinc-400 hover:text-white transition-colors flex items-center gap-1\"\n   423→          >\n   424→            Manage Roster\n   425→            <ChevronRightIcon className=\"w-3 h-3\" />\n   426→          </Link>\n   427→        </div>\n   428→      </div>\n   429→\n   430→      <div className=\"flex h-[calc(100vh-73px)]\">\n   431→        {/* Left: Current assignments */}\n   432→        <div className=\"flex-1 overflow-y-auto p-5 border-r border-zinc-800\">\n   433→          <div className=\"space-y-6\">\n   434→            {SLOT_ROLES.map(({ role, label, color }) => (\n   435→              <div key={role}>\n   436→                <div className={`flex items-center gap-2 mb-3 pb-2 border-b ${color.replace('border', 'border-b')}`}>\n   437→                  <h2 className=\"text-sm font-semibold text-zinc-300\">{label}</h2>\n   438→                  <span className=\"text-xs text-zinc-500\">({byRole[role]?.length || 0})</span>\n   439→                </div>\n   440→\n   441→                {byRole[role]?.length === 0 && (\n   442→                  <button\n   443→                    onClick={() => setActiveRole(role)}\n   444→                    className=\"w-full py-3 border border-dashed border-zinc-700 rounded-lg text-zinc-500 text-sm hover:border-zinc-500 hover:text-zinc-300 transition-colors flex items-center justify-center gap-2\"\n   445→                  >\n   446→                    <PlusIcon className=\"w-4 h-4\" />\n   447→                    Assign {label}\n   448→                  </button>\n   449→                )}\n   450→\n   451→                <div className=\"space-y-2\">\n   452→                  {byRole[role]?.map((assignment) => {\n   453→                    const talent = talentList.find(t => t.id === assignment.talentId);\n   454→                    const flowEntry = STATUS_FLOW.find(s => s.status === assignment.status);\n   455→                    const isEditingNotes = editingNotes === assignment.talentId;\n   456→\n   457→                    return (\n   458→                      <div key={assignment.talentId} className=\"bg-zinc-800 rounded-xl border border-zinc-700 p-4\">\n   459→                        <div className=\"flex items-start justify-between gap-3\">\n   460→                          <div className=\"flex-1 min-w-0\">\n   461→                            <div className=\"flex items-center gap-2 mb-1\">\n   462→                              <Link\n   463→                                to={`/talent/${assignment.talentId}`}\n   464→                                className=\"font-semibold text-white hover:text-blue-300 transition-colors\"\n   465→                              >\n   466→                                {talent?.name || assignment.talentId}\n   467→                              </Link>\n   468→                              <span className={`px-2 py-0.5 rounded text-xs font-medium ${getStaffStatusColor(assignment.status)}`}>\n   469→                                {getStaffStatusLabel(assignment.status)}\n   470→                              </span>\n   471→                            </div>\n   472→                            {talent && (\n   473→                              <div className=\"flex items-center gap-3 text-xs text-zinc-400\">\n   474→                                {talent.phone && (\n   475→                                  <a href={`tel:${talent.phone}`} className=\"flex items-center gap-1 text-blue-400 hover:text-blue-300\">\n   476→                                    <PhoneIcon className=\"w-3 h-3\" />\n   477→                                    {talent.phone}\n   478→                                  </a>\n   479→                                )}\n   480→                                {talent.email && (\n   481→                                  <a href={`mailto:${talent.email}`} className=\"flex items-center gap-1 text-zinc-400 hover:text-zinc-200\">\n   482→                                    <EnvelopeIcon className=\"w-3 h-3\" />\n   483→                                    {talent.email}\n   484→                                  </a>\n   485→                                )}\n   486→                              </div>\n   487→                            )}\n   488→                          </div>\n   489→                          <button\n   490→                            onClick={() => handleRemove(assignment.talentId, talent?.name)}\n   491→                            className=\"text-zinc-600 hover:text-red-400 transition-colors flex-shrink-0\"\n   492→                            title=\"Remove\"\n   493→                          >\n   494→                            <XMarkIcon className=\"w-4 h-4\" />\n   495→                          </button>\n   496→                        </div>\n   497→\n   498→                        {/* Workflow status buttons */}\n   499→                        <div className=\"flex items-center gap-2 mt-3 flex-wrap\">\n   500→                          {flowEntry?.next && (\n   501→                            <button\n   502→                              onClick={() => handleAdvanceStatus(assignment.talentId, assignment.status)}\n   503→                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded text-xs font-medium transition-colors\"\n   504→                            >\n   505→                              <CheckIcon className=\"w-3 h-3\" />\n   506→                              Mark as {getStaffStatusLabel(flowEntry.next)}\n   507→                            </button>\n   508→                          )}\n   509→                          <button\n   510→                            onClick={() => handleCopyBookingLink(assignment.talentId, assignment.role)}\n   511→                            className=\"flex items-center gap-1.5 px-3 py-1.5 bg-zinc-700 hover:bg-zinc-600 rounded text-xs font-medium transition-colors\"\n   512→                            title=\"Generate and copy booking link\"\n   513→                          >\n   514→                            <LinkIcon className=\"w-3 h-3\" />\n   515→                            Copy Link\n   516→                          </button>\n   517→                          {assignment.status === STAFF_STATUS.INVITED && (\n   518→                            <button\n   519→                              onClick={() => handleDecline(assignment.talentId)}\n   520→                              className=\"px-3 py-1.5 bg-red-900 hover:bg-red-800 rounded text-xs font-medium transition-colors\"\n   521→                            >\n   522→                              Mark Declined\n   523→                            </button>\n   524→                          )}\n   525→                          {assignment.status === STAFF_STATUS.CONFIRMED && (\n   526→                            <div className=\"flex items-center gap-1.5 px-2 py-1 text-xs text-zinc-500\">\n   527→                              <span className={`w-2 h-2 rounded-full ${assignment.calendarInviteSent ? 'bg-green-500' : 'bg-zinc-600'}`} />\n   528→                              Calendar invite\n   529→                            </div>\n   530→                          )}\n   531→                        </div>\n   532→\n   533→                        {/* Outreach buttons */}\n   534→                        <div className=\"border-t border-zinc-700 mt-3 pt-3\">\n   535→                          <div className=\"text-xs font-semibold text-zinc-400 mb-2\">Outreach Actions</div>\n   536→                          <div className=\"flex items-center gap-2 flex-wrap\">\n   537→                            <button\n   538→                              onClick={() => handleSendInvite(assignment.talentId, assignment.role)}\n   539→                              disabled={sendingOutreach}\n   540→                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-green-700 hover:bg-green-600 rounded text-xs font-medium transition-colors disabled:opacity-50\"\n   541→                            >\n   542→                              <PaperAirplaneIcon className=\"w-3 h-3\" />\n   543→                              Send Invite\n   544→                            </button>\n   545→                            <button\n   546→                              onClick={() => handleCopyForIMessage(assignment.talentId, 'invite', generateInviteMessage(talent, assignment.role))}\n   547→                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-zinc-700 hover:bg-zinc-600 rounded text-xs font-medium transition-colors\"\n   548→                              title=\"Copy invite for iMessage\"\n   549→                            >\n   550→                              <ClipboardDocumentIcon className=\"w-3 h-3\" />\n   551→                              Copy for iMessage\n   552→                            </button>\n   553→                          </div>\n   554→                          <div className=\"flex items-center gap-2 flex-wrap mt-2\">\n   555→                            <button\n   556→                              onClick={() => setBriefingModalOpen(assignment.talentId)}\n   557→                              disabled={sendingOutreach}\n   558→                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-purple-700 hover:bg-purple-600 rounded text-xs font-medium transition-colors disabled:opacity-50\"\n   559→                            >\n   560→                              <DocumentTextIcon className=\"w-3 h-3\" />\n   561→                              Send Briefing\n   562→                            </button>\n   563→                            <button\n   564→                              onClick={() => handleCopyForIMessage(assignment.talentId, 'briefing', generateBriefingMessage(talent))}\n   565→                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-zinc-700 hover:bg-zinc-600 rounded text-xs font-medium transition-colors\"\n   566→                              title=\"Copy briefing for iMessage\"\n   567→                            >\n   568→                              <ClipboardDocumentIcon className=\"w-3 h-3\" />\n   569→                              Copy for iMessage\n   570→                            </button>\n   571→                          </div>\n   572→                          <div className=\"flex items-center gap-2 flex-wrap mt-2\">\n   573→                            <button\n   574→                              onClick={() => handleSendCalendarInvite(assignment.talentId)}\n   575→                              disabled={sendingOutreach}\n   576→                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-blue-700 hover:bg-blue-600 rounded text-xs font-medium transition-colors disabled:opacity-50\"\n   577→                            >\n   578→                              <CalendarIcon className=\"w-3 h-3\" />\n   579→                              Calendar Invite\n   580→                            </button>\n   581→                            <button\n   582→                              onClick={() => setPreProdModalOpen(assignment.talentId)}\n   583→                              disabled={sendingOutreach}\n   584→                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-teal-700 hover:bg-teal-600 rounded text-xs font-medium transition-colors disabled:opacity-50\"\n   585→                            >\n   586→                              <CalendarIcon className=\"w-3 h-3\" />\n   587→                              Schedule Pre-Prod\n   588→                            </button>\n   589→                          </div>\n   590→                        </div>\n   591→\n   592→                        {/* Notes */}\n   593→                        <div className=\"mt-2\">\n   594→                          {isEditingNotes ? (\n   595→                            <div className=\"flex gap-2\">\n   596→                              <input\n   597→                                autoFocus\n   598→                                value={notesDraft}\n   599→                                onChange={e => setNotesDraft(e.target.value)}\n   600→                                placeholder=\"Add a note for this competition...\"\n   601→                                className=\"flex-1 px-2 py-1 bg-zinc-700 border border-zinc-600 rounded text-xs text-white focus:outline-none\"\n   602→                              />\n   603→                              <button onClick={() => handleSaveNotes(assignment.talentId)} className=\"px-2 py-1 bg-blue-600 hover:bg-blue-500 rounded text-xs\">Save</button>\n   604→                              <button onClick={() => setEditingNotes(null)} className=\"px-2 py-1 text-zinc-400 hover:text-white text-xs\">Cancel</button>\n   605→                            </div>\n   606→                          ) : (\n   607→                            <button\n   608→                              onClick={() => { setEditingNotes(assignment.talentId); setNotesDraft(assignment.notes || ''); }}\n   609→                              className=\"text-xs text-zinc-500 hover:text-zinc-300 transition-colors\"\n   610→                            >\n   611→                              {assignment.notes ? assignment.notes : '+ Add competition note'}\n   612→                            </button>\n   613→                          )}\n   614→                        </div>\n   615→                      </div>\n   616→                    );\n   617→                  })}\n   618→                </div>\n   619→              </div>\n   620→            ))}\n   621→          </div>\n   622→        </div>\n   623→\n   624→        {/* Right: Talent search */}\n   625→        <div className=\"w-80 flex-shrink-0 flex flex-col\">\n   626→          <div className=\"p-4 border-b border-zinc-800\">\n   627→            <div className=\"flex items-center gap-2 mb-3\">\n   628→              <h2 className=\"text-sm font-semibold text-zinc-300\">Add to competition</h2>\n   629→            </div>\n   630→            {/* Role selector */}\n   631→            <div className=\"flex gap-1.5 mb-3\">\n   632→              {SLOT_ROLES.map(({ role, label }) => (\n   633→                <button\n   634→                  key={role}\n   635→                  onClick={() => setActiveRole(role)}\n   636→                  className={`flex-1 py-1.5 rounded text-xs font-medium transition-colors ${\n   637→                    activeRole === role\n   638→                      ? 'bg-blue-600 text-white'\n   639→                      : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'\n   640→                  }`}\n   641→                >\n   642→                  {role === 'pbp' ? 'PBP' : role === 'analyst' ? 'Analyst' : 'Producer'}\n   643→                </button>\n   644→              ))}\n   645→            </div>\n   646→            <div className=\"relative\">\n   647→              <MagnifyingGlassIcon className=\"w-4 h-4 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\n   648→              <input\n   649→                type=\"text\"\n   650→                placeholder={`Search ${targetWagMag} talent...`}\n   651→                value={search}\n   652→                onChange={e => setSearch(e.target.value)}\n   653→                className=\"w-full pl-9 pr-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500\"\n   654→              />\n   655→            </div>\n   656→          </div>\n   657→\n   658→          <div className=\"flex-1 overflow-y-auto p-3 space-y-1.5\">\n   659→            {talentLoading ? (\n   660→              <div className=\"text-center py-8 text-zinc-500 text-sm\">Loading...</div>\n   661→            ) : sortedAvailable.length === 0 ? (\n   662→              <div className=\"text-center py-8 text-zinc-500 text-sm\">No talent found</div>\n   663→            ) : (\n   664→              sortedAvailable.map(talent => {\n   665→                const isInterested = talent.interested && talent.interested[compId] === true;\n   666→                return (\n   667→                  <div\n   668→                    key={talent.id}\n   669→                    className=\"bg-zinc-800 hover:bg-zinc-750 border border-zinc-700 rounded-lg px-3 py-2.5 group\"\n   670→                  >\n   671→                    <div className=\"flex items-start gap-2\">\n   672→                      <div className=\"flex-1 min-w-0\">\n   673→                        <div className=\"flex items-center gap-1.5 mb-0.5\">\n   674→                          <span className=\"text-sm font-medium text-white truncate\">{talent.name}</span>\n   675→                          <span className={`flex-shrink-0 px-1.5 py-0.5 rounded text-xs ${getStatusColor(talent.status)}`}>\n   676→                            {getStatusLabel(talent.status)}\n   677→                          </span>\n   678→                          {isInterested && (\n   679→                            <span className=\"flex-shrink-0 px-1.5 py-0.5 rounded text-xs bg-green-900 text-green-200 flex items-center gap-1\">\n   680→                              <CheckIcon className=\"w-2.5 h-2.5\" />\n   681→                              Interested\n   682→                            </span>\n   683→                          )}\n   684→                        </div>\n   685→                        <div className=\"text-xs text-zinc-500 truncate\">\n   686→                          {talent.commentaryRole}{talent.affiliation ? ` · ${talent.affiliation}` : ''}\n   687→                        </div>\n   688→                        {talent.phone && (\n   689→                          <a href={`tel:${talent.phone}`} className=\"text-xs text-blue-500 hover:text-blue-400 flex items-center gap-1 mt-0.5\">\n   690→                            <PhoneIcon className=\"w-2.5 h-2.5\" />\n   691→                            {talent.phone}\n   692→                          </a>\n   693→                        )}\n   694→                      </div>\n   695→                      <button\n   696→                        onClick={() => handleAssign(talent)}\n   697→                        className=\"flex-shrink-0 p-1.5 bg-blue-600 hover:bg-blue-500 rounded transition-colors opacity-0 group-hover:opacity-100\"\n   698→                        title={`Add as ${getRoleLabel(activeRole)}`}\n   699→                      >\n   700→                        <PlusIcon className=\"w-3.5 h-3.5\" />\n   701→                      </button>\n   702→                    </div>\n   703→                  </div>\n   704→                );\n   705→              })\n   706→            )}\n   707→          </div>\n   708→\n   709→          <div className=\"p-3 border-t border-zinc-800\">\n   710→            <Link\n   711→              to=\"/talent\"\n   712→              className=\"w-full flex items-center justify-center gap-2 py-2 bg-zinc-800 hover:bg-zinc-700 rounded-lg text-xs text-zinc-400 hover:text-white transition-colors\"\n   713→            >\n   714→              <UserGroupIcon className=\"w-4 h-4\" />\n   715→              View full roster\n   716→            </Link>\n   717→          </div>\n   718→        </div>\n   719→      </div>\n   720→    </div>\n   721→    </>\n   722→  );\n   723→}\n   724→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"b6b0c018-1c51-4923-9f8e-0cd073fd25e6","uuid":"35da66d8-e883-43ab-86a2-742f51e75be9","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/pages/CommentaryPage.jsx","content":"import { useState } from 'react';\nimport { Link } from 'react-router-dom';\nimport { useCompetition } from '../context/CompetitionContext';\nimport { useCommentaryStaff, getStaffStatusLabel, getStaffStatusColor, getRoleLabel, STAFF_STATUS } from '../hooks/useCommentaryStaff';\nimport { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\nimport {\n  MagnifyingGlassIcon,\n  PhoneIcon,\n  EnvelopeIcon,\n  PlusIcon,\n  XMarkIcon,\n  UserGroupIcon,\n  ChevronRightIcon,\n  CheckIcon,\n  LinkIcon,\n  PaperAirplaneIcon,\n  CalendarIcon,\n  DocumentTextIcon,\n  ClipboardDocumentIcon,\n} from '@heroicons/react/24/solid';\nimport toast from 'react-hot-toast';\n\nconst STATUS_FLOW = [\n  { status: STAFF_STATUS.ASSIGNED, label: 'Assigned', next: STAFF_STATUS.INVITED },\n  { status: STAFF_STATUS.INVITED, label: 'Invited', next: STAFF_STATUS.CONFIRMED },\n  { status: STAFF_STATUS.CONFIRMED, label: 'Confirmed', next: STAFF_STATUS.BRIEFED },\n  { status: STAFF_STATUS.DECLINED, label: 'Declined', next: null },\n  { status: STAFF_STATUS.BRIEFED, label: 'Briefed', next: null },\n];\n\nconst SLOT_ROLES = [\n  { role: 'pbp', label: 'Play by Play / Lead', color: 'border-blue-600' },\n  { role: 'analyst', label: 'Color / Analyst', color: 'border-purple-600' },\n  { role: 'producer', label: 'Producer', color: 'border-teal-600' },\n];\n\n/**\n * CommentaryPage - Per-competition commentary talent management.\n * URL: /:compId/commentary\n */\nexport default function CommentaryPage() {\n  const { compId, competitionConfig } = useCompetition();\n  const { staffList, loading: staffLoading, assignTalent, updateStatus, updateNotes, removeAssignment } = useCommentaryStaff(compId);\n  const { talentList, loading: talentLoading } = useTalentRoster();\n\n  const gender = competitionConfig?.gender || 'womens';\n  const [search, setSearch] = useState('');\n  const [activeRole, setActiveRole] = useState('pbp');\n  const [editingNotes, setEditingNotes] = useState(null);\n  const [notesDraft, setNotesDraft] = useState('');\n\n  // Outreach modals\n  const [briefingModalOpen, setBriefingModalOpen] = useState(null); // talentId when open\n  const [briefingForm, setBriefingForm] = useState({ virtiusUrl: '', discordInfo: '', preProdTime: '' });\n  const [preProdModalOpen, setPreProdModalOpen] = useState(null); // talentId when open\n  const [preProdTime, setPreProdTime] = useState('');\n  const [iMessageConfirmOpen, setIMessageConfirmOpen] = useState(null); // { talentId, type, message } when open\n  const [sendingOutreach, setSendingOutreach] = useState(false);\n\n  // Filter talent list for the right panel — match gender and status\n  const targetWagMag = gender === 'mens' ? 'MAG' : 'WAG';\n  const assignedIds = new Set(staffList.map(s => s.talentId));\n\n  const availableTalent = talentList.filter(t => {\n    // Already assigned to this competition\n    if (assignedIds.has(t.id)) return false;\n    // Must match gender or be \"Both\"\n    if (t.wagMag && t.wagMag !== 'Both' && t.wagMag !== targetWagMag) return false;\n    // Search\n    if (search) {\n      const q = search.toLowerCase();\n      if (!t.name?.toLowerCase().includes(q) && !t.affiliation?.toLowerCase().includes(q)) return false;\n    }\n    return true;\n  });\n\n  // Sort: ready first, then has-contact, then others\n  const sortedAvailable = [...availableTalent].sort((a, b) => {\n    const order = { ready: 0, 'has-contact': 1, 'did-2025': 2, 'need-info': 3 };\n    return (order[a.status] ?? 4) - (order[b.status] ?? 4);\n  });\n\n  async function handleAssign(talent) {\n    try {\n      await assignTalent(talent.id, activeRole);\n      toast.success(`${talent.name} added as ${getRoleLabel(activeRole)}`);\n    } catch (e) {\n      toast.error('Failed to assign talent');\n    }\n  }\n\n  async function handleAdvanceStatus(talentId, currentStatus) {\n    const flow = STATUS_FLOW.find(s => s.status === currentStatus);\n    if (!flow?.next) return;\n    try {\n      await updateStatus(talentId, flow.next);\n      toast.success(`Status updated to ${getStaffStatusLabel(flow.next)}`);\n    } catch (e) {\n      toast.error('Failed to update status');\n    }\n  }\n\n  async function handleDecline(talentId) {\n    try {\n      await updateStatus(talentId, STAFF_STATUS.DECLINED);\n    } catch (e) {\n      toast.error('Failed to update status');\n    }\n  }\n\n  async function handleRemove(talentId, name) {\n    try {\n      await removeAssignment(talentId);\n      toast.success(`${name} removed`);\n    } catch (e) {\n      toast.error('Failed to remove');\n    }\n  }\n\n  async function handleSaveNotes(talentId) {\n    await updateNotes(talentId, notesDraft);\n    setEditingNotes(null);\n    toast.success('Notes saved');\n  }\n\n  async function handleCopyBookingLink(talentId, role) {\n    try {\n      const response = await fetch(`https://api.commentarygraphic.com/api/book/generate`, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ talentId, compId, role }),\n      });\n\n      if (!response.ok) throw new Error('Failed to generate booking link');\n\n      const data = await response.json();\n      await navigator.clipboard.writeText(data.url);\n      toast.success('Booking link copied!', { duration: 2000 });\n    } catch (e) {\n      toast.error('Failed to generate link');\n    }\n  }\n\n  // Outreach handlers\n  async function handleSendInvite(talentId, role) {\n    setSendingOutreach(true);\n    try {\n      const response = await fetch(`https://api.commentarygraphic.com/api/commentary/${compId}/${talentId}/invite`, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ role }),\n      });\n\n      if (!response.ok) throw new Error('Failed to send invite');\n\n      toast.success('Invite sent ✓');\n    } catch (e) {\n      toast.error(e.message || 'Failed to send invite');\n    } finally {\n      setSendingOutreach(false);\n    }\n  }\n\n  async function handleSendBriefing(talentId) {\n    if (!briefingForm.virtiusUrl || !briefingForm.discordInfo || !briefingForm.preProdTime) {\n      toast.error('All fields are required');\n      return;\n    }\n\n    setSendingOutreach(true);\n    try {\n      const response = await fetch(`https://api.commentarygraphic.com/api/commentary/${compId}/${talentId}/briefing`, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(briefingForm),\n      });\n\n      if (!response.ok) throw new Error('Failed to send briefing');\n\n      toast.success('Briefing sent ✓');\n      setBriefingModalOpen(null);\n      setBriefingForm({ virtiusUrl: '', discordInfo: '', preProdTime: '' });\n    } catch (e) {\n      toast.error(e.message || 'Failed to send briefing');\n    } finally {\n      setSendingOutreach(false);\n    }\n  }\n\n  async function handleSendCalendarInvite(talentId) {\n    setSendingOutreach(true);\n    try {\n      const response = await fetch(`https://api.commentarygraphic.com/api/commentary/${compId}/${talentId}/calendar-invite`, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n      });\n\n      if (!response.ok) throw new Error('Failed to send calendar invite');\n\n      toast.success('Calendar invite sent ✓');\n    } catch (e) {\n      toast.error(e.message || 'Failed to send calendar invite');\n    } finally {\n      setSendingOutreach(false);\n    }\n  }\n\n  async function handleSchedulePreProd(talentId) {\n    if (!preProdTime) {\n      toast.error('Meeting time is required');\n      return;\n    }\n\n    setSendingOutreach(true);\n    try {\n      const response = await fetch(`https://api.commentarygraphic.com/api/commentary/${compId}/${talentId}/schedule-preproduction`, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ meetingTime: preProdTime }),\n      });\n\n      if (!response.ok) throw new Error('Failed to schedule meeting');\n\n      toast.success('Pre-production meeting scheduled ✓');\n      setPreProdModalOpen(null);\n      setPreProdTime('');\n    } catch (e) {\n      toast.error(e.message || 'Failed to schedule meeting');\n    } finally {\n      setSendingOutreach(false);\n    }\n  }\n\n  function generateInviteMessage(talent, role) {\n    const eventName = competitionConfig?.eventName || 'the competition';\n    const meetDate = competitionConfig?.meetDate || 'TBD';\n    return `Hi ${talent?.name?.split(' ')[0] || 'there'}! Would you be available for ${eventName} on ${meetDate}? You'd be joining as ${getRoleLabel(role)}. Let me know!`;\n  }\n\n  function generateBriefingMessage(talent) {\n    const eventName = competitionConfig?.eventName || 'the competition';\n    return `Hi ${talent?.name?.split(' ')[0]}! Here's your briefing for ${eventName}:\\n\\nVirtius: ${briefingForm.virtiusUrl}\\nDiscord: ${briefingForm.discordInfo}\\nPre-production meeting: ${briefingForm.preProdTime}\\n\\nSee you soon!`;\n  }\n\n  async function handleCopyForIMessage(talentId, type, message) {\n    await navigator.clipboard.writeText(message);\n    setIMessageConfirmOpen({ talentId, type, message });\n  }\n\n  async function confirmIMessageSent(talentId, type) {\n    try {\n      const talent = talentList.find(t => t.id === talentId);\n      const response = await fetch(`https://api.commentarygraphic.com/api/talent/${talentId}/communication-log`, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({\n          type: 'imessage',\n          sentAt: new Date().toISOString(),\n          note: `${type} sent via iMessage`,\n        }),\n      });\n\n      if (!response.ok) throw new Error('Failed to log iMessage');\n\n      toast.success('Logged as sent via iMessage ✓');\n      setIMessageConfirmOpen(null);\n    } catch (e) {\n      toast.error('Failed to log message');\n    }\n  }\n\n  // Group staff by role\n  const byRole = SLOT_ROLES.reduce((acc, { role }) => {\n    acc[role] = staffList.filter(s => s.role === role);\n    return acc;\n  }, {});\n\n  const confirmedCount = staffList.filter(s => s.status === STAFF_STATUS.CONFIRMED || s.status === STAFF_STATUS.BRIEFED).length;\n  const totalCount = staffList.length;\n\n  return (\n    <>\n      {/* Briefing Modal */}\n      {briefingModalOpen && (\n        <div className=\"fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-zinc-900 rounded-xl border border-zinc-800 p-6 w-full max-w-md\">\n            <h3 className=\"text-lg font-bold mb-4\">Send Briefing</h3>\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"block text-xs text-zinc-400 mb-1\">Virtius Session URL</label>\n                <input\n                  type=\"text\"\n                  value={briefingForm.virtiusUrl}\n                  onChange={(e) => setBriefingForm({ ...briefingForm, virtiusUrl: e.target.value })}\n                  placeholder=\"https://...\"\n                  className=\"w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs text-zinc-400 mb-1\">Discord Info</label>\n                <input\n                  type=\"text\"\n                  value={briefingForm.discordInfo}\n                  onChange={(e) => setBriefingForm({ ...briefingForm, discordInfo: e.target.value })}\n                  placeholder=\"Room name or link\"\n                  className=\"w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs text-zinc-400 mb-1\">Pre-Production Meeting Time</label>\n                <input\n                  type=\"datetime-local\"\n                  value={briefingForm.preProdTime}\n                  onChange={(e) => setBriefingForm({ ...briefingForm, preProdTime: e.target.value })}\n                  className=\"w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                />\n              </div>\n            </div>\n            <div className=\"flex gap-2 mt-5\">\n              <button\n                onClick={() => handleSendBriefing(briefingModalOpen)}\n                disabled={sendingOutreach}\n                className=\"flex-1 py-2 bg-blue-600 hover:bg-blue-500 rounded font-medium text-sm disabled:opacity-50\"\n              >\n                {sendingOutreach ? 'Sending...' : 'Send Briefing'}\n              </button>\n              <button\n                onClick={() => setBriefingModalOpen(null)}\n                disabled={sendingOutreach}\n                className=\"px-4 py-2 bg-zinc-800 hover:bg-zinc-700 rounded text-sm\"\n              >\n                Cancel\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Pre-Production Scheduling Modal */}\n      {preProdModalOpen && (\n        <div className=\"fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-zinc-900 rounded-xl border border-zinc-800 p-6 w-full max-w-md\">\n            <h3 className=\"text-lg font-bold mb-4\">Schedule Pre-Production Meeting</h3>\n            <div>\n              <label className=\"block text-xs text-zinc-400 mb-1\">Meeting Time</label>\n              <input\n                type=\"datetime-local\"\n                value={preProdTime}\n                onChange={(e) => setPreProdTime(e.target.value)}\n                className=\"w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n            <div className=\"flex gap-2 mt-5\">\n              <button\n                onClick={() => handleSchedulePreProd(preProdModalOpen)}\n                disabled={sendingOutreach}\n                className=\"flex-1 py-2 bg-blue-600 hover:bg-blue-500 rounded font-medium text-sm disabled:opacity-50\"\n              >\n                {sendingOutreach ? 'Scheduling...' : 'Schedule Meeting'}\n              </button>\n              <button\n                onClick={() => setPreProdModalOpen(null)}\n                disabled={sendingOutreach}\n                className=\"px-4 py-2 bg-zinc-800 hover:bg-zinc-700 rounded text-sm\"\n              >\n                Cancel\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* iMessage Confirmation Modal */}\n      {iMessageConfirmOpen && (\n        <div className=\"fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-zinc-900 rounded-xl border border-zinc-800 p-6 w-full max-w-md\">\n            <h3 className=\"text-lg font-bold mb-3\">Message Copied!</h3>\n            <p className=\"text-sm text-zinc-400 mb-4\">\n              The message has been copied to your clipboard. After you send it via iMessage, click \"Yes\" to log it in the system.\n            </p>\n            <div className=\"bg-zinc-800 p-3 rounded text-xs text-zinc-300 mb-4 max-h-32 overflow-y-auto whitespace-pre-wrap\">\n              {iMessageConfirmOpen.message}\n            </div>\n            <div className=\"flex gap-2\">\n              <button\n                onClick={() => confirmIMessageSent(iMessageConfirmOpen.talentId, iMessageConfirmOpen.type)}\n                className=\"flex-1 py-2 bg-green-600 hover:bg-green-500 rounded font-medium text-sm\"\n              >\n                Yes, I sent it\n              </button>\n              <button\n                onClick={() => setIMessageConfirmOpen(null)}\n                className=\"px-4 py-2 bg-zinc-800 hover:bg-zinc-700 rounded text-sm\"\n              >\n                Cancel\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n    <div className=\"min-h-screen bg-zinc-950 text-white\">\n      {/* Header */}\n      <div className=\"bg-zinc-900 border-b border-zinc-800 px-6 py-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-4\">\n            <div>\n              <h1 className=\"text-lg font-bold text-white flex items-center gap-2\">\n                <UserGroupIcon className=\"w-5 h-5 text-blue-400\" />\n                Commentary\n              </h1>\n              <p className=\"text-xs text-zinc-500\">\n                {competitionConfig?.eventName || compId} ·{' '}\n                {totalCount === 0\n                  ? 'No talent assigned'\n                  : `${confirmedCount}/${totalCount} confirmed`}\n              </p>\n            </div>\n          </div>\n          <Link\n            to=\"/talent\"\n            className=\"text-xs text-zinc-400 hover:text-white transition-colors flex items-center gap-1\"\n          >\n            Manage Roster\n            <ChevronRightIcon className=\"w-3 h-3\" />\n          </Link>\n        </div>\n      </div>\n\n      <div className=\"flex h-[calc(100vh-73px)]\">\n        {/* Left: Current assignments */}\n        <div className=\"flex-1 overflow-y-auto p-5 border-r border-zinc-800\">\n          <div className=\"space-y-6\">\n            {SLOT_ROLES.map(({ role, label, color }) => (\n              <div key={role}>\n                <div className={`flex items-center gap-2 mb-3 pb-2 border-b ${color.replace('border', 'border-b')}`}>\n                  <h2 className=\"text-sm font-semibold text-zinc-300\">{label}</h2>\n                  <span className=\"text-xs text-zinc-500\">({byRole[role]?.length || 0})</span>\n                </div>\n\n                {byRole[role]?.length === 0 && (\n                  <button\n                    onClick={() => setActiveRole(role)}\n                    className=\"w-full py-3 border border-dashed border-zinc-700 rounded-lg text-zinc-500 text-sm hover:border-zinc-500 hover:text-zinc-300 transition-colors flex items-center justify-center gap-2\"\n                  >\n                    <PlusIcon className=\"w-4 h-4\" />\n                    Assign {label}\n                  </button>\n                )}\n\n                <div className=\"space-y-2\">\n                  {byRole[role]?.map((assignment) => {\n                    const talent = talentList.find(t => t.id === assignment.talentId);\n                    const flowEntry = STATUS_FLOW.find(s => s.status === assignment.status);\n                    const isEditingNotes = editingNotes === assignment.talentId;\n\n                    return (\n                      <div key={assignment.talentId} className=\"bg-zinc-800 rounded-xl border border-zinc-700 p-4\">\n                        <div className=\"flex items-start justify-between gap-3\">\n                          <div className=\"flex-1 min-w-0\">\n                            <div className=\"flex items-center gap-2 mb-1\">\n                              <Link\n                                to={`/talent/${assignment.talentId}`}\n                                className=\"font-semibold text-white hover:text-blue-300 transition-colors\"\n                              >\n                                {talent?.name || assignment.talentId}\n                              </Link>\n                              <span className={`px-2 py-0.5 rounded text-xs font-medium ${getStaffStatusColor(assignment.status)}`}>\n                                {getStaffStatusLabel(assignment.status)}\n                              </span>\n                            </div>\n                            {talent && (\n                              <div className=\"flex items-center gap-3 text-xs text-zinc-400\">\n                                {talent.phone && (\n                                  <a href={`tel:${talent.phone}`} className=\"flex items-center gap-1 text-blue-400 hover:text-blue-300\">\n                                    <PhoneIcon className=\"w-3 h-3\" />\n                                    {talent.phone}\n                                  </a>\n                                )}\n                                {talent.email && (\n                                  <a href={`mailto:${talent.email}`} className=\"flex items-center gap-1 text-zinc-400 hover:text-zinc-200\">\n                                    <EnvelopeIcon className=\"w-3 h-3\" />\n                                    {talent.email}\n                                  </a>\n                                )}\n                              </div>\n                            )}\n                          </div>\n                          <button\n                            onClick={() => handleRemove(assignment.talentId, talent?.name)}\n                            className=\"text-zinc-600 hover:text-red-400 transition-colors flex-shrink-0\"\n                            title=\"Remove\"\n                          >\n                            <XMarkIcon className=\"w-4 h-4\" />\n                          </button>\n                        </div>\n\n                        {/* Workflow status buttons */}\n                        <div className=\"flex items-center gap-2 mt-3 flex-wrap\">\n                          {flowEntry?.next && (\n                            <button\n                              onClick={() => handleAdvanceStatus(assignment.talentId, assignment.status)}\n                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded text-xs font-medium transition-colors\"\n                            >\n                              <CheckIcon className=\"w-3 h-3\" />\n                              Mark as {getStaffStatusLabel(flowEntry.next)}\n                            </button>\n                          )}\n                          <button\n                            onClick={() => handleCopyBookingLink(assignment.talentId, assignment.role)}\n                            className=\"flex items-center gap-1.5 px-3 py-1.5 bg-zinc-700 hover:bg-zinc-600 rounded text-xs font-medium transition-colors\"\n                            title=\"Generate and copy booking link\"\n                          >\n                            <LinkIcon className=\"w-3 h-3\" />\n                            Copy Link\n                          </button>\n                          {assignment.status === STAFF_STATUS.INVITED && (\n                            <button\n                              onClick={() => handleDecline(assignment.talentId)}\n                              className=\"px-3 py-1.5 bg-red-900 hover:bg-red-800 rounded text-xs font-medium transition-colors\"\n                            >\n                              Mark Declined\n                            </button>\n                          )}\n                          {assignment.status === STAFF_STATUS.CONFIRMED && (\n                            <div className=\"flex items-center gap-1.5 px-2 py-1 text-xs text-zinc-500\">\n                              <span className={`w-2 h-2 rounded-full ${assignment.calendarInviteSent ? 'bg-green-500' : 'bg-zinc-600'}`} />\n                              Calendar invite\n                            </div>\n                          )}\n                        </div>\n\n                        {/* Outreach buttons */}\n                        <div className=\"border-t border-zinc-700 mt-3 pt-3\">\n                          <div className=\"text-xs font-semibold text-zinc-400 mb-2\">Outreach Actions</div>\n                          <div className=\"flex items-center gap-2 flex-wrap\">\n                            <button\n                              onClick={() => handleSendInvite(assignment.talentId, assignment.role)}\n                              disabled={sendingOutreach}\n                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-green-700 hover:bg-green-600 rounded text-xs font-medium transition-colors disabled:opacity-50\"\n                            >\n                              <PaperAirplaneIcon className=\"w-3 h-3\" />\n                              Send Invite\n                            </button>\n                            <button\n                              onClick={() => handleCopyForIMessage(assignment.talentId, 'invite', generateInviteMessage(talent, assignment.role))}\n                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-zinc-700 hover:bg-zinc-600 rounded text-xs font-medium transition-colors\"\n                              title=\"Copy invite for iMessage\"\n                            >\n                              <ClipboardDocumentIcon className=\"w-3 h-3\" />\n                              Copy for iMessage\n                            </button>\n                          </div>\n                          <div className=\"flex items-center gap-2 flex-wrap mt-2\">\n                            <button\n                              onClick={() => setBriefingModalOpen(assignment.talentId)}\n                              disabled={sendingOutreach}\n                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-purple-700 hover:bg-purple-600 rounded text-xs font-medium transition-colors disabled:opacity-50\"\n                            >\n                              <DocumentTextIcon className=\"w-3 h-3\" />\n                              Send Briefing\n                            </button>\n                            <button\n                              onClick={() => handleCopyForIMessage(assignment.talentId, 'briefing', generateBriefingMessage(talent))}\n                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-zinc-700 hover:bg-zinc-600 rounded text-xs font-medium transition-colors\"\n                              title=\"Copy briefing for iMessage\"\n                            >\n                              <ClipboardDocumentIcon className=\"w-3 h-3\" />\n                              Copy for iMessage\n                            </button>\n                          </div>\n                          <div className=\"flex items-center gap-2 flex-wrap mt-2\">\n                            <button\n                              onClick={() => handleSendCalendarInvite(assignment.talentId)}\n                              disabled={sendingOutreach}\n                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-blue-700 hover:bg-blue-600 rounded text-xs font-medium transition-colors disabled:opacity-50\"\n                            >\n                              <CalendarIcon className=\"w-3 h-3\" />\n                              Calendar Invite\n                            </button>\n                            <button\n                              onClick={() => setPreProdModalOpen(assignment.talentId)}\n                              disabled={sendingOutreach}\n                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-teal-700 hover:bg-teal-600 rounded text-xs font-medium transition-colors disabled:opacity-50\"\n                            >\n                              <CalendarIcon className=\"w-3 h-3\" />\n                              Schedule Pre-Prod\n                            </button>\n                          </div>\n                        </div>\n\n                        {/* Notes */}\n                        <div className=\"mt-2\">\n                          {isEditingNotes ? (\n                            <div className=\"flex gap-2\">\n                              <input\n                                autoFocus\n                                value={notesDraft}\n                                onChange={e => setNotesDraft(e.target.value)}\n                                placeholder=\"Add a note for this competition...\"\n                                className=\"flex-1 px-2 py-1 bg-zinc-700 border border-zinc-600 rounded text-xs text-white focus:outline-none\"\n                              />\n                              <button onClick={() => handleSaveNotes(assignment.talentId)} className=\"px-2 py-1 bg-blue-600 hover:bg-blue-500 rounded text-xs\">Save</button>\n                              <button onClick={() => setEditingNotes(null)} className=\"px-2 py-1 text-zinc-400 hover:text-white text-xs\">Cancel</button>\n                            </div>\n                          ) : (\n                            <button\n                              onClick={() => { setEditingNotes(assignment.talentId); setNotesDraft(assignment.notes || ''); }}\n                              className=\"text-xs text-zinc-500 hover:text-zinc-300 transition-colors\"\n                            >\n                              {assignment.notes ? assignment.notes : '+ Add competition note'}\n                            </button>\n                          )}\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Right: Talent search */}\n        <div className=\"w-80 flex-shrink-0 flex flex-col\">\n          <div className=\"p-4 border-b border-zinc-800\">\n            <div className=\"flex items-center gap-2 mb-3\">\n              <h2 className=\"text-sm font-semibold text-zinc-300\">Add to competition</h2>\n            </div>\n            {/* Role selector */}\n            <div className=\"flex gap-1.5 mb-3\">\n              {SLOT_ROLES.map(({ role, label }) => (\n                <button\n                  key={role}\n                  onClick={() => setActiveRole(role)}\n                  className={`flex-1 py-1.5 rounded text-xs font-medium transition-colors ${\n                    activeRole === role\n                      ? 'bg-blue-600 text-white'\n                      : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'\n                  }`}\n                >\n                  {role === 'pbp' ? 'PBP' : role === 'analyst' ? 'Analyst' : 'Producer'}\n                </button>\n              ))}\n            </div>\n            <div className=\"relative\">\n              <MagnifyingGlassIcon className=\"w-4 h-4 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"text\"\n                placeholder={`Search ${targetWagMag} talent...`}\n                value={search}\n                onChange={e => setSearch(e.target.value)}\n                className=\"w-full pl-9 pr-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto p-3 space-y-1.5\">\n            {talentLoading ? (\n              <div className=\"text-center py-8 text-zinc-500 text-sm\">Loading...</div>\n            ) : sortedAvailable.length === 0 ? (\n              <div className=\"text-center py-8 text-zinc-500 text-sm\">No talent found</div>\n            ) : (\n              sortedAvailable.map(talent => {\n                const isInterested = talent.interested && talent.interested[compId] === true;\n                return (\n                  <div\n                    key={talent.id}\n                    className=\"bg-zinc-800 hover:bg-zinc-750 border border-zinc-700 rounded-lg px-3 py-2.5 group\"\n                  >\n                    <div className=\"flex items-start gap-2\">\n                      <div className=\"flex-1 min-w-0\">\n                        <div className=\"flex items-center gap-1.5 mb-0.5\">\n                          <span className=\"text-sm font-medium text-white truncate\">{talent.name}</span>\n                          <span className={`flex-shrink-0 px-1.5 py-0.5 rounded text-xs ${getStatusColor(talent.status)}`}>\n                            {getStatusLabel(talent.status)}\n                          </span>\n                          {isInterested && (\n                            <span className=\"flex-shrink-0 px-1.5 py-0.5 rounded text-xs bg-green-900 text-green-200 flex items-center gap-1\">\n                              <CheckIcon className=\"w-2.5 h-2.5\" />\n                              Interested\n                            </span>\n                          )}\n                        </div>\n                        <div className=\"text-xs text-zinc-500 truncate\">\n                          {talent.commentaryRole}{talent.affiliation ? ` · ${talent.affiliation}` : ''}\n                        </div>\n                        {talent.phone && (\n                          <a href={`tel:${talent.phone}`} className=\"text-xs text-blue-500 hover:text-blue-400 flex items-center gap-1 mt-0.5\">\n                            <PhoneIcon className=\"w-2.5 h-2.5\" />\n                            {talent.phone}\n                          </a>\n                        )}\n                      </div>\n                      <button\n                        onClick={() => handleAssign(talent)}\n                        className=\"flex-shrink-0 p-1.5 bg-blue-600 hover:bg-blue-500 rounded transition-colors opacity-0 group-hover:opacity-100\"\n                        title={`Add as ${getRoleLabel(activeRole)}`}\n                      >\n                        <PlusIcon className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </div>\n                );\n              })\n            )}\n          </div>\n\n          <div className=\"p-3 border-t border-zinc-800\">\n            <Link\n              to=\"/talent\"\n              className=\"w-full flex items-center justify-center gap-2 py-2 bg-zinc-800 hover:bg-zinc-700 rounded-lg text-xs text-zinc-400 hover:text-white transition-colors\"\n            >\n              <UserGroupIcon className=\"w-4 h-4\" />\n              View full roster\n            </Link>\n          </div>\n        </div>\n      </div>\n    </div>\n    </>\n  );\n}\n","numLines":724,"startLine":1,"totalLines":724}}}
