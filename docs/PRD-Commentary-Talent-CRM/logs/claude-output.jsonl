n\n                onClick={handleDelete}\n                className=\"px-4 py-2 bg-red-600 hover:bg-red-500 rounded-lg text-sm font-medium transition-colors\"\n              >\n                Remove\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction Field({ label, editing, value, onChange, children, inputType = 'text' }) {\n  return (\n    <div>\n      <label className=\"block text-xs text-gray-500 mb-1\">{label}</label>\n      {editing ? (\n        <input\n          type={inputType}\n          value={value}\n          onChange={e => onChange(e.target.value)}\n          className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n        />\n      ) : (\n        <div className=\"text-sm\">{children}</div>\n      )}\n    </div>\n  );\n}\n","structuredPatch":[{"oldStart":575,"oldLines":67,"newStart":575,"newLines":154,"lines":["                 )}","               </div>"," ","-          {/* Notes */}","-          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">","-            <div className=\"flex items-center gap-2 mb-3\">","-              <ChatBubbleLeftRightIcon className=\"w-4 h-4 text-blue-400\" />","-              <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide\">Notes</h2>","-            </div>","-            {editing ? (","-              <textarea","-                value={form.notes || ''}","-                onChange={e => setForm(p => ({ ...p, notes: e.target.value }))}","-                rows={6}","-                className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500 resize-none\"","-                placeholder=\"Notes about this person...\"","-              />","-            ) : (","-              <>","-                {talent.notes ? (","-                  <pre className=\"text-x