dirname = dirname(__filename);\n    76→\n    77→const app = express();\n    78→const httpServer = createServer(app);\n    79→const io = new Server(httpServer, {\n    80→  cors: {\n    81→    origin: \"*\",\n    82→    methods: [\"GET\", \"POST\"]\n    83→  }\n    84→});\n    85→\n    86→const obs = new OBSWebSocket();\n    87→\n    88→// Configuration\n    89→const PORT = process.env.PORT || 3003;\n    90→const OBS_WEBSOCKET_URL = process.env.OBS_WEBSOCKET_URL || 'ws://localhost:4455';\n    91→const OBS_WEBSOCKET_PASSWORD = process.env.OBS_WEBSOCKET_PASSWORD || '';\n    92→\n    93→// Show State\n    94→let showState = {\n    95→  currentSegmentIndex: 0,\n    96→  currentSegment: null,\n    97→  nextSegment: null,\n    98→  isPlaying: false,\n    99→  isPaused: false,\n   100→  talentLocked: false,\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"99fd8026-bedb-44c3-8913-2fa1c74bb83f","uuid":"01bbd108-cc80-4c37-8004-8dfc1b185ba6","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/server/index.js","content":"import express from 'express';\nimport { createServer } from 'http';\nimport { Server } from 'socket.io';\nimport OBSWebSocket from 'obs-websocket-js';\nimport cors from 'cors';\nimport { readFileSync, writeFileSync, watchFile } from 'fs';\nimport { fileURLToPath } from 'url';\nimport { dirname, join } from 'path';\nimport dotenv from 'dotenv';\nimport multer from 'multer';\nimport { parse } from 'csv-parse/sync';\nimport { validateShowConfig } from './lib/showConfigSchema.js';\nimport { CameraHealthMonitor } from './lib/cameraHealth.js';\nimport { CameraRuntimeState } from './lib/cameraRuntimeState.js';\nimport { CameraFallbackManager } from './lib/cameraFallback.js';\nimport { OBSSceneGenerator } from './lib/obsSceneGenerator.js';\nimport { TimesheetEngine } from './lib/timesheetEngine.js';\nimport { getApparatusForGender } from './lib/apparatusConfig.js';\nimport productionConfigService from './lib/productionConfigService.js';\nimport configLoader from './lib/configLoader.js';\nimport { getVMPoolManager, VM_STATUS } from './lib/vmPoolManager.js';\nimport { getAWSService } from './lib/awsService.js';\nimport { getAlertService, ALERT_LEVEL, ALERT_CATEGORY } from './lib/alertService.js';\nimport { getAutoShutdownService } from './lib/autoShutdown.js';\nimport { getSelfStopService } from './lib/selfStop.js';\nimport { getOBSStateSync } from './lib/obsStateSync.js';\nimport { setupOBSRoutes } from './routes/obs.js';\nimport { getOBSConnectionManager } from './lib/obsConnectionManager.js';\nimport { DEFAULT_PRESETS } from './lib/obsAudioManager.js';\nimport { encryptStreamKey, decryptStreamKey, isEncryptedKey } from './lib/obsStreamManager.js';\nimport { mapEditorSegmentsToEngine, validateEngineSegments, diffSegments, detectDuplicateIds, deduplicateSegmentsById } from './lib/segmentMapper.js';\nimport aiSuggestionService from './lib/aiSuggestionService.js';\nimport { getOrCreateContextService, getContextService, removeContextService } from './lib/aiContextService.js';\nimport { ingestCompetitionStats, ingestTeamStats, syncStatsToConfig, snapshotStatsForCompetition, checkStaleness, parseCompetitionType, buildTeamDbKey, fetchLeagueRankings } from './lib/rtnStatsService.js';\nimport { randomUUID } from 'crypto';\nimport Anthropic from '@anthropic-ai/sdk';\nimport { sendEmail, inviteEmail, briefingEmail, reminderEmail } from './lib/gmailService.js';\nimport { createCompetitionEvent, createPreProdMeeting } from './lib/googleCalendarService.js';\n\ndotenv.config();\n\n// ============================================\n// Coordinator State Tracking\n// ============================================\nconst serverStartTime = Date.now();\nlet lastActivityTimestamp = Date.now();\nconst SERVER_VERSION = '1.0.0';\n\n/**\n * Update last activity timestamp\n * Called on API requests and socket events\n */\nfunction updateLastActivity() {\n  lastActivityTimestamp = Date.now();\n}\n\n/**\n * Get server uptime in seconds\n */\nfunction getUptime() {\n  return Math.floor((Date.now() - serverStartTime) / 1000);\n}\n\n/**\n * Get idle time in seconds\n */\nfunction getIdleTime() {\n  return Math.floor((Date.now() - lastActivityTimestamp) / 1000);\n}\n\n// Configure multer for file uploads\nconst upload = multer({ storage: multer.memoryStorage() });\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = dirname(__filename);\n\nconst app = express();\nconst httpServer = createServer(app);\nconst io = new Server(httpServer, {\n  cors: {\n    origin: \"*\",\n    methods: [\"GET\", \"POST\"]\n  }\n});\n\nconst obs = new OBSWebSocket();\n\n// Configuration\nconst PORT = process.env.PORT || 3003;\nconst OBS_WEBSOCKET_URL = process.env.OBS_WEBSOCKET_URL || 'ws://localhost:4455';\nconst OBS_WEBSOCKET_PASSWORD = process.env.OBS_WEBSOCKET_PASSWORD || '';\n\n// Show State\nlet showState = {\n  currentSegmentIndex: 0,\n  currentSegment: null,\n  nextSegment: null,\n  isPlaying: false,\n  isPaused: false,\n  talentLocked: false,","numLines":100,"startLine":1,"totalLines":7320}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0194qgN7KpGxZrjA6jgWDojR","type":"tool_result","content":"     1→import { useState, useEffect } from 'react';\n     2→import { Link, useParams, useNavigate } from 'react-router-dom';\n     3→import { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\n     4→import {\n     5→  PhoneIcon,\n     6→  EnvelopeIcon,\n     7→  PencilIcon,\n     8→  CheckIcon,\n     9→  XMarkIcon,\n    10→  TrashIcon,\n    11→  TrophyIcon,\n    12→  ChatBubbleLeftRightIcon,\n    13→} from '@heroicons/react/24/solid';\n    14→import toast from 'react-hot-toast';\n    15→\n    16→const OTHER_INTERESTS = [\n    17→  'Commentator',\n    18→  'Producer',\n    19→  'Meet Monitor',\n    20→  'Streaming / Production',\n    21→  'Social Media',\n    22→  'Creative (Broadcast Graphics, Web Design, Social Graphics, etc)',\n    23→];\n    24→\n    25→/**\n    26→ * TalentProfilePage - Full profile for a single talent person.\n    27→ * URL: /talent/:talentId\n    28→ */\n    29→export default function TalentProfilePage() {\n    30→  const { talentId } = useParams();\n    31→  const navigate = useNavigate();\n    32→  const { talents, loading, updateTalent, deleteTalent } = useTalentRoster();\n    33→\n    34→  const [editing, setEditing] = useState(false);\n    35→  const [saving, setSaving] = useState(false);\n    36→  const [form, setForm] = useState(null);\n    37→  const [confirmDelete, setConfirmDelete] = useState(false);\n    38→  const [noteText, setNoteText] = useState('');\n    39→  const [savingNote, setSavingNote] = useState(false);\n    40→\n    41→  const talent = talents[talentId];\n    42→\n    43→  useEffect(() => {\n    44→    if (talent && !form) {\n    45→      setForm({ ...talent });\n    46→    }\n    47→  }, [talent]);\n    48→\n    49→  if (loading) {\n    50→    return (\n    51→      <div className=\"min-h-screen bg-gray-900 flex items-center justify-center\">\n    52→        <div className=\"text-gray-400\">Loading...</div>\n    53→      </div>\n    54→    );\n    55→  }\n    56→\n    57→  if (!talent) {\n    58→    return (\n    59→      <div className=\"min-h-screen bg-gray-900 flex items-center justify-center\">\n    60→        <div className=\"text-center\">\n    61→          <p className=\"text-gray-400 mb-4\">Talent not found.</p>\n    62→          <Link to=\"/talent\" className=\"text-blue-400 hover:text-blue-300\">← Back to roster</Link>\n    63→        </div>\n    64→      </div>\n    65→    );\n    66→  }\n    67→\n    68→  async function handleSave() {\n    69→    setSaving(true);\n    70→    try {\n    71→      await updateTalent(talentId, form);\n    72→      setEditing(false);\n    73→      toast.success('Profile saved');\n    74→    } catch (e) {\n    75→      toast.error('Save failed');\n    76→    } finally {\n    77→      setSaving(false);\n    78→    }\n    79→  }\n    80→\n    81→  function handleCancel() {\n    82→    setForm({ ...talent });\n    83→    setEditing(false);\n    84→  }\n    85→\n    86→  async function handleDelete() {\n    87→    await deleteTalent(talentId);\n    88→    navigate('/talent');\n    89→    toast.success('Talent removed');\n    90→  }\n    91→\n    92→  async function handleAddNote(e) {\n    93→    e.preventDefault();\n    94→    if (!noteText.trim()) return;\n    95→    setSavingNote(true);\n    96→    const existing = talent.notes || '';\n    97→    const timestamp = new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });\n    98→    const updated = existing\n    99→      ? `${existing}\\n\\n[${timestamp}] ${noteText.trim()}`\n   100→      : `[${timestamp}] ${noteText.trim()}`;\n   101→    try {\n   102→      await updateTalent(talentId, { notes: updated });\n   103→      setNoteText('');\n   104→      toast.success('Note added');\n   105→\n   106→      // Parse the note for availability hints\n   107→      try {\n   108→        const response = await fetch(`https://api.commentarygraphic.com/api/talent/${talentId}/notes/parse`, {\n   109→          method: 'POST',\n   110→          headers: { 'Content-Type': 'application/json' },\n   111→          body: JSON.stringify({ noteText: noteText.trim() })\n   112→        });\n   113→        if (response.ok) {\n   114→          const parsed = await response.json();\n   115→          if (parsed.availablePeriods?.length > 0 || parsed.unavailableDates?.length > 0) {\n   116→            toast.success('Availability hints extracted');\n   117→          }\n   118→        }\n   119→      } catch (parseError) {\n   120→        console.error('Note parsing failed:', parseError);\n   121→        // Don't show error to user - parsing is a bonus feature\n   122→      }\n   123→    } catch (e) {\n   124→      toast.error('Failed to add note');\n   125→    } finally {\n   126→      setSavingNote(false);\n   127→    }\n   128→  }\n   129→\n   130→  function toggleInterest(interest) {\n   131→    const current = form.otherInterests || [];\n   132→    const updated = current.includes(interest)\n   133→      ? current.filter(i => i !== interest)\n   134→      : [...current, interest];\n   135→    setForm(p => ({ ...p, otherInterests: updated }));\n   136→  }\n   137→\n   138→  const wm = wagMagLabel(talent.wagMag);\n   139→  const history = talent.competitionHistory || [];\n   140→\n   141→  return (\n   142→    <div className=\"min-h-screen bg-gray-900 text-white\">\n   143→      {/* Header */}\n   144→      <div className=\"bg-gray-800 border-b border-gray-700 px-6 py-4\">\n   145→        <div className=\"max-w-5xl mx-auto flex items-center justify-between\">\n   146→          <div className=\"flex items-center gap-4\">\n   147→            <Link to=\"/talent\" className=\"text-gray-400 hover:text-white text-sm transition-colors\">\n   148→              ← Talent Roster\n   149→            </Link>\n   150→            <div className=\"flex items-center gap-3\">\n   151→              <h1 className=\"text-xl font-bold text-white\">{talent.name}</h1>\n   152→              <span className={`px-2 py-0.5 rounded text-xs font-medium ${getStatusColor(talent.status)}`}>\n   153→                {getStatusLabel(talent.status)}\n   154→              </span>\n   155→              {talent.wagMag && (\n   156→                <span className={`px-2 py-0.5 rounded text-xs font-medium ${wm.color}`}>\n   157→                  {wm.label}\n   158→                </span>\n   159→              )}\n   160→              {talent.canProduce && (\n   161→                <span className=\"px-2 py-0.5 bg-teal-800 text-teal-200 text-xs rounded\">Producer</span>\n   162→              )}\n   163→            </div>\n   164→          </div>\n   165→          <div className=\"flex items-center gap-2\">\n   166→            {editing ? (\n   167→              <>\n   168→                <button\n   169→                  onClick={handleCancel}\n   170→                  className=\"flex items-center gap-1.5 px-3 py-1.5 text-gray-400 hover:text-white text-sm transition-colors\"\n   171→                >\n   172→                  <XMarkIcon className=\"w-4 h-4\" />\n   173→                  Cancel\n   174→                </button>\n   175→                <button\n   176→                  onClick={handleSave}\n   177→                  disabled={saving}\n   178→                  className=\"flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded-lg text-sm font-medium transition-colors disabled:opacity-50\"\n   179→                >\n   180→                  <CheckIcon className=\"w-4 h-4\" />\n   181→                  {saving ? 'Saving...' : 'Save'}\n   182→                </button>\n   183→              </>\n   184→            ) : (\n   185→              <>\n   186→                <button\n   187→                  onClick={() => setEditing(true)}\n   188→                  className=\"flex items-center gap-1.5 px-3 py-1.5 bg-gray-700 hover:bg-gray-600 rounded-lg text-sm transition-colors\"\n   189→                >\n   190→                  <PencilIcon className=\"w-4 h-4\" />\n   191→                  Edit\n   192→                </button>\n   193→                <button\n   194→                  onClick={() => setConfirmDelete(true)}\n   195→                  className=\"flex items-center gap-1.5 px-3 py-1.5 text-red-400 hover:text-red-300 text-sm transition-colors\"\n   196→                >\n   197→                  <TrashIcon className=\"w-4 h-4\" />\n   198→                </button>\n   199→              </>\n   200→            )}\n   201→          </div>\n   202→        </div>\n   203→      </div>\n   204→\n   205→      <div className=\"max-w-5xl mx-auto px-6 py-6 grid grid-cols-3 gap-6\">\n   206→        {/* Left: Profile fields */}\n   207→        <div className=\"col-span-2 space-y-5\">\n   208→\n   209→          {/* Contact info */}\n   210→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n   211→            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Contact</h2>\n   212→            <div className=\"grid grid-cols-2 gap-4\">\n   213→              <Field label=\"Name\" editing={editing} value={form?.name || ''} onChange={v => setForm(p => ({ ...p, name: v }))}>\n   214→                <a href={`tel:${talent.name}`} className=\"font-semibold text-white\">{talent.name}</a>\n   215→              </Field>\n   216→              <Field label=\"Phone\" editing={editing} value={form?.phone || ''} onChange={v => setForm(p => ({ ...p, phone: v }))}>\n   217→                {talent.phone ? (\n   218→                  <a href={`tel:${talent.phone}`} className=\"flex items-center gap-2 text-blue-400 hover:text-blue-300\">\n   219→                    <PhoneIcon className=\"w-4 h-4\" />\n   220→                    {talent.phone}\n   221→                  </a>\n   222→                ) : <span className=\"text-gray-500 italic text-sm\">Not provided</span>}\n   223→              </Field>\n   224→              <Field label=\"Email\" editing={editing} value={form?.email || ''} onChange={v => setForm(p => ({ ...p, email: v }))}>\n   225→                {talent.email ? (\n   226→                  <a href={`mailto:${talent.email}`} className=\"flex items-center gap-2 text-blue-400 hover:text-blue-300 text-sm\">\n   227→                    <EnvelopeIcon className=\"w-4 h-4\" />\n   228→                    {talent.email}\n   229→                  </a>\n   230→                ) : <span className=\"text-gray-500 italic text-sm\">Not provided</span>}\n   231→              </Field>\n   232→              <Field label=\"Discord\" editing={editing} value={form?.discordHandle || ''} onChange={v => setForm(p => ({ ...p, discordHandle: v }))}>\n   233→                <span className=\"text-sm text-white\">{talent.discordHandle || <span className=\"text-gray-500 italic\">Not set</span>}</span>\n   234→              </Field>\n   235→            </div>\n   236→          </div>\n   237→\n   238→          {/* Commentary details */}\n   239→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n   240→            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Commentary Profile</h2>\n   241→            <div className=\"grid grid-cols-2 gap-4\">\n   242→              <div>\n   243→                <label className=\"block text-xs text-gray-500 mb-1\">WAG / MAG</label>\n   244→                {editing ? (\n   245→                  <select\n   246→                    value={form.wagMag || ''}\n   247→                    onChange={e => setForm(p => ({ ...p, wagMag: e.target.value }))}\n   248→                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   249→                  >\n   250→                    <option value=\"WAG\">WAG</option>\n   251→                    <option value=\"MAG\">MAG</option>\n   252→                    <option value=\"Both\">Both</option>\n   253→                  </select>\n   254→                ) : (\n   255→                  <span className={`inline-block px-2 py-0.5 rounded text-xs font-medium ${wm.color}`}>{wm.label}</span>\n   256→                )}\n   257→              </div>\n   258→              <div>\n   259→                <label className=\"block text-xs text-gray-500 mb-1\">Commentary Role</label>\n   260→                {editing ? (\n   261→                  <select\n   262→                    value={form.commentaryRole || ''}\n   263→                    onChange={e => setForm(p => ({ ...p, commentaryRole: e.target.value }))}\n   264→                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   265→                  >\n   266→                    <option value=\"Play by Play / Lead\">Play by Play / Lead</option>\n   267→                    <option value=\"Color / Analyst\">Color / Analyst</option>\n   268→                    <option value=\"Does not matter\">Does not matter</option>\n   269→                  </select>\n   270→                ) : (\n   271→                  <span className=\"text-sm text-white\">{talent.commentaryRole || '—'}</span>\n   272→                )}\n   273→              </div>\n   274→              <div>\n   275→                <label className=\"block text-xs text-gray-500 mb-1\">Status</label>\n   276→                {editing ? (\n   277→                  <select\n   278→                    value={form.status || ''}\n   279→                    onChange={e => setForm(p => ({ ...p, status: e.target.value }))}\n   280→                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   281→                  >\n   282→                    <option value=\"ready\">Ready</option>\n   283→                    <option value=\"has-contact\">Has Contact</option>\n   284→                    <option value=\"did-2025\">Did 2025</option>\n   285→                    <option value=\"need-info\">Need Info</option>\n   286→                  </select>\n   287→                ) : (\n   288→                  <span className={`inline-block px-2 py-0.5 rounded text-xs font-medium ${getStatusColor(talent.status)}`}>\n   289→                    {getStatusLabel(talent.status)}\n   290→                  </span>\n   291→                )}\n   292→              </div>\n   293→              <div>\n   294→                <label className=\"block text-xs text-gray-500 mb-1\">Affiliation</label>\n   295→                {editing ? (\n   296→                  <input\n   297→                    value={form.affiliation || ''}\n   298→                    onChange={e => setForm(p => ({ ...p, affiliation: e.target.value }))}\n   299→                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   300→                    placeholder=\"e.g. Stanford Alumni\"\n   301→                  />\n   302→                ) : <span className=\"text-sm text-white\">{talent.affiliation || '—'}</span>}\n   303→              </div>\n   304→              <div>\n   305→                <label className=\"block text-xs text-gray-500 mb-1\">Conference</label>\n   306→                {editing ? (\n   307→                  <input\n   308→                    value={form.conference || ''}\n   309→                    onChange={e => setForm(p => ({ ...p, conference: e.target.value }))}\n   310→                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   311→                    placeholder=\"e.g. ECAC, GEC\"\n   312→                  />\n   313→                ) : <span className=\"text-sm text-white\">{talent.conference || '—'}</span>}\n   314→              </div>\n   315→              <div className=\"flex items-center gap-2\">\n   316→                {editing ? (\n   317→                  <>\n   318→                    <input\n   319→                      id=\"editCanProduce\"\n   320→                      type=\"checkbox\"\n   321→                      checked={form.canProduce || false}\n   322→                      onChange={e => setForm(p => ({ ...p, canProduce: e.target.checked }))}\n   323→                      className=\"rounded\"\n   324→                    />\n   325→                    <label htmlFor=\"editCanProduce\" className=\"text-sm text-gray-300\">Can produce</label>\n   326→                  </>\n   327→                ) : (\n   328→                  <span className=\"text-sm text-white\">{talent.canProduce ? '✓ Can produce' : '—'}</span>\n   329→                )}\n   330→              </div>\n   331→            </div>\n   332→\n   333→            {/* Other Interests */}\n   334→            <div className=\"mt-4\">\n   335→              <label className=\"block text-xs text-gray-500 mb-2\">Other Interests</label>\n   336→              {editing ? (\n   337→                <div className=\"flex flex-wrap gap-2\">\n   338→                  {OTHER_INTERESTS.map(interest => (\n   339→                    <button\n   340→                      key={interest}\n   341→                      type=\"button\"\n   342→                      onClick={() => toggleInterest(interest)}\n   343→                      className={`px-2 py-1 rounded text-xs transition-colors ${\n   344→                        (form.otherInterests || []).includes(interest)\n   345→                          ? 'bg-blue-600 text-white'\n   346→                          : 'bg-gray-700 text-gray-300 hover:bg-gray-600'\n   347→                      }`}\n   348→                    >\n   349→                      {interest.split(' (')[0]}\n   350→                    </button>\n   351→                  ))}\n   352→                </div>\n   353→              ) : (\n   354→                <div className=\"flex flex-wrap gap-2\">\n   355→                  {(talent.otherInterests || []).length === 0\n   356→                    ? <span className=\"text-sm text-gray-500 italic\">None listed</span>\n   357→                    : (talent.otherInterests || []).map(i => (\n   358→                      <span key={i} className=\"px-2 py-0.5 bg-gray-700 text-gray-300 text-xs rounded\">\n   359→                        {i.split(' (')[0]}\n   360→                      </span>\n   361→                    ))}\n   362→                </div>\n   363→              )}\n   364→            </div>\n   365→          </div>\n   366→\n   367→          {/* Tech onboarding */}\n   368→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n   369→            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Tech & Onboarding</h2>\n   370→            <div className=\"grid grid-cols-3 gap-4\">\n   371→              <div>\n   372→                <label className=\"block text-xs text-gray-500 mb-1\">2026 Survey</label>\n   373→                {editing ? (\n   374→                  <input\n   375→                    type=\"checkbox\"\n   376→                    checked={form.surveyCompleted || false}\n   377→                    onChange={e => setForm(p => ({ ...p, surveyCompleted: e.target.checked }))}\n   378→                  />\n   379→                ) : (\n   380→                  <span className={`text-sm font-medium ${talent.surveyCompleted ? 'text-green-400' : 'text-gray-500'}`}>\n   381→                    {talent.surveyCompleted ? '✓ Completed' : 'Not completed'}\n   382→                  </span>\n   383→                )}\n   384→              </div>\n   385→              <div>\n   386→                <label className=\"block text-xs text-gray-500 mb-1\">Text Sent</label>\n   387→                {editing ? (\n   388→                  <input\n   389→                    type=\"checkbox\"\n   390→                    checked={form.textSent || false}\n   391→                    onChange={e => setForm(p => ({ ...p, textSent: e.target.checked }))}\n   392→                  />\n   393→                ) : (\n   394→                  <span className={`text-sm font-medium ${talent.textSent ? 'text-green-400' : 'text-gray-500'}`}>\n   395→                    {talent.textSent ? '✓ Sent' : 'Not sent'}\n   396→                  </span>\n   397→                )}\n   398→              </div>\n   399→              <div>\n   400→                <label className=\"block text-xs text-gray-500 mb-1\">Discord Added</label>\n   401→                {editing ? (\n   402→                  <input\n   403→                    type=\"checkbox\"\n   404→                    checked={form.discordAdded || false}\n   405→                    onChange={e => setForm(p => ({ ...p, discordAdded: e.target.checked }))}\n   406→                  />\n   407→                ) : (\n   408→                  <span className={`text-sm font-medium ${talent.discordAdded ? 'text-green-400' : 'text-gray-500'}`}>\n   409→                    {talent.discordAdded ? '✓ Added' : 'Not added'}\n   410→                  </span>\n   411→                )}\n   412→              </div>\n   413→              <div>\n   414→                <label className=\"block text-xs text-gray-500 mb-1\">Headphones</label>\n   415→                <span className=\"text-sm text-white\">{talent.hasHeadphones ? 'Yes' : '—'}</span>\n   416→              </div>\n   417→              <div>\n   418→                <label className=\"block text-xs text-gray-500 mb-1\">Upload / Download</label>\n   419→                <span className=\"text-sm text-white\">\n   420→                  {talent.internetUploadMbps ? `${talent.internetUploadMbps} / ${talent.internetDownloadMbps || '?'} Mbps` : '—'}\n   421→                </span>\n   422→              </div>\n   423→            </div>\n   424→          </div>\n   425→\n   426→          {/* Social links */}\n   427→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n   428→            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Social / Discovery</h2>\n   429→            <div className=\"grid grid-cols-2 gap-4\">\n   430→              <Field label=\"LinkedIn\" editing={editing} value={form?.linkedInUrl || ''} onChange={v => setForm(p => ({ ...p, linkedInUrl: v }))} inputType=\"url\">\n   431→                {talent.linkedInUrl\n   432→                  ? <a href={talent.linkedInUrl} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-blue-400 hover:text-blue-300 text-sm truncate\">{talent.linkedInUrl}</a>\n   433→                  : <span className=\"text-gray-500 italic text-sm\">Not found</span>}\n   434→              </Field>\n   435→              <Field label=\"Instagram\" editing={editing} value={form?.instagramUrl || ''} onChange={v => setForm(p => ({ ...p, instagramUrl: v }))} inputType=\"url\">\n   436→                {talent.instagramUrl\n   437→                  ? <a href={talent.instagramUrl} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-blue-400 hover:text-blue-300 text-sm truncate\">{talent.instagramUrl}</a>\n   438→                  : <span className=\"text-gray-500 italic text-sm\">Not found</span>}\n   439→              </Field>\n   440→              <div className=\"col-span-2\">\n   441→                <label className=\"block text-xs text-gray-500 mb-1\">Discovered From</label>\n   442→                <span className=\"text-sm text-gray-400\">{talent.discoveredFrom || 'manual'}</span>\n   443→              </div>\n   444→            </div>\n   445→          </div>\n   446→        </div>\n   447→\n   448→        {/* Right: History + Notes */}\n   449→        <div className=\"space-y-5\">\n   450→          {/* Competition history */}\n   451→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n   452→            <div className=\"flex items-center gap-2 mb-4\">\n   453→              <TrophyIcon className=\"w-4 h-4 text-yellow-400\" />\n   454→              <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide\">\n   455→                History\n   456→              </h2>\n   457→              <span className=\"ml-auto text-xs text-gray-500\">{talent.totalCompetitions || history.length} events</span>\n   458→            </div>\n   459→            {history.length === 0 ? (\n   460→              <p className=\"text-xs text-gray-500 italic\">No competitions recorded yet.</p>\n   461→            ) : (\n   462→              <div className=\"space-y-2 max-h-64 overflow-y-auto\">\n   463→                {[...history].reverse().map((h, i) => (\n   464→                  <div key={i} className=\"text-xs border-b border-gray-700 pb-2 last:border-0\">\n   465→                    <div className=\"text-white font-medium\">{h.eventName || h.compId}</div>\n   466→                    <div className=\"text-gray-400\">{h.date} · {h.role}</div>\n   467→                  </div>\n   468→                ))}\n   469→              </div>\n   470→            )}\n   471→          </div>\n   472→\n   473→          {/* Notes */}\n   474→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n   475→            <div className=\"flex items-center gap-2 mb-3\">\n   476→              <ChatBubbleLeftRightIcon className=\"w-4 h-4 text-blue-400\" />\n   477→              <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide\">Notes</h2>\n   478→            </div>\n   479→            {editing ? (\n   480→              <textarea\n   481→                value={form.notes || ''}\n   482→                onChange={e => setForm(p => ({ ...p, notes: e.target.value }))}\n   483→                rows={6}\n   484→                className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500 resize-none\"\n   485→                placeholder=\"Notes about this person...\"\n   486→              />\n   487→            ) : (\n   488→              <>\n   489→                {talent.notes ? (\n   490→                  <pre className=\"text-xs text-gray-300 whitespace-pre-wrap font-sans max-h-48 overflow-y-auto mb-3\">\n   491→                    {talent.notes}\n   492→                  </pre>\n   493→                ) : (\n   494→                  <p className=\"text-xs text-gray-500 italic mb-3\">No notes yet.</p>\n   495→                )}\n   496→                <form onSubmit={handleAddNote} className=\"flex gap-2\">\n   497→                  <input\n   498→                    value={noteText}\n   499→                    onChange={e => setNoteText(e.target.value)}\n   500→                    placeholder=\"Add a note...\"\n   501→                    className=\"flex-1 px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   502→                  />\n   503→                  <button\n   504→                    type=\"submit\"\n   505→                    disabled={savingNote || !noteText.trim()}\n   506→                    className=\"px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded text-sm disabled:opacity-50 transition-colors\"\n   507→                  >\n   508→                    Add\n   509→                  </button>\n   510→                </form>\n   511→                <p className=\"text-xs text-gray-600 mt-1.5\">Notes are timestamped automatically.</p>\n   512→\n   513→                {/* Parsed availability hints */}\n   514→                {(talent.parsedAvailability?.availablePeriods?.length > 0 || talent.parsedAvailability?.unavailableDates?.length > 0) && (\n   515→                  <div className=\"mt-3 pt-3 border-t border-gray-700\">\n   516→                    <p className=\"text-xs text-gray-500 mb-2\">Extracted availability:</p>\n   517→                    <div className=\"flex flex-wrap gap-1.5\">\n   518→                      {(talent.parsedAvailability?.availablePeriods || []).map((period, i) => (\n   519→                        <span key={`avail-${i}`} className=\"px-2 py-0.5 bg-green-900/30 text-green-400 text-xs rounded border border-green-700\">\n   520→                          Available: {period}\n   521→                        </span>\n   522→                      ))}\n   523→                      {(talent.parsedAvailability?.unavailableDates || []).map((date, i) => (\n   524→                        <span key={`busy-${i}`} className=\"px-2 py-0.5 bg-red-900/30 text-red-400 text-xs rounded border border-red-700\">\n   525→                          Busy: {date}\n   526→                        </span>\n   527→                      ))}\n   528→                    </div>\n   529→                  </div>\n   530→                )}\n   531→              </>\n   532→            )}\n   533→          </div>\n   534→        </div>\n   535→      </div>\n   536→\n   537→      {/* Delete confirmation */}\n   538→      {confirmDelete && (\n   539→        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n   540→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-6 max-w-sm w-full\">\n   541→            <h3 className=\"text-lg font-semibold text-white mb-2\">Remove {talent.name}?</h3>\n   542→            <p className=\"text-gray-400 text-sm mb-5\">This will permanently delete their profile and all associated data.</p>\n   543→            <div className=\"flex justify-end gap-3\">\n   544→              <button onClick={() => setConfirmDelete(false)} className=\"px-4 py-2 text-gray-400 hover:text-white text-sm\">\n   545→                Cancel\n   546→              </button>\n   547→              <button\n   548→                onClick={handleDelete}\n   549→                className=\"px-4 py-2 bg-red-600 hover:bg-red-500 rounded-lg text-sm font-medium transition-colors\"\n   550→              >\n   551→                Remove\n   552→              </button>\n   553→            </div>\n   554→          </div>\n   555→        </div>\n   556→      )}\n   557→    </div>\n   558→  );\n   559→}\n   560→\n   561→function Field({ label, editing, value, onChange, children, inputType = 'text' }) {\n   562→  return (\n   563→    <div>\n   564→      <label className=\"block text-xs text-gray-500 mb-1\">{label}</label>\n   565→      {editing ? (\n   566→        <input\n   567→          type={inputType}\n   568→          value={value}\n   569→          onChange={e => onChange(e.target.value)}\n   570→          className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   571→        />\n   572→      ) : (\n   573→        <div className=\"text-sm\">{children}</div>\n   574→      )}\n   575→    </div>\n   576→  );\n   577→}\n   578→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"99fd8026-bedb-44c3-8913-2fa1c74bb83f","uuid":"a8c67338-163f-487a-926d-32b590f1c9ac","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/pages/TalentProfilePage.jsx","content":"import { useState, useEffect } from 'react';\nimport { Link, useParams, useNavigate } from 'react-router-dom';\nimport { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\nimport {\n  PhoneIcon,\n  EnvelopeIcon,\n  PencilIcon,\n  CheckIcon,\n  XMarkIcon,\n  TrashIcon,\n  TrophyIcon,\n  ChatBubbleLeftRightIcon,\n} from '@heroicons/react/24/solid';\nimport toast from 'react-hot-toast';\n\nconst OTHER_INTERESTS = [\n  'Commentator',\n  'Producer',\n  'Meet Monitor',\n  'Streaming / Production',\n  'Social Media',\n  'Creative (Broadcast Graphics, Web Design, Social Graphics, etc)',\n];\n\n/**\n * TalentProfilePage - Full profile for a single talent person.\n * URL: /talent/:talentId\n */\nexport default function TalentProfilePage() {\n  const { talentId } = useParams();\n  const navigate = useNavigate();\n  const { talents, loading, updateTalent, deleteTalent } = useTalentRoster();\n\n  const [editing, setEditing] = useState(false);\n  const [saving, setSaving] = useState(false);\n  const [form, setForm] = useState(null);\n  const [confirmDelete, setConfirmDelete] = useState(false);\n  const [noteText, setNoteText] = useState('');\n  const [savingNote, setSavingNote] = useState(false);\n\n  const talent = talents[talentId];\n\n  useEffect(() => {\n    if (talent && !form) {\n      setForm({ ...talent });\n    }\n  }, [talent]);\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-gray-900 flex items-center justify-center\">\n        <div className=\"text-gray-400\">Loading...</div>\n      </div>\n    );\n  }\n\n  if (!talent) {\n    return (\n      <div className=\"min-h-screen bg-gray-900 flex items-center justify-center\">\n        <div className=\"text-center\">\n          <p className=\"text-gray-400 mb-4\">Talent not found.</p>\n          <Link to=\"/talent\" className=\"text-blue-400 hover:text-blue-300\">← Back to roster</Link>\n        </div>\n      </div>\n    );\n  }\n\n  async function handleSave() {\n    setSaving(true);\n    try {\n      await updateTalent(talentId, form);\n      setEditing(false);\n      toast.success('Profile saved');\n    } catch (e) {\n      toast.error('Save failed');\n    } finally {\n      setSaving(false);\n    }\n  }\n\n  function handleCancel() {\n    setForm({ ...talent });\n    setEditing(false);\n  }\n\n  async function handleDelete() {\n    await deleteTalent(talentId);\n    navigate('/talent');\n    toast.success('Talent removed');\n  }\n\n  async function handleAddNote(e) {\n    e.preventDefault();\n    if (!noteText.trim()) return;\n    setSavingNote(true);\n    const existing = talent.notes || '';\n    const timestamp = new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });\n    const updated = existing\n      ? `${existing}\\n\\n[${timestamp}] ${noteText.trim()}`\n      : `[${timestamp}] ${noteText.trim()}`;\n    try {\n      await updateTalent(talentId, { notes: updated });\n      setNoteText('');\n      toast.success('Note added');\n\n      // Parse the note for availability hints\n      try {\n        const response = await fetch(`https://api.commentarygraphic.com/api/talent/${talentId}/notes/parse`, {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ noteText: noteText.trim() })\n        });\n        if (response.ok) {\n          const parsed = await response.json();\n          if (parsed.availablePeriods?.length > 0 || parsed.unavailableDates?.length > 0) {\n            toast.success('Availability hints extracted');\n          }\n        }\n      } catch (parseError) {\n        console.error('Note parsing failed:', parseError);\n        // Don't show error to user - parsing is a bonus feature\n      }\n    } catch (e) {\n      toast.error('Failed to add note');\n    } finally {\n      setSavingNote(false);\n    }\n  }\n\n  function toggleInterest(interest) {\n    const current = form.otherInterests || [];\n    const updated = current.includes(interest)\n      ? current.filter(i => i !== interest)\n      : [...current, interest];\n    setForm(p => ({ ...p, otherInterests: updated }));\n  }\n\n  const wm = wagMagLabel(talent.wagMag);\n  const history = talent.competitionHistory || [];\n\n  return (\n    <div className=\"min-h-screen bg-gray-900 text-white\">\n      {/* Header */}\n      <div className=\"bg-gray-800 border-b border-gray-700 px-6 py-4\">\n        <div className=\"max-w-5xl mx-auto flex items-center justify-between\">\n          <div className=\"flex items-center gap-4\">\n            <Link to=\"/talent\" className=\"text-gray-400 hover:text-white text-sm transition-colors\">\n              ← Talent Roster\n            </Link>\n            <div className=\"flex items-center gap-3\">\n              <h1 className=\"text-xl font-bold text-white\">{talent.name}</h1>\n              <span className={`px-2 py-0.5 rounded text-xs font-medium ${getStatusColor(talent.status)}`}>\n                {getStatusLabel(talent.status)}\n              </span>\n              {talent.wagMag && (\n                <span className={`px-2 py-0.5 rounded text-xs font-medium ${wm.color}`}>\n                  {wm.label}\n                </span>\n              )}\n              {talent.canProduce && (\n                <span className=\"px-2 py-0.5 bg-teal-800 text-teal-200 text-xs rounded\">Producer</span>\n              )}\n            </div>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            {editing ? (\n              <>\n                <button\n                  onClick={handleCancel}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 text-gray-400 hover:text-white text-sm transition-colors\"\n                >\n                  <XMarkIcon className=\"w-4 h-4\" />\n                  Cancel\n                </button>\n                <button\n                  onClick={handleSave}\n                  disabled={saving}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded-lg text-sm font-medium transition-colors disabled:opacity-50\"\n                >\n                  <CheckIcon className=\"w-4 h-4\" />\n                  {saving ? 'Saving...' : 'Save'}\n                </button>\n              </>\n            ) : (\n              <>\n                <button\n                  onClick={() => setEditing(true)}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 bg-gray-700 hover:bg-gray-600 rounded-lg text-sm transition-colors\"\n                >\n                  <PencilIcon className=\"w-4 h-4\" />\n                  Edit\n                </button>\n                <button\n                  onClick={() => setConfirmDelete(true)}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 text-red-400 hover:text-red-300 text-sm transition-colors\"\n                >\n                  <TrashIcon className=\"w-4 h-4\" />\n                </button>\n              </>\n            )}\n          </div>\n        </div>\n      </div>\n\n      <div className=\"max-w-5xl mx-auto px-6 py-6 grid grid-cols-3 gap-6\">\n        {/* Left: Profile fields */}\n        <div className=\"col-span-2 space-y-5\">\n\n          {/* Contact info */}\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Contact</h2>\n            <div className=\"grid grid-cols-2 gap-4\">\n              <Field label=\"Name\" editing={editing} value={form?.name || ''} onChange={v => setForm(p => ({ ...p, name: v }))}>\n                <a href={`tel:${talent.name}`} className=\"font-semibold text-white\">{talent.name}</a>\n              </Field>\n              <Field label=\"Phone\" editing={editing} value={form?.phone || ''} onChange={v => setForm(p => ({ ...p, phone: v }))}>\n                {talent.phone ? (\n                  <a href={`tel:${talent.phone}`} className=\"flex items-center gap-2 text-blue-400 hover:text-blue-300\">\n                    <PhoneIcon className=\"w-4 h-4\" />\n                    {talent.phone}\n                  </a>\n                ) : <span className=\"text-gray-500 italic text-sm\">Not provided</span>}\n              </Field>\n              <Field label=\"Email\" editing={editing} value={form?.email || ''} onChange={v => setForm(p => ({ ...p, email: v }))}>\n                {talent.email ? (\n                  <a href={`mailto:${talent.email}`} className=\"flex items-center gap-2 text-blue-400 hover:text-blue-300 text-sm\">\n                    <EnvelopeIcon className=\"w-4 h-4\" />\n                    {talent.email}\n                  </a>\n                ) : <span className=\"text-gray-500 italic text-sm\">Not provided</span>}\n              </Field>\n              <Field label=\"Discord\" editing={editing} value={form?.discordHandle || ''} onChange={v => setForm(p => ({ ...p, discordHandle: v }))}>\n                <span className=\"text-sm text-white\">{talent.discordHandle || <span className=\"text-gray-500 italic\">Not set</span>}</span>\n              </Field>\n            </div>\n          </div>\n\n          {/* Commentary details */}\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Commentary Profile</h2>\n            <div className=\"grid grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">WAG / MAG</label>\n                {editing ? (\n                  <select\n                    value={form.wagMag || ''}\n                    onChange={e => setForm(p => ({ ...p, wagMag: e.target.value }))}\n                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                  >\n                    <option value=\"WAG\">WAG</option>\n                    <option value=\"MAG\">MAG</option>\n                    <option value=\"Both\">Both</option>\n                  </select>\n                ) : (\n                  <span className={`inline-block px-2 py-0.5 rounded text-xs font-medium ${wm.color}`}>{wm.label}</span>\n                )}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Commentary Role</label>\n                {editing ? (\n                  <select\n                    value={form.commentaryRole || ''}\n                    onChange={e => setForm(p => ({ ...p, commentaryRole: e.target.value }))}\n                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                  >\n                    <option value=\"Play by Play / Lead\">Play by Play / Lead</option>\n                    <option value=\"Color / Analyst\">Color / Analyst</option>\n                    <option value=\"Does not matter\">Does not matter</option>\n                  </select>\n                ) : (\n                  <span className=\"text-sm text-white\">{talent.commentaryRole || '—'}</span>\n                )}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Status</label>\n                {editing ? (\n                  <select\n                    value={form.status || ''}\n                    onChange={e => setForm(p => ({ ...p, status: e.target.value }))}\n                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                  >\n                    <option value=\"ready\">Ready</option>\n                    <option value=\"has-contact\">Has Contact</option>\n                    <option value=\"did-2025\">Did 2025</option>\n                    <option value=\"need-info\">Need Info</option>\n                  </select>\n                ) : (\n                  <span className={`inline-block px-2 py-0.5 rounded text-xs font-medium ${getStatusColor(talent.status)}`}>\n                    {getStatusLabel(talent.status)}\n                  </span>\n                )}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Affiliation</label>\n                {editing ? (\n                  <input\n                    value={form.affiliation || ''}\n                    onChange={e => setForm(p => ({ ...p, affiliation: e.target.value }))}\n                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                    placeholder=\"e.g. Stanford Alumni\"\n                  />\n                ) : <span className=\"text-sm text-white\">{talent.affiliation || '—'}</span>}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Conference</label>\n                {editing ? (\n                  <input\n                    value={form.conference || ''}\n                    onChange={e => setForm(p => ({ ...p, conference: e.target.value }))}\n                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                    placeholder=\"e.g. ECAC, GEC\"\n                  />\n                ) : <span className=\"text-sm text-white\">{talent.conference || '—'}</span>}\n              </div>\n              <div className=\"flex items-center gap-2\">\n                {editing ? (\n                  <>\n                    <input\n                      id=\"editCanProduce\"\n                      type=\"checkbox\"\n                      checked={form.canProduce || false}\n                      onChange={e => setForm(p => ({ ...p, canProduce: e.target.checked }))}\n                      className=\"rounded\"\n                    />\n                    <label htmlFor=\"editCanProduce\" className=\"text-sm text-gray-300\">Can produce</label>\n                  </>\n                ) : (\n                  <span className=\"text-sm text-white\">{talent.canProduce ? '✓ Can produce' : '—'}</span>\n                )}\n              </div>\n            </div>\n\n            {/* Other Interests */}\n            <div className=\"mt-4\">\n              <label className=\"block text-xs text-gray-500 mb-2\">Other Interests</label>\n              {editing ? (\n                <div className=\"flex flex-wrap gap-2\">\n                  {OTHER_INTERESTS.map(interest => (\n                    <button\n                      key={interest}\n                      type=\"button\"\n                      onClick={() => toggleInterest(interest)}\n                      className={`px-2 py-1 rounded text-xs transition-colors ${\n                        (form.otherInterests || []).includes(interest)\n                          ? 'bg-blue-600 text-white'\n                          : 'bg-gray-700 text-gray-300 hover:bg-gray-600'\n                      }`}\n                    >\n                      {interest.split(' (')[0]}\n                    </button>\n                  ))}\n                </div>\n              ) : (\n                <div className=\"flex flex-wrap gap-2\">\n                  {(talent.otherInterests || []).length === 0\n                    ? <span className=\"text-sm text-gray-500 italic\">None listed</span>\n                    : (talent.otherInterests || []).map(i => (\n                      <span key={i} className=\"px-2 py-0.5 bg-gray-700 text-gray-300 text-xs rounded\">\n                        {i.split(' (')[0]}\n                      </span>\n                    ))}\n                </div>\n              )}\n            </div>\n          </div>\n\n          {/* Tech onboarding */}\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Tech & Onboarding</h2>\n            <div className=\"grid grid-cols-3 gap-4\">\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">2026 Survey</label>\n                {editing ? (\n                  <input\n                    type=\"checkbox\"\n                    checked={form.surveyCompleted || false}\n                    onChange={e => setForm(p => ({ ...p, surveyCompleted: e.target.checked }))}\n                  />\n                ) : (\n                  <span className={`text-sm font-medium ${talent.surveyCompleted ? 'text-green-400' : 'text-gray-500'}`}>\n                    {talent.surveyCompleted ? '✓ Completed' : 'Not completed'}\n                  </span>\n                )}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Text Sent</label>\n                {editing ? (\n                  <input\n                    type=\"checkbox\"\n                    checked={form.textSent || false}\n                    onChange={e => setForm(p => ({ ...p, textSent: e.target.checked }))}\n                  />\n                ) : (\n                  <span className={`text-sm font-medium ${talent.textSent ? 'text-green-400' : 'text-gray-500'}`}>\n                    {talent.textSent ? '✓ Sent' : 'Not sent'}\n                  </span>\n                )}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Discord Added</label>\n                {editing ? (\n                  <input\n                    type=\"checkbox\"\n                    checked={form.discordAdded || false}\n                    onChange={e => setForm(p => ({ ...p, discordAdded: e.target.checked }))}\n                  />\n                ) : (\n                  <span className={`text-sm font-medium ${talent.discordAdded ? 'text-green-400' : 'text-gray-500'}`}>\n                    {talent.discordAdded ? '✓ Added' : 'Not added'}\n                  </span>\n                )}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Headphones</label>\n                <span className=\"text-sm text-white\">{talent.hasHeadphones ? 'Yes' : '—'}</span>\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Upload / Download</label>\n                <span className=\"text-sm text-white\">\n                  {talent.internetUploadMbps ? `${talent.internetUploadMbps} / ${talent.internetDownloadMbps || '?'} Mbps` : '—'}\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* Social links */}\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Social / Discovery</h2>\n            <div className=\"grid grid-cols-2 gap-4\">\n              <Field label=\"LinkedIn\" editing={editing} value={form?.linkedInUrl || ''} onChange={v => setForm(p => ({ ...p, linkedInUrl: v }))} inputType=\"url\">\n                {talent.linkedInUrl\n                  ? <a href={talent.linkedInUrl} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-blue-400 hover:text-blue-300 text-sm truncate\">{talent.linkedInUrl}</a>\n                  : <span className=\"text-gray-500 italic text-sm\">Not found</span>}\n              </Field>\n              <Field label=\"Instagram\" editing={editing} value={form?.instagramUrl || ''} onChange={v => setForm(p => ({ ...p, instagramUrl: v }))} inputType=\"url\">\n                {talent.instagramUrl\n                  ? <a href={talent.instagramUrl} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-blue-400 hover:text-blue-300 text-sm truncate\">{talent.instagramUrl}</a>\n                  : <span className=\"text-gray-500 italic text-sm\">Not found</span>}\n              </Field>\n              <div className=\"col-span-2\">\n                <label className=\"block text-xs text-gray-500 mb-1\">Discovered From</label>\n                <span className=\"text-sm text-gray-400\">{talent.discoveredFrom || 'manual'}</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Right: History + Notes */}\n        <div className=\"space-y-5\">\n          {/* Competition history */}\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n            <div className=\"flex items-center gap-2 mb-4\">\n              <TrophyIcon className=\"w-4 h-4 text-yellow-400\" />\n              <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide\">\n                History\n              </h2>\n              <span className=\"ml-auto text-xs text-gray-500\">{talent.totalCompetitions || history.length} events</span>\n            </div>\n            {history.length === 0 ? (\n              <p className=\"text-xs text-gray-500 italic\">No competitions recorded yet.</p>\n            ) : (\n              <div className=\"space-y-2 max-h-64 overflow-y-auto\">\n                {[...history].reverse().map((h, i) => (\n                  <div key={i} className=\"text-xs border-b border-gray-700 pb-2 last:border-0\">\n                    <div className=\"text-white font-medium\">{h.eventName || h.compId}</div>\n                    <div className=\"text-gray-400\">{h.date} · {h.role}</div>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Notes */}\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n            <div className=\"flex items-center gap-2 mb-3\">\n              <ChatBubbleLeftRightIcon className=\"w-4 h-4 text-blue-400\" />\n              <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide\">Notes</h2>\n            </div>\n            {editing ? (\n              <textarea\n                value={form.notes || ''}\n                onChange={e => setForm(p => ({ ...p, notes: e.target.value }))}\n                rows={6}\n                className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500 resize-none\"\n                placeholder=\"Notes about this person...\"\n              />\n            ) : (\n              <>\n                {talent.notes ? (\n                  <pre className=\"text-xs text-gray-300 whitespace-pre-wrap font-sans max-h-48 overflow-y-auto mb-3\">\n                    {talent.notes}\n                  </pre>\n                ) : (\n                  <p className=\"text-xs text-gray-500 italic mb-3\">No notes yet.</p>\n                )}\n                <form onSubmit={handleAddNote} className=\"flex gap-2\">\n                  <input\n                    value={noteText}\n                    onChange={e => setNoteText(e.target.value)}\n                    placeholder=\"Add a note...\"\n                    className=\"flex-1 px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                  />\n                  <button\n                    type=\"submit\"\n                    disabled={savingNote || !noteText.trim()}\n                    className=\"px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded text-sm disabled:opacity-50 transition-colors\"\n                  >\n                    Add\n                  </button>\n                </form>\n                <p className=\"text-xs text-gray-600 mt-1.5\">Notes are timestamped automatically.</p>\n\n                {/* Parsed availability hints */}\n                {(talent.parsedAvailability?.availablePeriods?.length > 0 || talent.parsedAvailability?.unavailableDates?.length > 0) && (\n                  <div className=\"mt-3 pt-3 border-t border-gray-700\">\n                    <p className=\"text-xs text-gray-500 mb-2\">Extracted availability:</p>\n                    <div className=\"flex flex-wrap gap-1.5\">\n                      {(talent.parsedAvailability?.availablePeriods || []).map((period, i) => (\n                        <span key={`avail-${i}`} className=\"px-2 py-0.5 bg-green-900/30 text-green-400 text-xs rounded border border-green-700\">\n                          Available: {period}\n                        </span>\n                      ))}\n                      {(talent.parsedAvailability?.unavailableDates || []).map((date, i) => (\n                        <span key={`busy-${i}`} className=\"px-2 py-0.5 bg-red-900/30 text-red-400 text-xs rounded border border-red-700\">\n                          Busy: {date}\n                        </span>\n                      ))}\n                    </div>\n                  </div>\n                )}\n              </>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Delete confirmation */}\n      {confirmDelete && (\n        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-6 max-w-sm w-full\">\n            <h3 className=\"text-lg font-semibold text-white mb-2\">Remove {talent.name}?</h3>\n            <p className=\"text-gray-400 text-sm mb-5\">This will permanently delete their profile and all associated data.</p>\n            <div className=\"flex justify-end gap-3\">\n              <button onClick={() => setConfirmDelete(false)} className=\"px-4 py-2 text-gray-400 hover:text-white text-sm\">\n                Cancel\n              </button>\n              <button\n                onClick={handleDelete}\n                className=\"px-4 py-2 bg-red-600 hover:bg-red-500 rounded-lg text-sm font-medium transition-colors\"\n              >\n                Remove\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction Field({ label, editing, value, onChange, children, inputType = 'text' }) {\n  return (\n    <div>\n      <label className=\"block text-xs text-gray-500 mb-1\">{label}</label>\n      {editing ? (\n        <input\n          type={inputType}\n          value={value}\n          onChange={e => onChange(e.target.value)}\n          className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n        />\n      ) : (\n        <div className=\"text-sm\">{children}</div>\n      )}\n    </div>\n  );\n}\n","numLines":578,"startLine":1,"totalLines":578}}}
