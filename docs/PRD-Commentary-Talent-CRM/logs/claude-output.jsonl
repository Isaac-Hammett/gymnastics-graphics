{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012zQVhjjy6VzwPsR35gvffu","type":"tool_result","content":"     1→import { useState, useEffect } from 'react';\n     2→import { Link, useParams, useNavigate } from 'react-router-dom';\n     3→import { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\n     4→import {\n     5→  PhoneIcon,\n     6→  EnvelopeIcon,\n     7→  PencilIcon,\n     8→  CheckIcon,\n     9→  XMarkIcon,\n    10→  TrashIcon,\n    11→  TrophyIcon,\n    12→  ChatBubbleLeftRightIcon,\n    13→} from '@heroicons/react/24/solid';\n    14→import toast from 'react-hot-toast';\n    15→\n    16→const OTHER_INTERESTS = [\n    17→  'Commentator',\n    18→  'Producer',\n    19→  'Meet Monitor',\n    20→  'Streaming / Production',\n    21→  'Social Media',\n    22→  'Creative (Broadcast Graphics, Web Design, Social Graphics, etc)',\n    23→];\n    24→\n    25→/**\n    26→ * TalentProfilePage - Full profile for a single talent person.\n    27→ * URL: /talent/:talentId\n    28→ */\n    29→export default function TalentProfilePage() {\n    30→  const { talentId } = useParams();\n    31→  const navigate = useNavigate();\n    32→  const { talents, loading, updateTalent, deleteTalent } = useTalentRoster();\n    33→\n    34→  const [editing, setEditing] = useState(false);\n    35→  const [saving, setSaving] = useState(false);\n    36→  const [form, setForm] = useState(null);\n    37→  const [confirmDelete, setConfirmDelete] = useState(false);\n    38→  const [noteText, setNoteText] = useState('');\n    39→  const [savingNote, setSavingNote] = useState(false);\n    40→\n    41→  const talent = talents[talentId];\n    42→\n    43→  useEffect(() => {\n    44→    if (talent && !form) {\n    45→      setForm({ ...talent });\n    46→    }\n    47→  }, [talent]);\n    48→\n    49→  if (loading) {\n    50→    return (\n    51→      <div className=\"min-h-screen bg-gray-900 flex items-center justify-center\">\n    52→        <div className=\"text-gray-400\">Loading...</div>\n    53→      </div>\n    54→    );\n    55→  }\n    56→\n    57→  if (!talent) {\n    58→    return (\n    59→      <div className=\"min-h-screen bg-gray-900 flex items-center justify-center\">\n    60→        <div className=\"text-center\">\n    61→          <p className=\"text-gray-400 mb-4\">Talent not found.</p>\n    62→          <Link to=\"/talent\" className=\"text-blue-400 hover:text-blue-300\">← Back to roster</Link>\n    63→        </div>\n    64→      </div>\n    65→    );\n    66→  }\n    67→\n    68→  async function handleSave() {\n    69→    setSaving(true);\n    70→    try {\n    71→      await updateTalent(talentId, form);\n    72→      setEditing(false);\n    73→      toast.success('Profile saved');\n    74→    } catch (e) {\n    75→      toast.error('Save failed');\n    76→    } finally {\n    77→      setSaving(false);\n    78→    }\n    79→  }\n    80→\n    81→  function handleCancel() {\n    82→    setForm({ ...talent });\n    83→    setEditing(false);\n    84→  }\n    85→\n    86→  async function handleDelete() {\n    87→    await deleteTalent(talentId);\n    88→    navigate('/talent');\n    89→    toast.success('Talent removed');\n    90→  }\n    91→\n    92→  async function handleAddNote(e) {\n    93→    e.preventDefault();\n    94→    if (!noteText.trim()) return;\n    95→    setSavingNote(true);\n    96→    const existing = talent.notes || '';\n    97→    const timestamp = new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });\n    98→    const updated = existing\n    99→      ? `${existing}\\n\\n[${timestamp}] ${noteText.trim()}`\n   100→      : `[${timestamp}] ${noteText.trim()}`;\n   101→    try {\n   102→      await updateTalent(talentId, { notes: updated });\n   103→      setNoteText('');\n   104→      toast.success('Note added');\n   105→    } catch (e) {\n   106→      toast.error('Failed to add note');\n   107→    } finally {\n   108→      setSavingNote(false);\n   109→    }\n   110→  }\n   111→\n   112→  function toggleInterest(interest) {\n   113→    const current = form.otherInterests || [];\n   114→    const updated = current.includes(interest)\n   115→      ? current.filter(i => i !== interest)\n   116→      : [...current, interest];\n   117→    setForm(p => ({ ...p, otherInterests: updated }));\n   118→  }\n   119→\n   120→  const wm = wagMagLabel(talent.wagMag);\n   121→  const history = talent.competitionHistory || [];\n   122→\n   123→  return (\n   124→    <div className=\"min-h-screen bg-gray-900 text-white\">\n   125→      {/* Header */}\n   126→      <div className=\"bg-gray-800 border-b border-gray-700 px-6 py-4\">\n   127→        <div className=\"max-w-5xl mx-auto flex items-center justify-between\">\n   128→          <div className=\"flex items-center gap-4\">\n   129→            <Link to=\"/talent\" className=\"text-gray-400 hover:text-white text-sm transition-colors\">\n   130→              ← Talent Roster\n   131→            </Link>\n   132→            <div className=\"flex items-center gap-3\">\n   133→              <h1 className=\"text-xl font-bold text-white\">{talent.name}</h1>\n   134→              <span className={`px-2 py-0.5 rounded text-xs font-medium ${getStatusColor(talent.status)}`}>\n   135→                {getStatusLabel(talent.status)}\n   136→              </span>\n   137→              {talent.wagMag && (\n   138→                <span className={`px-2 py-0.5 rounded text-xs font-medium ${wm.color}`}>\n   139→                  {wm.label}\n   140→                </span>\n   141→              )}\n   142→              {talent.canProduce && (\n   143→                <span className=\"px-2 py-0.5 bg-teal-800 text-teal-200 text-xs rounded\">Producer</span>\n   144→              )}\n   145→            </div>\n   146→          </div>\n   147→          <div className=\"flex items-center gap-2\">\n   148→            {editing ? (\n   149→              <>\