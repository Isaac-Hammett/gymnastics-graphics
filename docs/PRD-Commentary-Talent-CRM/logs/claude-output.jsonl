{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JqSHfej2YLZjSX5p2A57vU","type":"tool_result","content":"     1→import { useState } from 'react';\n     2→import { Link } from 'react-router-dom';\n     3→import { useCompetition } from '../context/CompetitionContext';\n     4→import { useCommentaryStaff, getStaffStatusLabel, getStaffStatusColor, getRoleLabel, STAFF_STATUS } from '../hooks/useCommentaryStaff';\n     5→import { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\n     6→import {\n     7→  MagnifyingGlassIcon,\n     8→  PhoneIcon,\n     9→  EnvelopeIcon,\n    10→  PlusIcon,\n    11→  XMarkIcon,\n    12→  UserGroupIcon,\n    13→  ChevronRightIcon,\n    14→  CheckIcon,\n    15→  LinkIcon,\n    16→} from '@heroicons/react/24/solid';\n    17→import toast from 'react-hot-toast';\n    18→\n    19→const STATUS_FLOW = [\n    20→  { status: STAFF_STATUS.ASSIGNED, label: 'Assigned', next: STAFF_STATUS.INVITED },\n    21→  { status: STAFF_STATUS.INVITED, label: 'Invited', next: STAFF_STATUS.CONFIRMED },\n    22→  { status: STAFF_STATUS.CONFIRMED, label: 'Confirmed', next: STAFF_STATUS.BRIEFED },\n    23→  { status: STAFF_STATUS.DECLINED, label: 'Declined', next: null },\n    24→  { status: STAFF_STATUS.BRIEFED, label: 'Briefed', next: null },\n    25→];\n    26→\n    27→const SLOT_ROLES = [\n    28→  { role: 'pbp', label: 'Play by Play / Lead', color: 'border-blue-600' },\n    29→  { role: 'analyst', label: 'Color / Analyst', color: 'border-purple-600' },\n    30→  { role: 'producer', label: 'Producer', color: 'border-teal-600' },\n    31→];\n    32→\n    33→/**\n    34→ * CommentaryPage - Per-competition commentary talent management.\n    35→ * URL: /:compId/commentary\n    36→ */\n    37→export default function CommentaryPage() {\n    38→  const { compId, competitionConfig } = useCompetition();\n    39→  const { staffList, loading: staffLoading, assignTalent, updateStatus, updateNotes, removeAssignment } = useCommentaryStaff(compId);\n    40→  const { talentList, loading: talentLoading } = useTalentRoster();\n    41→\n    42→  const gender = competitionConfig?.gender || 'womens';\n    43→  const [search, setSearch] = useState('');\n    44→  const [activeRole, setActiveRole] = useState('pbp');\n    45→  const [editingNotes, setEditingNotes] = useState(null);\n    46→  const [notesDraft, setNotesDraft] = useState('');\n    47→\n    48→  // Filter talent list for the right panel — match gender and status\n    49→  const targetWagMag = gender === 'mens' ? 'MAG' : 'WAG';\n    50→  const assignedIds = new Set(staffList.map(s => s.talentId));\n    51→\n    52→  const availableTalent = talentList.filter(t => {\n    53→    // Already assigned to this competition\n    54→    if (assignedIds.has(t.id)) return false;\n    55→    // Must match gender or be \"Both\"\n    56→    if (t.wagMag && t.wagMag !== 'Both' && t.wagMag !== targetWagMag) return false;\n    57→    // Search\n    58→    if (search) {\n    59→      const q = search.toLowerCase();\n    60→      if (!t.name?.toLowerCase().includes(q) && !t.affiliation?.toLowerCase().includes(q)) return false;\n    61→    }\n    62→    return true;\n    63→  });\n    64→\n    65→  // Sort: ready first, then has-contact, then others\n    66→  const sortedAvailable = [...availableTalent].sort((a, b) => {\n    67→    const order = { ready: 0, 'has-contact': 1, 'did-2025': 2, 'need-info': 3 };\n    68→    return (order[a.status] ?? 4) - (order[b.status] ?? 4);\n    69→  });\n    70→\n    71→  async function handleAssign(talent) {\n    72→    try {\n    73→      await assignTalent(talent.id, activeRole);\n    74→      toast.success(`${talent.name} added as ${getRoleLabel(activeRole)}`);\n    75→    } catch (e) {\n    76→      toast.error('Failed to assign talent');\n    77→    }\n    78→  }\n    79→\n    80→  async function handleAdvanceStatus(talentId, currentStatus) {\n    81→    const flow = STATUS_FLOW.find(s => s.status === currentStatus);\n    82→    if (!flow?.next) return;\n    83→    try {\n    84→      await updateStatus(talentId, flow.next);\n    85→      toast.success(`Status updated to ${getStaffStatusLabel(flow.next)}`);\n    86→    } catch (e) {\n    87→      toast.error('Failed to update status');\n    88→    }\n    89→  }\n    90→\n    91→  async function handleDecline(talentId) {\n    92→    try {\n    93→      await updateStatus(talentId, STAFF_STATUS.DECLINED);\n    94→    } catch (e) {\n    95→      toast.error('Failed to update status');\n    96→    }\n    97→  }\n    98→\n    99→  async function handleRemove(talentId, name) {\n   100→    try {\n   101→      await removeAssignment(talentId);\n   102→      toast.success(`${name} removed`);\n   103→    } catch (e) {\n   104→      toast.error('Failed to remove');\n   105→    }\n   106→  }\n   107→\n   108→  async function handleSaveNotes(talentId) {\n   109→    await updateNotes(talentId, notesDraft);\n   110→    setEditingNotes(null);\n   111→    toast.success('Notes saved');\n   112→  }\n   113→\n   114→  async function handleCopyBookingLink(talentId, role) {\n   115→    try {\n   116→      const response = await fetch(`https://api.commentarygraphic.com/api/book/generate`, {\n   117→        method: 'POST',\n   118→        headers: { 'Content-Type': 'application/json' },\n   119→        body: JSON.stringify({ talentId, compId, role }),\n   120→      });\n   121→\n   122→      if (!response.ok) throw new Error('Failed to generate booking link');\n   123→\n   124→      const data = await response.json();\n   125→      await navigator.clipboard.writeText(data.url);\n   126→      toast.success('Booking link copied!', { duration: 2000 });\n   127→    } catch (e) {\n   128→      toast.error('Failed to generate link');\n   129→    }\n   130→  }\n   131→\n   132→  // Group staff by role\n   133→  const byRole = SLOT_ROLES.reduce((acc, { role }) => {\n   134→    acc[role] = staffList.filter(s => s.role === role);\n   135→    return acc;\n   136→  }, {});\n   137→\n   138→  const confirmedCount = staffList.filter(s => s.status === STAFF_STATUS.CONFIRMED || s.status === STAFF_STATUS.BRIEFED).length;\n   139→  const totalCount = staffList.length;\n   140→\n   141→  return (\n   142→    <div className=\"min-h-screen bg-zinc-950 text-white\">\n   143→      {/* Header */}\n   144→      <div className=\"bg-zinc-900 border-b border-zinc-800 px-6 py-4\">\n   145→        <div className=\"flex items-center justify-between\">\n   146→          <div className=\"flex items-center gap-4\">\n   147→            <div>\n   148→              <h1 className=\"text-lg font-bold text-white flex items-center gap-2\">\n   149→                <UserGroupIcon className=\"w-5 h-5 text-blue-400\" />\n   150→                Commentary\n   151→              </h1>\n   152→              <p className=\"text-xs text-zinc-500\">\n   153→                {competitionConfig?.eventName || compId} ·{' '}\n   154→                {totalCount === 0\n   155→                  ? 'No talent assigned'\n   156→                  : `${confirmedCount}/${totalCount} confirmed`}\n   157→              </p>\n   158→            </div>\n   159→          </div>\n   160→          <Link\n   161→            to=\"/talent\"\n   162→            className=\"text-xs text-zinc-400 hover:text-white transition-colors flex items-center gap-1\"\n   163→          >\n   164→            Manage Roster\n   165→            <ChevronRightIcon className=\"w-3 h-3\" />\n   166→          </Link>\n   167→        </div>\n   168→      </div>\n   169→\n   170→      <div className=\"flex h-[calc(100vh-73px)]\">\n   171→        {/* Left: Current assignments */}\n   172→        <div className=\"flex-1 overflow-y-auto p-5 border-r border-zinc-800\">\n   173→          <div className=\"space-y-6\">\n   174→            {SLOT_ROLES.map(({ role, label, color }) => (\n   175→              <div key={role}>\n   176→                <div className={`flex items-center gap-2 mb-3 pb-2 border-b ${color.replace('border', 'border-b')}`}>\n   177→                  <h2 className=\"text-sm font-semibold text-zinc-300\">{label}</h2>\n   178→                  <span className=\"text-xs text-zinc-500\">({byRole[role]?.length || 0})</span>\n   179→                </div>\n   180→\n   181→                {byRole[role]?.length === 0 && (\n   182→                  <button\n   183→                    onClick={() => setActiveRole(role)}\n   184→                    className=\"w-full py-3 border border-dashed border-zinc-700 rounded-lg text-zinc-500 text-sm hover:border-zinc-500 hover:text-zinc-300 transition-colors flex items-center justify-center gap-2\"\n   185→                  >\n   186→                    <PlusIcon className=\"w-4 h-4\" />\n   187→                    Assign {label}\n   188→                  </button>\n   189→                )}\n   190→\n   191→                <div className=\"space-y-2\">\n   192→                  {byRole[role]?.map((assignment) => {\n   193→                    const talent = talentList.find(t => t.id === assignment.talentId);\n   194→                    const flowEntry = STATUS_FLOW.find(s => s.status === assignment.status);\n   195→                    const isEditingNotes = editingNotes === assignment.talentId;\n   196→\n   197→                    return (\n   198→                      <div key={assignment.talentId} className=\"bg-zinc-800 rounded-xl border border-zinc-700 p-4\">\n   199→                        <div className=\"flex items-start justify-between gap-3\">\n   200→                          <div className=\"flex-1 min-w-0\">\n   201→                            <div className=\"flex items-center gap-2 mb-1\">\n   202→                              <Link\n   203→                                to={`/talent/${assignment.talentId}`}\n   204→                                className=\"font-semibold text-white hover:text-blue-300 transition-colors\"\n   205→                              >\n   206→                                {talent?.name || assignment.talentId}\n   207→                              </Link>\n   208→                              <span className={`px-2 py-0.5 rounded text-xs font-medium ${getStaffStatusColor(assignment.status)}`}>\n   209→                                {getStaffStatusLabel(assignment.status)}\n   210→                              </span>\n   211→                            </div>\n   212→                            {talent && (\n   213→                              <div className=\"flex items-center gap-3 text-xs text-zinc-400\">\n   214→                                {talent.phone && (\n   215→                                  <a href={`tel:${talent.phone}`} className=\"flex items-center gap-1 text-blue-400 hover:text-blue-300\">\n   216→                                    <PhoneIcon className=\"w-3 h-3\" />\n   217→                                    {talent.phone}\n   218→                                  </a>\n   219→                                )}\n   220→                                {talent.email && (\n   221→                                  <a href={`mailto:${talent.email}`} className=\"flex items-center gap-1 text-zinc-400 hover:text-zinc-200\">\n   222→                                    <EnvelopeIcon className=\"w-3 h-3\" />\n   223→                                    {talent.email}\n   224→                                  </a>\n   225→                                )}\n   226→                              </div>\n   227→                            )}\n   228→                          </div>\n   229→                          <button\n   230→                            onClick={() => handleRemove(assignment.talentId, talent?.name)}\n   231→                            className=\"text-zinc-600 hover:text-red-400 transition-colors flex-shrink-0\"\n   232→                            title=\"Remove\"\n   233→                          >\n   234→                            <XMarkIcon className=\"w-4 h-4\" />\n   235→                          </button>\n   236→                        </div>\n   237→\n   238→                        {/* Workflow status buttons */}\n   239→                        <div className=\"flex items-center gap-2 mt-3 flex-wrap\">\n   240→                          {flowEntry?.next && (\n   241→                            <button\n   242→                              onClick={() => handleAdvanceStatus(assignment.talentId, assignment.status)}\n   243→                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded text-xs font-medium transition-colors\"\n   244→                            >\n   245→                              <CheckIcon className=\"w-3 h-3\" />\n   246→                              Mark as {getStaffStatusLabel(flowEntry.next)}\n   247→                            </button>\n   248→                          )}\n   249→                          <button\n   250→                            onClick={() => handleCopyBookingLink(assignment.talentId, assignment.role)}\n   251→                            className=\"flex items-center gap-1.5 px-3 py-1.5 bg-zinc-700 hover:bg-zinc-600 rounded text-xs font-medium transition-colors\"\n   252→                            title=\"Generate and copy booking link\"\n   253→                          >\n   254→                            <LinkIcon className=\"w-3 h-3\" />\n   255→                            Copy Link\n   256→                          </button>\n   257→                          {assignment.status === STAFF_STATUS.INVITED && (\n   258→                            <button\n   259→                              onClick={() => handleDecline(assignment.talentId)}\n   260→                              className=\"px-3 py-1.5 bg-red-900 hover:bg-red-800 rounded text-xs font-medium transition-colors\"\n   261→                            >\n   262→                              Mark Declined\n   263→                            </button>\n   264→                          )}\n   265→                          {assignment.status === STAFF_STATUS.CONFIRMED && (\n   266→                            <div className=\"flex items-center gap-1.5 px-2 py-1 text-xs text-zinc-500\">\n   267→                              <span className={`w-2 h-2 rounded-full ${assignment.calendarInviteSent ? 'bg-green-500' : 'bg-zinc-600'}`} />\n   268→                              Calendar invite\n   269→                            </div>\n   270→                          )}\n   271→                        </div>\n   272→\n   273→                        {/* Notes */}\n   274→                        <div className=\"mt-2\">\n   275→                          {isEditingNotes ? (\n   276→                            <div className=\"flex gap-2\">\n   277→                              <input\n   278→                                autoFocus\n   279→                                value={notesDraft}\n   280→                                onChange={e => setNotesDraft(e.target.value)}\n   281→                                placeholder=\"Add a note for this competition...\"\n   282→                                className=\"flex-1 px-2 py-1 bg-zinc-700 border border-zinc-600 rounded text-xs text-white focus:outline-none\"\n   283→                              />\n   284→                              <button onClick={() => handleSaveNotes(assignment.talentId)} className=\"px-2 py-1 bg-blue-600 hover:bg-blue-500 rounded text-xs\">Save</button>\n   285→                              <button onClick={() => setEditingNotes(null)} className=\"px-2 py-1 text-zinc-400 hover:text-white text-xs\">Cancel</button>\n   286→                            </div>\n   287→                          ) : (\n   288→                            <button\n   289→                              onClick={() => { setEditingNotes(assignment.talentId); setNotesDraft(assignment.notes || ''); }}\n   290→                              className=\"text-xs text-zinc-500 hover:text-zinc-300 transition-colors\"\n   291→                            >\n   292→                              {assignment.notes ? assignment.notes : '+ Add competition note'}\n   293→                            </button>\n   294→                          )}\n   295→                        </div>\n   296→                      </div>\n   297→                    );\n   298→                  })}\n   299→                </div>\n   300→              </div>\n   301→            ))}\n   302→          </div>\n   303→        </div>\n   304→\n   305→        {/* Right: Talent search */}\n   306→        <div className=\"w-80 flex-shrink-0 flex flex-col\">\n   307→          <div className=\"p-4 border-b border-zinc-800\">\n   308→            <div className=\"flex items-center gap-2 mb-3\">\n   309→              <h2 className=\"text-sm font-semibold text-zinc-300\">Add to competition</h2>\n   310→            </div>\n   311→            {/* Role selector */}\n   312→            <div className=\"flex gap-1.5 mb-3\">\n   313→              {SLOT_ROLES.map(({ role, label }) => (\n   314→                <button\n   315→                  key={role}\n   316→                  onClick={() => setActiveRole(role)}\n   317→                  className={`flex-1 py-1.5 rounded text-xs font-medium transition-colors ${\n   318→                    activeRole === role\n   319→                      ? 'bg-blue-600 text-white'\n   320→                      : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'\n   321→                  }`}\n   322→                >\n   323→                  {role === 'pbp' ? 'PBP' : role === 'analyst' ? 'Analyst' : 'Producer'}\n   324→                </button>\n   325→              ))}\n   326→            </div>\n   327→            <div className=\"relative\">\n   328→              <MagnifyingGlassIcon className=\"w-4 h-4 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\n   329→              <input\n   330→                type=\"text\"\n   331→                placeholder={`Search ${targetWagMag} talent...`}\n   332→                value={search}\n   333→                onChange={e => setSearch(e.target.value)}\n   334→                className=\"w-full pl-9 pr-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500\"\n   335→              />\n   336→            </div>\n   337→          </div>\n   338→\n   339→          <div className=\"flex-1 overflow-y-auto p-3 space-y-1.5\">\n   340→            {talentLoading ? (\n   341→              <div className=\"text-center py-8 text-zinc-500 text-sm\">Loading...</div>\n   342→            ) : sortedAvailable.length === 0 ? (\n   343→              <div className=\"text-center py-8 text-zinc-500 text-sm\">No talent found</div>\n   344→            ) : (\n   345→              sortedAvailable.map(talent => {\n   346→                const isInterested = talent.interested && talent.interested[compId] === true;\n   347→                return (\n   348→                  <div\n   349→                    key={talent.id}\n   350→                    className=\"bg-zinc-800 hover:bg-zinc-750 border border-zinc-700 rounded-lg px-3 py-2.5 group\"\n   351→                  >\n   352→                    <div className=\"flex items-start gap-2\">\n   353→                      <div className=\"flex-1 min-w-0\">\n   354→                        <div className=\"flex items-center gap-1.5 mb-0.5\">\n   355→                          <span className=\"text-sm font-medium text-white truncate\">{talent.name}</span>\n   356→                          <span className={`flex-shrink-0 px-1.5 py-0.5 rounded text-xs ${getStatusColor(talent.status)}`}>\n   357→                            {getStatusLabel(talent.status)}\n   358→                          </span>\n   359→                          {isInterested && (\n   360→                            <span className=\"flex-shrink-0 px-1.5 py-0.5 rounded text-xs bg-green-900 text-green-200 flex items-center gap-1\">\n   361→                              <CheckIcon className=\"w-2.5 h-2.5\" />\n   362→                              Interested\n   363→                            </span>\n   364→                          )}\n   365→                        </div>\n   366→                        <div className=\"text-xs text-zinc-500 truncate\">\n   367→                          {talent.commentaryRole}{talent.affiliation ? ` · ${talent.affiliation}` : ''}\n   368→                        </div>\n   369→                        {talent.phone && (\n   370→                          <a href={`tel:${talent.phone}`} className=\"text-xs text-blue-500 hover:text-blue-400 flex items-center gap-1 mt-0.5\">\n   371→                            <PhoneIcon className=\"w-2.5 h-2.5\" />\n   372→                            {talent.phone}\n   373→                          </a>\n   374→                        )}\n   375→                      </div>\n   376→                      <button\n   377→                        onClick={() => handleAssign(talent)}\n   378→                        className=\"flex-shrink-0 p-1.5 bg-blue-600 hover:bg-blue-500 rounded transition-colors opacity-0 group-hover:opacity-100\"\n   379→                        title={`Add as ${getRoleLabel(activeRole)}`}\n   380→                      >\n   381→                        <PlusIcon className=\"w-3.5 h-3.5\" />\n   382→                      </button>\n   383→                    </div>\n   384→                  </div>\n   385→                );\n   386→              })\n   387→            )}\n   388→          </div>\n   389→\n   390→          <div className=\"p-3 border-t border-zinc-800\">\n   391→            <Link\n   392→              to=\"/talent\"\n   393→              className=\"w-full flex items-center justify-center gap-2 py-2 bg-zinc-800 hover:bg-zinc-700 rounded-lg text-xs text-zinc-400 hover:text-white transition-colors\"\n   394→            >\n   395→              <UserGroupIcon className=\"w-4 h-4\" />\n   396→              View full roster\n   397→            </Link>\n   398→          </div>\n   399→        </div>\n   400→      </div>\n   401→    </div>\n   402→  );\n   403→}\n   404→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"1726e8a1-3905-44f2-afab-a27d184a3596","uuid":"202038b0-443d-4586-933b-1da8fd85479c","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/pages/CommentaryPage.jsx","content":"import { useState } from 'react';\nimport { Link } from 'react-router-dom';\nimport { useCompetition } from '../context/CompetitionContext';\nimport { useCommentaryStaff, getStaffStatusLabel, getStaffStatusColor, getRoleLabel, STAFF_STATUS } from '../hooks/useCommentaryStaff';\nimport { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\nimport {\n  MagnifyingGlassIcon,\n  PhoneIcon,\n  EnvelopeIcon,\n  PlusIcon,\n  XMarkIcon,\n  UserGroupIcon,\n  ChevronRightIcon,\n  CheckIcon,\n  LinkIcon,\n} from '@heroicons/react/24/solid';\nimport toast from 'react-hot-toast';\n\nconst STATUS_FLOW = [\n  { status: STAFF_STATUS.ASSIGNED, label: 'Assigned', next: STAFF_STATUS.INVITED },\n  { status: STAFF_STATUS.INVITED, label: 'Invited', next: STAFF_STATUS.CONFIRMED },\n  { status: STAFF_STATUS.CONFIRMED, label: 'Confirmed', next: STAFF_STATUS.BRIEFED },\n  { status: STAFF_STATUS.DECLINED, label: 'Declined', next: null },\n  { status: STAFF_STATUS.BRIEFED, label: 'Briefed', next: null },\n];\n\nconst SLOT_ROLES = [\n  { role: 'pbp', label: 'Play by Play / Lead', color: 'border-blue-600' },\n  { role: 'analyst', label: 'Color / Analyst', color: 'border-purple-600' },\n  { role: 'producer', label: 'Producer', color: 'border-teal-600' },\n];\n\n/**\n * CommentaryPage - Per-competition commentary talent management.\n * URL: /:compId/commentary\n */\nexport default function CommentaryPage() {\n  const { compId, competitionConfig } = useCompetition();\n  const { staffList, loading: staffLoading, assignTalent, updateStatus, updateNotes, removeAssignment } = useCommentaryStaff(compId);\n  const { talentList, loading: talentLoading } = useTalentRoster();\n\n  const gender = competitionConfig?.gender || 'womens';\n  const [search, setSearch] = useState('');\n  const [activeRole, setActiveRole] = useState('pbp');\n  const [editingNotes, setEditingNotes] = useState(null);\n  const [notesDraft, setNotesDraft] = useState('');\n\n  // Filter talent list for the right panel — match gender and status\n  const targetWagMag = gender === 'mens' ? 'MAG' : 'WAG';\n  const assignedIds = new Set(staffList.map(s => s.talentId));\n\n  const availableTalent = talentList.filter(t => {\n    // Already assigned to this competition\n    if (assignedIds.has(t.id)) return false;\n    // Must match gender or be \"Both\"\n    if (t.wagMag && t.wagMag !== 'Both' && t.wagMag !== targetWagMag) return false;\n    // Search\n    if (search) {\n      const q = search.toLowerCase();\n      if (!t.name?.toLowerCase().includes(q) && !t.affiliation?.toLowerCase().includes(q)) return false;\n    }\n    return true;\n  });\n\n  // Sort: ready first, then has-contact, then others\n  const sortedAvailable = [...availableTalent].sort((a, b) => {\n    const order = { ready: 0, 'has-contact': 1, 'did-2025': 2, 'need-info': 3 };\n    return (order[a.status] ?? 4) - (order[b.status] ?? 4);\n  });\n\n  async function handleAssign(talent) {\n    try {\n      await assignTalent(talent.id, activeRole);\n      toast.success(`${talent.name} added as ${getRoleLabel(activeRole)}`);\n    } catch (e) {\n      toast.error('Failed to assign talent');\n    }\n  }\n\n  async function handleAdvanceStatus(talentId, currentStatus) {\n    const flow = STATUS_FLOW.find(s => s.status === currentStatus);\n    if (!flow?.next) return;\n    try {\n      await updateStatus(talentId, flow.next);\n      toast.success(`Status updated to ${getStaffStatusLabel(flow.next)}`);\n    } catch (e) {\n      toast.error('Failed to update status');\n    }\n  }\n\n  async function handleDecline(talentId) {\n    try {\n      await updateStatus(talentId, STAFF_STATUS.DECLINED);\n    } catch (e) {\n      toast.error('Failed to update status');\n    }\n  }\n\n  async function handleRemove(talentId, name) {\n    try {\n      await removeAssignment(talentId);\n      toast.success(`${name} removed`);\n    } catch (e) {\n      toast.error('Failed to remove');\n    }\n  }\n\n  async function handleSaveNotes(talentId) {\n    await updateNotes(talentId, notesDraft);\n    setEditingNotes(null);\n    toast.success('Notes saved');\n  }\n\n  async function handleCopyBookingLink(talentId, role) {\n    try {\n      const response = await fetch(`https://api.commentarygraphic.com/api/book/generate`, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ talentId, compId, role }),\n      });\n\n      if (!response.ok) throw new Error('Failed to generate booking link');\n\n      const data = await response.json();\n      await navigator.clipboard.writeText(data.url);\n      toast.success('Booking link copied!', { duration: 2000 });\n    } catch (e) {\n      toast.error('Failed to generate link');\n    }\n  }\n\n  // Group staff by role\n  const byRole = SLOT_ROLES.reduce((acc, { role }) => {\n    acc[role] = staffList.filter(s => s.role === role);\n    return acc;\n  }, {});\n\n  const confirmedCount = staffList.filter(s => s.status === STAFF_STATUS.CONFIRMED || s.status === STAFF_STATUS.BRIEFED).length;\n  const totalCount = staffList.length;\n\n  return (\n    <div className=\"min-h-screen bg-zinc-950 text-white\">\n      {/* Header */}\n      <div className=\"bg-zinc-900 border-b border-zinc-800 px-6 py-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-4\">\n            <div>\n              <h1 className=\"text-lg font-bold text-white flex items-center gap-2\">\n                <UserGroupIcon className=\"w-5 h-5 text-blue-400\" />\n                Commentary\n              </h1>\n              <p className=\"text-xs text-zinc-500\">\n                {competitionConfig?.eventName || compId} ·{' '}\n                {totalCount === 0\n                  ? 'No talent assigned'\n                  : `${confirmedCount}/${totalCount} confirmed`}\n              </p>\n            </div>\n          </div>\n          <Link\n            to=\"/talent\"\n            className=\"text-xs text-zinc-400 hover:text-white transition-colors flex items-center gap-1\"\n          >\n            Manage Roster\n            <ChevronRightIcon className=\"w-3 h-3\" />\n          </Link>\n        </div>\n      </div>\n\n      <div className=\"flex h-[calc(100vh-73px)]\">\n        {/* Left: Current assignments */}\n        <div className=\"flex-1 overflow-y-auto p-5 border-r border-zinc-800\">\n          <div className=\"space-y-6\">\n            {SLOT_ROLES.map(({ role, label, color }) => (\n              <div key={role}>\n                <div className={`flex items-center gap-2 mb-3 pb-2 border-b ${color.replace('border', 'border-b')}`}>\n                  <h2 className=\"text-sm font-semibold text-zinc-300\">{label}</h2>\n                  <span className=\"text-xs text-zinc-500\">({byRole[role]?.length || 0})</span>\n                </div>\n\n                {byRole[role]?.length === 0 && (\n                  <button\n                    onClick={() => setActiveRole(role)}\n                    className=\"w-full py-3 border border-dashed border-zinc-700 rounded-lg text-zinc-500 text-sm hover:border-zinc-500 hover:text-zinc-300 transition-colors flex items-center justify-center gap-2\"\n                  >\n                    <PlusIcon className=\"w-4 h-4\" />\n                    Assign {label}\n                  </button>\n                )}\n\n                <div className=\"space-y-2\">\n                  {byRole[role]?.map((assignment) => {\n                    const talent = talentList.find(t => t.id === assignment.talentId);\n                    const flowEntry = STATUS_FLOW.find(s => s.status === assignment.status);\n                    const isEditingNotes = editingNotes === assignment.talentId;\n\n                    return (\n                      <div key={assignment.talentId} className=\"bg-zinc-800 rounded-xl border border-zinc-700 p-4\">\n                        <div className=\"flex items-start justify-between gap-3\">\n                          <div className=\"flex-1 min-w-0\">\n                            <div className=\"flex items-center gap-2 mb-1\">\n                              <Link\n                                to={`/talent/${assignment.talentId}`}\n                                className=\"font-semibold text-white hover:text-blue-300 transition-colors\"\n                              >\n                                {talent?.name || assignment.talentId}\n                              </Link>\n                              <span className={`px-2 py-0.5 rounded text-xs font-medium ${getStaffStatusColor(assignment.status)}`}>\n                                {getStaffStatusLabel(assignment.status)}\n                              </span>\n                            </div>\n                            {talent && (\n                              <div className=\"flex items-center gap-3 text-xs text-zinc-400\">\n                                {talent.phone && (\n                                  <a href={`tel:${talent.phone}`} className=\"flex items-center gap-1 text-blue-400 hover:text-blue-300\">\n                                    <PhoneIcon className=\"w-3 h-3\" />\n                                    {talent.phone}\n                                  </a>\n                                )}\n                                {talent.email && (\n                                  <a href={`mailto:${talent.email}`} className=\"flex items-center gap-1 text-zinc-400 hover:text-zinc-200\">\n                                    <EnvelopeIcon className=\"w-3 h-3\" />\n                                    {talent.email}\n                                  </a>\n                                )}\n                              </div>\n                            )}\n                          </div>\n                          <button\n                            onClick={() => handleRemove(assignment.talentId, talent?.name)}\n                            className=\"text-zinc-600 hover:text-red-400 transition-colors flex-shrink-0\"\n                            title=\"Remove\"\n                          >\n                            <XMarkIcon className=\"w-4 h-4\" />\n                          </button>\n                        </div>\n\n                        {/* Workflow status buttons */}\n                        <div className=\"flex items-center gap-2 mt-3 flex-wrap\">\n                          {flowEntry?.next && (\n                            <button\n                              onClick={() => handleAdvanceStatus(assignment.talentId, assignment.status)}\n                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded text-xs font-medium transition-colors\"\n                            >\n                              <CheckIcon className=\"w-3 h-3\" />\n                              Mark as {getStaffStatusLabel(flowEntry.next)}\n                            </button>\n                          )}\n                          <button\n                            onClick={() => handleCopyBookingLink(assignment.talentId, assignment.role)}\n                            className=\"flex items-center gap-1.5 px-3 py-1.5 bg-zinc-700 hover:bg-zinc-600 rounded text-xs font-medium transition-colors\"\n                            title=\"Generate and copy booking link\"\n                          >\n                            <LinkIcon className=\"w-3 h-3\" />\n                            Copy Link\n                          </button>\n                          {assignment.status === STAFF_STATUS.INVITED && (\n                            <button\n                              onClick={() => handleDecline(assignment.talentId)}\n                              className=\"px-3 py-1.5 bg-red-900 hover:bg-red-800 rounded text-xs font-medium transition-colors\"\n                            >\n                              Mark Declined\n                            </button>\n                          )}\n                          {assignment.status === STAFF_STATUS.CONFIRMED && (\n                            <div className=\"flex items-center gap-1.5 px-2 py-1 text-xs text-zinc-500\">\n                              <span className={`w-2 h-2 rounded-full ${assignment.calendarInviteSent ? 'bg-green-500' : 'bg-zinc-600'}`} />\n                              Calendar invite\n                            </div>\n                          )}\n                        </div>\n\n                        {/* Notes */}\n                        <div className=\"mt-2\">\n                          {isEditingNotes ? (\n                            <div className=\"flex gap-2\">\n                              <input\n                                autoFocus\n                                value={notesDraft}\n                                onChange={e => setNotesDraft(e.target.value)}\n                                placeholder=\"Add a note for this competition...\"\n                                className=\"flex-1 px-2 py-1 bg-zinc-700 border border-zinc-600 rounded text-xs text-white focus:outline-none\"\n                              />\n                              <button onClick={() => handleSaveNotes(assignment.talentId)} className=\"px-2 py-1 bg-blue-600 hover:bg-blue-500 rounded text-xs\">Save</button>\n                              <button onClick={() => setEditingNotes(null)} className=\"px-2 py-1 text-zinc-400 hover:text-white text-xs\">Cancel</button>\n                            </div>\n                          ) : (\n                            <button\n                              onClick={() => { setEditingNotes(assignment.talentId); setNotesDraft(assignment.notes || ''); }}\n                              className=\"text-xs text-zinc-500 hover:text-zinc-300 transition-colors\"\n                            >\n                              {assignment.notes ? assignment.notes : '+ Add competition note'}\n                            </button>\n                          )}\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Right: Talent search */}\n        <div className=\"w-80 flex-shrink-0 flex flex-col\">\n          <div className=\"p-4 border-b border-zinc-800\">\n            <div className=\"flex items-center gap-2 mb-3\">\n              <h2 className=\"text-sm font-semibold text-zinc-300\">Add to competition</h2>\n            </div>\n            {/* Role selector */}\n            <div className=\"flex gap-1.5 mb-3\">\n              {SLOT_ROLES.map(({ role, label }) => (\n                <button\n                  key={role}\n                  onClick={() => setActiveRole(role)}\n                  className={`flex-1 py-1.5 rounded text-xs font-medium transition-colors ${\n                    activeRole === role\n                      ? 'bg-blue-600 text-white'\n                      : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'\n                  }`}\n                >\n                  {role === 'pbp' ? 'PBP' : role === 'analyst' ? 'Analyst' : 'Producer'}\n                </button>\n              ))}\n            </div>\n            <div className=\"relative\">\n              <MagnifyingGlassIcon className=\"w-4 h-4 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"text\"\n                placeholder={`Search ${targetWagMag} talent...`}\n                value={search}\n                onChange={e => setSearch(e.target.value)}\n                className=\"w-full pl-9 pr-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto p-3 space-y-1.5\">\n            {talentLoading ? (\n              <div className=\"text-center py-8 text-zinc-500 text-sm\">Loading...</div>\n            ) : sortedAvailable.length === 0 ? (\n              <div className=\"text-center py-8 text-zinc-500 text-sm\">No talent found</div>\n            ) : (\n              sortedAvailable.map(talent => {\n                const isInterested = talent.interested && talent.interested[compId] === true;\n                return (\n                  <div\n                    key={talent.id}\n                    className=\"bg-zinc-800 hover:bg-zinc-750 border border-zinc-700 rounded-lg px-3 py-2.5 group\"\n                  >\n                    <div className=\"flex items-start gap-2\">\n                      <div className=\"flex-1 min-w-0\">\n                        <div className=\"flex items-center gap-1.5 mb-0.5\">\n                          <span className=\"text-sm font-medium text-white truncate\">{talent.name}</span>\n                          <span className={`flex-shrink-0 px-1.5 py-0.5 rounded text-xs ${getStatusColor(talent.status)}`}>\n                            {getStatusLabel(talent.status)}\n                          </span>\n                          {isInterested && (\n                            <span className=\"flex-shrink-0 px-1.5 py-0.5 rounded text-xs bg-green-900 text-green-200 flex items-center gap-1\">\n                              <CheckIcon className=\"w-2.5 h-2.5\" />\n                              Interested\n                            </span>\n                          )}\n                        </div>\n                        <div className=\"text-xs text-zinc-500 truncate\">\n                          {talent.commentaryRole}{talent.affiliation ? ` · ${talent.affiliation}` : ''}\n                        </div>\n                        {talent.phone && (\n                          <a href={`tel:${talent.phone}`} className=\"text-xs text-blue-500 hover:text-blue-400 flex items-center gap-1 mt-0.5\">\n                            <PhoneIcon className=\"w-2.5 h-2.5\" />\n                            {talent.phone}\n                          </a>\n                        )}\n                      </div>\n                      <button\n                        onClick={() => handleAssign(talent)}\n                        className=\"flex-shrink-0 p-1.5 bg-blue-600 hover:bg-blue-500 rounded transition-colors opacity-0 group-hover:opacity-100\"\n                        title={`Add as ${getRoleLabel(activeRole)}`}\n                      >\n                        <PlusIcon className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </div>\n                );\n              })\n            )}\n          </div>\n\n          <div className=\"p-3 border-t border-zinc-800\">\n            <Link\n              to=\"/talent\"\n              className=\"w-full flex items-center justify-center gap-2 py-2 bg-zinc-800 hover:bg-zinc-700 rounded-lg text-xs text-zinc-400 hover:text-white transition-colors\"\n            >\n              <UserGroupIcon className=\"w-4 h-4\" />\n              View full roster\n            </Link>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","numLines":404,"startLine":1,"totalLines":404}}}
