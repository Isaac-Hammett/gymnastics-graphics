{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RFLPNFTpaNcbeGB49sPxf3","type":"tool_result","content":"     1→/**\n     2→ * Talent Discovery Service\n     3→ *\n     4→ * AI-powered discovery of potential commentary talent from college gymnastics\n     5→ * alumni rosters. Uses web scraping + Claude API for candidate scoring.\n     6→ *\n     7→ * PRD-Commentary-Talent-CRM Phase 4\n     8→ */\n     9→\n    10→import Anthropic from '@anthropic-ai/sdk';\n    11→import admin from 'firebase-admin';\n    12→\n    13→// ============================================================================\n    14→// Configuration\n    15→// ============================================================================\n    16→\n    17→// RTN does not have public alumni roster pages via their API\n    18→// This service attempts to scrape school athletic department pages\n    19→// For MVP, we'll use a flexible approach that can handle multiple URL patterns\n    20→\n    21→const RTN_TEAMS_BASE = 'https://www.rtnathletics.com/teams';\n    22→const SCHOOL_ROSTER_PATTERNS = {\n    23→  // These are potential URL patterns - will need to be validated/updated\n    24→  // Most schools have their own athletic department sites, not RTN-hosted rosters\n    25→  rtn: (schoolSlug) => `${RTN_TEAMS_BASE}/${schoolSlug}/roster`,\n    26→  // Fallback: many schools use their own athletic department sites\n    27→  // We'll need school-specific mappings for production use\n    28→};\n    29→\n    30→// Claude model for scoring\n    31→const CLAUDE_MODEL = 'claude-haiku-4-5-20251001';\n    32→\n    33→// Levenshtein distance for fuzzy name matching (dedup check)\n    34→const FUZZY_MATCH_THRESHOLD = 0.85; // 85% similarity\n    35→\n    36→// ============================================================================\n    37→// Firebase Integration\n    38→// ============================================================================\n    39→\n    40→let db = null;\n    41→\n    42→/**\n    43→ * Get Firebase database reference\n    44→ * Reuses the existing Firebase Admin initialization from other services\n    45→ */\n    46→function getDb() {\n    47→  if (!db) {\n    48→    try {\n    49→      db = admin.database();\n    50→    } catch (error) {\n    51→      console.error('[talentDiscoveryService] Firebase not initialized:', error.message);\n    52→      return null;\n    53→    }\n    54→  }\n    55→  return db;\n    56→}\n    57→\n    58→// ============================================================================\n    59→// Helper Functions\n    60→// ============================================================================\n    61→\n    62→/**\n    63→ * Calculate Levenshtein distance between two strings\n    64→ * Used for fuzzy name matching to detect duplicates\n    65→ */\n    66→function levenshtein(a, b) {\n    67→  const matrix = [];\n    68→\n    69→  for (let i = 0; i <= b.length; i++) {\n    70→    matrix[i] = [i];\n    71→  }\n    72→\n    73→  for (let j = 0; j <= a.length; j++) {\n    74→    matrix[0][j] = j;\n    75→  }\n    76→\n    77→  for (let i = 1; i <= b.length; i++) {\n    78→    for (let j = 1; j <= a.length; j++) {\n    79→      if (b.charAt(i - 1) === a.charAt(j - 1)) {\n    80→        matrix[i][j] = matrix[i - 1][j - 1];\n    81→      } else {\n    82→        matrix[i][j] = Math.min(\n    83→          matrix[i - 1][j - 1] + 1,\n    84→          matrix[i][j - 1] + 1,\n    85→          matrix[i - 1][j] + 1\n    86→        );\n    87→      }\n    88→    }\n    89→  }\n    90→\n    91→  return matrix[b.length][a.length];\n    92→}\n    93→\n    94→/**\n    95→ * Calculate similarity score (0-1) between two strings\n    96→ */\n    97→function similarity(a, b) {\n    98→  const longer = a.length > b.length ? a : b;\n    99→  const shorter = a.length > b.length ? b : a;\n   100→\n   101→  if (longer.length === 0) {\n   102→    return 1.0;\n   103→  }\n   104→\n   105→  const distance = levenshtein(longer, shorter);\n   106→  return (longer.length - distance) / longer.length;\n   107→}\n   108→\n   109→/**\n   110→ * Normalize name for comparison (lowercase, trim)\n   111→ */\n   112→function normalizeName(name) {\n   113→  return name.toLowerCase().trim();\n   114→}\n   115→\n   116→/**\n   117→ * Check if a candidate already exists in the talent roster\n   118→ * Uses fuzzy name matching to catch variations in spelling\n   119→ */\n   120→async function checkIfInRoster(candidateName) {\n   121→  const database = getDb();\n   122→  if (!database) {\n   123→    console.warn('[talentDiscoveryService] Firebase not available for dedup check');\n   124→    return false;\n   125→  }\n   126→\n   127→  try {\n   128→    const snapshot = await database.ref('talentRoster').once('value');\n   129→    const roster = snapshot.val();\n   130→\n   131→    if (!roster) {\n   132→      return false;\n   133→    }\n   134→\n   135→    const normalizedCandidate = normalizeName(candidateName);\n   136→\n   137→    // Check all existing talent entries for fuzzy name match\n   138→    for (const [talentId, talent] of Object.entries(roster)) {\n   139→      if (talent && talent.name) {\n   140→        const normalizedExisting = normalizeName(talent.name);\n   141→        const similarityScore = similarity(normalizedCandidate, normalizedExisting);\n   142→\n   143→        if (similarityScore >= FUZZY_MATCH_THRESHOLD) {\n   144→          console.log(`[talentDiscoveryService] Found existing talent: \"${candidateName}\" matches \"${talent.name}\" (${Math.round(similarityScore * 100)}% similar)`);\n   145→          return true;\n   146→        }\n   147→      }\n   148→    }\n   149→\n   150→    return false;\n   151→  } catch (error) {\n   152→    console.error('[talentDiscoveryService] Error checking roster:', error.message);\n   153→    return false;\n   154→  }\n   155→}\n   156→\n   157→/**\n   158→ * Fetch alumni roster data for a school\n   159→ * This is a placeholder implementation - actual URL patterns will vary by school\n   160→ *\n   161→ * @param {string} schoolName - School name (e.g., \"Stanford\", \"Oklahoma\")\n   162→ * @returns {Promise<Array>} Array of { name, graduationYear }\n   163→ */\n   164→async function fetchAlumniRoster(schoolName) {\n   165→  // For MVP, we'll return a mock structure\n   166→  // In production, this would scrape the actual school pages\n   167→  // RTN doesn't have public alumni rosters - most schools use their own athletic dept sites\n   168→\n   169→  console.log(`[talentDiscoveryService] Fetching alumni roster for ${schoolName}`);\n   170→\n   171→  // Attempt to fetch from RTN pattern (likely to fail - RTN doesn't have this)\n   172→  const schoolSlug = schoolName.toLowerCase().replace(/\\s+/g, '-');\n   173→  const rtnUrl = SCHOOL_ROSTER_PATTERNS.rtn(schoolSlug);\n   174→\n   175→  try {\n   176→    const response = await fetch(rtnUrl, {\n   177→      headers: {\n   178→        'User-Agent': 'GymnasticsGraphics/1.0'\n   179→      }\n   180→    });\n   181→\n   182→    if (!response.ok) {\n   183→      throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   184→    }\n   185→\n   186→    const html = await response.text();\n   187→\n   188→    // Basic HTML parsing (would need to be more sophisticated for real use)\n   189→    // This is a placeholder - actual implementation would parse the HTML structure\n   190→    // Most schools don't have machine-readable roster data, so this will often fail\n   191→\n   192→    console.log('[talentDiscoveryService] Successfully fetched roster page');\n   193→\n   194→    // Parse HTML for athlete names and graduation years\n   195→    // This is highly site-specific and would need per-school logic\n   196→    const athletes = parseRosterHTML(html, schoolName);\n   197→\n   198→    return athletes;\n   199→\n   200→  } catch (error) {\n   201→    console.warn(`[talentDiscoveryService] Failed to fetch from RTN (${rtnUrl}): ${error.message}`);\n   202→\n   203→    // Fallback: Return empty array with informative error\n   204→    // In production, this is where we'd try alternative sources or return an error\n   205→    throw new Error(`Alumni roster not available for ${schoolName}. RTN does not provide public alumni rosters. Consider manual entry or alternative data sources.`);\n   206→  }\n   207→}\n   208→\n   209→/**\n   210→ * Parse HTML roster page\n   211→ * Placeholder implementation - would need school-specific parsing logic\n   212→ */\n   213→function parseRosterHTML(html, schoolName) {\n   214→  // This is a placeholder\n   215→  // Real implementation would parse the HTML structure of the roster page\n   216→  // Each school has different HTML structures, making this very brittle\n   217→\n   218→  // For now, return empty array to signal \"no data available\"\n   219→  return [];\n   220→}\n   221→\n   222→/**\n   223→ * Score candidates using Claude API in a single batch call\n   224→ * CRITICAL: Batch all candidates in ONE API call to avoid N+1 timeout issues\n   225→ *\n   226→ * @param {Array} athletes - Array of { name, graduationYear, school }\n   227→ * @returns {Promise<Array>} Array of candidate cards with scores\n   228→ */\n   229→async function scoreAlumniWithClaude(athletes, schoolName) {\n   230→  if (!process.env.ANTHROPIC_API_KEY) {\n   231→    throw new Error('ANTHROPIC_API_KEY not configured');\n   232→  }\n   233→\n   234→  if (!athletes || athletes.length === 0) {\n   235→    return [];\n   236→  }\n   237→\n   238→  console.log(`[talentDiscoveryService] Scoring ${athletes.length} candidates with Claude`);\n   239→\n   240→  const anthropic = new Anthropic({\n   241→    apiKey: process.env.ANTHROPIC_API_KEY,\n   242→  });\n   243→\n   244→  // Build a prompt that includes ALL athletes\n   245→  // This avoids N+1 API calls which would cause HTTP timeout\n   246→  const athleteList = athletes.map((a, idx) =>\n   247→    `${idx + 1}. ${a.name}${a.graduationYear ? ` (Class of ${a.graduationYear})` : ''}`\n   248→  ).join('\\n');\n   249→\n   250→  const prompt = `You are evaluating former collegiate gymnasts from ${schoolName} as potential remote gymnastics commentators.\n   251→\n   252→Here is a list of ${athletes.length} alumni:\n   253→\n   254→${athleteList}\n   255→\n   256→For each person, provide:\n   257→1. A suitability score from 1-5 (5 = excellent candidate, 1 = not suitable)\n   258→2. A brief explanation (1-2 sentences) of why they would or wouldn't be a good commentator\n   259→\n   260→Scoring criteria:\n   261→- Recent graduation (more recent = higher score, as they're more familiar with current NCAA gymnastics)\n   262→- Years competed (4+ years = stronger candidate)\n   263→- Consider that being an athlete doesn't automatically make someone a good commentator\n   264→\n   265→IMPORTANT: Do NOT attempt to find social media links. Return null for linkedIn and instagram fields.\n   266→\n   267→Return ONLY valid JSON in this exact format (no markdown, no code blocks):\n   268→[\n   269→  {\n   270→    \"name\": \"First Last\",\n   271→    \"score\": 3,\n   272→    \"explanation\": \"Brief explanation here\",\n   273→    \"linkedIn\": null,\n   274→    \"instagram\": null\n   275→  }\n   276→]`;\n   277→\n   278→  try {\n   279→    const message = await anthropic.messages.create({\n   280→      model: CLAUDE_MODEL,\n   281→      max_tokens: 4000,\n   282→      messages: [\n   283→        {\n   284→          role: 'user',\n   285→          content: prompt\n   286→        }\n   287→      ]\n   288→    });\n   289→\n   290→    // Extract the response text\n   291→    const responseText = message.content[0].text;\n   292→\n   293→    // Parse JSON response\n   294→    let scoredCandidates;\n   295→    try {\n   296→      scoredCandidates = JSON.parse(responseText);\n   297→    } catch (parseError) {\n   298→      console.error('[talentDiscoveryService] Failed to parse Claude response as JSON:', responseText);\n   299→      throw new Error('Claude API returned invalid JSON');\n   300→    }\n   301→\n   302→    // Validate response structure\n   303→    if (!Array.isArray(scoredCandidates)) {\n   304→      throw new Error('Claude API response is not an array');\n   305→    }\n   306→\n   307→    // Add school name and check if already in roster\n   308→    const candidateCards = await Promise.all(\n   309→      scoredCandidates.map(async (candidate) => {\n   310→        const alreadyInRoster = await checkIfInRoster(candidate.name);\n   311→\n   312→        return {\n   313→          name: candidate.name,\n   314→          school: schoolName,\n   315→          graduationYear: athletes.find(a => a.name === candidate.name)?.graduationYear || null,\n   316→          score: candidate.score,\n   317→          explanation: candidate.explanation,\n   318→          linkedIn: null, // Always null per task requirements\n   319→          instagram: null, // Always null per task requirements\n   320→          rtnAthleteId: null, // Not available from our data source\n   321→          alreadyInRoster\n   322→        };\n   323→      })\n   324→    );\n   325→\n   326→    console.log(`[talentDiscoveryService] Scored ${candidateCards.length} candidates`);\n   327→    return candidateCards;\n   328→\n   329→  } catch (error) {\n   330→    console.error('[talentDiscoveryService] Claude API error:', error.message);\n   331→    throw new Error(`Failed to score candidates: ${error.message}`);\n   332→  }\n   333→}\n   334→\n   335→// ============================================================================\n   336→// Public API\n   337→// ============================================================================\n   338→\n   339→/**\n   340→ * Discover alumni candidates for a school\n   341→ *\n   342→ * @param {string} schoolName - School name (e.g., \"Stanford\", \"Oklahoma\")\n   343→ * @returns {Promise<Array>} Array of CandidateCard objects\n   344→ */\n   345→export async function discoverAlumni(schoolName) {\n   346→  if (!schoolName || typeof schoolName !== 'string') {\n   347→    throw new Error('School name is required');\n   348→  }\n   349→\n   350→  console.log(`[talentDiscoveryService] Starting discovery for ${schoolName}`);\n   351→\n   352→  try {\n   353→    // Step 1: Fetch alumni roster\n   354→    const athletes = await fetchAlumniRoster(schoolName);\n   355→\n   356→    if (athletes.length === 0) {\n   357→      console.warn(`[talentDiscoveryService] No alumni data found for ${schoolName}`);\n   358→      return [];\n   359→    }\n   360→\n   361→    // Step 2: Score all athletes in ONE Claude API call (not N+1!)\n   362→    const candidateCards = await scoreAlumniWithClaude(athletes, schoolName);\n   363→\n   364→    console.log(`[talentDiscoveryService] Discovery complete for ${schoolName}: ${candidateCards.length} candidates`);\n   365→    return candidateCards;\n   366→\n   367→  } catch (error) {\n   368→    console.error(`[talentDiscoveryService] Error discovering alumni for ${schoolName}:`, error.message);\n   369→    throw error;\n   370→  }\n   371→}\n   372→\n   373→/**\n   374→ * CandidateCard shape (for reference):\n   375→ * {\n   376→ *   name: string,\n   377→ *   school: string,\n   378→ *   graduationYear: number | null,\n   379→ *   score: number (1-5),\n   380→ *   explanation: string,\n   381→ *   linkedIn: null (always null - see task notes),\n   382→ *   instagram: null (always null - see task notes),\n   383→ *   rtnAthleteId: string | null,\n   384→ *   alreadyInRoster: boolean\n   385→ * }\n   386→ */\n   387→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"b773f974-5265-4e65-81c8-6345833f251d","uuid":"eb5db23d-b52a-456d-95a1-9f76b127d075","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/server/lib/talentDiscoveryService.js","content":"/**\n * Talent Discovery Service\n *\n * AI-powered discovery of potential commentary talent from college gymnastics\n * alumni rosters. Uses web scraping + Claude API for candidate scoring.\n *\n * PRD-Commentary-Talent-CRM Phase 4\n */\n\nimport Anthropic from '@anthropic-ai/sdk';\nimport admin from 'firebase-admin';\n\n// ============================================================================\n// Configuration\n// ============================================================================\n\n// RTN does not have public alumni roster pages via their API\n// This service attempts to scrape school athletic department pages\n// For MVP, we'll use a flexible approach that can handle multiple URL patterns\n\nconst RTN_TEAMS_BASE = 'https://www.rtnathletics.com/teams';\nconst SCHOOL_ROSTER_PATTERNS = {\n  // These are potential URL patterns - will need to be validated/updated\n  // Most schools have their own athletic department sites, not RTN-hosted rosters\n  rtn: (schoolSlug) => `${RTN_TEAMS_BASE}/${schoolSlug}/roster`,\n  // Fallback: many schools use their own athletic department sites\n  // We'll need school-specific mappings for production use\n};\n\n// Claude model for scoring\nconst CLAUDE_MODEL = 'claude-haiku-4-5-20251001';\n\n// Levenshtein distance for fuzzy name matching (dedup check)\nconst FUZZY_MATCH_THRESHOLD = 0.85; // 85% similarity\n\n// ============================================================================\n// Firebase Integration\n// ============================================================================\n\nlet db = null;\n\n/**\n * Get Firebase database reference\n * Reuses the existing Firebase Admin initialization from other services\n */\nfunction getDb() {\n  if (!db) {\n    try {\n      db = admin.database();\n    } catch (error) {\n      console.error('[talentDiscoveryService] Firebase not initialized:', error.message);\n      return null;\n    }\n  }\n  return db;\n}\n\n// ============================================================================\n// Helper Functions\n// ============================================================================\n\n/**\n * Calculate Levenshtein distance between two strings\n * Used for fuzzy name matching to detect duplicates\n */\nfunction levenshtein(a, b) {\n  const matrix = [];\n\n  for (let i = 0; i <= b.length; i++) {\n    matrix[i] = [i];\n  }\n\n  for (let j = 0; j <= a.length; j++) {\n    matrix[0][j] = j;\n  }\n\n  for (let i = 1; i <= b.length; i++) {\n    for (let j = 1; j <= a.length; j++) {\n      if (b.charAt(i - 1) === a.charAt(j - 1)) {\n        matrix[i][j] = matrix[i - 1][j - 1];\n      } else {\n        matrix[i][j] = Math.min(\n          matrix[i - 1][j - 1] + 1,\n          matrix[i][j - 1] + 1,\n          matrix[i - 1][j] + 1\n        );\n      }\n    }\n  }\n\n  return matrix[b.length][a.length];\n}\n\n/**\n * Calculate similarity score (0-1) between two strings\n */\nfunction similarity(a, b) {\n  const longer = a.length > b.length ? a : b;\n  const shorter = a.length > b.length ? b : a;\n\n  if (longer.length === 0) {\n    return 1.0;\n  }\n\n  const distance = levenshtein(longer, shorter);\n  return (longer.length - distance) / longer.length;\n}\n\n/**\n * Normalize name for comparison (lowercase, trim)\n */\nfunction normalizeName(name) {\n  return name.toLowerCase().trim();\n}\n\n/**\n * Check if a candidate already exists in the talent roster\n * Uses fuzzy name matching to catch variations in spelling\n */\nasync function checkIfInRoster(candidateName) {\n  const database = getDb();\n  if (!database) {\n    console.warn('[talentDiscoveryService] Firebase not available for dedup check');\n    return false;\n  }\n\n  try {\n    const snapshot = await database.ref('talentRoster').once('value');\n    const roster = snapshot.val();\n\n    if (!roster) {\n      return false;\n    }\n\n    const normalizedCandidate = normalizeName(candidateName);\n\n    // Check all existing talent entries for fuzzy name match\n    for (const [talentId, talent] of Object.entries(roster)) {\n      if (talent && talent.name) {\n        const normalizedExisting = normalizeName(talent.name);\n        const similarityScore = similarity(normalizedCandidate, normalizedExisting);\n\n        if (similarityScore >= FUZZY_MATCH_THRESHOLD) {\n          console.log(`[talentDiscoveryService] Found existing talent: \"${candidateName}\" matches \"${talent.name}\" (${Math.round(similarityScore * 100)}% similar)`);\n          return true;\n        }\n      }\n    }\n\n    return false;\n  } catch (error) {\n    console.error('[talentDiscoveryService] Error checking roster:', error.message);\n    return false;\n  }\n}\n\n/**\n * Fetch alumni roster data for a school\n * This is a placeholder implementation - actual URL patterns will vary by school\n *\n * @param {string} schoolName - School name (e.g., \"Stanford\", \"Oklahoma\")\n * @returns {Promise<Array>} Array of { name, graduationYear }\n */\nasync function fetchAlumniRoster(schoolName) {\n  // For MVP, we'll return a mock structure\n  // In production, this would scrape the actual school pages\n  // RTN doesn't have public alumni rosters - most schools use their own athletic dept sites\n\n  console.log(`[talentDiscoveryService] Fetching alumni roster for ${schoolName}`);\n\n  // Attempt to fetch from RTN pattern (likely to fail - RTN doesn't have this)\n  const schoolSlug = schoolName.toLowerCase().replace(/\\s+/g, '-');\n  const rtnUrl = SCHOOL_ROSTER_PATTERNS.rtn(schoolSlug);\n\n  try {\n    const response = await fetch(rtnUrl, {\n      headers: {\n        'User-Agent': 'GymnasticsGraphics/1.0'\n      }\n    });\n\n    if (!response.ok) {\n      throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n    }\n\n    const html = await response.text();\n\n    // Basic HTML parsing (would need to be more sophisticated for real use)\n    // This is a placeholder - actual implementation would parse the HTML structure\n    // Most schools don't have machine-readable roster data, so this will often fail\n\n    console.log('[talentDiscoveryService] Successfully fetched roster page');\n\n    // Parse HTML for athlete names and graduation years\n    // This is highly site-specific and would need per-school logic\n    const athletes = parseRosterHTML(html, schoolName);\n\n    return athletes;\n\n  } catch (error) {\n    console.warn(`[talentDiscoveryService] Failed to fetch from RTN (${rtnUrl}): ${error.message}`);\n\n    // Fallback: Return empty array with informative error\n    // In production, this is where we'd try alternative sources or return an error\n    throw new Error(`Alumni roster not available for ${schoolName}. RTN does not provide public alumni rosters. Consider manual entry or alternative data sources.`);\n  }\n}\n\n/**\n * Parse HTML roster page\n * Placeholder implementation - would need school-specific parsing logic\n */\nfunction parseRosterHTML(html, schoolName) {\n  // This is a placeholder\n  // Real implementation would parse the HTML structure of the roster page\n  // Each school has different HTML structures, making this very brittle\n\n  // For now, return empty array to signal \"no data available\"\n  return [];\n}\n\n/**\n * Score candidates using Claude API in a single batch call\n * CRITICAL: Batch all candidates in ONE API call to avoid N+1 timeout issues\n *\n * @param {Array} athletes - Array of { name, graduationYear, school }\n * @returns {Promise<Array>} Array of candidate cards with scores\n */\nasync function scoreAlumniWithClaude(athletes, schoolName) {\n  if (!process.env.ANTHROPIC_API_KEY) {\n    throw new Error('ANTHROPIC_API_KEY not configured');\n  }\n\n  if (!athletes || athletes.length === 0) {\n    return [];\n  }\n\n  console.log(`[talentDiscoveryService] Scoring ${athletes.length} candidates with Claude`);\n\n  const anthropic = new Anthropic({\n    apiKey: process.env.ANTHROPIC_API_KEY,\n  });\n\n  // Build a prompt that includes ALL athletes\n  // This avoids N+1 API calls which would cause HTTP timeout\n  const athleteList = athletes.map((a, idx) =>\n    `${idx + 1}. ${a.name}${a.graduationYear ? ` (Class of ${a.graduationYear})` : ''}`\n  ).join('\\n');\n\n  const prompt = `You are evaluating former collegiate gymnasts from ${schoolName} as potential remote gymnastics commentators.\n\nHere is a list of ${athletes.length} alumni:\n\n${athleteList}\n\nFor each person, provide:\n1. A suitability score from 1-5 (5 = excellent candidate, 1 = not suitable)\n2. A brief explanation (1-2 sentences) of why they would or wouldn't be a good commentator\n\nScoring criteria:\n- Recent graduation (more recent = higher score, as they're more familiar with current NCAA gymnastics)\n- Years competed (4+ years = stronger candidate)\n- Consider that being an athlete doesn't automatically make someone a good commentator\n\nIMPORTANT: Do NOT attempt to find social media links. Return null for linkedIn and instagram fields.\n\nReturn ONLY valid JSON in this exact format (no markdown, no code blocks):\n[\n  {\n    \"name\": \"First Last\",\n    \"score\": 3,\n    \"explanation\": \"Brief explanation here\",\n    \"linkedIn\": null,\n    \"instagram\": null\n  }\n]`;\n\n  try {\n    const message = await anthropic.messages.create({\n      model: CLAUDE_MODEL,\n      max_tokens: 4000,\n      messages: [\n        {\n          role: 'user',\n          content: prompt\n        }\n      ]\n    });\n\n    // Extract the response text\n    const responseText = message.content[0].text;\n\n    // Parse JSON response\n    let scoredCandidates;\n    try {\n      scoredCandidates = JSON.parse(responseText);\n    } catch (parseError) {\n      console.error('[talentDiscoveryService] Failed to parse Claude response as JSON:', responseText);\n      throw new Error('Claude API returned invalid JSON');\n    }\n\n    // Validate response structure\n    if (!Array.isArray(scoredCandidates)) {\n      throw new Error('Claude API response is not an array');\n    }\n\n    // Add school name and check if already in roster\n    const candidateCards = await Promise.all(\n      scoredCandidates.map(async (candidate) => {\n        const alreadyInRoster = await checkIfInRoster(candidate.name);\n\n        return {\n          name: candidate.name,\n          school: schoolName,\n          graduationYear: athletes.find(a => a.name === candidate.name)?.graduationYear || null,\n          score: candidate.score,\n          explanation: candidate.explanation,\n          linkedIn: null, // Always null per task requirements\n          instagram: null, // Always null per task requirements\n          rtnAthleteId: null, // Not available from our data source\n          alreadyInRoster\n        };\n      })\n    );\n\n    console.log(`[talentDiscoveryService] Scored ${candidateCards.length} candidates`);\n    return candidateCards;\n\n  } catch (error) {\n    console.error('[talentDiscoveryService] Claude API error:', error.message);\n    throw new Error(`Failed to score candidates: ${error.message}`);\n  }\n}\n\n// ============================================================================\n// Public API\n// ============================================================================\n\n/**\n * Discover alumni candidates for a school\n *\n * @param {string} schoolName - School name (e.g., \"Stanford\", \"Oklahoma\")\n * @returns {Promise<Array>} Array of CandidateCard objects\n */\nexport async function discoverAlumni(schoolName) {\n  if (!schoolName || typeof schoolName !== 'string') {\n    throw new Error('School name is required');\n  }\n\n  console.log(`[talentDiscoveryService] Starting discovery for ${schoolName}`);\n\n  try {\n    // Step 1: Fetch alumni roster\n    const athletes = await fetchAlumniRoster(schoolName);\n\n    if (athletes.length === 0) {\n      console.warn(`[talentDiscoveryService] No alumni data found for ${schoolName}`);\n      return [];\n    }\n\n    // Step 2: Score all athletes in ONE Claude API call (not N+1!)\n    const candidateCards = await scoreAlumniWithClaude(athletes, schoolName);\n\n    console.log(`[talentDiscoveryService] Discovery complete for ${schoolName}: ${candidateCards.length} candidates`);\n    return candidateCards;\n\n  } catch (error) {\n    console.error(`[talentDiscoveryService] Error discovering alumni for ${schoolName}:`, error.message);\n    throw error;\n  }\n}\n\n/**\n * CandidateCard shape (for reference):\n * {\n *   name: string,\n *   school: string,\n *   graduationYear: number | null,\n *   score: number (1-5),\n *   explanation: string,\n *   linkedIn: null (always null - see task notes),\n *   instagram: null (always null - see task notes),\n *   rtnAthleteId: string | null,\n *   alreadyInRoster: boolean\n * }\n */\n","numLines":387,"startLine":1,"totalLines":387}}}
