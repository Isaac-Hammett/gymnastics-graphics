{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WCD11Zko19gfepQYj8iY1G","type":"tool_result","content":"     1→/**\n     2→ * Gmail Service\n     3→ *\n     4→ * Sends emails via the coordinator's Gmail account using OAuth2.\n     5→ * Requires GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN in env.\n     6→ * If env vars are not set, methods return { error: 'Gmail not configured' }.\n     7→ */\n     8→\n     9→import { google } from 'googleapis';\n    10→\n    11→function getOAuth2Client() {\n    12→  const { GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN } = process.env;\n    13→  if (!GOOGLE_CLIENT_ID || !GOOGLE_CLIENT_SECRET || !GOOGLE_REFRESH_TOKEN) {\n    14→    return null;\n    15→  }\n    16→  const auth = new google.auth.OAuth2(GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET);\n    17→  auth.setCredentials({ refresh_token: GOOGLE_REFRESH_TOKEN });\n    18→  return auth;\n    19→}\n    20→\n    21→/**\n    22→ * Send an email via Gmail API.\n    23→ * @param {{ to: string, subject: string, html: string }} options\n    24→ * @returns {Promise<{ messageId: string } | { error: string }>}\n    25→ */\n    26→export async function sendEmail({ to, subject, html }) {\n    27→  const auth = getOAuth2Client();\n    28→  if (!auth) {\n    29→    console.warn('[GmailService] Gmail not configured — skipping send');\n    30→    return { error: 'Gmail not configured' };\n    31→  }\n    32→\n    33→  const gmail = google.gmail({ version: 'v1', auth });\n    34→\n    35→  // Build RFC 2822 message\n    36→  const utf8Subject = `=?utf-8?B?${Buffer.from(subject).toString('base64')}?=`;\n    37→  const messageParts = [\n    38→    `To: ${to}`,\n    39→    'Content-Type: text/html; charset=utf-8',\n    40→    'MIME-Version: 1.0',\n    41→    `Subject: ${utf8Subject}`,\n    42→    '',\n    43→    html,\n    44→  ];\n    45→  const message = messageParts.join('\\n');\n    46→  const encodedMessage = Buffer.from(message)\n    47→    .toString('base64')\n    48→    .replace(/\\+/g, '-')\n    49→    .replace(/\\//g, '_')\n    50→    .replace(/=+$/, '');\n    51→\n    52→  const res = await gmail.users.messages.send({\n    53→    userId: 'me',\n    54→    requestBody: { raw: encodedMessage },\n    55→  });\n    56→\n    57→  console.log(`[GmailService] Sent email to ${to} — messageId: ${res.data.id}`);\n    58→  return { messageId: res.data.id };\n    59→}\n    60→\n    61→// ============================================================================\n    62→// Email Templates\n    63→// ============================================================================\n    64→\n    65→/**\n    66→ * Invite email — sent when a coordinator invites talent to a competition.\n    67→ * @param {{ name: string }} talent\n    68→ * @param {{ eventName: string, meetDate: string, venue: string }} competition\n    69→ * @param {string} role — 'pbp' | 'analyst' | 'both'\n    70→ * @param {string} bookingUrl — unique booking link for this talent+competition\n    71→ * @returns {{ to: string, subject: string, html: string }}\n    72→ */\n    73→export function inviteEmail(talent, competition, role, bookingUrl) {\n    74→  const roleLabel = role === 'pbp' ? 'Play-by-Play' : role === 'analyst' ? 'Color Analyst' : 'Commentary';\n    75→  const subject = `Commentary Invitation: ${competition.eventName}`;\n    76→  const html = `\n    77→<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n    78→  <h2 style=\"color: #1a1a2e;\">Commentary Invitation</h2>\n    79→  <p>Hi ${talent.name},</p>\n    80→  <p>You're invited to join the commentary team for the following event:</p>\n    81→  <table style=\"border-collapse: collapse; width: 100%; margin: 16px 0;\">\n    82→    <tr><td style=\"padding: 8px; font-weight: bold; width: 140px;\">Event</td><td style=\"padding: 8px;\">${competition.eventName}</td></tr>\n    83→    <tr style=\"background:#f5f5f5;\"><td style=\"padding: 8px; font-weight: bold;\">Date</td><td style=\"padding: 8px;\">${competition.meetDate}</td></tr>\n    84→    <tr><td style=\"padding: 8px; font-weight: bold;\">Venue</td><td style=\"padding: 8px;\">${competition.venue || 'TBD'}</td></tr>\n    85→    <tr style=\"background:#f5f5f5;\"><td style=\"padding: 8px; font-weight: bold;\">Your Role</td><td style=\"padding: 8px;\">${roleLabel}</td></tr>\n    86→  </table>\n    87→  <p>Please let us know if you're available by clicking the link below:</p>\n    88→  <p style=\"text-align: center; margin: 24px 0;\">\n    89→    <a href=\"${bookingUrl}\" style=\"background: #4caf50; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-size: 16px;\">\n    90→      Respond to Invitation\n    91→    </a>\n    92→  </p>\n    93→  <p style=\"color: #666; font-size: 14px;\">This link expires in 30 days.</p>\n    94→  <p>Questions? Reply to this email.</p>\n    95→  <p>Thanks,<br>Commentary Coordination Team</p>\n    96→</div>`;\n    97→  return { subject, html };\n    98→}\n    99→\n   100→/**\n   101→ * Briefing email — sent after talent is confirmed with full production details.\n   102→ * @param {{ name: string }} talent\n   103→ * @param {{ eventName: string, meetDate: string, venue: string }} competition\n   104→ * @param {string} virtiusUrl\n   105→ * @param {string} discordInfo\n   106→ * @param {string} preProdTime — ISO timestamp\n   107→ * @returns {{ subject: string, html: string }}\n   108→ */\n   109→export function briefingEmail(talent, competition, virtiusUrl, discordInfo, preProdTime) {\n   110→  const preProdFormatted = preProdTime ? new Date(preProdTime).toLocaleString() : 'TBD';\n   111→  const commentaryUrl = `https://commentarygraphic.com/commentary`;\n   112→  const subject = `Pre-Production Briefing: ${competition.eventName}`;\n   113→  const html = `\n   114→<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n   115→  <h2 style=\"color: #1a1a2e;\">Production Briefing</h2>\n   116→  <p>Hi ${talent.name},</p>\n   117→  <p>Here are your production details for <strong>${competition.eventName}</strong>:</p>\n   118→  <table style=\"border-collapse: collapse; width: 100%; margin: 16px 0;\">\n   119→    <tr><td style=\"padding: 8px; font-weight: bold; width: 160px;\">Event</td><td style=\"padding: 8px;\">${competition.eventName}</td></tr>\n   120→    <tr style=\"background:#f5f5f5;\"><td style=\"padding: 8px; font-weight: bold;\">Date</td><td style=\"padding: 8px;\">${competition.meetDate}</td></tr>\n   121→    <tr><td style=\"padding: 8px; font-weight: bold;\">Venue</td><td style=\"padding: 8px;\">${competition.venue || 'TBD'}</td></tr>\n   122→    <tr style=\"background:#f5f5f5;\"><td style=\"padding: 8px; font-weight: bold;\">Virtius Session</td><td style=\"padding: 8px;\"><a href=\"${virtiusUrl}\">${virtiusUrl}</a></td></tr>\n   123→    <tr><td style=\"padding: 8px; font-weight: bold;\">Commentary View</td><td style=\"padding: 8px;\"><a href=\"${commentaryUrl}\">${commentaryUrl}</a></td></tr>\n   124→    <tr style=\"background:#f5f5f5;\"><td style=\"padding: 8px; font-weight: bold;\">Discord</td><td style=\"padding: 8px;\">${discordInfo}</td></tr>\n   125→    <tr><td style=\"padding: 8px; font-weight: bold;\">Pre-Production Call</td><td style=\"padding: 8px;\">${preProdFormatted}</td></tr>\n   126→  </table>\n   127→  <p>See you on air!</p>\n   128→  <p>Thanks,<br>Commentary Coordination Team</p>\n   129→</div>`;\n   130→  return { subject, html };\n   131→}\n   132→\n   133→/**\n   134→ * Reminder email — sent as a follow-up when talent hasn't responded.\n   135→ * @param {{ name: string }} talent\n   136→ * @param {{ eventName: string, meetDate: string }} competition\n   137→ * @param {string} bookingUrl\n   138→ * @returns {{ subject: string, html: string }}\n   139→ */\n   140→export function reminderEmail(talent, competition, bookingUrl) {\n   141→  const subject = `Reminder: Commentary Invitation for ${competition.eventName}`;\n   142→  const html = `\n   143→<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n   144→  <h2 style=\"color: #1a1a2e;\">Reminder: Commentary Invitation</h2>\n   145→  <p>Hi ${talent.name},</p>\n   146→  <p>Just a quick reminder — we'd love to have you on the commentary team for <strong>${competition.eventName}</strong> on ${competition.meetDate}.</p>\n   147→  <p>Please let us know your availability when you get a chance:</p>\n   148→  <p style=\"text-align: center; margin: 24px 0;\">\n   149→    <a href=\"${bookingUrl}\" style=\"background: #4caf50; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-size: 16px;\">\n   150→      Respond to Invitation\n   151→    </a>\n   152→  </p>\n   153→  <p style=\"color: #666; font-size: 14px;\">No worries if you're not available — just let us know!</p>\n   154→  <p>Thanks,<br>Commentary Coordination Team</p>\n   155→</div>`;\n   156→  return { subject, html };\n   157→}\n   158→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"06eeebf2-c804-48ef-8e0f-4a285f415442","uuid":"6786da61-0bd0-4dc2-b6ed-0df1a7ea450b","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/server/lib/gmailService.js","content":"/**\n * Gmail Service\n *\n * Sends emails via the coordinator's Gmail account using OAuth2.\n * Requires GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN in env.\n * If env vars are not set, methods return { error: 'Gmail not configured' }.\n */\n\nimport { google } from 'googleapis';\n\nfunction getOAuth2Client() {\n  const { GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN } = process.env;\n  if (!GOOGLE_CLIENT_ID || !GOOGLE_CLIENT_SECRET || !GOOGLE_REFRESH_TOKEN) {\n    return null;\n  }\n  const auth = new google.auth.OAuth2(GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET);\n  auth.setCredentials({ refresh_token: GOOGLE_REFRESH_TOKEN });\n  return auth;\n}\n\n/**\n * Send an email via Gmail API.\n * @param {{ to: string, subject: string, html: string }} options\n * @returns {Promise<{ messageId: string } | { error: string }>}\n */\nexport async function sendEmail({ to, subject, html }) {\n  const auth = getOAuth2Client();\n  if (!auth) {\n    console.warn('[GmailService] Gmail not configured — skipping send');\n    return { error: 'Gmail not configured' };\n  }\n\n  const gmail = google.gmail({ version: 'v1', auth });\n\n  // Build RFC 2822 message\n  const utf8Subject = `=?utf-8?B?${Buffer.from(subject).toString('base64')}?=`;\n  const messageParts = [\n    `To: ${to}`,\n    'Content-Type: text/html; charset=utf-8',\n    'MIME-Version: 1.0',\n    `Subject: ${utf8Subject}`,\n    '',\n    html,\n  ];\n  const message = messageParts.join('\\n');\n  const encodedMessage = Buffer.from(message)\n    .toString('base64')\n    .replace(/\\+/g, '-')\n    .replace(/\\//g, '_')\n    .replace(/=+$/, '');\n\n  const res = await gmail.users.messages.send({\n    userId: 'me',\n    requestBody: { raw: encodedMessage },\n  });\n\n  console.log(`[GmailService] Sent email to ${to} — messageId: ${res.data.id}`);\n  return { messageId: res.data.id };\n}\n\n// ============================================================================\n// Email Templates\n// ============================================================================\n\n/**\n * Invite email — sent when a coordinator invites talent to a competition.\n * @param {{ name: string }} talent\n * @param {{ eventName: string, meetDate: string, venue: string }} competition\n * @param {string} role — 'pbp' | 'analyst' | 'both'\n * @param {string} bookingUrl — unique booking link for this talent+competition\n * @returns {{ to: string, subject: string, html: string }}\n */\nexport function inviteEmail(talent, competition, role, bookingUrl) {\n  const roleLabel = role === 'pbp' ? 'Play-by-Play' : role === 'analyst' ? 'Color Analyst' : 'Commentary';\n  const subject = `Commentary Invitation: ${competition.eventName}`;\n  const html = `\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <h2 style=\"color: #1a1a2e;\">Commentary Invitation</h2>\n  <p>Hi ${talent.name},</p>\n  <p>You're invited to join the commentary team for the following event:</p>\n  <table style=\"border-collapse: collapse; width: 100%; margin: 16px 0;\">\n    <tr><td style=\"padding: 8px; font-weight: bold; width: 140px;\">Event</td><td style=\"padding: 8px;\">${competition.eventName}</td></tr>\n    <tr style=\"background:#f5f5f5;\"><td style=\"padding: 8px; font-weight: bold;\">Date</td><td style=\"padding: 8px;\">${competition.meetDate}</td></tr>\n    <tr><td style=\"padding: 8px; font-weight: bold;\">Venue</td><td style=\"padding: 8px;\">${competition.venue || 'TBD'}</td></tr>\n    <tr style=\"background:#f5f5f5;\"><td style=\"padding: 8px; font-weight: bold;\">Your Role</td><td style=\"padding: 8px;\">${roleLabel}</td></tr>\n  </table>\n  <p>Please let us know if you're available by clicking the link below:</p>\n  <p style=\"text-align: center; margin: 24px 0;\">\n    <a href=\"${bookingUrl}\" style=\"background: #4caf50; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-size: 16px;\">\n      Respond to Invitation\n    </a>\n  </p>\n  <p style=\"color: #666; font-size: 14px;\">This link expires in 30 days.</p>\n  <p>Questions? Reply to this email.</p>\n  <p>Thanks,<br>Commentary Coordination Team</p>\n</div>`;\n  return { subject, html };\n}\n\n/**\n * Briefing email — sent after talent is confirmed with full production details.\n * @param {{ name: string }} talent\n * @param {{ eventName: string, meetDate: string, venue: string }} competition\n * @param {string} virtiusUrl\n * @param {string} discordInfo\n * @param {string} preProdTime — ISO timestamp\n * @returns {{ subject: string, html: string }}\n */\nexport function briefingEmail(talent, competition, virtiusUrl, discordInfo, preProdTime) {\n  const preProdFormatted = preProdTime ? new Date(preProdTime).toLocaleString() : 'TBD';\n  const commentaryUrl = `https://commentarygraphic.com/commentary`;\n  const subject = `Pre-Production Briefing: ${competition.eventName}`;\n  const html = `\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <h2 style=\"color: #1a1a2e;\">Production Briefing</h2>\n  <p>Hi ${talent.name},</p>\n  <p>Here are your production details for <strong>${competition.eventName}</strong>:</p>\n  <table style=\"border-collapse: collapse; width: 100%; margin: 16px 0;\">\n    <tr><td style=\"padding: 8px; font-weight: bold; width: 160px;\">Event</td><td style=\"padding: 8px;\">${competition.eventName}</td></tr>\n    <tr style=\"background:#f5f5f5;\"><td style=\"padding: 8px; font-weight: bold;\">Date</td><td style=\"padding: 8px;\">${competition.meetDate}</td></tr>\n    <tr><td style=\"padding: 8px; font-weight: bold;\">Venue</td><td style=\"padding: 8px;\">${competition.venue || 'TBD'}</td></tr>\n    <tr style=\"background:#f5f5f5;\"><td style=\"padding: 8px; font-weight: bold;\">Virtius Session</td><td style=\"padding: 8px;\"><a href=\"${virtiusUrl}\">${virtiusUrl}</a></td></tr>\n    <tr><td style=\"padding: 8px; font-weight: bold;\">Commentary View</td><td style=\"padding: 8px;\"><a href=\"${commentaryUrl}\">${commentaryUrl}</a></td></tr>\n    <tr style=\"background:#f5f5f5;\"><td style=\"padding: 8px; font-weight: bold;\">Discord</td><td style=\"padding: 8px;\">${discordInfo}</td></tr>\n    <tr><td style=\"padding: 8px; font-weight: bold;\">Pre-Production Call</td><td style=\"padding: 8px;\">${preProdFormatted}</td></tr>\n  </table>\n  <p>See you on air!</p>\n  <p>Thanks,<br>Commentary Coordination Team</p>\n</div>`;\n  return { subject, html };\n}\n\n/**\n * Reminder email — sent as a follow-up when talent hasn't responded.\n * @param {{ name: string }} talent\n * @param {{ eventName: string, meetDate: string }} competition\n * @param {string} bookingUrl\n * @returns {{ subject: string, html: string }}\n */\nexport function reminderEmail(talent, competition, bookingUrl) {\n  const subject = `Reminder: Commentary Invitation for ${competition.eventName}`;\n  const html = `\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <h2 style=\"color: #1a1a2e;\">Reminder: Commentary Invitation</h2>\n  <p>Hi ${talent.name},</p>\n  <p>Just a quick reminder — we'd love to have you on the commentary team for <strong>${competition.eventName}</strong> on ${competition.meetDate}.</p>\n  <p>Please let us know your availability when you get a chance:</p>\n  <p style=\"text-align: center; margin: 24px 0;\">\n    <a href=\"${bookingUrl}\" style=\"background: #4caf50; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-size: 16px;\">\n      Respond to Invitation\n    </a>\n  </p>\n  <p style=\"color: #666; font-size: 14px;\">No worries if you're not available — just let us know!</p>\n  <p>Thanks,<br>Commentary Coordination Team</p>\n</div>`;\n  return { subject, html };\n}\n","numLines":158,"startLine":1,"totalLines":158}}}
