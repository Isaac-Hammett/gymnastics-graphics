{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HyXSpfHUSD9DtSpGU2FvTx","type":"tool_result","content":"     1→import { useState } from 'react';\n     2→import { Link } from 'react-router-dom';\n     3→import { useCompetition } from '../context/CompetitionContext';\n     4→import { useCommentaryStaff, getStaffStatusLabel, getStaffStatusColor, getRoleLabel, STAFF_STATUS } from '../hooks/useCommentaryStaff';\n     5→import { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\n     6→import {\n     7→  MagnifyingGlassIcon,\n     8→  PhoneIcon,\n     9→  EnvelopeIcon,\n    10→  PlusIcon,\n    11→  XMarkIcon,\n    12→  UserGroupIcon,\n    13→  ChevronRightIcon,\n    14→  CheckIcon,\n    15→} from '@heroicons/react/24/solid';\n    16→import toast from 'react-hot-toast';\n    17→\n    18→const STATUS_FLOW = [\n    19→  { status: STAFF_STATUS.ASSIGNED, label: 'Assigned', next: STAFF_STATUS.INVITED },\n    20→  { status: STAFF_STATUS.INVITED, label: 'Invited', next: STAFF_STATUS.CONFIRMED },\n    21→  { status: STAFF_STATUS.CONFIRMED, label: 'Confirmed', next: STAFF_STATUS.BRIEFED },\n    22→  { status: STAFF_STATUS.DECLINED, label: 'Declined', next: null },\n    23→  { status: STAFF_STATUS.BRIEFED, label: 'Briefed', next: null },\n    24→];\n    25→\n    26→const SLOT_ROLES = [\n    27→  { role: 'pbp', label: 'Play by Play / Lead', color: 'border-blue-600' },\n    28→  { role: 'analyst', label: 'Color / Analyst', color: 'border-purple-600' },\n    29→  { role: 'producer', label: 'Producer', color: 'border-teal-600' },\n    30→];\n    31→\n    32→/**\n    33→ * CommentaryPage - Per-competition commentary talent management.\n    34→ * URL: /:compId/commentary\n    35→ */\n    36→export default function CommentaryPage() {\n    37→  const { compId, competitionConfig } = useCompetition();\n    38→  const { staffList, loading: staffLoading, assignTalent, updateStatus, updateNotes, removeAssignment } = useCommentaryStaff(compId);\n    39→  const { talentList, loading: talentLoading } = useTalentRoster();\n    40→\n    41→  const gender = competitionConfig?.gender || 'womens';\n    42→  const [search, setSearch] = useState('');\n    43→  const [activeRole, setActiveRole] = useState('pbp');\n    44→  const [editingNotes, setEditingNotes] = useState(null);\n    45→  const [notesDraft, setNotesDraft] = useState('');\n    46→\n    47→  // Filter talent list for the right panel — match gender and status\n    48→  const targetWagMag = gender === 'mens' ? 'MAG' : 'WAG';\n    49→  const assignedIds = new Set(staffList.map(s => s.talentId));\n    50→\n    51→  const availableTalent = talentList.filter(t => {\n    52→    // Already assigned to this competition\n    53→    if (assignedIds.has(t.id)) return false;\n    54→    // Must match gender or be \"Both\"\n    55→    if (t.wagMag && t.wagMag !== 'Both' && t.wagMag !== targetWagMag) return false;\n    56→    // Search\n    57→    if (search) {\n    58→      const q = search.toLowerCase();\n    59→      if (!t.name?.toLowerCase().includes(q) && !t.affiliation?.toLowerCase().includes(q)) return false;\n    60→    }\n    61→    return true;\n    62→  });\n    63→\n    64→  // Sort: ready first, then has-contact, then others\n    65→  const sortedAvailable = [...availableTalent].sort((a, b) => {\n    66→    const order = { ready: 0, 'has-contact': 1, 'did-2025': 2, 'need-info': 3 };\n    67→    return (order[a.status] ?? 4) - (order[b.status] ?? 4);\n    68→  });\n    69→\n    70→  async function handleAssign(talent) {\n    71→    try {\n    72→      await assignTalent(talent.id, activeRole);\n    73→      toast.success(`${talent.name} added as ${getRoleLabel(activeRole)}`);\n    74→    } catch (e) {\n    75→      toast.error('Failed to assign talent');\n    76→    }\n    77→  }\n    78→\n    79→  async function handleAdvanceStatus(talentId, currentStatus) {\n    80→    const flow = STATUS_FLOW.find(s => s.status === currentStatus);\n    81→    if (!flow?.next) return;\n    82→    try {\n    83→      await updateStatus(talentId, flow.next);\n    84→      toast.success(`Status updated to ${getStaffStatusLabel(flow.next)}`);\n    85→    } catch (e) {\n    86→      toast.error('Failed to update status');\n    87→    }\n    88→  }\n    89→\n    90→  async function handleDecline(talentId) {\n    91→    try {\n    92→      await updateStatus(talentId, STAFF_STATUS.DECLINED);\n    93→    } catch (e) {\n    94→      toast.error('Failed to update status');\n    95→    }\n    96→  }\n    97→\n    98→  async function handleRemove(talentId, name) {\n    99→    try {\n   100→      await removeAssignment(talentId);\n   101→      toast.success(`${name} removed`);\n   102→    } catch (e) {\n   103→      toast.error('Failed to remove');\n   104→    }\n   105→  }\n   106→\n   107→  async function handleSaveNotes(talentId) {\n   108→    await updateNotes(talentId, notesDraft);\n   109→    setEditingNotes(null);\n   110→    toast.success('Notes saved');\n   111→  }\n   112→\n   113→  // Group staff by role\n   114→  const byRole = SLOT_ROLES.reduce((acc, { role }) => {\n   115→    acc[role] = staffList.filter(s => s.role === role);\n   116→    return acc;\n   117→  }, {});\n   118→\n   119→  const confirmedCount = staffList.filter(s => s.status === STAFF_STATUS.CONFIRMED || s.status === STAFF_STATUS.BRIEFED).length;\n   120→  const totalCount = staffList.length;\n   121→\n   122→  return (\n   123→    <div className=\"min-h-screen bg-zinc-950 text-white\">\n   124→      {/* Header */}\n   125→      <div className=\"bg-zinc-900 border-b border-zinc-800 px-6 py-4\">\n   126→        <div className=\"flex items-center justify-between\">\n   127→          <div className=\"flex items-center gap-4\">\n   128→            <div>\n   129→              <h1 className=\"text-lg font-bold text-white flex items-center gap-2\">\n   130→                <UserGroupIcon className=\"w-5 h-5 text-blue-400\" />\n   131→                Commentary\n   132→              </h1>\n   133→              <p className=\"text-xs text-zinc-500\">\n   134→                {competitionConfig?.eventName || compId} ·{' '}\n   135→                {totalCount === 0\n   136→                  ? 'No talent assigned'\n   137→                  : `${confirmedCount}/${totalCount} confirmed`}\n   138→              </p>\n   139→            </div>\n   140→          </div>\n   141→          <Link\n   142→            to=\"/talent\"\n   143→            className=\"text-xs text-zinc-400 hover:text-white transition-colors flex items-center gap-1\"\n   144→          >\n   145→            Manage Roster\n   146→            <ChevronRightIcon className=\"w-3 h-3\" />\n   147→          </Link>\n   148→        </div>\n   149→      </div>\n   150→\n   151→      <div className=\"flex h-[calc(100vh-73px)]\">\n   152→        {/* Left: Current assignments */}\n   153→        <div className=\"flex-1 overflow-y-auto p-5 border-r border-zinc-800\">\n   154→          <div className=\"space-y-6\">\n   155→            {SLOT_ROLES.map(({ role, label, color }) => (\n   156→              <div key={role}>\n   157→                <div className={`flex items-center gap-2 mb-3 pb-2 border-b ${color.replace('border', 'border-b')}`}>\n   158→                  <h2 className=\"text-sm font-semibold text-zinc-300\">{label}</h2>\n   159→                  <span className=\"text-xs text-zinc-500\">({byRole[role]?.length || 0})</span>\n   160→                </div>\n   161→\n   162→                {byRole[role]?.length === 0 && (\n   163→                  <button\n   164→                    onClick={() => setActiveRole(role)}\n   165→                    className=\"w-full py-3 border border-dashed border-zinc-700 rounded-lg text-zinc-500 text-sm hover:border-zinc-500 hover:text-zinc-300 transition-colors flex items-center justify-center gap-2\"\n   166→                  >\n   167→                    <PlusIcon className=\"w-4 h-4\" />\n   168→                    Assign {label}\n   169→                  </button>\n   170→                )}\n   171→\n   172→                <div className=\"space-y-2\">\n   173→                  {byRole[role]?.map((assignment) => {\n   174→                    const talent = talentList.find(t => t.id === assignment.talentId);\n   175→                    const flowEntry = STATUS_FLOW.find(s => s.status === assignment.status);\n   176→                    const isEditingNotes = editingNotes === assignment.talentId;\n   177→\n   178→                    return (\n   179→                      <div key={assignment.talentId} className=\"bg-zinc-800 rounded-xl border border-zinc-700 p-4\">\n   180→                        <div className=\"flex items-start justify-between gap-3\">\n   181→                          <div className=\"flex-1 min-w-0\">\n   182→                            <div className=\"flex items-center gap-2 mb-1\">\n   183→                              <Link\n   184→                                to={`/talent/${assignment.talentId}`}\n   185→                                className=\"font-semibold text-white hover:text-blue-300 transition-colors\"\n   186→                              >\n   187→                                {talent?.name || assignment.talentId}\n   188→                              </Link>\n   189→                              <span className={`px-2 py-0.5 rounded text-xs font-medium ${getStaffStatusColor(assignment.status)}`}>\n   190→                                {getStaffStatusLabel(assignment.status)}\n   191→                              </span>\n   192→                            </div>\n   193→                            {talent && (\n   194→                              <div className=\"flex items-center gap-3 text-xs text-zinc-400\">\n   195→                                {talent.phone && (\n   196→                                  <a href={`tel:${talent.phone}`} className=\"flex items-center gap-1 text-blue-400 hover:text-blue-300\">\n   197→                                    <PhoneIcon className=\"w-3 h-3\" />\n   198→                                    {talent.phone}\n   199→                                  </a>\n   200→                                )}\n   201→                                {talent.email && (\n   202→                                  <a href={`mailto:${talent.email}`} className=\"flex items-center gap-1 text-zinc-400 hover:text-zinc-200\">\n   203→                                    <EnvelopeIcon className=\"w-3 h-3\" />\n   204→                                    {talent.email}\n   205→                                  </a>\n   206→                                )}\n   207→                              </div>\n   208→                            )}\n   209→                          </div>\n   210→                          <button\n   211→                            onClick={() => handleRemove(assignment.talentId, talent?.name)}\n   212→                            className=\"text-zinc-600 hover:text-red-400 transition-colors flex-shrink-0\"\n   213→                            title=\"Remove\"\n   214→                          >\n   215→                            <XMarkIcon className=\"w-4 h-4\" />\n   216→                          </button>\n   217→                        </div>\n   218→\n   219→                        {/* Workflow status buttons */}\n   220→                        <div className=\"flex items-center gap-2 mt-3 flex-wrap\">\n   221→                          {flowEntry?.next && (\n   222→                            <button\n   223→                              onClick={() => handleAdvanceStatus(assignment.talentId, assignment.status)}\n   224→                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded text-xs font-medium transition-colors\"\n   225→                            >\n   226→                              <CheckIcon className=\"w-3 h-3\" />\n   227→                              Mark as {getStaffStatusLabel(flowEntry.next)}\n   228→                            </button>\n   229→                          )}\n   230→                          {assignment.status === STAFF_STATUS.INVITED && (\n   231→                            <button\n   232→                              onClick={() => handleDecline(assignment.talentId)}\n   233→                              className=\"px-3 py-1.5 bg-red-900 hover:bg-red-800 rounded text-xs font-medium transition-colors\"\n   234→                            >\n   235→                              Mark Declined\n   236→                            </button>\n   237→                          )}\n   238→                          {assignment.status === STAFF_STATUS.CONFIRMED && (\n   239→                            <div className=\"flex items-center gap-1.5 px-2 py-1 text-xs text-zinc-500\">\n   240→                              <span className={`w-2 h-2 rounded-full ${assignment.calendarInviteSent ? 'bg-green-500' : 'bg-zinc-600'}`} />\n   241→                              Calendar invite\n   242→                            </div>\n   243→                          )}\n   244→                        </div>\n   245→\n   246→                        {/* Notes */}\n   247→                        <div className=\"mt-2\">\n   248→                          {isEditingNotes ? (\n   249→                            <div className=\"flex gap-2\">\n   250→                              <input\n   251→                                autoFocus\n   252→                                value={notesDraft}\n   253→                                onChange={e => setNotesDraft(e.target.value)}\n   254→                                placeholder=\"Add a note for this competition...\"\n   255→                                className=\"flex-1 px-2 py-1 bg-zinc-700 border border-zinc-600 rounded text-xs text-white focus:outline-none\"\n   256→                              />\n   257→                              <button onClick={() => handleSaveNotes(assignment.talentId)} className=\"px-2 py-1 bg-blue-600 hover:bg-blue-500 rounded text-xs\">Save</button>\n   258→                              <button onClick={() => setEditingNotes(null)} className=\"px-2 py-1 text-zinc-400 hover:text-white text-xs\">Cancel</button>\n   259→                            </div>\n   260→                          ) : (\n   261→                            <button\n   262→                              onClick={() => { setEditingNotes(assignment.talentId); setNotesDraft(assignment.notes || ''); }}\n   263→                              className=\"text-xs text-zinc-500 hover:text-zinc-300 transition-colors\"\n   264→                            >\n   265→                              {assignment.notes ? assignment.notes : '+ Add competition note'}\n   266→                            </button>\n   267→                          )}\n   268→                        </div>\n   269→                      </div>\n   270→                    );\n   271→                  })}\n   272→                </div>\n   273→              </div>\n   274→            ))}\n   275→          </div>\n   276→        </div>\n   277→\n   278→        {/* Right: Talent search */}\n   279→        <div className=\"w-80 flex-shrink-0 flex flex-col\">\n   280→          <div className=\"p-4 border-b border-zinc-800\">\n   281→            <div className=\"flex items-center gap-2 mb-3\">\n   282→              <h2 className=\"text-sm font-semibold text-zinc-300\">Add to competition</h2>\n   283→            </div>\n   284→            {/* Role selector */}\n   285→            <div className=\"flex gap-1.5 mb-3\">\n   286→              {SLOT_ROLES.map(({ role, label }) => (\n   287→                <button\n   288→                  key={role}\n   289→                  onClick={() => setActiveRole(role)}\n   290→                  className={`flex-1 py-1.5 rounded text-xs font-medium transition-colors ${\n   291→                    activeRole === role\n   292→                      ? 'bg-blue-600 text-white'\n   293→                      : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'\n   294→                  }`}\n   295→                >\n   296→                  {role === 'pbp' ? 'PBP' : role === 'analyst' ? 'Analyst' : 'Producer'}\n   297→                </button>\n   298→              ))}\n   299→            </div>\n   300→            <div className=\"relative\">\n   301→              <MagnifyingGlassIcon className=\"w-4 h-4 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\n   302→              <input\n   303→                type=\"text\"\n   304→                placeholder={`Search ${targetWagMag} talent...`}\n   305→                value={search}\n   306→                onChange={e => setSearch(e.target.value)}\n   307→                className=\"w-full pl-9 pr-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500\"\n   308→              />\n   309→            </div>\n   310→          </div>\n   311→\n   312→          <div className=\"flex-1 overflow-y-auto p-3 space-y-1.5\">\n   313→            {talentLoading ? (\n   314→              <div className=\"text-center py-8 text-zinc-500 text-sm\">Loading...</div>\n   315→            ) : sortedAvailable.length === 0 ? (\n   316→              <div className=\"text-center py-8 text-zinc-500 text-sm\">No talent found</div>\n   317→            ) : (\n   318→              sortedAvailable.map(talent => (\n   319→                <div\n   320→                  key={talent.id}\n   321→                  className=\"bg-zinc-800 hover:bg-zinc-750 border border-zinc-700 rounded-lg px-3 py-2.5 group\"\n   322→                >\n   323→                  <div className=\"flex items-start gap-2\">\n   324→                    <div className=\"flex-1 min-w-0\">\n   325→                      <div className=\"flex items-center gap-1.5 mb-0.5\">\n   326→                        <span className=\"text-sm font-medium text-white truncate\">{talent.name}</span>\n   327→                        <span className={`flex-shrink-0 px-1.5 py-0.5 rounded text-xs ${getStatusColor(talent.status)}`}>\n   328→                          {getStatusLabel(talent.status)}\n   329→                        </span>\n   330→                      </div>\n   331→                      <div className=\"text-xs text-zinc-500 truncate\">\n   332→                        {talent.commentaryRole}{talent.affiliation ? ` · ${talent.affiliation}` : ''}\n   333→                      </div>\n   334→                      {talent.phone && (\n   335→                        <a href={`tel:${talent.phone}`} className=\"text-xs text-blue-500 hover:text-blue-400 flex items-center gap-1 mt-0.5\">\n   336→                          <PhoneIcon className=\"w-2.5 h-2.5\" />\n   337→                          {talent.phone}\n   338→                        </a>\n   339→                      )}\n   340→                    </div>\n   341→                    <button\n   342→                      onClick={() => handleAssign(talent)}\n   343→                      className=\"flex-shrink-0 p-1.5 bg-blue-600 hover:bg-blue-500 rounded transition-colors opacity-0 group-hover:opacity-100\"\n   344→                      title={`Add as ${getRoleLabel(activeRole)}`}\n   345→                    >\n   346→                      <PlusIcon className=\"w-3.5 h-3.5\" />\n   347→                    </button>\n   348→                  </div>\n   349→                </div>\n   350→              ))\n   351→            )}\n   352→          </div>\n   353→\n   354→          <div className=\"p-3 border-t border-zinc-800\">\n   355→            <Link\n   356→              to=\"/talent\"\n   357→              className=\"w-full flex items-center justify-center gap-2 py-2 bg-zinc-800 hover:bg-zinc-700 rounded-lg text-xs text-zinc-400 hover:text-white transition-colors\"\n   358→            >\n   359→              <UserGroupIcon className=\"w-4 h-4\" />\n   360→              View full roster\n   361→            </Link>\n   362→          </div>\n   363→        </div>\n   364→      </div>\n   365→    </div>\n   366→  );\n   367→}\n   368→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"81329dfc-ba87-486e-9a4e-05dce3e39867","uuid":"1e539ff8-a93c-4d01-aa96-eb9aa46dd2db","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/pages/CommentaryPage.jsx","content":"import { useState } from 'react';\nimport { Link } from 'react-router-dom';\nimport { useCompetition } from '../context/CompetitionContext';\nimport { useCommentaryStaff, getStaffStatusLabel, getStaffStatusColor, getRoleLabel, STAFF_STATUS } from '../hooks/useCommentaryStaff';\nimport { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\nimport {\n  MagnifyingGlassIcon,\n  PhoneIcon,\n  EnvelopeIcon,\n  PlusIcon,\n  XMarkIcon,\n  UserGroupIcon,\n  ChevronRightIcon,\n  CheckIcon,\n} from '@heroicons/react/24/solid';\nimport toast from 'react-hot-toast';\n\nconst STATUS_FLOW = [\n  { status: STAFF_STATUS.ASSIGNED, label: 'Assigned', next: STAFF_STATUS.INVITED },\n  { status: STAFF_STATUS.INVITED, label: 'Invited', next: STAFF_STATUS.CONFIRMED },\n  { status: STAFF_STATUS.CONFIRMED, label: 'Confirmed', next: STAFF_STATUS.BRIEFED },\n  { status: STAFF_STATUS.DECLINED, label: 'Declined', next: null },\n  { status: STAFF_STATUS.BRIEFED, label: 'Briefed', next: null },\n];\n\nconst SLOT_ROLES = [\n  { role: 'pbp', label: 'Play by Play / Lead', color: 'border-blue-600' },\n  { role: 'analyst', label: 'Color / Analyst', color: 'border-purple-600' },\n  { role: 'producer', label: 'Producer', color: 'border-teal-600' },\n];\n\n/**\n * CommentaryPage - Per-competition commentary talent management.\n * URL: /:compId/commentary\n */\nexport default function CommentaryPage() {\n  const { compId, competitionConfig } = useCompetition();\n  const { staffList, loading: staffLoading, assignTalent, updateStatus, updateNotes, removeAssignment } = useCommentaryStaff(compId);\n  const { talentList, loading: talentLoading } = useTalentRoster();\n\n  const gender = competitionConfig?.gender || 'womens';\n  const [search, setSearch] = useState('');\n  const [activeRole, setActiveRole] = useState('pbp');\n  const [editingNotes, setEditingNotes] = useState(null);\n  const [notesDraft, setNotesDraft] = useState('');\n\n  // Filter talent list for the right panel — match gender and status\n  const targetWagMag = gender === 'mens' ? 'MAG' : 'WAG';\n  const assignedIds = new Set(staffList.map(s => s.talentId));\n\n  const availableTalent = talentList.filter(t => {\n    // Already assigned to this competition\n    if (assignedIds.has(t.id)) return false;\n    // Must match gender or be \"Both\"\n    if (t.wagMag && t.wagMag !== 'Both' && t.wagMag !== targetWagMag) return false;\n    // Search\n    if (search) {\n      const q = search.toLowerCase();\n      if (!t.name?.toLowerCase().includes(q) && !t.affiliation?.toLowerCase().includes(q)) return false;\n    }\n    return true;\n  });\n\n  // Sort: ready first, then has-contact, then others\n  const sortedAvailable = [...availableTalent].sort((a, b) => {\n    const order = { ready: 0, 'has-contact': 1, 'did-2025': 2, 'need-info': 3 };\n    return (order[a.status] ?? 4) - (order[b.status] ?? 4);\n  });\n\n  async function handleAssign(talent) {\n    try {\n      await assignTalent(talent.id, activeRole);\n      toast.success(`${talent.name} added as ${getRoleLabel(activeRole)}`);\n    } catch (e) {\n      toast.error('Failed to assign talent');\n    }\n  }\n\n  async function handleAdvanceStatus(talentId, currentStatus) {\n    const flow = STATUS_FLOW.find(s => s.status === currentStatus);\n    if (!flow?.next) return;\n    try {\n      await updateStatus(talentId, flow.next);\n      toast.success(`Status updated to ${getStaffStatusLabel(flow.next)}`);\n    } catch (e) {\n      toast.error('Failed to update status');\n    }\n  }\n\n  async function handleDecline(talentId) {\n    try {\n      await updateStatus(talentId, STAFF_STATUS.DECLINED);\n    } catch (e) {\n      toast.error('Failed to update status');\n    }\n  }\n\n  async function handleRemove(talentId, name) {\n    try {\n      await removeAssignment(talentId);\n      toast.success(`${name} removed`);\n    } catch (e) {\n      toast.error('Failed to remove');\n    }\n  }\n\n  async function handleSaveNotes(talentId) {\n    await updateNotes(talentId, notesDraft);\n    setEditingNotes(null);\n    toast.success('Notes saved');\n  }\n\n  // Group staff by role\n  const byRole = SLOT_ROLES.reduce((acc, { role }) => {\n    acc[role] = staffList.filter(s => s.role === role);\n    return acc;\n  }, {});\n\n  const confirmedCount = staffList.filter(s => s.status === STAFF_STATUS.CONFIRMED || s.status === STAFF_STATUS.BRIEFED).length;\n  const totalCount = staffList.length;\n\n  return (\n    <div className=\"min-h-screen bg-zinc-950 text-white\">\n      {/* Header */}\n      <div className=\"bg-zinc-900 border-b border-zinc-800 px-6 py-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-4\">\n            <div>\n              <h1 className=\"text-lg font-bold text-white flex items-center gap-2\">\n                <UserGroupIcon className=\"w-5 h-5 text-blue-400\" />\n                Commentary\n              </h1>\n              <p className=\"text-xs text-zinc-500\">\n                {competitionConfig?.eventName || compId} ·{' '}\n                {totalCount === 0\n                  ? 'No talent assigned'\n                  : `${confirmedCount}/${totalCount} confirmed`}\n              </p>\n            </div>\n          </div>\n          <Link\n            to=\"/talent\"\n            className=\"text-xs text-zinc-400 hover:text-white transition-colors flex items-center gap-1\"\n          >\n            Manage Roster\n            <ChevronRightIcon className=\"w-3 h-3\" />\n          </Link>\n        </div>\n      </div>\n\n      <div className=\"flex h-[calc(100vh-73px)]\">\n        {/* Left: Current assignments */}\n        <div className=\"flex-1 overflow-y-auto p-5 border-r border-zinc-800\">\n          <div className=\"space-y-6\">\n            {SLOT_ROLES.map(({ role, label, color }) => (\n              <div key={role}>\n                <div className={`flex items-center gap-2 mb-3 pb-2 border-b ${color.replace('border', 'border-b')}`}>\n                  <h2 className=\"text-sm font-semibold text-zinc-300\">{label}</h2>\n                  <span className=\"text-xs text-zinc-500\">({byRole[role]?.length || 0})</span>\n                </div>\n\n                {byRole[role]?.length === 0 && (\n                  <button\n                    onClick={() => setActiveRole(role)}\n                    className=\"w-full py-3 border border-dashed border-zinc-700 rounded-lg text-zinc-500 text-sm hover:border-zinc-500 hover:text-zinc-300 transition-colors flex items-center justify-center gap-2\"\n                  >\n                    <PlusIcon className=\"w-4 h-4\" />\n                    Assign {label}\n                  </button>\n                )}\n\n                <div className=\"space-y-2\">\n                  {byRole[role]?.map((assignment) => {\n                    const talent = talentList.find(t => t.id === assignment.talentId);\n                    const flowEntry = STATUS_FLOW.find(s => s.status === assignment.status);\n                    const isEditingNotes = editingNotes === assignment.talentId;\n\n                    return (\n                      <div key={assignment.talentId} className=\"bg-zinc-800 rounded-xl border border-zinc-700 p-4\">\n                        <div className=\"flex items-start justify-between gap-3\">\n                          <div className=\"flex-1 min-w-0\">\n                            <div className=\"flex items-center gap-2 mb-1\">\n                              <Link\n                                to={`/talent/${assignment.talentId}`}\n                                className=\"font-semibold text-white hover:text-blue-300 transition-colors\"\n                              >\n                                {talent?.name || assignment.talentId}\n                              </Link>\n                              <span className={`px-2 py-0.5 rounded text-xs font-medium ${getStaffStatusColor(assignment.status)}`}>\n                                {getStaffStatusLabel(assignment.status)}\n                              </span>\n                            </div>\n                            {talent && (\n                              <div className=\"flex items-center gap-3 text-xs text-zinc-400\">\n                                {talent.phone && (\n                                  <a href={`tel:${talent.phone}`} className=\"flex items-center gap-1 text-blue-400 hover:text-blue-300\">\n                                    <PhoneIcon className=\"w-3 h-3\" />\n                                    {talent.phone}\n                                  </a>\n                                )}\n                                {talent.email && (\n                                  <a href={`mailto:${talent.email}`} className=\"flex items-center gap-1 text-zinc-400 hover:text-zinc-200\">\n                                    <EnvelopeIcon className=\"w-3 h-3\" />\n                                    {talent.email}\n                                  </a>\n                                )}\n                              </div>\n                            )}\n                          </div>\n                          <button\n                            onClick={() => handleRemove(assignment.talentId, talent?.name)}\n                            className=\"text-zinc-600 hover:text-red-400 transition-colors flex-shrink-0\"\n                            title=\"Remove\"\n                          >\n                            <XMarkIcon className=\"w-4 h-4\" />\n                          </button>\n                        </div>\n\n                        {/* Workflow status buttons */}\n                        <div className=\"flex items-center gap-2 mt-3 flex-wrap\">\n                          {flowEntry?.next && (\n                            <button\n                              onClick={() => handleAdvanceStatus(assignment.talentId, assignment.status)}\n                              className=\"flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded text-xs font-medium transition-colors\"\n                            >\n                              <CheckIcon className=\"w-3 h-3\" />\n                              Mark as {getStaffStatusLabel(flowEntry.next)}\n                            </button>\n                          )}\n                          {assignment.status === STAFF_STATUS.INVITED && (\n                            <button\n                              onClick={() => handleDecline(assignment.talentId)}\n                              className=\"px-3 py-1.5 bg-red-900 hover:bg-red-800 rounded text-xs font-medium transition-colors\"\n                            >\n                              Mark Declined\n                            </button>\n                          )}\n                          {assignment.status === STAFF_STATUS.CONFIRMED && (\n                            <div className=\"flex items-center gap-1.5 px-2 py-1 text-xs text-zinc-500\">\n                              <span className={`w-2 h-2 rounded-full ${assignment.calendarInviteSent ? 'bg-green-500' : 'bg-zinc-600'}`} />\n                              Calendar invite\n                            </div>\n                          )}\n                        </div>\n\n                        {/* Notes */}\n                        <div className=\"mt-2\">\n                          {isEditingNotes ? (\n                            <div className=\"flex gap-2\">\n                              <input\n                                autoFocus\n                                value={notesDraft}\n                                onChange={e => setNotesDraft(e.target.value)}\n                                placeholder=\"Add a note for this competition...\"\n                                className=\"flex-1 px-2 py-1 bg-zinc-700 border border-zinc-600 rounded text-xs text-white focus:outline-none\"\n                              />\n                              <button onClick={() => handleSaveNotes(assignment.talentId)} className=\"px-2 py-1 bg-blue-600 hover:bg-blue-500 rounded text-xs\">Save</button>\n                              <button onClick={() => setEditingNotes(null)} className=\"px-2 py-1 text-zinc-400 hover:text-white text-xs\">Cancel</button>\n                            </div>\n                          ) : (\n                            <button\n                              onClick={() => { setEditingNotes(assignment.talentId); setNotesDraft(assignment.notes || ''); }}\n                              className=\"text-xs text-zinc-500 hover:text-zinc-300 transition-colors\"\n                            >\n                              {assignment.notes ? assignment.notes : '+ Add competition note'}\n                            </button>\n                          )}\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Right: Talent search */}\n        <div className=\"w-80 flex-shrink-0 flex flex-col\">\n          <div className=\"p-4 border-b border-zinc-800\">\n            <div className=\"flex items-center gap-2 mb-3\">\n              <h2 className=\"text-sm font-semibold text-zinc-300\">Add to competition</h2>\n            </div>\n            {/* Role selector */}\n            <div className=\"flex gap-1.5 mb-3\">\n              {SLOT_ROLES.map(({ role, label }) => (\n                <button\n                  key={role}\n                  onClick={() => setActiveRole(role)}\n                  className={`flex-1 py-1.5 rounded text-xs font-medium transition-colors ${\n                    activeRole === role\n                      ? 'bg-blue-600 text-white'\n                      : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'\n                  }`}\n                >\n                  {role === 'pbp' ? 'PBP' : role === 'analyst' ? 'Analyst' : 'Producer'}\n                </button>\n              ))}\n            </div>\n            <div className=\"relative\">\n              <MagnifyingGlassIcon className=\"w-4 h-4 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"text\"\n                placeholder={`Search ${targetWagMag} talent...`}\n                value={search}\n                onChange={e => setSearch(e.target.value)}\n                className=\"w-full pl-9 pr-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto p-3 space-y-1.5\">\n            {talentLoading ? (\n              <div className=\"text-center py-8 text-zinc-500 text-sm\">Loading...</div>\n            ) : sortedAvailable.length === 0 ? (\n              <div className=\"text-center py-8 text-zinc-500 text-sm\">No talent found</div>\n            ) : (\n              sortedAvailable.map(talent => (\n                <div\n                  key={talent.id}\n                  className=\"bg-zinc-800 hover:bg-zinc-750 border border-zinc-700 rounded-lg px-3 py-2.5 group\"\n                >\n                  <div className=\"flex items-start gap-2\">\n                    <div className=\"flex-1 min-w-0\">\n                      <div className=\"flex items-center gap-1.5 mb-0.5\">\n                        <span className=\"text-sm font-medium text-white truncate\">{talent.name}</span>\n                        <span className={`flex-shrink-0 px-1.5 py-0.5 rounded text-xs ${getStatusColor(talent.status)}`}>\n                          {getStatusLabel(talent.status)}\n                        </span>\n                      </div>\n                      <div className=\"text-xs text-zinc-500 truncate\">\n                        {talent.commentaryRole}{talent.affiliation ? ` · ${talent.affiliation}` : ''}\n                      </div>\n                      {talent.phone && (\n                        <a href={`tel:${talent.phone}`} className=\"text-xs text-blue-500 hover:text-blue-400 flex items-center gap-1 mt-0.5\">\n                          <PhoneIcon className=\"w-2.5 h-2.5\" />\n                          {talent.phone}\n                        </a>\n                      )}\n                    </div>\n                    <button\n                      onClick={() => handleAssign(talent)}\n                      className=\"flex-shrink-0 p-1.5 bg-blue-600 hover:bg-blue-500 rounded transition-colors opacity-0 group-hover:opacity-100\"\n                      title={`Add as ${getRoleLabel(activeRole)}`}\n                    >\n                      <PlusIcon className=\"w-3.5 h-3.5\" />\n                    </button>\n                  </div>\n                </div>\n              ))\n            )}\n          </div>\n\n          <div className=\"p-3 border-t border-zinc-800\">\n            <Link\n              to=\"/talent\"\n              className=\"w-full flex items-center justify-center gap-2 py-2 bg-zinc-800 hover:bg-zinc-700 rounded-lg text-xs text-zinc-400 hover:text-white transition-colors\"\n            >\n              <UserGroupIcon className=\"w-4 h-4\" />\n              View full roster\n            </Link>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","numLines":368,"startLine":1,"totalLines":368}}}
