{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X2e25Peo6fyBb7hqBuEPWG","type":"tool_result","content":"  2850→});\n  2851→\n  2852→// ============================================\n  2853→// Booking & Talent Management API Endpoints\n  2854→// ============================================\n  2855→\n  2856→// POST /api/book/generate - Generate a booking token for talent invitation\n  2857→app.post('/api/book/generate', async (req, res) => {\n  2858→  const { talentId, compId, role } = req.body;\n  2859→\n  2860→  if (!talentId || !compId || !role) {\n  2861→    return res.status(400).json({\n  2862→      error: 'Missing required fields',\n  2863→      required: ['talentId', 'compId', 'role']\n  2864→    });\n  2865→  }\n  2866→\n  2867→  try {\n  2868→    const db = productionConfigService.getDb();\n  2869→    if (!db) {\n  2870→      return res.status(503).json({ error: 'Firebase not available' });\n  2871→    }\n  2872→\n  2873→    // Generate unique token\n  2874→    const token = randomUUID();\n  2875→    const now = new Date().toISOString();\n  2876→    const expiresAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString(); // 30 days\n  2877→\n  2878→    // Write token to Firebase\n  2879→    await db.ref(`bookingTokens/${token}`).set({\n  2880→      talentId,\n  2881→      compId,\n  2882→      role,\n  2883→      createdAt: now,\n  2884→      expiresAt,\n  2885→      responded: false\n  2886→    });\n  2887→\n  2888→    // Update competition commentary status\n  2889→    await db.ref(`competitions/${compId}/commentary/${talentId}`).update({\n  2890→      status: 'invited',\n  2891→      invitedAt: now\n  2892→    });\n  2893→\n  2894→    const url = `https://commentarygraphic.com/book/${token}`;\n  2895→\n  2896→    res.json({\n  2897→      token,\n  2898→      url,\n  2899→      expiresAt\n  2900→    });\n  2901→  } catch (error) {\n  2902→    console.error('[Booking] Failed to generate booking token:', error);\n  2903→    res.status(500).json({ error: error.message });\n  2904→  }\n  2905→});\n  2906→\n  2907→// POST /api/talent/:talentId/notes/parse - Parse talent notes for availability hints\n  2908→app.post('/api/talent/:talentId/notes/parse', async (req, res) => {\n  2909→  const { talentId } = req.params;\n  2910→  const { noteText } = req.body;\n  2911→\n  2912→  if (!noteText) {\n  2913→    return res.status(400).json({\n  2914→      error: 'Missing required field',\n  2915→      required: ['noteText']\n  2916→    });\n  2917→  }\n  2918→\n  2919→  // Check if ANTHROPIC_API_KEY is configured\n  2920→  if (!process.env.ANTHROPIC_API_KEY) {\n  2921→    return res.status(503).json({\n  2922→      error: 'AI note parsing not configured',\n  2923→      message: 'ANTHROPIC_API_KEY not set in server environment'\n  2924→    });\n  2925→  }\n  2926→\n  2927→  try {\n  2928→    const db = productionConfigService.getDb();\n  2929→    if (!db) {\n  2930→      return res.status(503).json({ error: 'Firebase not available' });\n  2931→    }\n  2932→\n  2933→    // Initialize Anthropic client\n  2934→    const anthropic = new Anthropic({\n  2935→      apiKey: process.env.ANTHROPIC_API_KEY\n  2936→    });\n  2937→\n  2938→    // Call Claude API to extract date hints\n  2939→    const message = await anthropic.messages.create({\n  2940→      model: 'claude-haiku-4-5-20251001',\n  2941→      max_tokens: 512,\n  2942→      messages: [{\n  2943→        role: 'user',\n  2944→        content: `Extract any date mentions or availability hints from this note about a gymnastics commentator's availability.\n  2945→Return JSON only (no markdown code blocks) with this structure:\n  2946→{\n  2947→  \"availablePeriods\": [\"late February\", \"first week of March\"],\n  2948→  \"unavailableDates\": [\"January 15\", \"Feb 20-22\"]\n  2949→}\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"06eeebf2-c804-48ef-8e0f-4a285f415442","uuid":"3a1f5df8-2b02-4562-946e-a2b08f1669c5","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/server/index.js","content":"});\n\n// ============================================\n// Booking & Talent Management API Endpoints\n// ============================================\n\n// POST /api/book/generate - Generate a booking token for talent invitation\napp.post('/api/book/generate', async (req, res) => {\n  const { talentId, compId, role } = req.body;\n\n  if (!talentId || !compId || !role) {\n    return res.status(400).json({\n      error: 'Missing required fields',\n      required: ['talentId', 'compId', 'role']\n    });\n  }\n\n  try {\n    const db = productionConfigService.getDb();\n    if (!db) {\n      return res.status(503).json({ error: 'Firebase not available' });\n    }\n\n    // Generate unique token\n    const token = randomUUID();\n    const now = new Date().toISOString();\n    const expiresAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString(); // 30 days\n\n    // Write token to Firebase\n    await db.ref(`bookingTokens/${token}`).set({\n      talentId,\n      compId,\n      role,\n      createdAt: now,\n      expiresAt,\n      responded: false\n    });\n\n    // Update competition commentary status\n    await db.ref(`competitions/${compId}/commentary/${talentId}`).update({\n      status: 'invited',\n      invitedAt: now\n    });\n\n    const url = `https://commentarygraphic.com/book/${token}`;\n\n    res.json({\n      token,\n      url,\n      expiresAt\n    });\n  } catch (error) {\n    console.error('[Booking] Failed to generate booking token:', error);\n    res.status(500).json({ error: error.message });\n  }\n});\n\n// POST /api/talent/:talentId/notes/parse - Parse talent notes for availability hints\napp.post('/api/talent/:talentId/notes/parse', async (req, res) => {\n  const { talentId } = req.params;\n  const { noteText } = req.body;\n\n  if (!noteText) {\n    return res.status(400).json({\n      error: 'Missing required field',\n      required: ['noteText']\n    });\n  }\n\n  // Check if ANTHROPIC_API_KEY is configured\n  if (!process.env.ANTHROPIC_API_KEY) {\n    return res.status(503).json({\n      error: 'AI note parsing not configured',\n      message: 'ANTHROPIC_API_KEY not set in server environment'\n    });\n  }\n\n  try {\n    const db = productionConfigService.getDb();\n    if (!db) {\n      return res.status(503).json({ error: 'Firebase not available' });\n    }\n\n    // Initialize Anthropic client\n    const anthropic = new Anthropic({\n      apiKey: process.env.ANTHROPIC_API_KEY\n    });\n\n    // Call Claude API to extract date hints\n    const message = await anthropic.messages.create({\n      model: 'claude-haiku-4-5-20251001',\n      max_tokens: 512,\n      messages: [{\n        role: 'user',\n        content: `Extract any date mentions or availability hints from this note about a gymnastics commentator's availability.\nReturn JSON only (no markdown code blocks) with this structure:\n{\n  \"availablePeriods\": [\"late February\", \"first week of March\"],\n  \"unavailableDates\": [\"January 15\", \"Feb 20-22\"]\n}","numLines":100,"startLine":2850,"totalLines":6969}}}
