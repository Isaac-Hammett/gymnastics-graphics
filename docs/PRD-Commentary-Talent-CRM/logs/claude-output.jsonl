     (row.autoAdvance || row.auto_advance || row.auto || '').toLowerCase()\n  3049→      );\n  3050→\n  3051→      // Build segment object\n  3052→      const segment = {\n  3053→        id,\n  3054→        name: row.name || row.segment_name || row.title || `Segment ${index + 1}`,\n  3055→        type: row.type || 'live',\n  3056→        obsScene: row.obsScene || row.obs_scene || row.scene || null,\n  3057→        duration,\n  3058→        autoAdvance,\n  3059→        notes: row.notes || row.description || null,\n  3060→        videoFile: row.videoFile || row.video_file || row.video || null\n  3061→      };\n  3062→\n  3063→      // Add graphic if specified\n  3064→      if (row.graphic) {\n  3065→        segment.graphic = row.graphic;\n  3066→\n  3067→        // Parse graphicData if provided as JSON string\n  3068→        if (row.graphicData || row.graphic_data) {\n  3069→          try {\n  3070→            segment.graphicData = JSON.parse(row.graphicData || row.graphic_data);\n  3071→          } catch (e) {\n  3072→            // If not valid JSON, try to parse as key=value pairs\n  3073→            const data = {};\n  3074→            const dataStr = row.graphicData || row.graphic_data;\n  3075→            if (dataStr.includes('=')) {\n  3076→              dataStr.split(';').forEach(pair => {\n  3077→                const [key, value] = pair.split('=');\n  3078→                if (key && value) data[key.trim()] = value.trim();\n  3079→              });\n  3080→              segment.graphicData = data;\n  3081→            }\n  3082→          }\n  3083→        }\n  3084→      }\n  3085→\n  3086→      return segment;\n  3087→    });\n  3088→\n  3089→    // Build the show config\n  3090→    const newConfig = {\n  3091→      showName,\n  3092→      segments,\n  3093→      sponsors: showConfig?.sponsors || {},\n  3094→      quickActions: showConfig?.quickActions || []\n  3095→    };\n  3096→\n  3097→    // Save to file\n  3098→    const configPath = join(__dirname, 'co