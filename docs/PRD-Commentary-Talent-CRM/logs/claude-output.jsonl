{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LgsF2kHwno7XqN9K3pDudH","type":"tool_result","content":"     1→import { useState, useEffect, useMemo } from 'react';\n     2→import { Link, useNavigate } from 'react-router-dom';\n     3→import { useCompetitions, checkVmStatus } from '../hooks/useCompetitions';\n     4→import { useVMPool, VM_STATUS } from '../hooks/useVMPool';\n     5→import { useCoordinator, COORDINATOR_STATUS } from '../hooks/useCoordinator';\n     6→import CoordinatorStatus from '../components/CoordinatorStatus';\n     7→import { competitionTypes, teamCounts, typeLabels } from '../lib/graphicButtons';\n     8→import { useTeamsDatabase } from '../hooks/useTeamsDatabase';\n     9→import { useHeadCoach } from '../hooks/useRoadToNationals';\n    10→import { getGenderFromCompType, buildTeamKey } from '../lib/competitionUtils';\n    11→import { ExclamationTriangleIcon, CheckCircleIcon, UserIcon } from '@heroicons/react/24/solid';\n    12→import StatsStatusBadge from '../components/StatsStatusBadge';\n    13→import StatsDetailPanel from '../components/StatsDetailPanel';\n    14→import RankingsPanel from '../components/RankingsPanel';\n    15→import { db, ref, onValue } from '../lib/firebase';\n    16→\n    17→/**\n    18→ * HomePage - Consolidated landing page combining:\n    19→ * - CompetitionSelector: Competition list, VM assignment, coordinator status\n    20→ * - HubPage: Links to all tools and overlays\n    21→ * - DashboardPage: Create/edit competition functionality\n    22→ *\n    23→ * URL: /\n    24→ */\n    25→export default function HomePage() {\n    26→  const {\n    27→    competitions,\n    28→    loading,\n    29→    error,\n    30→    createCompetition,\n    31→    updateCompetition,\n    32→    deleteCompetition,\n    33→    duplicateCompetition,\n    34→    refreshTeamData\n    35→  } = useCompetitions();\n    36→  const {\n    37→    vms,\n    38→    availableVMs,\n    39→    assignVM,\n    40→    releaseVM,\n    41→    getVMForCompetition,\n    42→    hasVMAssigned,\n    43→    loading: vmPoolLoading,\n    44→  } = useVMPool();\n    45→  const {\n    46→    status: coordinatorStatus,\n    47→    isWaking,\n    48→    error: coordinatorError,\n    49→    wake,\n    50→  } = useCoordinator();\n    51→  const { getTeamLogo } = useTeamsDatabase();\n    52→\n    53→  const [searchQuery, setSearchQuery] = useState('');\n    54→  const [vmStatuses, setVmStatuses] = useState({});\n    55→  const [assigningVm, setAssigningVm] = useState(null);\n    56→  const [releasingVm, setReleasingVm] = useState(null);\n    57→  const [showPastCompetitions, setShowPastCompetitions] = useState(false);\n    58→  const navigate = useNavigate();\n    59→\n    60→  // Modal state for create/edit\n    61→  const [showModal, setShowModal] = useState(false);\n    62→  const [editingCompId, setEditingCompId] = useState(null);\n    63→  const [formData, setFormData] = useState(getDefaultFormData());\n    64→  const [virtiusSessionId, setVirtiusSessionId] = useState('');\n    65→  const [virtiusFetching, setVirtiusFetching] = useState(false);\n    66→  const [virtiusError, setVirtiusError] = useState(null);\n    67→  const [refreshing, setRefreshing] = useState(false);\n    68→  const [refreshResult, setRefreshResult] = useState(null); // 'success' | 'error' | null\n    69→  const [availableThemes, setAvailableThemes] = useState({});\n    70→\n    71→  // Load meet themes from Firebase\n    72→  useEffect(() => {\n    73→    const themesRef = ref(db, 'themes');\n    74→    const unsubscribe = onValue(themesRef, (snapshot) => {\n    75→      setAvailableThemes(snapshot.val() || {});\n    76→    });\n    77→    return () => unsubscribe();\n    78→  }, []);\n    79→\n    80→  // Coordinator status helpers\n    81→  const isCoordinatorOffline = coordinatorStatus === COORDINATOR_STATUS.OFFLINE;\n    82→  const isCoordinatorStarting = coordinatorStatus === COORDINATOR_STATUS.STARTING;\n    83→\n    84→  function getDefaultFormData() {\n    85→    return {\n    86→      compId: '',\n    87→      compType: '',\n    88→      gender: '',\n    89→      meetTheme: '',\n    90→      eventName: '',\n    91→      meetDate: '',\n    92→      venue: '',\n    93→      location: '',\n    94→      team1Name: '', team1Logo: '', team1Tricode: '',\n    95→      team2Name: '', team2Logo: '', team2Tricode: '',\n    96→      team3Name: '', team3Logo: '', team3Tricode: '',\n    97→      team4Name: '', team4Logo: '', team4Tricode: '',\n    98→      team5Name: '', team5Logo: '', team5Tricode: '',\n    99→      team6Name: '', team6Logo: '', team6Tricode: '',\n   100→      team7Name: '', team7Logo: '', team7Tricode: '',\n   101→    };\n   102→  }\n   103→\n   104→  function generateCompId() {\n   105→    const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';\n   106→    let result = '';\n   107→    for (let i = 0; i < 8; i++) {\n   108→      result += chars.charAt(Math.floor(Math.random() * chars.length));\n   109→    }\n   110→    return result;\n   111→  }\n   112→\n   113→  // Group competitions by date\n   114→  const groupedCompetitions = useMemo(() => {\n   115→    const now = new Date();\n   116→    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());\n   117→    const tomorrow = new Date(today);\n   118→    tomorrow.setDate(tomorrow.getDate() + 1);\n   119→\n   120→    const groups = {\n   121→      today: [],\n   122→      tomorrow: [],\n   123→      upcoming: [],\n   124→      past: []\n   125→    };\n   126→\n   127→    Object.entries(competitions).forEach(([compId, data]) => {\n   128→      const config = data?.config;\n   129→      if (!config) return;\n   130→\n   131→      const searchLower = searchQuery.toLowerCase();\n   132→      const matchesSearch = !searchQuery ||\n   133→        config.eventName?.toLowerCase().includes(searchLower) ||\n   134→        config.venue?.toLowerCase().includes(searchLower) ||\n   135→        config.team1Name?.toLowerCase().includes(searchLower) ||\n   136→        config.team2Name?.toLowerCase().includes(searchLower) ||\n   137→        compId.toLowerCase().includes(searchLower);\n   138→\n   139→      if (!matchesSearch) return;\n   140→\n   141→      const meetDate = config.meetDate ? new Date(config.meetDate) : null;\n   142→      const competition = { compId, config, meetDate };\n   143→\n   144→      if (!meetDate) {\n   145→        groups.upcoming.push(competition);\n   146→      } else if (meetDate >= today && meetDate < tomorrow) {\n   147→        groups.today.push(competition);\n   148→      } else if (meetDate >= tomorrow && meetDate < new Date(tomorrow.getTime() + 86400000)) {\n   149→        groups.tomorrow.push(competition);\n   150→      } else if (meetDate >= today) {\n   151→        groups.upcoming.push(competition);\n   152→      } else {\n   153→        groups.past.push(competition);\n   154→      }\n   155→    });\n   156→\n   157→    const sortByDate = (a, b) => {\n   158→      if (!a.meetDate && !b.meetDate) return 0;\n   159→      if (!a.meetDate) return 1;\n   160→      if (!b.meetDate) return -1;\n   161→      return a.meetDate - b.meetDate;\n   162→    };\n   163→\n   164→    groups.today.sort(sortByDate);\n   165→    groups.tomorrow.sort(sortByDate);\n   166→    groups.upcoming.sort(sortByDate);\n   167→    groups.past.sort((a, b) => sortByDate(b, a));\n   168→\n   169→    return groups;\n   170→  }, [competitions, searchQuery]);\n   171→\n   172→  // Check VM status for competitions (routes through coordinator in production)\n   173→  useEffect(() => {\n   174→    const checkStatuses = async () => {\n   175→      for (const [compId, data] of Object.entries(competitions)) {\n   176→        const vmAddress = data?.config?.vmAddress;\n   177→        if (!vmAddress) {\n   178→          setVmStatuses(prev => ({ ...prev, [compId]: { online: false, noVm: true } }));\n   179→          continue;\n   180→        }\n   181→\n   182→        const status = await checkVmStatus(vmAddress, 5000, compId);\n   183→        setVmStatuses(prev => ({ ...prev, [compId]: status }));\n   184→      }\n   185→    };\n   186→\n   187→    checkStatuses();\n   188→  }, [competitions]);\n   189→\n   190→  // VM assignment handlers\n   191→  const handleAssignVM = async (compId) => {\n   192→    setAssigningVm(compId);\n   193→    const result = await assignVM(compId);\n   194→    setAssigningVm(null);\n   195→    if (!result.success) {\n   196→      console.error('Failed to assign VM:', result.error);\n   197→    }\n   198→  };\n   199→\n   200→  const handleReleaseVM = async (compId) => {\n   201→    setReleasingVm(compId);\n   202→    const result = await releaseVM(compId);\n   203→    setReleasingVm(null);\n   204→    if (!result.success) {\n   205→      console.error('Failed to release VM:', result.error);\n   206→    }\n   207→  };\n   208→\n   209→  // Virtius import\n   210→  function formatDate(dateStr) {\n   211→    if (!dateStr) return '';\n   212→    const date = new Date(dateStr + 'T00:00:00');\n   213→    return date.toLocaleDateString('en-US', {\n   214→      year: 'numeric', month: 'long', day: 'numeric'\n   215→    });\n   216→  }\n   217→\n   218→  function inferCompType(sex, teamCount) {\n   219→    const prefix = sex === 'women' ? 'womens' : 'mens';\n   220→    const suffix = teamCount === 2 ? 'dual' :\n   221→                   teamCount === 3 ? 'tri' :\n   222→                   teamCount === 4 ? 'quad' :\n   223→                   `${teamCount}`;\n   224→    return `${prefix}-${suffix}`;\n   225→  }\n   226→\n   227→  async function fetchFromVirtius() {\n   228→    if (!virtiusSessionId.trim()) return;\n   229→    setVirtiusFetching(true);\n   230→    setVirtiusError(null);\n   231→\n   232→    try {\n   233→      const response = await fetch(`https://api.virti.us/session/${virtiusSessionId.trim()}/json`);\n   234→      if (!response.ok) throw new Error('Session not found');\n   235→      const data = await response.json();\n   236→\n   237→      const meet = data.meet;\n   238→      const teams = meet.teams || [];\n   239→      const sortedTeams = [...teams].sort((a, b) => (a.team_order || 0) - (b.team_order || 0));\n   240→      const compType = inferCompType(meet.sex, sortedTeams.length);\n   241→      const gender = meet.sex === 'women' ? 'womens' : 'mens';\n   242→\n   243→      setFormData(prev => ({\n   244→        ...prev,\n   245→        eventName: meet.name || prev.eventName,\n   246→        meetDate: formatDate(meet.meet_date) || prev.meetDate,\n   247→        venue: meet.location?.split(',')[0]?.trim() || prev.venue,\n   248→        location: meet.location?.split(',').slice(1).join(',').trim() || prev.location,\n   249→        compType,\n   250→        gender,\n   251→        team1Name: sortedTeams[0]?.name || prev.team1Name,\n   252→        team1Logo: getTeamLogo(sortedTeams[0]?.name, gender) || prev.team1Logo,\n   253→        team1Tricode: sortedTeams[0]?.tricode || prev.team1Tricode,\n   254→        team2Name: sortedTeams[1]?.name || prev.team2Name,\n   255→        team2Logo: getTeamLogo(sortedTeams[1]?.name, gender) || prev.team2Logo,\n   256→        team2Tricode: sortedTeams[1]?.tricode || prev.team2Tricode,\n   257→        team3Name: sortedTeams[2]?.name || prev.team3Name,\n   258→        team3Logo: getTeamLogo(sortedTeams[2]?.name, gender) || prev.team3Logo,\n   259→        team3Tricode: sortedTeams[2]?.tricode || prev.team3Tricode,\n   260→        team4Name: sortedTeams[3]?.name || prev.team4Name,\n   261→        team4Logo: getTeamLogo(sortedTeams[3]?.name, gender) || prev.team4Logo,\n   262→        team4Tricode: sortedTeams[3]?.tricode || prev.team4Tricode,\n   263→        team5Name: sortedTeams[4]?.name || prev.team5Name,\n   264→        team5Logo: getTeamLogo(sortedTeams[4]?.name, gender) || prev.team5Logo,\n   265→        team5Tricode: sortedTeams[4]?.tricode || prev.team5Tricode,\n   266→        team6Name: sortedTeams[5]?.name || prev.team6Name,\n   267→        team6Logo: getTeamLogo(sortedTeams[5]?.name, gender) || prev.team6Logo,\n   268→        team6Tricode: sortedTeams[5]?.tricode || prev.team6Tricode,\n   269→        team7Name: sortedTeams[6]?.name || prev.team7Name,\n   270→        team7Logo: getTeamLogo(sortedTeams[6]?.name, gender) || prev.team7Logo,\n   271→        team7Tricode: sortedTeams[6]?.tricode || prev.team7Tricode,\n   272→        virtiusSessionId: virtiusSessionId.trim(),\n   273→      }));\n   274→    } catch (error) {\n   275→      setVirtiusError('Could not fetch Virtius session. Check the session ID and try again.');\n   276→    } finally {\n   277→      setVirtiusFetching(false);\n   278→    }\n   279→  }\n   280→\n   281→  // Modal handlers\n   282→  function openCreateModal() {\n   283→    setEditingCompId(null);\n   284→    setFormData({ ...getDefaultFormData(), compId: generateCompId() });\n   285→    setVirtiusSessionId('');\n   286→    setVirtiusError(null);\n   287→    setShowModal(true);\n   288→  }\n   289→\n   290→  function openEditModal(compId) {\n   291→    const config = competitions[compId]?.config || {};\n   292→    setEditingCompId(compId);\n   293→    const gender = config.gender || getGenderFromCompType(config.compType) || 'mens';\n   294→    setFormData({\n   295→      compId,\n   296→      compType: config.compType || 'mens-dual',\n   297→      gender,\n   298→      meetTheme: config.meetTheme || '',\n   299→      eventName: config.eventName || '',\n   300→      meetDate: config.meetDate || '',\n   301→      venue: config.venue || '',\n   302→      location: config.location || '',\n   303→      team1Name: config.team1Name || '', team1Logo: config.team1Logo || '', team1Tricode: config.team1Tricode || '',\n   304→      team2Name: config.team2Name || '', team2Logo: config.team2Logo || '', team2Tricode: config.team2Tricode || '',\n   305→      team3Name: config.team3Name || '', team3Logo: config.team3Logo || '', team3Tricode: config.team3Tricode || '',\n   306→      team4Name: config.team4Name || '', team4Logo: config.team4Logo || '', team4Tricode: config.team4Tricode || '',\n   307→      team5Name: config.team5Name || '', team5Logo: config.team5Logo || '', team5Tricode: config.team5Tricode || '',\n   308→      team6Name: config.team6Name || '', team6Logo: config.team6Logo || '', team6Tricode: config.team6Tricode || '',\n   309→      team7Name: config.team7Name || '', team7Logo: config.team7Logo || '', team7Tricode: config.team7Tricode || '',\n   310→      virtiusSessionId: config.virtiusSessionId || '',\n   311→    });\n   312→    setVirtiusSessionId(config.virtiusSessionId || '');\n   313→    setVirtiusError(null);\n   314→    setShowModal(true);\n   315→  }\n   316→\n   317→  async function handleSubmit(e) {\n   318→    e.preventDefault();\n   319→    const compId = formData.compId.toLowerCase().trim();\n   320→    const gender = formData.gender || getGenderFromCompType(formData.compType) || 'mens';\n   321→\n   322→    const config = {\n   323→      compType: formData.compType,\n   324→      gender,\n   325→      meetTheme: formData.meetTheme || '',\n   326→      eventName: formData.eventName,\n   327→      meetDate: formData.meetDate,\n   328→      venue: formData.venue,\n   329→      location: formData.location,\n   330→      virtiusSessionId: formData.virtiusSessionId || '',\n   331→      team1Name: formData.team1Name,\n   332→      team1Logo: formData.team1Logo || 'https://via.placeholder.com/200/00274C/FFCB05?text=T1',\n   333→      team1Tricode: formData.team1Tricode || '',\n   334→      team1Key: formData.team1Name ? buildTeamKey(formData.team1Name, gender) : '',\n   335→      team2Name: formData.team2Name,\n   336→      team2Logo: formData.team2Logo || 'https://via.placeholder.com/200/BB0000/FFFFFF?text=T2',\n   337→      team2Tricode: formData.team2Tricode || '',\n   338→      team2Key: formData.team2Name ? buildTeamKey(formData.team2Name, gender) : '',\n   339→      team3Name: formData.team3Name,\n   340→      team3Logo: formData.team3Logo || 'https://via.placeholder.com/200/006400/FFFFFF?text=T3',\n   341→      team3Tricode: formData.team3Tricode || '',\n   342→      team3Key: formData.team3Name ? buildTeamKey(formData.team3Name, gender) : '',\n   343→      team4Name: formData.team4Name,\n   344→      team4Logo: formData.team4Logo || 'https://via.placeholder.com/200/800080/FFFFFF?text=T4',\n   345→      team4Tricode: formData.team4Tricode || '',\n   346→      team4Key: formData.team4Name ? buildTeamKey(formData.team4Name, gender) : '',\n   347→      team5Name: formData.team5Name,\n   348→      team5Logo: formData.team5Logo || 'https://via.placeholder.com/200/FF6600/FFFFFF?text=T5',\n   349→      team5Tricode: formData.team5Tricode || '',\n   350→      team5Key: formData.team5Name ? buildTeamKey(formData.team5Name, gender) : '',\n   351→      team6Name: formData.team6Name,\n   352→      team6Logo: formData.team6Logo || 'https://via.placeholder.com/200/000080/FFFFFF?text=T6',\n   353→      team6Tricode: formData.team6Tricode || '',\n   354→      team6Key: formData.team6Name ? buildTeamKey(formData.team6Name, gender) : '',\n   355→      team7Name: formData.team7Name,\n   356→      team7Logo: formData.team7Logo || 'https://via.placeholder.com/200/000080/FFFFFF?text=T7',\n   357→      team7Tricode: formData.team7Tricode || '',\n   358→      team7Key: formData.team7Name ? buildTeamKey(formData.team7Name, gender) : '',\n   359→      hosts: 'Host Name',\n   360→      team1Ave: '0.000', team1High: '0.000', team1Con: '0%', team1Coaches: 'Coach Name',\n   361→      team2Ave: '0.000', team2High: '0.000', team2Con: '0%', team2Coaches: 'Coach Name',\n   362→      team3Ave: '0.000', team3High: '0.000', team3Con: '0%', team3Coaches: 'Coach Name',\n   363→      team4Ave: '0.000', team4High: '0.000', team4Con: '0%', team4Coaches: 'Coach Name',\n   364→      team5Ave: '0.000', team5High: '0.000', team5Con: '0%', team5Coaches: 'Coach Name',\n   365→      team6Ave: '0.000', team6High: '0.000', team6Con: '0%', team6Coaches: 'Coach Name',\n   366→    };\n   367→\n   368→    if (editingCompId) {\n   369→      await updateCompetition(editingCompId, config);\n   370→    } else {\n   371→      await createCompetition(compId, config);\n   372→    }\n   373→\n   374→    setShowModal(false);\n   375→  }\n   376→\n   377→  async function handleDelete() {\n   378→    if (!editingCompId) return;\n   379→    if (window.confirm(`Are you sure you want to delete competition \"${editingCompId}\"? This cannot be undone.`)) {\n   380→      await deleteCompetition(editingCompId);\n   381→      setShowModal(false);\n   382→    }\n   383→  }\n   384→\n   385→  async function handleDuplicate(compId) {\n   386→    const newCompId = window.prompt(`Duplicate \"${compId}\" as:\\n\\nEnter new competition ID (lowercase, no spaces):`, compId + '-copy');\n   387→    if (!newCompId) return;\n   388→\n   389→    if (!/^[a-z0-9-]+$/.test(newCompId)) {\n   390→      alert('Competition ID can only contain lowercase letters, numbers, and hyphens.');\n   391→      return;\n   392→    }\n   393→\n   394→    if (competitions[newCompId]) {\n   395→      alert(`Competition \"${newCompId}\" already exists. Please choose a different ID.`);\n   396→      return;\n   397→    }\n   398→\n   399→    await duplicateCompetition(compId, newCompId);\n   400→  }\n   401→\n   402→  async function handleDeleteFromCard(compId) {\n   403→    if (window.confirm(`Are you sure you want to delete \"${compId}\"?\\n\\nThis will permanently delete:\\n- All configuration\\n- Current graphic state\\n- All data for this competition\\n\\nThis cannot be undone.`)) {\n   404→      await deleteCompetition(compId);\n   405→    }\n   406→  }\n   407→\n   408→  async function handleRefreshTeamData() {\n   409→    if (!editingCompId) return;\n   410→    setRefreshing(true);\n   411→    setRefreshResult(null);\n   412→    try {\n   413→      const result = await refreshTeamData(editingCompId);\n   414→      setRefreshResult(result?.success ? 'success' : 'error');\n   415→    } catch (err) {\n   416→      console.error('Failed to refresh team data:', err);\n   417→      setRefreshResult('error');\n   418→    }\n   419→    setRefreshing(false);\n   420→    // Auto-clear the result message after 4 seconds\n   421→    setTimeout(() => setRefreshResult(null), 4000);\n   422→  }\n   423→\n   424→  // Helper functions\n   425→  const getGenderBadge = (config) => {\n   426→    const gender = config?.gender || (config?.compType?.includes('womens') ? 'womens' : 'mens');\n   427→    const isWomens = gender === 'womens' || gender === 'WAG';\n   428→    return {\n   429→      label: isWomens ? 'WAG' : 'MAG',\n   430→      color: isWomens ? 'bg-pink-500' : 'bg-blue-500'\n   431→    };\n   432→  };\n   433→\n   434→  const getTeams = (config) => {\n   435→    return [\n   436→      config?.team1Name, config?.team2Name, config?.team3Name,\n   437→      config?.team4Name, config?.team5Name, config?.team6Name, config?.team7Name\n   438→    ].filter(Boolean);\n   439→  };\n   440→\n   441→  const formatDisplayDate = (date) => {\n   442→    if (!date) return 'No date set';\n   443→    return date.toLocaleDateString('en-US', {\n   444→      weekday: 'short', month: 'short', day: 'numeric', year: 'numeric'\n   445→    });\n   446→  };\n   447→\n   448→  const getVMStatusBadge = (compId) => {\n   449→    const vm = getVMForCompetition(compId);\n   450→    if (!vm) return null;\n   451→\n   452→    const statusConfig = {\n   453→      [VM_STATUS.AVAILABLE]: { color: 'bg-green-500', label: 'VM Ready' },\n   454→      [VM_STATUS.ASSIGNED]: { color: 'bg-blue-500', label: 'VM Assigned' },\n   455→      [VM_STATUS.IN_USE]: { color: 'bg-purple-500', label: 'VM In Use' },\n   456→      [VM_STATUS.STARTING]: { color: 'bg-yellow-500', label: 'VM Starting' },\n   457→      [VM_STATUS.STOPPING]: { color: 'bg-orange-500', label: 'VM Stopping' },\n   458→      [VM_STATUS.ERROR]: { color: 'bg-red-500', label: 'VM Error' },\n   459→    };\n   460→\n   461→    const cfg = statusConfig[vm.status] || { color: 'bg-zinc-500', label: vm.status };\n   462→    return { ...cfg, vm };\n   463→  };\n   464→\n   465→  const VmStatusIndicator = ({ compId }) => {\n   466→    const status = vmStatuses[compId];\n   467→    if (!status) {\n   468→      return <div className=\"w-3 h-3 rounded-full bg-zinc-600 animate-pulse\" title=\"Checking...\" />;\n   469→    }\n   470→    if (status.noVm) {\n   471→      return <div className=\"w-3 h-3 rounded-full bg-zinc-600\" title=\"No VM configured\" />;\n   472→    }\n   473→    if (status.online) {\n   474→      return (\n   475→        <div\n   476→          className={`w-3 h-3 rounded-full ${status.obsConnected ? 'bg-green-500' : 'bg-yellow-500'}`}\n   477→          title={status.obsConnected ? 'Online (OBS connected)' : 'Online (OBS disconnected)'}\n   478→        />\n   479→      );\n   480→    }\n   481→    return <div className=\"w-3 h-3 rounded-full bg-red-500\" title=\"Offline\" />;\n   482→  };\n   483→\n   484→  const teamCount = teamCounts[formData.compType] || 2;\n   485→\n   486→  const totalCompetitions = Object.keys(competitions).length;\n   487→  const filteredCount =\n   488→    groupedCompetitions.today.length +\n   489→    groupedCompetitions.tomorrow.length +\n   490→    groupedCompetitions.upcoming.length +\n   491→    groupedCompetitions.past.length;\n   492→\n   493→  // Loading state\n   494→  if (loading) {\n   495→    return (\n   496→      <div className=\"min-h-screen bg-zinc-950 flex items-center justify-center\">\n   497→        <div className=\"text-center\">\n   498→          <div className=\"w-10 h-10 border-4 border-blue-500 border-t-transparent rounded-full animate-spin mx-auto mb-4\" />\n   499→          <p className=\"text-zinc-400\">Loading...</p>\n   500→        </div>\n   501→      </div>\n   502→    );\n   503→  }\n   504→\n   505→  // Error state\n   506→  if (error) {\n   507→    return (\n   508→      <div className=\"min-h-screen bg-zinc-950 flex items-center justify-center\">\n   509→        <div className=\"text-center\">\n   510→          <div className=\"text-red-500 text-4xl mb-4\">!</div>\n   511→          <h2 className=\"text-xl font-bold text-white mb-2\">Failed to Load</h2>\n   512→          <p className=\"text-zinc-400\">{error}</p>\n   513→        </div>\n   514→      </div>\n   515→    );\n   516→  }\n   517→\n   518→  return (\n   519→    <div className=\"min-h-screen bg-zinc-950 p-6 md:p-10\">\n   520→      <div className=\"max-w-6xl mx-auto\">\n   521→        {/* Header */}\n   522→        <div className=\"flex justify-between items-start mb-8\">\n   523→          <div className=\"flex-1 text-center\">\n   524→            <h1 className=\"text-3xl font-extrabold text-white mb-2\">Gymnastics Graphics</h1>\n   525→            <p className=\"text-zinc-500\">Control center for broadcast graphics</p>\n   526→          </div>\n   527→          <div className=\"absolute right-6 md:right-10 top-6 md:top-10\">\n   528→            <CoordinatorStatus />\n   529→          </div>\n   530→        </div>\n   531→\n   532→        {/* Offline Banner */}\n   533→        {isCoordinatorOffline && (\n   534→          <div className=\"bg-red-900/30 border-2 border-red-800 rounded-xl p-5 mb-8\">\n   535→            <div className=\"flex items-center justify-between flex-wrap gap-4\">\n   536→              <div className=\"flex items-center gap-3\">\n   537→                <div className=\"w-10 h-10 bg-red-900/50 rounded-full flex items-center justify-center\">\n   538→                  <span className=\"text-xl\">*</span>\n   539→                </div>\n   540→                <div>\n   541→                  <h3 className=\"text-lg font-bold text-white\">System is Sleeping</h3>\n   542→                  <p className=\"text-sm text-red-300/70\">\n   543→                    The coordinator is offline to save costs. VM operations are disabled.\n   544→                  </p>\n   545→                </div>\n   546→              </div>\n   547→              <button\n   548→                onClick={wake}\n   549→                disabled={isWaking}\n   550→                className={`px-5 py-2.5 text-sm font-bold rounded-lg transition-colors ${\n   551→                  isWaking\n   552→                    ? 'bg-zinc-700 text-zinc-400 cursor-not-allowed'\n   553→                    : 'bg-green-600 text-white hover:bg-green-500'\n   554→                }`}\n   555→              >\n   556→                {isWaking ? (\n   557→                  <span className=\"flex items-center gap-2\">\n   558→                    <span className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n   559→                    Starting System...\n   560→                  </span>\n   561→                ) : (\n   562→                  'Start System'\n   563→                )}\n   564→              </button>\n   565→            </div>\n   566→            {coordinatorError && (\n   567→              <div className=\"mt-3 text-sm text-red-400 bg-red-900/30 rounded-lg px-3 py-2\">\n   568→                Error: {coordinatorError}\n   569→              </div>\n   570→            )}\n   571→          </div>\n   572→        )}\n   573→\n   574→        {/* Starting Banner */}\n   575→        {isCoordinatorStarting && (\n   576→          <div className=\"bg-yellow-900/30 border-2 border-yellow-800 rounded-xl p-5 mb-8\">\n   577→            <div className=\"flex items-center gap-3\">\n   578→              <div className=\"w-10 h-10 bg-yellow-900/50 rounded-full flex items-center justify-center\">\n   579→                <span className=\"w-5 h-5 border-2 border-yellow-400 border-t-transparent rounded-full animate-spin\" />\n   580→              </div>\n   581→              <div>\n   582→                <h3 className=\"text-lg font-bold text-white\">System Starting</h3>\n   583→                <p className=\"text-sm text-yellow-300/70\">\n   584→                  The coordinator is starting up. This typically takes 60-90 seconds.\n   585→                </p>\n   586→              </div>\n   587→            </div>\n   588→          </div>\n   589→        )}\n   590→\n   591→        {/* Local Development Option */}\n   592→        <div className=\"bg-gradient-to-r from-zinc-900 to-zinc-800 border-2 border-zinc-700 rounded-xl p-5 mb-8\">\n   593→          <div className=\"flex items-center justify-between flex-wrap gap-4\">\n   594→            <div>\n   595→              <div className=\"flex items-center gap-2 mb-1\">\n   596→                <span className=\"text-lg\">$</span>\n   597→                <h3 className=\"text-lg font-bold text-white\">Local Development</h3>\n   598→              </div>\n   599→              <p className=\"text-sm text-zinc-400\">\n   600→                Connect to local server at localhost:3003\n   601→              </p>\n   602→            </div>\n   603→            <div className=\"flex gap-2\">\n   604→              <Link\n   605→                to=\"/local/producer\"\n   606→                className=\"px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-500 transition-colors\"\n   607→              >\n   608→                Producer\n   609→              </Link>\n   610→              <Link\n   611→                to=\"/local/talent\"\n   612→                className=\"px-4 py-2 bg-zinc-700 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-600 transition-colors\"\n   613→              >\n   614→                Talent\n   615→              </Link>\n   616→              <Link\n   617→                to=\"/local/camera-setup\"\n   618→                className=\"px-4 py-2 bg-zinc-700 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-600 transition-colors\"\n   619→              >\n   620→                Cameras\n   621→              </Link>\n   622→            </div>\n   623→          </div>\n   624→        </div>\n   625→\n   626→        {/* Search and Create */}\n   627→        <div className=\"flex flex-col sm:flex-row gap-4 mb-8\">\n   628→          <div className=\"flex-1\">\n   629→            <input\n   630→              type=\"text\"\n   631→              placeholder=\"Search competitions...\"\n   632→              value={searchQuery}\n   633→              onChange={(e) => setSearchQuery(e.target.value)}\n   634→              className=\"w-full px-4 py-3 bg-zinc-900 border border-zinc-700 rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500\"\n   635→            />\n   636→          </div>\n   637→          <button\n   638→            onClick={openCreateModal}\n   639→            className=\"px-6 py-3 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-500 transition-colors\"\n   640→          >\n   641→            + Create Competition\n   642→          </button>\n   643→        </div>\n   644→\n   645→        {searchQuery && (\n   646→          <p className=\"text-sm text-zinc-500 mb-4\">\n   647→            Showing {filteredCount} of {totalCompetitions} competitions\n   648→          </p>\n   649→        )}\n   650→\n   651→        {/* Competition Groups */}\n   652→        <CompetitionGroup\n   653→          title=\"Today\"\n   654→          competitions={groupedCompetitions.today}\n   655→          emptyMessage={!searchQuery ? \"No competitions scheduled for today\" : null}\n   656→          renderCard={(comp) => (\n   657→            <CompetitionCard\n   658→              key={comp.compId}\n   659→              competition={comp}\n   660→              vmStatuses={vmStatuses}\n   661→              getGenderBadge={getGenderBadge}\n   662→              getTeams={getTeams}\n   663→              formatDisplayDate={formatDisplayDate}\n   664→              getVMStatusBadge={getVMStatusBadge}\n   665→              hasVMAssigned={hasVMAssigned}\n   666→              availableVMs={availableVMs}\n   667→              isCoordinatorOffline={isCoordinatorOffline}\n   668→              assigningVm={assigningVm}\n   669→              releasingVm={releasingVm}\n   670→              onAssignVM={handleAssignVM}\n   671→              onReleaseVM={handleReleaseVM}\n   672→              onEdit={openEditModal}\n   673→              onDuplicate={handleDuplicate}\n   674→              onDelete={handleDeleteFromCard}\n   675→              VmStatusIndicator={VmStatusIndicator}\n   676→              navigate={navigate}\n   677→            />\n   678→          )}\n   679→        />\n   680→        <CompetitionGroup\n   681→          title=\"Tomorrow\"\n   682→          competitions={groupedCompetitions.tomorrow}\n   683→          renderCard={(comp) => (\n   684→            <CompetitionCard\n   685→              key={comp.compId}\n   686→              competition={comp}\n   687→              vmStatuses={vmStatuses}\n   688→              getGenderBadge={getGenderBadge}\n   689→              getTeams={getTeams}\n   690→              formatDisplayDate={formatDisplayDate}\n   691→              getVMStatusBadge={getVMStatusBadge}\n   692→              hasVMAssigned={hasVMAssigned}\n   693→              availableVMs={availableVMs}\n   694→              isCoordinatorOffline={isCoordinatorOffline}\n   695→              assigningVm={assigningVm}\n   696→              releasingVm={releasingVm}\n   697→              onAssignVM={handleAssignVM}\n   698→              onReleaseVM={handleReleaseVM}\n   699→              onEdit={openEditModal}\n   700→              onDuplicate={handleDuplicate}\n   701→              onDelete={handleDeleteFromCard}\n   702→              VmStatusIndicator={VmStatusIndicator}\n   703→              navigate={navigate}\n   704→            />\n   705→          )}\n   706→        />\n   707→        <CompetitionGroup\n   708→          title=\"Upcoming\"\n   709→          competitions={groupedCompetitions.upcoming}\n   710→          renderCard={(comp) => (\n   711→            <CompetitionCard\n   712→              key={comp.compId}\n   713→              competition={comp}\n   714→              vmStatuses={vmStatuses}\n   715→              getGenderBadge={getGenderBadge}\n   716→              getTeams={getTeams}\n   717→              formatDisplayDate={formatDisplayDate}\n   718→              getVMStatusBadge={getVMStatusBadge}\n   719→              hasVMAssigned={hasVMAssigned}\n   720→              availableVMs={availableVMs}\n   721→              isCoordinatorOffline={isCoordinatorOffline}\n   722→              assigningVm={assigningVm}\n   723→              releasingVm={releasingVm}\n   724→              onAssignVM={handleAssignVM}\n   725→              onReleaseVM={handleReleaseVM}\n   726→              onEdit={openEditModal}\n   727→              onDuplicate={handleDuplicate}\n   728→              onDelete={handleDeleteFromCard}\n   729→              VmStatusIndicator={VmStatusIndicator}\n   730→              navigate={navigate}\n   731→            />\n   732→          )}\n   733→        />\n   734→\n   735→        {/* Past competitions toggle */}\n   736→        {groupedCompetitions.past.length > 0 && (\n   737→          <div className=\"mb-8\">\n   738→            <button\n   739→              onClick={() => setShowPastCompetitions(!showPastCompetitions)}\n   740→              className=\"text-sm text-zinc-500 hover:text-white transition-colors flex items-center gap-2\"\n   741→            >\n   742→              <span>{showPastCompetitions ? 'v' : '>'}</span>\n   743→              Past Competitions ({groupedCompetitions.past.length})\n   744→            </button>\n   745→            {showPastCompetitions && (\n   746→              <div className=\"mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n   747→                {groupedCompetitions.past.map((comp) => (\n   748→                  <CompetitionCard\n   749→                    key={comp.compId}\n   750→                    competition={comp}\n   751→                    vmStatuses={vmStatuses}\n   752→                    getGenderBadge={getGenderBadge}\n   753→                    getTeams={getTeams}\n   754→                    formatDisplayDate={formatDisplayDate}\n   755→                    getVMStatusBadge={getVMStatusBadge}\n   756→                    hasVMAssigned={hasVMAssigned}\n   757→                    availableVMs={availableVMs}\n   758→                    isCoordinatorOffline={isCoordinatorOffline}\n   759→                    assigningVm={assigningVm}\n   760→                    releasingVm={releasingVm}\n   761→                    onAssignVM={handleAssignVM}\n   762→                    onReleaseVM={handleReleaseVM}\n   763→                    onEdit={openEditModal}\n   764→                    onDuplicate={handleDuplicate}\n   765→                    onDelete={handleDeleteFromCard}\n   766→                    VmStatusIndicator={VmStatusIndicator}\n   767→                    navigate={navigate}\n   768→                  />\n   769→                ))}\n   770→              </div>\n   771→            )}\n   772→          </div>\n   773→        )}\n   774→\n   775→        {/* No Results */}\n   776→        {filteredCount === 0 && !loading && (\n   777→          <div className=\"text-center py-12\">\n   778→            <div className=\"text-4xl mb-4\">?</div>\n   779→            <h3 className=\"text-xl font-bold text-white mb-2\">No competitions found</h3>\n   780→            <p className=\"text-zinc-400 mb-6\">\n   781→              {searchQuery\n   782→                ? `No competitions match \"${searchQuery}\"`\n   783→                : \"Create your first competition to get started\"}\n   784→            </p>\n   785→            <button\n   786→              onClick={openCreateModal}\n   787→              className=\"inline-block px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-500 transition-colors\"\n   788→            >\n   789→              Create Competition\n   790→            </button>\n   791→          </div>\n   792→        )}\n   793→\n   794→        {/* Management Tools Section */}\n   795→        <Section title=\"Management Tools\">\n   796→          <ToolCard\n   797→            to=\"/media-manager\"\n   798→            icon=\"[img]\"\n   799→            title=\"Media Manager\"\n   800→            description=\"Manage team logos and athlete headshots\"\n   801→          />\n   802→          <ToolCard\n   803→            to=\"/url-generator\"\n   804→            icon=\"[url]\"\n   805→            title=\"URL Generator\"\n   806→            description=\"Generate OBS overlay URLs\"\n   807→          />\n   808→          <ToolCard\n   809→            to=\"/graphics-manager\"\n   810→            icon=\"[gfx]\"\n   811→            title=\"Graphics Manager\"\n   812→            description=\"View all graphics, filter by category\"\n   813→          />\n   814→          <ToolCard\n   815→            to=\"/theme-editor\"\n   816→            icon=\"[theme]\"\n   817→            title=\"Theme Editor\"\n   818→            description=\"Create custom meet themes for branded graphics\"\n   819→          />\n   820→          <ToolCard\n   821→            to=\"/background-generator\"\n   822→            icon=\"[bg]\"\n   823→            title=\"Background Generator\"\n   824→            description=\"Create animated looping backgrounds from logo colors\"\n   825→          />\n   826→          <ToolCard\n   827→            to=\"/import\"\n   828→            icon=\"[csv]\"\n   829→            title=\"Import Shows\"\n   830→            description=\"Import show plans from CSV\"\n   831→          />\n   832→        </Section>\n   833→\n   834→        {/* System Administration Section */}\n   835→        <Section title=\"System Administration\">\n   836→          <ToolCard\n   837→            to=\"/_admin/vm-pool\"\n   838→            icon=\"[vm]\"\n   839→            title=\"VM Pool\"\n   840→            description=\"Manage EC2 instances\"\n   841→          />\n   842→          <ToolCard\n   843→            to=\"/_admin/setup-guide\"\n   844→            icon=\"[doc]\"\n   845→            title=\"Setup Guide\"\n   846→            description=\"Documentation for coordinator system\"\n   847→          />\n   848→          <ExternalToolCard\n   849→            href=\"/output.html\"\n   850→            icon=\"[out]\"\n   851→            title=\"Graphics Output\"\n   852→            description=\"View live graphics output\"\n   853→          />\n   854→        </Section>\n   855→\n   856→        {/* Overlay Templates Section */}\n   857→        <Section title=\"Overlay Templates\">\n   858→          <ExternalToolCard href=\"/overlays/logos.html\" icon=\"[logo]\" title=\"Team Logos\" description=\"Display team logos\" />\n   859→          <ExternalToolCard href=\"/overlays/team-stats.html\" icon=\"[stats]\" title=\"Team Stats\" description=\"Show team statistics\" />\n   860→          <ExternalToolCard href=\"/overlays/coaches.html\" icon=\"[coach]\" title=\"Coaches\" description=\"Display coaching staff\" />\n   861→          <ExternalToolCard href=\"/overlays/hosts.html\" icon=\"[host]\" title=\"Hosts\" description=\"Show broadcast hosts\" />\n   862→          <ExternalToolCard href=\"/overlays/event-bar.html\" icon=\"[bar]\" title=\"Event Bar\" description=\"Lower-third event info\" />\n   863→          <ExternalToolCard href=\"/overlays/event-frame.html\" icon=\"[frame]\" title=\"Event Frame\" description=\"Full-screen event title\" />\n   864→          <ExternalToolCard href=\"/overlays/stream.html\" icon=\"[stream]\" title=\"Stream Cards\" description=\"Starting/ending screens\" />\n   865→        </Section>\n   866→      </div>\n   867→\n   868→      {/* Create/Edit Competition Modal */}\n   869→      {showModal && (\n   870→        <CompetitionModal\n   871→          editingCompId={editingCompId}\n   872→          formData={formData}\n   873→          setFormData={setFormData}\n   874→          virtiusSessionId={virtiusSessionId}\n   875→          setVirtiusSessionId={setVirtiusSessionId}\n   876→          virtiusFetching={virtiusFetching}\n   877→          virtiusError={virtiusError}\n   878→          fetchFromVirtius={fetchFromVirtius}\n   879→          teamCount={teamCount}\n   880→          refreshing={refreshing}\n   881→          refreshResult={refreshResult}\n   882→          onSubmit={handleSubmit}\n   883→          onDelete={handleDelete}\n   884→          onRefreshTeamData={handleRefreshTeamData}\n   885→          onClose={() => setShowModal(false)}\n   886→          getTeamLogo={getTeamLogo}\n   887→          availableThemes={availableThemes}\n   888→        />\n   889→      )}\n   890→    </div>\n   891→  );\n   892→}\n   893→\n   894→// Competition Card Component\n   895→function CompetitionCard({\n   896→  competition,\n   897→  vmStatuses,\n   898→  getGenderBadge,\n   899→  getTeams,\n   900→  formatDisplayDate,\n   901→  getVMStatusBadge,\n   902→  hasVMAssigned,\n   903→  availableVMs,\n   904→  isCoordinatorOffline,\n   905→  assigningVm,\n   906→  releasingVm,\n   907→  onAssignVM,\n   908→  onReleaseVM,\n   909→  onEdit,\n   910→  onDuplicate,\n   911→  onDelete,\n   912→  VmStatusIndicator,\n   913→  navigate\n   914→}) {\n   915→  const { compId, config, meetDate } = competition;\n   916→  const genderBadge = getGenderBadge(config);\n   917→  const teams = getTeams(config);\n   918→  const vmBadge = getVMStatusBadge(compId);\n   919→  const hasVM = hasVMAssigned(compId);\n   920→  const isAssigning = assigningVm === compId;\n   921→  const isReleasing = releasingVm === compId;\n   922→  const canAssignVM = availableVMs.length > 0 && !hasVM && !isCoordinatorOffline;\n   923→  const canReleaseVM = hasVM && !isCoordinatorOffline;\n   924→\n   925→  return (\n   926→    <div className=\"bg-zinc-900 border-2 border-zinc-800 rounded-xl p-5 hover:border-zinc-700 transition-colors\">\n   927→      <div className=\"flex items-start justify-between mb-3\">\n   928→        <div className=\"flex items-center gap-2\">\n   929→          <VmStatusIndicator compId={compId} />\n   930→          <span className={`px-2 py-0.5 rounded text-xs font-bold text-white ${genderBadge.color}`}>\n   931→            {genderBadge.label}\n   932→          </span>\n   933→          {vmBadge && (\n   934→            <span\n   935→              className={`px-2 py-0.5 rounded text-xs font-bold text-white ${vmBadge.color} cursor-help`}\n   936→              title={vmBadge.vm.publicIp ? `IP: ${vmBadge.vm.publicIp}` : 'No IP assigned'}\n   937→            >\n   938→              {vmBadge.label}\n   939→            </span>\n   940→          )}\n   941→        </div>\n   942→        <span className=\"text-xs text-zinc-500\">{compId}</span>\n   943→      </div>\n   944→\n   945→      <h3 className=\"text-lg font-bold text-white mb-1\">\n   946→        {config?.eventName || 'Untitled Competition'}\n   947→      </h3>\n   948→\n   949→      <div className=\"text-sm text-zinc-400 mb-2\">\n   950→        {formatDisplayDate(meetDate)}\n   951→        {config?.venue && <span className=\"text-zinc-500\"> - {config.venue}</span>}\n   952→      </div>\n   953→\n   954→      {teams.length > 0 && (\n   955→        <div className=\"text-sm text-zinc-500 mb-2\">\n   956→          {teams.join(' vs ')}\n   957→        </div>\n   958→      )}\n   959→\n   960→      <div className=\"mb-3\">\n   961→        <StatsStatusBadge compId={compId} config={config} />\n   962→        <StatsDetailPanel compId={compId} config={config} />\n   963→        <RankingsPanel compId={compId} config={config} />\n   964→        <CommentaryStatusBadge compId={compId} />\n   965→      </div>\n   966→\n   967→      {vmBadge?.vm?.publicIp && (\n   968→        <div className=\"text-xs text-zinc-500 mb-3 font-mono\">\n   969→          VM: {vmBadge.vm.publicIp}\n   970→        </div>\n   971→      )}\n   972→\n   973→      {/* Action buttons - always navigate, CompetitionLayout handles VM errors */}\n   974→      <div className=\"flex gap-2 flex-wrap\">\n   975→        <Link\n   976→          to={`/${compId}/producer`}\n   977→          className=\"px-3 py-1.5 text-sm font-medium rounded-lg transition-colors bg-blue-600 text-white hover:bg-blue-500\"\n   978→        >\n   979→          Producer\n   980→        </Link>\n   981→        <Link\n   982→          to={`/${compId}/talent`}\n   983→          className=\"px-3 py-1.5 text-sm font-medium rounded-lg transition-colors bg-zinc-800 text-zinc-300 hover:bg-zinc-700\"\n   984→        >\n   985→          Talent\n   986→        </Link>\n   987→        <a\n   988→          href={`/output.html?comp=${compId}`}\n   989→          target=\"_blank\"\n   990→          rel=\"noopener noreferrer\"\n   991→          className=\"px-3 py-1.5 bg-zinc-800 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-700 transition-colors\"\n   992→        >\n   993→          Graphics\n   994→        </a>\n   995→        <Link\n   996→          to={`/${compId}/camera-setup`}\n   997→          className=\"px-3 py-1.5 bg-zinc-800 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-700 transition-colors\"\n   998→        >\n   999→          Cameras\n  1000→        </Link>\n  1001→        <Link\n  1002→          to={`/${compId}/checklist`}\n  1003→          className=\"px-3 py-1.5 bg-zinc-800 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-700 transition-colors\"\n  1004→        >\n  1005→          Checklist\n  1006→        </Link>\n  1007→        <Link\n  1008→          to={`/${compId}/commentary`}\n  1009→          className=\"px-3 py-1.5 bg-zinc-800 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-700 transition-colors\"\n  1010→        >\n  1011→          Commentary\n  1012→        </Link>\n  1013→      </div>\n  1014→\n  1015→      {/* VM & Edit Controls */}\n  1016→      <div className=\"flex gap-2 mt-3 pt-3 border-t border-zinc-800 flex-wrap\">\n  1017→        {!hasVM ? (\n  1018→          <button\n  1019→            onClick={() => onAssignVM(compId)}\n  1020→            disabled={!canAssignVM || isAssigning}\n  1021→            className={`px-3 py-1.5 text-sm font-medium rounded-lg transition-colors ${\n  1022→              canAssignVM && !isAssigning\n  1023→                ? 'bg-green-600 text-white hover:bg-green-500'\n  1024→                : 'bg-zinc-800 text-zinc-500 cursor-not-allowed'\n  1025→            }`}\n  1026→            title={\n  1027→              isCoordinatorOffline\n  1028→                ? 'Start system first'\n  1029→                : !canAssignVM\n  1030→                  ? 'No VMs available'\n  1031→                  : undefined\n  1032→            }\n  1033→          >\n  1034→            {isAssigning ? (\n  1035→              <span className=\"flex items-center gap-1\">\n  1036→                <span className=\"w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n  1037→                Assigning...\n  1038→              </span>\n  1039→            ) : (\n  1040→              `Assign VM${!isCoordinatorOffline && availableVMs.length > 0 ? ` (${availableVMs.length})` : ''}`\n  1041→            )}\n  1042→          </button>\n  1043→        ) : (\n  1044→          <button\n  1045→            onClick={() => onReleaseVM(compId)}\n  1046→            disabled={!canReleaseVM || isReleasing}\n  1047→            className={`px-3 py-1.5 text-sm font-medium rounded-lg transition-colors ${\n  1048→              canReleaseVM && !isReleasing\n  1049→                ? 'bg-orange-600 text-white hover:bg-orange-500'\n  1050→                : 'bg-zinc-800 text-zinc-500 cursor-not-allowed'\n  1051→            }`}\n  1052→            title={isCoordinatorOffline ? 'Start system first' : undefined}\n  1053→          >\n  1054→            {isReleasing ? (\n  1055→              <span className=\"flex items-center gap-1\">\n  1056→                <span className=\"w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n  1057→                Releasing...\n  1058→              </span>\n  1059→            ) : (\n  1060→              'Release VM'\n  1061→            )}\n  1062→          </button>\n  1063→        )}\n  1064→        <button\n  1065→          onClick={() => onEdit(compId)}\n  1066→          className=\"px-3 py-1.5 bg-zinc-800 text-zinc-300 text-sm rounded-lg hover:bg-zinc-700 transition-colors\"\n  1067→        >\n  1068→          Edit\n  1069→        </button>\n  1070→        <button\n  1071→          onClick={() => onDuplicate(compId)}\n  1072→          className=\"px-3 py-1.5 bg-zinc-800 text-zinc-300 text-sm rounded-lg hover:bg-zinc-700 transition-colors\"\n  1073→        >\n  1074→          Duplicate\n  1075→        </button>\n  1076→        <button\n  1077→          onClick={() => onDelete(compId)}\n  1078→          className=\"px-3 py-1.5 bg-zinc-800 text-red-400 text-sm rounded-lg hover:bg-zinc-700 transition-colors\"\n  1079→        >\n  1080→          Delete\n  1081→        </button>\n  1082→      </div>\n  1083→    </div>\n  1084→  );\n  1085→}\n  1086→\n  1087→// Competition Group Component\n  1088→function CompetitionGroup({ title, competitions, emptyMessage, renderCard }) {\n  1089→  if (competitions.length === 0) {\n  1090→    if (emptyMessage) {\n  1091→      return (\n  1092→        <div className=\"mb-8\">\n  1093→          <h2 className=\"text-sm font-semibold text-zinc-400 uppercase tracking-wide mb-4 pb-2 border-b border-zinc-800\">\n  1094→            {title}\n  1095→          </h2>\n  1096→          <p className=\"text-zinc-600 text-sm italic\">{emptyMessage}</p>\n  1097→        </div>\n  1098→      );\n  1099→    }\n  1100→    return null;\n  1101→  }\n  1102→\n  1103→  return (\n  1104→    <div className=\"mb-8\">\n  1105→      <h2 className=\"text-sm font-semibold text-zinc-400 uppercase tracking-wide mb-4 pb-2 border-b border-zinc-800\">\n  1106→        {title} ({competitions.length})\n  1107→      </h2>\n  1108→      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n  1109→        {competitions.map(renderCard)}\n  1110→      </div>\n  1111→    </div>\n  1112→  );\n  1113→}\n  1114→\n  1115→// Section Component for tools\n  1116→function Section({ title, children }) {\n  1117→  return (\n  1118→    <div className=\"mb-10\">\n  1119→      <div className=\"text-sm font-semibold text-zinc-400 uppercase tracking-wide mb-4 pb-2 border-b border-zinc-800\">\n  1120→        {title}\n  1121→      </div>\n  1122→      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5\">\n  1123→        {children}\n  1124→      </div>\n  1125→    </div>\n  1126→  );\n  1127→}\n  1128→\n  1129→// Tool Card Component\n  1130→function ToolCard({ to, icon, title, description }) {\n  1131→  return (\n  1132→    <Link\n  1133→      to={to}\n  1134→      className=\"block bg-zinc-900 border-2 border-zinc-800 rounded-xl p-6 hover:border-blue-500 hover:-translate-y-0.5 transition-all\"\n  1135→    >\n  1136→      <div className=\"text-2xl mb-3 text-zinc-500\">{icon}</div>\n  1137→      <div className=\"text-lg font-bold text-white mb-2\">{title}</div>\n  1138→      <div className=\"text-sm text-zinc-500 leading-relaxed\">{description}</div>\n  1139→    </Link>\n  1140→  );\n  1141→}\n  1142→\n  1143→// External Tool Card Component\n  1144→function ExternalToolCard({ href, icon, title, description }) {\n  1145→  return (\n  1146→    <a\n  1147→      href={href}\n  1148→      target=\"_blank\"\n  1149→      rel=\"noopener noreferrer\"\n  1150→      className=\"block bg-zinc-900 border-2 border-zinc-800 rounded-xl p-6 hover:border-blue-500 hover:-translate-y-0.5 transition-all\"\n  1151→    >\n  1152→      <div className=\"text-2xl mb-3 text-zinc-500\">{icon}</div>\n  1153→      <div className=\"text-lg font-bold text-white mb-2\">{title}</div>\n  1154→      <div className=\"text-sm text-zinc-500 leading-relaxed\">{description}</div>\n  1155→    </a>\n  1156→  );\n  1157→}\n  1158→\n  1159→// Competition Modal Component\n  1160→function CompetitionModal({\n  1161→  editingCompId,\n  1162→  formData,\n  1163→  setFormData,\n  1164→  virtiusSessionId,\n  1165→  setVirtiusSessionId,\n  1166→  virtiusFetching,\n  1167→  virtiusError,\n  1168→  fetchFromVirtius,\n  1169→  teamCount,\n  1170→  refreshing,\n  1171→  refreshResult,\n  1172→  onSubmit,\n  1173→  onDelete,\n  1174→  onRefreshTeamData,\n  1175→  onClose,\n  1176→  getTeamLogo,\n  1177→  availableThemes = {}\n  1178→}) {\n  1179→  return (\n  1180→    <div\n  1181→      className=\"fixed inset-0 bg-black/80 flex items-center justify-center z-50\"\n  1182→      onClick={onClose}\n  1183→    >\n  1184→      <div\n  1185→        className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-8 w-full max-w-lg max-h-[90vh] overflow-y-auto\"\n  1186→        onClick={(e) => e.stopPropagation()}\n  1187→      >\n  1188→        <h2 className=\"text-xl font-bold text-white mb-2\">\n  1189→          {editingCompId ? 'Edit Competition' : 'Create Competition'}\n  1190→        </h2>\n  1191→        <p className=\"text-sm text-zinc-500 mb-6\">Configure competition details</p>\n  1192→\n  1193→        <form onSubmit={onSubmit}>\n  1194→          {/* Virtius Import Section */}\n  1195→          <div className=\"mb-6 p-4 bg-zinc-800/50 border border-zinc-700 rounded-lg\">\n  1196→            <div className=\"text-xs text-zinc-400 mb-2\">Import from Virtius (optional)</div>\n  1197→            <div className=\"flex gap-2\">\n  1198→              <input\n  1199→                type=\"text\"\n  1200→                value={virtiusSessionId}\n  1201→                onChange={(e) => setVirtiusSessionId(e.target.value)}\n  1202→                placeholder=\"Session ID, e.g., EeUcxrjyBD\"\n  1203→                className=\"flex-1 px-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n  1204→              />\n  1205→              <button\n  1206→                type=\"button\"\n  1207→                onClick={fetchFromVirtius}\n  1208→                disabled={virtiusFetching || !virtiusSessionId.trim()}\n  1209→                className=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 disabled:bg-zinc-700 disabled:text-zinc-500 text-white text-sm font-medium rounded-lg transition-colors\"\n  1210→              >\n  1211→                {virtiusFetching ? 'Fetching...' : 'Fetch'}\n  1212→              </button>\n  1213→            </div>\n  1214→            {virtiusError && (\n  1215→              <div className=\"mt-2 text-xs text-red-400\">{virtiusError}</div>\n  1216→            )}\n  1217→          </div>\n  1218→\n  1219→          <FormGroup label=\"Competition ID (no spaces, lowercase)\">\n  1220→            <input\n  1221→              type=\"text\"\n  1222→              value={formData.compId}\n  1223→              onChange={(e) => setFormData({ ...formData, compId: e.target.value })}\n  1224→              disabled={!!editingCompId}\n  1225→              placeholder=\"e.g., court1, meet-a, ncaa-finals\"\n  1226→              pattern=\"[a-z0-9-]+\"\n  1227→              required\n  1228→              className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500 disabled:opacity-50\"\n  1229→            />\n  1230→          </FormGroup>\n  1231→\n  1232→          <div className=\"grid grid-cols-2 gap-3\">\n  1233→            <FormGroup label=\"Competition Type\">\n  1234→              <select\n  1235→                value={formData.compType}\n  1236→                onChange={(e) => {\n  1237→                  const newCompType = e.target.value;\n  1238→                  const inferredGender = getGenderFromCompType(newCompType);\n  1239→                  setFormData({ ...formData, compType: newCompType, gender: inferredGender || formData.gender });\n  1240→                }}\n  1241→                required\n  1242→                className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n  1243→              >\n  1244→                <option value=\"\">Select type...</option>\n  1245→                {competitionTypes.map((type) => (\n  1246→                  <option key={type.value} value={type.value}>{type.label}</option>\n  1247→                ))}\n  1248→              </select>\n  1249→            </FormGroup>\n  1250→\n  1251→            <FormGroup label=\"Gender\">\n  1252→              <select\n  1253→                value={formData.gender}\n  1254→                onChange={(e) => setFormData({ ...formData, gender: e.target.value })}\n  1255→                required\n  1256→                className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n  1257→              >\n  1258→                <option value=\"\">Select gender...</option>\n  1259→                <option value=\"womens\">Women's</option>\n  1260→                <option value=\"mens\">Men's</option>\n  1261→              </select>\n  1262→            </FormGroup>\n  1263→          </div>\n  1264→\n  1265→          <FormGroup label=\"Event Name\">\n  1266→            <input\n  1267→              type=\"text\"\n  1268→              value={formData.eventName}\n  1269→              onChange={(e) => setFormData({ ...formData, eventName: e.target.value })}\n  1270→              placeholder=\"e.g., Big Ten Dual Meet\"\n  1271→              required\n  1272→              className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n  1273→            />\n  1274→          </FormGroup>\n  1275→\n  1276→          <FormGroup label=\"Meet Date\">\n  1277→            <input\n  1278→              type=\"text\"\n  1279→              value={formData.meetDate}\n  1280→              onChange={(e) => setFormData({ ...formData, meetDate: e.target.value })}\n  1281→              placeholder=\"e.g., January 15, 2025\"\n  1282→              required\n  1283→              className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n  1284→            />\n  1285→          </FormGroup>\n  1286→\n  1287→          <div className=\"grid grid-cols-2 gap-3\">\n  1288→            <FormGroup label=\"Venue\">\n  1289→              <input\n  1290→                type=\"text\"\n  1291→                value={formData.venue}\n  1292→                onChange={(e) => setFormData({ ...formData, venue: e.target.value })}\n  1293→                placeholder=\"e.g., Crisler Center\"\n  1294→                required\n  1295→                className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n  1296→              />\n  1297→            </FormGroup>\n  1298→            <FormGroup label=\"Location\">\n  1299→              <input\n  1300→                type=\"text\"\n  1301→                value={formData.location}\n  1302→                onChange={(e) => setFormData({ ...formData, location: e.target.value })}\n  1303→                placeholder=\"e.g., Ann Arbor, MI\"\n  1304→                required\n  1305→                className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n  1306→              />\n  1307→            </FormGroup>\n  1308→          </div>\n  1309→\n  1310→          <FormGroup label=\"Meet Theme (optional)\">\n  1311→            <select\n  1312→              value={formData.meetTheme}\n  1313→              onChange={(e) => setFormData({ ...formData, meetTheme: e.target.value })}\n  1314→              className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n  1315→            >\n  1316→              <option value=\"\">None (use default styling)</option>\n  1317→              {Object.entries(availableThemes).map(([id, theme]) => (\n  1318→                <option key={id} value={id}>\n  1319→                  {theme.name || id}\n  1320→                </option>\n  1321→              ))}\n  1322→            </select>\n  1323→            {formData.meetTheme && availableThemes[formData.meetTheme] && (\n  1324→              <div className=\"mt-2 flex items-center gap-2\">\n  1325→                <div\n  1326→                  className=\"w-4 h-4 rounded-sm border border-zinc-600\"\n  1327→                  style={{ backgroundColor: availableThemes[formData.meetTheme]?.colors?.headerBar || availableThemes[formData.meetTheme]?.colors?.accentPrimary }}\n  1328→                />\n  1329→                <span className=\"text-xs text-zinc-400\">\n  1330→                  {availableThemes[formData.meetTheme]?.description || 'Custom theme'}\n  1331→                </span>\n  1332→              </div>\n  1333→            )}\n  1334→          </FormGroup>\n  1335→\n  1336→          {/* Team inputs */}\n  1337→          <TeamLogoInput\n  1338→            teamNum={1}\n  1339→            teamName={formData.team1Name}\n  1340→            teamLogo={formData.team1Logo}\n  1341→            onNameChange={(val) => setFormData({ ...formData, team1Name: val })}\n  1342→            onLogoChange={(val) => setFormData({ ...formData, team1Logo: val })}\n  1343→            gender={formData.gender}\n  1344→            getTeamLogo={getTeamLogo}\n  1345→            required\n  1346→          />\n  1347→          <TeamLogoInput\n  1348→            teamNum={2}\n  1349→            teamName={formData.team2Name}\n  1350→            teamLogo={formData.team2Logo}\n  1351→            onNameChange={(val) => setFormData({ ...formData, team2Name: val })}\n  1352→            onLogoChange={(val) => setFormData({ ...formData, team2Logo: val })}\n  1353→            gender={formData.gender}\n  1354→            getTeamLogo={getTeamLogo}\n  1355→            required\n  1356→          />\n  1357→          {teamCount >= 3 && (\n  1358→            <TeamLogoInput\n  1359→              teamNum={3}\n  1360→              teamName={formData.team3Name}\n  1361→              teamLogo={formData.team3Logo}\n  1362→              onNameChange={(val) => setFormData({ ...formData, team3Name: val })}\n  1363→              onLogoChange={(val) => setFormData({ ...formData, team3Logo: val })}\n  1364→              gender={formData.gender}\n  1365→              getTeamLogo={getTeamLogo}\n  1366→              required\n  1367→            />\n  1368→          )}\n  1369→          {teamCount >= 4 && (\n  1370→            <TeamLogoInput\n  1371→              teamNum={4}\n  1372→              teamName={formData.team4Name}\n  1373→              teamLogo={formData.team4Logo}\n  1374→              onNameChange={(val) => setFormData({ ...formData, team4Name: val })}\n  1375→              onLogoChange={(val) => setFormData({ ...formData, team4Logo: val })}\n  1376→              gender={formData.gender}\n  1377→              getTeamLogo={getTeamLogo}\n  1378→              required\n  1379→            />\n  1380→          )}\n  1381→          {teamCount >= 5 && (\n  1382→            <TeamLogoInput\n  1383→              teamNum={5}\n  1384→              teamName={formData.team5Name}\n  1385→              teamLogo={formData.team5Logo}\n  1386→              onNameChange={(val) => setFormData({ ...formData, team5Name: val })}\n  1387→              onLogoChange={(val) => setFormData({ ...formData, team5Logo: val })}\n  1388→              gender={formData.gender}\n  1389→              getTeamLogo={getTeamLogo}\n  1390→              required\n  1391→            />\n  1392→          )}\n  1393→          {teamCount >= 6 && (\n  1394→            <TeamLogoInput\n  1395→              teamNum={6}\n  1396→              teamName={formData.team6Name}\n  1397→              teamLogo={formData.team6Logo}\n  1398→              onNameChange={(val) => setFormData({ ...formData, team6Name: val })}\n  1399→              onLogoChange={(val) => setFormData({ ...formData, team6Logo: val })}\n  1400→              gender={formData.gender}\n  1401→              getTeamLogo={getTeamLogo}\n  1402→              required\n  1403→            />\n  1404→          )}\n  1405→          {teamCount >= 7 && (\n  1406→            <TeamLogoInput\n  1407→              teamNum={7}\n  1408→              teamName={formData.team7Name}\n  1409→              teamLogo={formData.team7Logo}\n  1410→              onNameChange={(val) => setFormData({ ...formData, team7Name: val })}\n  1411→              onLogoChange={(val) => setFormData({ ...formData, team7Logo: val })}\n  1412→              gender={formData.gender}\n  1413→              getTeamLogo={getTeamLogo}\n  1414→              required\n  1415→            />\n  1416→          )}\n  1417→\n  1418→          {/* Refresh Team Data - only when editing */}\n  1419→          {editingCompId && (\n  1420→            <div className=\"mb-4 p-4 bg-zinc-800/50 border border-zinc-700 rounded-lg\">\n  1421→              <div className=\"text-xs text-zinc-400 mb-2\">Sync Headshots from Media Manager</div>\n  1422→              <p className=\"text-xs text-zinc-500 mb-3\">\n  1423→                Re-fetch rosters from RTN and merge latest headshots from Firebase.\n  1424→              </p>\n  1425→              <button\n  1426→                type=\"button\"\n  1427→                onClick={onRefreshTeamData}\n  1428→                disabled={refreshing}\n  1429→                className=\"px-4 py-2 bg-green-600 hover:bg-green-500 disabled:bg-zinc-700 disabled:text-zinc-500 text-white text-sm font-medium rounded-lg transition-colors\"\n  1430→              >\n  1431→                {refreshing ? 'Refreshing...' : 'Refresh Team Data'}\n  1432→              </button>\n  1433→              {refreshResult === 'success' && (\n  1434→                <span className=\"ml-3 text-green-400 text-sm\">Rosters and headshots updated!</span>\n  1435→              )}\n  1436→              {refreshResult === 'error' && (\n  1437→                <span className=\"ml-3 text-red-400 text-sm\">Failed to refresh — check console for details</span>\n  1438→              )}\n  1439→            </div>\n  1440→          )}\n  1441→\n  1442→          <div className=\"flex gap-3 mt-6\">\n  1443→            <button\n  1444→              type=\"button\"\n  1445→              onClick={onClose}\n  1446→              className=\"flex-1 px-4 py-2.5 bg-zinc-800 text-zinc-300 rounded-lg hover:bg-zinc-700 transition-colors\"\n  1447→            >\n  1448→              Cancel\n  1449→            </button>\n  1450→            {editingCompId && (\n  1451→              <button\n  1452→                type=\"button\"\n  1453→                onClick={onDelete}\n  1454→                className=\"px-4 py-2.5 bg-red-600 text-white rounded-lg hover:bg-red-500 transition-colors\"\n  1455→              >\n  1456→                Delete\n  1457→              </button>\n  1458→            )}\n  1459→            <button\n  1460→              type=\"submit\"\n  1461→              className=\"flex-1 px-4 py-2.5 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-500 transition-colors\"\n  1462→            >\n  1463→              Save Competition\n  1464→            </button>\n  1465→          </div>\n  1466→        </form>\n  1467→      </div>\n  1468→    </div>\n  1469→  );\n  1470→}\n  1471→\n  1472→// Form Group Component\n  1473→function FormGroup({ label, children }) {\n  1474→  return (\n  1475→    <div className=\"mb-4\">\n  1476→      <label className=\"block text-xs text-zinc-400 mb-1.5\">{label}</label>\n  1477→      {children}\n  1478→    </div>\n  1479→  );\n  1480→}\n  1481→\n  1482→// Team Logo Input Component\n  1483→function TeamLogoInput({ teamNum, teamName, teamLogo, onNameChange, onLogoChange, required, gender, getTeamLogo }) {\n  1484→  const effectiveGender = gender || 'mens';\n  1485→  const hasLogoFromFirebase = teamName && getTeamLogo(teamName, effectiveGender);\n  1486→  const hasLogoUrl = !!teamLogo;\n  1487→  const logoStatus = hasLogoUrl ? 'has-url' : hasLogoFromFirebase ? 'in-library' : teamName ? 'missing' : 'no-name';\n  1488→\n  1489→  return (\n  1490→    <div className=\"mb-4 p-3 bg-zinc-800/30 rounded-lg border border-zinc-800\">\n  1491→      <div className=\"flex items-center justify-between mb-2\">\n  1492→        <div className=\"flex items-center gap-2\">\n  1493→          <span className=\"text-xs text-zinc-400\">Team {teamNum}</span>\n  1494→          {effectiveGender && (\n  1495→            <span className={`px-1.5 py-0.5 rounded text-[10px] font-medium ${\n  1496→              effectiveGender === 'womens'\n  1497→                ? 'bg-pink-500/20 text-pink-400 border border-pink-500/30'\n  1498→                : 'bg-blue-500/20 text-blue-400 border border-blue-500/30'\n  1499→            }`}>\n  1500→              {effectiveGender === 'womens' ? \"W\" : \"M\"}\n  1501→            </span>\n  1502→          )}\n  1503→        </div>\n  1504→        <div className=\"flex items-center gap-3\">\n  1505→          {logoStatus === 'has-url' && (\n  1506→            <span className=\"flex items-center gap-1 text-xs text-green-400\">\n  1507→              <CheckCircleIcon className=\"w-3 h-3\" /> Logo set\n  1508→            </span>\n  1509→          )}\n  1510→          {logoStatus === 'in-library' && (\n  1511→            <span className=\"flex items-center gap-1 text-xs text-blue-400\">\n  1512→              <CheckCircleIcon className=\"w-3 h-3\" /> In library\n  1513→            </span>\n  1514→          )}\n  1515→          {logoStatus === 'missing' && (\n  1516→            <Link\n  1517→              to=\"/media-manager\"\n  1518→              className=\"flex items-center gap-1 text-xs text-amber-400 hover:text-amber-300\"\n  1519→            >\n  1520→              <ExclamationTriangleIcon className=\"w-3 h-3\" /> Add logo\n  1521→            </Link>\n  1522→          )}\n  1523→        </div>\n  1524→      </div>\n  1525→      <div className=\"flex gap-2\">\n  1526→        <div className=\"w-12 h-12 bg-zinc-700 rounded-lg flex items-center justify-center overflow-hidden flex-shrink-0\">\n  1527→          {(teamLogo || (teamName && getTeamLogo(teamName, effectiveGender))) ? (\n  1528→            <img\n  1529→              src={teamLogo || getTeamLogo(teamName, effectiveGender)}\n  1530→              alt={teamName || 'Team logo'}\n  1531→              className=\"w-10 h-10 object-contain\"\n  1532→            />\n  1533→          ) : (\n  1534→            <span className=\"text-zinc-500 text-lg\">?</span>\n  1535→          )}\n  1536→        </div>\n  1537→        <div className=\"flex-1 space-y-2\">\n  1538→          <input\n  1539→            type=\"text\"\n  1540→            value={teamName}\n  1541→            onChange={(e) => onNameChange(e.target.value)}\n  1542→            placeholder={`Team ${teamNum} name`}\n  1543→            required={required}\n  1544→            className=\"w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n  1545→          />\n  1546→          <input\n  1547→            type=\"text\"\n  1548→            value={teamLogo}\n  1549→            onChange={(e) => onLogoChange(e.target.value)}\n  1550→            placeholder=\"Logo URL (auto-filled if in library)\"\n  1551→            className=\"w-full px-3 py-1.5 bg-zinc-800 border border-zinc-700 rounded text-white text-xs focus:outline-none focus:border-blue-500\"\n  1552→          />\n  1553→        </div>\n  1554→      </div>\n  1555→    </div>\n  1556→  );\n  1557→}\n  1558→\n  1559→/**\n  1560→ * CommentaryStatusBadge - Shows commentary staffing status on a competition card.\n  1561→ * Reads competitions/{compId}/commentary from Firebase.\n  1562→ */\n  1563→function CommentaryStatusBadge({ compId }) {\n  1564→  const [staff, setStaff] = useState(null);\n  1565→\n  1566→  useEffect(() => {\n  1567→    const staffRef = ref(db, `competitions/${compId}/commentary`);\n  1568→    const unsubscribe = onValue(staffRef, (snapshot) => {\n  1569→      setStaff(snapshot.val());\n  1570→    });\n  1571→    return () => unsubscribe();\n  1572→  }, [compId]);\n  1573→\n  1574→  if (!staff) return null;\n  1575→\n  1576→  const entries = Object.values(staff);\n  1577→  if (entries.length === 0) return null;\n  1578→\n  1579→  const confirmed = entries.filter(s => s.status === 'confirmed' || s.status === 'briefed').length;\n  1580→  const total = entries.length;\n  1581→  const allConfirmed = confirmed === total;\n  1582→\n  1583→  return (\n  1584→    <div className={`inline-flex items-center gap-1.5 mt-1 px-2 py-0.5 rounded text-xs font-medium ${\n  1585→      allConfirmed ? 'bg-green-900/40 text-green-300 border border-green-800' : 'bg-yellow-900/40 text-yellow-300 border border-yellow-800'\n  1586→    }`}>\n  1587→      <span>{allConfirmed ? '✓' : '⋯'}</span>\n  1588→      Commentary: {confirmed}/{total} confirmed\n  1589→    </div>\n  1590→  );\n  1591→}\n  1592→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"93fbf748-dbe6-4fbe-9f9d-e937e5652744","uuid":"128335c6-d50a-4c5a-8c3f-a783db8cbcbb","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/pages/HomePage.jsx","content":"import { useState, useEffect, useMemo } from 'react';\nimport { Link, useNavigate } from 'react-router-dom';\nimport { useCompetitions, checkVmStatus } from '../hooks/useCompetitions';\nimport { useVMPool, VM_STATUS } from '../hooks/useVMPool';\nimport { useCoordinator, COORDINATOR_STATUS } from '../hooks/useCoordinator';\nimport CoordinatorStatus from '../components/CoordinatorStatus';\nimport { competitionTypes, teamCounts, typeLabels } from '../lib/graphicButtons';\nimport { useTeamsDatabase } from '../hooks/useTeamsDatabase';\nimport { useHeadCoach } from '../hooks/useRoadToNationals';\nimport { getGenderFromCompType, buildTeamKey } from '../lib/competitionUtils';\nimport { ExclamationTriangleIcon, CheckCircleIcon, UserIcon } from '@heroicons/react/24/solid';\nimport StatsStatusBadge from '../components/StatsStatusBadge';\nimport StatsDetailPanel from '../components/StatsDetailPanel';\nimport RankingsPanel from '../components/RankingsPanel';\nimport { db, ref, onValue } from '../lib/firebase';\n\n/**\n * HomePage - Consolidated landing page combining:\n * - CompetitionSelector: Competition list, VM assignment, coordinator status\n * - HubPage: Links to all tools and overlays\n * - DashboardPage: Create/edit competition functionality\n *\n * URL: /\n */\nexport default function HomePage() {\n  const {\n    competitions,\n    loading,\n    error,\n    createCompetition,\n    updateCompetition,\n    deleteCompetition,\n    duplicateCompetition,\n    refreshTeamData\n  } = useCompetitions();\n  const {\n    vms,\n    availableVMs,\n    assignVM,\n    releaseVM,\n    getVMForCompetition,\n    hasVMAssigned,\n    loading: vmPoolLoading,\n  } = useVMPool();\n  const {\n    status: coordinatorStatus,\n    isWaking,\n    error: coordinatorError,\n    wake,\n  } = useCoordinator();\n  const { getTeamLogo } = useTeamsDatabase();\n\n  const [searchQuery, setSearchQuery] = useState('');\n  const [vmStatuses, setVmStatuses] = useState({});\n  const [assigningVm, setAssigningVm] = useState(null);\n  const [releasingVm, setReleasingVm] = useState(null);\n  const [showPastCompetitions, setShowPastCompetitions] = useState(false);\n  const navigate = useNavigate();\n\n  // Modal state for create/edit\n  const [showModal, setShowModal] = useState(false);\n  const [editingCompId, setEditingCompId] = useState(null);\n  const [formData, setFormData] = useState(getDefaultFormData());\n  const [virtiusSessionId, setVirtiusSessionId] = useState('');\n  const [virtiusFetching, setVirtiusFetching] = useState(false);\n  const [virtiusError, setVirtiusError] = useState(null);\n  const [refreshing, setRefreshing] = useState(false);\n  const [refreshResult, setRefreshResult] = useState(null); // 'success' | 'error' | null\n  const [availableThemes, setAvailableThemes] = useState({});\n\n  // Load meet themes from Firebase\n  useEffect(() => {\n    const themesRef = ref(db, 'themes');\n    const unsubscribe = onValue(themesRef, (snapshot) => {\n      setAvailableThemes(snapshot.val() || {});\n    });\n    return () => unsubscribe();\n  }, []);\n\n  // Coordinator status helpers\n  const isCoordinatorOffline = coordinatorStatus === COORDINATOR_STATUS.OFFLINE;\n  const isCoordinatorStarting = coordinatorStatus === COORDINATOR_STATUS.STARTING;\n\n  function getDefaultFormData() {\n    return {\n      compId: '',\n      compType: '',\n      gender: '',\n      meetTheme: '',\n      eventName: '',\n      meetDate: '',\n      venue: '',\n      location: '',\n      team1Name: '', team1Logo: '', team1Tricode: '',\n      team2Name: '', team2Logo: '', team2Tricode: '',\n      team3Name: '', team3Logo: '', team3Tricode: '',\n      team4Name: '', team4Logo: '', team4Tricode: '',\n      team5Name: '', team5Logo: '', team5Tricode: '',\n      team6Name: '', team6Logo: '', team6Tricode: '',\n      team7Name: '', team7Logo: '', team7Tricode: '',\n    };\n  }\n\n  function generateCompId() {\n    const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';\n    let result = '';\n    for (let i = 0; i < 8; i++) {\n      result += chars.charAt(Math.floor(Math.random() * chars.length));\n    }\n    return result;\n  }\n\n  // Group competitions by date\n  const groupedCompetitions = useMemo(() => {\n    const now = new Date();\n    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());\n    const tomorrow = new Date(today);\n    tomorrow.setDate(tomorrow.getDate() + 1);\n\n    const groups = {\n      today: [],\n      tomorrow: [],\n      upcoming: [],\n      past: []\n    };\n\n    Object.entries(competitions).forEach(([compId, data]) => {\n      const config = data?.config;\n      if (!config) return;\n\n      const searchLower = searchQuery.toLowerCase();\n      const matchesSearch = !searchQuery ||\n        config.eventName?.toLowerCase().includes(searchLower) ||\n        config.venue?.toLowerCase().includes(searchLower) ||\n        config.team1Name?.toLowerCase().includes(searchLower) ||\n        config.team2Name?.toLowerCase().includes(searchLower) ||\n        compId.toLowerCase().includes(searchLower);\n\n      if (!matchesSearch) return;\n\n      const meetDate = config.meetDate ? new Date(config.meetDate) : null;\n      const competition = { compId, config, meetDate };\n\n      if (!meetDate) {\n        groups.upcoming.push(competition);\n      } else if (meetDate >= today && meetDate < tomorrow) {\n        groups.today.push(competition);\n      } else if (meetDate >= tomorrow && meetDate < new Date(tomorrow.getTime() + 86400000)) {\n        groups.tomorrow.push(competition);\n      } else if (meetDate >= today) {\n        groups.upcoming.push(competition);\n      } else {\n        groups.past.push(competition);\n      }\n    });\n\n    const sortByDate = (a, b) => {\n      if (!a.meetDate && !b.meetDate) return 0;\n      if (!a.meetDate) return 1;\n      if (!b.meetDate) return -1;\n      return a.meetDate - b.meetDate;\n    };\n\n    groups.today.sort(sortByDate);\n    groups.tomorrow.sort(sortByDate);\n    groups.upcoming.sort(sortByDate);\n    groups.past.sort((a, b) => sortByDate(b, a));\n\n    return groups;\n  }, [competitions, searchQuery]);\n\n  // Check VM status for competitions (routes through coordinator in production)\n  useEffect(() => {\n    const checkStatuses = async () => {\n      for (const [compId, data] of Object.entries(competitions)) {\n        const vmAddress = data?.config?.vmAddress;\n        if (!vmAddress) {\n          setVmStatuses(prev => ({ ...prev, [compId]: { online: false, noVm: true } }));\n          continue;\n        }\n\n        const status = await checkVmStatus(vmAddress, 5000, compId);\n        setVmStatuses(prev => ({ ...prev, [compId]: status }));\n      }\n    };\n\n    checkStatuses();\n  }, [competitions]);\n\n  // VM assignment handlers\n  const handleAssignVM = async (compId) => {\n    setAssigningVm(compId);\n    const result = await assignVM(compId);\n    setAssigningVm(null);\n    if (!result.success) {\n      console.error('Failed to assign VM:', result.error);\n    }\n  };\n\n  const handleReleaseVM = async (compId) => {\n    setReleasingVm(compId);\n    const result = await releaseVM(compId);\n    setReleasingVm(null);\n    if (!result.success) {\n      console.error('Failed to release VM:', result.error);\n    }\n  };\n\n  // Virtius import\n  function formatDate(dateStr) {\n    if (!dateStr) return '';\n    const date = new Date(dateStr + 'T00:00:00');\n    return date.toLocaleDateString('en-US', {\n      year: 'numeric', month: 'long', day: 'numeric'\n    });\n  }\n\n  function inferCompType(sex, teamCount) {\n    const prefix = sex === 'women' ? 'womens' : 'mens';\n    const suffix = teamCount === 2 ? 'dual' :\n                   teamCount === 3 ? 'tri' :\n                   teamCount === 4 ? 'quad' :\n                   `${teamCount}`;\n    return `${prefix}-${suffix}`;\n  }\n\n  async function fetchFromVirtius() {\n    if (!virtiusSessionId.trim()) return;\n    setVirtiusFetching(true);\n    setVirtiusError(null);\n\n    try {\n      const response = await fetch(`https://api.virti.us/session/${virtiusSessionId.trim()}/json`);\n      if (!response.ok) throw new Error('Session not found');\n      const data = await response.json();\n\n      const meet = data.meet;\n      const teams = meet.teams || [];\n      const sortedTeams = [...teams].sort((a, b) => (a.team_order || 0) - (b.team_order || 0));\n      const compType = inferCompType(meet.sex, sortedTeams.length);\n      const gender = meet.sex === 'women' ? 'womens' : 'mens';\n\n      setFormData(prev => ({\n        ...prev,\n        eventName: meet.name || prev.eventName,\n        meetDate: formatDate(meet.meet_date) || prev.meetDate,\n        venue: meet.location?.split(',')[0]?.trim() || prev.venue,\n        location: meet.location?.split(',').slice(1).join(',').trim() || prev.location,\n        compType,\n        gender,\n        team1Name: sortedTeams[0]?.name || prev.team1Name,\n        team1Logo: getTeamLogo(sortedTeams[0]?.name, gender) || prev.team1Logo,\n        team1Tricode: sortedTeams[0]?.tricode || prev.team1Tricode,\n        team2Name: sortedTeams[1]?.name || prev.team2Name,\n        team2Logo: getTeamLogo(sortedTeams[1]?.name, gender) || prev.team2Logo,\n        team2Tricode: sortedTeams[1]?.tricode || prev.team2Tricode,\n        team3Name: sortedTeams[2]?.name || prev.team3Name,\n        team3Logo: getTeamLogo(sortedTeams[2]?.name, gender) || prev.team3Logo,\n        team3Tricode: sortedTeams[2]?.tricode || prev.team3Tricode,\n        team4Name: sortedTeams[3]?.name || prev.team4Name,\n        team4Logo: getTeamLogo(sortedTeams[3]?.name, gender) || prev.team4Logo,\n        team4Tricode: sortedTeams[3]?.tricode || prev.team4Tricode,\n        team5Name: sortedTeams[4]?.name || prev.team5Name,\n        team5Logo: getTeamLogo(sortedTeams[4]?.name, gender) || prev.team5Logo,\n        team5Tricode: sortedTeams[4]?.tricode || prev.team5Tricode,\n        team6Name: sortedTeams[5]?.name || prev.team6Name,\n        team6Logo: getTeamLogo(sortedTeams[5]?.name, gender) || prev.team6Logo,\n        team6Tricode: sortedTeams[5]?.tricode || prev.team6Tricode,\n        team7Name: sortedTeams[6]?.name || prev.team7Name,\n        team7Logo: getTeamLogo(sortedTeams[6]?.name, gender) || prev.team7Logo,\n        team7Tricode: sortedTeams[6]?.tricode || prev.team7Tricode,\n        virtiusSessionId: virtiusSessionId.trim(),\n      }));\n    } catch (error) {\n      setVirtiusError('Could not fetch Virtius session. Check the session ID and try again.');\n    } finally {\n      setVirtiusFetching(false);\n    }\n  }\n\n  // Modal handlers\n  function openCreateModal() {\n    setEditingCompId(null);\n    setFormData({ ...getDefaultFormData(), compId: generateCompId() });\n    setVirtiusSessionId('');\n    setVirtiusError(null);\n    setShowModal(true);\n  }\n\n  function openEditModal(compId) {\n    const config = competitions[compId]?.config || {};\n    setEditingCompId(compId);\n    const gender = config.gender || getGenderFromCompType(config.compType) || 'mens';\n    setFormData({\n      compId,\n      compType: config.compType || 'mens-dual',\n      gender,\n      meetTheme: config.meetTheme || '',\n      eventName: config.eventName || '',\n      meetDate: config.meetDate || '',\n      venue: config.venue || '',\n      location: config.location || '',\n      team1Name: config.team1Name || '', team1Logo: config.team1Logo || '', team1Tricode: config.team1Tricode || '',\n      team2Name: config.team2Name || '', team2Logo: config.team2Logo || '', team2Tricode: config.team2Tricode || '',\n      team3Name: config.team3Name || '', team3Logo: config.team3Logo || '', team3Tricode: config.team3Tricode || '',\n      team4Name: config.team4Name || '', team4Logo: config.team4Logo || '', team4Tricode: config.team4Tricode || '',\n      team5Name: config.team5Name || '', team5Logo: config.team5Logo || '', team5Tricode: config.team5Tricode || '',\n      team6Name: config.team6Name || '', team6Logo: config.team6Logo || '', team6Tricode: config.team6Tricode || '',\n      team7Name: config.team7Name || '', team7Logo: config.team7Logo || '', team7Tricode: config.team7Tricode || '',\n      virtiusSessionId: config.virtiusSessionId || '',\n    });\n    setVirtiusSessionId(config.virtiusSessionId || '');\n    setVirtiusError(null);\n    setShowModal(true);\n  }\n\n  async function handleSubmit(e) {\n    e.preventDefault();\n    const compId = formData.compId.toLowerCase().trim();\n    const gender = formData.gender || getGenderFromCompType(formData.compType) || 'mens';\n\n    const config = {\n      compType: formData.compType,\n      gender,\n      meetTheme: formData.meetTheme || '',\n      eventName: formData.eventName,\n      meetDate: formData.meetDate,\n      venue: formData.venue,\n      location: formData.location,\n      virtiusSessionId: formData.virtiusSessionId || '',\n      team1Name: formData.team1Name,\n      team1Logo: formData.team1Logo || 'https://via.placeholder.com/200/00274C/FFCB05?text=T1',\n      team1Tricode: formData.team1Tricode || '',\n      team1Key: formData.team1Name ? buildTeamKey(formData.team1Name, gender) : '',\n      team2Name: formData.team2Name,\n      team2Logo: formData.team2Logo || 'https://via.placeholder.com/200/BB0000/FFFFFF?text=T2',\n      team2Tricode: formData.team2Tricode || '',\n      team2Key: formData.team2Name ? buildTeamKey(formData.team2Name, gender) : '',\n      team3Name: formData.team3Name,\n      team3Logo: formData.team3Logo || 'https://via.placeholder.com/200/006400/FFFFFF?text=T3',\n      team3Tricode: formData.team3Tricode || '',\n      team3Key: formData.team3Name ? buildTeamKey(formData.team3Name, gender) : '',\n      team4Name: formData.team4Name,\n      team4Logo: formData.team4Logo || 'https://via.placeholder.com/200/800080/FFFFFF?text=T4',\n      team4Tricode: formData.team4Tricode || '',\n      team4Key: formData.team4Name ? buildTeamKey(formData.team4Name, gender) : '',\n      team5Name: formData.team5Name,\n      team5Logo: formData.team5Logo || 'https://via.placeholder.com/200/FF6600/FFFFFF?text=T5',\n      team5Tricode: formData.team5Tricode || '',\n      team5Key: formData.team5Name ? buildTeamKey(formData.team5Name, gender) : '',\n      team6Name: formData.team6Name,\n      team6Logo: formData.team6Logo || 'https://via.placeholder.com/200/000080/FFFFFF?text=T6',\n      team6Tricode: formData.team6Tricode || '',\n      team6Key: formData.team6Name ? buildTeamKey(formData.team6Name, gender) : '',\n      team7Name: formData.team7Name,\n      team7Logo: formData.team7Logo || 'https://via.placeholder.com/200/000080/FFFFFF?text=T7',\n      team7Tricode: formData.team7Tricode || '',\n      team7Key: formData.team7Name ? buildTeamKey(formData.team7Name, gender) : '',\n      hosts: 'Host Name',\n      team1Ave: '0.000', team1High: '0.000', team1Con: '0%', team1Coaches: 'Coach Name',\n      team2Ave: '0.000', team2High: '0.000', team2Con: '0%', team2Coaches: 'Coach Name',\n      team3Ave: '0.000', team3High: '0.000', team3Con: '0%', team3Coaches: 'Coach Name',\n      team4Ave: '0.000', team4High: '0.000', team4Con: '0%', team4Coaches: 'Coach Name',\n      team5Ave: '0.000', team5High: '0.000', team5Con: '0%', team5Coaches: 'Coach Name',\n      team6Ave: '0.000', team6High: '0.000', team6Con: '0%', team6Coaches: 'Coach Name',\n    };\n\n    if (editingCompId) {\n      await updateCompetition(editingCompId, config);\n    } else {\n      await createCompetition(compId, config);\n    }\n\n    setShowModal(false);\n  }\n\n  async function handleDelete() {\n    if (!editingCompId) return;\n    if (window.confirm(`Are you sure you want to delete competition \"${editingCompId}\"? This cannot be undone.`)) {\n      await deleteCompetition(editingCompId);\n      setShowModal(false);\n    }\n  }\n\n  async function handleDuplicate(compId) {\n    const newCompId = window.prompt(`Duplicate \"${compId}\" as:\\n\\nEnter new competition ID (lowercase, no spaces):`, compId + '-copy');\n    if (!newCompId) return;\n\n    if (!/^[a-z0-9-]+$/.test(newCompId)) {\n      alert('Competition ID can only contain lowercase letters, numbers, and hyphens.');\n      return;\n    }\n\n    if (competitions[newCompId]) {\n      alert(`Competition \"${newCompId}\" already exists. Please choose a different ID.`);\n      return;\n    }\n\n    await duplicateCompetition(compId, newCompId);\n  }\n\n  async function handleDeleteFromCard(compId) {\n    if (window.confirm(`Are you sure you want to delete \"${compId}\"?\\n\\nThis will permanently delete:\\n- All configuration\\n- Current graphic state\\n- All data for this competition\\n\\nThis cannot be undone.`)) {\n      await deleteCompetition(compId);\n    }\n  }\n\n  async function handleRefreshTeamData() {\n    if (!editingCompId) return;\n    setRefreshing(true);\n    setRefreshResult(null);\n    try {\n      const result = await refreshTeamData(editingCompId);\n      setRefreshResult(result?.success ? 'success' : 'error');\n    } catch (err) {\n      console.error('Failed to refresh team data:', err);\n      setRefreshResult('error');\n    }\n    setRefreshing(false);\n    // Auto-clear the result message after 4 seconds\n    setTimeout(() => setRefreshResult(null), 4000);\n  }\n\n  // Helper functions\n  const getGenderBadge = (config) => {\n    const gender = config?.gender || (config?.compType?.includes('womens') ? 'womens' : 'mens');\n    const isWomens = gender === 'womens' || gender === 'WAG';\n    return {\n      label: isWomens ? 'WAG' : 'MAG',\n      color: isWomens ? 'bg-pink-500' : 'bg-blue-500'\n    };\n  };\n\n  const getTeams = (config) => {\n    return [\n      config?.team1Name, config?.team2Name, config?.team3Name,\n      config?.team4Name, config?.team5Name, config?.team6Name, config?.team7Name\n    ].filter(Boolean);\n  };\n\n  const formatDisplayDate = (date) => {\n    if (!date) return 'No date set';\n    return date.toLocaleDateString('en-US', {\n      weekday: 'short', month: 'short', day: 'numeric', year: 'numeric'\n    });\n  };\n\n  const getVMStatusBadge = (compId) => {\n    const vm = getVMForCompetition(compId);\n    if (!vm) return null;\n\n    const statusConfig = {\n      [VM_STATUS.AVAILABLE]: { color: 'bg-green-500', label: 'VM Ready' },\n      [VM_STATUS.ASSIGNED]: { color: 'bg-blue-500', label: 'VM Assigned' },\n      [VM_STATUS.IN_USE]: { color: 'bg-purple-500', label: 'VM In Use' },\n      [VM_STATUS.STARTING]: { color: 'bg-yellow-500', label: 'VM Starting' },\n      [VM_STATUS.STOPPING]: { color: 'bg-orange-500', label: 'VM Stopping' },\n      [VM_STATUS.ERROR]: { color: 'bg-red-500', label: 'VM Error' },\n    };\n\n    const cfg = statusConfig[vm.status] || { color: 'bg-zinc-500', label: vm.status };\n    return { ...cfg, vm };\n  };\n\n  const VmStatusIndicator = ({ compId }) => {\n    const status = vmStatuses[compId];\n    if (!status) {\n      return <div className=\"w-3 h-3 rounded-full bg-zinc-600 animate-pulse\" title=\"Checking...\" />;\n    }\n    if (status.noVm) {\n      return <div className=\"w-3 h-3 rounded-full bg-zinc-600\" title=\"No VM configured\" />;\n    }\n    if (status.online) {\n      return (\n        <div\n          className={`w-3 h-3 rounded-full ${status.obsConnected ? 'bg-green-500' : 'bg-yellow-500'}`}\n          title={status.obsConnected ? 'Online (OBS connected)' : 'Online (OBS disconnected)'}\n        />\n      );\n    }\n    return <div className=\"w-3 h-3 rounded-full bg-red-500\" title=\"Offline\" />;\n  };\n\n  const teamCount = teamCounts[formData.compType] || 2;\n\n  const totalCompetitions = Object.keys(competitions).length;\n  const filteredCount =\n    groupedCompetitions.today.length +\n    groupedCompetitions.tomorrow.length +\n    groupedCompetitions.upcoming.length +\n    groupedCompetitions.past.length;\n\n  // Loading state\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-zinc-950 flex items-center justify-center\">\n        <div className=\"text-center\">\n          <div className=\"w-10 h-10 border-4 border-blue-500 border-t-transparent rounded-full animate-spin mx-auto mb-4\" />\n          <p className=\"text-zinc-400\">Loading...</p>\n        </div>\n      </div>\n    );\n  }\n\n  // Error state\n  if (error) {\n    return (\n      <div className=\"min-h-screen bg-zinc-950 flex items-center justify-center\">\n        <div className=\"text-center\">\n          <div className=\"text-red-500 text-4xl mb-4\">!</div>\n          <h2 className=\"text-xl font-bold text-white mb-2\">Failed to Load</h2>\n          <p className=\"text-zinc-400\">{error}</p>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-zinc-950 p-6 md:p-10\">\n      <div className=\"max-w-6xl mx-auto\">\n        {/* Header */}\n        <div className=\"flex justify-between items-start mb-8\">\n          <div className=\"flex-1 text-center\">\n            <h1 className=\"text-3xl font-extrabold text-white mb-2\">Gymnastics Graphics</h1>\n            <p className=\"text-zinc-500\">Control center for broadcast graphics</p>\n          </div>\n          <div className=\"absolute right-6 md:right-10 top-6 md:top-10\">\n            <CoordinatorStatus />\n          </div>\n        </div>\n\n        {/* Offline Banner */}\n        {isCoordinatorOffline && (\n          <div className=\"bg-red-900/30 border-2 border-red-800 rounded-xl p-5 mb-8\">\n            <div className=\"flex items-center justify-between flex-wrap gap-4\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 bg-red-900/50 rounded-full flex items-center justify-center\">\n                  <span className=\"text-xl\">*</span>\n                </div>\n                <div>\n                  <h3 className=\"text-lg font-bold text-white\">System is Sleeping</h3>\n                  <p className=\"text-sm text-red-300/70\">\n                    The coordinator is offline to save costs. VM operations are disabled.\n                  </p>\n                </div>\n              </div>\n              <button\n                onClick={wake}\n                disabled={isWaking}\n                className={`px-5 py-2.5 text-sm font-bold rounded-lg transition-colors ${\n                  isWaking\n                    ? 'bg-zinc-700 text-zinc-400 cursor-not-allowed'\n                    : 'bg-green-600 text-white hover:bg-green-500'\n                }`}\n              >\n                {isWaking ? (\n                  <span className=\"flex items-center gap-2\">\n                    <span className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                    Starting System...\n                  </span>\n                ) : (\n                  'Start System'\n                )}\n              </button>\n            </div>\n            {coordinatorError && (\n              <div className=\"mt-3 text-sm text-red-400 bg-red-900/30 rounded-lg px-3 py-2\">\n                Error: {coordinatorError}\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* Starting Banner */}\n        {isCoordinatorStarting && (\n          <div className=\"bg-yellow-900/30 border-2 border-yellow-800 rounded-xl p-5 mb-8\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 bg-yellow-900/50 rounded-full flex items-center justify-center\">\n                <span className=\"w-5 h-5 border-2 border-yellow-400 border-t-transparent rounded-full animate-spin\" />\n              </div>\n              <div>\n                <h3 className=\"text-lg font-bold text-white\">System Starting</h3>\n                <p className=\"text-sm text-yellow-300/70\">\n                  The coordinator is starting up. This typically takes 60-90 seconds.\n                </p>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Local Development Option */}\n        <div className=\"bg-gradient-to-r from-zinc-900 to-zinc-800 border-2 border-zinc-700 rounded-xl p-5 mb-8\">\n          <div className=\"flex items-center justify-between flex-wrap gap-4\">\n            <div>\n              <div className=\"flex items-center gap-2 mb-1\">\n                <span className=\"text-lg\">$</span>\n                <h3 className=\"text-lg font-bold text-white\">Local Development</h3>\n              </div>\n              <p className=\"text-sm text-zinc-400\">\n                Connect to local server at localhost:3003\n              </p>\n            </div>\n            <div className=\"flex gap-2\">\n              <Link\n                to=\"/local/producer\"\n                className=\"px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-500 transition-colors\"\n              >\n                Producer\n              </Link>\n              <Link\n                to=\"/local/talent\"\n                className=\"px-4 py-2 bg-zinc-700 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-600 transition-colors\"\n              >\n                Talent\n              </Link>\n              <Link\n                to=\"/local/camera-setup\"\n                className=\"px-4 py-2 bg-zinc-700 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-600 transition-colors\"\n              >\n                Cameras\n              </Link>\n            </div>\n          </div>\n        </div>\n\n        {/* Search and Create */}\n        <div className=\"flex flex-col sm:flex-row gap-4 mb-8\">\n          <div className=\"flex-1\">\n            <input\n              type=\"text\"\n              placeholder=\"Search competitions...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full px-4 py-3 bg-zinc-900 border border-zinc-700 rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500\"\n            />\n          </div>\n          <button\n            onClick={openCreateModal}\n            className=\"px-6 py-3 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-500 transition-colors\"\n          >\n            + Create Competition\n          </button>\n        </div>\n\n        {searchQuery && (\n          <p className=\"text-sm text-zinc-500 mb-4\">\n            Showing {filteredCount} of {totalCompetitions} competitions\n          </p>\n        )}\n\n        {/* Competition Groups */}\n        <CompetitionGroup\n          title=\"Today\"\n          competitions={groupedCompetitions.today}\n          emptyMessage={!searchQuery ? \"No competitions scheduled for today\" : null}\n          renderCard={(comp) => (\n            <CompetitionCard\n              key={comp.compId}\n              competition={comp}\n              vmStatuses={vmStatuses}\n              getGenderBadge={getGenderBadge}\n              getTeams={getTeams}\n              formatDisplayDate={formatDisplayDate}\n              getVMStatusBadge={getVMStatusBadge}\n              hasVMAssigned={hasVMAssigned}\n              availableVMs={availableVMs}\n              isCoordinatorOffline={isCoordinatorOffline}\n              assigningVm={assigningVm}\n              releasingVm={releasingVm}\n              onAssignVM={handleAssignVM}\n              onReleaseVM={handleReleaseVM}\n              onEdit={openEditModal}\n              onDuplicate={handleDuplicate}\n              onDelete={handleDeleteFromCard}\n              VmStatusIndicator={VmStatusIndicator}\n              navigate={navigate}\n            />\n          )}\n        />\n        <CompetitionGroup\n          title=\"Tomorrow\"\n          competitions={groupedCompetitions.tomorrow}\n          renderCard={(comp) => (\n            <CompetitionCard\n              key={comp.compId}\n              competition={comp}\n              vmStatuses={vmStatuses}\n              getGenderBadge={getGenderBadge}\n              getTeams={getTeams}\n              formatDisplayDate={formatDisplayDate}\n              getVMStatusBadge={getVMStatusBadge}\n              hasVMAssigned={hasVMAssigned}\n              availableVMs={availableVMs}\n              isCoordinatorOffline={isCoordinatorOffline}\n              assigningVm={assigningVm}\n              releasingVm={releasingVm}\n              onAssignVM={handleAssignVM}\n              onReleaseVM={handleReleaseVM}\n              onEdit={openEditModal}\n              onDuplicate={handleDuplicate}\n              onDelete={handleDeleteFromCard}\n              VmStatusIndicator={VmStatusIndicator}\n              navigate={navigate}\n            />\n          )}\n        />\n        <CompetitionGroup\n          title=\"Upcoming\"\n          competitions={groupedCompetitions.upcoming}\n          renderCard={(comp) => (\n            <CompetitionCard\n              key={comp.compId}\n              competition={comp}\n              vmStatuses={vmStatuses}\n              getGenderBadge={getGenderBadge}\n              getTeams={getTeams}\n              formatDisplayDate={formatDisplayDate}\n              getVMStatusBadge={getVMStatusBadge}\n              hasVMAssigned={hasVMAssigned}\n              availableVMs={availableVMs}\n              isCoordinatorOffline={isCoordinatorOffline}\n              assigningVm={assigningVm}\n              releasingVm={releasingVm}\n              onAssignVM={handleAssignVM}\n              onReleaseVM={handleReleaseVM}\n              onEdit={openEditModal}\n              onDuplicate={handleDuplicate}\n              onDelete={handleDeleteFromCard}\n              VmStatusIndicator={VmStatusIndicator}\n              navigate={navigate}\n            />\n          )}\n        />\n\n        {/* Past competitions toggle */}\n        {groupedCompetitions.past.length > 0 && (\n          <div className=\"mb-8\">\n            <button\n              onClick={() => setShowPastCompetitions(!showPastCompetitions)}\n              className=\"text-sm text-zinc-500 hover:text-white transition-colors flex items-center gap-2\"\n            >\n              <span>{showPastCompetitions ? 'v' : '>'}</span>\n              Past Competitions ({groupedCompetitions.past.length})\n            </button>\n            {showPastCompetitions && (\n              <div className=\"mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                {groupedCompetitions.past.map((comp) => (\n                  <CompetitionCard\n                    key={comp.compId}\n                    competition={comp}\n                    vmStatuses={vmStatuses}\n                    getGenderBadge={getGenderBadge}\n                    getTeams={getTeams}\n                    formatDisplayDate={formatDisplayDate}\n                    getVMStatusBadge={getVMStatusBadge}\n                    hasVMAssigned={hasVMAssigned}\n                    availableVMs={availableVMs}\n                    isCoordinatorOffline={isCoordinatorOffline}\n                    assigningVm={assigningVm}\n                    releasingVm={releasingVm}\n                    onAssignVM={handleAssignVM}\n                    onReleaseVM={handleReleaseVM}\n                    onEdit={openEditModal}\n                    onDuplicate={handleDuplicate}\n                    onDelete={handleDeleteFromCard}\n                    VmStatusIndicator={VmStatusIndicator}\n                    navigate={navigate}\n                  />\n                ))}\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* No Results */}\n        {filteredCount === 0 && !loading && (\n          <div className=\"text-center py-12\">\n            <div className=\"text-4xl mb-4\">?</div>\n            <h3 className=\"text-xl font-bold text-white mb-2\">No competitions found</h3>\n            <p className=\"text-zinc-400 mb-6\">\n              {searchQuery\n                ? `No competitions match \"${searchQuery}\"`\n                : \"Create your first competition to get started\"}\n            </p>\n            <button\n              onClick={openCreateModal}\n              className=\"inline-block px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-500 transition-colors\"\n            >\n              Create Competition\n            </button>\n          </div>\n        )}\n\n        {/* Management Tools Section */}\n        <Section title=\"Management Tools\">\n          <ToolCard\n            to=\"/media-manager\"\n            icon=\"[img]\"\n            title=\"Media Manager\"\n            description=\"Manage team logos and athlete headshots\"\n          />\n          <ToolCard\n            to=\"/url-generator\"\n            icon=\"[url]\"\n            title=\"URL Generator\"\n            description=\"Generate OBS overlay URLs\"\n          />\n          <ToolCard\n            to=\"/graphics-manager\"\n            icon=\"[gfx]\"\n            title=\"Graphics Manager\"\n            description=\"View all graphics, filter by category\"\n          />\n          <ToolCard\n            to=\"/theme-editor\"\n            icon=\"[theme]\"\n            title=\"Theme Editor\"\n            description=\"Create custom meet themes for branded graphics\"\n          />\n          <ToolCard\n            to=\"/background-generator\"\n            icon=\"[bg]\"\n            title=\"Background Generator\"\n            description=\"Create animated looping backgrounds from logo colors\"\n          />\n          <ToolCard\n            to=\"/import\"\n            icon=\"[csv]\"\n            title=\"Import Shows\"\n            description=\"Import show plans from CSV\"\n          />\n        </Section>\n\n        {/* System Administration Section */}\n        <Section title=\"System Administration\">\n          <ToolCard\n            to=\"/_admin/vm-pool\"\n            icon=\"[vm]\"\n            title=\"VM Pool\"\n            description=\"Manage EC2 instances\"\n          />\n          <ToolCard\n            to=\"/_admin/setup-guide\"\n            icon=\"[doc]\"\n            title=\"Setup Guide\"\n            description=\"Documentation for coordinator system\"\n          />\n          <ExternalToolCard\n            href=\"/output.html\"\n            icon=\"[out]\"\n            title=\"Graphics Output\"\n            description=\"View live graphics output\"\n          />\n        </Section>\n\n        {/* Overlay Templates Section */}\n        <Section title=\"Overlay Templates\">\n          <ExternalToolCard href=\"/overlays/logos.html\" icon=\"[logo]\" title=\"Team Logos\" description=\"Display team logos\" />\n          <ExternalToolCard href=\"/overlays/team-stats.html\" icon=\"[stats]\" title=\"Team Stats\" description=\"Show team statistics\" />\n          <ExternalToolCard href=\"/overlays/coaches.html\" icon=\"[coach]\" title=\"Coaches\" description=\"Display coaching staff\" />\n          <ExternalToolCard href=\"/overlays/hosts.html\" icon=\"[host]\" title=\"Hosts\" description=\"Show broadcast hosts\" />\n          <ExternalToolCard href=\"/overlays/event-bar.html\" icon=\"[bar]\" title=\"Event Bar\" description=\"Lower-third event info\" />\n          <ExternalToolCard href=\"/overlays/event-frame.html\" icon=\"[frame]\" title=\"Event Frame\" description=\"Full-screen event title\" />\n          <ExternalToolCard href=\"/overlays/stream.html\" icon=\"[stream]\" title=\"Stream Cards\" description=\"Starting/ending screens\" />\n        </Section>\n      </div>\n\n      {/* Create/Edit Competition Modal */}\n      {showModal && (\n        <CompetitionModal\n          editingCompId={editingCompId}\n          formData={formData}\n          setFormData={setFormData}\n          virtiusSessionId={virtiusSessionId}\n          setVirtiusSessionId={setVirtiusSessionId}\n          virtiusFetching={virtiusFetching}\n          virtiusError={virtiusError}\n          fetchFromVirtius={fetchFromVirtius}\n          teamCount={teamCount}\n          refreshing={refreshing}\n          refreshResult={refreshResult}\n          onSubmit={handleSubmit}\n          onDelete={handleDelete}\n          onRefreshTeamData={handleRefreshTeamData}\n          onClose={() => setShowModal(false)}\n          getTeamLogo={getTeamLogo}\n          availableThemes={availableThemes}\n        />\n      )}\n    </div>\n  );\n}\n\n// Competition Card Component\nfunction CompetitionCard({\n  competition,\n  vmStatuses,\n  getGenderBadge,\n  getTeams,\n  formatDisplayDate,\n  getVMStatusBadge,\n  hasVMAssigned,\n  availableVMs,\n  isCoordinatorOffline,\n  assigningVm,\n  releasingVm,\n  onAssignVM,\n  onReleaseVM,\n  onEdit,\n  onDuplicate,\n  onDelete,\n  VmStatusIndicator,\n  navigate\n}) {\n  const { compId, config, meetDate } = competition;\n  const genderBadge = getGenderBadge(config);\n  const teams = getTeams(config);\n  const vmBadge = getVMStatusBadge(compId);\n  const hasVM = hasVMAssigned(compId);\n  const isAssigning = assigningVm === compId;\n  const isReleasing = releasingVm === compId;\n  const canAssignVM = availableVMs.length > 0 && !hasVM && !isCoordinatorOffline;\n  const canReleaseVM = hasVM && !isCoordinatorOffline;\n\n  return (\n    <div className=\"bg-zinc-900 border-2 border-zinc-800 rounded-xl p-5 hover:border-zinc-700 transition-colors\">\n      <div className=\"flex items-start justify-between mb-3\">\n        <div className=\"flex items-center gap-2\">\n          <VmStatusIndicator compId={compId} />\n          <span className={`px-2 py-0.5 rounded text-xs font-bold text-white ${genderBadge.color}`}>\n            {genderBadge.label}\n          </span>\n          {vmBadge && (\n            <span\n              className={`px-2 py-0.5 rounded text-xs font-bold text-white ${vmBadge.color} cursor-help`}\n              title={vmBadge.vm.publicIp ? `IP: ${vmBadge.vm.publicIp}` : 'No IP assigned'}\n            >\n              {vmBadge.label}\n            </span>\n          )}\n        </div>\n        <span className=\"text-xs text-zinc-500\">{compId}</span>\n      </div>\n\n      <h3 className=\"text-lg font-bold text-white mb-1\">\n        {config?.eventName || 'Untitled Competition'}\n      </h3>\n\n      <div className=\"text-sm text-zinc-400 mb-2\">\n        {formatDisplayDate(meetDate)}\n        {config?.venue && <span className=\"text-zinc-500\"> - {config.venue}</span>}\n      </div>\n\n      {teams.length > 0 && (\n        <div className=\"text-sm text-zinc-500 mb-2\">\n          {teams.join(' vs ')}\n        </div>\n      )}\n\n      <div className=\"mb-3\">\n        <StatsStatusBadge compId={compId} config={config} />\n        <StatsDetailPanel compId={compId} config={config} />\n        <RankingsPanel compId={compId} config={config} />\n        <CommentaryStatusBadge compId={compId} />\n      </div>\n\n      {vmBadge?.vm?.publicIp && (\n        <div className=\"text-xs text-zinc-500 mb-3 font-mono\">\n          VM: {vmBadge.vm.publicIp}\n        </div>\n      )}\n\n      {/* Action buttons - always navigate, CompetitionLayout handles VM errors */}\n      <div className=\"flex gap-2 flex-wrap\">\n        <Link\n          to={`/${compId}/producer`}\n          className=\"px-3 py-1.5 text-sm font-medium rounded-lg transition-colors bg-blue-600 text-white hover:bg-blue-500\"\n        >\n          Producer\n        </Link>\n        <Link\n          to={`/${compId}/talent`}\n          className=\"px-3 py-1.5 text-sm font-medium rounded-lg transition-colors bg-zinc-800 text-zinc-300 hover:bg-zinc-700\"\n        >\n          Talent\n        </Link>\n        <a\n          href={`/output.html?comp=${compId}`}\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          className=\"px-3 py-1.5 bg-zinc-800 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-700 transition-colors\"\n        >\n          Graphics\n        </a>\n        <Link\n          to={`/${compId}/camera-setup`}\n          className=\"px-3 py-1.5 bg-zinc-800 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-700 transition-colors\"\n        >\n          Cameras\n        </Link>\n        <Link\n          to={`/${compId}/checklist`}\n          className=\"px-3 py-1.5 bg-zinc-800 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-700 transition-colors\"\n        >\n          Checklist\n        </Link>\n        <Link\n          to={`/${compId}/commentary`}\n          className=\"px-3 py-1.5 bg-zinc-800 text-zinc-300 text-sm font-medium rounded-lg hover:bg-zinc-700 transition-colors\"\n        >\n          Commentary\n        </Link>\n      </div>\n\n      {/* VM & Edit Controls */}\n      <div className=\"flex gap-2 mt-3 pt-3 border-t border-zinc-800 flex-wrap\">\n        {!hasVM ? (\n          <button\n            onClick={() => onAssignVM(compId)}\n            disabled={!canAssignVM || isAssigning}\n            className={`px-3 py-1.5 text-sm font-medium rounded-lg transition-colors ${\n              canAssignVM && !isAssigning\n                ? 'bg-green-600 text-white hover:bg-green-500'\n                : 'bg-zinc-800 text-zinc-500 cursor-not-allowed'\n            }`}\n            title={\n              isCoordinatorOffline\n                ? 'Start system first'\n                : !canAssignVM\n                  ? 'No VMs available'\n                  : undefined\n            }\n          >\n            {isAssigning ? (\n              <span className=\"flex items-center gap-1\">\n                <span className=\"w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                Assigning...\n              </span>\n            ) : (\n              `Assign VM${!isCoordinatorOffline && availableVMs.length > 0 ? ` (${availableVMs.length})` : ''}`\n            )}\n          </button>\n        ) : (\n          <button\n            onClick={() => onReleaseVM(compId)}\n            disabled={!canReleaseVM || isReleasing}\n            className={`px-3 py-1.5 text-sm font-medium rounded-lg transition-colors ${\n              canReleaseVM && !isReleasing\n                ? 'bg-orange-600 text-white hover:bg-orange-500'\n                : 'bg-zinc-800 text-zinc-500 cursor-not-allowed'\n            }`}\n            title={isCoordinatorOffline ? 'Start system first' : undefined}\n          >\n            {isReleasing ? (\n              <span className=\"flex items-center gap-1\">\n                <span className=\"w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                Releasing...\n              </span>\n            ) : (\n              'Release VM'\n            )}\n          </button>\n        )}\n        <button\n          onClick={() => onEdit(compId)}\n          className=\"px-3 py-1.5 bg-zinc-800 text-zinc-300 text-sm rounded-lg hover:bg-zinc-700 transition-colors\"\n        >\n          Edit\n        </button>\n        <button\n          onClick={() => onDuplicate(compId)}\n          className=\"px-3 py-1.5 bg-zinc-800 text-zinc-300 text-sm rounded-lg hover:bg-zinc-700 transition-colors\"\n        >\n          Duplicate\n        </button>\n        <button\n          onClick={() => onDelete(compId)}\n          className=\"px-3 py-1.5 bg-zinc-800 text-red-400 text-sm rounded-lg hover:bg-zinc-700 transition-colors\"\n        >\n          Delete\n        </button>\n      </div>\n    </div>\n  );\n}\n\n// Competition Group Component\nfunction CompetitionGroup({ title, competitions, emptyMessage, renderCard }) {\n  if (competitions.length === 0) {\n    if (emptyMessage) {\n      return (\n        <div className=\"mb-8\">\n          <h2 className=\"text-sm font-semibold text-zinc-400 uppercase tracking-wide mb-4 pb-2 border-b border-zinc-800\">\n            {title}\n          </h2>\n          <p className=\"text-zinc-600 text-sm italic\">{emptyMessage}</p>\n        </div>\n      );\n    }\n    return null;\n  }\n\n  return (\n    <div className=\"mb-8\">\n      <h2 className=\"text-sm font-semibold text-zinc-400 uppercase tracking-wide mb-4 pb-2 border-b border-zinc-800\">\n        {title} ({competitions.length})\n      </h2>\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {competitions.map(renderCard)}\n      </div>\n    </div>\n  );\n}\n\n// Section Component for tools\nfunction Section({ title, children }) {\n  return (\n    <div className=\"mb-10\">\n      <div className=\"text-sm font-semibold text-zinc-400 uppercase tracking-wide mb-4 pb-2 border-b border-zinc-800\">\n        {title}\n      </div>\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5\">\n        {children}\n      </div>\n    </div>\n  );\n}\n\n// Tool Card Component\nfunction ToolCard({ to, icon, title, description }) {\n  return (\n    <Link\n      to={to}\n      className=\"block bg-zinc-900 border-2 border-zinc-800 rounded-xl p-6 hover:border-blue-500 hover:-translate-y-0.5 transition-all\"\n    >\n      <div className=\"text-2xl mb-3 text-zinc-500\">{icon}</div>\n      <div className=\"text-lg font-bold text-white mb-2\">{title}</div>\n      <div className=\"text-sm text-zinc-500 leading-relaxed\">{description}</div>\n    </Link>\n  );\n}\n\n// External Tool Card Component\nfunction ExternalToolCard({ href, icon, title, description }) {\n  return (\n    <a\n      href={href}\n      target=\"_blank\"\n      rel=\"noopener noreferrer\"\n      className=\"block bg-zinc-900 border-2 border-zinc-800 rounded-xl p-6 hover:border-blue-500 hover:-translate-y-0.5 transition-all\"\n    >\n      <div className=\"text-2xl mb-3 text-zinc-500\">{icon}</div>\n      <div className=\"text-lg font-bold text-white mb-2\">{title}</div>\n      <div className=\"text-sm text-zinc-500 leading-relaxed\">{description}</div>\n    </a>\n  );\n}\n\n// Competition Modal Component\nfunction CompetitionModal({\n  editingCompId,\n  formData,\n  setFormData,\n  virtiusSessionId,\n  setVirtiusSessionId,\n  virtiusFetching,\n  virtiusError,\n  fetchFromVirtius,\n  teamCount,\n  refreshing,\n  refreshResult,\n  onSubmit,\n  onDelete,\n  onRefreshTeamData,\n  onClose,\n  getTeamLogo,\n  availableThemes = {}\n}) {\n  return (\n    <div\n      className=\"fixed inset-0 bg-black/80 flex items-center justify-center z-50\"\n      onClick={onClose}\n    >\n      <div\n        className=\"bg-zinc-900 border border-zinc-800 rounded-xl p-8 w-full max-w-lg max-h-[90vh] overflow-y-auto\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        <h2 className=\"text-xl font-bold text-white mb-2\">\n          {editingCompId ? 'Edit Competition' : 'Create Competition'}\n        </h2>\n        <p className=\"text-sm text-zinc-500 mb-6\">Configure competition details</p>\n\n        <form onSubmit={onSubmit}>\n          {/* Virtius Import Section */}\n          <div className=\"mb-6 p-4 bg-zinc-800/50 border border-zinc-700 rounded-lg\">\n            <div className=\"text-xs text-zinc-400 mb-2\">Import from Virtius (optional)</div>\n            <div className=\"flex gap-2\">\n              <input\n                type=\"text\"\n                value={virtiusSessionId}\n                onChange={(e) => setVirtiusSessionId(e.target.value)}\n                placeholder=\"Session ID, e.g., EeUcxrjyBD\"\n                className=\"flex-1 px-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n              />\n              <button\n                type=\"button\"\n                onClick={fetchFromVirtius}\n                disabled={virtiusFetching || !virtiusSessionId.trim()}\n                className=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 disabled:bg-zinc-700 disabled:text-zinc-500 text-white text-sm font-medium rounded-lg transition-colors\"\n              >\n                {virtiusFetching ? 'Fetching...' : 'Fetch'}\n              </button>\n            </div>\n            {virtiusError && (\n              <div className=\"mt-2 text-xs text-red-400\">{virtiusError}</div>\n            )}\n          </div>\n\n          <FormGroup label=\"Competition ID (no spaces, lowercase)\">\n            <input\n              type=\"text\"\n              value={formData.compId}\n              onChange={(e) => setFormData({ ...formData, compId: e.target.value })}\n              disabled={!!editingCompId}\n              placeholder=\"e.g., court1, meet-a, ncaa-finals\"\n              pattern=\"[a-z0-9-]+\"\n              required\n              className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500 disabled:opacity-50\"\n            />\n          </FormGroup>\n\n          <div className=\"grid grid-cols-2 gap-3\">\n            <FormGroup label=\"Competition Type\">\n              <select\n                value={formData.compType}\n                onChange={(e) => {\n                  const newCompType = e.target.value;\n                  const inferredGender = getGenderFromCompType(newCompType);\n                  setFormData({ ...formData, compType: newCompType, gender: inferredGender || formData.gender });\n                }}\n                required\n                className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n              >\n                <option value=\"\">Select type...</option>\n                {competitionTypes.map((type) => (\n                  <option key={type.value} value={type.value}>{type.label}</option>\n                ))}\n              </select>\n            </FormGroup>\n\n            <FormGroup label=\"Gender\">\n              <select\n                value={formData.gender}\n                onChange={(e) => setFormData({ ...formData, gender: e.target.value })}\n                required\n                className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n              >\n                <option value=\"\">Select gender...</option>\n                <option value=\"womens\">Women's</option>\n                <option value=\"mens\">Men's</option>\n              </select>\n            </FormGroup>\n          </div>\n\n          <FormGroup label=\"Event Name\">\n            <input\n              type=\"text\"\n              value={formData.eventName}\n              onChange={(e) => setFormData({ ...formData, eventName: e.target.value })}\n              placeholder=\"e.g., Big Ten Dual Meet\"\n              required\n              className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n            />\n          </FormGroup>\n\n          <FormGroup label=\"Meet Date\">\n            <input\n              type=\"text\"\n              value={formData.meetDate}\n              onChange={(e) => setFormData({ ...formData, meetDate: e.target.value })}\n              placeholder=\"e.g., January 15, 2025\"\n              required\n              className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n            />\n          </FormGroup>\n\n          <div className=\"grid grid-cols-2 gap-3\">\n            <FormGroup label=\"Venue\">\n              <input\n                type=\"text\"\n                value={formData.venue}\n                onChange={(e) => setFormData({ ...formData, venue: e.target.value })}\n                placeholder=\"e.g., Crisler Center\"\n                required\n                className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n              />\n            </FormGroup>\n            <FormGroup label=\"Location\">\n              <input\n                type=\"text\"\n                value={formData.location}\n                onChange={(e) => setFormData({ ...formData, location: e.target.value })}\n                placeholder=\"e.g., Ann Arbor, MI\"\n                required\n                className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n              />\n            </FormGroup>\n          </div>\n\n          <FormGroup label=\"Meet Theme (optional)\">\n            <select\n              value={formData.meetTheme}\n              onChange={(e) => setFormData({ ...formData, meetTheme: e.target.value })}\n              className=\"w-full px-3 py-2.5 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n            >\n              <option value=\"\">None (use default styling)</option>\n              {Object.entries(availableThemes).map(([id, theme]) => (\n                <option key={id} value={id}>\n                  {theme.name || id}\n                </option>\n              ))}\n            </select>\n            {formData.meetTheme && availableThemes[formData.meetTheme] && (\n              <div className=\"mt-2 flex items-center gap-2\">\n                <div\n                  className=\"w-4 h-4 rounded-sm border border-zinc-600\"\n                  style={{ backgroundColor: availableThemes[formData.meetTheme]?.colors?.headerBar || availableThemes[formData.meetTheme]?.colors?.accentPrimary }}\n                />\n                <span className=\"text-xs text-zinc-400\">\n                  {availableThemes[formData.meetTheme]?.description || 'Custom theme'}\n                </span>\n              </div>\n            )}\n          </FormGroup>\n\n          {/* Team inputs */}\n          <TeamLogoInput\n            teamNum={1}\n            teamName={formData.team1Name}\n            teamLogo={formData.team1Logo}\n            onNameChange={(val) => setFormData({ ...formData, team1Name: val })}\n            onLogoChange={(val) => setFormData({ ...formData, team1Logo: val })}\n            gender={formData.gender}\n            getTeamLogo={getTeamLogo}\n            required\n          />\n          <TeamLogoInput\n            teamNum={2}\n            teamName={formData.team2Name}\n            teamLogo={formData.team2Logo}\n            onNameChange={(val) => setFormData({ ...formData, team2Name: val })}\n            onLogoChange={(val) => setFormData({ ...formData, team2Logo: val })}\n            gender={formData.gender}\n            getTeamLogo={getTeamLogo}\n            required\n          />\n          {teamCount >= 3 && (\n            <TeamLogoInput\n              teamNum={3}\n              teamName={formData.team3Name}\n              teamLogo={formData.team3Logo}\n              onNameChange={(val) => setFormData({ ...formData, team3Name: val })}\n              onLogoChange={(val) => setFormData({ ...formData, team3Logo: val })}\n              gender={formData.gender}\n              getTeamLogo={getTeamLogo}\n              required\n            />\n          )}\n          {teamCount >= 4 && (\n            <TeamLogoInput\n              teamNum={4}\n              teamName={formData.team4Name}\n              teamLogo={formData.team4Logo}\n              onNameChange={(val) => setFormData({ ...formData, team4Name: val })}\n              onLogoChange={(val) => setFormData({ ...formData, team4Logo: val })}\n              gender={formData.gender}\n              getTeamLogo={getTeamLogo}\n              required\n            />\n          )}\n          {teamCount >= 5 && (\n            <TeamLogoInput\n              teamNum={5}\n              teamName={formData.team5Name}\n              teamLogo={formData.team5Logo}\n              onNameChange={(val) => setFormData({ ...formData, team5Name: val })}\n              onLogoChange={(val) => setFormData({ ...formData, team5Logo: val })}\n              gender={formData.gender}\n              getTeamLogo={getTeamLogo}\n              required\n            />\n          )}\n          {teamCount >= 6 && (\n            <TeamLogoInput\n              teamNum={6}\n              teamName={formData.team6Name}\n              teamLogo={formData.team6Logo}\n              onNameChange={(val) => setFormData({ ...formData, team6Name: val })}\n              onLogoChange={(val) => setFormData({ ...formData, team6Logo: val })}\n              gender={formData.gender}\n              getTeamLogo={getTeamLogo}\n              required\n            />\n          )}\n          {teamCount >= 7 && (\n            <TeamLogoInput\n              teamNum={7}\n              teamName={formData.team7Name}\n              teamLogo={formData.team7Logo}\n              onNameChange={(val) => setFormData({ ...formData, team7Name: val })}\n              onLogoChange={(val) => setFormData({ ...formData, team7Logo: val })}\n              gender={formData.gender}\n              getTeamLogo={getTeamLogo}\n              required\n            />\n          )}\n\n          {/* Refresh Team Data - only when editing */}\n          {editingCompId && (\n            <div className=\"mb-4 p-4 bg-zinc-800/50 border border-zinc-700 rounded-lg\">\n              <div className=\"text-xs text-zinc-400 mb-2\">Sync Headshots from Media Manager</div>\n              <p className=\"text-xs text-zinc-500 mb-3\">\n                Re-fetch rosters from RTN and merge latest headshots from Firebase.\n              </p>\n              <button\n                type=\"button\"\n                onClick={onRefreshTeamData}\n                disabled={refreshing}\n                className=\"px-4 py-2 bg-green-600 hover:bg-green-500 disabled:bg-zinc-700 disabled:text-zinc-500 text-white text-sm font-medium rounded-lg transition-colors\"\n              >\n                {refreshing ? 'Refreshing...' : 'Refresh Team Data'}\n              </button>\n              {refreshResult === 'success' && (\n                <span className=\"ml-3 text-green-400 text-sm\">Rosters and headshots updated!</span>\n              )}\n              {refreshResult === 'error' && (\n                <span className=\"ml-3 text-red-400 text-sm\">Failed to refresh — check console for details</span>\n              )}\n            </div>\n          )}\n\n          <div className=\"flex gap-3 mt-6\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"flex-1 px-4 py-2.5 bg-zinc-800 text-zinc-300 rounded-lg hover:bg-zinc-700 transition-colors\"\n            >\n              Cancel\n            </button>\n            {editingCompId && (\n              <button\n                type=\"button\"\n                onClick={onDelete}\n                className=\"px-4 py-2.5 bg-red-600 text-white rounded-lg hover:bg-red-500 transition-colors\"\n              >\n                Delete\n              </button>\n            )}\n            <button\n              type=\"submit\"\n              className=\"flex-1 px-4 py-2.5 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-500 transition-colors\"\n            >\n              Save Competition\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n}\n\n// Form Group Component\nfunction FormGroup({ label, children }) {\n  return (\n    <div className=\"mb-4\">\n      <label className=\"block text-xs text-zinc-400 mb-1.5\">{label}</label>\n      {children}\n    </div>\n  );\n}\n\n// Team Logo Input Component\nfunction TeamLogoInput({ teamNum, teamName, teamLogo, onNameChange, onLogoChange, required, gender, getTeamLogo }) {\n  const effectiveGender = gender || 'mens';\n  const hasLogoFromFirebase = teamName && getTeamLogo(teamName, effectiveGender);\n  const hasLogoUrl = !!teamLogo;\n  const logoStatus = hasLogoUrl ? 'has-url' : hasLogoFromFirebase ? 'in-library' : teamName ? 'missing' : 'no-name';\n\n  return (\n    <div className=\"mb-4 p-3 bg-zinc-800/30 rounded-lg border border-zinc-800\">\n      <div className=\"flex items-center justify-between mb-2\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"text-xs text-zinc-400\">Team {teamNum}</span>\n          {effectiveGender && (\n            <span className={`px-1.5 py-0.5 rounded text-[10px] font-medium ${\n              effectiveGender === 'womens'\n                ? 'bg-pink-500/20 text-pink-400 border border-pink-500/30'\n                : 'bg-blue-500/20 text-blue-400 border border-blue-500/30'\n            }`}>\n              {effectiveGender === 'womens' ? \"W\" : \"M\"}\n            </span>\n          )}\n        </div>\n        <div className=\"flex items-center gap-3\">\n          {logoStatus === 'has-url' && (\n            <span className=\"flex items-center gap-1 text-xs text-green-400\">\n              <CheckCircleIcon className=\"w-3 h-3\" /> Logo set\n            </span>\n          )}\n          {logoStatus === 'in-library' && (\n            <span className=\"flex items-center gap-1 text-xs text-blue-400\">\n              <CheckCircleIcon className=\"w-3 h-3\" /> In library\n            </span>\n          )}\n          {logoStatus === 'missing' && (\n            <Link\n              to=\"/media-manager\"\n              className=\"flex items-center gap-1 text-xs text-amber-400 hover:text-amber-300\"\n            >\n              <ExclamationTriangleIcon className=\"w-3 h-3\" /> Add logo\n            </Link>\n          )}\n        </div>\n      </div>\n      <div className=\"flex gap-2\">\n        <div className=\"w-12 h-12 bg-zinc-700 rounded-lg flex items-center justify-center overflow-hidden flex-shrink-0\">\n          {(teamLogo || (teamName && getTeamLogo(teamName, effectiveGender))) ? (\n            <img\n              src={teamLogo || getTeamLogo(teamName, effectiveGender)}\n              alt={teamName || 'Team logo'}\n              className=\"w-10 h-10 object-contain\"\n            />\n          ) : (\n            <span className=\"text-zinc-500 text-lg\">?</span>\n          )}\n        </div>\n        <div className=\"flex-1 space-y-2\">\n          <input\n            type=\"text\"\n            value={teamName}\n            onChange={(e) => onNameChange(e.target.value)}\n            placeholder={`Team ${teamNum} name`}\n            required={required}\n            className=\"w-full px-3 py-2 bg-zinc-800 border border-zinc-700 rounded-lg text-white text-sm focus:outline-none focus:border-blue-500\"\n          />\n          <input\n            type=\"text\"\n            value={teamLogo}\n            onChange={(e) => onLogoChange(e.target.value)}\n            placeholder=\"Logo URL (auto-filled if in library)\"\n            className=\"w-full px-3 py-1.5 bg-zinc-800 border border-zinc-700 rounded text-white text-xs focus:outline-none focus:border-blue-500\"\n          />\n        </div>\n      </div>\n    </div>\n  );\n}\n\n/**\n * CommentaryStatusBadge - Shows commentary staffing status on a competition card.\n * Reads competitions/{compId}/commentary from Firebase.\n */\nfunction CommentaryStatusBadge({ compId }) {\n  const [staff, setStaff] = useState(null);\n\n  useEffect(() => {\n    const staffRef = ref(db, `competitions/${compId}/commentary`);\n    const unsubscribe = onValue(staffRef, (snapshot) => {\n      setStaff(snapshot.val());\n    });\n    return () => unsubscribe();\n  }, [compId]);\n\n  if (!staff) return null;\n\n  const entries = Object.values(staff);\n  if (entries.length === 0) return null;\n\n  const confirmed = entries.filter(s => s.status === 'confirmed' || s.status === 'briefed').length;\n  const total = entries.length;\n  const allConfirmed = confirmed === total;\n\n  return (\n    <div className={`inline-flex items-center gap-1.5 mt-1 px-2 py-0.5 rounded text-xs font-medium ${\n      allConfirmed ? 'bg-green-900/40 text-green-300 border border-green-800' : 'bg-yellow-900/40 text-yellow-300 border border-yellow-800'\n    }`}>\n      <span>{allConfirmed ? '✓' : '⋯'}</span>\n      Commentary: {confirmed}/{total} confirmed\n    </div>\n  );\n}\n","numLines":1592,"startLine":1,"totalLines":1592}}}
