{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MR6zU8MsJmvEf7KAViX6Jo","type":"tool_result","content":"     1→import { useState } from 'react';\n     2→import { Link, useNavigate } from 'react-router-dom';\n     3→import { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\n     4→import {\n     5→  PlusIcon,\n     6→  MagnifyingGlassIcon,\n     7→  PhoneIcon,\n     8→  EnvelopeIcon,\n     9→  UserGroupIcon,\n    10→  SparklesIcon,\n    11→  XMarkIcon,\n    12→} from '@heroicons/react/24/solid';\n    13→\n    14→const STATUS_OPTIONS = [\n    15→  { value: '', label: 'All Statuses' },\n    16→  { value: 'ready', label: 'Ready' },\n    17→  { value: 'has-contact', label: 'Has Contact' },\n    18→  { value: 'did-2025', label: 'Did 2025' },\n    19→  { value: 'need-info', label: 'Need Info' },\n    20→];\n    21→\n    22→const WAG_MAG_OPTIONS = [\n    23→  { value: '', label: 'All' },\n    24→  { value: 'WAG', label: 'WAG' },\n    25→  { value: 'MAG', label: 'MAG' },\n    26→  { value: 'Both', label: 'Both' },\n    27→];\n    28→\n    29→const ROLE_OPTIONS = [\n    30→  { value: '', label: 'All Roles' },\n    31→  { value: 'Play by Play / Lead', label: 'Play by Play' },\n    32→  { value: 'Color / Analyst', label: 'Color / Analyst' },\n    33→  { value: 'Does not matter', label: 'Flexible' },\n    34→];\n    35→\n    36→/**\n    37→ * TalentPage - Global talent roster management page.\n    38→ * URL: /talent\n    39→ */\n    40→export default function TalentPage() {\n    41→  const { talentList, loading, error, createTalent } = useTalentRoster();\n    42→  const navigate = useNavigate();\n    43→\n    44→  const [search, setSearch] = useState('');\n    45→  const [statusFilter, setStatusFilter] = useState('');\n    46→  const [wagMagFilter, setWagMagFilter] = useState('');\n    47→  const [roleFilter, setRoleFilter] = useState('');\n    48→  const [showAddModal, setShowAddModal] = useState(false);\n    49→  const [saving, setSaving] = useState(false);\n    50→\n    51→  const [newTalent, setNewTalent] = useState({\n    52→    name: '',\n    53→    phone: '',\n    54→    email: '',\n    55→    wagMag: 'Both',\n    56→    commentaryRole: 'Does not matter',\n    57→    canProduce: false,\n    58→    affiliation: '',\n    59→    conference: '',\n    60→    status: 'has-contact',\n    61→    notes: '',\n    62→    otherInterests: [],\n    63→  });\n    64→\n    65→  const filtered = talentList.filter((t) => {\n    66→    if (search) {\n    67→      const q = search.toLowerCase();\n    68→      if (\n    69→        !t.name?.toLowerCase().includes(q) &&\n    70→        !t.affiliation?.toLowerCase().includes(q) &&\n    71→        !t.conference?.toLowerCase().includes(q) &&\n    72→        !t.notes?.toLowerCase().includes(q)\n    73→      ) return false;\n    74→    }\n    75→    if (statusFilter && t.status !== statusFilter) return false;\n    76→    if (wagMagFilter && t.wagMag !== wagMagFilter) return false;\n    77→    if (roleFilter && t.commentaryRole !== roleFilter) return false;\n    78→    return true;\n    79→  });\n    80→\n    81→  const counts = {\n    82→    ready: talentList.filter(t => t.status === 'ready').length,\n    83→    hasContact: talentList.filter(t => t.status === 'has-contact').length,\n    84→    didPrior: talentList.filter(t => t.status?.startsWith('did-')).length,\n    85→    needInfo: talentList.filter(t => t.status === 'need-info').length,\n    86→  };\n    87→\n    88→  async function handleCreate(e) {\n    89→    e.preventDefault();\n    90→    if (!newTalent.name.trim()) return;\n    91→    setSaving(true);\n    92→    try {\n    93→      const id = await createTalent(newTalent);\n    94→      setShowAddModal(false);\n    95→      setNewTalent({\n    96→        name: '', phone: '', email: '', wagMag: 'Both',\n    97→        commentaryRole: 'Does not matter', canProduce: false,\n    98→        affiliation: '', conference: '', status: 'has-contact', notes: '', otherInterests: [],\n    99→      });\n   100→      navigate(`/talent/${id}`);\n   101→    } finally {\n   102→      setSaving(false);\n   103→    }\n   104→  }\n   105→\n   106→  return (\n   107→    <div className=\"min-h-screen bg-gray-900 text-white\">\n   108→      {/* Header */}\n   109→      <div className=\"bg-gray-800 border-b border-gray-700 px-6 py-4\">\n   110→        <div className=\"max-w-7xl mx-auto flex items-center justify-between\">\n   111→          <div className=\"flex items-center gap-4\">\n   112→            <Link to=\"/\" className=\"text-gray-400 hover:text-white text-sm transition-colors\">\n   113→              ← Home\n   114→            </Link>\n   115→            <div>\n   116→              <h1 className=\"text-xl font-bold text-white flex items-center gap-2\">\n   117→                <UserGroupIcon className=\"w-6 h-6 text-blue-400\" />\n   118→                Talent Roster\n   119→              </h1>\n   120→              <p className=\"text-gray-400 text-sm\">{talentList.length} total contacts</p>\n   121→            </div>\n   122→          </div>\n   123→          <div className=\"flex items-center gap-3\">\n   124→            <Link\n   125→              to=\"/talent/discover\"\n   126→              className=\"flex items-center gap-2 px-3 py-2 bg-purple-700 hover:bg-purple-600 rounded-lg text-sm font-medium transition-colors\"\n   127→            >\n   128→              <SparklesIcon className=\"w-4 h-4\" />\n   129→              Discover Talent\n   130→            </Link>\n   131→            <button\n   132→              onClick={() => setShowAddModal(true)}\n   133→              className=\"flex items-center gap-2 px-3 py-2 bg-blue-600 hover:bg-blue-500 rounded-lg text-sm font-medium transition-colors\"\n   134→            >\n   135→              <PlusIcon className=\"w-4 h-4\" />\n   136→              Add Talent\n   137→            </button>\n   138→          </div>\n   139→        </div>\n   140→      </div>\n   141→\n   142→      <div className=\"max-w-7xl mx-auto px-6 py-6\">\n   143→        {/* Status summary strip */}\n   144→        <div className=\"grid grid-cols-4 gap-3 mb-6\">\n   145→          {[\n   146→            { label: 'Ready', count: counts.ready, color: 'border-green-600 bg-green-900/20', filter: 'ready' },\n   147→            { label: 'Has Contact', count: counts.hasContact, color: 'border-blue-600 bg-blue-900/20', filter: 'has-contact' },\n   148→            { label: 'Did Prior Season', count: counts.didPrior, color: 'border-amber-600 bg-amber-900/20', filter: 'did-2025' },\n   149→            { label: 'Need Info', count: counts.needInfo, color: 'border-gray-600 bg-gray-800/50', filter: 'need-info' },\n   150→          ].map(({ label, count, color, filter }) => (\n   151→            <button\n   152→              key={filter}\n   153→              onClick={() => setStatusFilter(statusFilter === filter ? '' : filter)}\n   154→              className={`rounded-lg border p-3 text-left transition-colors ${color} ${statusFilter === filter ? 'ring-2 ring-white/20' : 'hover:bg-opacity-30'}`}\n   155→            >\n   156→              <div className=\"text-2xl font-bold text-white\">{count}</div>\n   157→              <div className=\"text-xs text-gray-300 mt-0.5\">{label}</div>\n   158→            </button>\n   159→          ))}\n   160→        </div>\n   161→\n   162→        {/* Filter row */}\n   163→        <div className=\"flex items-center gap-3 mb-5 flex-wrap\">\n   164→          <div className=\"relative flex-1 min-w-48\">\n   165→            <MagnifyingGlassIcon className=\"w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n   166→            <input\n   167→              type=\"text\"\n   168→              placeholder=\"Search by name, affiliation, conference...\"\n   169→              value={search}\n   170→              onChange={(e) => setSearch(e.target.value)}\n   171→              className=\"w-full pl-9 pr-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500\"\n   172→            />\n   173→          </div>\n   174→          <select\n   175→            value={statusFilter}\n   176→            onChange={(e) => setStatusFilter(e.target.value)}\n   177→            className=\"px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   178→          >\n   179→            {STATUS_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}\n   180→          </select>\n   181→          <select\n   182→            value={wagMagFilter}\n   183→            onChange={(e) => setWagMagFilter(e.target.value)}\n   184→            className=\"px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   185→          >\n   186→            {WAG_MAG_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}\n   187→          </select>\n   188→          <select\n   189→            value={roleFilter}\n   190→            onChange={(e) => setRoleFilter(e.target.value)}\n   191→            className=\"px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   192→          >\n   193→            {ROLE_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}\n   194→          </select>\n   195→          {(search || statusFilter || wagMagFilter || roleFilter) && (\n   196→            <button\n   197→              onClick={() => { setSearch(''); setStatusFilter(''); setWagMagFilter(''); setRoleFilter(''); }}\n   198→              className=\"text-gray-400 hover:text-white text-sm flex items-center gap-1\"\n   199→            >\n   200→              <XMarkIcon className=\"w-4 h-4\" />\n   201→              Clear\n   202→            </button>\n   203→          )}\n   204→          <span className=\"text-gray-500 text-sm ml-auto\">{filtered.length} shown</span>\n   205→        </div>\n   206→\n   207→        {/* Talent list */}\n   208→        {loading ? (\n   209→          <div className=\"text-center py-20 text-gray-500\">Loading roster...</div>\n   210→        ) : error ? (\n   211→          <div className=\"text-center py-20 text-red-400\">{error}</div>\n   212→        ) : filtered.length === 0 ? (\n   213→          <div className=\"text-center py-20 text-gray-500\">\n   214→            {talentList.length === 0 ? 'No talent in roster yet. Add someone to get started.' : 'No results match your filters.'}\n   215→          </div>\n   216→        ) : (\n   217→          <div className=\"space-y-2\">\n   218→            {filtered.map((talent) => (\n   219→              <TalentCard key={talent.id} talent={talent} />\n   220→            ))}\n   221→          </div>\n   222→        )}\n   223→      </div>\n   224→\n   225→      {/* Add Talent Modal */}\n   226→      {showAddModal && (\n   227→        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n   228→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 w-full max-w-lg\">\n   229→            <div className=\"flex items-center justify-between px-5 py-4 border-b border-gray-700\">\n   230→              <h2 className=\"text-lg font-semibold text-white\">Add Talent</h2>\n   231→              <button onClick={() => setShowAddModal(false)} className=\"text-gray-400 hover:text-white\">\n   232→                <XMarkIcon className=\"w-5 h-5\" />\n   233→              </button>\n   234→            </div>\n   235→            <form onSubmit={handleCreate} className=\"p-5 space-y-4\">\n   236→              <div className=\"grid grid-cols-2 gap-4\">\n   237→                <div className=\"col-span-2\">\n   238→                  <label className=\"block text-xs text-gray-400 mb-1\">Name *</label>\n   239→                  <input\n   240→                    required\n   241→                    value={newTalent.name}\n   242→                    onChange={e => setNewTalent(p => ({ ...p, name: e.target.value }))}\n   243→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   244→                    placeholder=\"Full name\"\n   245→                  />\n   246→                </div>\n   247→                <div>\n   248→                  <label className=\"block text-xs text-gray-400 mb-1\">Phone</label>\n   249→                  <input\n   250→                    value={newTalent.phone}\n   251→                    onChange={e => setNewTalent(p => ({ ...p, phone: e.target.value }))}\n   252→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   253→                    placeholder=\"(555) 123-4567\"\n   254→                  />\n   255→                </div>\n   256→                <div>\n   257→                  <label className=\"block text-xs text-gray-400 mb-1\">Email</label>\n   258→                  <input\n   259→                    type=\"email\"\n   260→                    value={newTalent.email}\n   261→                    onChange={e => setNewTalent(p => ({ ...p, email: e.target.value }))}\n   262→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   263→                    placeholder=\"email@example.com\"\n   264→                  />\n   265→                </div>\n   266→                <div>\n   267→                  <label className=\"block text-xs text-gray-400 mb-1\">WAG / MAG</label>\n   268→                  <select\n   269→                    value={newTalent.wagMag}\n   270→                    onChange={e => setNewTalent(p => ({ ...p, wagMag: e.target.value }))}\n   271→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   272→                  >\n   273→                    <option value=\"WAG\">WAG</option>\n   274→                    <option value=\"MAG\">MAG</option>\n   275→                    <option value=\"Both\">Both</option>\n   276→                  </select>\n   277→                </div>\n   278→                <div>\n   279→                  <label className=\"block text-xs text-gray-400 mb-1\">Role</label>\n   280→                  <select\n   281→                    value={newTalent.commentaryRole}\n   282→                    onChange={e => setNewTalent(p => ({ ...p, commentaryRole: e.target.value }))}\n   283→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   284→                  >\n   285→                    <option value=\"Play by Play / Lead\">Play by Play / Lead</option>\n   286→                    <option value=\"Color / Analyst\">Color / Analyst</option>\n   287→                    <option value=\"Does not matter\">Does not matter</option>\n   288→                  </select>\n   289→                </div>\n   290→                <div>\n   291→                  <label className=\"block text-xs text-gray-400 mb-1\">Status</label>\n   292→                  <select\n   293→                    value={newTalent.status}\n   294→                    onChange={e => setNewTalent(p => ({ ...p, status: e.target.value }))}\n   295→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   296→                  >\n   297→                    <option value=\"ready\">Ready</option>\n   298→                    <option value=\"has-contact\">Has Contact</option>\n   299→                    <option value=\"did-2025\">Did 2025</option>\n   300→                    <option value=\"need-info\">Need Info</option>\n   301→                  </select>\n   302→                </div>\n   303→                <div>\n   304→                  <label className=\"block text-xs text-gray-400 mb-1\">Affiliation</label>\n   305→                  <input\n   306→                    value={newTalent.affiliation}\n   307→                    onChange={e => setNewTalent(p => ({ ...p, affiliation: e.target.value }))}\n   308→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   309→                    placeholder=\"e.g. Stanford Alumni\"\n   310→                  />\n   311→                </div>\n   312→                <div>\n   313→                  <label className=\"block text-xs text-gray-400 mb-1\">Conference</label>\n   314→                  <input\n   315→                    value={newTalent.conference}\n   316→                    onChange={e => setNewTalent(p => ({ ...p, conference: e.target.value }))}\n   317→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   318→                    placeholder=\"e.g. ECAC, GEC, NCGA\"\n   319→                  />\n   320→                </div>\n   321→                <div className=\"col-span-2 flex items-center gap-2\">\n   322→                  <input\n   323→                    id=\"canProduce\"\n   324→                    type=\"checkbox\"\n   325→                    checked={newTalent.canProduce}\n   326→                    onChange={e => setNewTalent(p => ({ ...p, canProduce: e.target.checked }))}\n   327→                    className=\"rounded\"\n   328→                  />\n   329→                  <label htmlFor=\"canProduce\" className=\"text-sm text-gray-300\">Can also produce</label>\n   330→                </div>\n   331→                <div className=\"col-span-2\">\n   332→                  <label className=\"block text-xs text-gray-400 mb-1\">Notes</label>\n   333→                  <textarea\n   334→                    value={newTalent.notes}\n   335→                    onChange={e => setNewTalent(p => ({ ...p, notes: e.target.value }))}\n   336→                    rows={2}\n   337→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500 resize-none\"\n   338→                    placeholder=\"Any notes about this person...\"\n   339→                  />\n   340→                </div>\n   341→              </div>\n   342→              <div className=\"flex justify-end gap-3 pt-2\">\n   343→                <button type=\"button\" onClick={() => setShowAddModal(false)} className=\"px-4 py-2 text-gray-400 hover:text-white text-sm\">\n   344→                  Cancel\n   345→                </button>\n   346→                <button\n   347→                  type=\"submit\"\n   348→                  disabled={saving || !newTalent.name.trim()}\n   349→                  className=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 disabled:opacity-50 rounded-lg text-sm font-medium transition-colors\"\n   350→                >\n   351→                  {saving ? 'Saving...' : 'Add & Open Profile'}\n   352→                </button>\n   353→              </div>\n   354→            </form>\n   355→          </div>\n   356→        </div>\n   357→      )}\n   358→    </div>\n   359→  );\n   360→}\n   361→\n   362→function TalentCard({ talent }) {\n   363→  const statusBadge = getStatusColor(talent.status);\n   364→  const wm = wagMagLabel(talent.wagMag);\n   365→\n   366→  return (\n   367→    <Link\n   368→      to={`/talent/${talent.id}`}\n   369→      className=\"block bg-gray-800 hover:bg-gray-750 border border-gray-700 hover:border-gray-600 rounded-lg px-4 py-3 transition-colors group\"\n   370→    >\n   371→      <div className=\"flex items-center gap-3\">\n   372→        {/* Status + WAG/MAG badges */}\n   373→        <div className=\"flex flex-col gap-1 w-24 flex-shrink-0\">\n   374→          <span className={`inline-block px-2 py-0.5 rounded text-xs font-medium ${statusBadge}`}>\n   375→            {getStatusLabel(talent.status)}\n   376→          </span>\n   377→          {talent.wagMag && (\n   378→            <span className={`inline-block px-2 py-0.5 rounded text-xs font-medium ${wm.color}`}>\n   379→              {wm.label}\n   380→            </span>\n   381→          )}\n   382→        </div>\n   383→\n   384→        {/* Name + role */}\n   385→        <div className=\"flex-1 min-w-0\">\n   386→          <div className=\"flex items-center gap-2\">\n   387→            <span className=\"font-semibold text-white group-hover:text-blue-300 transition-colors\">\n   388→              {talent.name}\n   389→            </span>\n   390→            {talent.canProduce && (\n   391→              <span className=\"px-1.5 py-0.5 bg-teal-800 text-teal-200 text-xs rounded\">Producer</span>\n   392→            )}\n   393→          </div>\n   394→          <div className=\"text-xs text-gray-400 mt-0.5 truncate\">\n   395→            {[talent.commentaryRole, talent.affiliation, talent.conference].filter(Boolean).join(' · ')}\n   396→          </div>\n   397→        </div>\n   398→\n   399→        {/* Contact info */}\n   400→        <div className=\"flex items-center gap-3 flex-shrink-0\">\n   401→          {talent.phone && (\n   402→            <a\n   403→              href={`tel:${talent.phone}`}\n   404→              onClick={e => e.stopPropagation()}\n   405→              className=\"flex items-center gap-1 text-blue-400 hover:text-blue-300 text-sm transition-colors\"\n   406→              title={talent.phone}\n   407→            >\n   408→              <PhoneIcon className=\"w-3.5 h-3.5\" />\n   409→              <span className=\"hidden sm:inline text-xs\">{talent.phone}</span>\n   410→            </a>\n   411→          )}\n   412→          {talent.email && (\n   413→            <a\n   414→              href={`mailto:${talent.email}`}\n   415→              onClick={e => e.stopPropagation()}\n   416→              className=\"flex items-center gap-1 text-gray-400 hover:text-gray-300 text-sm transition-colors\"\n   417→              title={talent.email}\n   418→            >\n   419→              <EnvelopeIcon className=\"w-3.5 h-3.5\" />\n   420→            </a>\n   421→          )}\n   422→        </div>\n   423→\n   424→        {/* Competition count */}\n   425→        <div className=\"text-right flex-shrink-0 w-16\">\n   426→          {(talent.totalCompetitions > 0 || talent.competitionHistory?.length > 0) && (\n   427→            <div className=\"text-sm font-semibold text-white\">\n   428→              {talent.totalCompetitions || talent.competitionHistory?.length || 0}\n   429→            </div>\n   430→          )}\n   431→          <div className=\"text-xs text-gray-500\">\n   432→            {(talent.totalCompetitions || talent.competitionHistory?.length || 0) === 1 ? 'event' : 'events'}\n   433→          </div>\n   434→        </div>\n   435→      </div>\n   436→\n   437→      {/* Notes snippet */}\n   438→      {talent.notes && (\n   439→        <div className=\"mt-2 text-xs text-gray-500 truncate pl-27\">\n   440→          {talent.notes}\n   441→        </div>\n   442→      )}\n   443→    </Link>\n   444→  );\n   445→}\n   446→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"08025688-80fb-4a54-a507-d0d5405c8893","uuid":"a1a5f36f-0ebb-4f2e-b695-6ae9c6b10774","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/pages/TalentPage.jsx","content":"import { useState } from 'react';\nimport { Link, useNavigate } from 'react-router-dom';\nimport { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\nimport {\n  PlusIcon,\n  MagnifyingGlassIcon,\n  PhoneIcon,\n  EnvelopeIcon,\n  UserGroupIcon,\n  SparklesIcon,\n  XMarkIcon,\n} from '@heroicons/react/24/solid';\n\nconst STATUS_OPTIONS = [\n  { value: '', label: 'All Statuses' },\n  { value: 'ready', label: 'Ready' },\n  { value: 'has-contact', label: 'Has Contact' },\n  { value: 'did-2025', label: 'Did 2025' },\n  { value: 'need-info', label: 'Need Info' },\n];\n\nconst WAG_MAG_OPTIONS = [\n  { value: '', label: 'All' },\n  { value: 'WAG', label: 'WAG' },\n  { value: 'MAG', label: 'MAG' },\n  { value: 'Both', label: 'Both' },\n];\n\nconst ROLE_OPTIONS = [\n  { value: '', label: 'All Roles' },\n  { value: 'Play by Play / Lead', label: 'Play by Play' },\n  { value: 'Color / Analyst', label: 'Color / Analyst' },\n  { value: 'Does not matter', label: 'Flexible' },\n];\n\n/**\n * TalentPage - Global talent roster management page.\n * URL: /talent\n */\nexport default function TalentPage() {\n  const { talentList, loading, error, createTalent } = useTalentRoster();\n  const navigate = useNavigate();\n\n  const [search, setSearch] = useState('');\n  const [statusFilter, setStatusFilter] = useState('');\n  const [wagMagFilter, setWagMagFilter] = useState('');\n  const [roleFilter, setRoleFilter] = useState('');\n  const [showAddModal, setShowAddModal] = useState(false);\n  const [saving, setSaving] = useState(false);\n\n  const [newTalent, setNewTalent] = useState({\n    name: '',\n    phone: '',\n    email: '',\n    wagMag: 'Both',\n    commentaryRole: 'Does not matter',\n    canProduce: false,\n    affiliation: '',\n    conference: '',\n    status: 'has-contact',\n    notes: '',\n    otherInterests: [],\n  });\n\n  const filtered = talentList.filter((t) => {\n    if (search) {\n      const q = search.toLowerCase();\n      if (\n        !t.name?.toLowerCase().includes(q) &&\n        !t.affiliation?.toLowerCase().includes(q) &&\n        !t.conference?.toLowerCase().includes(q) &&\n        !t.notes?.toLowerCase().includes(q)\n      ) return false;\n    }\n    if (statusFilter && t.status !== statusFilter) return false;\n    if (wagMagFilter && t.wagMag !== wagMagFilter) return false;\n    if (roleFilter && t.commentaryRole !== roleFilter) return false;\n    return true;\n  });\n\n  const counts = {\n    ready: talentList.filter(t => t.status === 'ready').length,\n    hasContact: talentList.filter(t => t.status === 'has-contact').length,\n    didPrior: talentList.filter(t => t.status?.startsWith('did-')).length,\n    needInfo: talentList.filter(t => t.status === 'need-info').length,\n  };\n\n  async function handleCreate(e) {\n    e.preventDefault();\n    if (!newTalent.name.trim()) return;\n    setSaving(true);\n    try {\n      const id = await createTalent(newTalent);\n      setShowAddModal(false);\n      setNewTalent({\n        name: '', phone: '', email: '', wagMag: 'Both',\n        commentaryRole: 'Does not matter', canProduce: false,\n        affiliation: '', conference: '', status: 'has-contact', notes: '', otherInterests: [],\n      });\n      navigate(`/talent/${id}`);\n    } finally {\n      setSaving(false);\n    }\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gray-900 text-white\">\n      {/* Header */}\n      <div className=\"bg-gray-800 border-b border-gray-700 px-6 py-4\">\n        <div className=\"max-w-7xl mx-auto flex items-center justify-between\">\n          <div className=\"flex items-center gap-4\">\n            <Link to=\"/\" className=\"text-gray-400 hover:text-white text-sm transition-colors\">\n              ← Home\n            </Link>\n            <div>\n              <h1 className=\"text-xl font-bold text-white flex items-center gap-2\">\n                <UserGroupIcon className=\"w-6 h-6 text-blue-400\" />\n                Talent Roster\n              </h1>\n              <p className=\"text-gray-400 text-sm\">{talentList.length} total contacts</p>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <Link\n              to=\"/talent/discover\"\n              className=\"flex items-center gap-2 px-3 py-2 bg-purple-700 hover:bg-purple-600 rounded-lg text-sm font-medium transition-colors\"\n            >\n              <SparklesIcon className=\"w-4 h-4\" />\n              Discover Talent\n            </Link>\n            <button\n              onClick={() => setShowAddModal(true)}\n              className=\"flex items-center gap-2 px-3 py-2 bg-blue-600 hover:bg-blue-500 rounded-lg text-sm font-medium transition-colors\"\n            >\n              <PlusIcon className=\"w-4 h-4\" />\n              Add Talent\n            </button>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-6 py-6\">\n        {/* Status summary strip */}\n        <div className=\"grid grid-cols-4 gap-3 mb-6\">\n          {[\n            { label: 'Ready', count: counts.ready, color: 'border-green-600 bg-green-900/20', filter: 'ready' },\n            { label: 'Has Contact', count: counts.hasContact, color: 'border-blue-600 bg-blue-900/20', filter: 'has-contact' },\n            { label: 'Did Prior Season', count: counts.didPrior, color: 'border-amber-600 bg-amber-900/20', filter: 'did-2025' },\n            { label: 'Need Info', count: counts.needInfo, color: 'border-gray-600 bg-gray-800/50', filter: 'need-info' },\n          ].map(({ label, count, color, filter }) => (\n            <button\n              key={filter}\n              onClick={() => setStatusFilter(statusFilter === filter ? '' : filter)}\n              className={`rounded-lg border p-3 text-left transition-colors ${color} ${statusFilter === filter ? 'ring-2 ring-white/20' : 'hover:bg-opacity-30'}`}\n            >\n              <div className=\"text-2xl font-bold text-white\">{count}</div>\n              <div className=\"text-xs text-gray-300 mt-0.5\">{label}</div>\n            </button>\n          ))}\n        </div>\n\n        {/* Filter row */}\n        <div className=\"flex items-center gap-3 mb-5 flex-wrap\">\n          <div className=\"relative flex-1 min-w-48\">\n            <MagnifyingGlassIcon className=\"w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search by name, affiliation, conference...\"\n              value={search}\n              onChange={(e) => setSearch(e.target.value)}\n              className=\"w-full pl-9 pr-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500\"\n            />\n          </div>\n          <select\n            value={statusFilter}\n            onChange={(e) => setStatusFilter(e.target.value)}\n            className=\"px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n          >\n            {STATUS_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}\n          </select>\n          <select\n            value={wagMagFilter}\n            onChange={(e) => setWagMagFilter(e.target.value)}\n            className=\"px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n          >\n            {WAG_MAG_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}\n          </select>\n          <select\n            value={roleFilter}\n            onChange={(e) => setRoleFilter(e.target.value)}\n            className=\"px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n          >\n            {ROLE_OPTIONS.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}\n          </select>\n          {(search || statusFilter || wagMagFilter || roleFilter) && (\n            <button\n              onClick={() => { setSearch(''); setStatusFilter(''); setWagMagFilter(''); setRoleFilter(''); }}\n              className=\"text-gray-400 hover:text-white text-sm flex items-center gap-1\"\n            >\n              <XMarkIcon className=\"w-4 h-4\" />\n              Clear\n            </button>\n          )}\n          <span className=\"text-gray-500 text-sm ml-auto\">{filtered.length} shown</span>\n        </div>\n\n        {/* Talent list */}\n        {loading ? (\n          <div className=\"text-center py-20 text-gray-500\">Loading roster...</div>\n        ) : error ? (\n          <div className=\"text-center py-20 text-red-400\">{error}</div>\n        ) : filtered.length === 0 ? (\n          <div className=\"text-center py-20 text-gray-500\">\n            {talentList.length === 0 ? 'No talent in roster yet. Add someone to get started.' : 'No results match your filters.'}\n          </div>\n        ) : (\n          <div className=\"space-y-2\">\n            {filtered.map((talent) => (\n              <TalentCard key={talent.id} talent={talent} />\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Add Talent Modal */}\n      {showAddModal && (\n        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 w-full max-w-lg\">\n            <div className=\"flex items-center justify-between px-5 py-4 border-b border-gray-700\">\n              <h2 className=\"text-lg font-semibold text-white\">Add Talent</h2>\n              <button onClick={() => setShowAddModal(false)} className=\"text-gray-400 hover:text-white\">\n                <XMarkIcon className=\"w-5 h-5\" />\n              </button>\n            </div>\n            <form onSubmit={handleCreate} className=\"p-5 space-y-4\">\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div className=\"col-span-2\">\n                  <label className=\"block text-xs text-gray-400 mb-1\">Name *</label>\n                  <input\n                    required\n                    value={newTalent.name}\n                    onChange={e => setNewTalent(p => ({ ...p, name: e.target.value }))}\n                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n                    placeholder=\"Full name\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs text-gray-400 mb-1\">Phone</label>\n                  <input\n                    value={newTalent.phone}\n                    onChange={e => setNewTalent(p => ({ ...p, phone: e.target.value }))}\n                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n                    placeholder=\"(555) 123-4567\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs text-gray-400 mb-1\">Email</label>\n                  <input\n                    type=\"email\"\n                    value={newTalent.email}\n                    onChange={e => setNewTalent(p => ({ ...p, email: e.target.value }))}\n                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n                    placeholder=\"email@example.com\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs text-gray-400 mb-1\">WAG / MAG</label>\n                  <select\n                    value={newTalent.wagMag}\n                    onChange={e => setNewTalent(p => ({ ...p, wagMag: e.target.value }))}\n                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n                  >\n                    <option value=\"WAG\">WAG</option>\n                    <option value=\"MAG\">MAG</option>\n                    <option value=\"Both\">Both</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-xs text-gray-400 mb-1\">Role</label>\n                  <select\n                    value={newTalent.commentaryRole}\n                    onChange={e => setNewTalent(p => ({ ...p, commentaryRole: e.target.value }))}\n                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n                  >\n                    <option value=\"Play by Play / Lead\">Play by Play / Lead</option>\n                    <option value=\"Color / Analyst\">Color / Analyst</option>\n                    <option value=\"Does not matter\">Does not matter</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-xs text-gray-400 mb-1\">Status</label>\n                  <select\n                    value={newTalent.status}\n                    onChange={e => setNewTalent(p => ({ ...p, status: e.target.value }))}\n                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n                  >\n                    <option value=\"ready\">Ready</option>\n                    <option value=\"has-contact\">Has Contact</option>\n                    <option value=\"did-2025\">Did 2025</option>\n                    <option value=\"need-info\">Need Info</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-xs text-gray-400 mb-1\">Affiliation</label>\n                  <input\n                    value={newTalent.affiliation}\n                    onChange={e => setNewTalent(p => ({ ...p, affiliation: e.target.value }))}\n                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n                    placeholder=\"e.g. Stanford Alumni\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs text-gray-400 mb-1\">Conference</label>\n                  <input\n                    value={newTalent.conference}\n                    onChange={e => setNewTalent(p => ({ ...p, conference: e.target.value }))}\n                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n                    placeholder=\"e.g. ECAC, GEC, NCGA\"\n                  />\n                </div>\n                <div className=\"col-span-2 flex items-center gap-2\">\n                  <input\n                    id=\"canProduce\"\n                    type=\"checkbox\"\n                    checked={newTalent.canProduce}\n                    onChange={e => setNewTalent(p => ({ ...p, canProduce: e.target.checked }))}\n                    className=\"rounded\"\n                  />\n                  <label htmlFor=\"canProduce\" className=\"text-sm text-gray-300\">Can also produce</label>\n                </div>\n                <div className=\"col-span-2\">\n                  <label className=\"block text-xs text-gray-400 mb-1\">Notes</label>\n                  <textarea\n                    value={newTalent.notes}\n                    onChange={e => setNewTalent(p => ({ ...p, notes: e.target.value }))}\n                    rows={2}\n                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500 resize-none\"\n                    placeholder=\"Any notes about this person...\"\n                  />\n                </div>\n              </div>\n              <div className=\"flex justify-end gap-3 pt-2\">\n                <button type=\"button\" onClick={() => setShowAddModal(false)} className=\"px-4 py-2 text-gray-400 hover:text-white text-sm\">\n                  Cancel\n                </button>\n                <button\n                  type=\"submit\"\n                  disabled={saving || !newTalent.name.trim()}\n                  className=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 disabled:opacity-50 rounded-lg text-sm font-medium transition-colors\"\n                >\n                  {saving ? 'Saving...' : 'Add & Open Profile'}\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction TalentCard({ talent }) {\n  const statusBadge = getStatusColor(talent.status);\n  const wm = wagMagLabel(talent.wagMag);\n\n  return (\n    <Link\n      to={`/talent/${talent.id}`}\n      className=\"block bg-gray-800 hover:bg-gray-750 border border-gray-700 hover:border-gray-600 rounded-lg px-4 py-3 transition-colors group\"\n    >\n      <div className=\"flex items-center gap-3\">\n        {/* Status + WAG/MAG badges */}\n        <div className=\"flex flex-col gap-1 w-24 flex-shrink-0\">\n          <span className={`inline-block px-2 py-0.5 rounded text-xs font-medium ${statusBadge}`}>\n            {getStatusLabel(talent.status)}\n          </span>\n          {talent.wagMag && (\n            <span className={`inline-block px-2 py-0.5 rounded text-xs font-medium ${wm.color}`}>\n              {wm.label}\n            </span>\n          )}\n        </div>\n\n        {/* Name + role */}\n        <div className=\"flex-1 min-w-0\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"font-semibold text-white group-hover:text-blue-300 transition-colors\">\n              {talent.name}\n            </span>\n            {talent.canProduce && (\n              <span className=\"px-1.5 py-0.5 bg-teal-800 text-teal-200 text-xs rounded\">Producer</span>\n            )}\n          </div>\n          <div className=\"text-xs text-gray-400 mt-0.5 truncate\">\n            {[talent.commentaryRole, talent.affiliation, talent.conference].filter(Boolean).join(' · ')}\n          </div>\n        </div>\n\n        {/* Contact info */}\n        <div className=\"flex items-center gap-3 flex-shrink-0\">\n          {talent.phone && (\n            <a\n              href={`tel:${talent.phone}`}\n              onClick={e => e.stopPropagation()}\n              className=\"flex items-center gap-1 text-blue-400 hover:text-blue-300 text-sm transition-colors\"\n              title={talent.phone}\n            >\n              <PhoneIcon className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline text-xs\">{talent.phone}</span>\n            </a>\n          )}\n          {talent.email && (\n            <a\n              href={`mailto:${talent.email}`}\n              onClick={e => e.stopPropagation()}\n              className=\"flex items-center gap-1 text-gray-400 hover:text-gray-300 text-sm transition-colors\"\n              title={talent.email}\n            >\n              <EnvelopeIcon className=\"w-3.5 h-3.5\" />\n            </a>\n          )}\n        </div>\n\n        {/* Competition count */}\n        <div className=\"text-right flex-shrink-0 w-16\">\n          {(talent.totalCompetitions > 0 || talent.competitionHistory?.length > 0) && (\n            <div className=\"text-sm font-semibold text-white\">\n              {talent.totalCompetitions || talent.competitionHistory?.length || 0}\n            </div>\n          )}\n          <div className=\"text-xs text-gray-500\">\n            {(talent.totalCompetitions || talent.competitionHistory?.length || 0) === 1 ? 'event' : 'events'}\n          </div>\n        </div>\n      </div>\n\n      {/* Notes snippet */}\n      {talent.notes && (\n        <div className=\"mt-2 text-xs text-gray-500 truncate pl-27\">\n          {talent.notes}\n        </div>\n      )}\n    </Link>\n  );\n}\n","numLines":446,"startLine":1,"totalLines":446}}}
