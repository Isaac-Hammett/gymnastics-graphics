ssName=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   272→                  >\n   273→                    <option value=\"WAG\">WAG</option>\n   274→                    <option value=\"MAG\">MAG</option>\n   275→                    <option value=\"Both\">Both</option>\n   276→                  </select>\n   277→                </div>\n   278→                <div>\n   279→                  <label className=\"block text-xs text-gray-400 mb-1\">Role</label>\n   280→                  <select\n   281→                    value={newTalent.commentaryRole}\n   282→                    onChange={e => setNewTalent(p => ({ ...p, commentaryRole: e.target.value }))}\n   283→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   284→                  >\n   285→                    <option value=\"Play by Play / Lead\">Play by Play / Lead</option>\n   286→                    <option value=\"Color / Analyst\">Color / Analyst</option>\n   287→                    <option value=\"Does not matter\">Does not matter</option>\n   288→                  </select>\n   289→                </div>\n   290→                <div>\n   291→                  <label className=\"block text-xs text-gray-400 mb-1\">Status</label>\n   292→                  <select\n   293→                    value={newTalent.status}\n   294→                    onChange={e => setNewTalent(p => ({ ...p, status: e.target.value }))}\n   295→                    className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500\"\n   296→                  >\n   297→                    <option value=\"ready\">Ready</option>\n   298→                    <option value=\"has-contact\">Has Contact</option>\n   299→                    <option value=\"did-2025\">Did 2025</option>\n   3