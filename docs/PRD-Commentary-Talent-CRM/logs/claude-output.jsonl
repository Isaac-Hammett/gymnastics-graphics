{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012W74WFTsMEPmZHSxzHDZNU","type":"tool_result","content":"     1→import { useState, useEffect } from 'react';\n     2→import { useParams } from 'react-router-dom';\n     3→import { db, ref, get, push } from '../lib/firebase';\n     4→import { CheckCircleIcon, CalendarIcon } from '@heroicons/react/24/solid';\n     5→\n     6→/**\n     7→ * SurveyPage - Public annual talent survey page.\n     8→ * URL: /survey/:year (no auth required)\n     9→ *\n    10→ * Collects: WAG/MAG, competition availability, tech setup, role preference, Discord status.\n    11→ * Writes to surveyResponses/{year}/{pushKey} in Firebase (NOT directly to talentRoster).\n    12→ */\n    13→export default function SurveyPage() {\n    14→  const { year } = useParams();\n    15→  const [loading, setLoading] = useState(true);\n    16→  const [upcomingCompetitions, setUpcomingCompetitions] = useState([]);\n    17→  const [submitting, setSubmitting] = useState(false);\n    18→  const [submitted, setSubmitted] = useState(false);\n    19→\n    20→  // Form state\n    21→  const [formData, setFormData] = useState({\n    22→    name: '',\n    23→    email: '',\n    24→    wagMag: '',\n    25→    surveyAvailability: {},\n    26→    internetUploadMbps: '',\n    27→    internetDownloadMbps: '',\n    28→    micType: '',\n    29→    hasHeadphones: false,\n    30→    discordUsername: '',\n    31→    commentaryRole: '',\n    32→  });\n    33→\n    34→  useEffect(() => {\n    35→    loadUpcomingCompetitions();\n    36→  }, []);\n    37→\n    38→  async function loadUpcomingCompetitions() {\n    39→    try {\n    40→      setLoading(true);\n    41→      const compsSnapshot = await get(ref(db, 'competitions'));\n    42→      if (!compsSnapshot.exists()) {\n    43→        setLoading(false);\n    44→        return;\n    45→      }\n    46→\n    47→      const allComps = compsSnapshot.val();\n    48→      const now = new Date();\n    49→      const upcoming = Object.entries(allComps)\n    50→        .filter(([_, comp]) => {\n    51→          const meetDate = comp.config?.meetDate ? new Date(comp.config.meetDate) : null;\n    52→          return meetDate && meetDate > now;\n    53→        })\n    54→        .map(([compId, comp]) => ({\n    55→          compId,\n    56→          eventName: comp.config?.eventName || 'Unnamed Event',\n    57→          meetDate: comp.config?.meetDate || '',\n    58→          venue: comp.config?.venue || '',\n    59→        }))\n    60→        .sort((a, b) => new Date(a.meetDate) - new Date(b.meetDate));\n    61→\n    62→      setUpcomingCompetitions(upcoming);\n    63→      setLoading(false);\n    64→    } catch (err) {\n    65→      console.error('Error loading competitions:', err);\n    66→      setLoading(false);\n    67→    }\n    68→  }\n    69→\n    70→  function handleInputChange(field, value) {\n    71→    setFormData(prev => ({ ...prev, [field]: value }));\n    72→  }\n    73→\n    74→  function toggleCompetition(compId) {\n    75→    setFormData(prev => ({\n    76→      ...prev,\n    77→      surveyAvailability: {\n    78→        ...prev.surveyAvailability,\n    79→        [compId]: !prev.surveyAvailability[compId],\n    80→      },\n    81→    }));\n    82→  }\n    83→\n    84→  async function handleSubmit(e) {\n    85→    e.preventDefault();\n    86→\n    87→    // Basic validation\n    88→    if (!formData.name || !formData.email || !formData.wagMag || !formData.commentaryRole) {\n    89→      alert('Please fill in all required fields (name, email, WAG/MAG, role preference).');\n    90→      return;\n    91→    }\n    92→\n    93→    setSubmitting(true);\n    94→    try {\n    95→      // Write to surveyResponses/{year}/{pushKey}\n    96→      const surveyData = {\n    97→        name: formData.name,\n    98→        email: formData.email,\n    99→        wagMag: formData.wagMag,\n   100→        surveyAvailability: formData.surveyAvailability,\n   101→        internetUploadMbps: parseFloat(formData.internetUploadMbps) || 0,\n   102→        internetDownloadMbps: parseFloat(formData.internetDownloadMbps) || 0,\n   103→        micType: formData.micType,\n   104→        hasHeadphones: formData.hasHeadphones,\n   105→        discordUsername: formData.discordUsername,\n   106→        commentaryRole: formData.commentaryRole,\n   107→        submittedAt: new Date().toISOString(),\n   108→        surveyYear: parseInt(year, 10),\n   109→      };\n   110→\n   111→      await push(ref(db, `surveyResponses/${year}`), surveyData);\n   112→      setSubmitted(true);\n   113→    } catch (err) {\n   114→      alert(`Error submitting survey: ${err.message}`);\n   115→    } finally {\n   116→      setSubmitting(false);\n   117→    }\n   118→  }\n   119→\n   120→  if (loading) {\n   121→    return (\n   122→      <div className=\"min-h-screen bg-gray-900 text-white flex items-center justify-center\">\n   123→        <div className=\"text-gray-400\">Loading survey...</div>\n   124→      </div>\n   125→    );\n   126→  }\n   127→\n   128→  if (submitted) {\n   129→    return (\n   130→      <div className=\"min-h-screen bg-gray-900 text-white flex items-center justify-center px-4\">\n   131→        <div className=\"max-w-md w-full bg-gray-800 border border-gray-700 rounded-xl p-6 text-center\">\n   132→          <CheckCircleIcon className=\"w-16 h-16 text-green-500 mx-auto mb-4\" />\n   133→          <h1 className=\"text-xl font-bold text-white mb-2\">Thank You!</h1>\n   134→          <p className=\"text-gray-400\">\n   135→            Your survey response has been submitted. We'll be in touch!\n   136→          </p>\n   137→        </div>\n   138→      </div>\n   139→    );\n   140→  }\n   141→\n   142→  return (\n   143→    <div className=\"min-h-screen bg-gray-900 text-white px-4 py-8\">\n   144→      <div className=\"max-w-3xl mx-auto\">\n   145→        <div className=\"bg-gray-800 border border-gray-700 rounded-xl p-6 md:p-8\">\n   146→          <