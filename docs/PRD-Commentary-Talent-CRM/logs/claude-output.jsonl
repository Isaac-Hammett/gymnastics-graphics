le || <span className=\"text-gray-500 italic\">Not set</span>}</span>\n   216→              </Field>\n   217→            </div>\n   218→          </div>\n   219→\n   220→          {/* Commentary details */}\n   221→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n   222→            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Commentary Profile</h2>\n   223→            <div className=\"grid grid-cols-2 gap-4\">\n   224→              <div>\n   225→                <label className=\"block text-xs text-gray-500 mb-1\">WAG / MAG</label>\n   226→                {editing ? (\n   227→                  <select\n   228→                    value={form.wagMag || ''}\n   229→                    onChange={e => setForm(p => ({ ...p, wagMag: e.target.value }))}\n   230→                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   231→                  >\n   232→                    <option value=\"WAG\">WAG</option>\n   233→                    <option value=\"MAG\">MAG</option>\n   234→                    <option value=\"Both\">Both</option>\n   235→                  </select>\n   236→                ) : (\n   237→                  <span className={`inline-block px-2 py-0.5 rounded text-xs font-medium ${wm.color}`}>{wm.label}</span>\n   238→                )}\n   239→              </div>\n   240→              <div>\n   241→                <label className=\"block text-xs text-gray-500 mb-1\">Commentary Role</label>\n   242→                {editing ? (\n   243→                  <select\n   244→                    value={form.commentaryRole || ''}\n   245→                    onChange={e => setForm(p => ({ ...p, commentaryRole: e.target.value }))}\n   246→                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   247→                  >\n   248→                    <option value=\"Play by Play / Lead\">Play by Play / Lead</option>\n   249→                    <option value=\"Color / Analyst\">Color / Analyst</option>\n   250→                    <option value=\"Does not matter\">Does not matter</option>\n   251→                  </select>\n   252→                ) : (\n   253→                  <span className=\"text-sm text-white\">{talent.commentaryRole || '—'}</span>\n   254→                )}\n   255→              </div>\n   256→              <div>\n   257→                <label className=\"block text-xs text-gray-500 mb-1\">Status</label>\n   258→                {editing ? (\n   259→                  <select\n   260→                    value={form.status || ''}\n   261→                    onChange={e => setForm(p => ({ ...p, status: e.target.value }))}\n   262→                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   263→                  >\n   264→                    <option value=\"ready\">Ready</option>\n   265→                    <option value=\"has-contact\">Has Contact</option>\n   266→                    <option value=\"did-2025\">Did 2025</option>\n   267→                    <option value=\"need-info\">Need Info</option>\n   268→                  </select>\n   269→                ) : (\n   270→                  <span className={`inline-block px-2 py-0.5 rounded text-xs font-medium ${getStatusColor(talent.status)}`}>\n   271→                    {getStatusLabel(talent.status)}\n   272→                  </span>\n   273→                )}\n   274→              </div>\n   275→              <div>\n   276→                <label className=\"block text-xs text-gray-500 mb-1\">Affiliation</label>\n   277→                {editing ? (\n   278→                  <input\n   279→                    value={form.affiliation || ''}\n   280→                    onChange={e => setForm(p => ({ ...p, affiliation: e.target.value }))}\n   281→                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   282→                    placeholder=\"e.g. Stanford Alumni\"\n   283→                  />\n   284→                ) : <span className=\"text-sm text-white\">{talent.affiliation || '—'}</span>}\n   285→              </div>\n   286→              <div>\n   287→                <label className=\"block text-xs text-gray-500 mb-1\">Conference</label>\n   288→                {editing ? (\n   289→                  <input\n   290→                    value={form.conference || ''}\n   291→                    onChange={e => setForm(p => ({ ...p, conference: e.target.value }))}\n   292→                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   293→                    placeholder=\"e.g. ECAC, GEC\"\n   294→                  />\n   295→                ) : <span className=\"text-sm text-white\">{talent.conference || '—'}</span>}\n   296→              </div>\n   297→              <div className=\"flex items-center gap-2\">\n   298→                {editing ? (\n   299→                  <>\n   300→                    <input\n   301→                      id=\"editCanProduce\"\n   302→                      type=\"checkbox\"\n   303→                      checked={form.canProduce || false}\n   304→                      onChange={e => setForm(p => ({ ...p, canProduce: e.target.checked }))}\n   305→                      className=\"rounded\"\n   306→                    />\n   307→                    <label htmlFor=\"editCanProduce\" className=\"text-sm text-gray-300\">Can produce</label>\n   308→                  </>\n   309→                ) : (\n   310→                  <span className=\"text-sm text-white\">{talent.canProduce ? '✓ Can produce' : '—'}</span>\n   311→                )}\n   312→              </div>\n   313→            </div>\n   314→\n   315→            {/* Other Interests */}\n   316→            <div className=\"mt-4\">\n   317→              <label className=\"block text-xs text-gray-500 mb-2\">Other Interests</label>\n   318→              {editing ? (\n   319→                <div className=\"flex flex-wrap gap-2\">\n   320→                  {OTHER_INTERESTS.map(interest => (\n   321→                    <button\n   322→                      key={interest}\n   323→                      type=\"button\"\n   324→                      onClick={() => toggleInterest(interest)}\n   325→                      className={`px-2 py-1 rounded text-xs transition-colors ${\n   326→                        (form.otherInterests || []).includes(interest)\n   327→                          ? 'bg-blue-600 text-white'\n   328→                          : 'bg-gray-700 text-gray-300 hover:bg-gray-600'\n   329→                      }`}\n   330→                    >\n   331→                      {interest.split(' (')[0]}\n   332→                    </button>\n   333→                  ))}\n   334→                </div>\n   335→              ) : (\n   336→                <div className=\"flex flex-wrap gap-2\">\n   337→                  {(talent.otherInterests || []).length === 0\n   338→                    ? <span className=\"text-sm text-gray-500 italic\">None listed</span>\n   339→                    : (talent.otherInterests || []).map(i => (\n   340→                      <span key={i} className=\"px-2 py-0.5 bg-gray-700 text-gray-300 text-xs rounded\">\n   341→                        {i.split(' (')[0]}\n   342→                      </span>\n   343→                    ))}\n   344→                </div>\n   345→              )}\n   346→            </div>\n   347→          </div>\n   348→\n   349→          {/* Tech onboarding */}\n   350→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n   351→            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Tech & Onboarding</h2>\n   352→            <div className=\"grid grid-cols-3 gap-4\">\n   353→              <div>\n   354→                <label className=\"block text-xs text-gray-500 mb-1\">2026 Survey</label>\n   355→                {editing ? (\n   356→                  <input\n   357→                    type=\"checkbox\"\n   358→                    checked={form.surveyCompleted || false}\n   359→                    onChange={e => setForm(p => ({ ...p, surveyCompleted: e.target.checked }))}\n   360→                  />\n   361→                ) : (\n   362→                  <span className={`text-sm font-medium ${talent.surveyCompleted ? 'text-green-400' : 'text-gray-500'}`}>\n   363→                    {talent.surveyCompleted ? '✓ Completed' : 'Not completed'}\n   364→                  </span>\n   365→                )}\n   366→              </div>\n   367→              <div>\n   368→                <label className=\"block text-xs text-gray-500 mb-1\">Text Sent</label>\n   369→                {editing ? (\n   370→                  <input\n   371→                    type=\"checkbox\"\n   372→                    checked={form.textSent || false}\n   373→                    onChange={e => setForm(p => ({ ...p, textSent: e.target.checked }))}\n   374→                  />\n   375→                ) : (\n   376→                  <span className={`text-sm font-medium ${talent.textSent ? 'text-green-400' : 'text-gray-500'}`}>\n   377→                    {talent.textSent ? '✓ Sent' : 'Not sent'}\n   378→                  </span>\n   379→                )}\n   380→              </div>\n   381→              <div>\n   382→                <label className=\"block text-xs text-gray-500 mb-1\">Discord Added</label>\n   383→                {editing ? (\n   384→                  <input\n   385→                    type=\"checkbox\"\n   386→                    checked={form.discordAdded || false}\n   387→                    onChange={e => setForm(p => ({ ...p, discordAdded: e.target.checked }))}\n   388→                  />\n   389→                ) : (\n   390→                  <span className={`text-sm font-medium ${talent.discordAdded ? 'text-green-400' : 'text-gray-500'}`}>\n   391→                    {talent.discordAdded ? '✓ Added' : 'Not added'}\n   392→                  </span>\n   393→                )}\n   394→              </div>\n   395→              <div>\n   396→                <label className=\"block text-xs text-gray-500 mb-1\">Headphones</label>\n   397→                <span className=\"text-sm text-white\">{talent.hasHeadphones ? 'Yes' : '—'}</span>\n   398→              </div>\n   399→              <div>\n   400→                <label className=\"block text-xs text-gray-500 mb-1\">Upload / Download</label>\n   401→                <span className=\"text-sm text-white\">\n   402→                  {talent.internetUploadMbps ? `${talent.internetUploadMbps} / ${talent.internetDownloadMbps || '?'} Mbps` : '—'}\n   403→                </span>\n   404→              </div>\n   405→            </div>\n   406→          </div>\n   407→\n   408→          {/* Social links */}\n   409→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n   410→            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Social / Discovery</h2>\n   411→            <div className=\"grid grid-cols-2 gap-4\">\n   412→              <Field label=\"LinkedIn\" editing={editing} value={form?.linkedInUrl || ''} onChange={v => setForm(p => ({ ...p, linkedInUrl: v }))} inputType=\"url\">\n   413→                {talent.linkedInUrl\n   414→                  ? <a href={talent.linkedInUrl} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-blue-400 hover:text-blue-300 text-sm truncate\">{talent.linkedInUrl}</a>\n   415→                  : <span className=\"text-gray-500 italic text-sm\">Not found</span>}\n   416→              </Field>\n   417→              <Field label=\"Instagram\" editing={editing} value={form?.instagramUrl || ''} onChange={v => setForm(p => ({ ...p, instagramUrl: v }))} inputType=\"url\">\n   418→                {talent.instagramUrl\n   419→                  ? <a href={talent.instagramUrl} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-blue-400 hover:text-blue-300 text-sm truncate\">{talent.instagramUrl}</a>\n   420→                  : <span className=\"text-gray-500 italic text-sm\">Not found</span>}\n   421→              </Field>\n   422→              <div className=\"col-span-2\">\n   423→                <label className=\"block text-xs text-gray-500 mb-1\">Discovered From</label>\n   424→                <span className=\"text-sm text-gray-400\">{talent.discoveredFrom || 'manual'}</span>\n   425→              </div>\n   426→            </div>\n   427→          </div>\n   428→        </div>\n   429→\n   430→        {/* Right: History + Notes */}\n   431→        <div className=\"space-y-5\">\n   432→          {/* Competition history */}\n   433→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n   434→            <div className=\"flex items-center gap-2 mb-4\">\n   435→              <TrophyIcon className=\"w-4 h-4 text-yellow-400\" />\n   436→              <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide\">\n   437→                History\n   438→              </h2>\n   439→              <span className=\"ml-auto text-xs text-gray-500\">{talent.totalCompetitions || history.length} events</span>\n   440→            </div>\n   441→            {history.length === 0 ? (\n   442→              <p className=\"text-xs text-gray-500 italic\">No competitions recorded yet.</p>\n   443→            ) : (\n   444→              <div className=\"space-y-2 max-h-64 overflow-y-auto\">\n   445→                {[...history].reverse().map((h, i) => (\n   446→                  <div key={i} className=\"text-xs border-b border-gray-700 pb-2 last:border-0\">\n   447→                    <div className=\"text-white font-medium\">{h.eventName || h.compId}</div>\n   448→                    <div className=\"text-gray-400\">{h.date} · {h.role}</div>\n   449→                  </div>\n   450→                ))}\n   451→              </div>\n   452→            )}\n   453→          </div>\n   454→\n   455→          {/* Notes */}\n   456→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n   457→            <div className=\"flex items-center gap-2 mb-3\">\n   458→              <ChatBubbleLeftRightIcon className=\"w-4 h-4 text-blue-400\" />\n   459→              <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide\">Notes</h2>\n   460→            </div>\n   461→            {editing ? (\n   462→              <textarea\n   463→                value={form.notes || ''}\n   464→                onChange={e => setForm(p => ({ ...p, notes: e.target.value }))}\n   465→                rows={6}\n   466→                className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500 resize-none\"\n   467→                placeholder=\"Notes about this person...\"\n   468→              />\n   469→            ) : (\n   470→              <>\n   471→                {talent.notes ? (\n   472→                  <pre className=\"text-xs text-gray-300 whitespace-pre-wrap font-sans max-h-48 overflow-y-auto mb-3\">\n   473→                    {talent.notes}\n   474→                  </pre>\n   475→                ) : (\n   476→                  <p className=\"text-xs text-gray-500 italic mb-3\">No notes yet.</p>\n   477→                )}\n   478→                <form onSubmit={handleAddNote} className=\"flex gap-2\">\n   479→                  <input\n   480→                    value={noteText}\n   481→                    onChange={e => setNoteText(e.target.value)}\n   482→                    placeholder=\"Add a note...\"\n   483→                    className=\"flex-1 px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   484→                  />\n   485→                  <button\n   486→                    type=\"submit\"\n   487→                    disabled={savingNote || !noteText.trim()}\n   488→                    className=\"px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded text-sm disabled:opacity-50 transition-colors\"\n   489→                  >\n   490→                    Add\n   491→                  </button>\n   492→                </form>\n   493→                <p className=\"text-xs text-gray-600 mt-1.5\">Notes are timestamped automatically.</p>\n   494→              </>\n   495→            )}\n   496→          </div>\n   497→        </div>\n   498→      </div>\n   499→\n   500→      {/* Delete confirmation */}\n   501→      {confirmDelete && (\n   502→        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n   503→          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-6 max-w-sm w-full\">\n   504→            <h3 className=\"text-lg font-semibold text-white mb-2\">Remove {talent.name}?</h3>\n   505→            <p className=\"text-gray-400 text-sm mb-5\">This will permanently delete their profile and all associated data.</p>\n   506→            <div className=\"flex justify-end gap-3\">\n   507→              <button onClick={() => setConfirmDelete(false)} className=\"px-4 py-2 text-gray-400 hover:text-white text-sm\">\n   508→                Cancel\n   509→              </button>\n   510→              <button\n   511→                onClick={handleDelete}\n   512→                className=\"px-4 py-2 bg-red-600 hover:bg-red-500 rounded-lg text-sm font-medium transition-colors\"\n   513→              >\n   514→                Remove\n   515→              </button>\n   516→            </div>\n   517→          </div>\n   518→        </div>\n   519→      )}\n   520→    </div>\n   521→  );\n   522→}\n   523→\n   524→function Field({ label, editing, value, onChange, children, inputType = 'text' }) {\n   525→  return (\n   526→    <div>\n   527→      <label className=\"block text-xs text-gray-500 mb-1\">{label}</label>\n   528→      {editing ? (\n   529→        <input\n   530→          type={inputType}\n   531→          value={value}\n   532→          onChange={e => onChange(e.target.value)}\n   533→          className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n   534→        />\n   535→      ) : (\n   536→        <div className=\"text-sm\">{children}</div>\n   537→      )}\n   538→    </div>\n   539→  );\n   540→}\n   541→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"da7453cc-0afa-437c-9224-6f7a011f8142","uuid":"bd14c59f-d929-4cee-947f-41ab1598362f","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/pages/TalentProfilePage.jsx","content":"import { useState, useEffect } from 'react';\nimport { Link, useParams, useNavigate } from 'react-router-dom';\nimport { useTalentRoster, getStatusLabel, getStatusColor, wagMagLabel } from '../hooks/useTalentRoster';\nimport {\n  PhoneIcon,\n  EnvelopeIcon,\n  PencilIcon,\n  CheckIcon,\n  XMarkIcon,\n  TrashIcon,\n  TrophyIcon,\n  ChatBubbleLeftRightIcon,\n} from '@heroicons/react/24/solid';\nimport toast from 'react-hot-toast';\n\nconst OTHER_INTERESTS = [\n  'Commentator',\n  'Producer',\n  'Meet Monitor',\n  'Streaming / Production',\n  'Social Media',\n  'Creative (Broadcast Graphics, Web Design, Social Graphics, etc)',\n];\n\n/**\n * TalentProfilePage - Full profile for a single talent person.\n * URL: /talent/:talentId\n */\nexport default function TalentProfilePage() {\n  const { talentId } = useParams();\n  const navigate = useNavigate();\n  const { talents, loading, updateTalent, deleteTalent } = useTalentRoster();\n\n  const [editing, setEditing] = useState(false);\n  const [saving, setSaving] = useState(false);\n  const [form, setForm] = useState(null);\n  const [confirmDelete, setConfirmDelete] = useState(false);\n  const [noteText, setNoteText] = useState('');\n  const [savingNote, setSavingNote] = useState(false);\n\n  const talent = talents[talentId];\n\n  useEffect(() => {\n    if (talent && !form) {\n      setForm({ ...talent });\n    }\n  }, [talent]);\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-gray-900 flex items-center justify-center\">\n        <div className=\"text-gray-400\">Loading...</div>\n      </div>\n    );\n  }\n\n  if (!talent) {\n    return (\n      <div className=\"min-h-screen bg-gray-900 flex items-center justify-center\">\n        <div className=\"text-center\">\n          <p className=\"text-gray-400 mb-4\">Talent not found.</p>\n          <Link to=\"/talent\" className=\"text-blue-400 hover:text-blue-300\">← Back to roster</Link>\n        </div>\n      </div>\n    );\n  }\n\n  async function handleSave() {\n    setSaving(true);\n    try {\n      await updateTalent(talentId, form);\n      setEditing(false);\n      toast.success('Profile saved');\n    } catch (e) {\n      toast.error('Save failed');\n    } finally {\n      setSaving(false);\n    }\n  }\n\n  function handleCancel() {\n    setForm({ ...talent });\n    setEditing(false);\n  }\n\n  async function handleDelete() {\n    await deleteTalent(talentId);\n    navigate('/talent');\n    toast.success('Talent removed');\n  }\n\n  async function handleAddNote(e) {\n    e.preventDefault();\n    if (!noteText.trim()) return;\n    setSavingNote(true);\n    const existing = talent.notes || '';\n    const timestamp = new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });\n    const updated = existing\n      ? `${existing}\\n\\n[${timestamp}] ${noteText.trim()}`\n      : `[${timestamp}] ${noteText.trim()}`;\n    try {\n      await updateTalent(talentId, { notes: updated });\n      setNoteText('');\n      toast.success('Note added');\n    } catch (e) {\n      toast.error('Failed to add note');\n    } finally {\n      setSavingNote(false);\n    }\n  }\n\n  function toggleInterest(interest) {\n    const current = form.otherInterests || [];\n    const updated = current.includes(interest)\n      ? current.filter(i => i !== interest)\n      : [...current, interest];\n    setForm(p => ({ ...p, otherInterests: updated }));\n  }\n\n  const wm = wagMagLabel(talent.wagMag);\n  const history = talent.competitionHistory || [];\n\n  return (\n    <div className=\"min-h-screen bg-gray-900 text-white\">\n      {/* Header */}\n      <div className=\"bg-gray-800 border-b border-gray-700 px-6 py-4\">\n        <div className=\"max-w-5xl mx-auto flex items-center justify-between\">\n          <div className=\"flex items-center gap-4\">\n            <Link to=\"/talent\" className=\"text-gray-400 hover:text-white text-sm transition-colors\">\n              ← Talent Roster\n            </Link>\n            <div className=\"flex items-center gap-3\">\n              <h1 className=\"text-xl font-bold text-white\">{talent.name}</h1>\n              <span className={`px-2 py-0.5 rounded text-xs font-medium ${getStatusColor(talent.status)}`}>\n                {getStatusLabel(talent.status)}\n              </span>\n              {talent.wagMag && (\n                <span className={`px-2 py-0.5 rounded text-xs font-medium ${wm.color}`}>\n                  {wm.label}\n                </span>\n              )}\n              {talent.canProduce && (\n                <span className=\"px-2 py-0.5 bg-teal-800 text-teal-200 text-xs rounded\">Producer</span>\n              )}\n            </div>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            {editing ? (\n              <>\n                <button\n                  onClick={handleCancel}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 text-gray-400 hover:text-white text-sm transition-colors\"\n                >\n                  <XMarkIcon className=\"w-4 h-4\" />\n                  Cancel\n                </button>\n                <button\n                  onClick={handleSave}\n                  disabled={saving}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded-lg text-sm font-medium transition-colors disabled:opacity-50\"\n                >\n                  <CheckIcon className=\"w-4 h-4\" />\n                  {saving ? 'Saving...' : 'Save'}\n                </button>\n              </>\n            ) : (\n              <>\n                <button\n                  onClick={() => setEditing(true)}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 bg-gray-700 hover:bg-gray-600 rounded-lg text-sm transition-colors\"\n                >\n                  <PencilIcon className=\"w-4 h-4\" />\n                  Edit\n                </button>\n                <button\n                  onClick={() => setConfirmDelete(true)}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 text-red-400 hover:text-red-300 text-sm transition-colors\"\n                >\n                  <TrashIcon className=\"w-4 h-4\" />\n                </button>\n              </>\n            )}\n          </div>\n        </div>\n      </div>\n\n      <div className=\"max-w-5xl mx-auto px-6 py-6 grid grid-cols-3 gap-6\">\n        {/* Left: Profile fields */}\n        <div className=\"col-span-2 space-y-5\">\n\n          {/* Contact info */}\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Contact</h2>\n            <div className=\"grid grid-cols-2 gap-4\">\n              <Field label=\"Name\" editing={editing} value={form?.name || ''} onChange={v => setForm(p => ({ ...p, name: v }))}>\n                <a href={`tel:${talent.name}`} className=\"font-semibold text-white\">{talent.name}</a>\n              </Field>\n              <Field label=\"Phone\" editing={editing} value={form?.phone || ''} onChange={v => setForm(p => ({ ...p, phone: v }))}>\n                {talent.phone ? (\n                  <a href={`tel:${talent.phone}`} className=\"flex items-center gap-2 text-blue-400 hover:text-blue-300\">\n                    <PhoneIcon className=\"w-4 h-4\" />\n                    {talent.phone}\n                  </a>\n                ) : <span className=\"text-gray-500 italic text-sm\">Not provided</span>}\n              </Field>\n              <Field label=\"Email\" editing={editing} value={form?.email || ''} onChange={v => setForm(p => ({ ...p, email: v }))}>\n                {talent.email ? (\n                  <a href={`mailto:${talent.email}`} className=\"flex items-center gap-2 text-blue-400 hover:text-blue-300 text-sm\">\n                    <EnvelopeIcon className=\"w-4 h-4\" />\n                    {talent.email}\n                  </a>\n                ) : <span className=\"text-gray-500 italic text-sm\">Not provided</span>}\n              </Field>\n              <Field label=\"Discord\" editing={editing} value={form?.discordHandle || ''} onChange={v => setForm(p => ({ ...p, discordHandle: v }))}>\n                <span className=\"text-sm text-white\">{talent.discordHandle || <span className=\"text-gray-500 italic\">Not set</span>}</span>\n              </Field>\n            </div>\n          </div>\n\n          {/* Commentary details */}\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Commentary Profile</h2>\n            <div className=\"grid grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">WAG / MAG</label>\n                {editing ? (\n                  <select\n                    value={form.wagMag || ''}\n                    onChange={e => setForm(p => ({ ...p, wagMag: e.target.value }))}\n                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                  >\n                    <option value=\"WAG\">WAG</option>\n                    <option value=\"MAG\">MAG</option>\n                    <option value=\"Both\">Both</option>\n                  </select>\n                ) : (\n                  <span className={`inline-block px-2 py-0.5 rounded text-xs font-medium ${wm.color}`}>{wm.label}</span>\n                )}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Commentary Role</label>\n                {editing ? (\n                  <select\n                    value={form.commentaryRole || ''}\n                    onChange={e => setForm(p => ({ ...p, commentaryRole: e.target.value }))}\n                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                  >\n                    <option value=\"Play by Play / Lead\">Play by Play / Lead</option>\n                    <option value=\"Color / Analyst\">Color / Analyst</option>\n                    <option value=\"Does not matter\">Does not matter</option>\n                  </select>\n                ) : (\n                  <span className=\"text-sm text-white\">{talent.commentaryRole || '—'}</span>\n                )}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Status</label>\n                {editing ? (\n                  <select\n                    value={form.status || ''}\n                    onChange={e => setForm(p => ({ ...p, status: e.target.value }))}\n                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                  >\n                    <option value=\"ready\">Ready</option>\n                    <option value=\"has-contact\">Has Contact</option>\n                    <option value=\"did-2025\">Did 2025</option>\n                    <option value=\"need-info\">Need Info</option>\n                  </select>\n                ) : (\n                  <span className={`inline-block px-2 py-0.5 rounded text-xs font-medium ${getStatusColor(talent.status)}`}>\n                    {getStatusLabel(talent.status)}\n                  </span>\n                )}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Affiliation</label>\n                {editing ? (\n                  <input\n                    value={form.affiliation || ''}\n                    onChange={e => setForm(p => ({ ...p, affiliation: e.target.value }))}\n                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                    placeholder=\"e.g. Stanford Alumni\"\n                  />\n                ) : <span className=\"text-sm text-white\">{talent.affiliation || '—'}</span>}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Conference</label>\n                {editing ? (\n                  <input\n                    value={form.conference || ''}\n                    onChange={e => setForm(p => ({ ...p, conference: e.target.value }))}\n                    className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                    placeholder=\"e.g. ECAC, GEC\"\n                  />\n                ) : <span className=\"text-sm text-white\">{talent.conference || '—'}</span>}\n              </div>\n              <div className=\"flex items-center gap-2\">\n                {editing ? (\n                  <>\n                    <input\n                      id=\"editCanProduce\"\n                      type=\"checkbox\"\n                      checked={form.canProduce || false}\n                      onChange={e => setForm(p => ({ ...p, canProduce: e.target.checked }))}\n                      className=\"rounded\"\n                    />\n                    <label htmlFor=\"editCanProduce\" className=\"text-sm text-gray-300\">Can produce</label>\n                  </>\n                ) : (\n                  <span className=\"text-sm text-white\">{talent.canProduce ? '✓ Can produce' : '—'}</span>\n                )}\n              </div>\n            </div>\n\n            {/* Other Interests */}\n            <div className=\"mt-4\">\n              <label className=\"block text-xs text-gray-500 mb-2\">Other Interests</label>\n              {editing ? (\n                <div className=\"flex flex-wrap gap-2\">\n                  {OTHER_INTERESTS.map(interest => (\n                    <button\n                      key={interest}\n                      type=\"button\"\n                      onClick={() => toggleInterest(interest)}\n                      className={`px-2 py-1 rounded text-xs transition-colors ${\n                        (form.otherInterests || []).includes(interest)\n                          ? 'bg-blue-600 text-white'\n                          : 'bg-gray-700 text-gray-300 hover:bg-gray-600'\n                      }`}\n                    >\n                      {interest.split(' (')[0]}\n                    </button>\n                  ))}\n                </div>\n              ) : (\n                <div className=\"flex flex-wrap gap-2\">\n                  {(talent.otherInterests || []).length === 0\n                    ? <span className=\"text-sm text-gray-500 italic\">None listed</span>\n                    : (talent.otherInterests || []).map(i => (\n                      <span key={i} className=\"px-2 py-0.5 bg-gray-700 text-gray-300 text-xs rounded\">\n                        {i.split(' (')[0]}\n                      </span>\n                    ))}\n                </div>\n              )}\n            </div>\n          </div>\n\n          {/* Tech onboarding */}\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Tech & Onboarding</h2>\n            <div className=\"grid grid-cols-3 gap-4\">\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">2026 Survey</label>\n                {editing ? (\n                  <input\n                    type=\"checkbox\"\n                    checked={form.surveyCompleted || false}\n                    onChange={e => setForm(p => ({ ...p, surveyCompleted: e.target.checked }))}\n                  />\n                ) : (\n                  <span className={`text-sm font-medium ${talent.surveyCompleted ? 'text-green-400' : 'text-gray-500'}`}>\n                    {talent.surveyCompleted ? '✓ Completed' : 'Not completed'}\n                  </span>\n                )}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Text Sent</label>\n                {editing ? (\n                  <input\n                    type=\"checkbox\"\n                    checked={form.textSent || false}\n                    onChange={e => setForm(p => ({ ...p, textSent: e.target.checked }))}\n                  />\n                ) : (\n                  <span className={`text-sm font-medium ${talent.textSent ? 'text-green-400' : 'text-gray-500'}`}>\n                    {talent.textSent ? '✓ Sent' : 'Not sent'}\n                  </span>\n                )}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Discord Added</label>\n                {editing ? (\n                  <input\n                    type=\"checkbox\"\n                    checked={form.discordAdded || false}\n                    onChange={e => setForm(p => ({ ...p, discordAdded: e.target.checked }))}\n                  />\n                ) : (\n                  <span className={`text-sm font-medium ${talent.discordAdded ? 'text-green-400' : 'text-gray-500'}`}>\n                    {talent.discordAdded ? '✓ Added' : 'Not added'}\n                  </span>\n                )}\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Headphones</label>\n                <span className=\"text-sm text-white\">{talent.hasHeadphones ? 'Yes' : '—'}</span>\n              </div>\n              <div>\n                <label className=\"block text-xs text-gray-500 mb-1\">Upload / Download</label>\n                <span className=\"text-sm text-white\">\n                  {talent.internetUploadMbps ? `${talent.internetUploadMbps} / ${talent.internetDownloadMbps || '?'} Mbps` : '—'}\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* Social links */}\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n            <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide mb-4\">Social / Discovery</h2>\n            <div className=\"grid grid-cols-2 gap-4\">\n              <Field label=\"LinkedIn\" editing={editing} value={form?.linkedInUrl || ''} onChange={v => setForm(p => ({ ...p, linkedInUrl: v }))} inputType=\"url\">\n                {talent.linkedInUrl\n                  ? <a href={talent.linkedInUrl} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-blue-400 hover:text-blue-300 text-sm truncate\">{talent.linkedInUrl}</a>\n                  : <span className=\"text-gray-500 italic text-sm\">Not found</span>}\n              </Field>\n              <Field label=\"Instagram\" editing={editing} value={form?.instagramUrl || ''} onChange={v => setForm(p => ({ ...p, instagramUrl: v }))} inputType=\"url\">\n                {talent.instagramUrl\n                  ? <a href={talent.instagramUrl} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-blue-400 hover:text-blue-300 text-sm truncate\">{talent.instagramUrl}</a>\n                  : <span className=\"text-gray-500 italic text-sm\">Not found</span>}\n              </Field>\n              <div className=\"col-span-2\">\n                <label className=\"block text-xs text-gray-500 mb-1\">Discovered From</label>\n                <span className=\"text-sm text-gray-400\">{talent.discoveredFrom || 'manual'}</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Right: History + Notes */}\n        <div className=\"space-y-5\">\n          {/* Competition history */}\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n            <div className=\"flex items-center gap-2 mb-4\">\n              <TrophyIcon className=\"w-4 h-4 text-yellow-400\" />\n              <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide\">\n                History\n              </h2>\n              <span className=\"ml-auto text-xs text-gray-500\">{talent.totalCompetitions || history.length} events</span>\n            </div>\n            {history.length === 0 ? (\n              <p className=\"text-xs text-gray-500 italic\">No competitions recorded yet.</p>\n            ) : (\n              <div className=\"space-y-2 max-h-64 overflow-y-auto\">\n                {[...history].reverse().map((h, i) => (\n                  <div key={i} className=\"text-xs border-b border-gray-700 pb-2 last:border-0\">\n                    <div className=\"text-white font-medium\">{h.eventName || h.compId}</div>\n                    <div className=\"text-gray-400\">{h.date} · {h.role}</div>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Notes */}\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-5\">\n            <div className=\"flex items-center gap-2 mb-3\">\n              <ChatBubbleLeftRightIcon className=\"w-4 h-4 text-blue-400\" />\n              <h2 className=\"text-sm font-semibold text-gray-300 uppercase tracking-wide\">Notes</h2>\n            </div>\n            {editing ? (\n              <textarea\n                value={form.notes || ''}\n                onChange={e => setForm(p => ({ ...p, notes: e.target.value }))}\n                rows={6}\n                className=\"w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded-lg text-sm text-white focus:outline-none focus:border-blue-500 resize-none\"\n                placeholder=\"Notes about this person...\"\n              />\n            ) : (\n              <>\n                {talent.notes ? (\n                  <pre className=\"text-xs text-gray-300 whitespace-pre-wrap font-sans max-h-48 overflow-y-auto mb-3\">\n                    {talent.notes}\n                  </pre>\n                ) : (\n                  <p className=\"text-xs text-gray-500 italic mb-3\">No notes yet.</p>\n                )}\n                <form onSubmit={handleAddNote} className=\"flex gap-2\">\n                  <input\n                    value={noteText}\n                    onChange={e => setNoteText(e.target.value)}\n                    placeholder=\"Add a note...\"\n                    className=\"flex-1 px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n                  />\n                  <button\n                    type=\"submit\"\n                    disabled={savingNote || !noteText.trim()}\n                    className=\"px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded text-sm disabled:opacity-50 transition-colors\"\n                  >\n                    Add\n                  </button>\n                </form>\n                <p className=\"text-xs text-gray-600 mt-1.5\">Notes are timestamped automatically.</p>\n              </>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Delete confirmation */}\n      {confirmDelete && (\n        <div className=\"fixed inset-0 bg-black/60 flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-gray-800 rounded-xl border border-gray-700 p-6 max-w-sm w-full\">\n            <h3 className=\"text-lg font-semibold text-white mb-2\">Remove {talent.name}?</h3>\n            <p className=\"text-gray-400 text-sm mb-5\">This will permanently delete their profile and all associated data.</p>\n            <div className=\"flex justify-end gap-3\">\n              <button onClick={() => setConfirmDelete(false)} className=\"px-4 py-2 text-gray-400 hover:text-white text-sm\">\n                Cancel\n              </button>\n              <button\n                onClick={handleDelete}\n                className=\"px-4 py-2 bg-red-600 hover:bg-red-500 rounded-lg text-sm font-medium transition-colors\"\n              >\n                Remove\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction Field({ label, editing, value, onChange, children, inputType = 'text' }) {\n  return (\n    <div>\n      <label className=\"block text-xs text-gray-500 mb-1\">{label}</label>\n      {editing ? (\n        <input\n          type={inputType}\n          value={value}\n          onChange={e => onChange(e.target.value)}\n          className=\"w-full px-3 py-1.5 bg-gray-700 border border-gray-600 rounded text-sm text-white focus:outline-none focus:border-blue-500\"\n        />\n      ) : (\n        <div className=\"text-sm\">{children}</div>\n      )}\n    </div>\n  );\n}\n","numLines":541,"startLine":1,"totalLines":541}}}
