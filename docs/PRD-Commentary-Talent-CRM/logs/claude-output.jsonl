{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FD2tFnsj2gyV4r72TmPqgQ","type":"tool_result","content":"     1→import { useState, useEffect, useCallback } from 'react';\n     2→import { db, ref, onValue, push, set, update, remove } from '../lib/firebase';\n     3→\n     4→/**\n     5→ * useTalentRoster - Global hook for managing the commentary talent database.\n     6→ *\n     7→ * Firebase path: talentRoster/\n     8→ *\n     9→ * Status tiers (matches existing Google Sheets):\n    10→ *   need-info    — Name + affiliation only, no contact details\n    11→ *   has-contact  — Partial contact info (email or phone)\n    12→ *   did-YYYY     — Worked in a prior season (e.g. \"did-2025\"), needs re-confirmation\n    13→ *   ready        — Fully confirmed for current season\n    14→ */\n    15→export function useTalentRoster() {\n    16→  const [talents, setTalents] = useState({});\n    17→  const [loading, setLoading] = useState(true);\n    18→  const [error, setError] = useState(null);\n    19→\n    20→  useEffect(() => {\n    21→    const talentRef = ref(db, 'talentRoster');\n    22→    const unsubscribe = onValue(\n    23→      talentRef,\n    24→      (snapshot) => {\n    25→        setTalents(snapshot.val() || {});\n    26→        setLoading(false);\n    27→      },\n    28→      (err) => {\n    29→        setError(err.message);\n    30→        setLoading(false);\n    31→      }\n    32→    );\n    33→    return () => unsubscribe();\n    34→  }, []);\n    35→\n    36→  const createTalent = useCallback(async (data) => {\n    37→    const listRef = ref(db, 'talentRoster');\n    38→    const newRef = push(listRef);\n    39→    await set(newRef, {\n    40→      ...data,\n    41→      totalCompetitions: data.totalCompetitions || 0,\n    42→      competitionHistory: data.competitionHistory || [],\n    43→      createdAt: new Date().toISOString(),\n    44→      updatedAt: new Date().toISOString(),\n    45→    });\n    46→    return newRef.key;\n    47→  }, []);\n    48→\n    49→  const updateTalent = useCallback(async (talentId, data) => {\n    50→    await update(ref(db, `talentRoster/${talentId}`), {\n    51→      ...data,\n    52→      updatedAt: new Date().toISOString(),\n    53→    });\n    54→  }, []);\n    55→\n    56→  const deleteTalent = useCallback(async (talentId) => {\n    57→    await remove(ref(db, `talentRoster/${talentId}`));\n    58→  }, []);\n    59→\n    60→  // Sorted array for rendering\n    61→  const talentList = Object.entries(talents)\n    62→    .map(([id, data]) => ({ id, ...data }))\n    63→    .sort((a, b) => (a.name || '').localeCompare(b.name || ''));\n    64→\n    65→  return {\n    66→    talents,\n    67→    talentList,\n    68→    loading,\n    69→    error,\n    70→    createTalent,\n    71→    updateTalent,\n    72→    deleteTalent,\n    73→  };\n    74→}\n    75→\n    76→// ─── Status helpers ───────────────────────────────────────────────────────────\n    77→\n    78→export const TALENT_STATUS = {\n    79→  NEED_INFO: 'need-info',\n    80→  HAS_CONTACT: 'has-contact',\n    81→  READY: 'ready',\n    82→};\n    83→\n    84→export function getStatusLabel(status) {\n    85→  if (!status) return 'Unknown';\n    86→  if (status === 'need-info') return 'Need Info';\n    87→  if (status === 'has-contact') return 'Has Contact';\n    88→  if (status === 'ready') return 'Ready';\n    89→  if (status.startsWith('did-')) return `Did ${status.slice(4)}`;\n    90→  return status;\n    91→}\n    92→\n    93→export function getStatusColor(status) {\n    94→  if (status === 'ready') return 'bg-green-700 text-green-100';\n    95→  if (status === 'has-contact') return 'bg-blue-700 text-blue-100';\n    96→  if (status === 'need-info') return 'bg-gray-600 text-gray-200';\n    97→  if (status?.startsWith('did-')) return 'bg-amber-700 text-amber-100';\n    98→  return 'bg-gray-600 text-gray-200';\n    99→}\n   100→\n   101→export function wagMagLabel(wagMag) {\n   102→  if (wagMag === 'WAG') return { label: 'WAG', color: 'bg-pink-700 text-pink-100' };\n   103→  if (wagMag === 'MAG') return { label: 'MAG', color: 'bg-blue-700 text-blue-100' };\n   104→  return { label: 'Both', color: 'bg-purple-700 text-purple-100' };\n   105→}\n   106→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"88d7e50c-2ca8-430e-b0be-ee1c17518ff0","uuid":"7e91f37a-dc1a-4cce-ac3d-b50659543e7e","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/hooks/useTalentRoster.js","content":"import { useState, useEffect, useCallback } from 'react';\nimport { db, ref, onValue, push, set, update, remove } from '../lib/firebase';\n\n/**\n * useTalentRoster - Global hook for managing the commentary talent database.\n *\n * Firebase path: talentRoster/\n *\n * Status tiers (matches existing Google Sheets):\n *   need-info    — Name + affiliation only, no contact details\n *   has-contact  — Partial contact info (email or phone)\n *   did-YYYY     — Worked in a prior season (e.g. \"did-2025\"), needs re-confirmation\n *   ready        — Fully confirmed for current season\n */\nexport function useTalentRoster() {\n  const [talents, setTalents] = useState({});\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState(null);\n\n  useEffect(() => {\n    const talentRef = ref(db, 'talentRoster');\n    const unsubscribe = onValue(\n      talentRef,\n      (snapshot) => {\n        setTalents(snapshot.val() || {});\n        setLoading(false);\n      },\n      (err) => {\n        setError(err.message);\n        setLoading(false);\n      }\n    );\n    return () => unsubscribe();\n  }, []);\n\n  const createTalent = useCallback(async (data) => {\n    const listRef = ref(db, 'talentRoster');\n    const newRef = push(listRef);\n    await set(newRef, {\n      ...data,\n      totalCompetitions: data.totalCompetitions || 0,\n      competitionHistory: data.competitionHistory || [],\n      createdAt: new Date().toISOString(),\n      updatedAt: new Date().toISOString(),\n    });\n    return newRef.key;\n  }, []);\n\n  const updateTalent = useCallback(async (talentId, data) => {\n    await update(ref(db, `talentRoster/${talentId}`), {\n      ...data,\n      updatedAt: new Date().toISOString(),\n    });\n  }, []);\n\n  const deleteTalent = useCallback(async (talentId) => {\n    await remove(ref(db, `talentRoster/${talentId}`));\n  }, []);\n\n  // Sorted array for rendering\n  const talentList = Object.entries(talents)\n    .map(([id, data]) => ({ id, ...data }))\n    .sort((a, b) => (a.name || '').localeCompare(b.name || ''));\n\n  return {\n    talents,\n    talentList,\n    loading,\n    error,\n    createTalent,\n    updateTalent,\n    deleteTalent,\n  };\n}\n\n// ─── Status helpers ───────────────────────────────────────────────────────────\n\nexport const TALENT_STATUS = {\n  NEED_INFO: 'need-info',\n  HAS_CONTACT: 'has-contact',\n  READY: 'ready',\n};\n\nexport function getStatusLabel(status) {\n  if (!status) return 'Unknown';\n  if (status === 'need-info') return 'Need Info';\n  if (status === 'has-contact') return 'Has Contact';\n  if (status === 'ready') return 'Ready';\n  if (status.startsWith('did-')) return `Did ${status.slice(4)}`;\n  return status;\n}\n\nexport function getStatusColor(status) {\n  if (status === 'ready') return 'bg-green-700 text-green-100';\n  if (status === 'has-contact') return 'bg-blue-700 text-blue-100';\n  if (status === 'need-info') return 'bg-gray-600 text-gray-200';\n  if (status?.startsWith('did-')) return 'bg-amber-700 text-amber-100';\n  return 'bg-gray-600 text-gray-200';\n}\n\nexport function wagMagLabel(wagMag) {\n  if (wagMag === 'WAG') return { label: 'WAG', color: 'bg-pink-700 text-pink-100' };\n  if (wagMag === 'MAG') return { label: 'MAG', color: 'bg-blue-700 text-blue-100' };\n  return { label: 'Both', color: 'bg-purple-700 text-purple-100' };\n}\n","numLines":106,"startLine":1,"totalLines":106}}}
