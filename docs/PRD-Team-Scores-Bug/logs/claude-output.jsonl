t gymnasts = event.gymnasts || [];","+        if (gymnasts.length === 0) continue;","+","+        const scored = gymnasts.filter(g => g.final_score != null);","+        const unscored = gymnasts.filter(g => g.final_score == null);","+","+        // Event in progress: has some scores but not complete","+        if (scored.length > 0 && unscored.length > 0) {","+          return event;","+        }","+      }","+","+      // No event in progress - find the last event with scores","+      for (let i = events.length - 1; i >= 0; i--) {","+        const event = events[i];","+        const gymnasts = event.gymnasts || [];","+        const scored = gymnasts.filter(g => g.final_score != null);","+        if (scored.length > 0) {","+          return event;","+        }","+      }","+","+      // No events have scores yet - return first event","+      return events[0];","+    }","+","+    /**","+     * Render lineup card HTML content.","+     * @param {Object} teamData - Team data from Virtius API","+     * @param {Object} configTeam - Team config with logo/name","+     * @param {Object} event - Current event to display","+     * @returns {string} HTML content","+     */","+    function renderLineupCardContent(teamData, configTeam, event) {","+      const teamName = configTeam.name || teamData.name || 'Team';","+      const teamLogo = configTeam.logo || '';","+      const eventName = getEventShortCode(event.event_name || event.name || '');","+      const eventTotal = formatScore(event.event_score);","+","+      // Sort gymnasts by lineup order","+      const gymnasts = [...(event.gymnasts || [])].sort((a, b) => (a.order || 0) - (b.order || 0));","+","+      // Build athlete rows","+      const athleteRows = gymnasts.map((g, idx) => {","+        const order = g.order || (idx + 1);","+        const name = g.full_name || 'Unknown';","+        // Get start value from scores array if available","+        const startValue = (g.scores && g.scores[0] && g.scores[0].start)","+        