{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WhxLkgTQS4uTX9XwYh7mNv","type":"tool_result","content":"     1→import { useState, useEffect, useMemo } from 'react';\n     2→import { db, ref, onValue, set } from '../lib/firebase';\n     3→import {\n     4→  ChartBarIcon,\n     5→  ChevronDownIcon,\n     6→  ChevronUpIcon,\n     7→  ClipboardIcon,\n     8→  CheckIcon,\n     9→  ExclamationTriangleIcon,\n    10→  XMarkIcon\n    11→} from '@heroicons/react/24/solid';\n    12→\n    13→/**\n    14→ * HeartbeatIndicator - Shows last poll time with status indicator\n    15→ *\n    16→ * States:\n    17→ * - Recent (green): within 2x poll interval - normal operation\n    18→ * - Warning (yellow): 2x-5x poll interval - delayed but not critical\n    19→ * - Stale (red): beyond 5x poll interval - data may be outdated\n    20→ */\n    21→function HeartbeatIndicator({ lastPoll, pollInterval }) {\n    22→  const [now, setNow] = useState(Date.now());\n    23→\n    24→  // Update \"now\" every second to keep relative time fresh\n    25→  useEffect(() => {\n    26→    const interval = setInterval(() => setNow(Date.now()), 1000);\n    27→    return () => clearInterval(interval);\n    28→  }, []);\n    29→\n    30→  const { timeAgo, status } = useMemo(() => {\n    31→    if (!lastPoll) return { timeAgo: 'never', status: 'stale' };\n    32→    const seconds = Math.floor((now - lastPoll) / 1000);\n    33→    const intervalSec = pollInterval / 1000;\n    34→\n    35→    // Determine status based on multiples of poll interval\n    36→    let status;\n    37→    if (seconds < intervalSec * 2) {\n    38→      status = 'recent';\n    39→    } else if (seconds < intervalSec * 5) {\n    40→      status = 'warning';\n    41→    } else {\n    42→      status = 'stale';\n    43→    }\n    44→\n    45→    return {\n    46→      timeAgo: seconds < 60 ? `${seconds}s ago` : `${Math.floor(seconds / 60)}m ago`,\n    47→      status\n    48→    };\n    49→  }, [lastPoll, now, pollInterval]);\n    50→\n    51→  const dotClass = {\n    52→    recent: 'bg-green-500 animate-pulse',\n    53→    warning: 'bg-yellow-500',\n    54→    stale: 'bg-red-500'\n    55→  }[status];\n    56→\n    57→  const textClass = {\n    58→    recent: 'text-green-400',\n    59→    warning: 'text-yellow-400',\n    60→    stale: 'text-red-400'\n    61→  }[status];\n    62→\n    63→  return (\n    64→    <div className=\"flex items-center gap-2\">\n    65→      <span className={`w-2 h-2 rounded-full ${dotClass}`} />\n    66→      <span className={`text-sm ${textClass}`}>\n    67→        {timeAgo}\n    68→      </span>\n    69→      {status === 'stale' && (\n    70→        <span className=\"px-1.5 py-0.5 bg-red-500/20 text-red-400 text-xs rounded font-medium\">\n    71→          STALE\n    72→        </span>\n    73→      )}\n    74→    </div>\n    75→  );\n    76→}\n    77→\n    78→/**\n    79→ * ScoreBugPanel - Control panel for team scores bug overlay\n    80→ *\n    81→ * @param {string} compId - Competition ID\n    82→ * @param {boolean} collapsed - Initial collapsed state\n    83→ */\n    84→export default function ScoreBugPanel({\n    85→  compId,\n    86→  collapsed: initialCollapsed = true\n    87→}) {\n    88→  const [collapsed, setCollapsed] = useState(initialCollapsed);\n    89→  const [scoreBugState, setScoreBugState] = useState(null);\n    90→  const [copiedUrl, setCopiedUrl] = useState(false);\n    91→\n    92→  // Generate overlay URL\n    93→  const overlayUrl = compId\n    94→    ? `${window.location.origin}/overlays/team-bug.html?compId=${compId}`\n    95→    : '';\n    96→\n    97→  // Copy URL to clipboard\n    98→  const copyUrl = () => {\n    99→    navigator.clipboard.writeText(overlayUrl);\n   100→    setCopiedUrl(true);\n   101→    setTimeout(() => setCopiedUrl(false), 2000);\n   102→  };\n   103→\n   104→  // Toggle enabled state\n   105→  const toggleEnabled = () => {\n   106→    const newState = !scoreBugState?.enabled;\n   107→    set(ref(db, `competitions/${compId}/scoreBug/enabled`), newState);\n   108→  };\n   109→\n   110→  // Toggle polling state\n   111→  const togglePolling = () => {\n   112→    const newState = !scoreBugState?.polling;\n   113→    set(ref(db, `competitions/${compId}/scoreBug/polling`), newState);\n   114→  };\n   115→\n   116→  // Set poll frequency\n   117→  const setPollFrequency = (frequency) => {\n   118→    set(ref(db, `competitions/${compId}/scoreBug/config/pollInterval`), frequency);\n   119→  };\n   120→\n   121→  // Toggle automation mode (auto/manual)\n   122→  const toggleAutomationMode = () => {\n   123→    const currentMode = scoreBugState?.config?.automationMode || 'auto';\n   124→    const newMode = currentMode === 'auto' ? 'manual' : 'auto';\n   125→    set(ref(db, `competitions/${compId}/scoreBug/config/automationMode`), newMode);\n   126→  };\n   127→\n   128→  // Dismiss flash for a specific team\n   129→  const dismissFlash = (teamIndex) => {\n   130→    set(ref(db, `competitions/${compId}/scoreBug/dismissFlash/${teamIndex}`), true);\n   131→  };\n   132→\n   133→  // Dismiss all flashes\n   134→  const dismissAllFlashes = () => {\n   135→    // Dismiss flashes for teams 0, 1 (typical dual meet)\n   136→    const dismissals = { 0: true, 1: true };\n   137→    set(ref(db, `competitions/${compId}/scoreBug/dismissFlash`), dismissals);\n   138→  };\n   139→\n   140→  // Listen to scoreBug state from Firebase\n   141→  useEffect(() => {\n   142→    if (!compId) return;\n   143→\n   144→    const scoreBugRef = ref(db, `competitions/${compId}/scoreBug`);\n   145→    const unsubscribe = onValue(scoreBugRef, (snapshot) => {\n   146→      setScoreBugState(snapshot.val() || {});\n   147→    });\n   148→\n   149→    return () => unsubscribe();\n   150→  }, [compId]);\n   151→\n   152→  // Empty state - no competition selected\n   153→  if (!compId) {\n   154→    return (\n   155→      <div className=\"bg-zinc-800 rounded-xl p-4\">\n   156→        <div className=\"flex items-center gap-2 text-zinc-400\">\n   157→          <ChartBarIcon className=\"w-5 h-5\" />\n   158→          <span className=\"font-medium\">Score Bug</span>\n   159→        </div>\n   160→        <div className=\"text-center py-4 text-zinc-500 text-sm\">\n   161→          Select a competition\n   162→        </div>\n   163→      </div>\n   164→    );\n   165→  }\n   166→\n   167→  // Loading state\n   168→  if (scoreBugState === null) {\n   169→    return (\n   170→      <div className=\"bg-zinc-800 rounded-xl p-4\">\n   171→        <div className=\"flex items-center gap-2 text-zinc-400\">\n   172→          <ChartBarIcon className=\"w-5 h-5\" />\n   173→          <span className=\"font-medium\">Score Bug</span>\n   174→        </div>\n   175→        <div className=\"text-center py-4 text-zinc-500 text-sm\">\n   176→          Loading...\n   177→        </div>\n   178→      </div>\n   179→    );\n   180→  }\n   181→\n   182→  return (\n   183→    <div className=\"bg-zinc-800 rounded-xl overflow-hidden\">\n   184→      {/* Header */}\n   185→      <button\n   186→        onClick={() => setCollapsed(!collapsed)}\n   187→        className=\"w-full flex items-center justify-between px-4 py-3 bg-zinc-800 hover:bg-zinc-700/50 transition-colors\"\n   188→      >\n   189→        <div className=\"flex items-center gap-2\">\n   190→          <ChartBarIcon className=\"w-5 h-5 text-zinc-400\" />\n   191→          <span className=\"font-medium text-white\">Score Bug</span>\n   192→          {/* Status indicator */}\n   193→          {scoreBugState.enabled && (\n   194→            <span className=\"px-2 py-0.5 bg-green-500/20 text-green-400 text-xs rounded-full\">\n   195→              ON\n   196→            </span>\n   197→          )}\n   198→        </div>\n   199→        {collapsed ? (\n   200→          <ChevronDownIcon className=\"w-5 h-5 text-zinc-400\" />\n   201→        ) : (\n   202→          <ChevronUpIcon className=\"w-5 h-5 text-zinc-400\" />\n   203→        )}\n   204→      </button>\n   205→\n   206→      {!collapsed && (\n   207→        <div className=\"p-4 pt-0 space-y-3\">\n   208→          {/* Overlay URL with Copy Button */}\n   209→          <div className=\"flex items-center gap-2\">\n   210→            <input\n   211→              type=\"text\"\n   212→              readOnly\n   213→              value={overlayUrl}\n   214→              className=\"flex-1 bg-zinc-900 text-zinc-400 text-xs px-3 py-2 rounded-lg border border-zinc-700 focus:outline-none\"\n   215→            />\n   216→            <button\n   217→              onClick={copyUrl}\n   218→              className=\"p-2 bg-zinc-700 hover:bg-zinc-600 text-zinc-300 rounded-lg transition-colors\"\n   219→              title=\"Copy overlay URL\"\n   220→            >\n   221→              {copiedUrl ? (\n   222→                <CheckIcon className=\"w-4 h-4 text-green-400\" />\n   223→              ) : (\n   224→                <ClipboardIcon className=\"w-4 h-4\" />\n   225→              )}\n   226→            </button>\n   227→          </div>\n   228→\n   229→          {/* On/Off Toggle */}\n   230→          <div className=\"flex items-center justify-between py-2\">\n   231→            <span className=\"text-sm text-zinc-300\">Show Bug</span>\n   232→            <button\n   233→              onClick={toggleEnabled}\n   234→              className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${\n   235→                scoreBugState?.enabled ? 'bg-green-500' : 'bg-zinc-600'\n   236→              }`}\n   237→            >\n   238→              <span\n   239→                className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${\n   240→                  scoreBugState?.enabled ? 'translate-x-6' : 'translate-x-1'\n   241→                }`}\n   242→              />\n   243→            </button>\n   244→          </div>\n   245→\n   246→          {/* Polling Toggle */}\n   247→          <div className=\"flex items-center justify-between py-2\">\n   248→            <span className=\"text-sm text-zinc-300\">API Polling</span>\n   249→            <button\n   250→              onClick={togglePolling}\n   251→              className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${\n   252→                scoreBugState?.polling ? 'bg-blue-500' : 'bg-zinc-600'\n   253→              }`}\n   254→            >\n   255→              <span\n   256→                className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${\n   257→                  scoreBugState?.polling ? 'translate-x-6' : 'translate-x-1'\n   258→                }`}\n   259→              />\n   260→            </button>\n   261→          </div>\n   262→\n   263→          {/* Poll Frequency Selector */}\n   264→          <div className=\"flex items-center justify-between py-2\">\n   265→            <span className=\"text-sm text-zinc-300\">Poll Frequency</span>\n   266→            <select\n   267→              value={scoreBugState?.config?.pollInterval || 5000}\n   268→              onChange={(e) => setPollFrequency(Number(e.target.value))}\n   269→              className=\"bg-zinc-700 text-zinc-200 text-sm px-3 py-1.5 rounded-lg border border-zinc-600 focus:outline-none focus:border-blue-500\"\n   270→            >\n   271→              <option value={2000}>2s</option>\n   272→              <option value={5000}>5s</option>\n   273→              <option value={10000}>10s</option>\n   274→              <option value={30000}>30s</option>\n   275→            </select>\n   276→          </div>\n   277→\n   278→          {/* Heartbeat Indicator */}\n   279→          {scoreBugState?.polling && (\n   280→            <div className=\"flex items-center justify-between py-2\">\n   281→              <span className=\"text-sm text-zinc-300\">Last Poll</span>\n   282→              <HeartbeatIndicator\n   283→                lastPoll={scoreBugState?.status?.lastPoll}\n   284→                pollInterval={scoreBugState?.config?.pollInterval || 5000}\n   285→              />\n   286→            </div>\n   287→          )}\n   288→\n   289→          {/* API Error Indicator (D5b) */}\n   290→          {scoreBugState?.status?.error && (\n   291→            <div className=\"bg-red-500/10 border border-red-500/30 rounded-lg px-3 py-2\">\n   292→              <div className=\"flex items-center gap-2\">\n   293→                <ExclamationTriangleIcon className=\"w-4 h-4 text-red-400 flex-shrink-0\" />\n   294→                <span className=\"text-sm text-red-400 font-medium\">API Error</span>\n   295→              </div>\n   296→              <p className=\"text-xs text-red-300/80 mt-1 ml-6\">\n   297→                {scoreBugState.status.error.message || 'Unknown error'}\n   298→              </p>\n   299→              {scoreBugState.status.error.retryIn && (\n   300→                <p className=\"text-xs text-red-300/60 mt-0.5 ml-6\">\n   301→                  Retrying in {Math.ceil(scoreBugState.status.error.retryIn / 1000)}s\n   302→                </p>\n   303→              )}\n   304→            </div>\n   305→          )}\n   306→\n   307→          {/* Automation Mode Toggle */}\n   308→          <div className=\"flex items-center justify-between py-2\">\n   309→            <span className=\"text-sm text-zinc-300\">Now Competing</span>\n   310→            <div className=\"flex items-center gap-2\">\n   311→              <span className={`text-xs ${\n   312→                (scoreBugState?.config?.automationMode || 'auto') === 'auto'\n   313→                  ? 'text-zinc-500'\n   314→                  : 'text-purple-400 font-medium'\n   315→              }`}>\n   316→                MANUAL\n   317→              </span>\n   318→              <button\n   319→                onClick={toggleAutomationMode}\n   320→                className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${\n   321→     