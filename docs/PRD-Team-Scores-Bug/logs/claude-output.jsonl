{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AgeW4NBUrpCZYwELYa9WMe","type":"tool_result","content":"   100→  { id: 'nbc', label: 'NBC Olympics' },\n   101→  { id: 'btn', label: 'Big Ten' },\n   102→  { id: 'pac12', label: 'Pac-12' },\n   103→  { id: 'virtius', label: 'Virtius' },\n   104→  { id: 'neon', label: 'Neon' },\n   105→  { id: 'classic', label: 'Classic' },\n   106→  { id: 'light', label: 'Light' },\n   107→  { id: 'home', label: 'Team Colors' },\n   108→  { id: 'gradient', label: 'Gradient' },\n   109→];\n   110→\n   111→// Map Virtius event names to display names\n   112→const eventDisplayNames = {\n   113→  'FLOOR': 'Floor Exercise',\n   114→  'HORSE': 'Pommel Horse',\n   115→  'RINGS': 'Still Rings',\n   116→  'VAULT': 'Vault',\n   117→  'PBARS': 'Parallel Bars',\n   118→  'BAR': 'High Bar',\n   119→};\n   120→\n   121→export default function GraphicsControl({ competitionId }) {\n   122→  const [currentGraphic, setCurrentGraphic] = useState(null);\n   123→  const [currentGraphicId, setCurrentGraphicId] = useState(null); // Track the specific button ID (e.g., 'floor', 'pommel')\n   124→  const [config, setConfig] = useState(null);\n   125→  const [copied, setCopied] = useState(false);\n   126→  const [summaryTheme, setSummaryTheme] = useState('default');\n   127→  const [liveAthletes, setLiveAthletes] = useState([]); // Athletes currently competing (type: 0, no score yet)\n   128→  const [isPolling, setIsPolling] = useState(false);\n   129→\n   130→  // Use competitionId directly from props (no local state needed)\n   131→  const compId = competitionId || '';\n   132→\n   133→  // Get gender-specific event configuration\n   134→  const { events, eventIds, rotationCount, gender } = useEventConfig(config?.compType);\n   135→\n   136→  // Get teams database for sponsor data\n   137→  const { getTeamSponsors, resolveSchoolKey } = useTeamsDatabase();\n   138→\n   139→  // Build dynamic graphic buttons based on competition gender