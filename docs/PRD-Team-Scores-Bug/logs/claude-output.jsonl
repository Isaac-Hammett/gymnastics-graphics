{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019DAnvoaBPfifc7Ra6uQEKM","type":"tool_result","content":"     1→import { useState, useEffect, useMemo } from 'react';\n     2→import { db, ref, onValue, set } from '../lib/firebase';\n     3→import {\n     4→  ChartBarIcon,\n     5→  ChevronDownIcon,\n     6→  ChevronUpIcon,\n     7→  ClipboardIcon,\n     8→  CheckIcon,\n     9→  ExclamationTriangleIcon\n    10→} from '@heroicons/react/24/solid';\n    11→\n    12→/**\n    13→ * HeartbeatIndicator - Shows last poll time with status indicator\n    14→ *\n    15→ * States:\n    16→ * - Recent (green): within 2x poll interval - normal operation\n    17→ * - Warning (yellow): 2x-5x poll interval - delayed but not critical\n    18→ * - Stale (red): beyond 5x poll interval - data may be outdated\n    19→ */\n    20→function HeartbeatIndicator({ lastPoll, pollInterval }) {\n    21→  const [now, setNow] = useState(Date.now());\n    22→\n    23→  // Update \"now\" every second to keep relative time fresh\n    24→  useEffect(() => {\n    25→    const interval = setInterval(() => setNow(Date.now()), 1000);\n    26→    return () => clearInterval(interval);\n    27→  }, []);\n    28→\n    29→  const { timeAgo, status } = useMemo(() => {\n    30→    if (!lastPoll) return { timeAgo: 'never', status: 'stale' };\n    31→    const seconds = Math.floor((now - lastPoll) / 1000);\n    32→    const intervalSec = pollInterval / 1000;\n    33→\n    34→    // Determine status based on multiples of poll interval\n    35→    let status;\n    36→    if (seconds < intervalSec * 2) {\n    37→      status = 'recent';\n    38→    } else if (seconds < intervalSec * 5) {\n    39→      status = 'warning';\n    40→    } else {\n    41→      status = 'stale';\n    42→    }\n    43→\n    44→    return {\n    45→      timeAgo: seconds < 60 ? `${seconds}s ago` : `${Math.floor(seconds / 60)}m ago`,\n    46→      status\n    47→    };\n    48→  }, [lastPoll, now, pollInterval]);\n    49→\n    50→  const dotClass = {\n    51→    recent: 'bg-green-500 animate-pulse',\n    52→    warning: 'bg-yellow-500',\n    53→    stale: 'bg-red-500'\n    54→  }[status];\n    55→\n    56→  const textClass = {\n    57→    recent: 'text-green-400',\n    58→    warning: 'text-yellow-400',\n    59→    stale: 'text-red-400'\n    60→  }[status];\n    61→\n    62→  return (\n    63→    <div className=\"flex items-center gap-2\">\n    64→      <span className={`w-2 h-2 rounded-full ${dotClass}`} />\n    65→      <span className={`text-sm ${textClass}`}>\n    66→        {timeAgo}\n    67→      </span>\n    68→      {status === 'stale' && (\n    69→        <span className=\"px-1.5 py-0.5 bg-red-500/20 text-red-400 text-xs rounded font-medium\">\n    70→          STALE\n    71→        </span>\n    72→      )}\n    73→    </div>\n    74→  );\n    75→}\n    76→\n    77→/**\n    78→ * ScoreBugPanel - Control panel for team scores bug overlay\n    79→ *\n    80→ * @param {string} compId - Competition ID\n    81→ * @param {boolean} collapsed - Initial collapsed state\n    82→ */\n    83→export default function ScoreBugPanel({\n    84→  compId,\n    85→  collapsed: initialCollapsed = true\n    86→}) {\n    87→  const [collapsed, setCollapsed] = useState(initialCollapsed);\n    88→  const [scoreBugState, setScoreBugState] = useState(null);\n    89→  const [copiedUrl, setCopiedUrl] = useState(false);\n    90→\n    91→  // Generate overlay URL\n    92→  const overlayUrl = compId\n    93→    ? `${window.location.origin}/overlays/team-bug.html?compId=${compId}`\n    94→    : '';\n    95→\n    96→  // Copy URL to clipboard\n    97→  const copyUrl = () => {\n    98→    navigator.clipboard.writeText(overlayUrl);\n    99→    setCopiedUrl(true);\n   100→    setTimeout(() => setCopiedUrl(false), 2000);\n   101→  };\n   102→\n   103→  // Toggle enabled state\n   104→  const toggleEnabled = () => {\n   105→    const newState = !scoreBugState?.enabled;\n   106→    set(ref(db, `competitions/${compId}/scoreBug/enabled`), newState);\n   107→  };\n   108→\n   109→  // Toggle polling state\n   110→  const togglePolling = () => {\n   111→    const newState = !scoreBugState?.polling;\n   112→    set(ref(db, `competitions/${compId}/scoreBug/polling`), newState);\n   113→  };\n   114→\n   115→  // Set poll frequency\n   116→  const setPollFrequency = (frequency) => {\n   117→    set(ref(db, `competitions/${compId}/scoreBug/config/pollInterval`), frequency);\n   118→  };\n   119→\n   120→  // Toggle automation mode (auto/manual)\n   121→  const toggleAutomationMode = () => {\n   122→    const currentMode = scoreBugState?.config?.automationMode || 'auto';\n   123→    const newMode = currentMode === 'auto' ? 'manual' : 'auto';\n   124→    set(ref(db, `competitions/${compId}/scoreBug/config/automationMode`), newMode);\n   125→  };\n   126→\n   127→  // Listen to scoreBug state from Firebase\n   128→  useEffect(() => {\n   129→    if (!compId) return;\n   130→\n   131→    const scoreBugRef = ref(db, `competitions/${compId}/scoreBug`);\n   132→    const unsubscribe = onValue(scoreBugRef, (snapshot) => {\n   133→      setScoreBugState(snapshot.val() || {});\n   134→    });\n   135→\n   136→    return () => unsubscribe();\n   137→  }, [compId]);\n   138→\n   139→  // Empty state - no competition selected\n   140→  if (!compId) {\n   141→    return (\n   142→      <div className=\"bg-zinc-800 rounded-xl p-4\">\n   143→        <div className=\"flex items-center gap-2 text-zinc-400\">\n   144→          <ChartBarIcon className=\"w-5 h-5\" />\n   145→          <span className=\"font-medium\">Score Bug</span>\n   146→        </div>\n   147→        <div className=\"text-center py-4 text-zinc-500 text-sm\">\n   148→          Select a competition\n   149→        </div>\n   150→      </div>\n   151→    );\n   152→  }\n   153→\n   154→  // Loading state\n   155→  if (scoreBugState === null) {\n   156→    return (\n   157→      <div className=\"bg-zinc-800 rounded-xl p-4\">\n   158→        <div className=\"flex items-center gap-2 text-zinc-400\">\n   159→          <ChartBarIcon className=\"w-5 h-5\" />\n   160→          <span className=\"font-medium\">Score Bug</span>\n   161→        </div>\n   162→        <div className=\"text-center py-4 text-zinc-500 text-sm\">\n   163→          Loading...\n   164→        </div>\n   165→      </div>\n   166→    );\n   167→  }\n   168→\n   169→  return (\n   170→    <div className=\"bg-zinc-800 rounded-xl overflow-hidden\">\n   171→      {/* Header */}\n   172→      <button\n   173→        onClick={() => setCollapsed(!collapsed)}\n   174→        className=\"w-full flex items-center justify-between px-4 py-3 bg-zinc-800 hover:bg-zinc-700/50 transition-colors\"\n   175→      >\n   176→        <div className=\"flex items-center gap-2\">\n   177→          <ChartBarIcon className=\"w-5 h-5 text-zinc-400\" />\n   178→          <span className=\"font-medium text-white\">Score Bug</span>\n   179→          {/* Status indicator */}\n   180→          {scoreBugState.enabled && (\n   181→            <span className=\"px-2 py-0.5 bg-green-500/20 text-green-400 text-xs rounded-full\">\n   182→              ON\n   183→            </span>\n   184→          )}\n   185→        </div>\n   186→        {collapsed ? (\n   187→          <ChevronDownIcon className=\"w-5 h-5 text-zinc-400\" />\n   188→        ) : (\n   189→          <ChevronUpIcon className=\"w-5 h-5 text-zinc-400\" />\n   190→        )}\n   191→      </button>\n   192→\n   193→      {!collapsed && (\n   194→        <div className=\"p-4 pt-0 space-y-3\">\n   195→          {/* Overlay URL with Copy Button */}\n   196→          <div className=\"flex items-center gap-2\">\n   197→            <input\n   198→              type=\"text\"\n   199→              readOnly\n   200→              value={overlayUrl}\n   201→              className=\"flex-1 bg-zinc-900 text-zinc-400 text-xs px-3 py-2 rounded-lg border border-zinc-700 focus:outline-none\"\n   202→            />\n   203→            <button\n   204→              onClick={copyUrl}\n   205→              className=\"p-2 bg-zinc-700 hover:bg-zinc-600 text-zinc-300 rounded-lg transition-colors\"\n   206→              title=\"Copy overlay URL\"\n   207→            >\n   208→              {copiedUrl ? (\n   209→                <CheckIcon className=\"w-4 h-4 text-green-400\" />\n   210→              ) : (\n   211→                <ClipboardIcon className=\"w-4 h-4\" />\n   212→              )}\n   213→            </button>\n   214→          </div>\n   215→\n   216→          {/* On/Off Toggle */}\n   217→          <div className=\"flex items-center justify-between py-2\">\n   218→            <span className=\"text-sm text-zinc-300\">Show Bug</span>\n   219→            <button\n   220→              onClick={toggleEnabled}\n   221→              className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${\n   222→                scoreBugState?.enabled ? 'bg-green-500' : 'bg-zinc-600'\n   223→              }`}\n   224→            >\n   225→              <span\n   226→                className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${\n   227→                  scoreBugState?.enabled ? 'translate-x-6' : 'translate-x-1'\n   228→                }`}\n   229→              />\n   230→            </button>\n   231→          </div>\n   232→\n   233→          {/* Polling Toggle */}\n   234→          <div className=\"flex items-center justify-between py-2\">\n   235→            <span className=\"text-sm text-zinc-300\">API Polling</span>\n   236→            <button\n   237→              onClick={togglePolling}\n   238→              className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${\n   239→                scoreBugState?.polling ? 'bg-blue-500' : 'bg-zinc-600'\n   240→              }`}\n   241→            >\n   242→              <span\n   243→                className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${\n   244→                  scoreBugState?.polling ? 'translate-x-6' : 'translate-x-1'\n   245→                }`}\n   246→              />\n   247→            </button>\n   248→          </div>\n   249→\n   250→          {/* Poll Frequency Selector */}\n   251→          <div className=\"flex items-center justify-between py-2\">\n   252→            <span className=\"text-sm text-zinc-300\">Poll Frequency</span>\n   253→            <select\n   254→              value={scoreBugState?.config?.pollInterval || 5000}\n   255→              onChange={(e) => setPollFrequency(Number(e.target.value))}\n   256→              className=\"bg-zinc-700 text-zinc-200 text-sm px-3 py-1.5 rounded-lg border border-zinc-600 focus:outline-none focus:border-blue-500\"\n   257→            >\n   258→              <option value={2000}>2s</option>\n   259→              <option value={5000}>5s</option>\n   260→              <option value={10000}>10s</option>\n   261→              <option value={30000}>30s</option>\n   262→            </select>\n   263→          </div>\n   264→\n   265→          {/* Heartbeat Indicator */}\n   266→          {scoreBugState?.polling && (\n   267→            <div className=\"flex items-center justify-between py-2\">\n   268→              <span className=\"text-sm text-zinc-300\">Last Poll</span>\n   269→              <HeartbeatIndicator\n   270→                lastPoll={scoreBugState?.status?.lastPoll}\n   271→                pollInterval={scoreBugState?.config?.pollInterval || 5000}\n   272→              />\n   273→            </div>\n   274→          )}\n   275→\n   276→          {/* API Error Indicator (D5b) */}\n   277→          {scoreBugState?.status?.error && (\n   278→            <div className=\"bg-red-500/10 border border-red-500/30 rounded-lg px-3 py-2\">\n   279→              <div className=\"flex items-center gap-2\">\n   280→                <ExclamationTriangleIcon className=\"w-4 h-4 text-red-400 flex-shrink-0\" />\n   281→                <span className=\"text-sm text-red-400 font-medium\">API Error</span>\n   282→              </div>\n   283→              <p className=\"text-xs text-red-300/80 mt-1 ml-6\">\n   284→                {scoreBugState.status.error.message || 'Unknown error'}\n   285→              </p>\n   286→              {scoreBugState.status.error.retryIn && (\n   287→                <p className=\"text-xs text-red-300/60 mt-0.5 ml-6\">\n   288→                  Retrying in {Math.ceil(scoreBugState.status.error.retryIn / 1000)}s\n   289→                </p>\n   290→              )}\n   291→            </div>\n   292→          )}\n   293→\n   294→          {/* Automation Mode Toggle */}\n   295→          <div className=\"flex items-center justify-between py-2\">\n   296→            <span className=\"text-sm text-zinc-300\">Now Competing</span>\n   297→            <div className=\"flex items-center gap-2\">\n   298→              <span className={`text-xs ${\n   299→                (scoreBugState?.config?.automationMode || 'auto') === 'auto'\n   300→                  ? 'text-zinc-500'\n   301→                  : 'text-purple-400 font-medium'\n   302→              }`}>\n   303→                MANUAL\n   304→              </span>\n   305→              <button\n   306→                onClick={toggleAutomationMode}\n   307→                className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${\n   308→                  (scoreBugState?.config?.automationMode || 'auto') === 'auto'\n   309→                    ? 'bg-purple-500'\n   310→                    : 'bg-zinc-600'\n   311→                }`}\n   312→              >\n   313→                <span\n   314→                  className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${\n   315→                    (scoreBugState?.config?.automationMode || 'auto') === 'auto'\n   316→                      ? 'translate-x-6'\n   317→                      : 'translate-x-1'\n   318→                  }`}\n   319→                />\n   320→              </button>\n   321→              <span className={`text-xs ${\n   322→                (scoreBugState?.config?.automationMode || 'auto') === 'auto'\n   323→                  ? 'text-purple-400 font-medium'\n   324→                  : 'text-zinc-500'\n   325→              }`}>\n   326→                AUTO\n   327→              </span>\n   328→            </div>\n   329→          </div>\n   330→\n   331→          {/* Now Competing Display (D5) - shown when detected athletes exist */}\n   332→          {scoreBugState?.detected?.nowCompeting?.length > 0 && (\n   333→            <div className=\"pt-2 border-t border-zinc-700\">\n   334→              <div className=\"text-xs text-zinc-400 mb-2\">Detected Now Competing:</div>\n   335→              <div className=\"space-y-2\">\n   336→                {scoreBugState.detected.nowCompeting.map((nc, idx) => (\n   337→                  <div\n   338→                    key={`${nc.teamIndex}-${idx}`}\n   339→                    className=\"flex items-center justify-between bg-zinc-900/50 rounded-lg px-3 py-2\"\n   340→                  >\n   341→                    <div className=\"flex items-center gap-2\">\n   342→                      <span className=\"text-xs font-bold text-purple-400 bg-purple-500/20 px-1.5 py-0.5 rounded\">\n   343→                        {nc.tricode}\n   344→                      </span>\n   345→                      <span className=\"text-sm text-zinc-200\">{nc.athlete?.name}</span>\n   346→                    </div>\n   347→                    <span className=\"text-xs text-zinc-400\">{nc.eventName}</span>\n   348→                  </div>\n   349→                ))}\n   350→              </div>\n   351→            </div>\n   352→          )}\n   353→        </div>\n   354→      )}\n   355→    </div>\n   356→  );\n   357→}\n   358→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"af9e7b0b-717a-4523-8596-08397b416ec3","uuid":"211b1c80-b864-4cc6-8a10-217321a912c4","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/components/ScoreBugPanel.jsx","content":"import { useState, useEffect, useMemo } from 'react';\nimport { db, ref, onValue, set } from '../lib/firebase';\nimport {\n  ChartBarIcon,\n  ChevronDownIcon,\n  ChevronUpIcon,\n  ClipboardIcon,\n  CheckIcon,\n  ExclamationTriangleIcon\n} from '@heroicons/react/24/solid';\n\n/**\n * HeartbeatIndicator - Shows last poll time with status indicator\n *\n * States:\n * - Recent (green): within 2x poll interval - normal operation\n * - Warning (yellow): 2x-5x poll interval - delayed but not critical\n * - Stale (red): beyond 5x poll interval - data may be outdated\n */\nfunction HeartbeatIndicator({ lastPoll, pollInterval }) {\n  const [now, setNow] = useState(Date.now());\n\n  // Update \"now\" every second to keep relative time fresh\n  useEffect(() => {\n    const interval = setInterval(() => setNow(Date.now()), 1000);\n    return () => clearInterval(interval);\n  }, []);\n\n  const { timeAgo, status } = useMemo(() => {\n    if (!lastPoll) return { timeAgo: 'never', status: 'stale' };\n    const seconds = Math.floor((now - lastPoll) / 1000);\n    const intervalSec = pollInterval / 1000;\n\n    // Determine status based on multiples of poll interval\n    let status;\n    if (seconds < intervalSec * 2) {\n      status = 'recent';\n    } else if (seconds < intervalSec * 5) {\n      status = 'warning';\n    } else {\n      status = 'stale';\n    }\n\n    return {\n      timeAgo: seconds < 60 ? `${seconds}s ago` : `${Math.floor(seconds / 60)}m ago`,\n      status\n    };\n  }, [lastPoll, now, pollInterval]);\n\n  const dotClass = {\n    recent: 'bg-green-500 animate-pulse',\n    warning: 'bg-yellow-500',\n    stale: 'bg-red-500'\n  }[status];\n\n  const textClass = {\n    recent: 'text-green-400',\n    warning: 'text-yellow-400',\n    stale: 'text-red-400'\n  }[status];\n\n  return (\n    <div className=\"flex items-center gap-2\">\n      <span className={`w-2 h-2 rounded-full ${dotClass}`} />\n      <span className={`text-sm ${textClass}`}>\n        {timeAgo}\n      </span>\n      {status === 'stale' && (\n        <span className=\"px-1.5 py-0.5 bg-red-500/20 text-red-400 text-xs rounded font-medium\">\n          STALE\n        </span>\n      )}\n    </div>\n  );\n}\n\n/**\n * ScoreBugPanel - Control panel for team scores bug overlay\n *\n * @param {string} compId - Competition ID\n * @param {boolean} collapsed - Initial collapsed state\n */\nexport default function ScoreBugPanel({\n  compId,\n  collapsed: initialCollapsed = true\n}) {\n  const [collapsed, setCollapsed] = useState(initialCollapsed);\n  const [scoreBugState, setScoreBugState] = useState(null);\n  const [copiedUrl, setCopiedUrl] = useState(false);\n\n  // Generate overlay URL\n  const overlayUrl = compId\n    ? `${window.location.origin}/overlays/team-bug.html?compId=${compId}`\n    : '';\n\n  // Copy URL to clipboard\n  const copyUrl = () => {\n    navigator.clipboard.writeText(overlayUrl);\n    setCopiedUrl(true);\n    setTimeout(() => setCopiedUrl(false), 2000);\n  };\n\n  // Toggle enabled state\n  const toggleEnabled = () => {\n    const newState = !scoreBugState?.enabled;\n    set(ref(db, `competitions/${compId}/scoreBug/enabled`), newState);\n  };\n\n  // Toggle polling state\n  const togglePolling = () => {\n    const newState = !scoreBugState?.polling;\n    set(ref(db, `competitions/${compId}/scoreBug/polling`), newState);\n  };\n\n  // Set poll frequency\n  const setPollFrequency = (frequency) => {\n    set(ref(db, `competitions/${compId}/scoreBug/config/pollInterval`), frequency);\n  };\n\n  // Toggle automation mode (auto/manual)\n  const toggleAutomationMode = () => {\n    const currentMode = scoreBugState?.config?.automationMode || 'auto';\n    const newMode = currentMode === 'auto' ? 'manual' : 'auto';\n    set(ref(db, `competitions/${compId}/scoreBug/config/automationMode`), newMode);\n  };\n\n  // Listen to scoreBug state from Firebase\n  useEffect(() => {\n    if (!compId) return;\n\n    const scoreBugRef = ref(db, `competitions/${compId}/scoreBug`);\n    const unsubscribe = onValue(scoreBugRef, (snapshot) => {\n      setScoreBugState(snapshot.val() || {});\n    });\n\n    return () => unsubscribe();\n  }, [compId]);\n\n  // Empty state - no competition selected\n  if (!compId) {\n    return (\n      <div className=\"bg-zinc-800 rounded-xl p-4\">\n        <div className=\"flex items-center gap-2 text-zinc-400\">\n          <ChartBarIcon className=\"w-5 h-5\" />\n          <span className=\"font-medium\">Score Bug</span>\n        </div>\n        <div className=\"text-center py-4 text-zinc-500 text-sm\">\n          Select a competition\n        </div>\n      </div>\n    );\n  }\n\n  // Loading state\n  if (scoreBugState === null) {\n    return (\n      <div className=\"bg-zinc-800 rounded-xl p-4\">\n        <div className=\"flex items-center gap-2 text-zinc-400\">\n          <ChartBarIcon className=\"w-5 h-5\" />\n          <span className=\"font-medium\">Score Bug</span>\n        </div>\n        <div className=\"text-center py-4 text-zinc-500 text-sm\">\n          Loading...\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"bg-zinc-800 rounded-xl overflow-hidden\">\n      {/* Header */}\n      <button\n        onClick={() => setCollapsed(!collapsed)}\n        className=\"w-full flex items-center justify-between px-4 py-3 bg-zinc-800 hover:bg-zinc-700/50 transition-colors\"\n      >\n        <div className=\"flex items-center gap-2\">\n          <ChartBarIcon className=\"w-5 h-5 text-zinc-400\" />\n          <span className=\"font-medium text-white\">Score Bug</span>\n          {/* Status indicator */}\n          {scoreBugState.enabled && (\n            <span className=\"px-2 py-0.5 bg-green-500/20 text-green-400 text-xs rounded-full\">\n              ON\n            </span>\n          )}\n        </div>\n        {collapsed ? (\n          <ChevronDownIcon className=\"w-5 h-5 text-zinc-400\" />\n        ) : (\n          <ChevronUpIcon className=\"w-5 h-5 text-zinc-400\" />\n        )}\n      </button>\n\n      {!collapsed && (\n        <div className=\"p-4 pt-0 space-y-3\">\n          {/* Overlay URL with Copy Button */}\n          <div className=\"flex items-center gap-2\">\n            <input\n              type=\"text\"\n              readOnly\n              value={overlayUrl}\n              className=\"flex-1 bg-zinc-900 text-zinc-400 text-xs px-3 py-2 rounded-lg border border-zinc-700 focus:outline-none\"\n            />\n            <button\n              onClick={copyUrl}\n              className=\"p-2 bg-zinc-700 hover:bg-zinc-600 text-zinc-300 rounded-lg transition-colors\"\n              title=\"Copy overlay URL\"\n            >\n              {copiedUrl ? (\n                <CheckIcon className=\"w-4 h-4 text-green-400\" />\n              ) : (\n                <ClipboardIcon className=\"w-4 h-4\" />\n              )}\n            </button>\n          </div>\n\n          {/* On/Off Toggle */}\n          <div className=\"flex items-center justify-between py-2\">\n            <span className=\"text-sm text-zinc-300\">Show Bug</span>\n            <button\n              onClick={toggleEnabled}\n              className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${\n                scoreBugState?.enabled ? 'bg-green-500' : 'bg-zinc-600'\n              }`}\n            >\n              <span\n                className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${\n                  scoreBugState?.enabled ? 'translate-x-6' : 'translate-x-1'\n                }`}\n              />\n            </button>\n          </div>\n\n          {/* Polling Toggle */}\n          <div className=\"flex items-center justify-between py-2\">\n            <span className=\"text-sm text-zinc-300\">API Polling</span>\n            <button\n              onClick={togglePolling}\n              className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${\n                scoreBugState?.polling ? 'bg-blue-500' : 'bg-zinc-600'\n              }`}\n            >\n              <span\n                className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${\n                  scoreBugState?.polling ? 'translate-x-6' : 'translate-x-1'\n                }`}\n              />\n            </button>\n          </div>\n\n          {/* Poll Frequency Selector */}\n          <div className=\"flex items-center justify-between py-2\">\n            <span className=\"text-sm text-zinc-300\">Poll Frequency</span>\n            <select\n              value={scoreBugState?.config?.pollInterval || 5000}\n              onChange={(e) => setPollFrequency(Number(e.target.value))}\n              className=\"bg-zinc-700 text-zinc-200 text-sm px-3 py-1.5 rounded-lg border border-zinc-600 focus:outline-none focus:border-blue-500\"\n            >\n              <option value={2000}>2s</option>\n              <option value={5000}>5s</option>\n              <option value={10000}>10s</option>\n              <option value={30000}>30s</option>\n            </select>\n          </div>\n\n          {/* Heartbeat Indicator */}\n          {scoreBugState?.polling && (\n            <div className=\"flex items-center justify-between py-2\">\n              <span className=\"text-sm text-zinc-300\">Last Poll</span>\n              <HeartbeatIndicator\n                lastPoll={scoreBugState?.status?.lastPoll}\n                pollInterval={scoreBugState?.config?.pollInterval || 5000}\n              />\n            </div>\n          )}\n\n          {/* API Error Indicator (D5b) */}\n          {scoreBugState?.status?.error && (\n            <div className=\"bg-red-500/10 border border-red-500/30 rounded-lg px-3 py-2\">\n              <div className=\"flex items-center gap-2\">\n                <ExclamationTriangleIcon className=\"w-4 h-4 text-red-400 flex-shrink-0\" />\n                <span className=\"text-sm text-red-400 font-medium\">API Error</span>\n              </div>\n              <p className=\"text-xs text-red-300/80 mt-1 ml-6\">\n                {scoreBugState.status.error.message || 'Unknown error'}\n              </p>\n              {scoreBugState.status.error.retryIn && (\n                <p className=\"text-xs text-red-300/60 mt-0.5 ml-6\">\n                  Retrying in {Math.ceil(scoreBugState.status.error.retryIn / 1000)}s\n                </p>\n              )}\n            </div>\n          )}\n\n          {/* Automation Mode Toggle */}\n          <div className=\"flex items-center justify-between py-2\">\n            <span className=\"text-sm text-zinc-300\">Now Competing</span>\n            <div className=\"flex items-center gap-2\">\n              <span className={`text-xs ${\n                (scoreBugState?.config?.automationMode || 'auto') === 'auto'\n                  ? 'text-zinc-500'\n                  : 'text-purple-400 font-medium'\n              }`}>\n                MANUAL\n              </span>\n              <button\n                onClick={toggleAutomationMode}\n                className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${\n                  (scoreBugState?.config?.automationMode || 'auto') === 'auto'\n                    ? 'bg-purple-500'\n                    : 'bg-zinc-600'\n                }`}\n              >\n                <span\n                  className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${\n                    (scoreBugState?.config?.automationMode || 'auto') === 'auto'\n                      ? 'translate-x-6'\n                      : 'translate-x-1'\n                  }`}\n                />\n              </button>\n              <span className={`text-xs ${\n                (scoreBugState?.config?.automationMode || 'auto') === 'auto'\n                  ? 'text-purple-400 font-medium'\n                  : 'text-zinc-500'\n              }`}>\n                AUTO\n              </span>\n            </div>\n          </div>\n\n          {/* Now Competing Display (D5) - shown when detected athletes exist */}\n          {scoreBugState?.detected?.nowCompeting?.length > 0 && (\n            <div className=\"pt-2 border-t border-zinc-700\">\n              <div className=\"text-xs text-zinc-400 mb-2\">Detected Now Competing:</div>\n              <div className=\"space-y-2\">\n                {scoreBugState.detected.nowCompeting.map((nc, idx) => (\n                  <div\n                    key={`${nc.teamIndex}-${idx}`}\n                    className=\"flex items-center justify-between bg-zinc-900/50 rounded-lg px-3 py-2\"\n                  >\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-xs font-bold text-purple-400 bg-purple-500/20 px-1.5 py-0.5 rounded\">\n                        {nc.tricode}\n                      </span>\n                      <span className=\"text-sm text-zinc-200\">{nc.athlete?.name}</span>\n                    </div>\n                    <span className=\"text-xs text-zinc-400\">{nc.eventName}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n}\n","numLines":358,"startLine":1,"totalLines":358}}}
