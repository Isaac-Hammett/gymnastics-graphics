{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PdAjaGX9XTbTeNFMPFbFch","type":"tool_result","content":"     1→<!DOCTYPE html>\n     2→<html lang=\"en\">\n     3→<head>\n     4→  <meta charset=\"UTF-8\">\n     5→  <meta name=\"viewport\" content=\"width=1920, height=1080\">\n     6→  <title>Team Score Bug</title>\n     7→  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n     8→\n     9→  <!-- Firebase SDK -->\n    10→  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js\"></script>\n    11→  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js\"></script>\n    12→\n    13→  <style>\n    14→    * { margin: 0; padding: 0; box-sizing: border-box; }\n    15→\n    16→    body {\n    17→      font-family: 'Inter', sans-serif;\n    18→      width: 1920px;\n    19→      height: 1080px;\n    20→      overflow: hidden;\n    21→      background: transparent;\n    22→    }\n    23→\n    24→    /* Score bug container - positioned on right side of screen */\n    25→    .score-bug {\n    26→      position: absolute;\n    27→      top: 50%;\n    28→      right: 0;\n    29→      transform: translateY(-50%) translateX(100%);\n    30→      display: flex;\n    31→      flex-direction: column;\n    32→      min-width: 500px;\n    33→      opacity: 0;\n    34→      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n    35→    }\n    36→\n    37→    .score-bug.visible {\n    38→      transform: translateY(-50%) translateX(0);\n    39→      opacity: 1;\n    40→    }\n    41→\n    42→    /* Rotation tag at top */\n    43→    .rotation-tag {\n    44→      background: #27272a;\n    45→      color: #fff;\n    46→      font-size: 20px;\n    47→      font-weight: 700;\n    48→      padding: 10px 20px;\n    49→      text-transform: uppercase;\n    50→      letter-spacing: 0.5px;\n    51→    }\n    52→\n    53→    /* Team rows container */\n    54→    .team-rows {\n    55→      display: flex;\n    56→      flex-direction: column;\n    57→    }\n    58→\n    59→    /* Individual team row */\n    60→    .team-row {\n    61→      display: flex;\n    62→      flex-direction: row;\n    63→      background: #1a1a1a;\n    64→      border-bottom: 1px solid #333;\n    65→      min-height: 70px;\n    66→    }\n    67→\n    68→    .team-row:last-child {\n    69→      border-bottom: none;\n    70→    }\n    71→\n    72→    /* Fixed left section: logo + total */\n    73→    .team-fixed {\n    74→      display: flex;\n    75→      flex-direction: column;\n    76→      align-items: center;\n    77→      justify-content: center;\n    78→      padding: 10px 15px;\n    79→      min-width: 100px;\n    80→      background: #000;\n    81→    }\n    82→\n    83→    .team-logo {\n    84→      width: 40px;\n    85→      height: 40px;\n    86→      object-fit: contain;\n    87→    }\n    88→\n    89→    .team-total {\n    90→      font-size: 22px;\n    91→      font-weight: 900;\n    92→      color: #fff;\n    93→      margin-top: 4px;\n    94→    }\n    95→\n    96→    .team-total.highlight {\n    97→      animation: totalPulse 0.5s ease;\n    98→    }\n    99→\n   100→    @keyframes totalPulse {\n   101→      0%, 100% { transform: scale(1); color: #fff; }\n   102→      50% { transform: scale(1.1); color: #22d3ee; }\n   103→    }\n   104→\n   105→    /* Slot area for score flash / now competing */\n   106→    .team-slot {\n   107→      flex: 1;\n   108→      display: flex;\n   109→      align-items: center;\n   110→      padding: 10px 20px;\n   111→      overflow: hidden;\n   112→      position: relative;\n   113→    }\n   114→\n   115→    /* Slot content (animates up/down) */\n   116→    .slot-content {\n   117→      display: flex;\n   118→      align-items: center;\n   119→      gap: 12px;\n   120→      transform: translateY(0);\n   121→      transition: transform 0.4s ease, opacity 0.4s ease;\n   122→      opacity: 0;\n   123→    }\n   124→\n   125→    .slot-content.visible {\n   126→      opacity: 1;\n   127→    }\n   128→\n   129→    .slot-content.exit-up {\n   130→      transform: translateY(-100%);\n   131→      opacity: 0;\n   132→    }\n   133→\n   134→    .slot-content.enter-from-below {\n   135→      transform: translateY(100%);\n   136→      opacity: 0;\n   137→    }\n   138→\n   139→    /* Headshot in slot */\n   140→    .slot-headshot {\n   141→      width: 36px;\n   142→      height: 36px;\n   143→      border-radius: 50%;\n   144→      object-fit: cover;\n   145→      flex-shrink: 0;\n   146→    }\n   147→\n   148→    /* Athlete name in slot */\n   149→    .slot-name {\n   150→      font-size: 24px;\n   151→      font-weight: 700;\n   152→      color: #fff;\n   153→      white-space: nowrap;\n   154→    }\n   155→\n   156→    /* Score in slot */\n   157→    .slot-score {\n   158→      font-size: 28px;\n   159→      font-weight: 900;\n   160→      color: #fff;\n   161→    }\n   162→\n   163→    /* Apparatus code */\n   164→    .slot-apparatus {\n   165→      font-size: 18px;\n   166→      font-weight: 600;\n   167→      color: #a1a1aa;\n   168→      text-transform: uppercase;\n   169→    }\n   170→\n   171→    /* Start value */\n   172→    .slot-sv {\n   173→      font-size: 16px;\n   174→      font-weight: 400;\n   175→      color: #71717a;\n   176→    }\n   177→\n   178→    /* Stick indicator */\n   179→    .slot-stick {\n   180→      width: 24px;\n   181→      height: 24px;\n   182→      border-radius: 50%;\n   183→      background: #22c55e;\n   184→      color: #fff;\n   185→      font-size: 14px;\n   186→      font-weight: 700;\n   187→      display: flex;\n   188→      align-items: center;\n   189→      justify-content: center;\n   190→    }\n   191→\n   192→    /* Separator dot */\n   193→    .slot-separator {\n   194→      color: #52525b;\n   195→      font-size: 20px;\n   196→    }\n   197→\n   198→    /* Lineup card (above bug) */\n   199→    .lineup-card {\n   200→      position: absolute;\n   201→      bottom: 100%;\n   202→      right: 0;\n   203→      width: 100%;\n   204→      background: #1a1a1a;\n   205→      transform: translateY(100%);\n   206→      opacity: 0;\n   207→      transition: transform 0.4s ease, opacity 0.4s ease;\n   208→      margin-bottom: 8px;\n   209→    }\n   210→\n   211→    .lineup-card.visible {\n   212→      transform: translateY(0);\n   213→      opacity: 1;\n   214→    }\n   215→\n   216→    .lineup-header {\n   217→      display: flex;\n   218→      justify-content: space-between;\n   219→      align-items: center;\n   220→      padding: 12px 20px;\n   221→      background: #27272a;\n   222→    }\n   223→\n   224→    .lineup-team-name {\n   225→      font-size: 22px;\n   226→      font-weight: 800;\n   227→      color: #fff;\n   228→      text-transform: uppercase;\n   229→    }\n   230→\n   231→    .lineup-logo {\n   232→      width: 32px;\n   233→      height: 32px;\n   234→      object-fit: contain;\n   235→    }\n   236→\n   237→    .lineup-athletes {\n   238→      padding: 8px 0;\n   239→    }\n   240→\n   241→    .lineup-athlete {\n   242→      display: flex;\n   243→      align-items: center;\n   244→      padding: 8px 20px;\n   245→      gap: 12px;\n   246→    }\n   247→\n   248→    .lineup-order {\n   249→      font-size: 16px;\n   250→      font-weight: 600;\n   251→      color: #71717a;\n   252→      min-width: 24px;\n   253→    }\n   254→\n   255→    .lineup-name {\n   256→      flex: 1;\n   257→      font-size: 20px;\n   258→      font-weight: 600;\n   259→      color: #fff;\n   260→    }\n   261→\n   262→    .lineup-sv {\n   263→      font-size: 16px;\n   264→      font-weight: 400;\n   265→      color: #71717a;\n   266→      min-width: 40px;\n   267→      text-align: right;\n   268→    }\n   269→\n   270→    .lineup-score {\n   271→      font-size: 22px;\n   272→      font-weight: 700;\n   273→      color: #fff;\n   274→      min-width: 70px;\n   275→      text-align: right;\n   276→    }\n   277→\n   278→    .lineup-score.pending {\n   279→      color: #52525b;\n   280→    }\n   281→\n   282→    .lineup-footer {\n   283→      display: flex;\n   284→      justify-content: space-between;\n   285→      align-items: center;\n   286→      padding: 12px 20px;\n   287→      background: #27272a;\n   288→    }\n   289→\n   290→    .lineup-event {\n   291→      font-size: 18px;\n   292→      font-weight: 600;\n   293→      color: #a1a1aa;\n   294→      text-transform: uppercase;\n   295→    }\n   296→\n   297→    .lineup-total {\n   298→      font-size: 26px;\n   299→      font-weight: 800;\n   300→      color: #fff;\n   301→    }\n   302→\n   303→    /* Loading / error states */\n   304→    .loading-state {\n   305→      color: #71717a;\n   306→      font-size: 18px;\n   307→      padding: 20px;\n   308→      text-align: center;\n   309→    }\n   310→\n   311→    .error-state {\n   312→      color: #ef4444;\n   313→      font-size: 18px;\n   314→      padding: 20px;\n   315→      text-align: center;\n   316→    }\n   317→  </style>\n   318→</head>\n   319→<body>\n   320→  <div class=\"score-bug\" id=\"scoreBug\">\n   321→    <div class=\"lineup-card\" id=\"lineupCard\">\n   322→      <!-- Lineup card content populated dynamically -->\n   323→    </div>\n   324→    <div class=\"rotation-tag\" id=\"rotationTag\">Rotation 1 of 6</div>\n   325→    <div class=\"team-rows\" id=\"teamRows\">\n   326→      <!-- Team rows populated dynamically -->\n   327→    </div>\n   328→  </div>\n   329→\n   330→  <script>\n   331→    // Firebase configuration\n   332→    const firebaseConfig = {\n   333→      apiKey: \"AIzaSyCh0aZUvKl6Qvqsva3hvOgJJlleP1OwcTY\",\n   334→      authDomain: \"gymnastics-graphics.firebaseapp.com\",\n   335→      databaseURL: \"https://gymnastics-graphics-default-rtdb.firebaseio.com\",\n   336→      projectId: \"gymnastics-graphics\",\n   337→      storageBucket: \"gymnastics-graphics.firebasestorage.app\",\n   338→      messagingSenderId: \"702072609550\",\n   339→      appId: \"1:702072609550:web:ac74a811186d3ff45b955f\"\n   340→    };\n   341→\n   342→    // Initialize Firebase\n   343→    firebase.initializeApp(firebaseConfig);\n   344→    const db = firebase.database();\n   345→\n   346→    // Parse URL parameters\n   347→    const params = new URLSearchParams(window.location.search);\n   348→    const compId = params.get('compId');\n   349→\n   350→    if (!compId) {\n   351→      console.error('Missing compId parameter');\n   352→      document.body.innerHTML = '<div class=\"error-state\">Missing compId parameter</div>';\n   353→    }\n   354→\n   355→    // State management\n   356→    const state = {\n   357→      enabled: false,\n   358→      polling: false,\n   359→      automationMode: 'auto',\n   360→      showLineup: null,\n   361→      teams: [],\n   362→      rotation: { current: 1, total: 6, isFinal: false },\n   363→      previousScores: {},        // { \"gymnast_id\": \"finalScore\" (string) }\n   364→      previousTeamTotals: {},    // { \"teamKey\": \"finalScore\" (string) }\n   365→      flashQueues: {},           // Per-team flash queues\n   366→      activeFlashes: {},         // Currently active flashes per team\n   367→      pollInterval: 5000,\n   368→      flashDuration: 10000,\n   369→      stalePollCount: 0,         // Consecutive polls with no data changes\n   370→      // Competition config (loaded from Firebase)\n   371→      competitionConfig: null,\n   372→      virtiusSessionId: null,\n   373→      gender: 'mens',\n   374→      // Error handling state (A3c)\n   375→      consecutiveErrors: 0,      // Count of consecutive poll failures\n   376→      lastError: null,           // Last error message\n   377→      lastErrorTime: null,       // Timestamp of last error\n   378→      maxBackoffMs: 60000,       // Max backoff delay (60 seconds)\n   379→      // Offline/reconnect state (A3d)\n   380→      firebaseConnected: true,   // Firebase connection state\n   381→      pendingWrites: [],         // Writes queued during offline\n   382→      reconnectAttempts: 0       // Count of reconnect attempts\n   383→    };\n   384→\n   385→    /**\n   386→     * Normalize athlete name for lookup (lowercase, remove special chars).\n   387→     * Matches pattern used in output.html for headshot lookups.\n   388→     */\n   389→    function normalizeName(name) {\n   390→      if (!name) return '';\n   391→      return name.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');\n   392→    }\n   393→\n   394→    // Firebase paths\n   395→    const scoreBugRef = db.ref(`competitions/${compId}/scoreBug`);\n   396→    const configRef = db.ref(`competitions/${compId}/config`);\n   397→    const connectedRef = db.ref('.info/connected');\n   398→\n   399→    /**\n   400→     * Initialize Firebase connection monitoring (A3d).\n   401→     * Detects offline/online state and handles reconnection.\n   402→     */\n   403→    function initConnectionMonitor() {\n   404→      connectedRef.on('value', (snapshot) => {\n   405→        const connected = snapshot.val() === true;\n   406→        const wasConnected = state.firebaseConnected;\n   407→        state.firebaseConnected = connected;\n   408→\n   409→        if (connected && !wasConnected) {\n   410→          // Just reconnected\n   411→          console.log('Firebase connected - processing pending writes');\n   412→          state.reconnectAttempts = 0;\n   413→          processPendingWrites();\n   414→\n   415→          // Write reconnect event to Firebase\n   416→          scoreBugRef.child('connectionStatus').set({\n   417→            connected: true,\n   418→            reconnectedAt: Date.now(),\n   419→            pendingWritesProcessed: state.pendingWrites.length\n   420→          });\n   421→        } else if (!connected && wasConnected) {\n   422→          // Just went offline\n   423→          console.warn('Firebase disconnected - writes will be queued');\n   424→          state.reconnectAttempts++;\n   425→\n   426→          // Note: Firebase SDK has offline persistence by default\n   427→          // Writes are automatically queued and synced on reconnect\n   428→        }\n   429→\n   430→        console.log('Firebase connection state:', connected ? 'ONLINE' : 'OFFLINE');\n   431→      });\n   432→    }\n   433→\n   434→    /**\n   435→     * Process any pending writes that were queued during offline.\n   436→     * Firebase SDK handles this automatically, but we log for visibility.\n   437→     */\n   438→    function processPendingWrites() {\n   439→      if (state.pendingWrites.length === 0) return;\n   440→\n   441→      console.log('Processing', state.pendingWrites.length, 'pending writes');\n   442→\n   443→      // Firebase SDK automatically syncs queued writes\n   444→      // Clear our tracking array\n   445→      state.pendingWrites = [];\n   446→    }\n   447→\n   448→    /**\n   449→     * Safe write to Firebase with offline queueing (A3d).\n   450→     * Wraps Firebase write operations to track pending writes during offline.\n   451→     * @param {firebase.database.Reference} ref - Firebase reference\n   452→     * @param {string} method - 'set', 'update', or 'remove'\n   453→     * @param {*} data - Data to write (for set/update)\n   454→     * @returns {Promise}\n   455→     */\n   456→    async function safeWrite(ref, method, data) {\n   457→      const writeOp = { path: ref.toString(), method, data, timestamp: Date.now() };\n   458→\n   459→      if (!state.firebaseConnected) {\n   460→        // Queue the write for tracking (Firebase SDK queues automatically)\n   461→        state.pendingWrites.push(writeOp);\n   462→        console.log('Queued offline write:', writeOp.path, method);\n   463→      }\n   464→\n   465→      try {\n   466→        if (method === 'set') {\n   467→          await ref.set(data);\n   468→        } else if (method === 'update') {\n   469→          await ref.update(data);\n   470→        } else if (method === 'remove') {\n   471→          await ref.remove();\n   472→        }\n   473→        return true;\n   474→      } catch (err) {\n   475→        // Firebase SDK will retry on reconnect\n   476→        console.error('Write failed (will retry on reconnect):', err.message);\n   477→        if (!state.pendingWrites.includes(writeOp)) {\n   478→          state.pendingWrites.push(writeOp);\n   479→        }\n   480→        return false;\n   481→      }\n   482→    }\n   483→\n   484→    /**\n   485→     * Load competition config from Firebase.\n   486→     * Gets virtiusSessionId, team names/logos, gender, and compType.\n   487→     * Must be called before initializing Firebase listeners.\n   488→     */\n   489→    async function loadCompetitionConfig() {\n   490→      try {\n   491→        const snapshot = await configRef.once('value');\n   492→        const config = snapshot.val();\n   493→\n   494→        if (!config) {\n   495→          console.error('No competition config found for compId:', compId);\n   496→          document.body.innerHTML = '<div class=\"error-state\">Competition not found</div>';\n   497→          return false;\n   498→        }\n   499→\n   500→        state.competitionConfig = config;\n   501→        state.virtiusSessionId = config.virtiusSessionId || null;\n   502→        state.gender = config.gender || 'mens';\n   503→\n   504→        // Build teams array from config (up to 6 teams)\n   505→        state.teams = [];\n   506→        for (let i = 1; i <= 6; i++) {\n   507→          const teamName = config[`team${i}Name`];\n   508→          if (teamName) {\n   509→            state.teams.push({\n   510→              index: i,\n   511→              name: teamName,\n   512→              logo: config[`team${i}Logo`] || '',\n   513→              tricode: config[`team${i}Tricode`] || '',\n   514→              total: '--'  // Initial state before first API poll\n   515→            });\n   516→          }\n   517→        }\n   518→\n   519→        // Determine total rotations based on gender (6 for men, 4 for women)\n   520→        state.rotation.total = state.gender === 'womens' ? 4 : 6;\n   521→\n   522→        console.log('Competition config loaded:', {\n   523→          compId,\n   524→          virtiusSessionId: state.virtiusSessionId,\n   525→          gender: state.gender,\n   526→          teamCount: state.teams.length,\n   527→          teams: state.teams.map(t => t.name)\n   528→        });\n   529→\n   530→        // Check if Virtius session ID is configured\n   531→        if (!state.virtiusSessionId) {\n   532→          console.warn('No Virtius session ID configured - API polling will not work');\n   533→        }\n   534→\n   535→        return true;\n   536→      } catch (err) {\n   537→        console.error('Failed to load competition config:', err);\n   538→        document.body.innerHTML = '<div class=\"error-state\">Failed to load competition config</div>';\n   539→        return false;\n   540→      }\n   541→    }\n   542→\n   543→    /**\n   544→     * Render initial team rows based on competition config.\n   545→     * Called after loadCompetitionConfig() to show teams before API polling starts.\n   546→     */\n   547→    function renderTeamRows() {\n   548→      const container = document.getElementById('teamRows');\n   549→      if (!container) return;\n   550→\n   551→      container.innerHTML = state.teams.map((team, idx) => `\n   552→        <div class=\"team-row\" data-team-index=\"${team.index}\">\n   553→          <div class=\"team-fixed\">\n   554→            <img class=\"team-logo\" src=\"${team.logo}\" alt=\"${team.name}\" onerror=\"this.style.display='none'\">\n   555→            <div class=\"team-total\" id=\"teamTotal${team.index}\">${team.total}</div>\n   556→          </div>\n   557→          <div class=\"team-slot\" id=\"teamSlot${team.index}\">\n   558→            <div class=\"slot-content\" id=\"slotContent${team.index}\">\n   559→              <!-- Score flash / now competing content populated dynamically -->\n   560→            </div>\n   561→          </div>\n   562→        </div>\n   563→      `).join('');\n   564→\n   565→      console.log('Team rows rendered:', state.teams.length);\n   566→    }\n   567→\n   568→    /**\n   569→     * Update team total display element (A4).\n   570→     * Called when API polling detects a change in team.final_score.\n   571→     * Adds highlight animation on value change.\n   572→     * @param {number} teamIndex - 1-based team index\n   573→     * @param {string} newTotal - Formatted score string (e.g., \"196.450\")\n   574→     */\n   575→    function updateTeamTotal(teamIndex, newTotal) {\n   576→      const totalEl = document.getElementById(`teamTotal${teamIndex}`);\n   577→      if (!totalEl) return;\n   578→\n   579→      const prevTotal = totalEl.textContent;\n   580→\n   581→      // Only update if value changed\n   582→      if (prevTotal === newTotal) return;\n   583→\n   584→      totalEl.textContent = newTotal;\n   585→\n   586→      // Trigger highlight animation on change (skip for initial load)\n   587→      if (prevTotal !== '--') {\n   588→        totalEl.classList.remove('highlight');\n   589→        // Force reflow to restart animation\n   590→        void totalEl.offsetWidth;\n   591→        totalEl.classList.add('highlight');\n   592→      }\n   593→    }\n   594→\n   595→    /**\n   596→     * Update all team totals from state (A4).\n   597→     * Called after API poll updates state.teams[].total values.\n   598→     */\n   599→    function updateAllTeamTotals() {\n   600→      state.teams.forEach((team) => {\n   601→        updateTeamTotal(team.index, team.total);\n   602→      });\n   603→    }\n   604→\n   605→    // Initialize Firebase listeners\n   606→    function initFirebaseListeners() {\n   607→      // Listen for enabled state\n   608→      scoreBugRef.child('enabled').on('value', (snapshot) => {\n   609→        state.enabled = snapshot.val() === true;\n   610→        updateBugVisibility();\n   611→      });\n   612→\n   613→      // Listen for polling state\n   614→      scoreBugRef.child('polling').on('value', (snapshot) => {\n   615→        const wasPolling = state.polling;\n   616→        state.polling = snapshot.val() === true;\n   617→        if (state.polling && !wasPolling) {\n   618→          startPolling();\n   619→        } else if (!state.polling && wasPolling) {\n   620→          stopPolling();\n   621→        }\n   622→      });\n   623→\n   624→      // Listen for automation mode\n   625→      scoreBugRef.child('automationMode').on('value', (snapshot) => {\n   626→        state.automationMode = snapshot.val() || 'auto';\n   627→      });\n   628→\n   629→      // Listen for lineup card toggle\n   630→      scoreBugRef.child('showLineup').on('value', (snapshot) => {\n   631→        state.showLineup = snapshot.val();\n   632→        updateLineupCard();\n   633→      });\n   634→\n   635→      // Listen for flash dismissals\n   636→      scoreBugRef.child('dismissFlash').on('value', (snapshot) => {\n   637→        const dismissals = snapshot.val() || {};\n   638→        handleFlashDismissals(dismissals);\n   639→      });\n   640→\n   641→      // Listen for poll interval changes - restart polling with new interval\n   642→      scoreBugRef.child('config/pollInterval').on('value', (snapshot) => {\n   643→        const newInterval = snapshot.val() || 5000;\n   644→        const wasPolling = state.polling && pollTimer !== null;\n   645→        state.pollInterval = newInterval;\n   646→\n   647→        // Restart polling with new interval if currently polling\n   648→        if (wasPolling) {\n   649→          console.log('Poll interval changed to', newInterval, 'ms - restarting polling');\n   650→          stopPolling();\n   651→          startPolling();\n   652→        }\n   653→      });\n   654→\n   655→      // Listen for flash duration changes\n   656→      scoreBugRef.child('config/flashDuration').on('value', (snapshot) => {\n   657→        state.flashDuration = snapshot.val() || 10000;\n   658→      });\n   659→\n   660→      console.log('Firebase listeners initialized');\n   661→    }\n   662→\n   663→    // Update bug visibility based on enabled state\n   664→    function updateBugVisibility() {\n   665→      const bugEl = document.getElementById('scoreBug');\n   666→      if (state.enabled) {\n   667→        bugEl.classList.add('visible');\n   668→      } else {\n   669→        bugEl.classList.remove('visible');\n   670→      }\n   671→    }\n   672→\n   673→    // Update lineup card visibility\n   674→    function updateLineupCard() {\n   675→      const cardEl = document.getElementById('lineupCard');\n   676→      if (state.showLineup) {\n   677→        cardEl.classList.add('visible');\n   678→        // TODO: Populate lineup card content (Phase C)\n   679→      } else {\n   680→        cardEl.classList.remove('visible');\n   681→      }\n   682→    }\n   683→\n   684→    // Handle flash dismissals from producer\n   685→    function handleFlashDismissals(dismissals) {\n   686→      // TODO: Implement flash dismissal handling (Task A12c)\n   687→    }\n   688→\n   689→    // Polling management\n   690→    let pollTimer = null;\n   691→\n   692→    function startPolling() {\n   693→      if (pollTimer) return;\n   694→      console.log('Starting API polling');\n   695→      poll();  // Initial poll\n   696→      pollTimer = setInterval(poll, state.pollInterval);\n   697→    }\n   698→\n   699→    function stopPolling() {\n   700→      if (pollTimer) {\n   701→        clearInterval(pollTimer);\n   702→        pollTimer = null;\n   703→        console.log('Stopped API polling');\n   704→      }\n   705→    }\n   706→\n   707→    // Main poll function - fetches data from Virtius API\n   708→    async function poll() {\n   709→      // Check if we have a valid session ID\n   710→      if (!state.virtiusSessionId) {\n   711→        console.warn('No Virtius session ID - skipping poll');\n   712→        return;\n   713→      }\n   714→\n   715→      const pollStartTime = Date.now();\n   716→\n   717→      try {\n   718→        // Fetch from Virtius API\n   719→        const response = await fetch(`https://api.virti.us/session/${state.virtiusSessionId}/json`);\n   720→\n   721→        if (!response.ok) {\n   722→          throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   723→        }\n   724→\n   725→        const data = await response.json();\n   726→\n   727→        // Store raw API data for score diff engine (Task A5)\n   728→        // Extract teams array from meet data\n   729→        const teams = data.meet?.teams || [];\n   730→\n   731→        if (teams.length === 0) {\n   732→          console.warn('No teams found in API response');\n   733→        }\n   734→\n   735→        // Store the latest API data in state\n   736→        state.lastApiData = data;\n   737→        state.lastApiTeams = teams;\n   738→\n   739→        // Extract team totals and update state.teams with actual data\n   740→        // final_score comes as a string from API - convert to float for display\n   741→        teams.forEach((apiTeam, idx) => {\n   742→          // Match API team to our configured teams by index or name\n   743→          const stateTeam = state.teams[idx];\n   744→          if (stateTeam) {\n   745→            // Convert string final_score to formatted number\n   746→            const rawScore = apiTeam.final_score;\n   747→            if (rawScore !== null && rawScore !== undefined) {\n   748→              const numScore = parseFloat(rawScore);\n   749→              stateTeam.total = isNaN(numScore) ? '--' : numScore.toFixed(3);\n   750→            }\n   751→            // Store API team reference for score diff engine\n   752→            stateTeam.apiTeam = apiTeam;\n   753→          }\n   754→        });\n   755→\n   756→        // Write heartbeat to Firebase on successful poll (using safeWrite for offline resilience)\n   757→        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n   758→\n   759→        console.log('Poll successful:', {\n   760→          sessionId: state.virtiusSessionId,\n   761→          teamCount: teams.length,\n   762→          teams: state.teams.map(t => ({ name: t.name, total: t.total }))\n   763→        });\n   764→\n   765→        // Process API data - detect changes and write deltas to Firebase\n   766→        await processApiData(teams, pollStartTime);\n   767→\n   768→        // Update team total displays (A4)\n   769→        updateAllTeamTotals();\n   770→\n   771→      } catch (err) {\n   772→        // Error handling with exponential backoff (A3c)\n   773→        state.consecutiveErrors++;\n   774→        state.lastError = err.message;\n   775→        state.lastErrorTime = pollStartTime;\n   776→\n   777→        // Calculate backoff delay: 5s, 10s, 20s, 40s, 60s (max)\n   778→        const backoffDelay = Math.min(\n   779→          state.pollInterval * Math.pow(2, state.consecutiveErrors - 1),\n   780→          state.maxBackoffMs\n   781→        );\n   782→\n   783→        console.error('Poll failed:', {\n   784→          error: err.message,\n   785→          consecutiveErrors: state.consecutiveErrors,\n   786→          nextRetryIn: `${backoffDelay / 1000}s`\n   787→        });\n   788→\n   789→        // Write error state to Firebase for producer panel visibility (D5b)\n   790→        // Using safeWrite for offline resilience\n   791→        await safeWrite(scoreBugRef.child('apiError'), 'set', {\n   792→          message: err.message,\n   793→          consecutiveErrors: state.consecutiveErrors,\n   794→          timestamp: pollStartTime,\n   795→          nextRetryMs: backoffDelay\n   796→        });\n   797→        // Still write heartbeat to indicate overlay is running\n   798→        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n   799→\n   800→        // Schedule next poll with backoff delay if we're still supposed to be polling\n   801→        if (state.polling && pollTimer) {\n   802→          clearInterval(pollTimer);\n   803→          pollTimer = setTimeout(() => {\n   804→            if (state.polling) {\n   805→              poll();\n   806→              // If poll succeeds, startPolling() will be called to restore normal interval\n   807→            }\n   808→          }, backoffDelay);\n   809→        }\n   810→        return; // Skip normal completion\n   811→      }\n   812→\n   813→      // Success - reset error state\n   814→      if (state.consecutiveErrors > 0) {\n   815→        console.log('Poll recovered after', state.consecutiveErrors, 'consecutive errors');\n   816→        state.consecutiveErrors = 0;\n   817→        state.lastError = null;\n   818→        state.lastErrorTime = null;\n   819→\n   820→        // Clear error state in Firebase\n   821→        await safeWrite(scoreBugRef.child('apiError'), 'remove');\n   822→\n   823→        // Restore normal polling interval (we might be on backoff timeout)\n   824→        if (state.polling && pollTimer) {\n   825→          clearTimeout(pollTimer);\n   826→          clearInterval(pollTimer);\n   827→          pollTimer = setInterval(poll, state.pollInterval);\n   828→        }\n   829→      }\n   830→    }\n   831→\n   832→    /**\n   833→     * Process API data - detect score changes and write incremental deltas to Firebase.\n   834→     * Only writes changed paths, not full data rewrite.\n   835→     * @param {Array} apiTeams - Teams array from Virtius API\n   836→     * @param {number} pollTimestamp - Timestamp of this poll\n   837→     */\n   838→    async function processApiData(apiTeams, pollTimestamp) {\n   839→      const changedPaths = {};\n   840→      let hasChanges = false;\n   841→\n   842→      // Process each team\n   843→      apiTeams.forEach((team, teamIdx) => {\n   844→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n   845→\n   846→        // Check if team total changed\n   847→        const prevTeamTotal = state.previousTeamTotals[teamKey];\n   848→        const currTeamTotal = team.final_score;  // string or null\n   849→\n   850→        if (currTeamTotal !== prevTeamTotal) {\n   851→          changedPaths[`teams/${teamKey}/finalScore`] = currTeamTotal;\n   852→          changedPaths[`teams/${teamKey}/name`] = team.name || teamKey;\n   853→          hasChanges = true;\n   854→        }\n   855→\n   856→        // Process each event's gymnasts for score changes\n   857→        const events = team.events || [];\n   858→        events.forEach((event) => {\n   859→          const eventKey = event.short_name || event.name || 'unknown';\n   860→          const gymnasts = event.gymnasts || [];\n   861→\n   862→          gymnasts.forEach((gymnast) => {\n   863→            // Primary key: gymnast_id. Fallback: teamKey|normalizedName\n   864→            const gymnastKey = gymnast.gymnast_id ||\n   865→              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n   866→\n   867→            const prevScore = state.previousScores[gymnastKey];\n   868→            const currScore = gymnast.final_score;  // string or null\n   869→\n   870→            // Score changed (new score OR corrected score)\n   871→            if (currScore != null && prevScore !== currScore) {\n   872→              // Build gymnast data for Firebase\n   873→              const gymnastData = {\n   874→                name: gymnast.full_name,\n   875→                score: currScore,\n   876→                startValue: gymnast.start_value || null,\n   877→                execution: gymnast.execution || null,\n   878→                difficulty: gymnast.difficulty || null,\n   879→                order: gymnast.order,\n   880→                event: eventKey,\n   881→                team: teamKey,\n   882→                timestamp: pollTimestamp\n   883→              };\n   884→\n   885→              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}`] = gymnastData;\n   886→              hasChanges = true;\n   887→\n   888→              console.log('Score change detected:', {\n   889→                gymnast: gymnast.full_name,\n   890→                event: eventKey,\n   891→                team: teamKey,\n   892→                prev: prevScore,\n   893→                curr: currScore\n   894→              });\n   895→            }\n   896→\n   897→            // Score removed (rare - inquiry pending)\n   898→            if (currScore == null && prevScore != null) {\n   899→              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}/score`] = null;\n   900→              hasChanges = true;\n   901→              console.log('Score removed:', { gymnast: gymnast.full_name, event: eventKey });\n   902→            }\n   903→          });\n   904→        });\n   905→      });\n   906→\n   907→      // Write to Firebase (using safeWrite for offline resilience)\n   908→      if (hasChanges) {\n   909→        // Write changed paths and reset stale counter\n   910→        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n   911→          ...changedPaths,\n   912→          lastDataChangeTimestamp: pollTimestamp,\n   913→          stalePollCount: 0\n   914→        });\n   915→        state.stalePollCount = 0;\n   916→\n   917→        console.log('Wrote incremental deltas to Firebase:', Object.keys(changedPaths).length, 'paths');\n   918→      } else {\n   919→        // No changes - increment stale counter\n   920→        state.stalePollCount++;\n   921→        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n   922→          lastPollTimestamp: pollTimestamp,\n   923→          stalePollCount: state.stalePollCount\n   924→        });\n   925→      }\n   926→\n   927→      // Update previous state for next comparison\n   928→      state.previousScores = buildScoreMap(apiTeams);\n   929→      state.previousTeamTotals = buildTeamTotalMap(apiTeams);\n   930→    }\n   931→\n   932→    /**\n   933→     * Build score map from API teams data.\n   934→     * @returns {Object} Map of gymnastKey -> finalScore (string)\n   935→     */\n   936→    function buildScoreMap(apiTeams) {\n   937→      const map = {};\n   938→      apiTeams.forEach((team, teamIdx) => {\n   939→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n   940→        const events = team.events || [];\n   941→\n   942→        events.forEach((event) => {\n   943→          const gymnasts = event.gymnasts || [];\n   944→          gymnasts.forEach((gymnast) => {\n   945→            const gymnastKey = gymnast.gymnast_id ||\n   946→              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n   947→            map[gymnastKey] = gymnast.final_score;  // string or null\n   948→          });\n   949→        });\n   950→      });\n   951→      return map;\n   952→    }\n   953→\n   954→    /**\n   955→     * Build team total map from API teams data.\n   956→     * @returns {Object} Map of teamKey -> finalScore (string)\n   957→     */\n   958→    function buildTeamTotalMap(apiTeams) {\n   959→      const map = {};\n   960→      apiTeams.forEach((team, teamIdx) => {\n   961→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n   962→        map[teamKey] = team.final_score;  // string or null\n   963→      });\n   964→      return map;\n   965→    }\n   966→\n   967→    // Initialize Firebase schema with default values (prevents race conditions)\n   968→    // Uses update() with null checks - only sets values that don't exist\n   969→    async function initializeSchema() {\n   970→      const defaultSchema = {\n   971→        enabled: false,\n   972→        polling: false,\n   973→        automationMode: 'auto',\n   974→        showLineup: null,\n   975→        dismissFlash: {},\n   976→        nowCompeting: {},\n   977→        detected: {},\n   978→        heartbeat: null,\n   979→        liveData: {\n   980→          lastPollTimestamp: null,\n   981→          lastDataChangeTimestamp: null,\n   982→          stalePollCount: 0,\n   983→          rotation: null,\n   984→          totalRotations: null,\n   985→          teams: {}\n   986→        },\n   987→        lastError: null,\n   988→        config: {\n   989→          pollInterval: 5000,\n   990→          flashDuration: 10000,\n   991→          showStickIndicator: true\n   992→        }\n   993→      };\n   994→\n   995→      try {\n   996→        // Use transaction to safely initialize schema without overwriting existing values\n   997→        await scoreBugRef.transaction((currentData) => {\n   998→          if (currentData === null) {\n   999→            // No data exists - write full schema\n  1000→            console.log('Initializing scoreBug schema with defaults');\n  1001→            return defaultSchema;\n  1002→          }\n  1003→          // Data exists - merge defaults for any missing fields only\n  1004→          const merged = { ...defaultSchema };\n  1005→          Object.keys(currentData).forEach(key => {\n  1006→            if (currentData[key] !== undefined) {\n  1007→              // Keep existing value\n  1008→              merged[key] = currentData[key];\n  1009→            }\n  1010→          });\n  1011→          // Deep merge for nested objects (config, liveData)\n  1012→          if (currentData.config) {\n  1013→            merged.config = { ...defaultSchema.config, ...currentData.config };\n  1014→          }\n  1015→          if (currentData.liveData) {\n  1016→            merged.liveData = { ...defaultSchema.liveData, ...currentData.liveData };\n  1017→          }\n  1018→          console.log('Merged existing scoreBug data with defaults');\n  1019→          return merged;\n  1020→        });\n  1021→        console.log('Firebase schema initialized');\n  1022→      } catch (err) {\n  1023→        console.error('Failed to initialize schema:', err);\n  1024→      }\n  1025→    }\n  1026→\n  1027→    // Initialize on load\n  1028→    if (compId) {\n  1029→      // Start connection monitor immediately (A3d)\n  1030→      initConnectionMonitor();\n  1031→\n  1032→      // Order: load config -> render teams -> initialize schema -> start listeners\n  1033→      loadCompetitionConfig().then((success) => {\n  1034→        if (!success) return;\n  1035→\n  1036→        // Render team rows with initial state (before API data)\n  1037→        renderTeamRows();\n  1038→\n  1039→        // Initialize Firebase schema (safe defaults)\n  1040→        return initializeSchema();\n  1041→      }).then(() => {\n  1042→        // Start listening for Firebase changes\n  1043→        initFirebaseListeners();\n  1044→      });\n  1045→    }\n  1046→  </script>\n  1047→</body>\n  1048→</html>\n  1049→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"7d5acadc-34bc-4b7c-873d-83ef1cfd2a3f","uuid":"c8aa958d-ac9e-4f6a-a5a5-bee75da51134","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/overlays/team-bug.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=1920, height=1080\">\n  <title>Team Score Bug</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n\n  <!-- Firebase SDK -->\n  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js\"></script>\n  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js\"></script>\n\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n\n    body {\n      font-family: 'Inter', sans-serif;\n      width: 1920px;\n      height: 1080px;\n      overflow: hidden;\n      background: transparent;\n    }\n\n    /* Score bug container - positioned on right side of screen */\n    .score-bug {\n      position: absolute;\n      top: 50%;\n      right: 0;\n      transform: translateY(-50%) translateX(100%);\n      display: flex;\n      flex-direction: column;\n      min-width: 500px;\n      opacity: 0;\n      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n\n    .score-bug.visible {\n      transform: translateY(-50%) translateX(0);\n      opacity: 1;\n    }\n\n    /* Rotation tag at top */\n    .rotation-tag {\n      background: #27272a;\n      color: #fff;\n      font-size: 20px;\n      font-weight: 700;\n      padding: 10px 20px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n\n    /* Team rows container */\n    .team-rows {\n      display: flex;\n      flex-direction: column;\n    }\n\n    /* Individual team row */\n    .team-row {\n      display: flex;\n      flex-direction: row;\n      background: #1a1a1a;\n      border-bottom: 1px solid #333;\n      min-height: 70px;\n    }\n\n    .team-row:last-child {\n      border-bottom: none;\n    }\n\n    /* Fixed left section: logo + total */\n    .team-fixed {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 10px 15px;\n      min-width: 100px;\n      background: #000;\n    }\n\n    .team-logo {\n      width: 40px;\n      height: 40px;\n      object-fit: contain;\n    }\n\n    .team-total {\n      font-size: 22px;\n      font-weight: 900;\n      color: #fff;\n      margin-top: 4px;\n    }\n\n    .team-total.highlight {\n      animation: totalPulse 0.5s ease;\n    }\n\n    @keyframes totalPulse {\n      0%, 100% { transform: scale(1); color: #fff; }\n      50% { transform: scale(1.1); color: #22d3ee; }\n    }\n\n    /* Slot area for score flash / now competing */\n    .team-slot {\n      flex: 1;\n      display: flex;\n      align-items: center;\n      padding: 10px 20px;\n      overflow: hidden;\n      position: relative;\n    }\n\n    /* Slot content (animates up/down) */\n    .slot-content {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      transform: translateY(0);\n      transition: transform 0.4s ease, opacity 0.4s ease;\n      opacity: 0;\n    }\n\n    .slot-content.visible {\n      opacity: 1;\n    }\n\n    .slot-content.exit-up {\n      transform: translateY(-100%);\n      opacity: 0;\n    }\n\n    .slot-content.enter-from-below {\n      transform: translateY(100%);\n      opacity: 0;\n    }\n\n    /* Headshot in slot */\n    .slot-headshot {\n      width: 36px;\n      height: 36px;\n      border-radius: 50%;\n      object-fit: cover;\n      flex-shrink: 0;\n    }\n\n    /* Athlete name in slot */\n    .slot-name {\n      font-size: 24px;\n      font-weight: 700;\n      color: #fff;\n      white-space: nowrap;\n    }\n\n    /* Score in slot */\n    .slot-score {\n      font-size: 28px;\n      font-weight: 900;\n      color: #fff;\n    }\n\n    /* Apparatus code */\n    .slot-apparatus {\n      font-size: 18px;\n      font-weight: 600;\n      color: #a1a1aa;\n      text-transform: uppercase;\n    }\n\n    /* Start value */\n    .slot-sv {\n      font-size: 16px;\n      font-weight: 400;\n      color: #71717a;\n    }\n\n    /* Stick indicator */\n    .slot-stick {\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      background: #22c55e;\n      color: #fff;\n      font-size: 14px;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    /* Separator dot */\n    .slot-separator {\n      color: #52525b;\n      font-size: 20px;\n    }\n\n    /* Lineup card (above bug) */\n    .lineup-card {\n      position: absolute;\n      bottom: 100%;\n      right: 0;\n      width: 100%;\n      background: #1a1a1a;\n      transform: translateY(100%);\n      opacity: 0;\n      transition: transform 0.4s ease, opacity 0.4s ease;\n      margin-bottom: 8px;\n    }\n\n    .lineup-card.visible {\n      transform: translateY(0);\n      opacity: 1;\n    }\n\n    .lineup-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 20px;\n      background: #27272a;\n    }\n\n    .lineup-team-name {\n      font-size: 22px;\n      font-weight: 800;\n      color: #fff;\n      text-transform: uppercase;\n    }\n\n    .lineup-logo {\n      width: 32px;\n      height: 32px;\n      object-fit: contain;\n    }\n\n    .lineup-athletes {\n      padding: 8px 0;\n    }\n\n    .lineup-athlete {\n      display: flex;\n      align-items: center;\n      padding: 8px 20px;\n      gap: 12px;\n    }\n\n    .lineup-order {\n      font-size: 16px;\n      font-weight: 600;\n      color: #71717a;\n      min-width: 24px;\n    }\n\n    .lineup-name {\n      flex: 1;\n      font-size: 20px;\n      font-weight: 600;\n      color: #fff;\n    }\n\n    .lineup-sv {\n      font-size: 16px;\n      font-weight: 400;\n      color: #71717a;\n      min-width: 40px;\n      text-align: right;\n    }\n\n    .lineup-score {\n      font-size: 22px;\n      font-weight: 700;\n      color: #fff;\n      min-width: 70px;\n      text-align: right;\n    }\n\n    .lineup-score.pending {\n      color: #52525b;\n    }\n\n    .lineup-footer {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 20px;\n      background: #27272a;\n    }\n\n    .lineup-event {\n      font-size: 18px;\n      font-weight: 600;\n      color: #a1a1aa;\n      text-transform: uppercase;\n    }\n\n    .lineup-total {\n      font-size: 26px;\n      font-weight: 800;\n      color: #fff;\n    }\n\n    /* Loading / error states */\n    .loading-state {\n      color: #71717a;\n      font-size: 18px;\n      padding: 20px;\n      text-align: center;\n    }\n\n    .error-state {\n      color: #ef4444;\n      font-size: 18px;\n      padding: 20px;\n      text-align: center;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"score-bug\" id=\"scoreBug\">\n    <div class=\"lineup-card\" id=\"lineupCard\">\n      <!-- Lineup card content populated dynamically -->\n    </div>\n    <div class=\"rotation-tag\" id=\"rotationTag\">Rotation 1 of 6</div>\n    <div class=\"team-rows\" id=\"teamRows\">\n      <!-- Team rows populated dynamically -->\n    </div>\n  </div>\n\n  <script>\n    // Firebase configuration\n    const firebaseConfig = {\n      apiKey: \"AIzaSyCh0aZUvKl6Qvqsva3hvOgJJlleP1OwcTY\",\n      authDomain: \"gymnastics-graphics.firebaseapp.com\",\n      databaseURL: \"https://gymnastics-graphics-default-rtdb.firebaseio.com\",\n      projectId: \"gymnastics-graphics\",\n      storageBucket: \"gymnastics-graphics.firebasestorage.app\",\n      messagingSenderId: \"702072609550\",\n      appId: \"1:702072609550:web:ac74a811186d3ff45b955f\"\n    };\n\n    // Initialize Firebase\n    firebase.initializeApp(firebaseConfig);\n    const db = firebase.database();\n\n    // Parse URL parameters\n    const params = new URLSearchParams(window.location.search);\n    const compId = params.get('compId');\n\n    if (!compId) {\n      console.error('Missing compId parameter');\n      document.body.innerHTML = '<div class=\"error-state\">Missing compId parameter</div>';\n    }\n\n    // State management\n    const state = {\n      enabled: false,\n      polling: false,\n      automationMode: 'auto',\n      showLineup: null,\n      teams: [],\n      rotation: { current: 1, total: 6, isFinal: false },\n      previousScores: {},        // { \"gymnast_id\": \"finalScore\" (string) }\n      previousTeamTotals: {},    // { \"teamKey\": \"finalScore\" (string) }\n      flashQueues: {},           // Per-team flash queues\n      activeFlashes: {},         // Currently active flashes per team\n      pollInterval: 5000,\n      flashDuration: 10000,\n      stalePollCount: 0,         // Consecutive polls with no data changes\n      // Competition config (loaded from Firebase)\n      competitionConfig: null,\n      virtiusSessionId: null,\n      gender: 'mens',\n      // Error handling state (A3c)\n      consecutiveErrors: 0,      // Count of consecutive poll failures\n      lastError: null,           // Last error message\n      lastErrorTime: null,       // Timestamp of last error\n      maxBackoffMs: 60000,       // Max backoff delay (60 seconds)\n      // Offline/reconnect state (A3d)\n      firebaseConnected: true,   // Firebase connection state\n      pendingWrites: [],         // Writes queued during offline\n      reconnectAttempts: 0       // Count of reconnect attempts\n    };\n\n    /**\n     * Normalize athlete name for lookup (lowercase, remove special chars).\n     * Matches pattern used in output.html for headshot lookups.\n     */\n    function normalizeName(name) {\n      if (!name) return '';\n      return name.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');\n    }\n\n    // Firebase paths\n    const scoreBugRef = db.ref(`competitions/${compId}/scoreBug`);\n    const configRef = db.ref(`competitions/${compId}/config`);\n    const connectedRef = db.ref('.info/connected');\n\n    /**\n     * Initialize Firebase connection monitoring (A3d).\n     * Detects offline/online state and handles reconnection.\n     */\n    function initConnectionMonitor() {\n      connectedRef.on('value', (snapshot) => {\n        const connected = snapshot.val() === true;\n        const wasConnected = state.firebaseConnected;\n        state.firebaseConnected = connected;\n\n        if (connected && !wasConnected) {\n          // Just reconnected\n          console.log('Firebase connected - processing pending writes');\n          state.reconnectAttempts = 0;\n          processPendingWrites();\n\n          // Write reconnect event to Firebase\n          scoreBugRef.child('connectionStatus').set({\n            connected: true,\n            reconnectedAt: Date.now(),\n            pendingWritesProcessed: state.pendingWrites.length\n          });\n        } else if (!connected && wasConnected) {\n          // Just went offline\n          console.warn('Firebase disconnected - writes will be queued');\n          state.reconnectAttempts++;\n\n          // Note: Firebase SDK has offline persistence by default\n          // Writes are automatically queued and synced on reconnect\n        }\n\n        console.log('Firebase connection state:', connected ? 'ONLINE' : 'OFFLINE');\n      });\n    }\n\n    /**\n     * Process any pending writes that were queued during offline.\n     * Firebase SDK handles this automatically, but we log for visibility.\n     */\n    function processPendingWrites() {\n      if (state.pendingWrites.length === 0) return;\n\n      console.log('Processing', state.pendingWrites.length, 'pending writes');\n\n      // Firebase SDK automatically syncs queued writes\n      // Clear our tracking array\n      state.pendingWrites = [];\n    }\n\n    /**\n     * Safe write to Firebase with offline queueing (A3d).\n     * Wraps Firebase write operations to track pending writes during offline.\n     * @param {firebase.database.Reference} ref - Firebase reference\n     * @param {string} method - 'set', 'update', or 'remove'\n     * @param {*} data - Data to write (for set/update)\n     * @returns {Promise}\n     */\n    async function safeWrite(ref, method, data) {\n      const writeOp = { path: ref.toString(), method, data, timestamp: Date.now() };\n\n      if (!state.firebaseConnected) {\n        // Queue the write for tracking (Firebase SDK queues automatically)\n        state.pendingWrites.push(writeOp);\n        console.log('Queued offline write:', writeOp.path, method);\n      }\n\n      try {\n        if (method === 'set') {\n          await ref.set(data);\n        } else if (method === 'update') {\n          await ref.update(data);\n        } else if (method === 'remove') {\n          await ref.remove();\n        }\n        return true;\n      } catch (err) {\n        // Firebase SDK will retry on reconnect\n        console.error('Write failed (will retry on reconnect):', err.message);\n        if (!state.pendingWrites.includes(writeOp)) {\n          state.pendingWrites.push(writeOp);\n        }\n        return false;\n      }\n    }\n\n    /**\n     * Load competition config from Firebase.\n     * Gets virtiusSessionId, team names/logos, gender, and compType.\n     * Must be called before initializing Firebase listeners.\n     */\n    async function loadCompetitionConfig() {\n      try {\n        const snapshot = await configRef.once('value');\n        const config = snapshot.val();\n\n        if (!config) {\n          console.error('No competition config found for compId:', compId);\n          document.body.innerHTML = '<div class=\"error-state\">Competition not found</div>';\n          return false;\n        }\n\n        state.competitionConfig = config;\n        state.virtiusSessionId = config.virtiusSessionId || null;\n        state.gender = config.gender || 'mens';\n\n        // Build teams array from config (up to 6 teams)\n        state.teams = [];\n        for (let i = 1; i <= 6; i++) {\n          const teamName = config[`team${i}Name`];\n          if (teamName) {\n            state.teams.push({\n              index: i,\n              name: teamName,\n              logo: config[`team${i}Logo`] || '',\n              tricode: config[`team${i}Tricode`] || '',\n              total: '--'  // Initial state before first API poll\n            });\n          }\n        }\n\n        // Determine total rotations based on gender (6 for men, 4 for women)\n        state.rotation.total = state.gender === 'womens' ? 4 : 6;\n\n        console.log('Competition config loaded:', {\n          compId,\n          virtiusSessionId: state.virtiusSessionId,\n          gender: state.gender,\n          teamCount: state.teams.length,\n          teams: state.teams.map(t => t.name)\n        });\n\n        // Check if Virtius session ID is configured\n        if (!state.virtiusSessionId) {\n          console.warn('No Virtius session ID configured - API polling will not work');\n        }\n\n        return true;\n      } catch (err) {\n        console.error('Failed to load competition config:', err);\n        document.body.innerHTML = '<div class=\"error-state\">Failed to load competition config</div>';\n        return false;\n      }\n    }\n\n    /**\n     * Render initial team rows based on competition config.\n     * Called after loadCompetitionConfig() to show teams before API polling starts.\n     */\n    function renderTeamRows() {\n      const container = document.getElementById('teamRows');\n      if (!container) return;\n\n      container.innerHTML = state.teams.map((team, idx) => `\n        <div class=\"team-row\" data-team-index=\"${team.index}\">\n          <div class=\"team-fixed\">\n            <img class=\"team-logo\" src=\"${team.logo}\" alt=\"${team.name}\" onerror=\"this.style.display='none'\">\n            <div class=\"team-total\" id=\"teamTotal${team.index}\">${team.total}</div>\n          </div>\n          <div class=\"team-slot\" id=\"teamSlot${team.index}\">\n            <div class=\"slot-content\" id=\"slotContent${team.index}\">\n              <!-- Score flash / now competing content populated dynamically -->\n            </div>\n          </div>\n        </div>\n      `).join('');\n\n      console.log('Team rows rendered:', state.teams.length);\n    }\n\n    /**\n     * Update team total display element (A4).\n     * Called when API polling detects a change in team.final_score.\n     * Adds highlight animation on value change.\n     * @param {number} teamIndex - 1-based team index\n     * @param {string} newTotal - Formatted score string (e.g., \"196.450\")\n     */\n    function updateTeamTotal(teamIndex, newTotal) {\n      const totalEl = document.getElementById(`teamTotal${teamIndex}`);\n      if (!totalEl) return;\n\n      const prevTotal = totalEl.textContent;\n\n      // Only update if value changed\n      if (prevTotal === newTotal) return;\n\n      totalEl.textContent = newTotal;\n\n      // Trigger highlight animation on change (skip for initial load)\n      if (prevTotal !== '--') {\n        totalEl.classList.remove('highlight');\n        // Force reflow to restart animation\n        void totalEl.offsetWidth;\n        totalEl.classList.add('highlight');\n      }\n    }\n\n    /**\n     * Update all team totals from state (A4).\n     * Called after API poll updates state.teams[].total values.\n     */\n    function updateAllTeamTotals() {\n      state.teams.forEach((team) => {\n        updateTeamTotal(team.index, team.total);\n      });\n    }\n\n    // Initialize Firebase listeners\n    function initFirebaseListeners() {\n      // Listen for enabled state\n      scoreBugRef.child('enabled').on('value', (snapshot) => {\n        state.enabled = snapshot.val() === true;\n        updateBugVisibility();\n      });\n\n      // Listen for polling state\n      scoreBugRef.child('polling').on('value', (snapshot) => {\n        const wasPolling = state.polling;\n        state.polling = snapshot.val() === true;\n        if (state.polling && !wasPolling) {\n          startPolling();\n        } else if (!state.polling && wasPolling) {\n          stopPolling();\n        }\n      });\n\n      // Listen for automation mode\n      scoreBugRef.child('automationMode').on('value', (snapshot) => {\n        state.automationMode = snapshot.val() || 'auto';\n      });\n\n      // Listen for lineup card toggle\n      scoreBugRef.child('showLineup').on('value', (snapshot) => {\n        state.showLineup = snapshot.val();\n        updateLineupCard();\n      });\n\n      // Listen for flash dismissals\n      scoreBugRef.child('dismissFlash').on('value', (snapshot) => {\n        const dismissals = snapshot.val() || {};\n        handleFlashDismissals(dismissals);\n      });\n\n      // Listen for poll interval changes - restart polling with new interval\n      scoreBugRef.child('config/pollInterval').on('value', (snapshot) => {\n        const newInterval = snapshot.val() || 5000;\n        const wasPolling = state.polling && pollTimer !== null;\n        state.pollInterval = newInterval;\n\n        // Restart polling with new interval if currently polling\n        if (wasPolling) {\n          console.log('Poll interval changed to', newInterval, 'ms - restarting polling');\n          stopPolling();\n          startPolling();\n        }\n      });\n\n      // Listen for flash duration changes\n      scoreBugRef.child('config/flashDuration').on('value', (snapshot) => {\n        state.flashDuration = snapshot.val() || 10000;\n      });\n\n      console.log('Firebase listeners initialized');\n    }\n\n    // Update bug visibility based on enabled state\n    function updateBugVisibility() {\n      const bugEl = document.getElementById('scoreBug');\n      if (state.enabled) {\n        bugEl.classList.add('visible');\n      } else {\n        bugEl.classList.remove('visible');\n      }\n    }\n\n    // Update lineup card visibility\n    function updateLineupCard() {\n      const cardEl = document.getElementById('lineupCard');\n      if (state.showLineup) {\n        cardEl.classList.add('visible');\n        // TODO: Populate lineup card content (Phase C)\n      } else {\n        cardEl.classList.remove('visible');\n      }\n    }\n\n    // Handle flash dismissals from producer\n    function handleFlashDismissals(dismissals) {\n      // TODO: Implement flash dismissal handling (Task A12c)\n    }\n\n    // Polling management\n    let pollTimer = null;\n\n    function startPolling() {\n      if (pollTimer) return;\n      console.log('Starting API polling');\n      poll();  // Initial poll\n      pollTimer = setInterval(poll, state.pollInterval);\n    }\n\n    function stopPolling() {\n      if (pollTimer) {\n        clearInterval(pollTimer);\n        pollTimer = null;\n        console.log('Stopped API polling');\n      }\n    }\n\n    // Main poll function - fetches data from Virtius API\n    async function poll() {\n      // Check if we have a valid session ID\n      if (!state.virtiusSessionId) {\n        console.warn('No Virtius session ID - skipping poll');\n        return;\n      }\n\n      const pollStartTime = Date.now();\n\n      try {\n        // Fetch from Virtius API\n        const response = await fetch(`https://api.virti.us/session/${state.virtiusSessionId}/json`);\n\n        if (!response.ok) {\n          throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n        }\n\n        const data = await response.json();\n\n        // Store raw API data for score diff engine (Task A5)\n        // Extract teams array from meet data\n        const teams = data.meet?.teams || [];\n\n        if (teams.length === 0) {\n          console.warn('No teams found in API response');\n        }\n\n        // Store the latest API data in state\n        state.lastApiData = data;\n        state.lastApiTeams = teams;\n\n        // Extract team totals and update state.teams with actual data\n        // final_score comes as a string from API - convert to float for display\n        teams.forEach((apiTeam, idx) => {\n          // Match API team to our configured teams by index or name\n          const stateTeam = state.teams[idx];\n          if (stateTeam) {\n            // Convert string final_score to formatted number\n            const rawScore = apiTeam.final_score;\n            if (rawScore !== null && rawScore !== undefined) {\n              const numScore = parseFloat(rawScore);\n              stateTeam.total = isNaN(numScore) ? '--' : numScore.toFixed(3);\n            }\n            // Store API team reference for score diff engine\n            stateTeam.apiTeam = apiTeam;\n          }\n        });\n\n        // Write heartbeat to Firebase on successful poll (using safeWrite for offline resilience)\n        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n\n        console.log('Poll successful:', {\n          sessionId: state.virtiusSessionId,\n          teamCount: teams.length,\n          teams: state.teams.map(t => ({ name: t.name, total: t.total }))\n        });\n\n        // Process API data - detect changes and write deltas to Firebase\n        await processApiData(teams, pollStartTime);\n\n        // Update team total displays (A4)\n        updateAllTeamTotals();\n\n      } catch (err) {\n        // Error handling with exponential backoff (A3c)\n        state.consecutiveErrors++;\n        state.lastError = err.message;\n        state.lastErrorTime = pollStartTime;\n\n        // Calculate backoff delay: 5s, 10s, 20s, 40s, 60s (max)\n        const backoffDelay = Math.min(\n          state.pollInterval * Math.pow(2, state.consecutiveErrors - 1),\n          state.maxBackoffMs\n        );\n\n        console.error('Poll failed:', {\n          error: err.message,\n          consecutiveErrors: state.consecutiveErrors,\n          nextRetryIn: `${backoffDelay / 1000}s`\n        });\n\n        // Write error state to Firebase for producer panel visibility (D5b)\n        // Using safeWrite for offline resilience\n        await safeWrite(scoreBugRef.child('apiError'), 'set', {\n          message: err.message,\n          consecutiveErrors: state.consecutiveErrors,\n          timestamp: pollStartTime,\n          nextRetryMs: backoffDelay\n        });\n        // Still write heartbeat to indicate overlay is running\n        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n\n        // Schedule next poll with backoff delay if we're still supposed to be polling\n        if (state.polling && pollTimer) {\n          clearInterval(pollTimer);\n          pollTimer = setTimeout(() => {\n            if (state.polling) {\n              poll();\n              // If poll succeeds, startPolling() will be called to restore normal interval\n            }\n          }, backoffDelay);\n        }\n        return; // Skip normal completion\n      }\n\n      // Success - reset error state\n      if (state.consecutiveErrors > 0) {\n        console.log('Poll recovered after', state.consecutiveErrors, 'consecutive errors');\n        state.consecutiveErrors = 0;\n        state.lastError = null;\n        state.lastErrorTime = null;\n\n        // Clear error state in Firebase\n        await safeWrite(scoreBugRef.child('apiError'), 'remove');\n\n        // Restore normal polling interval (we might be on backoff timeout)\n        if (state.polling && pollTimer) {\n          clearTimeout(pollTimer);\n          clearInterval(pollTimer);\n          pollTimer = setInterval(poll, state.pollInterval);\n        }\n      }\n    }\n\n    /**\n     * Process API data - detect score changes and write incremental deltas to Firebase.\n     * Only writes changed paths, not full data rewrite.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @param {number} pollTimestamp - Timestamp of this poll\n     */\n    async function processApiData(apiTeams, pollTimestamp) {\n      const changedPaths = {};\n      let hasChanges = false;\n\n      // Process each team\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n\n        // Check if team total changed\n        const prevTeamTotal = state.previousTeamTotals[teamKey];\n        const currTeamTotal = team.final_score;  // string or null\n\n        if (currTeamTotal !== prevTeamTotal) {\n          changedPaths[`teams/${teamKey}/finalScore`] = currTeamTotal;\n          changedPaths[`teams/${teamKey}/name`] = team.name || teamKey;\n          hasChanges = true;\n        }\n\n        // Process each event's gymnasts for score changes\n        const events = team.events || [];\n        events.forEach((event) => {\n          const eventKey = event.short_name || event.name || 'unknown';\n          const gymnasts = event.gymnasts || [];\n\n          gymnasts.forEach((gymnast) => {\n            // Primary key: gymnast_id. Fallback: teamKey|normalizedName\n            const gymnastKey = gymnast.gymnast_id ||\n              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n\n            const prevScore = state.previousScores[gymnastKey];\n            const currScore = gymnast.final_score;  // string or null\n\n            // Score changed (new score OR corrected score)\n            if (currScore != null && prevScore !== currScore) {\n              // Build gymnast data for Firebase\n              const gymnastData = {\n                name: gymnast.full_name,\n                score: currScore,\n                startValue: gymnast.start_value || null,\n                execution: gymnast.execution || null,\n                difficulty: gymnast.difficulty || null,\n                order: gymnast.order,\n                event: eventKey,\n                team: teamKey,\n                timestamp: pollTimestamp\n              };\n\n              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}`] = gymnastData;\n              hasChanges = true;\n\n              console.log('Score change detected:', {\n                gymnast: gymnast.full_name,\n                event: eventKey,\n                team: teamKey,\n                prev: prevScore,\n                curr: currScore\n              });\n            }\n\n            // Score removed (rare - inquiry pending)\n            if (currScore == null && prevScore != null) {\n              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}/score`] = null;\n              hasChanges = true;\n              console.log('Score removed:', { gymnast: gymnast.full_name, event: eventKey });\n            }\n          });\n        });\n      });\n\n      // Write to Firebase (using safeWrite for offline resilience)\n      if (hasChanges) {\n        // Write changed paths and reset stale counter\n        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n          ...changedPaths,\n          lastDataChangeTimestamp: pollTimestamp,\n          stalePollCount: 0\n        });\n        state.stalePollCount = 0;\n\n        console.log('Wrote incremental deltas to Firebase:', Object.keys(changedPaths).length, 'paths');\n      } else {\n        // No changes - increment stale counter\n        state.stalePollCount++;\n        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n          lastPollTimestamp: pollTimestamp,\n          stalePollCount: state.stalePollCount\n        });\n      }\n\n      // Update previous state for next comparison\n      state.previousScores = buildScoreMap(apiTeams);\n      state.previousTeamTotals = buildTeamTotalMap(apiTeams);\n    }\n\n    /**\n     * Build score map from API teams data.\n     * @returns {Object} Map of gymnastKey -> finalScore (string)\n     */\n    function buildScoreMap(apiTeams) {\n      const map = {};\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n        const events = team.events || [];\n\n        events.forEach((event) => {\n          const gymnasts = event.gymnasts || [];\n          gymnasts.forEach((gymnast) => {\n            const gymnastKey = gymnast.gymnast_id ||\n              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n            map[gymnastKey] = gymnast.final_score;  // string or null\n          });\n        });\n      });\n      return map;\n    }\n\n    /**\n     * Build team total map from API teams data.\n     * @returns {Object} Map of teamKey -> finalScore (string)\n     */\n    function buildTeamTotalMap(apiTeams) {\n      const map = {};\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n        map[teamKey] = team.final_score;  // string or null\n      });\n      return map;\n    }\n\n    // Initialize Firebase schema with default values (prevents race conditions)\n    // Uses update() with null checks - only sets values that don't exist\n    async function initializeSchema() {\n      const defaultSchema = {\n        enabled: false,\n        polling: false,\n        automationMode: 'auto',\n        showLineup: null,\n        dismissFlash: {},\n        nowCompeting: {},\n        detected: {},\n        heartbeat: null,\n        liveData: {\n          lastPollTimestamp: null,\n          lastDataChangeTimestamp: null,\n          stalePollCount: 0,\n          rotation: null,\n          totalRotations: null,\n          teams: {}\n        },\n        lastError: null,\n        config: {\n          pollInterval: 5000,\n          flashDuration: 10000,\n          showStickIndicator: true\n        }\n      };\n\n      try {\n        // Use transaction to safely initialize schema without overwriting existing values\n        await scoreBugRef.transaction((currentData) => {\n          if (currentData === null) {\n            // No data exists - write full schema\n            console.log('Initializing scoreBug schema with defaults');\n            return defaultSchema;\n          }\n          // Data exists - merge defaults for any missing fields only\n          const merged = { ...defaultSchema };\n          Object.keys(currentData).forEach(key => {\n            if (currentData[key] !== undefined) {\n              // Keep existing value\n              merged[key] = currentData[key];\n            }\n          });\n          // Deep merge for nested objects (config, liveData)\n          if (currentData.config) {\n            merged.config = { ...defaultSchema.config, ...currentData.config };\n          }\n          if (currentData.liveData) {\n            merged.liveData = { ...defaultSchema.liveData, ...currentData.liveData };\n          }\n          console.log('Merged existing scoreBug data with defaults');\n          return merged;\n        });\n        console.log('Firebase schema initialized');\n      } catch (err) {\n        console.error('Failed to initialize schema:', err);\n      }\n    }\n\n    // Initialize on load\n    if (compId) {\n      // Start connection monitor immediately (A3d)\n      initConnectionMonitor();\n\n      // Order: load config -> render teams -> initialize schema -> start listeners\n      loadCompetitionConfig().then((success) => {\n        if (!success) return;\n\n        // Render team rows with initial state (before API data)\n        renderTeamRows();\n\n        // Initialize Firebase schema (safe defaults)\n        return initializeSchema();\n      }).then(() => {\n        // Start listening for Firebase changes\n        initFirebaseListeners();\n      });\n    }\n  </script>\n</body>\n</html>\n","numLines":1049,"startLine":1,"totalLines":1049}}}
