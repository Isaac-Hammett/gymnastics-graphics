→    }\n    52→\n    53→    /* Team rows container */\n    54→    .team-rows {\n    55→      display: flex;\n    56→      flex-direction: column;\n    57→    }\n    58→\n    59→    /* Individual team row */\n    60→    .team-row {\n    61→      display: flex;\n    62→      flex-direction: row;\n    63→      background: #1a1a1a;\n    64→      border-bottom: 1px solid #333;\n    65→      min-height: 70px;\n    66→    }\n    67→\n    68→    .team-row:last-child {\n    69→      border-bottom: none;\n    70→    }\n    71→\n    72→    /* Fixed left section: logo + total */\n    73→    .team-fixed {\n    74→      display: flex;\n    75→      flex-direction: column;\n    76→      align-items: center;\n    77→      justify-content: center;\n    78→      padding: 10px 15px;\n    79→      min-width: 100px;\n    80→      background: #000;\n    81→    }\n    82→\n    83→    .team-logo {\n    84→      width: 40px;\n    85→      height: 40px;\n    86→      object-fit: contain;\n    87→    }\n    88→\n    89→    .team-total {\n    90→      font-size: 22px;\n    91→      font-weight: 900;\n    92→      color: #fff;\n    93→      margin-top: 4px;\n    94→    }\n    95→\n    96→    .team-total.highlight {\n    97→      animation: totalPulse 0.5s ease;\n    98→    }\n    99→\n   100→    @keyframes totalPulse {\n   101→      0%, 100% { transform: scale(1); color: #fff; }\n   102→      50% { transform: scale(1.1); color: #22d3ee; }\n   103→    }\n   104→\n   105→    /* Slot area for score flash / now competing */\n   106→    .team-slot {\n   107→      flex: 1;\n   108→      display: flex;\n   109→      align-items: center;\n   110→      padding: 10px 20px;\n   111→      overflow: hidden;\n   112→      position: relative;\n   113→    }\n   114→\n   115→    /* Slot content (animates up/down) */\n   116→    .slot-content {\n   117→      display: flex;\n   118→      align-items: center;\n   119→      gap: 12px;\n   120→      transform: translateY(0);\n   121→      transition: transform 0.4s ease, opacity 0.4s ease;\n   122→      opacity: 0;\n   123→    }\n   124→\n   125→    .slot-content.visible {\n   126→      opacity: 1;\n   127→    }\n   128→\n   129→    .slot-content.exit-up {\n   130→      transform: translateY(-100%);\n   131→      opacity: 0;\n   132→    }\n   133→\n   134→    .slot-content.enter-from-below {\n   135→      transform: translateY(100%);\n   136→      opacity: 0;\n   137→    }\n   138→\n   139→    /* Slot machine animation - new content spins up from below */\n   140→    @keyframes slotSpinIn {\n   141→      0% {\n   142→        transform: translateY(100%);\n   143→        opacity: 0;\n   144→      }\n   145→      20% {\n   146→        opacity: 1;\n   147→      }\n   148→      100% {\n   149→        transform: translateY(0);\n   150→        opacity: 1;\n   151→      }\n   152→    }\n   153→\n   154→    /* Slot machine animation - old content spins up and out */\n   155→    @keyframes slotSpinOut {\n   156→      0% {\n   157→        transform: translateY(0);\n   158→        opacity: 1;\n   159→      }\n   160→      80% {\n   161→        opacity: 0;\n   162→      }\n   163→      100% {\n   164→        transform: translateY(-100%);\n   165→        opacity: 0;\n   166→      }\n   167→    }\n   168→\n   169→    .slot-content.spin-in {\n   170→      animation: slotSpinIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n   171→    }\n   172→\n   173→    .slot-content.spin-out {\n   174→      animation: slotSpinOut 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n   175→    }\n   176→\n   177→    /* Headshot in slot */\n   178→    .slot-headshot {\n   179→      width: 36px;\n   180→      height: 36px;\n   181→      border-radius: 50%;\n   182→      object-fit: cover;\n   183→      flex-shrink: 0;\n   184→    }\n   185→\n   186→    /* Athlete name in slot */\n   187→    .slot-name {\n   188→      font-size: 24px;\n   189→      font-weight: 700;\n   190→      color: #fff;\n   191→      white-space: nowrap;\n   192→    }\n   193→\n   194→    /* Sc