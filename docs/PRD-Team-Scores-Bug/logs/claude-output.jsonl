eup card (above bug) */\n   199→    .lineup-card {\n   200→      position: absolute;\n   201→      bottom: 100%;\n   202→      right: 0;\n   203→      width: 100%;\n   204→      background: #1a1a1a;\n   205→      transform: translateY(100%);\n   206→      opacity: 0;\n   207→      transition: transform 0.4s ease, opacity 0.4s ease;\n   208→      margin-bottom: 8px;\n   209→    }\n   210→\n   211→    .lineup-card.visible {\n   212→      transform: translateY(0);\n   213→      opacity: 1;\n   214→    }\n   215→\n   216→    .lineup-header {\n   217→      display: flex;\n   218→      justify-content: space-between;\n   219→      align-items: center;\n   220→      padding: 12px 20px;\n   221→      background: #27272a;\n   222→    }\n   223→\n   224→    .lineup-team-name {\n   225→      font-size: 22px;\n   226→      font-weight: 800;\n   227→      color: #fff;\n   228→      text-transform: uppercase;\n   229→    }\n   230→\n   231→    .lineup-logo {\n   232→      width: 32px;\n   233→      height: 32px;\n   234→      object-fit: contain;\n   235→    }\n   236→\n   237→    .lineup-athletes {\n   238→      padding: 8px 0;\n   239→    }\n   240→\n   241→    .lineup-athlete {\n   242→      display: flex;\n   243→      align-items: center;\n   244→      padding: 8px 20px;\n   245→      gap: 12px;\n   246→    }\n   247→\n   248→    .lineup-order {\n   249→      font-size: 16px;\n   250→      font-weight: 600;\n   251→      color: #71717a;\n   252→      min-width: 24px;\n   253→    }\n   254→\n   255→    .lineup-name {\n   256→      flex: 1;\n   257→      font-size: 20px;\n   258→      font-weight: 600;\n   259→      color: #fff;\n   260→    }\n   261→\n   262→    .lineup-sv {\n   263→      font-size: 16px;\n   264→      font-weight: 400;\n   265→      color: #71717a;\n   266→      min-width: 40px;\n   267→      text-align: right;\n   268→    }\n   269→\n   270→    .lineup-score {\n   271→      font-size: 22px;\n   272→      font-weight: 700;\n   273→      color: #fff;\n   274→      min-width: 70px;\n   275→      text-align: right;\n   276→    }\n   277→\n   278→    .lineup-score.pending {\n   279→      color: #52525b;\n   280→    }\n   281→\n   282→    .lineup-footer {\n   283→      display: flex;\n   284→      justify-content: space-between;\n   285→      align-items: center;\n   286→      padding: 12px 20px;\n   287→      background: #27272a;\n   288→    }\n   289→\n   290→    .lineup-event {\n   291→      font-size: 18px;\n   292→      font-weight: 600;\n   293→      color: #a1a1aa;\n   294→      text-transform: uppercase;\n   295→    }\n   296→\n   297→    .lineup-total {\n   298→      font-size: 26px;\n   299→      font-weight: 800;\n   300→      color: #fff;\n   301→    }\n   302→\n   303→    /* Loading / error states */\n   304→    .loading-state {\n   305→      color: #71717a;\n   306→      font-size: 18px;\n   307→      padding: 20px;\n   308→      text-align: center;\n   309→    }\n   310→\n   311→    .error-state {\n   312→      color: #ef4444;\n   313→      font-size: 18px;\n   314→      padding: 20px;\n   315→      text-align: center;\n   316→    }\n   317→  </style>\n   318→</head>\n   319→<body>\n   320→  <div class=\"score-bug\" id=\"scoreBug\">\n   321→    <div class=\"lineup-card\" id=\"lineupCard\">\n   322→      <!-- Lineup card content populated dynamically -->\n   323→    </div>\n   324→    <div class=\"rotation-tag\" id=\"rotationTag\">Rotation 1 of 6</div>\n   325→    <div class=\"team-rows\" id=\"teamRows\">\n   326→      <!-- Team rows populated dynamically -->\n   327→    </div>\n   328→  </div>\n   329→\n   330→  <script>\n   331→    // Firebase configuration\n   332→    const firebaseConfig = {\n   333→      apiKey: \"AIzaSyCh0aZUvKl6Qvqsva3hvOgJJlleP1OwcTY\",\n   334→      authDomain: \"gymnastics-graphics.firebaseapp.com\",\n   335→      databaseURL: \"https://gymnastics-graphics-default-rtdb.firebaseio.com\",\n   336→      projectId: \"gymnastics-graphics\",\n   337→      storageBucket: \"gymnastics-graphics.firebasestorage.app\",\n   338→      messagingSenderId: \"702072609550\",\n   339→      appId: \"1:702072609550:web:ac74a811186d3ff45b955f\"\n   340→    };\n   341→\n   342→    // Initialize Firebase\n   343→    firebase.initializeApp(firebaseConfig);\n   344→    const db = firebase.database();\n   345→\n   346→    // Parse URL parameters\n   347→    const params = new URLSearchParams(window.location.search);\n   348→    const compId = params.get('compId');\n   349→\n   350→    if (!compId) {\n   351→      console.error('Missing compId parameter');\n   352→      document.body.innerHTML = '<div class=\"error-state\">Missing compId parameter</div>';\n   353→    }\n   354→\n   355→    // State management\n   356→    const state = {\n   357→      enabled: false,\n   358→      polling: false,\n   359→      automationMode: 'auto',\n   360→      showLineup: null,\n   361→      teams: [],\n   362→      rotation: { current: 1, total: 6, isFinal: false },\n   363→      previousScores: {},        // { \"gymnast_id\": \"finalScore\" (string) }\n   364→      previousTeamTotals: {},    // { \"teamKey\": \"finalScore\" (string) }\n   365→      flashQueues: {},           // Per-team flash queues\n   366→      activeFlashes: {},         // Currently active flashes per team\n   367→      pollInterval: 5000,\n   368→      flashDuration: 10000,\n   369→      stalePollCount: 0,         // Consecutive polls with no data changes\n   370→      // Competition config (loaded from Firebase)\n   371→      competitionConfig: null,\n   372→      virtiusSessionId: null,\n   373→      gender: 'mens',\n   374→      // Error handling state (A3c)\n   375→      consecutiveErrors: 0,      // Count of consecutive poll failures\n   376→      lastError: null,           // Last error message\n   377→      lastErrorTime: null,       // Timestamp of last error\n   378→      maxBackoffMs: 60000        // Max backoff delay (60 seconds)\n   379→    };\n   380→\n   381→    /**\n   382→     * Normalize athlete name for lookup (lowercase, remove special chars).\n   383→     * Matches pattern used in output.html for headshot lookups.\n   384→     */\n   385→    function normalizeName(name) {\n   386→      if (!name) return '';\n   387→      return name.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');\n   388→    }\n   389→\n   390→    // Firebase paths\n   391→    const scoreBugRef = db.ref(`competitions/${compId}/scoreBug`);\n   392→    const configRef = db.ref(`competitions/${compId}/config`);\n   393→\n   394→    /**\n   395→     * Load competition config from Firebase.\n   396→     * Gets virtiusSessionId, team names/logos, gender, and compType.\n   397→     * Must be called before initializing Firebase listeners.\n   398→     */\n   399→    async function loadCompetitionConfig() {\n   400→      try {\n   401→        const snapshot = await configRef.once('value');\n   402→        const config = snapshot.val();\n   403→\n   404→        if (!config) {\n   405→          console.error('No competition config found for compId:', compId);\n   406→          document.body.innerHTML = '<div class=\"error-state\">Competition not found</div>';\n   407→          return false;\n   408→        }\n   409→\n   410→        state.competitionConfig = config;\n   411→        state.virtiusSessionId = config.virtiusSessionId || null;\n   412→        state.gender = config.gender || 'mens';\n   413→\n   414→        // Build teams array from config (up to 6 teams)\n   415→        state.teams = [];\n   416→        for (let i = 1; i <= 6; i++) {\n   417→          const teamName = config[`team${i}Name`];\n   418→          if (teamName) {\n   419→            state.teams.push({\n   420→              index: i,\n   421→              name: teamName,\n   422→              logo: config[`team${i}Logo`] || '',\n   423→              tricode: config[`team${i}Tricode`] || '',\n   424→              total: '--'  // Initial state before first API poll\n   425→            });\n   426→          }\n   427→        }\n   428→\n   429→        // Determine total rotations based on gender (6 for men, 4 for women)\n   430→        state.rotation.total = state.gender === 'womens' ? 4 : 6;\n   431→\n   432→        console.log('Competition config loaded:', {\n   433→          compId,\n   434→          virtiusSessionId: state.virtiusSessionId,\n   435→          gender: state.gender,\n   436→          teamCount: state.teams.length,\n   437→          teams: state.teams.map(t => t.name)\n   438→        });\n   439→\n   440→        // Check if Virtius session ID is configured\n   441→        if (!state.virtiusSessionId) {\n   442→          console.warn('No Virtius session ID configured - API polling will not work');\n   443→        }\n   444→\n   445→        return true;\n   446→      } catch (err) {\n   447→        console.error('Failed to load competition config:', err);\n   448→        document.body.innerHTML = '<div class=\"error-state\">Failed to load competition config</div>';\n   449→        return false;\n   450→      }\n   451→    }\n   452→\n   453→    /**\n   454→     * Render initial team rows based on competition config.\n   455→     * Called after loadCompetitionConfig() to show teams before API polling starts.\n   456→     */\n   457→    function renderTeamRows() {\n   458→      const container = document.getElementById('teamRows');\n   459→      if (!container) return;\n   460→\n   461→      container.innerHTML = state.teams.map((team, idx) => `\n   462→        <div class=\"team-row\" data-team-index=\"${team.index}\">\n   463→          <div class=\"team-fixed\">\n   464→            <img class=\"team-logo\" src=\"${team.logo}\" alt=\"${team.name}\" onerror=\"this.style.display='none'\">\n   465→            <div class=\"team-total\" id=\"teamTotal${team.index}\">${team.total}</div>\n   466→          </div>\n   467→          <div class=\"team-slot\" id=\"teamSlot${team.index}\">\n   468→            <div class=\"slot-content\" id=\"slotContent${team.index}\">\n   469→              <!-- Score flash / now competing content populated dynamically -->\n   470→            </div>\n   471→          </div>\n   472→        </div>\n   473→      `).join('');\n   474→\n   475→      console.log('Team rows rendered:', state.teams.length);\n   476→    }\n   477→\n   478→    // Initialize Firebase listeners\n   479→    function initFirebaseListeners() {\n   480→      // Listen for enabled state\n   481→      scoreBugRef.child('enabled').on('value', (snapshot) => {\n   482→        state.enabled = snapshot.val() === true;\n   483→        updateBugVisibility();\n   484→      });\n   485→\n   486→      // Listen for polling state\n   487→      scoreBugRef.child('polling').on('value', (snapshot) => {\n   488→        const wasPolling = state.polling;\n   489→        state.polling = snapshot.val() === true;\n   490→        if (state.polling && !wasPolling) {\n   491→          startPolling();\n   492→        } else if (!state.polling && wasPolling) {\n   493→          stopPolling();\n   494→        }\n   495→      });\n   496→\n   497→      // Listen for automation mode\n   498→      scoreBugRef.child('automationMode').on('value', (snapshot) => {\n   499→        state.automationMode = snapshot.val() || 'auto';\n   500→      });\n   501→\n   502→      // Listen for lineup card toggle\n   503→      scoreBugRef.child('showLineup').on('value', (snapshot) => {\n   504→        state.showLineup = snapshot.val();\n   505→        updateLineupCard();\n   506→      });\n   507→\n   508→      // Listen for flash dismissals\n   509→      scoreBugRef.child('dismissFlash').on('value', (snapshot) => {\n   510→        const dismissals = snapshot.val() || {};\n   511→        handleFlashDismissals(dismissals);\n   512→      });\n   513→\n   514→      // Listen for poll interval changes - restart polling with new interval\n   515→      scoreBugRef.child('config/pollInterval').on('value', (snapshot) => {\n   516→        const newInterval = snapshot.val() || 5000;\n   517→        const wasPolling = state.polling && pollTimer !== null;\n   518→        state.pollInterval = newInterval;\n   519→\n   520→        // Restart polling with new interval if currently polling\n   521→        if (wasPolling) {\n   522→          console.log('Poll interval changed to', newInterval, 'ms - restarting polling');\n   523→          stopPolling();\n   524→          startPolling();\n   525→        }\n   526→      });\n   527→\n   528→      // Listen for flash duration changes\n   529→      scoreBugRef.child('config/flashDuration').on('value', (snapshot) => {\n   530→        state.flashDuration = snapshot.val() || 10000;\n   531→      });\n   532→\n   533→      console.log('Firebase listeners initialized');\n   534→    }\n   535→\n   536→    // Update bug visibility based on enabled state\n   537→    function updateBugVisibility() {\n   538→      const bugEl = document.getElementById('scoreBug');\n   539→      if (state.enabled) {\n   540→        bugEl.classList.add('visible');\n   541→      } else {\n   542→        bugEl.classList.remove('visible');\n   543→      }\n   544→    }\n   545→\n   546→    // Update lineup card visibility\n   547→    function updateLineupCard() {\n   548→      const cardEl = document.getElementById('lineupCard');\n   549→      if (state.showLineup) {\n   550→        cardEl.classList.add('visible');\n   551→        // TODO: Populate lineup card content (Phase C)\n   552→      } else {\n   553→        cardEl.classList.remove('visible');\n   554→      }\n   555→    }\n   556→\n   557→    // Handle flash dismissals from producer\n   558→    function handleFlashDismissals(dismissals) {\n   559→      // TODO: Implement flash dismissal handling (Task A12c)\n   560→    }\n   561→\n   562→    // Polling management\n   563→    let pollTimer = null;\n   564→\n   565→    function startPolling() {\n   566→      if (pollTimer) return;\n   567→      console.log('Starting API polling');\n   568→      poll();  // Initial poll\n   569→      pollTimer = setInterval(poll, state.pollInterval);\n   570→    }\n   571→\n   572→    function stopPolling() {\n   573→      if (pollTimer) {\n   574→        clearInterval(pollTimer);\n   575→        pollTimer = null;\n   576→        console.log('Stopped API polling');\n   577→      }\n   578→    }\n   579→\n   580→    // Main poll function - fetches data from Virtius API\n   581→    async function poll() {\n   582→      // Check if we have a valid session ID\n   583→      if (!state.virtiusSessionId) {\n   584→        console.warn('No Virtius session ID - skipping poll');\n   585→        return;\n   586→      }\n   587→\n   588→      const pollStartTime = Date.now();\n   589→\n   590→      try {\n   591→        // Fetch from Virtius API\n   592→        const response = await fetch(`https://api.virti.us/session/${state.virtiusSessionId}/json`);\n   593→\n   594→        if (!response.ok) {\n   595→          throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   596→        }\n   597→\n   598→        const data = await response.json();\n   599→\n   600→        // Store raw API data for score diff engine (Task A5)\n   601→        // Extract teams array from meet data\n   602→        const teams = data.meet?.teams || [];\n   603→\n   604→        if (teams.length === 0) {\n   605→          console.warn('No teams found in API response');\n   606→        }\n   607→\n   608→        // Store the latest API data in state\n   609→        state.lastApiData = data;\n   610→        state.lastApiTeams = teams;\n   611→\n   612→        // Extract team totals and update state.teams with actual data\n   613→        // final_score comes as a string from API - convert to float for display\n   614→        teams.forEach((apiTeam, idx) => {\n   615→          // Match API team to our configured teams by index or name\n   616→          const stateTeam = state.teams[idx];\n   617→          if (stateTeam) {\n   618→            // Convert string final_score to formatted number\n   619→            const rawScore = apiTeam.final_score;\n   620→            if (rawScore !== null && rawScore !== undefined) {\n   621→              const numScore = parseFloat(rawScore);\n   622→              stateTeam.total = isNaN(numScore) ? '--' : numScore.toFixed(3);\n   623→            }\n   624→            // Store API team reference for score diff engine\n   625→            stateTeam.apiTeam = apiTeam;\n   626→          }\n   627→        });\n   628→\n   629→        // Write heartbeat to Firebase on successful poll\n   630→        await scoreBugRef.child('heartbeat').set(pollStartTime);\n   631→\n   632→        console.log('Poll successful:', {\n   633→          sessionId: state.virtiusSessionId,\n   634→          teamCount: teams.length,\n   635→          teams: state.teams.map(t => ({ name: t.name, total: t.total }))\n   636→        });\n   637→\n   638→        // Process API data - detect changes and write deltas to Firebase\n   639→        await processApiData(teams, pollStartTime);\n   640→\n   641→      } catch (err) {\n   642→        // Error handling with exponential backoff (A3c)\n   643→        state.consecutiveErrors++;\n   644→        state.lastError = err.message;\n   645→        state.lastErrorTime = pollStartTime;\n   646→\n   647→        // Calculate backoff delay: 5s, 10s, 20s, 40s, 60s (max)\n   648→        const backoffDelay = Math.min(\n   649→          state.pollInterval * Math.pow(2, state.consecutiveErrors - 1),\n   650→          state.maxBackoffMs\n   651→        );\n   652→\n   653→        console.error('Poll failed:', {\n   654→          error: err.message,\n   655→          consecutiveErrors: state.consecutiveErrors,\n   656→          nextRetryIn: `${backoffDelay / 1000}s`\n   657→        });\n   658→\n   659→        // Write error state to Firebase for producer panel visibility (D5b)\n   660→        try {\n   661→          await scoreBugRef.child('apiError').set({\n   662→            message: err.message,\n   663→            consecutiveErrors: state.consecutiveErrors,\n   664→            timestamp: pollStartTime,\n   665→            nextRetryMs: backoffDelay\n   666→          });\n   667→          // Still write heartbeat to indicate overlay is running\n   668→          await scoreBugRef.child('heartbeat').set(pollStartTime);\n   669→        } catch (firebaseErr) {\n   670→          console.error('Failed to write error state to Firebase:', firebaseErr);\n   671→        }\n   672→\n   673→        // Schedule next poll with backoff delay if we're still supposed to be polling\n   674→        if (state.polling && pollTimer) {\n   675→          clearInterval(pollTimer);\n   676→          pollTimer = setTimeout(() => {\n   677→            if (state.polling) {\n   678→              poll();\n   679→              // If poll succeeds, startPolling() will be called to restore normal interval\n   680→            }\n   681→          }, backoffDelay);\n   682→        }\n   683→        return; // Skip normal completion\n   684→      }\n   685→\n   686→      // Success - reset error state\n   687→      if (state.consecutiveErrors > 0) {\n   688→        console.log('Poll recovered after', state.consecutiveErrors, 'consecutive errors');\n   689→        state.consecutiveErrors = 0;\n   690→        state.lastError = null;\n   691→        state.lastErrorTime = null;\n   692→\n   693→        // Clear error state in Firebase\n   694→        await scoreBugRef.child('apiError').remove();\n   695→\n   696→        // Restore normal polling interval (we might be on backoff timeout)\n   697→        if (state.polling && pollTimer) {\n   698→          clearTimeout(pollTimer);\n   699→          clearInterval(pollTimer);\n   700→          pollTimer = setInterval(poll, state.pollInterval);\n   701→        }\n   702→      }\n   703→    }\n   704→\n   705→    /**\n   706→     * Process API data - detect score changes and write incremental deltas to Firebase.\n   707→     * Only writes changed paths, not full data rewrite.\n   708→     * @param {Array} apiTeams - Teams array from Virtius API\n   709→     * @param {number} pollTimestamp - Timestamp of this poll\n   710→     */\n   711→    async function processApiData(apiTeams, pollTimestamp) {\n   712→      const changedPaths = {};\n   713→      let hasChanges = false;\n   714→\n   715→      // Process each team\n   716→      apiTeams.forEach((team, teamIdx) => {\n   717→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n   718→\n   719→        // Check if team total changed\n   720→        const prevTeamTotal = state.previousTeamTotals[teamKey];\n   721→        const currTeamTotal = team.final_score;  // string or null\n   722→\n   723→        if (currTeamTotal !== prevTeamTotal) {\n   724→          changedPaths[`teams/${teamKey}/finalScore`] = currTeamTotal;\n   725→          changedPaths[`teams/${teamKey}/name`] = team.name || teamKey;\n   726→          hasChanges = true;\n   727→        }\n   728→\n   729→        // Process each event's gymnasts for score changes\n   730→        const events = team.events || [];\n   731→        events.forEach((event) => {\n   732→          const eventKey = event.short_name || event.name || 'unknown';\n   733→          const gymnasts = event.gymnasts || [];\n   734→\n   735→          gymnasts.forEach((gymnast) => {\n   736→            // Primary key: gymnast_id. Fallback: teamKey|normalizedName\n   737→            const gymnastKey = gymnast.gymnast_id ||\n   738→              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n   739→\n   740→            const prevScore = state.previousScores[gymnastKey];\n   741→            const currScore = gymnast.final_score;  // string or null\n   742→\n   743→            // Score changed (new score OR corrected score)\n   744→            if (currScore != null && prevScore !== currScore) {\n   745→              // Build gymnast data for Firebase\n   746→              const gymnastData = {\n   747→                name: gymnast.full_name,\n   748→                score: currScore,\n   749→                startValue: gymnast.start_value || null,\n   750→                execution: gymnast.execution || null,\n   751→                difficulty: gymnast.difficulty || null,\n   752→                order: gymnast.order,\n   753→                event: eventKey,\n   754→                team: teamKey,\n   755→                timestamp: pollTimestamp\n   756→              };\n   757→\n   758→              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}`] = gymnastData;\n   759→              hasChanges = true;\n   760→\n   761→              console.log('Score change detected:', {\n   762→                gymnast: gymnast.full_name,\n   763→                event: eventKey,\n   764→                team: teamKey,\n   765→                prev: prevScore,\n   766→                curr: currScore\n   767→              });\n   768→            }\n   769→\n   770→            // Score removed (rare - inquiry pending)\n   771→            if (currScore == null && prevScore != null) {\n   772→              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}/score`] = null;\n   773→              hasChanges = true;\n   774→              console.log('Score removed:', { gymnast: gymnast.full_name, event: eventKey });\n   775→            }\n   776→          });\n   777→        });\n   778→      });\n   779→\n   780→      // Write to Firebase\n   781→      try {\n   782→        if (hasChanges) {\n   783→          // Write changed paths and reset stale counter\n   784→          await scoreBugRef.child('liveData').update({\n   785→            ...changedPaths,\n   786→            lastDataChangeTimestamp: pollTimestamp,\n   787→            stalePollCount: 0\n   788→          });\n   789→          state.stalePollCount = 0;\n   790→\n   791→          console.log('Wrote incremental deltas to Firebase:', Object.keys(changedPaths).length, 'paths');\n   792→        } else {\n   793→          // No changes - increment stale counter\n   794→          state.stalePollCount++;\n   795→          await scoreBugRef.child('liveData').update({\n   796→            lastPollTimestamp: pollTimestamp,\n   797→            stalePollCount: state.stalePollCount\n   798→          });\n   799→        }\n   800→      } catch (err) {\n   801→        console.error('Failed to write liveData:', err);\n   802→      }\n   803→\n   804→      // Update previous state for next comparison\n   805→      state.previousScores = buildScoreMap(apiTeams);\n   806→      state.previousTeamTotals = buildTeamTotalMap(apiTeams);\n   807→    }\n   808→\n   809→    /**\n   810→     * Build score map from API teams data.\n   811→     * @returns {Object} Map of gymnastKey -> finalScore (string)\n   812→     */\n   813→    function buildScoreMap(apiTeams) {\n   814→      const map = {};\n   815→      apiTeams.forEach((team, teamIdx) => {\n   816→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n   817→        const events = team.events || [];\n   818→\n   819→        events.forEach((event) => {\n   820→          const gymnasts = event.gymnasts || [];\n   821→          gymnasts.forEach((gymnast) => {\n   822→            const gymnastKey = gymnast.gymnast_id ||\n   823→              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n   824→            map[gymnastKey] = gymnast.final_score;  // string or null\n   825→          });\n   826→        });\n   827→      });\n   828→      return map;\n   829→    }\n   830→\n   831→    /**\n   832→     * Build team total map from API teams data.\n   833→     * @returns {Object} Map of teamKey -> finalScore (string)\n   834→     */\n   835→    function buildTeamTotalMap(apiTeams) {\n   836→      const map = {};\n   837→      apiTeams.forEach((team, teamIdx) => {\n   838→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n   839→        map[teamKey] = team.final_score;  // string or null\n   840→      });\n   841→      return map;\n   842→    }\n   843→\n   844→    // Initialize Firebase schema with default values (prevents race conditions)\n   845→    // Uses update() with null checks - only sets values that don't exist\n   846→    async function initializeSchema() {\n   847→      const defaultSchema = {\n   848→        enabled: false,\n   849→        polling: false,\n   850→        automationMode: 'auto',\n   851→        showLineup: null,\n   852→        dismissFlash: {},\n   853→        nowCompeting: {},\n   854→        detected: {},\n   855→        heartbeat: null,\n   856→        liveData: {\n   857→          lastPollTimestamp: null,\n   858→          lastDataChangeTimestamp: null,\n   859→          stalePollCount: 0,\n   860→          rotation: null,\n   861→          totalRotations: null,\n   862→          teams: {}\n   863→        },\n   864→        lastError: null,\n   865→        config: {\n   866→          pollInterval: 5000,\n   867→          flashDuration: 10000,\n   868→          showStickIndicator: true\n   869→        }\n   870→      };\n   871→\n   872→      try {\n   873→        // Use transaction to safely initialize schema without overwriting existing values\n   874→        await scoreBugRef.transaction((currentData) => {\n   875→          if (currentData === null) {\n   876→            // No data exists - write full schema\n   877→            console.log('Initializing scoreBug schema with defaults');\n   878→            return defaultSchema;\n   879→          }\n   880→          // Data exists - merge defaults for any missing fields only\n   881→          const merged = { ...defaultSchema };\n   882→          Object.keys(currentData).forEach(key => {\n   883→            if (currentData[key] !== undefined) {\n   884→              // Keep existing value\n   885→              merged[key] = currentData[key];\n   886→            }\n   887→          });\n   888→          // Deep merge for nested objects (config, liveData)\n   889→          if (currentData.config) {\n   890→            merged.config = { ...defaultSchema.config, ...currentData.config };\n   891→          }\n   892→          if (currentData.liveData) {\n   893→            merged.liveData = { ...defaultSchema.liveData, ...currentData.liveData };\n   894→          }\n   895→          console.log('Merged existing scoreBug data with defaults');\n   896→          return merged;\n   897→        });\n   898→        console.log('Firebase schema initialized');\n   899→      } catch (err) {\n   900→        console.error('Failed to initialize schema:', err);\n   901→      }\n   902→    }\n   903→\n   904→    // Initialize on load\n   905→    if (compId) {\n   906→      // Order: load config -> render teams -> initialize schema -> start listeners\n   907→      loadCompetitionConfig().then((success) => {\n   908→        if (!success) return;\n   909→\n   910→        // Render team rows with initial state (before API data)\n   911→        renderTeamRows();\n   912→\n   913→        // Initialize Firebase schema (safe defaults)\n   914→        return initializeSchema();\n   915→      }).then(() => {\n   916→        // Start listening for Firebase changes\n   917→        initFirebaseListeners();\n   918→      });\n   919→    }\n   920→  </script>\n   921→</body>\n   922→</html>\n   923→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ea907497-cb76-4346-a60f-98941ef1f5a3","uuid":"567ca8ba-2875-47b8-8fba-d9ff410f1261","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/overlays/team-bug.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=1920, height=1080\">\n  <title>Team Score Bug</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n\n  <!-- Firebase SDK -->\n  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js\"></script>\n  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js\"></script>\n\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n\n    body {\n      font-family: 'Inter', sans-serif;\n      width: 1920px;\n      height: 1080px;\n      overflow: hidden;\n      background: transparent;\n    }\n\n    /* Score bug container - positioned on right side of screen */\n    .score-bug {\n      position: absolute;\n      top: 50%;\n      right: 0;\n      transform: translateY(-50%) translateX(100%);\n      display: flex;\n      flex-direction: column;\n      min-width: 500px;\n      opacity: 0;\n      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n\n    .score-bug.visible {\n      transform: translateY(-50%) translateX(0);\n      opacity: 1;\n    }\n\n    /* Rotation tag at top */\n    .rotation-tag {\n      background: #27272a;\n      color: #fff;\n      font-size: 20px;\n      font-weight: 700;\n      padding: 10px 20px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n\n    /* Team rows container */\n    .team-rows {\n      display: flex;\n      flex-direction: column;\n    }\n\n    /* Individual team row */\n    .team-row {\n      display: flex;\n      flex-direction: row;\n      background: #1a1a1a;\n      border-bottom: 1px solid #333;\n      min-height: 70px;\n    }\n\n    .team-row:last-child {\n      border-bottom: none;\n    }\n\n    /* Fixed left section: logo + total */\n    .team-fixed {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 10px 15px;\n      min-width: 100px;\n      background: #000;\n    }\n\n    .team-logo {\n      width: 40px;\n      height: 40px;\n      object-fit: contain;\n    }\n\n    .team-total {\n      font-size: 22px;\n      font-weight: 900;\n      color: #fff;\n      margin-top: 4px;\n    }\n\n    .team-total.highlight {\n      animation: totalPulse 0.5s ease;\n    }\n\n    @keyframes totalPulse {\n      0%, 100% { transform: scale(1); color: #fff; }\n      50% { transform: scale(1.1); color: #22d3ee; }\n    }\n\n    /* Slot area for score flash / now competing */\n    .team-slot {\n      flex: 1;\n      display: flex;\n      align-items: center;\n      padding: 10px 20px;\n      overflow: hidden;\n      position: relative;\n    }\n\n    /* Slot content (animates up/down) */\n    .slot-content {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      transform: translateY(0);\n      transition: transform 0.4s ease, opacity 0.4s ease;\n      opacity: 0;\n    }\n\n    .slot-content.visible {\n      opacity: 1;\n    }\n\n    .slot-content.exit-up {\n      transform: translateY(-100%);\n      opacity: 0;\n    }\n\n    .slot-content.enter-from-below {\n      transform: translateY(100%);\n      opacity: 0;\n    }\n\n    /* Headshot in slot */\n    .slot-headshot {\n      width: 36px;\n      height: 36px;\n      border-radius: 50%;\n      object-fit: cover;\n      flex-shrink: 0;\n    }\n\n    /* Athlete name in slot */\n    .slot-name {\n      font-size: 24px;\n      font-weight: 700;\n      color: #fff;\n      white-space: nowrap;\n    }\n\n    /* Score in slot */\n    .slot-score {\n      font-size: 28px;\n      font-weight: 900;\n      color: #fff;\n    }\n\n    /* Apparatus code */\n    .slot-apparatus {\n      font-size: 18px;\n      font-weight: 600;\n      color: #a1a1aa;\n      text-transform: uppercase;\n    }\n\n    /* Start value */\n    .slot-sv {\n      font-size: 16px;\n      font-weight: 400;\n      color: #71717a;\n    }\n\n    /* Stick indicator */\n    .slot-stick {\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      background: #22c55e;\n      color: #fff;\n      font-size: 14px;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    /* Separator dot */\n    .slot-separator {\n      color: #52525b;\n      font-size: 20px;\n    }\n\n    /* Lineup card (above bug) */\n    .lineup-card {\n      position: absolute;\n      bottom: 100%;\n      right: 0;\n      width: 100%;\n      background: #1a1a1a;\n      transform: translateY(100%);\n      opacity: 0;\n      transition: transform 0.4s ease, opacity 0.4s ease;\n      margin-bottom: 8px;\n    }\n\n    .lineup-card.visible {\n      transform: translateY(0);\n      opacity: 1;\n    }\n\n    .lineup-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 20px;\n      background: #27272a;\n    }\n\n    .lineup-team-name {\n      font-size: 22px;\n      font-weight: 800;\n      color: #fff;\n      text-transform: uppercase;\n    }\n\n    .lineup-logo {\n      width: 32px;\n      height: 32px;\n      object-fit: contain;\n    }\n\n    .lineup-athletes {\n      padding: 8px 0;\n    }\n\n    .lineup-athlete {\n      display: flex;\n      align-items: center;\n      padding: 8px 20px;\n      gap: 12px;\n    }\n\n    .lineup-order {\n      font-size: 16px;\n      font-weight: 600;\n      color: #71717a;\n      min-width: 24px;\n    }\n\n    .lineup-name {\n      flex: 1;\n      font-size: 20px;\n      font-weight: 600;\n      color: #fff;\n    }\n\n    .lineup-sv {\n      font-size: 16px;\n      font-weight: 400;\n      color: #71717a;\n      min-width: 40px;\n      text-align: right;\n    }\n\n    .lineup-score {\n      font-size: 22px;\n      font-weight: 700;\n      color: #fff;\n      min-width: 70px;\n      text-align: right;\n    }\n\n    .lineup-score.pending {\n      color: #52525b;\n    }\n\n    .lineup-footer {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 20px;\n      background: #27272a;\n    }\n\n    .lineup-event {\n      font-size: 18px;\n      font-weight: 600;\n      color: #a1a1aa;\n      text-transform: uppercase;\n    }\n\n    .lineup-total {\n      font-size: 26px;\n      font-weight: 800;\n      color: #fff;\n    }\n\n    /* Loading / error states */\n    .loading-state {\n      color: #71717a;\n      font-size: 18px;\n      padding: 20px;\n      text-align: center;\n    }\n\n    .error-state {\n      color: #ef4444;\n      font-size: 18px;\n      padding: 20px;\n      text-align: center;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"score-bug\" id=\"scoreBug\">\n    <div class=\"lineup-card\" id=\"lineupCard\">\n      <!-- Lineup card content populated dynamically -->\n    </div>\n    <div class=\"rotation-tag\" id=\"rotationTag\">Rotation 1 of 6</div>\n    <div class=\"team-rows\" id=\"teamRows\">\n      <!-- Team rows populated dynamically -->\n    </div>\n  </div>\n\n  <script>\n    // Firebase configuration\n    const firebaseConfig = {\n      apiKey: \"AIzaSyCh0aZUvKl6Qvqsva3hvOgJJlleP1OwcTY\",\n      authDomain: \"gymnastics-graphics.firebaseapp.com\",\n      databaseURL: \"https://gymnastics-graphics-default-rtdb.firebaseio.com\",\n      projectId: \"gymnastics-graphics\",\n      storageBucket: \"gymnastics-graphics.firebasestorage.app\",\n      messagingSenderId: \"702072609550\",\n      appId: \"1:702072609550:web:ac74a811186d3ff45b955f\"\n    };\n\n    // Initialize Firebase\n    firebase.initializeApp(firebaseConfig);\n    const db = firebase.database();\n\n    // Parse URL parameters\n    const params = new URLSearchParams(window.location.search);\n    const compId = params.get('compId');\n\n    if (!compId) {\n      console.error('Missing compId parameter');\n      document.body.innerHTML = '<div class=\"error-state\">Missing compId parameter</div>';\n    }\n\n    // State management\n    const state = {\n      enabled: false,\n      polling: false,\n      automationMode: 'auto',\n      showLineup: null,\n      teams: [],\n      rotation: { current: 1, total: 6, isFinal: false },\n      previousScores: {},        // { \"gymnast_id\": \"finalScore\" (string) }\n      previousTeamTotals: {},    // { \"teamKey\": \"finalScore\" (string) }\n      flashQueues: {},           // Per-team flash queues\n      activeFlashes: {},         // Currently active flashes per team\n      pollInterval: 5000,\n      flashDuration: 10000,\n      stalePollCount: 0,         // Consecutive polls with no data changes\n      // Competition config (loaded from Firebase)\n      competitionConfig: null,\n      virtiusSessionId: null,\n      gender: 'mens',\n      // Error handling state (A3c)\n      consecutiveErrors: 0,      // Count of consecutive poll failures\n      lastError: null,           // Last error message\n      lastErrorTime: null,       // Timestamp of last error\n      maxBackoffMs: 60000        // Max backoff delay (60 seconds)\n    };\n\n    /**\n     * Normalize athlete name for lookup (lowercase, remove special chars).\n     * Matches pattern used in output.html for headshot lookups.\n     */\n    function normalizeName(name) {\n      if (!name) return '';\n      return name.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');\n    }\n\n    // Firebase paths\n    const scoreBugRef = db.ref(`competitions/${compId}/scoreBug`);\n    const configRef = db.ref(`competitions/${compId}/config`);\n\n    /**\n     * Load competition config from Firebase.\n     * Gets virtiusSessionId, team names/logos, gender, and compType.\n     * Must be called before initializing Firebase listeners.\n     */\n    async function loadCompetitionConfig() {\n      try {\n        const snapshot = await configRef.once('value');\n        const config = snapshot.val();\n\n        if (!config) {\n          console.error('No competition config found for compId:', compId);\n          document.body.innerHTML = '<div class=\"error-state\">Competition not found</div>';\n          return false;\n        }\n\n        state.competitionConfig = config;\n        state.virtiusSessionId = config.virtiusSessionId || null;\n        state.gender = config.gender || 'mens';\n\n        // Build teams array from config (up to 6 teams)\n        state.teams = [];\n        for (let i = 1; i <= 6; i++) {\n          const teamName = config[`team${i}Name`];\n          if (teamName) {\n            state.teams.push({\n              index: i,\n              name: teamName,\n              logo: config[`team${i}Logo`] || '',\n              tricode: config[`team${i}Tricode`] || '',\n              total: '--'  // Initial state before first API poll\n            });\n          }\n        }\n\n        // Determine total rotations based on gender (6 for men, 4 for women)\n        state.rotation.total = state.gender === 'womens' ? 4 : 6;\n\n        console.log('Competition config loaded:', {\n          compId,\n          virtiusSessionId: state.virtiusSessionId,\n          gender: state.gender,\n          teamCount: state.teams.length,\n          teams: state.teams.map(t => t.name)\n        });\n\n        // Check if Virtius session ID is configured\n        if (!state.virtiusSessionId) {\n          console.warn('No Virtius session ID configured - API polling will not work');\n        }\n\n        return true;\n      } catch (err) {\n        console.error('Failed to load competition config:', err);\n        document.body.innerHTML = '<div class=\"error-state\">Failed to load competition config</div>';\n        return false;\n      }\n    }\n\n    /**\n     * Render initial team rows based on competition config.\n     * Called after loadCompetitionConfig() to show teams before API polling starts.\n     */\n    function renderTeamRows() {\n      const container = document.getElementById('teamRows');\n      if (!container) return;\n\n      container.innerHTML = state.teams.map((team, idx) => `\n        <div class=\"team-row\" data-team-index=\"${team.index}\">\n          <div class=\"team-fixed\">\n            <img class=\"team-logo\" src=\"${team.logo}\" alt=\"${team.name}\" onerror=\"this.style.display='none'\">\n            <div class=\"team-total\" id=\"teamTotal${team.index}\">${team.total}</div>\n          </div>\n          <div class=\"team-slot\" id=\"teamSlot${team.index}\">\n            <div class=\"slot-content\" id=\"slotContent${team.index}\">\n              <!-- Score flash / now competing content populated dynamically -->\n            </div>\n          </div>\n        </div>\n      `).join('');\n\n      console.log('Team rows rendered:', state.teams.length);\n    }\n\n    // Initialize Firebase listeners\n    function initFirebaseListeners() {\n      // Listen for enabled state\n      scoreBugRef.child('enabled').on('value', (snapshot) => {\n        state.enabled = snapshot.val() === true;\n        updateBugVisibility();\n      });\n\n      // Listen for polling state\n      scoreBugRef.child('polling').on('value', (snapshot) => {\n        const wasPolling = state.polling;\n        state.polling = snapshot.val() === true;\n        if (state.polling && !wasPolling) {\n          startPolling();\n        } else if (!state.polling && wasPolling) {\n          stopPolling();\n        }\n      });\n\n      // Listen for automation mode\n      scoreBugRef.child('automationMode').on('value', (snapshot) => {\n        state.automationMode = snapshot.val() || 'auto';\n      });\n\n      // Listen for lineup card toggle\n      scoreBugRef.child('showLineup').on('value', (snapshot) => {\n        state.showLineup = snapshot.val();\n        updateLineupCard();\n      });\n\n      // Listen for flash dismissals\n      scoreBugRef.child('dismissFlash').on('value', (snapshot) => {\n        const dismissals = snapshot.val() || {};\n        handleFlashDismissals(dismissals);\n      });\n\n      // Listen for poll interval changes - restart polling with new interval\n      scoreBugRef.child('config/pollInterval').on('value', (snapshot) => {\n        const newInterval = snapshot.val() || 5000;\n        const wasPolling = state.polling && pollTimer !== null;\n        state.pollInterval = newInterval;\n\n        // Restart polling with new interval if currently polling\n        if (wasPolling) {\n          console.log('Poll interval changed to', newInterval, 'ms - restarting polling');\n          stopPolling();\n          startPolling();\n        }\n      });\n\n      // Listen for flash duration changes\n      scoreBugRef.child('config/flashDuration').on('value', (snapshot) => {\n        state.flashDuration = snapshot.val() || 10000;\n      });\n\n      console.log('Firebase listeners initialized');\n    }\n\n    // Update bug visibility based on enabled state\n    function updateBugVisibility() {\n      const bugEl = document.getElementById('scoreBug');\n      if (state.enabled) {\n        bugEl.classList.add('visible');\n      } else {\n        bugEl.classList.remove('visible');\n      }\n    }\n\n    // Update lineup card visibility\n    function updateLineupCard() {\n      const cardEl = document.getElementById('lineupCard');\n      if (state.showLineup) {\n        cardEl.classList.add('visible');\n        // TODO: Populate lineup card content (Phase C)\n      } else {\n        cardEl.classList.remove('visible');\n      }\n    }\n\n    // Handle flash dismissals from producer\n    function handleFlashDismissals(dismissals) {\n      // TODO: Implement flash dismissal handling (Task A12c)\n    }\n\n    // Polling management\n    let pollTimer = null;\n\n    function startPolling() {\n      if (pollTimer) return;\n      console.log('Starting API polling');\n      poll();  // Initial poll\n      pollTimer = setInterval(poll, state.pollInterval);\n    }\n\n    function stopPolling() {\n      if (pollTimer) {\n        clearInterval(pollTimer);\n        pollTimer = null;\n        console.log('Stopped API polling');\n      }\n    }\n\n    // Main poll function - fetches data from Virtius API\n    async function poll() {\n      // Check if we have a valid session ID\n      if (!state.virtiusSessionId) {\n        console.warn('No Virtius session ID - skipping poll');\n        return;\n      }\n\n      const pollStartTime = Date.now();\n\n      try {\n        // Fetch from Virtius API\n        const response = await fetch(`https://api.virti.us/session/${state.virtiusSessionId}/json`);\n\n        if (!response.ok) {\n          throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n        }\n\n        const data = await response.json();\n\n        // Store raw API data for score diff engine (Task A5)\n        // Extract teams array from meet data\n        const teams = data.meet?.teams || [];\n\n        if (teams.length === 0) {\n          console.warn('No teams found in API response');\n        }\n\n        // Store the latest API data in state\n        state.lastApiData = data;\n        state.lastApiTeams = teams;\n\n        // Extract team totals and update state.teams with actual data\n        // final_score comes as a string from API - convert to float for display\n        teams.forEach((apiTeam, idx) => {\n          // Match API team to our configured teams by index or name\n          const stateTeam = state.teams[idx];\n          if (stateTeam) {\n            // Convert string final_score to formatted number\n            const rawScore = apiTeam.final_score;\n            if (rawScore !== null && rawScore !== undefined) {\n              const numScore = parseFloat(rawScore);\n              stateTeam.total = isNaN(numScore) ? '--' : numScore.toFixed(3);\n            }\n            // Store API team reference for score diff engine\n            stateTeam.apiTeam = apiTeam;\n          }\n        });\n\n        // Write heartbeat to Firebase on successful poll\n        await scoreBugRef.child('heartbeat').set(pollStartTime);\n\n        console.log('Poll successful:', {\n          sessionId: state.virtiusSessionId,\n          teamCount: teams.length,\n          teams: state.teams.map(t => ({ name: t.name, total: t.total }))\n        });\n\n        // Process API data - detect changes and write deltas to Firebase\n        await processApiData(teams, pollStartTime);\n\n      } catch (err) {\n        // Error handling with exponential backoff (A3c)\n        state.consecutiveErrors++;\n        state.lastError = err.message;\n        state.lastErrorTime = pollStartTime;\n\n        // Calculate backoff delay: 5s, 10s, 20s, 40s, 60s (max)\n        const backoffDelay = Math.min(\n          state.pollInterval * Math.pow(2, state.consecutiveErrors - 1),\n          state.maxBackoffMs\n        );\n\n        console.error('Poll failed:', {\n          error: err.message,\n          consecutiveErrors: state.consecutiveErrors,\n          nextRetryIn: `${backoffDelay / 1000}s`\n        });\n\n        // Write error state to Firebase for producer panel visibility (D5b)\n        try {\n          await scoreBugRef.child('apiError').set({\n            message: err.message,\n            consecutiveErrors: state.consecutiveErrors,\n            timestamp: pollStartTime,\n            nextRetryMs: backoffDelay\n          });\n          // Still write heartbeat to indicate overlay is running\n          await scoreBugRef.child('heartbeat').set(pollStartTime);\n        } catch (firebaseErr) {\n          console.error('Failed to write error state to Firebase:', firebaseErr);\n        }\n\n        // Schedule next poll with backoff delay if we're still supposed to be polling\n        if (state.polling && pollTimer) {\n          clearInterval(pollTimer);\n          pollTimer = setTimeout(() => {\n            if (state.polling) {\n              poll();\n              // If poll succeeds, startPolling() will be called to restore normal interval\n            }\n          }, backoffDelay);\n        }\n        return; // Skip normal completion\n      }\n\n      // Success - reset error state\n      if (state.consecutiveErrors > 0) {\n        console.log('Poll recovered after', state.consecutiveErrors, 'consecutive errors');\n        state.consecutiveErrors = 0;\n        state.lastError = null;\n        state.lastErrorTime = null;\n\n        // Clear error state in Firebase\n        await scoreBugRef.child('apiError').remove();\n\n        // Restore normal polling interval (we might be on backoff timeout)\n        if (state.polling && pollTimer) {\n          clearTimeout(pollTimer);\n          clearInterval(pollTimer);\n          pollTimer = setInterval(poll, state.pollInterval);\n        }\n      }\n    }\n\n    /**\n     * Process API data - detect score changes and write incremental deltas to Firebase.\n     * Only writes changed paths, not full data rewrite.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @param {number} pollTimestamp - Timestamp of this poll\n     */\n    async function processApiData(apiTeams, pollTimestamp) {\n      const changedPaths = {};\n      let hasChanges = false;\n\n      // Process each team\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n\n        // Check if team total changed\n        const prevTeamTotal = state.previousTeamTotals[teamKey];\n        const currTeamTotal = team.final_score;  // string or null\n\n        if (currTeamTotal !== prevTeamTotal) {\n          changedPaths[`teams/${teamKey}/finalScore`] = currTeamTotal;\n          changedPaths[`teams/${teamKey}/name`] = team.name || teamKey;\n          hasChanges = true;\n        }\n\n        // Process each event's gymnasts for score changes\n        const events = team.events || [];\n        events.forEach((event) => {\n          const eventKey = event.short_name || event.name || 'unknown';\n          const gymnasts = event.gymnasts || [];\n\n          gymnasts.forEach((gymnast) => {\n            // Primary key: gymnast_id. Fallback: teamKey|normalizedName\n            const gymnastKey = gymnast.gymnast_id ||\n              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n\n            const prevScore = state.previousScores[gymnastKey];\n            const currScore = gymnast.final_score;  // string or null\n\n            // Score changed (new score OR corrected score)\n            if (currScore != null && prevScore !== currScore) {\n              // Build gymnast data for Firebase\n              const gymnastData = {\n                name: gymnast.full_name,\n                score: currScore,\n                startValue: gymnast.start_value || null,\n                execution: gymnast.execution || null,\n                difficulty: gymnast.difficulty || null,\n                order: gymnast.order,\n                event: eventKey,\n                team: teamKey,\n                timestamp: pollTimestamp\n              };\n\n              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}`] = gymnastData;\n              hasChanges = true;\n\n              console.log('Score change detected:', {\n                gymnast: gymnast.full_name,\n                event: eventKey,\n                team: teamKey,\n                prev: prevScore,\n                curr: currScore\n              });\n            }\n\n            // Score removed (rare - inquiry pending)\n            if (currScore == null && prevScore != null) {\n              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}/score`] = null;\n              hasChanges = true;\n              console.log('Score removed:', { gymnast: gymnast.full_name, event: eventKey });\n            }\n          });\n        });\n      });\n\n      // Write to Firebase\n      try {\n        if (hasChanges) {\n          // Write changed paths and reset stale counter\n          await scoreBugRef.child('liveData').update({\n            ...changedPaths,\n            lastDataChangeTimestamp: pollTimestamp,\n            stalePollCount: 0\n          });\n          state.stalePollCount = 0;\n\n          console.log('Wrote incremental deltas to Firebase:', Object.keys(changedPaths).length, 'paths');\n        } else {\n          // No changes - increment stale counter\n          state.stalePollCount++;\n          await scoreBugRef.child('liveData').update({\n            lastPollTimestamp: pollTimestamp,\n            stalePollCount: state.stalePollCount\n          });\n        }\n      } catch (err) {\n        console.error('Failed to write liveData:', err);\n      }\n\n      // Update previous state for next comparison\n      state.previousScores = buildScoreMap(apiTeams);\n      state.previousTeamTotals = buildTeamTotalMap(apiTeams);\n    }\n\n    /**\n     * Build score map from API teams data.\n     * @returns {Object} Map of gymnastKey -> finalScore (string)\n     */\n    function buildScoreMap(apiTeams) {\n      const map = {};\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n        const events = team.events || [];\n\n        events.forEach((event) => {\n          const gymnasts = event.gymnasts || [];\n          gymnasts.forEach((gymnast) => {\n            const gymnastKey = gymnast.gymnast_id ||\n              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n            map[gymnastKey] = gymnast.final_score;  // string or null\n          });\n        });\n      });\n      return map;\n    }\n\n    /**\n     * Build team total map from API teams data.\n     * @returns {Object} Map of teamKey -> finalScore (string)\n     */\n    function buildTeamTotalMap(apiTeams) {\n      const map = {};\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n        map[teamKey] = team.final_score;  // string or null\n      });\n      return map;\n    }\n\n    // Initialize Firebase schema with default values (prevents race conditions)\n    // Uses update() with null checks - only sets values that don't exist\n    async function initializeSchema() {\n      const defaultSchema = {\n        enabled: false,\n        polling: false,\n        automationMode: 'auto',\n        showLineup: null,\n        dismissFlash: {},\n        nowCompeting: {},\n        detected: {},\n        heartbeat: null,\n        liveData: {\n          lastPollTimestamp: null,\n          lastDataChangeTimestamp: null,\n          stalePollCount: 0,\n          rotation: null,\n          totalRotations: null,\n          teams: {}\n        },\n        lastError: null,\n        config: {\n          pollInterval: 5000,\n          flashDuration: 10000,\n          showStickIndicator: true\n        }\n      };\n\n      try {\n        // Use transaction to safely initialize schema without overwriting existing values\n        await scoreBugRef.transaction((currentData) => {\n          if (currentData === null) {\n            // No data exists - write full schema\n            console.log('Initializing scoreBug schema with defaults');\n            return defaultSchema;\n          }\n          // Data exists - merge defaults for any missing fields only\n          const merged = { ...defaultSchema };\n          Object.keys(currentData).forEach(key => {\n            if (currentData[key] !== undefined) {\n              // Keep existing value\n              merged[key] = currentData[key];\n            }\n          });\n          // Deep merge for nested objects (config, liveData)\n          if (currentData.config) {\n            merged.config = { ...defaultSchema.config, ...currentData.config };\n          }\n          if (currentData.liveData) {\n            merged.liveData = { ...defaultSchema.liveData, ...currentData.liveData };\n          }\n          console.log('Merged existing scoreBug data with defaults');\n          return merged;\n        });\n        console.log('Firebase schema initialized');\n      } catch (err) {\n        console.error('Failed to initialize schema:', err);\n      }\n    }\n\n    // Initialize on load\n    if (compId) {\n      // Order: load config -> render teams -> initialize schema -> start listeners\n      loadCompetitionConfig().then((success) => {\n        if (!success) return;\n\n        // Render team rows with initial state (before API data)\n        renderTeamRows();\n\n        // Initialize Firebase schema (safe defaults)\n        return initializeSchema();\n      }).then(() => {\n        // Start listening for Firebase changes\n        initFirebaseListeners();\n      });\n    }\n  </script>\n</body>\n</html>\n","numLines":923,"startLine":1,"totalLines":923}}}
