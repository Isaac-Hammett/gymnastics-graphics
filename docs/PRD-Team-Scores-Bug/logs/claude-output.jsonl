\n   266→      padding: 12px 20px;\n   267→      background: #27272a;\n   268→    }\n   269→\n   270→    .lineup-team-name {\n   271→      font-size: 22px;\n   272→      font-weight: 800;\n   273→      color: #fff;\n   274→      text-transform: uppercase;\n   275→    }\n   276→\n   277→    .lineup-logo {\n   278→      width: 32px;\n   279→      height: 32px;\n   280→      object-fit: contain;\n   281→    }\n   282→\n   283→    .lineup-athletes {\n   284→      padding: 8px 0;\n   285→    }\n   286→\n   287→    .lineup-athlete {\n   288→      display: flex;\n   289→      align-items: center;\n   290→      padding: 8px 20px;\n   291→      gap: 12px;\n   292→    }\n   293→\n   294→    .lineup-order {\n   295→      font-size: 16px;\n   296→      font-weight: 600;\n   297→      color: #71717a;\n   298→      min-width: 24px;\n   299→    }\n   300→\n   301→    .lineup-name {\n   302→      flex: 1;\n   303→      font-size: 20px;\n   304→      font-weight: 600;\n   305→      color: #fff;\n   306→    }\n   307→\n   308→    .lineup-sv {\n   309→      font-size: 16px;\n   310→      font-weight: 400;\n   311→      color: #71717a;\n   312→      min-width: 40px;\n   313→      text-align: right;\n   314→    }\n   315→\n   316→    .lineup-score {\n   317→      font-size: 22px;\n   318→      font-weight: 700;\n   319→      color: #fff;\n   320→      min-width: 70px;\n   321→      text-align: right;\n   322→    }\n   323→\n   324→    .lineup-score.pending {\n   325→      color: #52525b;\n   326→    }\n   327→\n   328→    .lineup-footer {\n   329→      display: flex;\n   330→      justify-content: space-between;\n   331→      align-items: center;\n   332→      padding: 12px 20px;\n   333→      background: #27272a;\n   334→    }\n   335→\n   336→    .lineup-event {\n   337→      font-size: 18px;\n   338→      font-weight: 600;\n   339→      color: #a1a1aa;\n   340→      text-transform: uppercase;\n   341→    }\n   342→\n   343→    .lineup-total {\n   344→      font-size: 26px;\n   345→      font-weight: 800;\n   346→      color: #fff;\n   347→    }\n   348→\n   349→    /* Loading / error states */\n   350→    .loading-state {\n   351→      color: #71717a;\n   352→      font-size: 18px;\n   353→      padding: 20px;\n   354→      text-align: center;\n   355→    }\n   356→\n   357→    .error-state {\n   358→      color: #ef4444;\n   359→      font-size: 18px;\n   360→      padding: 20px;\n   361→      text-align: center;\n   362→    }\n   363→  </style>\n   364→</head>\n   365→<body>\n   366→  <div class=\"score-bug\" id=\"scoreBug\">\n   367→    <div class=\"lineup-card\" id=\"lineupCard\">\n   368→      <!-- Lineup card content populated dynamically -->\n   369→    </div>\n   370→    <div class=\"rotation-tag\" id=\"rotationTag\">Rotation 1 of 6</div>\n   371→    <div class=\"team-rows\" id=\"teamRows\">\n   372→      <!-- Team rows populated dynamically -->\n   373→    </div>\n   374→  </div>\n   375→\n   376→  <script>\n   377→    // Firebase configuration\n   378→    const firebaseConfig = {\n   379→      apiKey: \"AIzaSyCh0aZUvKl6Qvqsva3hvOgJJlleP1OwcTY\",\n   380→      authDomain: \"gymnastics-graphics.firebaseapp.com\",\n   381→      databaseURL: \"https://gymnastics-graphics-default-rtdb.firebaseio.com\",\n   382→      projectId: \"gymnastics-graphics\",\n   383→      storageBucket: \"gymnastics-graphics.firebasestorage.app\",\n   384→      messagingSenderId: \"702072609550\",\n   385→      appId: \"1:702072609550:web:ac74a811186d3ff45b955f\"\n   386→    };\n   387→\n   388→    // Initialize Firebase\n   389→    firebase.initializeApp(firebaseConfig);\n   390→    const db = firebase.database();\n   391→\n   392→    // Parse URL parameters\n   393→    const params = new URLSearchParams(window.location.search);\n   394→    const compId = params.get('compId');\n   395→\n   396→    if (!compId) {\n   397→      console.error('Missing compId parameter');\n   398→      document.body.innerHTML = '<div class=\"error-state\">Missing compId parameter</div>';\n   399→    }\n   400→\n   401→    // State management\n   402→    const state = {\n   403→      enabled: false,\n   404→      polling: false,\n   405→      automationMode: 'auto',\n   406→      showLineup: null,\n   407→      teams: [],\n   408→      rotation: { current: 1, total: 6, isFinal: false },\n   409→      previousScores: {},        // { \"gymnast_id\": \"finalScore\" (string) }\n   410→      previousTeamTotals: {},    // { \"teamKey\": \"finalScore\" (string) }\n   411→      flashQueues: {},           // Per-team flash queues\n   412→      activeFlashes: {},         // Currently active flashes per team\n   413→      nowCompeting: [],          // Currently competing athletes per team (B1)\n   414→      pollInterval: 5000,\n   415→      flashDuration: 10000,\n   416→      stalePollCount: 0,         // Consecutive polls with no data changes\n   417→      // Competition config (loaded from Firebase)\n   418→      competitionConfig: null,\n   419→      virtiusSessionId: null,\n   420→      gender: 'mens',\n   421→      // Error handling state (A3c)\n   422→      consecutiveErrors: 0,      // Count of consecutive poll failures\n   423→      lastError: null,           // Last error message\n   424→      lastErrorTime: null,       // Timestamp of last error\n   425→      maxBackoffMs: 60000,       // Max backoff delay (60 seconds)\n   426→      // Offline/reconnect state (A3d)\n   427→      firebaseConnected: true,   // Firebase connection state\n   428→      pendingWrites: [],         // Writes queued during offline\n   429→      reconnectAttempts: 0       // Count of reconnect attempts\n   430→    };\n   431→\n   432→    /**\n   433→     * Normalize athlete name for lookup (lowercase, remove special chars).\n   434→     * Matches pattern used in output.html for headshot lookups.\n   435→     */\n   436→    function normalizeName(name) {\n   437→      if (!name) return '';\n   438→      return name.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');\n   439→    }\n   440→\n   441→    // Firebase paths\n   442→    const scoreBugRef = db.ref(`competitions/${compId}/scoreBug`);\n   443→    const configRef = db.ref(`competitions/${compId}/config`);\n   444→    const connectedRef = db.ref('.info/connected');\n   445→\n   446→    /**\n   447→     * Initialize Firebase connection monitoring (A3d).\n   448→     * Detects offline/online state and handles reconnection.\n   449→     */\n   450→    function initConnectionMonitor() {\n   451→      connectedRef.on('value', (snapshot) => {\n   452→        const connected = snapshot.val() === true;\n   453→        const wasConnected = state.firebaseConnected;\n   454→        state.firebaseConnected = connected;\n   455→\n   456→        if (connected && !wasConnected) {\n   457→          // Just reconnected\n   458→          console.log('Firebase connected - processing pending writes');\n   459→          state.reconnectAttempts = 0;\n   460→          processPendingWrites();\n   461→\n   462→          // Write reconnect event to Firebase\n   463→          scoreBugRef.child('connectionStatus').set({\n   464→            connected: true,\n   465→            reconnectedAt: Date.now(),\n   466→            pendingWritesProcessed: state.pendingWrites.length\n   467→          });\n   468→        } else if (!connected && wasConnected) {\n   469→          // Just went offline\n   470→          console.warn('Firebase disconnected - writes will be queued');\n   471→          state.reconnectAttempts++;\n   472→\n   473→          // Note: Firebase SDK has offline persistence by default\n   474→          // Writes are automatically queued and synced on reconnect\n   475→        }\n   476→\n   477→        console.log('Firebase connection state:', connected ? 'ONLINE' : 'OFFLINE');\n   478→      });\n   479→    }\n   480→\n   481→    /**\n   482→     * Process any pending writes that were queued during offline.\n   483→     * Firebase SDK handles this automatically, but we log for visibility.\n   484→     */\n   485→    function processPendingWrites() {\n   486→      if (state.pendingWrites.length === 0) return;\n   487→\n   488→      console.log('Processing', state.pendingWrites.length, 'pending writes');\n   489→\n   490→      // Firebase SDK automatically syncs queued writes\n   491→      // Clear our tracking array\n   492→      state.pendingWrites = [];\n   493→    }\n   494→\n   495→    /**\n   496→     * Safe write to Firebase with offline queueing (A3d).\n   497→     * Wraps Firebase write operations to track pending writes during offline.\n   498→     * @param {firebase.database.Reference} ref - Firebase reference\n   499→     * @param {string} method - 'set', 'update', or 'remove'\n   500→     * @param {*} data - Data to write (for set/update)\n   501→     * @returns {Promise}\n   502→     */\n   503→    async function safeWrite(ref, method, data) {\n   504→      const writeOp = { path: ref.toString(), method, data, timestamp: Date.now() };\n   505→\n   506→      if (!state.firebaseConnected) {\n   507→        // Queue the write for tracking (Firebase SDK queues automatically)\n   508→        state.pendingWrites.push(writeOp);\n   509→        console.log('Queued offline write:', writeOp.path, method);\n   510→      }\n   511→\n   512→      try {\n   513→        if (method === 'set') {\n   514→          await ref.set(data);\n   515→        } else if (method === 'update') {\n   516→          await ref.update(data);\n   517→        } else if (method === 'remove') {\n   518→          await ref.remove();\n   519→        }\n   520→        return true;\n   521→      } catch (err) {\n   522→        // Firebase SDK will retry on reconnect\n   523→        console.error('Write failed (will retry on reconnect):', err.message);\n   524→        if (!state.pendingWrites.includes(writeOp)) {\n   525→          state.pendingWrites.push(writeOp);\n   526→        }\n   527→        return false;\n   528→      }\n   529→    }\n   530→\n   531→    /**\n   532→     * Load competition config from Firebase.\n   533→     * Gets virtiusSessionId, team names/logos, gender, and compType.\n   534→     * Must be called before initializing Firebase listeners.\n   535→     */\n   536→    async function loadCompetitionConfig() {\n   537→      try {\n   538→        const snapshot = await configRef.once('value');\n   539→        const config = snapshot.val();\n   540→\n   541→        if (!config) {\n   542→          console.error('No competition config found for compId:', compId);\n   543→          document.body.innerHTML = '<div class=\"error-state\">Competition not found</div>';\n   544→          return false;\n   545→        }\n   546→\n   547→        state.competitionConfig = config;\n   548→        state.virtiusSessionId = config.virtiusSessionId || null;\n   549→        state.gender = config.gender || 'mens';\n   550→\n   551→        // Build teams array from config (up to 6 teams)\n   552→        state.teams = [];\n   553→        for (let i = 1; i <= 6; i++) {\n   554→          const teamName = config[`team${i}Name`];\n   555→          if (teamName) {\n   556→            state.teams.push({\n   557→              index: i,\n   558→              name: teamName,\n   559→              logo: config[`team${i}Logo`] || '',\n   560→              tricode: config[`team${i}Tricode`] || '',\n   561→              total: '--'  // Initial state before first API poll\n   562→            });\n   563→          }\n   564→        }\n   565→\n   566→        // Determine total rotations based on gender (6 for men, 4 for women)\n   567→        state.rotation.total = state.gender === 'womens' ? 4 : 6;\n   568→\n   569→        console.log('Competition config loaded:', {\n   570→          compId,\n   571→          virtiusSessionId: state.virtiusSessionId,\n   572→          gender: state.gender,\n   573→          teamCount: state.teams.length,\n   574→          teams: state.teams.map(t => t.name)\n   575→        });\n   576→\n   577→        // Check if Virtius session ID is configured\n   578→        if (!state.virtiusSessionId) {\n   579→          console.warn('No Virtius session ID configured - API polling will not work');\n   580→        }\n   581→\n   582→        return true;\n   583→      } catch (err) {\n   584→        console.error('Failed to load competition config:', err);\n   585→        document.body.innerHTML = '<div class=\"error-state\">Failed to load competition config</div>';\n   586→        return false;\n   587→      }\n   588→    }\n   589→\n   590→    /**\n   591→     * Render initial team rows based on competition config.\n   592→     * Called after loadCompetitionConfig() to show teams before API polling starts.\n   593→     */\n   594→    function renderTeamRows() {\n   595→      const container = document.getElementById('teamRows');\n   596→      if (!container) return;\n   597→\n   598→      container.innerHTML = state.teams.map((team, idx) => `\n   599→        <div class=\"team-row\" data-team-index=\"${team.index}\">\n   600→          <div class=\"team-fixed\">\n   601→            <img class=\"team-logo\" src=\"${team.logo}\" alt=\"${team.name}\" onerror=\"this.style.display='none'\">\n   602→            <div class=\"team-total\" id=\"teamTotal${team.index}\">${team.total}</div>\n   603→          </div>\n   604→          <div class=\"team-slot\" id=\"teamSlot${team.index}\">\n   605→            <div class=\"slot-content\" id=\"slotContent${team.index}\">\n   606→              <!-- Score flash / now competing content populated dynamically -->\n   607→            </div>\n   608→          </div>\n   609→        </div>\n   610→      `).join('');\n   611→\n   612→      console.log('Team rows rendered:', state.teams.length);\n   613→    }\n   614→\n   615→    /**\n   616→     * Update team total display element (A4).\n   617→     * Called when API polling detects a change in team.final_score.\n   618→     * Adds highlight animation on value change.\n   619→     * @param {number} teamIndex - 1-based team index\n   620→     * @param {string} newTotal - Formatted score string (e.g., \"196.450\")\n   621→     */\n   622→    function updateTeamTotal(teamIndex, newTotal) {\n   623→      const totalEl = document.getElementById(`teamTotal${teamIndex}`);\n   624→      if (!totalEl) return;\n   625→\n   626→      const prevTotal = totalEl.textContent;\n   627→\n   628→      // Only update if value changed\n   629→      if (prevTotal === newTotal) return;\n   630→\n   631→      totalEl.textContent = newTotal;\n   632→\n   633→      // Trigger highlight animation on change (skip for initial load)\n   634→      if (prevTotal !== '--') {\n   635→        totalEl.classList.remove('highlight');\n   636→        // Force reflow to restart animation\n   637→        void totalEl.offsetWidth;\n   638→        totalEl.classList.add('highlight');\n   639→      }\n   640→    }\n   641→\n   642→    /**\n   643→     * Update all team totals from state (A4).\n   644→     * Called after API poll updates state.teams[].total values.\n   645→     */\n   646→    function updateAllTeamTotals() {\n   647→      state.teams.forEach((team) => {\n   648→        updateTeamTotal(team.index, team.total);\n   649→      });\n   650→    }\n   651→\n   652→    // Initialize Firebase listeners\n   653→    function initFirebaseListeners() {\n   654→      // Listen for enabled state\n   655→      scoreBugRef.child('enabled').on('value', (snapshot) => {\n   656→        state.enabled = snapshot.val() === true;\n   657→        updateBugVisibility();\n   658→      });\n   659→\n   660→      // Listen for polling state\n   661→      scoreBugRef.child('polling').on('value', (snapshot) => {\n   662→        const wasPolling = state.polling;\n   663→        state.polling = snapshot.val() === true;\n   664→        if (state.polling && !wasPolling) {\n   665→          startPolling();\n   666→        } else if (!state.polling && wasPolling) {\n   667→          stopPolling();\n   668→        }\n   669→      });\n   670→\n   671→      // Listen for automation mode\n   672→      scoreBugRef.child('automationMode').on('value', (snapshot) => {\n   673→        state.automationMode = snapshot.val() || 'auto';\n   674→      });\n   675→\n   676→      // Listen for lineup card toggle\n   677→      scoreBugRef.child('showLineup').on('value', (snapshot) => {\n   678→        state.showLineup = snapshot.val();\n   679→        updateLineupCard();\n   680→      });\n   681→\n   682→      // Listen for flash dismissals\n   683→      scoreBugRef.child('dismissFlash').on('value', (snapshot) => {\n   684→        const dismissals = snapshot.val() || {};\n   685→        handleFlashDismissals(dismissals);\n   686→      });\n   687→\n   688→      // Listen for poll interval changes - restart polling with new interval\n   689→      scoreBugRef.child('config/pollInterval').on('value', (snapshot) => {\n   690→        const newInterval = snapshot.val() || 5000;\n   691→        const wasPolling = state.polling && pollTimer !== null;\n   692→        state.pollInterval = newInterval;\n   693→\n   694→        // Restart polling with new interval if currently polling\n   695→        if (wasPolling) {\n   696→          console.log('Poll interval changed to', newInterval, 'ms - restarting polling');\n   697→          stopPolling();\n   698→          startPolling();\n   699→        }\n   700→      });\n   701→\n   702→      // Listen for flash duration changes\n   703→      scoreBugRef.child('config/flashDuration').on('value', (snapshot) => {\n   704→        state.flashDuration = snapshot.val() || 10000;\n   705→      });\n   706→\n   707→      console.log('Firebase listeners initialized');\n   708→    }\n   709→\n   710→    // Update bug visibility based on enabled state\n   711→    function updateBugVisibility() {\n   712→      const bugEl = document.getElementById('scoreBug');\n   713→      if (state.enabled) {\n   714→        bugEl.classList.add('visible');\n   715→      } else {\n   716→        bugEl.classList.remove('visible');\n   717→      }\n   718→    }\n   719→\n   720→    // Update lineup card visibility\n   721→    function updateLineupCard() {\n   722→      const cardEl = document.getElementById('lineupCard');\n   723→      if (state.showLineup) {\n   724→        cardEl.classList.add('visible');\n   725→        // TODO: Populate lineup card content (Phase C)\n   726→      } else {\n   727→        cardEl.classList.remove('visible');\n   728→      }\n   729→    }\n   730→\n   731→    /**\n   732→     * Handle flash dismissals from producer panel (Task A12c).\n   733→     * When producer clicks \"dismiss\" for a team, immediately clears\n   734→     * the active flash and advances to next in queue.\n   735→     * @param {Object} dismissals - Map of teamIndex -> timestamp\n   736→     */\n   737→    function handleFlashDismissals(dismissals) {\n   738→      if (!dismissals || typeof dismissals !== 'object') return;\n   739→\n   740→      Object.keys(dismissals).forEach((teamIndexStr) => {\n   741→        const teamIndex = parseInt(teamIndexStr, 10);\n   742→        const dismissTimestamp = dismissals[teamIndex];\n   743→\n   744→        // Skip if no active flash for this team\n   745→        if (!state.activeFlashes[teamIndex]) return;\n   746→\n   747→        // Skip if already processed this dismissal (compare timestamps)\n   748→        const activeFlash = state.activeFlashes[teamIndex];\n   749→        if (activeFlash.dismissedAt === dismissTimestamp) return;\n   750→\n   751→        console.log('Processing flash dismissal:', {\n   752→          team: teamIndex,\n   753→          gymnast: activeFlash.name,\n   754→          dismissTimestamp\n   755→        });\n   756→\n   757→        // Mark as processed\n   758→        activeFlash.dismissedAt = dismissTimestamp;\n   759→\n   760→        // Clear the timer for current flash\n   761→        if (activeFlash.timer) {\n   762→          clearTimeout(activeFlash.timer);\n   763→        }\n   764→\n   765→        // Advance to next flash (or clear if queue empty)\n   766→        advanceFlashQueue(teamIndex);\n   767→\n   768→        // Clear the dismissal flag in Firebase after processing\n   769→        scoreBugRef.child(`dismissFlash/${teamIndex}`).remove();\n   770→      });\n   771→    }\n   772→\n   773→    // Polling management\n   774→    let pollTimer = null;\n   775→\n   776→    function startPolling() {\n   777→      if (pollTimer) return;\n   778→      console.log('Starting API polling');\n   779→      poll();  // Initial poll\n   780→      pollTimer = setInterval(poll, state.pollInterval);\n   781→    }\n   782→\n   783→    function stopPolling() {\n   784→      if (pollTimer) {\n   785→        clearInterval(pollTimer);\n   786→        pollTimer = null;\n   787→        console.log('Stopped API polling');\n   788→      }\n   789→    }\n   790→\n   791→    // Main poll function - fetches data from Virtius API\n   792→    async function poll() {\n   793→      // Check if we have a valid session ID\n   794→      if (!state.virtiusSessionId) {\n   795→        console.warn('No Virtius session ID - skipping poll');\n   796→        return;\n   797→      }\n   798→\n   799→      const pollStartTime = Date.now();\n   800→\n   801→      try {\n   802→        // Fetch from Virtius API\n   803→        const response = await fetch(`https://api.virti.us/session/${state.virtiusSessionId}/json`);\n   804→\n   805→        if (!response.ok) {\n   806→          throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   807→        }\n   808→\n   809→        const data = await response.json();\n   810→\n   811→        // Store raw API data for score diff engine (Task A5)\n   812→        // Extract teams array from meet data\n   813→        const teams = data.meet?.teams || [];\n   814→\n   815→        if (teams.length === 0) {\n   816→          console.warn('No teams found in API response');\n   817→        }\n   818→\n   819→        // Store the latest API data in state\n   820→        state.lastApiData = data;\n   821→        state.lastApiTeams = teams;\n   822→\n   823→        // Extract team totals and update state.teams with actual data\n   824→        // final_score comes as a string from API - convert to float for display\n   825→        teams.forEach((apiTeam, idx) => {\n   826→          // Match API team to our configured teams by index or name\n   827→          const stateTeam = state.teams[idx];\n   828→          if (stateTeam) {\n   829→            // Convert string final_score to formatted number\n   830→            const rawScore = apiTeam.final_score;\n   831→            if (rawScore !== null && rawScore !== undefined) {\n   832→              const numScore = parseFloat(rawScore);\n   833→              stateTeam.total = isNaN(numScore) ? '--' : numScore.toFixed(3);\n   834→            }\n   835→            // Store API team reference for score diff engine\n   836→            stateTeam.apiTeam = apiTeam;\n   837→          }\n   838→        });\n   839→\n   840→        // Write heartbeat to Firebase on successful poll (using safeWrite for offline resilience)\n   841→        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n   842→\n   843→        console.log('Poll successful:', {\n   844→          sessionId: state.virtiusSessionId,\n   845→          teamCount: teams.length,\n   846→          teams: state.teams.map(t => ({ name: t.name, total: t.total }))\n   847→        });\n   848→\n   849→        // Process API data - detect changes and write deltas to Firebase\n   850→        await processApiData(teams, pollStartTime);\n   851→\n   852→        // Update team total displays (A4)\n   853→        updateAllTeamTotals();\n   854→\n   855→      } catch (err) {\n   856→        // Error handling with exponential backoff (A3c)\n   857→        state.consecutiveErrors++;\n   858→        state.lastError = err.message;\n   859→        state.lastErrorTime = pollStartTime;\n   860→\n   861→        // Calculate backoff delay: 5s, 10s, 20s, 40s, 60s (max)\n   862→        const backoffDelay = Math.min(\n   863→          state.pollInterval * Math.pow(2, state.consecutiveErrors - 1),\n   864→          state.maxBackoffMs\n   865→        );\n   866→\n   867→        console.error('Poll failed:', {\n   868→          error: err.message,\n   869→          consecutiveErrors: state.consecutiveErrors,\n   870→          nextRetryIn: `${backoffDelay / 1000}s`\n   871→        });\n   872→\n   873→        // Write error state to Firebase for producer panel visibility (D5b)\n   874→        // Using safeWrite for offline resilience\n   875→        await safeWrite(scoreBugRef.child('apiError'), 'set', {\n   876→          message: err.message,\n   877→          consecutiveErrors: state.consecutiveErrors,\n   878→          timestamp: pollStartTime,\n   879→          nextRetryMs: backoffDelay\n   880→        });\n   881→        // Still write heartbeat to indicate overlay is running\n   882→        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n   883→\n   884→        // Schedule next poll with backoff delay if we're still supposed to be polling\n   885→        if (state.polling && pollTimer) {\n   886→          clearInterval(pollTimer);\n   887→          pollTimer = setTimeout(() => {\n   888→            if (state.polling) {\n   889→              poll();\n   890→              // If poll succeeds, startPolling() will be called to restore normal interval\n   891→            }\n   892→          }, backoffDelay);\n   893→        }\n   894→        return; // Skip normal completion\n   895→      }\n   896→\n   897→      // Success - reset error state\n   898→      if (state.consecutiveErrors > 0) {\n   899→        console.log('Poll recovered after', state.consecutiveErrors, 'consecutive errors');\n   900→        state.consecutiveErrors = 0;\n   901→        state.lastError = null;\n   902→        state.lastErrorTime = null;\n   903→\n   904→        // Clear error state in Firebase\n   905→        await safeWrite(scoreBugRef.child('apiError'), 'remove');\n   906→\n   907→        // Restore normal polling interval (we might be on backoff timeout)\n   908→        if (state.polling && pollTimer) {\n   909→          clearTimeout(pollTimer);\n   910→          clearInterval(pollTimer);\n   911→          pollTimer = setInterval(poll, state.pollInterval);\n   912→        }\n   913→      }\n   914→    }\n   915→\n   916→    /**\n   917→     * Process API data - detect score changes and write incremental deltas to Firebase.\n   918→     * Only writes changed paths, not full data rewrite.\n   919→     * @param {Array} apiTeams - Teams array from Virtius API\n   920→     * @param {number} pollTimestamp - Timestamp of this poll\n   921→     */\n   922→    async function processApiData(apiTeams, pollTimestamp) {\n   923→      const changedPaths = {};\n   924→      let hasChanges = false;\n   925→\n   926→      // Process each team\n   927→      apiTeams.forEach((team, teamIdx) => {\n   928→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n   929→\n   930→        // Check if team total changed\n   931→        const prevTeamTotal = state.previousTeamTotals[teamKey];\n   932→        const currTeamTotal = team.final_score;  // string or null\n   933→\n   934→        if (currTeamTotal !== prevTeamTotal) {\n   935→          changedPaths[`teams/${teamKey}/finalScore`] = currTeamTotal;\n   936→          changedPaths[`teams/${teamKey}/name`] = team.name || teamKey;\n   937→          hasChanges = true;\n   938→        }\n   939→\n   940→        // Process each event's gymnasts for score changes\n   941→        const events = team.events || [];\n   942→        events.forEach((event) => {\n   943→          const eventKey = event.short_name || event.name || 'unknown';\n   944→          const gymnasts = event.gymnasts || [];\n   945→\n   946→          gymnasts.forEach((gymnast) => {\n   947→            // Primary key: gymnast_id. Fallback: teamKey|normalizedName\n   948→            const gymnastKey = gymnast.gymnast_id ||\n   949→              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n   950→\n   951→            const prevScore = state.previousScores[gymnastKey];\n   952→            const currScore = gymnast.final_score;  // string or null\n   953→\n   954→            // Score changed (new score OR corrected score)\n   955→            if (currScore != null && prevScore !== currScore) {\n   956→              // Build gymnast data for Firebase and flash queue\n   957→              const gymnastData = {\n   958→                name: gymnast.full_name,\n   959→                score: currScore,\n   960→                startValue: gymnast.start_value || null,\n   961→                execution: gymnast.execution || null,\n   962→                difficulty: gymnast.difficulty || null,\n   963→                order: gymnast.order,\n   964→                event: eventKey,\n   965→                team: teamKey,\n   966→                gymnastKey: gymnastKey,\n   967→                timestamp: pollTimestamp,\n   968→                isCorrection: prevScore != null  // True if score was changed (not new)\n   969→              };\n   970→\n   971→              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}`] = gymnastData;\n   972→              hasChanges = true;\n   973→\n   974→              console.log('Score change detected:', {\n   975→                gymnast: gymnast.full_name,\n   976→                event: eventKey,\n   977→                team: teamKey,\n   978→                prev: prevScore,\n   979→                curr: currScore,\n   980→                isCorrection: prevScore != null\n   981→              });\n   982→\n   983→              // Trigger flash for this score change (A5)\n   984→              const teamIndex = teamIdx + 1;  // Convert 0-based to 1-based index\n   985→              if (isFlashActive(teamIndex, gymnastKey)) {\n   986→                // Correction during active flash - interrupt and replace\n   987→                interruptFlash(teamIndex, gymnastData);\n   988→              } else {\n   989→                // Queue new flash for this team\n   990→                triggerScoreFlash(teamIndex, gymnastData);\n   991→              }\n   992→            }\n   993→\n   994→            // Score removed (rare - inquiry pending)\n   995→            if (currScore == null && prevScore != null) {\n   996→              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}/score`] = null;\n   997→              hasChanges = true;\n   998→              console.log('Score removed:', { gymnast: gymnast.full_name, event: eventKey });\n   999→            }\n  1000→          });\n  1001→        });\n  1002→      });\n  1003→\n  1004→      // Write to Firebase (using safeWrite for offline resilience)\n  1005→      if (hasChanges) {\n  1006→        // Write changed paths and reset stale counter\n  1007→        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n  1008→          ...changedPaths,\n  1009→          lastDataChangeTimestamp: pollTimestamp,\n  1010→          stalePollCount: 0\n  1011→        });\n  1012→        state.stalePollCount = 0;\n  1013→\n  1014→        console.log('Wrote incremental deltas to Firebase:', Object.keys(changedPaths).length, 'paths');\n  1015→      } else {\n  1016→        // No changes - increment stale counter\n  1017→        state.stalePollCount++;\n  1018→        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n  1019→          lastPollTimestamp: pollTimestamp,\n  1020→          stalePollCount: state.stalePollCount\n  1021→        });\n  1022→      }\n  1023→\n  1024→      // Update previous state for next comparison\n  1025→      state.previousScores = buildScoreMap(apiTeams);\n  1026→      state.previousTeamTotals = buildTeamTotalMap(apiTeams);\n  1027→\n  1028→      // Detect and update rotation (A10)\n  1029→      const newRotation = detectRotation(apiTeams);\n  1030→      if (newRotation.current !== state.rotation.current ||\n  1031→          newRotation.isFinal !== state.rotation.isFinal) {\n  1032→        state.rotation = newRotation;\n  1033→        updateRotationTag();\n  1034→\n  1035→        // Write rotation to Firebase for producer panel visibility\n  1036→        await safeWrite(scoreBugRef.child('liveData/rotation'), 'set', newRotation.current);\n  1037→        await safeWrite(scoreBugRef.child('liveData/totalRotations'), 'set', newRotation.total);\n  1038→        await safeWrite(scoreBugRef.child('liveData/isFinal'), 'set', newRotation.isFinal);\n  1039→\n  1040→        console.log('Rotation updated:', newRotation);\n  1041→      }\n  1042→\n  1043→      // Detect now-competing athletes (B1)\n  1044→      const nowCompeting = detectAllNowCompeting(apiTeams);\n  1045→      const prevNowCompeting = state.nowCompeting || [];\n  1046→\n  1047→      // Check if now-competing has changed\n  1048→      const nowCompetingChanged = JSON.stringify(nowCompeting) !== JSON.stringify(prevNowCompeting);\n  1049→\n  1050→      if (nowCompetingChanged) {\n  1051→        state.nowCompeting = nowCompeting;\n  1052→\n  1053→        // Write detected state to Firebase for producer panel visibility\n  1054→        await safeWrite(scoreBugRef.child('detected/nowCompeting'), 'set', nowCompeting);\n  1055→\n  1056→        console.log('Now competing updated:', nowCompeting);\n  1057→      }\n  1058→    }\n  1059→\n  1060→    /**\n  1061→     * Build score map from API teams data.\n  1062→     * @returns {Object} Map of gymnastKey -> finalScore (string)\n  1063→     */\n  1064→    function buildScoreMap(apiTeams) {\n  1065→      const map = {};\n  1066→      apiTeams.forEach((team, teamIdx) => {\n  1067→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n  1068→        const events = team.events || [];\n  1069→\n  1070→        events.forEach((event) => {\n  1071→          const gymnasts = event.gymnasts || [];\n  1072→          gymnasts.forEach((gymnast) => {\n  1073→            const gymnastKey = gymnast.gymnast_id ||\n  1074→              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n  1075→            map[gymnastKey] = gymnast.final_score;  // string or null\n  1076→          });\n  1077→        });\n  1078→      });\n  1079→      return map;\n  1080→    }\n  1081→\n  1082→    /**\n  1083→     * Build team total map from API teams data.\n  1084→     * @returns {Object} Map of teamKey -> finalScore (string)\n  1085→     */\n  1086→    function buildTeamTotalMap(apiTeams) {\n  1087→      const map = {};\n  1088→      apiTeams.forEach((team, teamIdx) => {\n  1089→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n  1090→        map[teamKey] = team.final_score;  // string or null\n  1091→      });\n  1092→      return map;\n  1093→    }\n  1094→\n  1095→    // ============================================================\n  1096→    // SCORE DIFF ENGINE - Flash Queue Management (Task A5)\n  1097→    // ============================================================\n  1098→\n  1099→    /**\n  1100→     * Check if a flash is currently active for a given team and gymnast.\n  1101→     * Used to detect score corrections during active flash display.\n  1102→     * @param {number} teamIndex - 1-based team index\n  1103→     * @param {string} gymnastKey - Unique gymnast identifier\n  1104→     * @returns {boolean} True if flash is active for this gymnast\n  1105→     */\n  1106→    function isFlashActive(teamIndex, gymnastKey) {\n  1107→      const activeFlash = state.activeFlashes[teamIndex];\n  1108→      return activeFlash && activeFlash.gymnastKey === gymnastKey;\n  1109→    }\n  1110→\n  1111→    /**\n  1112→     * Interrupt current flash with a new one (score correction case).\n  1113→     * Immediately replaces the active flash and resets timer.\n  1114→     * @param {number} teamIndex - 1-based team index\n  1115→     * @param {Object} gymnastData - New score data to display\n  1116→     */\n  1117→    function interruptFlash(teamIndex, gymnastData) {\n  1118→      console.log('Interrupting active flash with correction:', {\n  1119→        team: teamIndex,\n  1120→        gymnast: gymnastData.name,\n  1121→        newScore: gymnastData.score\n  1122→      });\n  1123→\n  1124→      // Clear existing flash timer\n  1125→      if (state.activeFlashes[teamIndex]?.timer) {\n  1126→        clearTimeout(state.activeFlashes[teamIndex].timer);\n  1127→      }\n  1128→\n  1129→      // Replace with new flash data\n  1130→      state.activeFlashes[teamIndex] = {\n  1131→        ...gymnastData,\n  1132→        startTime: Date.now(),\n  1133→        timer: null\n  1134→      };\n  1135→\n  1136→      // Render the updated flash immediately\n  1137→      renderFlash(teamIndex, gymnastData);\n  1138→\n  1139→      // Set new timer\n  1140→      state.activeFlashes[teamIndex].timer = setTimeout(() => {\n  1141→        advanceFlashQueue(teamIndex);\n  1142→      }, state.flashDuration);\n  1143→    }\n  1144→\n  1145→    /**\n  1146→     * Queue a new score flash for a team.\n  1147→     * If no flash is active, displays immediately. Otherwise queued.\n  1148→     * @param {number} teamIndex - 1-based team index\n  1149→     * @param {Object} gymnastData - Score data to display\n  1150→     */\n  1151→    function triggerScoreFlash(teamIndex, gymnastData) {\n  1152→      // Initialize queue if needed\n  1153→      if (!state.flashQueues[teamIndex]) {\n  1154→        state.flashQueues[teamIndex] = [];\n  1155→      }\n  1156→\n  1157→      const queue = state.flashQueues[teamIndex];\n  1158→\n  1159→      // Edge case: Check if this gymnast is already in the queue (correction before display)\n  1160→      const existingIndex = queue.findIndex(item => item.gymnastKey === gymnastData.gymnastKey);\n  1161→      if (existingIndex !== -1) {\n  1162→        // Update existing queue entry with corrected score (A13: corrections in queue)\n  1163→        console.log('Updating queued flash with correction:', {\n  1164→          team: teamIndex,\n  1165→          gymnast: gymnastData.name,\n  1166→          oldScore: queue[existingIndex].score,\n  1167→          newScore: gymnastData.score\n  1168→        });\n  1169→        queue[existingIndex] = { ...gymnastData, isCorrection: true };\n  1170→        return;\n  1171→      }\n  1172→\n  1173→      // Edge case: Cap queue length to prevent runaway (A13: rapid scores)\n  1174→      const MAX_QUEUE_SIZE = 6;  // Max gymnasts per rotation\n  1175→      if (queue.length >= MAX_QUEUE_SIZE) {\n  1176→        console.warn('Flash queue full, dropping oldest entry:', {\n  1177→          team: teamIndex,\n  1178→          dropped: queue[0].name,\n  1179→          newEntry: gymnastData.name\n  1180→        });\n  1181→        queue.shift();\n  1182→      }\n  1183→\n  1184→      console.log('Queuing score flash:', {\n  1185→        team: teamIndex,\n  1186→        gymnast: gymnastData.name,\n  1187→        score: gymnastData.score,\n  1188→        queueLength: queue.length\n  1189→      });\n  1190→\n  1191→      // Add to queue\n  1192→      queue.push(gymnastData);\n  1193→\n  1194→      // If no active flash, start displaying\n  1195→      if (!state.activeFlashes[teamIndex]) {\n  1196→        displayNextFlash(teamIndex);\n  1197→      }\n  1198→    }\n  1199→\n  1200→    /**\n  1201→     * Display the next flash from the queue.\n  1202→     * Called when starting or advancing the queue.\n  1203→     * @param {number} teamIndex - 1-based team index\n  1204→     */\n  1205→    function displayNextFlash(teamIndex) {\n  1206→      const queue = state.flashQueues[teamIndex] || [];\n  1207→\n  1208→      if (queue.length === 0) {\n  1209→        // No more flashes - clear active state\n  1210→        state.activeFlashes[teamIndex] = null;\n  1211→        clearFlashDisplay(teamIndex);\n  1212→        return;\n  1213→      }\n  1214→\n  1215→      // Get next flash from queue\n  1216→      const gymnastData = queue.shift();\n  1217→\n  1218→      // Set as active\n  1219→      state.activeFlashes[teamIndex] = {\n  1220→        ...gymnastData,\n  1221→        startTime: Date.now(),\n  1222→        timer: setTimeout(() => {\n  1223→          advanceFlashQueue(teamIndex);\n  1224→        }, state.flashDuration)\n  1225→      };\n  1226→\n  1227→      // Render the flash\n  1228→      renderFlash(teamIndex, gymnastData);\n  1229→    }\n  1230→\n  1231→    /**\n  1232→     * Advance to next flash in queue (called when timer expires).\n  1233→     * @param {number} teamIndex - 1-based team index\n  1234→     */\n  1235→    function advanceFlashQueue(teamIndex) {\n  1236→      // Clear current flash timer\n  1237→      if (state.activeFlashes[teamIndex]?.timer) {\n  1238→        clearTimeout(state.activeFlashes[teamIndex].timer);\n  1239→      }\n  1240→\n  1241→      // Display next or clear\n  1242→      displayNextFlash(teamIndex);\n  1243→    }\n  1244→\n  1245→    /**\n  1246→     * Render a score flash in a team's slot area with slot machine animation.\n  1247→     * TODO: Task A7 will enhance rendering with headshots/apparatus.\n  1248→     * @param {number} teamIndex - 1-based team index\n  1249→     * @param {Object} gymnastData - Score data to render\n  1250→     */\n  1251→    function renderFlash(teamIndex, gymnastData) {\n  1252→      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n  1253→      if (!slotContent) return;\n  1254→\n  1255→      // Check if there's existing content to animate out\n  1256→      const hasExistingContent = slotContent.innerHTML.trim() !== '';\n  1257→\n  1258→      if (hasExistingContent) {\n  1259→        // Spin out existing content first\n  1260→        slotContent.classList.remove('spin-in', 'visible');\n  1261→        slotContent.classList.add('spin-out');\n  1262→\n  1263→        // After spin-out completes, insert new content and spin in\n  1264→        setTimeout(() => {\n  1265→          insertFlashContent(slotContent, gymnastData);\n  1266→          triggerSpinIn(slotContent);\n  1267→        }, 400);  // Match spin-out animation duration\n  1268→      } else {\n  1269→        // No existing content - insert and spin in directly\n  1270→        insertFlashContent(slotContent, gymnastData);\n  1271→        triggerSpinIn(slotContent);\n  1272→      }\n  1273→\n  1274→      console.log('Rendered flash:', {\n  1275→        team: teamIndex,\n  1276→        gymnast: gymnastData.name,\n  1277→        score: gymnastData.score,\n  1278→        animated: hasExistingContent ? 'spin-transition' : 'spin-in'\n  1279→      });\n  1280→    }\n  1281→\n  1282→    /**\n  1283→     * Insert flash content HTML into slot element (Task A7).\n  1284→     * Renders: apparatus | name | SV | separator | score | correction indicator\n  1285→     * @param {HTMLElement} slotContent - The slot content container\n  1286→     * @param {Object} gymnastData - Score data to render\n  1287→     */\n  1288→    function insertFlashContent(slotContent, gymnastData) {\n  1289→      // Format start value for display (e.g., \"5.0\" or \"5.2\")\n  1290→      const svDisplay = gymnastData.startValue\n  1291→        ? `<span class=\"slot-sv\">SV ${parseFloat(gymnastData.startValue).toFixed(1)}</span>`\n  1292→        : '';\n  1293→\n  1294→      // Format score for display (e.g., \"13.450\")\n  1295→      const scoreValue = parseFloat(gymnastData.score);\n  1296→      const scoreDisplay = isNaN(scoreValue) ? gymnastData.score : scoreValue.toFixed(3);\n  1297→\n  1298→      slotContent.innerHTML = `\n  1299→        <span class=\"slot-apparatus\">${gymnastData.event}</span>\n  1300→        <span class=\"slot-name\">${gymnastData.name}</span>\n  1301→        ${svDisplay}\n  1302→        <span class=\"slot-separator\">•</span>\n  1303→        <span class=\"slot-score\">${scoreDisplay}</span>\n  1304→        ${gymnastData.isCorrection ? '<span class=\"slot-correction\">(corrected)</span>' : ''}\n  1305→      `;\n  1306→    }\n  1307→\n  1308→    /**\n  1309→     * Trigger spin-in animation on slot content.\n  1310→     * @param {HTMLElement} slotContent - The slot content container\n  1311→     */\n  1312→    function triggerSpinIn(slotContent) {\n  1313→      // Reset animation state\n  1314→      slotContent.classList.remove('spin-out', 'exit-up', 'enter-from-below');\n  1315→\n  1316→      // Force reflow to ensure animation restarts\n  1317→      void slotContent.offsetWidth;\n  1318→\n  1319→      // Trigger spin-in animation\n  1320→      slotContent.classList.add('spin-in', 'visible');\n  1321→    }\n  1322→\n  1323→    /**\n  1324→     * Clear flash display for a team (return to idle state) with spin-out animation.\n  1325→     * @param {number} teamIndex - 1-based team index\n  1326→     */\n  1327→    function clearFlashDisplay(teamIndex) {\n  1328→      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n  1329→      if (!slotContent) return;\n  1330→\n  1331→      // Only animate if there's content to clear\n  1332→      if (slotContent.innerHTML.trim() === '') return;\n  1333→\n  1334→      // Trigger spin-out animation\n  1335→      slotContent.classList.remove('spin-in', 'visible');\n  1336→      slotContent.classList.add('spin-out');\n  1337→\n  1338→      // Clear content after animation completes\n  1339→      setTimeout(() => {\n  1340→        if (!state.activeFlashes[teamIndex]) {\n  1341→          slotContent.innerHTML = '';\n  1342→          slotContent.classList.remove('spin-out');\n  1343→        }\n  1344→      }, 400);  // Match CSS animation duration\n  1345→    }\n  1346→\n  1347→    /**\n  1348→     * Get current flash queue status for debugging/producer panel.\n  1349→     * @returns {Object} Queue status by team\n  1350→     */\n  1351→    function getFlashQueueStatus() {\n  1352→      const status = {};\n  1353→      state.teams.forEach((team) => {\n  1354→        const queue = state.flashQueues[team.index] || [];\n  1355→        const active = state.activeFlashes[team.index];\n  1356→        status[team.index] = {\n  1357→          teamName: team.name,\n  1358→          queueLength: queue.length,\n  1359→          activeFlash: active ? {\n  1360→            gymnast: active.name,\n  1361→            score: active.score,\n  1362→            timeRemaining: active.startTime ?\n  1363→              Math.max(0, state.flashDuration - (Date.now() - active.startTime)) : 0\n  1364→          } : null\n  1365→        };\n  1366→      });\n  1367→      return status;\n  1368→    }\n  1369→\n  1370→    // ============================================================\n  1371→    // ROTATION DETECTION (Task A10)\n  1372→    // ============================================================\n  1373→\n  1374→    /**\n  1375→     * Detect current rotation from API data using ALL teams.\n  1376→     * Rotation only advances when ALL teams have completed their current event.\n  1377→     * @param {Array} apiTeams - Teams array from Virtius API\n  1378→     * @returns {Object} { current: number, total: number, isFinal: boolean }\n  1379→     */\n  1380→    function detectRotation(apiTeams) {\n  1381→      if (!apiTeams || apiTeams.length === 0) {\n  1382→        return state.rotation;  // Keep existing state if no data\n  1383→      }\n  1384→\n  1385→      // Total events based on gender (6 for men, 4 for women)\n  1386→      const totalEvents = state.rotation.total;\n  1387→\n  1388→      // Find minimum completed events across ALL teams\n  1389→      let minCompletedAcrossTeams = totalEvents;\n  1390→\n  1391→      apiTeams.forEach((team) => {\n  1392→        const events = team.events || [];\n  1393→        let completedEvents = 0;\n  1394→\n  1395→        events.forEach((event) => {\n  1396→          const gymnasts = event.gymnasts || [];\n  1397→          // An event is \"complete\" if all gymnasts have scores\n  1398→          const scored = gymnasts.filter(g => g.final_score != null);\n  1399→          if (scored.length === gymnasts.length && gymnasts.length > 0) {\n  1400→            completedEvents++;\n  1401→          }\n  1402→        });\n  1403→\n  1404→        minCompletedAcrossTeams = Math.min(minCompletedAcrossTeams, completedEvents);\n  1405→      });\n  1406→\n  1407→      // All events complete for all teams = Final\n  1408→      if (minCompletedAcrossTeams === totalEvents) {\n  1409→        return { current: totalEvents, total: totalEvents, isFinal: true };\n  1410→      }\n  1411→\n  1412→      // Current rotation = completed events + 1\n  1413→      const currentRotation = minCompletedAcrossTeams + 1;\n  1414→      return { current: currentRotation, total: totalEvents, isFinal: false };\n  1415→    }\n  1416→\n  1417→    /**\n  1418→     * Detect the currently competing athlete for a team.\n  1419→     * Finds the next athlete without a score in an event that has some scores.\n  1420→     * Based on logic from GraphicsControl.jsx:216-269.\n  1421→     * @param {Object} team - Team object from Virtius API\n  1422→     * @returns {Object|null} { athlete: Object, event: Object } or null\n  1423→     */\n  1424→    function detectNowCompeting(team) {\n  1425→      if (!team || !team.events) return null;\n  1426→\n  1427→      // Olympic order for events (already sorted in API, but just in case)\n  1428→      const events = team.events;\n  1429→\n  1430→      for (const event of events) {\n  1431→        const gymnasts = event.gymnasts || [];\n  1432→        if (gymnasts.length === 0) continue;\n  1433→\n  1434→        // Sort by order (lineup position)\n  1435→        const sortedGymnasts = [...gymnasts].sort((a, b) => (a.order || 0) - (b.order || 0));\n  1436→\n  1437→        // Find scored and unscored athletes\n  1438→        const scored = sortedGymnasts.filter(g => g.final_score != null);\n  1439→        const unscored = sortedGymnasts.filter(g => g.final_score == null);\n  1440→\n  1441→        // If this event has some scores but not all, it's in progress\n  1442→        if (scored.length > 0 && unscored.length > 0) {\n  1443→          return {\n  1444→            athlete: unscored[0],\n  1445→            event: event\n  1446→          };\n  1447→        }\n  1448→      }\n  1449→\n  1450→      return null; // No one currently competing (between rotations or complete)\n  1451→    }\n  1452→\n  1453→    /**\n  1454→     * Detect now-competing athletes for all teams and return results.\n  1455→     * @param {Array} apiTeams - Teams array from Virtius API\n  1456→     * @returns {Array} Array of { teamIndex, teamName, tricode, athlete, eventName }\n  1457→     */\n  1458→    function detectAllNowCompeting(apiTeams) {\n  1459→      if (!apiTeams || apiTeams.length === 0) return [];\n  1460→\n  1461→      const results = [];\n  1462→\n  1463→      apiTeams.forEach((team, teamIndex) => {\n  1464→        const nowCompeting = detectNowCompeting(team);\n  1465→        if (nowCompeting) {\n  1466→          results.push({\n  1467→            teamIndex: teamIndex,\n  1468→            teamName: team.name,\n  1469→            tricode: team.tricode,\n  1470→            athlete: {\n  1471→              id: nowCompeting.athlete.gymnast_id,\n  1472→              name: nowCompeting.athlete.full_name,\n  1473→              order: nowCompeting.athlete.order,\n  1474→              type: nowCompeting.athlete.type // 0=competing, 1=exhibition, etc.\n  1475→            },\n  1476→            eventName: nowCompeting.event.event_name\n  1477→          });\n  1478→        }\n  1479→      });\n  1480→\n  1481→      return results;\n  1482→    }\n  1483→\n  1484→    /**\n  1485→     * Update the rotation tag display in the DOM.\n  1486→     * Shows \"Rotation X of Y\" or \"Final\" when complete.\n  1487→     */\n  1488→    function updateRotationTag() {\n  1489→      const tagEl = document.getElementById('rotationTag');\n  1490→      if (!tagEl) return;\n  1491→\n  1492→      const { current, total, isFinal } = state.rotation;\n  1493→\n  1494→      if (isFinal) {\n  1495→        tagEl.textContent = 'Final';\n  1496→      } else {\n  1497→        tagEl.textContent = `Rotation ${current} of ${total}`;\n  1498→      }\n  1499→    }\n  1500→\n  1501→    // Initialize Firebase schema with default values (prevents race conditions)\n  1502→    // Uses update() with null checks - only sets values that don't exist\n  1503→    async function initializeSchema() {\n  1504→      const defaultSchema = {\n  1505→        enabled: false,\n  1506→        polling: false,\n  1507→        automationMode: 'auto',\n  1508→        showLineup: null,\n  1509→        dismissFlash: {},\n  1510→        nowCompeting: {},\n  1511→        detected: {},\n  1512→        heartbeat: null,\n  1513→        liveData: {\n  1514→          lastPollTimestamp: null,\n  1515→          lastDataChangeTimestamp: null,\n  1516→          stalePollCount: 0,\n  1517→          rotation: null,\n  1518→          totalRotations: null,\n  1519→          teams: {}\n  1520→        },\n  1521→        lastError: null,\n  1522→        config: {\n  1523→          pollInterval: 5000,\n  1524→          flashDuration: 10000,\n  1525→          showStickIndicator: true\n  1526→        }\n  1527→      };\n  1528→\n  1529→      try {\n  1530→        // Use transaction to safely initialize schema without overwriting existing values\n  1531→        await scoreBugRef.transaction((currentData) => {\n  1532→          if (currentData === null) {\n  1533→            // No data exists - write full schema\n  1534→            console.log('Initializing scoreBug schema with defaults');\n  1535→            return defaultSchema;\n  1536→          }\n  1537→          // Data exists - merge defaults for any missing fields only\n  1538→          const merged = { ...defaultSchema };\n  1539→          Object.keys(currentData).forEach(key => {\n  1540→            if (currentData[key] !== undefined) {\n  1541→              // Keep existing value\n  1542→              merged[key] = currentData[key];\n  1543→            }\n  1544→          });\n  1545→          // Deep merge for nested objects (config, liveData)\n  1546→          if (currentData.config) {\n  1547→            merged.config = { ...defaultSchema.config, ...currentData.config };\n  1548→          }\n  1549→          if (currentData.liveData) {\n  1550→            merged.liveData = { ...defaultSchema.liveData, ...currentData.liveData };\n  1551→          }\n  1552→          console.log('Merged existing scoreBug data with defaults');\n  1553→          return merged;\n  1554→        });\n  1555→        console.log('Firebase schema initialized');\n  1556→      } catch (err) {\n  1557→        console.error('Failed to initialize schema:', err);\n  1558→      }\n  1559→    }\n  1560→\n  1561→    // Initialize on load\n  1562→    if (compId) {\n  1563→      // Start connection monitor immediately (A3d)\n  1564→      initConnectionMonitor();\n  1565→\n  1566→      // Order: load config -> render teams -> initialize schema -> start listeners\n  1567→      loadCompetitionConfig().then(async (success) => {\n  1568→        if (!success) return;  // Exit early, don't initialize listeners\n  1569→\n  1570→        // Render team rows with initial state (before API data)\n  1571→        renderTeamRows();\n  1572→\n  1573→        // Update rotation tag for correct total (4 for women, 6 for men)\n  1574→        updateRotationTag();\n  1575→\n  1576→        // Initialize Firebase schema (safe defaults)\n  1577→        await initializeSchema();\n  1578→\n  1579→        // Start listening for Firebase changes (only after successful config load)\n  1580→        initFirebaseListeners();\n  1581→      });\n  1582→    }\n  1583→  </script>\n  1584→</body>\n  1585→</html>\n  1586→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"9f788203-1d97-4b7f-986f-2f9903719630","uuid":"2e8e51f2-c992-4a18-a73e-39eca1e8b8c3","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/overlays/team-bug.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=1920, height=1080\">\n  <title>Team Score Bug</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n\n  <!-- Firebase SDK -->\n  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js\"></script>\n  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js\"></script>\n\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n\n    body {\n      font-family: 'Inter', sans-serif;\n      width: 1920px;\n      height: 1080px;\n      overflow: hidden;\n      background: transparent;\n    }\n\n    /* Score bug container - positioned on right side of screen */\n    .score-bug {\n      position: absolute;\n      top: 50%;\n      right: 0;\n      transform: translateY(-50%) translateX(100%);\n      display: flex;\n      flex-direction: column;\n      min-width: 500px;\n      opacity: 0;\n      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n\n    .score-bug.visible {\n      transform: translateY(-50%) translateX(0);\n      opacity: 1;\n    }\n\n    /* Rotation tag at top */\n    .rotation-tag {\n      background: #27272a;\n      color: #fff;\n      font-size: 20px;\n      font-weight: 700;\n      padding: 10px 20px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n\n    /* Team rows container */\n    .team-rows {\n      display: flex;\n      flex-direction: column;\n    }\n\n    /* Individual team row */\n    .team-row {\n      display: flex;\n      flex-direction: row;\n      background: #1a1a1a;\n      border-bottom: 1px solid #333;\n      min-height: 70px;\n    }\n\n    .team-row:last-child {\n      border-bottom: none;\n    }\n\n    /* Fixed left section: logo + total */\n    .team-fixed {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 10px 15px;\n      min-width: 100px;\n      background: #000;\n    }\n\n    .team-logo {\n      width: 40px;\n      height: 40px;\n      object-fit: contain;\n    }\n\n    .team-total {\n      font-size: 22px;\n      font-weight: 900;\n      color: #fff;\n      margin-top: 4px;\n    }\n\n    .team-total.highlight {\n      animation: totalPulse 0.5s ease;\n    }\n\n    @keyframes totalPulse {\n      0%, 100% { transform: scale(1); color: #fff; }\n      50% { transform: scale(1.1); color: #22d3ee; }\n    }\n\n    /* Slot area for score flash / now competing */\n    .team-slot {\n      flex: 1;\n      display: flex;\n      align-items: center;\n      padding: 10px 20px;\n      overflow: hidden;\n      position: relative;\n    }\n\n    /* Slot content (animates up/down) */\n    .slot-content {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      transform: translateY(0);\n      transition: transform 0.4s ease, opacity 0.4s ease;\n      opacity: 0;\n    }\n\n    .slot-content.visible {\n      opacity: 1;\n    }\n\n    .slot-content.exit-up {\n      transform: translateY(-100%);\n      opacity: 0;\n    }\n\n    .slot-content.enter-from-below {\n      transform: translateY(100%);\n      opacity: 0;\n    }\n\n    /* Slot machine animation - new content spins up from below */\n    @keyframes slotSpinIn {\n      0% {\n        transform: translateY(100%);\n        opacity: 0;\n      }\n      20% {\n        opacity: 1;\n      }\n      100% {\n        transform: translateY(0);\n        opacity: 1;\n      }\n    }\n\n    /* Slot machine animation - old content spins up and out */\n    @keyframes slotSpinOut {\n      0% {\n        transform: translateY(0);\n        opacity: 1;\n      }\n      80% {\n        opacity: 0;\n      }\n      100% {\n        transform: translateY(-100%);\n        opacity: 0;\n      }\n    }\n\n    .slot-content.spin-in {\n      animation: slotSpinIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n    }\n\n    .slot-content.spin-out {\n      animation: slotSpinOut 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n    }\n\n    /* Headshot in slot */\n    .slot-headshot {\n      width: 36px;\n      height: 36px;\n      border-radius: 50%;\n      object-fit: cover;\n      flex-shrink: 0;\n    }\n\n    /* Athlete name in slot */\n    .slot-name {\n      font-size: 24px;\n      font-weight: 700;\n      color: #fff;\n      white-space: nowrap;\n    }\n\n    /* Score in slot */\n    .slot-score {\n      font-size: 28px;\n      font-weight: 900;\n      color: #fff;\n    }\n\n    /* Apparatus code */\n    .slot-apparatus {\n      font-size: 18px;\n      font-weight: 600;\n      color: #a1a1aa;\n      text-transform: uppercase;\n    }\n\n    /* Start value */\n    .slot-sv {\n      font-size: 16px;\n      font-weight: 400;\n      color: #71717a;\n    }\n\n    /* Stick indicator */\n    .slot-stick {\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      background: #22c55e;\n      color: #fff;\n      font-size: 14px;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    /* Separator dot */\n    .slot-separator {\n      color: #52525b;\n      font-size: 20px;\n    }\n\n    /* Correction indicator (score was changed) */\n    .slot-correction {\n      font-size: 14px;\n      font-weight: 500;\n      color: #f59e0b;\n      font-style: italic;\n    }\n\n    /* Lineup card (above bug) */\n    .lineup-card {\n      position: absolute;\n      bottom: 100%;\n      right: 0;\n      width: 100%;\n      background: #1a1a1a;\n      transform: translateY(100%);\n      opacity: 0;\n      transition: transform 0.4s ease, opacity 0.4s ease;\n      margin-bottom: 8px;\n    }\n\n    .lineup-card.visible {\n      transform: translateY(0);\n      opacity: 1;\n    }\n\n    .lineup-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 20px;\n      background: #27272a;\n    }\n\n    .lineup-team-name {\n      font-size: 22px;\n      font-weight: 800;\n      color: #fff;\n      text-transform: uppercase;\n    }\n\n    .lineup-logo {\n      width: 32px;\n      height: 32px;\n      object-fit: contain;\n    }\n\n    .lineup-athletes {\n      padding: 8px 0;\n    }\n\n    .lineup-athlete {\n      display: flex;\n      align-items: center;\n      padding: 8px 20px;\n      gap: 12px;\n    }\n\n    .lineup-order {\n      font-size: 16px;\n      font-weight: 600;\n      color: #71717a;\n      min-width: 24px;\n    }\n\n    .lineup-name {\n      flex: 1;\n      font-size: 20px;\n      font-weight: 600;\n      color: #fff;\n    }\n\n    .lineup-sv {\n      font-size: 16px;\n      font-weight: 400;\n      color: #71717a;\n      min-width: 40px;\n      text-align: right;\n    }\n\n    .lineup-score {\n      font-size: 22px;\n      font-weight: 700;\n      color: #fff;\n      min-width: 70px;\n      text-align: right;\n    }\n\n    .lineup-score.pending {\n      color: #52525b;\n    }\n\n    .lineup-footer {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 20px;\n      background: #27272a;\n    }\n\n    .lineup-event {\n      font-size: 18px;\n      font-weight: 600;\n      color: #a1a1aa;\n      text-transform: uppercase;\n    }\n\n    .lineup-total {\n      font-size: 26px;\n      font-weight: 800;\n      color: #fff;\n    }\n\n    /* Loading / error states */\n    .loading-state {\n      color: #71717a;\n      font-size: 18px;\n      padding: 20px;\n      text-align: center;\n    }\n\n    .error-state {\n      color: #ef4444;\n      font-size: 18px;\n      padding: 20px;\n      text-align: center;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"score-bug\" id=\"scoreBug\">\n    <div class=\"lineup-card\" id=\"lineupCard\">\n      <!-- Lineup card content populated dynamically -->\n    </div>\n    <div class=\"rotation-tag\" id=\"rotationTag\">Rotation 1 of 6</div>\n    <div class=\"team-rows\" id=\"teamRows\">\n      <!-- Team rows populated dynamically -->\n    </div>\n  </div>\n\n  <script>\n    // Firebase configuration\n    const firebaseConfig = {\n      apiKey: \"AIzaSyCh0aZUvKl6Qvqsva3hvOgJJlleP1OwcTY\",\n      authDomain: \"gymnastics-graphics.firebaseapp.com\",\n      databaseURL: \"https://gymnastics-graphics-default-rtdb.firebaseio.com\",\n      projectId: \"gymnastics-graphics\",\n      storageBucket: \"gymnastics-graphics.firebasestorage.app\",\n      messagingSenderId: \"702072609550\",\n      appId: \"1:702072609550:web:ac74a811186d3ff45b955f\"\n    };\n\n    // Initialize Firebase\n    firebase.initializeApp(firebaseConfig);\n    const db = firebase.database();\n\n    // Parse URL parameters\n    const params = new URLSearchParams(window.location.search);\n    const compId = params.get('compId');\n\n    if (!compId) {\n      console.error('Missing compId parameter');\n      document.body.innerHTML = '<div class=\"error-state\">Missing compId parameter</div>';\n    }\n\n    // State management\n    const state = {\n      enabled: false,\n      polling: false,\n      automationMode: 'auto',\n      showLineup: null,\n      teams: [],\n      rotation: { current: 1, total: 6, isFinal: false },\n      previousScores: {},        // { \"gymnast_id\": \"finalScore\" (string) }\n      previousTeamTotals: {},    // { \"teamKey\": \"finalScore\" (string) }\n      flashQueues: {},           // Per-team flash queues\n      activeFlashes: {},         // Currently active flashes per team\n      nowCompeting: [],          // Currently competing athletes per team (B1)\n      pollInterval: 5000,\n      flashDuration: 10000,\n      stalePollCount: 0,         // Consecutive polls with no data changes\n      // Competition config (loaded from Firebase)\n      competitionConfig: null,\n      virtiusSessionId: null,\n      gender: 'mens',\n      // Error handling state (A3c)\n      consecutiveErrors: 0,      // Count of consecutive poll failures\n      lastError: null,           // Last error message\n      lastErrorTime: null,       // Timestamp of last error\n      maxBackoffMs: 60000,       // Max backoff delay (60 seconds)\n      // Offline/reconnect state (A3d)\n      firebaseConnected: true,   // Firebase connection state\n      pendingWrites: [],         // Writes queued during offline\n      reconnectAttempts: 0       // Count of reconnect attempts\n    };\n\n    /**\n     * Normalize athlete name for lookup (lowercase, remove special chars).\n     * Matches pattern used in output.html for headshot lookups.\n     */\n    function normalizeName(name) {\n      if (!name) return '';\n      return name.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');\n    }\n\n    // Firebase paths\n    const scoreBugRef = db.ref(`competitions/${compId}/scoreBug`);\n    const configRef = db.ref(`competitions/${compId}/config`);\n    const connectedRef = db.ref('.info/connected');\n\n    /**\n     * Initialize Firebase connection monitoring (A3d).\n     * Detects offline/online state and handles reconnection.\n     */\n    function initConnectionMonitor() {\n      connectedRef.on('value', (snapshot) => {\n        const connected = snapshot.val() === true;\n        const wasConnected = state.firebaseConnected;\n        state.firebaseConnected = connected;\n\n        if (connected && !wasConnected) {\n          // Just reconnected\n          console.log('Firebase connected - processing pending writes');\n          state.reconnectAttempts = 0;\n          processPendingWrites();\n\n          // Write reconnect event to Firebase\n          scoreBugRef.child('connectionStatus').set({\n            connected: true,\n            reconnectedAt: Date.now(),\n            pendingWritesProcessed: state.pendingWrites.length\n          });\n        } else if (!connected && wasConnected) {\n          // Just went offline\n          console.warn('Firebase disconnected - writes will be queued');\n          state.reconnectAttempts++;\n\n          // Note: Firebase SDK has offline persistence by default\n          // Writes are automatically queued and synced on reconnect\n        }\n\n        console.log('Firebase connection state:', connected ? 'ONLINE' : 'OFFLINE');\n      });\n    }\n\n    /**\n     * Process any pending writes that were queued during offline.\n     * Firebase SDK handles this automatically, but we log for visibility.\n     */\n    function processPendingWrites() {\n      if (state.pendingWrites.length === 0) return;\n\n      console.log('Processing', state.pendingWrites.length, 'pending writes');\n\n      // Firebase SDK automatically syncs queued writes\n      // Clear our tracking array\n      state.pendingWrites = [];\n    }\n\n    /**\n     * Safe write to Firebase with offline queueing (A3d).\n     * Wraps Firebase write operations to track pending writes during offline.\n     * @param {firebase.database.Reference} ref - Firebase reference\n     * @param {string} method - 'set', 'update', or 'remove'\n     * @param {*} data - Data to write (for set/update)\n     * @returns {Promise}\n     */\n    async function safeWrite(ref, method, data) {\n      const writeOp = { path: ref.toString(), method, data, timestamp: Date.now() };\n\n      if (!state.firebaseConnected) {\n        // Queue the write for tracking (Firebase SDK queues automatically)\n        state.pendingWrites.push(writeOp);\n        console.log('Queued offline write:', writeOp.path, method);\n      }\n\n      try {\n        if (method === 'set') {\n          await ref.set(data);\n        } else if (method === 'update') {\n          await ref.update(data);\n        } else if (method === 'remove') {\n          await ref.remove();\n        }\n        return true;\n      } catch (err) {\n        // Firebase SDK will retry on reconnect\n        console.error('Write failed (will retry on reconnect):', err.message);\n        if (!state.pendingWrites.includes(writeOp)) {\n          state.pendingWrites.push(writeOp);\n        }\n        return false;\n      }\n    }\n\n    /**\n     * Load competition config from Firebase.\n     * Gets virtiusSessionId, team names/logos, gender, and compType.\n     * Must be called before initializing Firebase listeners.\n     */\n    async function loadCompetitionConfig() {\n      try {\n        const snapshot = await configRef.once('value');\n        const config = snapshot.val();\n\n        if (!config) {\n          console.error('No competition config found for compId:', compId);\n          document.body.innerHTML = '<div class=\"error-state\">Competition not found</div>';\n          return false;\n        }\n\n        state.competitionConfig = config;\n        state.virtiusSessionId = config.virtiusSessionId || null;\n        state.gender = config.gender || 'mens';\n\n        // Build teams array from config (up to 6 teams)\n        state.teams = [];\n        for (let i = 1; i <= 6; i++) {\n          const teamName = config[`team${i}Name`];\n          if (teamName) {\n            state.teams.push({\n              index: i,\n              name: teamName,\n              logo: config[`team${i}Logo`] || '',\n              tricode: config[`team${i}Tricode`] || '',\n              total: '--'  // Initial state before first API poll\n            });\n          }\n        }\n\n        // Determine total rotations based on gender (6 for men, 4 for women)\n        state.rotation.total = state.gender === 'womens' ? 4 : 6;\n\n        console.log('Competition config loaded:', {\n          compId,\n          virtiusSessionId: state.virtiusSessionId,\n          gender: state.gender,\n          teamCount: state.teams.length,\n          teams: state.teams.map(t => t.name)\n        });\n\n        // Check if Virtius session ID is configured\n        if (!state.virtiusSessionId) {\n          console.warn('No Virtius session ID configured - API polling will not work');\n        }\n\n        return true;\n      } catch (err) {\n        console.error('Failed to load competition config:', err);\n        document.body.innerHTML = '<div class=\"error-state\">Failed to load competition config</div>';\n        return false;\n      }\n    }\n\n    /**\n     * Render initial team rows based on competition config.\n     * Called after loadCompetitionConfig() to show teams before API polling starts.\n     */\n    function renderTeamRows() {\n      const container = document.getElementById('teamRows');\n      if (!container) return;\n\n      container.innerHTML = state.teams.map((team, idx) => `\n        <div class=\"team-row\" data-team-index=\"${team.index}\">\n          <div class=\"team-fixed\">\n            <img class=\"team-logo\" src=\"${team.logo}\" alt=\"${team.name}\" onerror=\"this.style.display='none'\">\n            <div class=\"team-total\" id=\"teamTotal${team.index}\">${team.total}</div>\n          </div>\n          <div class=\"team-slot\" id=\"teamSlot${team.index}\">\n            <div class=\"slot-content\" id=\"slotContent${team.index}\">\n              <!-- Score flash / now competing content populated dynamically -->\n            </div>\n          </div>\n        </div>\n      `).join('');\n\n      console.log('Team rows rendered:', state.teams.length);\n    }\n\n    /**\n     * Update team total display element (A4).\n     * Called when API polling detects a change in team.final_score.\n     * Adds highlight animation on value change.\n     * @param {number} teamIndex - 1-based team index\n     * @param {string} newTotal - Formatted score string (e.g., \"196.450\")\n     */\n    function updateTeamTotal(teamIndex, newTotal) {\n      const totalEl = document.getElementById(`teamTotal${teamIndex}`);\n      if (!totalEl) return;\n\n      const prevTotal = totalEl.textContent;\n\n      // Only update if value changed\n      if (prevTotal === newTotal) return;\n\n      totalEl.textContent = newTotal;\n\n      // Trigger highlight animation on change (skip for initial load)\n      if (prevTotal !== '--') {\n        totalEl.classList.remove('highlight');\n        // Force reflow to restart animation\n        void totalEl.offsetWidth;\n        totalEl.classList.add('highlight');\n      }\n    }\n\n    /**\n     * Update all team totals from state (A4).\n     * Called after API poll updates state.teams[].total values.\n     */\n    function updateAllTeamTotals() {\n      state.teams.forEach((team) => {\n        updateTeamTotal(team.index, team.total);\n      });\n    }\n\n    // Initialize Firebase listeners\n    function initFirebaseListeners() {\n      // Listen for enabled state\n      scoreBugRef.child('enabled').on('value', (snapshot) => {\n        state.enabled = snapshot.val() === true;\n        updateBugVisibility();\n      });\n\n      // Listen for polling state\n      scoreBugRef.child('polling').on('value', (snapshot) => {\n        const wasPolling = state.polling;\n        state.polling = snapshot.val() === true;\n        if (state.polling && !wasPolling) {\n          startPolling();\n        } else if (!state.polling && wasPolling) {\n          stopPolling();\n        }\n      });\n\n      // Listen for automation mode\n      scoreBugRef.child('automationMode').on('value', (snapshot) => {\n        state.automationMode = snapshot.val() || 'auto';\n      });\n\n      // Listen for lineup card toggle\n      scoreBugRef.child('showLineup').on('value', (snapshot) => {\n        state.showLineup = snapshot.val();\n        updateLineupCard();\n      });\n\n      // Listen for flash dismissals\n      scoreBugRef.child('dismissFlash').on('value', (snapshot) => {\n        const dismissals = snapshot.val() || {};\n        handleFlashDismissals(dismissals);\n      });\n\n      // Listen for poll interval changes - restart polling with new interval\n      scoreBugRef.child('config/pollInterval').on('value', (snapshot) => {\n        const newInterval = snapshot.val() || 5000;\n        const wasPolling = state.polling && pollTimer !== null;\n        state.pollInterval = newInterval;\n\n        // Restart polling with new interval if currently polling\n        if (wasPolling) {\n          console.log('Poll interval changed to', newInterval, 'ms - restarting polling');\n          stopPolling();\n          startPolling();\n        }\n      });\n\n      // Listen for flash duration changes\n      scoreBugRef.child('config/flashDuration').on('value', (snapshot) => {\n        state.flashDuration = snapshot.val() || 10000;\n      });\n\n      console.log('Firebase listeners initialized');\n    }\n\n    // Update bug visibility based on enabled state\n    function updateBugVisibility() {\n      const bugEl = document.getElementById('scoreBug');\n      if (state.enabled) {\n        bugEl.classList.add('visible');\n      } else {\n        bugEl.classList.remove('visible');\n      }\n    }\n\n    // Update lineup card visibility\n    function updateLineupCard() {\n      const cardEl = document.getElementById('lineupCard');\n      if (state.showLineup) {\n        cardEl.classList.add('visible');\n        // TODO: Populate lineup card content (Phase C)\n      } else {\n        cardEl.classList.remove('visible');\n      }\n    }\n\n    /**\n     * Handle flash dismissals from producer panel (Task A12c).\n     * When producer clicks \"dismiss\" for a team, immediately clears\n     * the active flash and advances to next in queue.\n     * @param {Object} dismissals - Map of teamIndex -> timestamp\n     */\n    function handleFlashDismissals(dismissals) {\n      if (!dismissals || typeof dismissals !== 'object') return;\n\n      Object.keys(dismissals).forEach((teamIndexStr) => {\n        const teamIndex = parseInt(teamIndexStr, 10);\n        const dismissTimestamp = dismissals[teamIndex];\n\n        // Skip if no active flash for this team\n        if (!state.activeFlashes[teamIndex]) return;\n\n        // Skip if already processed this dismissal (compare timestamps)\n        const activeFlash = state.activeFlashes[teamIndex];\n        if (activeFlash.dismissedAt === dismissTimestamp) return;\n\n        console.log('Processing flash dismissal:', {\n          team: teamIndex,\n          gymnast: activeFlash.name,\n          dismissTimestamp\n        });\n\n        // Mark as processed\n        activeFlash.dismissedAt = dismissTimestamp;\n\n        // Clear the timer for current flash\n        if (activeFlash.timer) {\n          clearTimeout(activeFlash.timer);\n        }\n\n        // Advance to next flash (or clear if queue empty)\n        advanceFlashQueue(teamIndex);\n\n        // Clear the dismissal flag in Firebase after processing\n        scoreBugRef.child(`dismissFlash/${teamIndex}`).remove();\n      });\n    }\n\n    // Polling management\n    let pollTimer = null;\n\n    function startPolling() {\n      if (pollTimer) return;\n      console.log('Starting API polling');\n      poll();  // Initial poll\n      pollTimer = setInterval(poll, state.pollInterval);\n    }\n\n    function stopPolling() {\n      if (pollTimer) {\n        clearInterval(pollTimer);\n        pollTimer = null;\n        console.log('Stopped API polling');\n      }\n    }\n\n    // Main poll function - fetches data from Virtius API\n    async function poll() {\n      // Check if we have a valid session ID\n      if (!state.virtiusSessionId) {\n        console.warn('No Virtius session ID - skipping poll');\n        return;\n      }\n\n      const pollStartTime = Date.now();\n\n      try {\n        // Fetch from Virtius API\n        const response = await fetch(`https://api.virti.us/session/${state.virtiusSessionId}/json`);\n\n        if (!response.ok) {\n          throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n        }\n\n        const data = await response.json();\n\n        // Store raw API data for score diff engine (Task A5)\n        // Extract teams array from meet data\n        const teams = data.meet?.teams || [];\n\n        if (teams.length === 0) {\n          console.warn('No teams found in API response');\n        }\n\n        // Store the latest API data in state\n        state.lastApiData = data;\n        state.lastApiTeams = teams;\n\n        // Extract team totals and update state.teams with actual data\n        // final_score comes as a string from API - convert to float for display\n        teams.forEach((apiTeam, idx) => {\n          // Match API team to our configured teams by index or name\n          const stateTeam = state.teams[idx];\n          if (stateTeam) {\n            // Convert string final_score to formatted number\n            const rawScore = apiTeam.final_score;\n            if (rawScore !== null && rawScore !== undefined) {\n              const numScore = parseFloat(rawScore);\n              stateTeam.total = isNaN(numScore) ? '--' : numScore.toFixed(3);\n            }\n            // Store API team reference for score diff engine\n            stateTeam.apiTeam = apiTeam;\n          }\n        });\n\n        // Write heartbeat to Firebase on successful poll (using safeWrite for offline resilience)\n        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n\n        console.log('Poll successful:', {\n          sessionId: state.virtiusSessionId,\n          teamCount: teams.length,\n          teams: state.teams.map(t => ({ name: t.name, total: t.total }))\n        });\n\n        // Process API data - detect changes and write deltas to Firebase\n        await processApiData(teams, pollStartTime);\n\n        // Update team total displays (A4)\n        updateAllTeamTotals();\n\n      } catch (err) {\n        // Error handling with exponential backoff (A3c)\n        state.consecutiveErrors++;\n        state.lastError = err.message;\n        state.lastErrorTime = pollStartTime;\n\n        // Calculate backoff delay: 5s, 10s, 20s, 40s, 60s (max)\n        const backoffDelay = Math.min(\n          state.pollInterval * Math.pow(2, state.consecutiveErrors - 1),\n          state.maxBackoffMs\n        );\n\n        console.error('Poll failed:', {\n          error: err.message,\n          consecutiveErrors: state.consecutiveErrors,\n          nextRetryIn: `${backoffDelay / 1000}s`\n        });\n\n        // Write error state to Firebase for producer panel visibility (D5b)\n        // Using safeWrite for offline resilience\n        await safeWrite(scoreBugRef.child('apiError'), 'set', {\n          message: err.message,\n          consecutiveErrors: state.consecutiveErrors,\n          timestamp: pollStartTime,\n          nextRetryMs: backoffDelay\n        });\n        // Still write heartbeat to indicate overlay is running\n        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n\n        // Schedule next poll with backoff delay if we're still supposed to be polling\n        if (state.polling && pollTimer) {\n          clearInterval(pollTimer);\n          pollTimer = setTimeout(() => {\n            if (state.polling) {\n              poll();\n              // If poll succeeds, startPolling() will be called to restore normal interval\n            }\n          }, backoffDelay);\n        }\n        return; // Skip normal completion\n      }\n\n      // Success - reset error state\n      if (state.consecutiveErrors > 0) {\n        console.log('Poll recovered after', state.consecutiveErrors, 'consecutive errors');\n        state.consecutiveErrors = 0;\n        state.lastError = null;\n        state.lastErrorTime = null;\n\n        // Clear error state in Firebase\n        await safeWrite(scoreBugRef.child('apiError'), 'remove');\n\n        // Restore normal polling interval (we might be on backoff timeout)\n        if (state.polling && pollTimer) {\n          clearTimeout(pollTimer);\n          clearInterval(pollTimer);\n          pollTimer = setInterval(poll, state.pollInterval);\n        }\n      }\n    }\n\n    /**\n     * Process API data - detect score changes and write incremental deltas to Firebase.\n     * Only writes changed paths, not full data rewrite.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @param {number} pollTimestamp - Timestamp of this poll\n     */\n    async function processApiData(apiTeams, pollTimestamp) {\n      const changedPaths = {};\n      let hasChanges = false;\n\n      // Process each team\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n\n        // Check if team total changed\n        const prevTeamTotal = state.previousTeamTotals[teamKey];\n        const currTeamTotal = team.final_score;  // string or null\n\n        if (currTeamTotal !== prevTeamTotal) {\n          changedPaths[`teams/${teamKey}/finalScore`] = currTeamTotal;\n          changedPaths[`teams/${teamKey}/name`] = team.name || teamKey;\n          hasChanges = true;\n        }\n\n        // Process each event's gymnasts for score changes\n        const events = team.events || [];\n        events.forEach((event) => {\n          const eventKey = event.short_name || event.name || 'unknown';\n          const gymnasts = event.gymnasts || [];\n\n          gymnasts.forEach((gymnast) => {\n            // Primary key: gymnast_id. Fallback: teamKey|normalizedName\n            const gymnastKey = gymnast.gymnast_id ||\n              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n\n            const prevScore = state.previousScores[gymnastKey];\n            const currScore = gymnast.final_score;  // string or null\n\n            // Score changed (new score OR corrected score)\n            if (currScore != null && prevScore !== currScore) {\n              // Build gymnast data for Firebase and flash queue\n              const gymnastData = {\n                name: gymnast.full_name,\n                score: currScore,\n                startValue: gymnast.start_value || null,\n                execution: gymnast.execution || null,\n                difficulty: gymnast.difficulty || null,\n                order: gymnast.order,\n                event: eventKey,\n                team: teamKey,\n                gymnastKey: gymnastKey,\n                timestamp: pollTimestamp,\n                isCorrection: prevScore != null  // True if score was changed (not new)\n              };\n\n              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}`] = gymnastData;\n              hasChanges = true;\n\n              console.log('Score change detected:', {\n                gymnast: gymnast.full_name,\n                event: eventKey,\n                team: teamKey,\n                prev: prevScore,\n                curr: currScore,\n                isCorrection: prevScore != null\n              });\n\n              // Trigger flash for this score change (A5)\n              const teamIndex = teamIdx + 1;  // Convert 0-based to 1-based index\n              if (isFlashActive(teamIndex, gymnastKey)) {\n                // Correction during active flash - interrupt and replace\n                interruptFlash(teamIndex, gymnastData);\n              } else {\n                // Queue new flash for this team\n                triggerScoreFlash(teamIndex, gymnastData);\n              }\n            }\n\n            // Score removed (rare - inquiry pending)\n            if (currScore == null && prevScore != null) {\n              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}/score`] = null;\n              hasChanges = true;\n              console.log('Score removed:', { gymnast: gymnast.full_name, event: eventKey });\n            }\n          });\n        });\n      });\n\n      // Write to Firebase (using safeWrite for offline resilience)\n      if (hasChanges) {\n        // Write changed paths and reset stale counter\n        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n          ...changedPaths,\n          lastDataChangeTimestamp: pollTimestamp,\n          stalePollCount: 0\n        });\n        state.stalePollCount = 0;\n\n        console.log('Wrote incremental deltas to Firebase:', Object.keys(changedPaths).length, 'paths');\n      } else {\n        // No changes - increment stale counter\n        state.stalePollCount++;\n        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n          lastPollTimestamp: pollTimestamp,\n          stalePollCount: state.stalePollCount\n        });\n      }\n\n      // Update previous state for next comparison\n      state.previousScores = buildScoreMap(apiTeams);\n      state.previousTeamTotals = buildTeamTotalMap(apiTeams);\n\n      // Detect and update rotation (A10)\n      const newRotation = detectRotation(apiTeams);\n      if (newRotation.current !== state.rotation.current ||\n          newRotation.isFinal !== state.rotation.isFinal) {\n        state.rotation = newRotation;\n        updateRotationTag();\n\n        // Write rotation to Firebase for producer panel visibility\n        await safeWrite(scoreBugRef.child('liveData/rotation'), 'set', newRotation.current);\n        await safeWrite(scoreBugRef.child('liveData/totalRotations'), 'set', newRotation.total);\n        await safeWrite(scoreBugRef.child('liveData/isFinal'), 'set', newRotation.isFinal);\n\n        console.log('Rotation updated:', newRotation);\n      }\n\n      // Detect now-competing athletes (B1)\n      const nowCompeting = detectAllNowCompeting(apiTeams);\n      const prevNowCompeting = state.nowCompeting || [];\n\n      // Check if now-competing has changed\n      const nowCompetingChanged = JSON.stringify(nowCompeting) !== JSON.stringify(prevNowCompeting);\n\n      if (nowCompetingChanged) {\n        state.nowCompeting = nowCompeting;\n\n        // Write detected state to Firebase for producer panel visibility\n        await safeWrite(scoreBugRef.child('detected/nowCompeting'), 'set', nowCompeting);\n\n        console.log('Now competing updated:', nowCompeting);\n      }\n    }\n\n    /**\n     * Build score map from API teams data.\n     * @returns {Object} Map of gymnastKey -> finalScore (string)\n     */\n    function buildScoreMap(apiTeams) {\n      const map = {};\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n        const events = team.events || [];\n\n        events.forEach((event) => {\n          const gymnasts = event.gymnasts || [];\n          gymnasts.forEach((gymnast) => {\n            const gymnastKey = gymnast.gymnast_id ||\n              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n            map[gymnastKey] = gymnast.final_score;  // string or null\n          });\n        });\n      });\n      return map;\n    }\n\n    /**\n     * Build team total map from API teams data.\n     * @returns {Object} Map of teamKey -> finalScore (string)\n     */\n    function buildTeamTotalMap(apiTeams) {\n      const map = {};\n      apiTeams.forEach((team, teamIdx) => {\n        const teamKey = team.short_name || `team${teamIdx + 1}`;\n        map[teamKey] = team.final_score;  // string or null\n      });\n      return map;\n    }\n\n    // ============================================================\n    // SCORE DIFF ENGINE - Flash Queue Management (Task A5)\n    // ============================================================\n\n    /**\n     * Check if a flash is currently active for a given team and gymnast.\n     * Used to detect score corrections during active flash display.\n     * @param {number} teamIndex - 1-based team index\n     * @param {string} gymnastKey - Unique gymnast identifier\n     * @returns {boolean} True if flash is active for this gymnast\n     */\n    function isFlashActive(teamIndex, gymnastKey) {\n      const activeFlash = state.activeFlashes[teamIndex];\n      return activeFlash && activeFlash.gymnastKey === gymnastKey;\n    }\n\n    /**\n     * Interrupt current flash with a new one (score correction case).\n     * Immediately replaces the active flash and resets timer.\n     * @param {number} teamIndex - 1-based team index\n     * @param {Object} gymnastData - New score data to display\n     */\n    function interruptFlash(teamIndex, gymnastData) {\n      console.log('Interrupting active flash with correction:', {\n        team: teamIndex,\n        gymnast: gymnastData.name,\n        newScore: gymnastData.score\n      });\n\n      // Clear existing flash timer\n      if (state.activeFlashes[teamIndex]?.timer) {\n        clearTimeout(state.activeFlashes[teamIndex].timer);\n      }\n\n      // Replace with new flash data\n      state.activeFlashes[teamIndex] = {\n        ...gymnastData,\n        startTime: Date.now(),\n        timer: null\n      };\n\n      // Render the updated flash immediately\n      renderFlash(teamIndex, gymnastData);\n\n      // Set new timer\n      state.activeFlashes[teamIndex].timer = setTimeout(() => {\n        advanceFlashQueue(teamIndex);\n      }, state.flashDuration);\n    }\n\n    /**\n     * Queue a new score flash for a team.\n     * If no flash is active, displays immediately. Otherwise queued.\n     * @param {number} teamIndex - 1-based team index\n     * @param {Object} gymnastData - Score data to display\n     */\n    function triggerScoreFlash(teamIndex, gymnastData) {\n      // Initialize queue if needed\n      if (!state.flashQueues[teamIndex]) {\n        state.flashQueues[teamIndex] = [];\n      }\n\n      const queue = state.flashQueues[teamIndex];\n\n      // Edge case: Check if this gymnast is already in the queue (correction before display)\n      const existingIndex = queue.findIndex(item => item.gymnastKey === gymnastData.gymnastKey);\n      if (existingIndex !== -1) {\n        // Update existing queue entry with corrected score (A13: corrections in queue)\n        console.log('Updating queued flash with correction:', {\n          team: teamIndex,\n          gymnast: gymnastData.name,\n          oldScore: queue[existingIndex].score,\n          newScore: gymnastData.score\n        });\n        queue[existingIndex] = { ...gymnastData, isCorrection: true };\n        return;\n      }\n\n      // Edge case: Cap queue length to prevent runaway (A13: rapid scores)\n      const MAX_QUEUE_SIZE = 6;  // Max gymnasts per rotation\n      if (queue.length >= MAX_QUEUE_SIZE) {\n        console.warn('Flash queue full, dropping oldest entry:', {\n          team: teamIndex,\n          dropped: queue[0].name,\n          newEntry: gymnastData.name\n        });\n        queue.shift();\n      }\n\n      console.log('Queuing score flash:', {\n        team: teamIndex,\n        gymnast: gymnastData.name,\n        score: gymnastData.score,\n        queueLength: queue.length\n      });\n\n      // Add to queue\n      queue.push(gymnastData);\n\n      // If no active flash, start displaying\n      if (!state.activeFlashes[teamIndex]) {\n        displayNextFlash(teamIndex);\n      }\n    }\n\n    /**\n     * Display the next flash from the queue.\n     * Called when starting or advancing the queue.\n     * @param {number} teamIndex - 1-based team index\n     */\n    function displayNextFlash(teamIndex) {\n      const queue = state.flashQueues[teamIndex] || [];\n\n      if (queue.length === 0) {\n        // No more flashes - clear active state\n        state.activeFlashes[teamIndex] = null;\n        clearFlashDisplay(teamIndex);\n        return;\n      }\n\n      // Get next flash from queue\n      const gymnastData = queue.shift();\n\n      // Set as active\n      state.activeFlashes[teamIndex] = {\n        ...gymnastData,\n        startTime: Date.now(),\n        timer: setTimeout(() => {\n          advanceFlashQueue(teamIndex);\n        }, state.flashDuration)\n      };\n\n      // Render the flash\n      renderFlash(teamIndex, gymnastData);\n    }\n\n    /**\n     * Advance to next flash in queue (called when timer expires).\n     * @param {number} teamIndex - 1-based team index\n     */\n    function advanceFlashQueue(teamIndex) {\n      // Clear current flash timer\n      if (state.activeFlashes[teamIndex]?.timer) {\n        clearTimeout(state.activeFlashes[teamIndex].timer);\n      }\n\n      // Display next or clear\n      displayNextFlash(teamIndex);\n    }\n\n    /**\n     * Render a score flash in a team's slot area with slot machine animation.\n     * TODO: Task A7 will enhance rendering with headshots/apparatus.\n     * @param {number} teamIndex - 1-based team index\n     * @param {Object} gymnastData - Score data to render\n     */\n    function renderFlash(teamIndex, gymnastData) {\n      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n      if (!slotContent) return;\n\n      // Check if there's existing content to animate out\n      const hasExistingContent = slotContent.innerHTML.trim() !== '';\n\n      if (hasExistingContent) {\n        // Spin out existing content first\n        slotContent.classList.remove('spin-in', 'visible');\n        slotContent.classList.add('spin-out');\n\n        // After spin-out completes, insert new content and spin in\n        setTimeout(() => {\n          insertFlashContent(slotContent, gymnastData);\n          triggerSpinIn(slotContent);\n        }, 400);  // Match spin-out animation duration\n      } else {\n        // No existing content - insert and spin in directly\n        insertFlashContent(slotContent, gymnastData);\n        triggerSpinIn(slotContent);\n      }\n\n      console.log('Rendered flash:', {\n        team: teamIndex,\n        gymnast: gymnastData.name,\n        score: gymnastData.score,\n        animated: hasExistingContent ? 'spin-transition' : 'spin-in'\n      });\n    }\n\n    /**\n     * Insert flash content HTML into slot element (Task A7).\n     * Renders: apparatus | name | SV | separator | score | correction indicator\n     * @param {HTMLElement} slotContent - The slot content container\n     * @param {Object} gymnastData - Score data to render\n     */\n    function insertFlashContent(slotContent, gymnastData) {\n      // Format start value for display (e.g., \"5.0\" or \"5.2\")\n      const svDisplay = gymnastData.startValue\n        ? `<span class=\"slot-sv\">SV ${parseFloat(gymnastData.startValue).toFixed(1)}</span>`\n        : '';\n\n      // Format score for display (e.g., \"13.450\")\n      const scoreValue = parseFloat(gymnastData.score);\n      const scoreDisplay = isNaN(scoreValue) ? gymnastData.score : scoreValue.toFixed(3);\n\n      slotContent.innerHTML = `\n        <span class=\"slot-apparatus\">${gymnastData.event}</span>\n        <span class=\"slot-name\">${gymnastData.name}</span>\n        ${svDisplay}\n        <span class=\"slot-separator\">•</span>\n        <span class=\"slot-score\">${scoreDisplay}</span>\n        ${gymnastData.isCorrection ? '<span class=\"slot-correction\">(corrected)</span>' : ''}\n      `;\n    }\n\n    /**\n     * Trigger spin-in animation on slot content.\n     * @param {HTMLElement} slotContent - The slot content container\n     */\n    function triggerSpinIn(slotContent) {\n      // Reset animation state\n      slotContent.classList.remove('spin-out', 'exit-up', 'enter-from-below');\n\n      // Force reflow to ensure animation restarts\n      void slotContent.offsetWidth;\n\n      // Trigger spin-in animation\n      slotContent.classList.add('spin-in', 'visible');\n    }\n\n    /**\n     * Clear flash display for a team (return to idle state) with spin-out animation.\n     * @param {number} teamIndex - 1-based team index\n     */\n    function clearFlashDisplay(teamIndex) {\n      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n      if (!slotContent) return;\n\n      // Only animate if there's content to clear\n      if (slotContent.innerHTML.trim() === '') return;\n\n      // Trigger spin-out animation\n      slotContent.classList.remove('spin-in', 'visible');\n      slotContent.classList.add('spin-out');\n\n      // Clear content after animation completes\n      setTimeout(() => {\n        if (!state.activeFlashes[teamIndex]) {\n          slotContent.innerHTML = '';\n          slotContent.classList.remove('spin-out');\n        }\n      }, 400);  // Match CSS animation duration\n    }\n\n    /**\n     * Get current flash queue status for debugging/producer panel.\n     * @returns {Object} Queue status by team\n     */\n    function getFlashQueueStatus() {\n      const status = {};\n      state.teams.forEach((team) => {\n        const queue = state.flashQueues[team.index] || [];\n        const active = state.activeFlashes[team.index];\n        status[team.index] = {\n          teamName: team.name,\n          queueLength: queue.length,\n          activeFlash: active ? {\n            gymnast: active.name,\n            score: active.score,\n            timeRemaining: active.startTime ?\n              Math.max(0, state.flashDuration - (Date.now() - active.startTime)) : 0\n          } : null\n        };\n      });\n      return status;\n    }\n\n    // ============================================================\n    // ROTATION DETECTION (Task A10)\n    // ============================================================\n\n    /**\n     * Detect current rotation from API data using ALL teams.\n     * Rotation only advances when ALL teams have completed their current event.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @returns {Object} { current: number, total: number, isFinal: boolean }\n     */\n    function detectRotation(apiTeams) {\n      if (!apiTeams || apiTeams.length === 0) {\n        return state.rotation;  // Keep existing state if no data\n      }\n\n      // Total events based on gender (6 for men, 4 for women)\n      const totalEvents = state.rotation.total;\n\n      // Find minimum completed events across ALL teams\n      let minCompletedAcrossTeams = totalEvents;\n\n      apiTeams.forEach((team) => {\n        const events = team.events || [];\n        let completedEvents = 0;\n\n        events.forEach((event) => {\n          const gymnasts = event.gymnasts || [];\n          // An event is \"complete\" if all gymnasts have scores\n          const scored = gymnasts.filter(g => g.final_score != null);\n          if (scored.length === gymnasts.length && gymnasts.length > 0) {\n            completedEvents++;\n          }\n        });\n\n        minCompletedAcrossTeams = Math.min(minCompletedAcrossTeams, completedEvents);\n      });\n\n      // All events complete for all teams = Final\n      if (minCompletedAcrossTeams === totalEvents) {\n        return { current: totalEvents, total: totalEvents, isFinal: true };\n      }\n\n      // Current rotation = completed events + 1\n      const currentRotation = minCompletedAcrossTeams + 1;\n      return { current: currentRotation, total: totalEvents, isFinal: false };\n    }\n\n    /**\n     * Detect the currently competing athlete for a team.\n     * Finds the next athlete without a score in an event that has some scores.\n     * Based on logic from GraphicsControl.jsx:216-269.\n     * @param {Object} team - Team object from Virtius API\n     * @returns {Object|null} { athlete: Object, event: Object } or null\n     */\n    function detectNowCompeting(team) {\n      if (!team || !team.events) return null;\n\n      // Olympic order for events (already sorted in API, but just in case)\n      const events = team.events;\n\n      for (const event of events) {\n        const gymnasts = event.gymnasts || [];\n        if (gymnasts.length === 0) continue;\n\n        // Sort by order (lineup position)\n        const sortedGymnasts = [...gymnasts].sort((a, b) => (a.order || 0) - (b.order || 0));\n\n        // Find scored and unscored athletes\n        const scored = sortedGymnasts.filter(g => g.final_score != null);\n        const unscored = sortedGymnasts.filter(g => g.final_score == null);\n\n        // If this event has some scores but not all, it's in progress\n        if (scored.length > 0 && unscored.length > 0) {\n          return {\n            athlete: unscored[0],\n            event: event\n          };\n        }\n      }\n\n      return null; // No one currently competing (between rotations or complete)\n    }\n\n    /**\n     * Detect now-competing athletes for all teams and return results.\n     * @param {Array} apiTeams - Teams array from Virtius API\n     * @returns {Array} Array of { teamIndex, teamName, tricode, athlete, eventName }\n     */\n    function detectAllNowCompeting(apiTeams) {\n      if (!apiTeams || apiTeams.length === 0) return [];\n\n      const results = [];\n\n      apiTeams.forEach((team, teamIndex) => {\n        const nowCompeting = detectNowCompeting(team);\n        if (nowCompeting) {\n          results.push({\n            teamIndex: teamIndex,\n            teamName: team.name,\n            tricode: team.tricode,\n            athlete: {\n              id: nowCompeting.athlete.gymnast_id,\n              name: nowCompeting.athlete.full_name,\n              order: nowCompeting.athlete.order,\n              type: nowCompeting.athlete.type // 0=competing, 1=exhibition, etc.\n            },\n            eventName: nowCompeting.event.event_name\n          });\n        }\n      });\n\n      return results;\n    }\n\n    /**\n     * Update the rotation tag display in the DOM.\n     * Shows \"Rotation X of Y\" or \"Final\" when complete.\n     */\n    function updateRotationTag() {\n      const tagEl = document.getElementById('rotationTag');\n      if (!tagEl) return;\n\n      const { current, total, isFinal } = state.rotation;\n\n      if (isFinal) {\n        tagEl.textContent = 'Final';\n      } else {\n        tagEl.textContent = `Rotation ${current} of ${total}`;\n      }\n    }\n\n    // Initialize Firebase schema with default values (prevents race conditions)\n    // Uses update() with null checks - only sets values that don't exist\n    async function initializeSchema() {\n      const defaultSchema = {\n        enabled: false,\n        polling: false,\n        automationMode: 'auto',\n        showLineup: null,\n        dismissFlash: {},\n        nowCompeting: {},\n        detected: {},\n        heartbeat: null,\n        liveData: {\n          lastPollTimestamp: null,\n          lastDataChangeTimestamp: null,\n          stalePollCount: 0,\n          rotation: null,\n          totalRotations: null,\n          teams: {}\n        },\n        lastError: null,\n        config: {\n          pollInterval: 5000,\n          flashDuration: 10000,\n          showStickIndicator: true\n        }\n      };\n\n      try {\n        // Use transaction to safely initialize schema without overwriting existing values\n        await scoreBugRef.transaction((currentData) => {\n          if (currentData === null) {\n            // No data exists - write full schema\n            console.log('Initializing scoreBug schema with defaults');\n            return defaultSchema;\n          }\n          // Data exists - merge defaults for any missing fields only\n          const merged = { ...defaultSchema };\n          Object.keys(currentData).forEach(key => {\n            if (currentData[key] !== undefined) {\n              // Keep existing value\n              merged[key] = currentData[key];\n            }\n          });\n          // Deep merge for nested objects (config, liveData)\n          if (currentData.config) {\n            merged.config = { ...defaultSchema.config, ...currentData.config };\n          }\n          if (currentData.liveData) {\n            merged.liveData = { ...defaultSchema.liveData, ...currentData.liveData };\n          }\n          console.log('Merged existing scoreBug data with defaults');\n          return merged;\n        });\n        console.log('Firebase schema initialized');\n      } catch (err) {\n        console.error('Failed to initialize schema:', err);\n      }\n    }\n\n    // Initialize on load\n    if (compId) {\n      // Start connection monitor immediately (A3d)\n      initConnectionMonitor();\n\n      // Order: load config -> render teams -> initialize schema -> start listeners\n      loadCompetitionConfig().then(async (success) => {\n        if (!success) return;  // Exit early, don't initialize listeners\n\n        // Render team rows with initial state (before API data)\n        renderTeamRows();\n\n        // Update rotation tag for correct total (4 for women, 6 for men)\n        updateRotationTag();\n\n        // Initialize Firebase schema (safe defaults)\n        await initializeSchema();\n\n        // Start listening for Firebase changes (only after successful config load)\n        initFirebaseListeners();\n      });\n    }\n  </script>\n</body>\n</html>\n","numLines":1586,"startLine":1,"totalLines":1586}}}
