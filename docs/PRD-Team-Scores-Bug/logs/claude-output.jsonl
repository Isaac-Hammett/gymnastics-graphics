{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01Pn3LJ1LiRtHN4wmUqicBrn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01L6K3MWb8UH9cB6k4yHHWqA","name":"Write","input":{"file_path":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/components/ScoreBugPanel.jsx","content":"import { useState, useEffect } from 'react';\nimport { ref, onValue } from 'firebase/database';\nimport {\n  ChartBarIcon,\n  ChevronDownIcon,\n  ChevronUpIcon\n} from '@heroicons/react/24/solid';\n\n/**\n * ScoreBugPanel - Control panel for team scores bug overlay\n *\n * @param {Object} database - Firebase database instance\n * @param {string} compId - Competition ID\n * @param {boolean} collapsed - Initial collapsed state\n */\nexport default function ScoreBugPanel({\n  database,\n  compId,\n  collapsed: initialCollapsed = true\n}) {\n  const [collapsed, setCollapsed] = useState(initialCollapsed);\n  const [scoreBugState, setScoreBugState] = useState(null);\n\n  // Listen to scoreBug state from Firebase\n  useEffect(() => {\n    if (!database || !compId) return;\n\n    const scoreBugRef = ref(database, `competitions/${compId}/scoreBug`);\n    const unsubscribe = onValue(scoreBugRef, (snapshot) => {\n      setScoreBugState(snapshot.val() || {});\n    });\n\n    return () => unsubscribe();\n  }, [database, compId]);\n\n  // Empty state - no competition selected\n  if (!compId) {\n    return (\n      <div className=\"bg-zinc-800 rounded-xl p-4\">\n        <div className=\"flex items-center gap-2 text-zinc-400\">\n          <ChartBarIcon className=\"w-5 h-5\" />\n          <span className=\"font-medium\">Score Bug</span>\n        </div>\n        <div className=\"text-center py-4 text-zinc-500 text-sm\">\n          Select a competition\n        </div>\n      </div>\n    );\n  }\n\n  // Loading state\n  if (scoreBugState === null) {\n    return (\n      <div className=\"bg-zinc-800 rounded-xl p-4\">\n        <div className=\"flex items-center gap-2 text-zinc-400\">\n          <ChartBarIcon className=\"w-5 h-5\" />\n          <span className=\"font-medium\">Score Bug</span>\n        </div>\n        <div className=\"text-center py-4 text-zinc-500 text-sm\">\n          Loading...\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"bg-zinc-800 rounded-xl overflow-hidden\">\n      {/* Header */}\n      <button\n        onClick={() => setCollapsed(!collapsed)}\n        className=\"w-full flex items-center justify-between px-4 py-3 bg-zinc-800 hover:bg-zinc-700/50 transition-colors\"\n      >\n        <div className=\"flex items-center gap-2\">\n          <ChartBarIcon className=\"w-5 h-5 text-zinc-400\" />\n          <span className=\"font-medium text-white\">Score Bug</span>\n          {/* Status indicator */}\n          {scoreBugState.enabled && (\n            <span className=\"px-2 py-0.5 bg-green-500/20 text-green-400 text-xs rounded-full\">\n              ON\n            </span>\n          )}\n        </div>\n        {collapsed ? (\n          <ChevronDownIcon className=\"w-5 h-5 text-zinc-400\" />\n        ) : (\n          <ChevronUpIcon className=\"w-5 h-5 text-zinc-400\" />\n        )}\n      </button>\n\n      {!collapsed && (\n        <div className=\"p-4 pt-0 space-y-3\">\n          {/* Placeholder content - controls will be added in subsequent tasks */}\n          <div className=\"text-center py-4 text-zinc-500 text-sm\">\n            Score bug controls coming soon\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":251,"cache_read_input_tokens":32874,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":251},"output_tokens":1076,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"51c9167a-f458-4df8-b39c-0275bc5fd24d","uu