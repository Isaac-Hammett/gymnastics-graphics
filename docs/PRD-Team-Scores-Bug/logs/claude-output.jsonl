ueuing score flash:', {\n  1217→        team: teamIndex,\n  1218→        gymnast: gymnastData.name,\n  1219→        score: gymnastData.score,\n  1220→        queueLength: queue.length\n  1221→      });\n  1222→\n  1223→      // Add to queue\n  1224→      queue.push(gymnastData);\n  1225→\n  1226→      // If no active flash, start displaying\n  1227→      if (!state.activeFlashes[teamIndex]) {\n  1228→        displayNextFlash(teamIndex);\n  1229→      }\n  1230→    }\n  1231→\n  1232→    /**\n  1233→     * Display the next flash from the queue.\n  1234→     * Called when starting or advancing the queue.\n  1235→     * @param {number} teamIndex - 1-based team index\n  1236→     */\n  1237→    function displayNextFlash(teamIndex) {\n  1238→      const queue = state.flashQueues[teamIndex] || [];\n  1239→\n  1240→      if (queue.length === 0) {\n  1241→        // No more flashes - clear active state\n  1242→        state.activeFlashes[teamIndex] = null;\n  1243→        clearFlashDisplay(teamIndex);\n  1244→        return;\n  1245→      }\n  1246→\n  1247→      // Get next flash from queue\n  1248→      const gymnastData = queue.shift();\n  1249→\n  1250→      // Set as active\n  1251→      state.activeFlashes[teamIndex] = {\n  1252→        ...gymnastData,\n  1253→        startTime: Date.now(),\n  1254→        timer: setTimeout(() => {\n  1255→          advanceFlashQueue(teamIndex);\n  1256→        }, state.flashDuration)\n  1257→      };\n  1258→\n  1259→      // Render the flash\n  1260→      renderFlash(teamIndex, gymnastData);\n  1261→    }\n  1262→\n  1263→    /**\n  1264→     * Advance to next flash in queue (called when timer expires).\n  1265→     * @param {number} teamIndex - 1-based team index\n  1266→     */\n  1267→    function advanceFlashQueue(teamIndex) {\n  1268→      // Clear current flash timer\n  1269→      if (state.activeFlashes[teamIndex]?.timer) {\n  1270→        clearTimeout(state.activeFlashes[teamIndex].timer);\n  1271→      }\n  1272→\n  1273→  