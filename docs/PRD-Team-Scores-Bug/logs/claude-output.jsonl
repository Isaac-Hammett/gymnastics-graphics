ext-xs transition-colors ${\n                          currentGraphicId === `now-competing-${athlete.id}`\n                            ? 'bg-green-600 text-white'\n                            : 'bg-zinc-700 hover:bg-zinc-600 text-zinc-300'\n                        }`}\n                      >\n                        <div className=\"flex items-center justify-between\">\n                          <div>\n                            <span className=\"font-semibold\">{athlete.name}</span>\n                            <span className=\"text-zinc-400 ml-2\">({athlete.teamTricode || athlete.team})</span>\n                          </div>\n                          <span className=\"text-zinc-400\">{athlete.eventDisplay}</span>\n                        </div>\n                      </button>\n                    ))}\n                  </div>\n                ) : (\n                  <div className=\"text-xs text-zinc-500 text-center py-3 bg-zinc-700/50 rounded\">\n                    No athletes currently competing\n                  </div>\n                )\n              ) : (\n                <div className=\"text-xs text-zinc-500 text-center py-3 bg-zinc-700/50 rounded\">\n                  Enable polling in Score Bug panel\n                </div>\n              )}\n            </div>\n          )}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":1237,"cache_read_input_tokens":44723,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1237},"output_tokens":1380,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"5658113a-8744-4772-a894-2aa4e358d1ff","uuid":"41ce333b-3881-4a79-ab50-0c9d20cda57a"}
