{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017V41TnV6rYNnMVSzQg75Lx","type":"tool_result","content":"     1→import { useState, useEffect } from 'react';\n     2→import { db, ref, onValue, set } from '../lib/firebase';\n     3→import {\n     4→  ChartBarIcon,\n     5→  ChevronDownIcon,\n     6→  ChevronUpIcon,\n     7→  ClipboardIcon,\n     8→  CheckIcon\n     9→} from '@heroicons/react/24/solid';\n    10→\n    11→/**\n    12→ * ScoreBugPanel - Control panel for team scores bug overlay\n    13→ *\n    14→ * @param {string} compId - Competition ID\n    15→ * @param {boolean} collapsed - Initial collapsed state\n    16→ */\n    17→export default function ScoreBugPanel({\n    18→  compId,\n    19→  collapsed: initialCollapsed = true\n    20→}) {\n    21→  const [collapsed, setCollapsed] = useState(initialCollapsed);\n    22→  const [scoreBugState, setScoreBugState] = useState(null);\n    23→  const [copiedUrl, setCopiedUrl] = useState(false);\n    24→\n    25→  // Generate overlay URL\n    26→  const overlayUrl = compId\n    27→    ? `${window.location.origin}/overlays/team-bug.html?compId=${compId}`\n    28→    : '';\n    29→\n    30→  // Copy URL to clipboard\n    31→  const copyUrl = () => {\n    32→    navigator.clipboard.writeText(overlayUrl);\n    33→    setCopiedUrl(true);\n    34→    setTimeout(() => setCopiedUrl(false), 2000);\n    35→  };\n    36→\n    37→  // Toggle enabled state\n    38→  const toggleEnabled = () => {\n    39→    const newState = !scoreBugState?.enabled;\n    40→    set(ref(db, `competitions/${compId}/scoreBug/enabled`), newState);\n    41→  };\n    42→\n    43→  // Toggle polling state\n    44→  const togglePolling = () => {\n    45→    const newState = !scoreBugState?.polling;\n    46→    set(ref(db, `competitions/${compId}/scoreBug/polling`), newState);\n    47→  };\n    48→\n    49→  // Set poll frequency\n    50→  const setPollFrequency = (frequency) => {\n    51→    set(ref(db, `competitions/${compId}/scor