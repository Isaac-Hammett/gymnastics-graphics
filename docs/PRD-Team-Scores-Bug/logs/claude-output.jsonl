{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DZ4xysS6LRHFwW2dF44GNV","type":"tool_result","content":"     1→<!DOCTYPE html>\n     2→<html lang=\"en\">\n     3→<head>\n     4→  <meta charset=\"UTF-8\">\n     5→  <meta name=\"viewport\" content=\"width=1920, height=1080\">\n     6→  <title>Team Score Bug</title>\n     7→  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n     8→\n     9→  <!-- Firebase SDK -->\n    10→  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js\"></script>\n    11→  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js\"></script>\n    12→\n    13→  <style>\n    14→    * { margin: 0; padding: 0; box-sizing: border-box; }\n    15→\n    16→    body {\n    17→      font-family: 'Inter', sans-serif;\n    18→      width: 1920px;\n    19→      height: 1080px;\n    20→      overflow: hidden;\n    21→      background: transparent;\n    22→    }\n    23→\n    24→    /* Score bug container - positioned on right side of screen */\n    25→    .score-bug {\n    26→      position: absolute;\n    27→      top: 50%;\n    28→      right: 0;\n    29→      transform: translateY(-50%) translateX(100%);\n    30→      display: flex;\n    31→      flex-direction: column;\n    32→      min-width: 500px;\n    33→      opacity: 0;\n    34→      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n    35→    }\n    36→\n    37→    .score-bug.visible {\n    38→      transform: translateY(-50%) translateX(0);\n    39→      opacity: 1;\n    40→    }\n    41→\n    42→    /* Rotation tag at top */\n    43→    .rotation-tag {\n    44→      background: #27272a;\n    45→      color: #fff;\n    46→      font-size: 20px;\n    47→      font-weight: 700;\n    48→      padding: 10px 20px;\n    49→      text-transform: uppercase;\n    50→      letter-spacing: 0.5px;\n    51→    }\n    52→\n    53→    /* Team rows container */\n    54→    .team-rows {\n    55→      display: flex;\n    56→      flex-direction: column;\n    57→    }\n    58→\n    59→    /* Individual team row */\n    60→    .team-row {\n    61→      display: flex;\n    62→      flex-direction: row;\n    63→      background: #1a1a1a;\n    64→      border-bottom: 1px solid #333;\n    65→      min-height: 70px;\n    66→    }\n    67→\n    68→    .team-row:last-child {\n    69→      border-bottom: none;\n    70→    }\n    71→\n    72→    /* Fixed left section: logo + total */\n    73→    .team-fixed {\n    74→      display: flex;\n    75→      flex-direction: column;\n    76→      align-items: center;\n    77→      justify-content: center;\n    78→      padding: 10px 15px;\n    79→      min-width: 100px;\n    80→      background: #000;\n    81→    }\n    82→\n    83→    .team-logo {\n    84→      width: 40px;\n    85→      height: 40px;\n    86→      object-fit: contain;\n    87→    }\n    88→\n    89→    .team-total {\n    90→      font-size: 22px;\n    91→      font-weight: 900;\n    92→      color: #fff;\n    93→      margin-top: 4px;\n    94→    }\n    95→\n    96→    .team-total.highlight {\n    97→      animation: totalPulse 0.5s ease;\n    98→    }\n    99→\n   100→    @keyframes totalPulse {\n   101→      0%, 100% { transform: scale(1); color: #fff; }\n   102→      50% { transform: scale(1.1); color: #22d3ee; }\n   103→    }\n   104→\n   105→    /* Slot area for score flash / now competing */\n   106→    .team-slot {\n   107→      flex: 1;\n   108→      display: flex;\n   109→      align-items: center;\n   110→      padding: 10px 20px;\n   111→      overflow: hidden;\n   112→      position: relative;\n   113→    }\n   114→\n   115→    /* Slot content (animates up/down) */\n   116→    .slot-content {\n   117→      display: flex;\n   118→      align-items: center;\n   119→      gap: 12px;\n   120→      transform: translateY(0);\n   121→      transition: transform 0.4s ease, opacity 0.4s ease;\n   122→      opacity: 0;\n   123→    }\n   124→\n   125→    .slot-content.visible {\n   126→      opacity: 1;\n   127→    }\n   128→\n   129→    .slot-content.exit-up {\n   130→      transform: translateY(-100%);\n   131→      opacity: 0;\n   132→    }\n   133→\n   134→    .slot-content.enter-from-below {\n   135→      transform: translateY(100%);\n   136→      opacity: 0;\n   137→    }\n   138→\n   139→    /* Slot machine animation - new content spins up from below */\n   140→    @keyframes slotSpinIn {\n   141→      0% {\n   142→        transform: translateY(100%);\n   143→        opacity: 0;\n   144→      }\n   145→      20% {\n   146→        opacity: 1;\n   147→      }\n   148→      100% {\n   149→        transform: translateY(0);\n   150→        opacity: 1;\n   151→      }\n   152→    }\n   153→\n   154→    /* Slot machine animation - old content spins up and out */\n   155→    @keyframes slotSpinOut {\n   156→      0% {\n   157→        transform: translateY(0);\n   158→        opacity: 1;\n   159→      }\n   160→      80% {\n   161→        opacity: 0;\n   162→      }\n   163→      100% {\n   164→        transform: translateY(-100%);\n   165→        opacity: 0;\n   166→      }\n   167→    }\n   168→\n   169→    .slot-content.spin-in {\n   170→      animation: slotSpinIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n   171→    }\n   172→\n   173→    .slot-content.spin-out {\n   174→      animation: slotSpinOut 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n   175→    }\n   176→\n   177→    /* Headshot in slot */\n   178→    .slot-headshot {\n   179→      width: 36px;\n   180→      height: 36px;\n   181→      border-radius: 50%;\n   182→      object-fit: cover;\n   183→      flex-shrink: 0;\n   184→    }\n   185→\n   186→    /* Athlete name in slot */\n   187→    .slot-name {\n   188→      font-size: 24px;\n   189→      font-weight: 700;\n   190→      color: #fff;\n   191→      white-space: nowrap;\n   192→    }\n   193→\n   194→    /* Score in slot */\n   195→    .slot-score {\n   196→      font-size: 28px;\n   197→      font-weight: 900;\n   198→      color: #fff;\n   199→    }\n   200→\n   201→    /* Apparatus code */\n   202→    .slot-apparatus {\n   203→      font-size: 18px;\n   204→      font-weight: 600;\n   205→      color: #a1a1aa;\n   206→      text-transform: uppercase;\n   207→    }\n   208→\n   209→    /* Start value */\n   210→    .slot-sv {\n   211→      font-size: 16px;\n   212→      font-weight: 400;\n   213→      color: #71717a;\n   214→    }\n   215→\n   216→    /* Stick indicator */\n   217→    .slot-stick {\n   218→      width: 24px;\n   219→      height: 24px;\n   220→      border-radius: 50%;\n   221→      background: #22c55e;\n   222→      color: #fff;\n   223→      font-size: 14px;\n   224→      font-weight: 700;\n   225→      display: flex;\n   226→      align-items: center;\n   227→      justify-content: center;\n   228→    }\n   229→\n   230→    /* Separator dot */\n   231→    .slot-separator {\n   232→      color: #52525b;\n   233→      font-size: 20px;\n   234→    }\n   235→\n   236→    /* Correction indicator (score was changed) */\n   237→    .slot-correction {\n   238→      font-size: 14px;\n   239→      font-weight: 500;\n   240→      color: #f59e0b;\n   241→      font-style: italic;\n   242→    }\n   243→\n   244→    /* Lineup card (above bug) */\n   245→    .lineup-card {\n   246→      position: absolute;\n   247→      bottom: 100%;\n   248→      right: 0;\n   249→      width: 100%;\n   250→      background: #1a1a1a;\n   251→      transform: translateY(100%);\n   252→      opacity: 0;\n   253→      transition: transform 0.4s ease, opacity 0.4s ease;\n   254→      margin-bottom: 8px;\n   255→    }\n   256→\n   257→    .lineup-card.visible {\n   258→      transform: translateY(0);\n   259→      opacity: 1;\n   260→    }\n   261→\n   262→    .lineup-header {\n   263→      display: flex;\n   264→      justify-content: space-between;\n   265→      align-items: center;\n   266→      padding: 12px 20px;\n   267→      background: #27272a;\n   268→    }\n   269→\n   270→    .lineup-team-name {\n   271→      font-size: 22px;\n   272→      font-weight: 800;\n   273→      color: #fff;\n   274→      text-transform: uppercase;\n   275→    }\n   276→\n   277→    .lineup-logo {\n   278→      width: 32px;\n   279→      height: 32px;\n   280→      object-fit: contain;\n   281→    }\n   282→\n   283→    .lineup-athletes {\n   284→      padding: 8px 0;\n   285→    }\n   286→\n   287→    .lineup-athlete {\n   288→      display: flex;\n   289→      align-items: center;\n   290→      padding: 8px 20px;\n   291→      gap: 12px;\n   292→    }\n   293→\n   294→    .lineup-order {\n   295→      font-size: 16px;\n   296→      font-weight: 600;\n   297→      color: #71717a;\n   298→      min-width: 24px;\n   299→    }\n   300→\n   301→    .lineup-name {\n   302→      flex: 1;\n   303→      font-size: 20px;\n   304→      font-weight: 600;\n   305→      color: #fff;\n   306→    }\n   307→\n   308→    .lineup-sv {\n   309→      font-size: 16px;\n   310→      font-weight: 400;\n   311→      color: #71717a;\n   312→      min-width: 40px;\n   313→      text-align: right;\n   314→    }\n   315→\n   316→    .lineup-score {\n   317→      font-size: 22px;\n   318→      font-weight: 700;\n   319→      color: #fff;\n   320→      min-width: 70px;\n   321→      text-align: right;\n   322→    }\n   323→\n   324→    .lineup-score.pending {\n   325→      color: #52525b;\n   326→    }\n   327→\n   328→    .lineup-footer {\n   329→      display: flex;\n   330→      justify-content: space-between;\n   331→      align-items: center;\n   332→      padding: 12px 20px;\n   333→      background: #27272a;\n   334→    }\n   335→\n   336→    .lineup-event {\n   337→      font-size: 18px;\n   338→      font-weight: 600;\n   339→      color: #a1a1aa;\n   340→      text-transform: uppercase;\n   341→    }\n   342→\n   343→    .lineup-total {\n   344→      font-size: 26px;\n   345→      font-weight: 800;\n   346→      color: #fff;\n   347→    }\n   348→\n   349→    /* Loading / error states */\n   350→    .loading-state {\n   351→      color: #71717a;\n   352→      font-size: 18px;\n   353→      padding: 20px;\n   354→      text-align: center;\n   355→    }\n   356→\n   357→    .error-state {\n   358→      color: #ef4444;\n   359→      font-size: 18px;\n   360→      padding: 20px;\n   361→      text-align: center;\n   362→    }\n   363→  </style>\n   364→</head>\n   365→<body>\n   366→  <div class=\"score-bug\" id=\"scoreBug\">\n   367→    <div class=\"lineup-card\" id=\"lineupCard\">\n   368→      <!-- Lineup card content populated dynamically -->\n   369→    </div>\n   370→    <div class=\"rotation-tag\" id=\"rotationTag\">Rotation 1 of 6</div>\n   371→    <div class=\"team-rows\" id=\"teamRows\">\n   372→      <!-- Team rows populated dynamically -->\n   373→    </div>\n   374→  </div>\n   375→\n   376→  <script>\n   377→    // Firebase configuration\n   378→    const firebaseConfig = {\n   379→      apiKey: \"AIzaSyCh0aZUvKl6Qvqsva3hvOgJJlleP1OwcTY\",\n   380→      authDomain: \"gymnastics-graphics.firebaseapp.com\",\n   381→      databaseURL: \"https://gymnastics-graphics-default-rtdb.firebaseio.com\",\n   382→      projectId: \"gymnastics-graphics\",\n   383→      storageBucket: \"gymnastics-graphics.firebasestorage.app\",\n   384→      messagingSenderId: \"702072609550\",\n   385→      appId: \"1:702072609550:web:ac74a811186d3ff45b955f\"\n   386→    };\n   387→\n   388→    // Initialize Firebase\n   389→    firebase.initializeApp(firebaseConfig);\n   390→    const db = firebase.database();\n   391→\n   392→    // Parse URL parameters\n   393→    const params = new URLSearchParams(window.location.search);\n   394→    const compId = params.get('compId');\n   395→\n   396→    if (!compId) {\n   397→      console.error('Missing compId parameter');\n   398→      document.body.innerHTML = '<div class=\"error-state\">Missing compId parameter</div>';\n   399→    }\n   400→\n   401→    // State management\n   402→    const state = {\n   403→      enabled: false,\n   404→      polling: false,\n   405→      automationMode: 'auto',\n   406→      showLineup: null,\n   407→      teams: [],\n   408→      rotation: { current: 1, total: 6, isFinal: false },\n   409→      previousScores: {},        // { \"gymnast_id\": \"finalScore\" (string) }\n   410→      previousTeamTotals: {},    // { \"teamKey\": \"finalScore\" (string) }\n   411→      flashQueues: {},           // Per-team flash queues\n   412→      activeFlashes: {},         // Currently active flashes per team\n   413→      pollInterval: 5000,\n   414→      flashDuration: 10000,\n   415→      stalePollCount: 0,         // Consecutive polls with no data changes\n   416→      // Competition config (loaded from Firebase)\n   417→      competitionConfig: null,\n   418→      virtiusSessionId: null,\n   419→      gender: 'mens',\n   420→      // Error handling state (A3c)\n   421→      consecutiveErrors: 0,      // Count of consecutive poll failures\n   422→      lastError: null,           // Last error message\n   423→      lastErrorTime: null,       // Timestamp of last error\n   424→      maxBackoffMs: 60000,       // Max backoff delay (60 seconds)\n   425→      // Offline/reconnect state (A3d)\n   426→      firebaseConnected: true,   // Firebase connection state\n   427→      pendingWrites: [],         // Writes queued during offline\n   428→      reconnectAttempts: 0       // Count of reconnect attempts\n   429→    };\n   430→\n   431→    /**\n   432→     * Normalize athlete name for lookup (lowercase, remove special chars).\n   433→     * Matches pattern used in output.html for headshot lookups.\n   434→     */\n   435→    function normalizeName(name) {\n   436→      if (!name) return '';\n   437→      return name.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');\n   438→    }\n   439→\n   440→    // Firebase paths\n   441→    const scoreBugRef = db.ref(`competitions/${compId}/scoreBug`);\n   442→    const configRef = db.ref(`competitions/${compId}/config`);\n   443→    const connectedRef = db.ref('.info/connected');\n   444→\n   445→    /**\n   446→     * Initialize Firebase connection monitoring (A3d).\n   447→     * Detects offline/online state and handles reconnection.\n   448→     */\n   449→    function initConnectionMonitor() {\n   450→      connectedRef.on('value', (snapshot) => {\n   451→        const connected = snapshot.val() === true;\n   452→        const wasConnected = state.firebaseConnected;\n   453→        state.firebaseConnected = connected;\n   454→\n   455→        if (connected && !wasConnected) {\n   456→          // Just reconnected\n   457→          console.log('Firebase connected - processing pending writes');\n   458→          state.reconnectAttempts = 0;\n   459→          processPendingWrites();\n   460→\n   461→          // Write reconnect event to Firebase\n   462→          scoreBugRef.child('connectionStatus').set({\n   463→            connected: true,\n   464→            reconnectedAt: Date.now(),\n   465→            pendingWritesProcessed: state.pendingWrites.length\n   466→          });\n   467→        } else if (!connected && wasConnected) {\n   468→          // Just went offline\n   469→          console.warn('Firebase disconnected - writes will be queued');\n   470→          state.reconnectAttempts++;\n   471→\n   472→          // Note: Firebase SDK has offline persistence by default\n   473→          // Writes are automatically queued and synced on reconnect\n   474→        }\n   475→\n   476→        console.log('Firebase connection state:', connected ? 'ONLINE' : 'OFFLINE');\n   477→      });\n   478→    }\n   479→\n   480→    /**\n   481→     * Process any pending writes that were queued during offline.\n   482→     * Firebase SDK handles this automatically, but we log for visibility.\n   483→     */\n   484→    function processPendingWrites() {\n   485→      if (state.pendingWrites.length === 0) return;\n   486→\n   487→      console.log('Processing', state.pendingWrites.length, 'pending writes');\n   488→\n   489→      // Firebase SDK automatically syncs queued writes\n   490→      // Clear our tracking array\n   491→      state.pendingWrites = [];\n   492→    }\n   493→\n   494→    /**\n   495→     * Safe write to Firebase with offline queueing (A3d).\n   496→     * Wraps Firebase write operations to track pending writes during offline.\n   497→     * @param {firebase.database.Reference} ref - Firebase reference\n   498→     * @param {string} method - 'set', 'update', or 'remove'\n   499→     * @param {*} data - Data to write (for set/update)\n   500→     * @returns {Promise}\n   501→     */\n   502→    async function safeWrite(ref, method, data) {\n   503→      const writeOp = { path: ref.toString(), method, data, timestamp: Date.now() };\n   504→\n   505→      if (!state.firebaseConnected) {\n   506→        // Queue the write for tracking (Firebase SDK queues automatically)\n   507→        state.pendingWrites.push(writeOp);\n   508→        console.log('Queued offline write:', writeOp.path, method);\n   509→      }\n   510→\n   511→      try {\n   512→        if (method === 'set') {\n   513→          await ref.set(data);\n   514→        } else if (method === 'update') {\n   515→          await ref.update(data);\n   516→        } else if (method === 'remove') {\n   517→          await ref.remove();\n   518→        }\n   519→        return true;\n   520→      } catch (err) {\n   521→        // Firebase SDK will retry on reconnect\n   522→        console.error('Write failed (will retry on reconnect):', err.message);\n   523→        if (!state.pendingWrites.includes(writeOp)) {\n   524→          state.pendingWrites.push(writeOp);\n   525→        }\n   526→        return false;\n   527→      }\n   528→    }\n   529→\n   530→    /**\n   531→     * Load competition config from Firebase.\n   532→     * Gets virtiusSessionId, team names/logos, gender, and compType.\n   533→     * Must be called before initializing Firebase listeners.\n   534→     */\n   535→    async function loadCompetitionConfig() {\n   536→      try {\n   537→        const snapshot = await configRef.once('value');\n   538→        const config = snapshot.val();\n   539→\n   540→        if (!config) {\n   541→          console.error('No competition config found for compId:', compId);\n   542→          document.body.innerHTML = '<div class=\"error-state\">Competition not found</div>';\n   543→          return false;\n   544→        }\n   545→\n   546→        state.competitionConfig = config;\n   547→        state.virtiusSessionId = config.virtiusSessionId || null;\n   548→        state.gender = config.gender || 'mens';\n   549→\n   550→        // Build teams array from config (up to 6 teams)\n   551→        state.teams = [];\n   552→        for (let i = 1; i <= 6; i++) {\n   553→          const teamName = config[`team${i}Name`];\n   554→          if (teamName) {\n   555→            state.teams.push({\n   556→              index: i,\n   557→              name: teamName,\n   558→              logo: config[`team${i}Logo`] || '',\n   559→              tricode: config[`team${i}Tricode`] || '',\n   560→              total: '--'  // Initial state before first API poll\n   561→            });\n   562→          }\n   563→        }\n   564→\n   565→        // Determine total rotations based on gender (6 for men, 4 for women)\n   566→        state.rotation.total = state.gender === 'womens' ? 4 : 6;\n   567→\n   568→        console.log('Competition config loaded:', {\n   569→          compId,\n   570→          virtiusSessionId: state.virtiusSessionId,\n   571→          gender: state.gender,\n   572→          teamCount: state.teams.length,\n   573→          teams: state.teams.map(t => t.name)\n   574→        });\n   575→\n   576→        // Check if Virtius session ID is configured\n   577→        if (!state.virtiusSessionId) {\n   578→          console.warn('No Virtius session ID configured - API polling will not work');\n   579→        }\n   580→\n   581→        return true;\n   582→      } catch (err) {\n   583→        console.error('Failed to load competition config:', err);\n   584→        document.body.innerHTML = '<div class=\"error-state\">Failed to load competition config</div>';\n   585→        return false;\n   586→      }\n   587→    }\n   588→\n   589→    /**\n   590→     * Render initial team rows based on competition config.\n   591→     * Called after loadCompetitionConfig() to show teams before API polling starts.\n   592→     */\n   593→    function renderTeamRows() {\n   594→      const container = document.getElementById('teamRows');\n   595→      if (!container) return;\n   596→\n   597→      container.innerHTML = state.teams.map((team, idx) => `\n   598→        <div class=\"team-row\" data-team-index=\"${team.index}\">\n   599→          <div class=\"team-fixed\">\n   600→            <img class=\"team-logo\" src=\"${team.logo}\" alt=\"${team.name}\" onerror=\"this.style.display='none'\">\n   601→            <div class=\"team-total\" id=\"teamTotal${team.index}\">${team.total}</div>\n   602→          </div>\n   603→          <div class=\"team-slot\" id=\"teamSlot${team.index}\">\n   604→            <div class=\"slot-content\" id=\"slotContent${team.index}\">\n   605→              <!-- Score flash / now competing content populated dynamically -->\n   606→            </div>\n   607→          </div>\n   608→        </div>\n   609→      `).join('');\n   610→\n   611→      console.log('Team rows rendered:', state.teams.length);\n   612→    }\n   613→\n   614→    /**\n   615→     * Update team total display element (A4).\n   616→     * Called when API polling detects a change in team.final_score.\n   617→     * Adds highlight animation on value change.\n   618→     * @param {number} teamIndex - 1-based team index\n   619→     * @param {string} newTotal - Formatted score string (e.g., \"196.450\")\n   620→     */\n   621→    function updateTeamTotal(teamIndex, newTotal) {\n   622→      const totalEl = document.getElementById(`teamTotal${teamIndex}`);\n   623→      if (!totalEl) return;\n   624→\n   625→      const prevTotal = totalEl.textContent;\n   626→\n   627→      // Only update if value changed\n   628→      if (prevTotal === newTotal) return;\n   629→\n   630→      totalEl.textContent = newTotal;\n   631→\n   632→      // Trigger highlight animation on change (skip for initial load)\n   633→      if (prevTotal !== '--') {\n   634→        totalEl.classList.remove('highlight');\n   635→        // Force reflow to restart animation\n   636→        void totalEl.offsetWidth;\n   637→        totalEl.classList.add('highlight');\n   638→      }\n   639→    }\n   640→\n   641→    /**\n   642→     * Update all team totals from state (A4).\n   643→     * Called after API poll updates state.teams[].total values.\n   644→     */\n   645→    function updateAllTeamTotals() {\n   646→      state.teams.forEach((team) => {\n   647→        updateTeamTotal(team.index, team.total);\n   648→      });\n   649→    }\n   650→\n   651→    // Initialize Firebase listeners\n   652→    function initFirebaseListeners() {\n   653→      // Listen for enabled state\n   654→      scoreBugRef.child('enabled').on('value', (snapshot) => {\n   655→        state.enabled = snapshot.val() === true;\n   656→        updateBugVisibility();\n   657→      });\n   658→\n   659→      // Listen for polling state\n   660→      scoreBugRef.child('polling').on('value', (snapshot) => {\n   661→        const wasPolling = state.polling;\n   662→        state.polling = snapshot.val() === true;\n   663→        if (state.polling && !wasPolling) {\n   664→          startPolling();\n   665→        } else if (!state.polling && wasPolling) {\n   666→          stopPolling();\n   667→        }\n   668→      });\n   669→\n   670→      // Listen for automation mode\n   671→      scoreBugRef.child('automationMode').on('value', (snapshot) => {\n   672→        state.automationMode = snapshot.val() || 'auto';\n   673→      });\n   674→\n   675→      // Listen for lineup card toggle\n   676→      scoreBugRef.child('showLineup').on('value', (snapshot) => {\n   677→        state.showLineup = snapshot.val();\n   678→        updateLineupCard();\n   679→      });\n   680→\n   681→      // Listen for flash dismissals\n   682→      scoreBugRef.child('dismissFlash').on('value', (snapshot) => {\n   683→        const dismissals = snapshot.val() || {};\n   684→        handleFlashDismissals(dismissals);\n   685→      });\n   686→\n   687→      // Listen for poll interval changes - restart polling with new interval\n   688→      scoreBugRef.child('config/pollInterval').on('value', (snapshot) => {\n   689→        const newInterval = snapshot.val() || 5000;\n   690→        const wasPolling = state.polling && pollTimer !== null;\n   691→        state.pollInterval = newInterval;\n   692→\n   693→        // Restart polling with new interval if currently polling\n   694→        if (wasPolling) {\n   695→          console.log('Poll interval changed to', newInterval, 'ms - restarting polling');\n   696→          stopPolling();\n   697→          startPolling();\n   698→        }\n   699→      });\n   700→\n   701→      // Listen for flash duration changes\n   702→      scoreBugRef.child('config/flashDuration').on('value', (snapshot) => {\n   703→        state.flashDuration = snapshot.val() || 10000;\n   704→      });\n   705→\n   706→      console.log('Firebase listeners initialized');\n   707→    }\n   708→\n   709→    // Update bug visibility based on enabled state\n   710→    function updateBugVisibility() {\n   711→      const bugEl = document.getElementById('scoreBug');\n   712→      if (state.enabled) {\n   713→        bugEl.classList.add('visible');\n   714→      } else {\n   715→        bugEl.classList.remove('visible');\n   716→      }\n   717→    }\n   718→\n   719→    // Update lineup card visibility\n   720→    function updateLineupCard() {\n   721→      const cardEl = document.getElementById('lineupCard');\n   722→      if (state.showLineup) {\n   723→        cardEl.classList.add('visible');\n   724→        // TODO: Populate lineup card content (Phase C)\n   725→      } else {\n   726→        cardEl.classList.remove('visible');\n   727→      }\n   728→    }\n   729→\n   730→    // Handle flash dismissals from producer\n   731→    function handleFlashDismissals(dismissals) {\n   732→      // TODO: Implement flash dismissal handling (Task A12c)\n   733→    }\n   734→\n   735→    // Polling management\n   736→    let pollTimer = null;\n   737→\n   738→    function startPolling() {\n   739→      if (pollTimer) return;\n   740→      console.log('Starting API polling');\n   741→      poll();  // Initial poll\n   742→      pollTimer = setInterval(poll, state.pollInterval);\n   743→    }\n   744→\n   745→    function stopPolling() {\n   746→      if (pollTimer) {\n   747→        clearInterval(pollTimer);\n   748→        pollTimer = null;\n   749→        console.log('Stopped API polling');\n   750→      }\n   751→    }\n   752→\n   753→    // Main poll function - fetches data from Virtius API\n   754→    async function poll() {\n   755→      // Check if we have a valid session ID\n   756→      if (!state.virtiusSessionId) {\n   757→        console.warn('No Virtius session ID - skipping poll');\n   758→        return;\n   759→      }\n   760→\n   761→      const pollStartTime = Date.now();\n   762→\n   763→      try {\n   764→        // Fetch from Virtius API\n   765→        const response = await fetch(`https://api.virti.us/session/${state.virtiusSessionId}/json`);\n   766→\n   767→        if (!response.ok) {\n   768→          throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   769→        }\n   770→\n   771→        const data = await response.json();\n   772→\n   773→        // Store raw API data for score diff engine (Task A5)\n   774→        // Extract teams array from meet data\n   775→        const teams = data.meet?.teams || [];\n   776→\n   777→        if (teams.length === 0) {\n   778→          console.warn('No teams found in API response');\n   779→        }\n   780→\n   781→        // Store the latest API data in state\n   782→        state.lastApiData = data;\n   783→        state.lastApiTeams = teams;\n   784→\n   785→        // Extract team totals and update state.teams with actual data\n   786→        // final_score comes as a string from API - convert to float for display\n   787→        teams.forEach((apiTeam, idx) => {\n   788→          // Match API team to our configured teams by index or name\n   789→          const stateTeam = state.teams[idx];\n   790→          if (stateTeam) {\n   791→            // Convert string final_score to formatted number\n   792→            const rawScore = apiTeam.final_score;\n   793→            if (rawScore !== null && rawScore !== undefined) {\n   794→              const numScore = parseFloat(rawScore);\n   795→              stateTeam.total = isNaN(numScore) ? '--' : numScore.toFixed(3);\n   796→            }\n   797→            // Store API team reference for score diff engine\n   798→            stateTeam.apiTeam = apiTeam;\n   799→          }\n   800→        });\n   801→\n   802→        // Write heartbeat to Firebase on successful poll (using safeWrite for offline resilience)\n   803→        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n   804→\n   805→        console.log('Poll successful:', {\n   806→          sessionId: state.virtiusSessionId,\n   807→          teamCount: teams.length,\n   808→          teams: state.teams.map(t => ({ name: t.name, total: t.total }))\n   809→        });\n   810→\n   811→        // Process API data - detect changes and write deltas to Firebase\n   812→        await processApiData(teams, pollStartTime);\n   813→\n   814→        // Update team total displays (A4)\n   815→        updateAllTeamTotals();\n   816→\n   817→      } catch (err) {\n   818→        // Error handling with exponential backoff (A3c)\n   819→        state.consecutiveErrors++;\n   820→        state.lastError = err.message;\n   821→        state.lastErrorTime = pollStartTime;\n   822→\n   823→        // Calculate backoff delay: 5s, 10s, 20s, 40s, 60s (max)\n   824→        const backoffDelay = Math.min(\n   825→          state.pollInterval * Math.pow(2, state.consecutiveErrors - 1),\n   826→          state.maxBackoffMs\n   827→        );\n   828→\n   829→        console.error('Poll failed:', {\n   830→          error: err.message,\n   831→          consecutiveErrors: state.consecutiveErrors,\n   832→          nextRetryIn: `${backoffDelay / 1000}s`\n   833→        });\n   834→\n   835→        // Write error state to Firebase for producer panel visibility (D5b)\n   836→        // Using safeWrite for offline resilience\n   837→        await safeWrite(scoreBugRef.child('apiError'), 'set', {\n   838→          message: err.message,\n   839→          consecutiveErrors: state.consecutiveErrors,\n   840→          timestamp: pollStartTime,\n   841→          nextRetryMs: backoffDelay\n   842→        });\n   843→        // Still write heartbeat to indicate overlay is running\n   844→        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n   845→\n   846→        // Schedule next poll with backoff delay if we're still supposed to be polling\n   847→        if (state.polling && pollTimer) {\n   848→          clearInterval(pollTimer);\n   849→          pollTimer = setTimeout(() => {\n   850→            if (state.polling) {\n   851→              poll();\n   852→              // If poll succeeds, startPolling() will be called to restore normal interval\n   853→            }\n   854→          }, backoffDelay);\n   855→        }\n   856→        return; // Skip normal completion\n   857→      }\n   858→\n   859→      // Success - reset error state\n   860→      if (state.consecutiveErrors > 0) {\n   861→        console.log('Poll recovered after', state.consecutiveErrors, 'consecutive errors');\n   862→        state.consecutiveErrors = 0;\n   863→        state.lastError = null;\n   864→        state.lastErrorTime = null;\n   865→\n   866→        // Clear error state in Firebase\n   867→        await safeWrite(scoreBugRef.child('apiError'), 'remove');\n   868→\n   869→        // Restore normal polling interval (we might be on backoff timeout)\n   870→        if (state.polling && pollTimer) {\n   871→          clearTimeout(pollTimer);\n   872→          clearInterval(pollTimer);\n   873→          pollTimer = setInterval(poll, state.pollInterval);\n   874→        }\n   875→      }\n   876→    }\n   877→\n   878→    /**\n   879→     * Process API data - detect score changes and write incremental deltas to Firebase.\n   880→     * Only writes changed paths, not full data rewrite.\n   881→     * @param {Array} apiTeams - Teams array from Virtius API\n   882→     * @param {number} pollTimestamp - Timestamp of this poll\n   883→     */\n   884→    async function processApiData(apiTeams, pollTimestamp) {\n   885→      const changedPaths = {};\n   886→      let hasChanges = false;\n   887→\n   888→      // Process each team\n   889→      apiTeams.forEach((team, teamIdx) => {\n   890→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n   891→\n   892→        // Check if team total changed\n   893→        const prevTeamTotal = state.previousTeamTotals[teamKey];\n   894→        const currTeamTotal = team.final_score;  // string or null\n   895→\n   896→        if (currTeamTotal !== prevTeamTotal) {\n   897→          changedPaths[`teams/${teamKey}/finalScore`] = currTeamTotal;\n   898→          changedPaths[`teams/${teamKey}/name`] = team.name || teamKey;\n   899→          hasChanges = true;\n   900→        }\n   901→\n   902→        // Process each event's gymnasts for score changes\n   903→        const events = team.events || [];\n   904→        events.forEach((event) => {\n   905→          const eventKey = event.short_name || event.name || 'unknown';\n   906→          const gymnasts = event.gymnasts || [];\n   907→\n   908→          gymnasts.forEach((gymnast) => {\n   909→            // Primary key: gymnast_id. Fallback: teamKey|normalizedName\n   910→            const gymnastKey = gymnast.gymnast_id ||\n   911→              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n   912→\n   913→            const prevScore = state.previousScores[gymnastKey];\n   914→            const currScore = gymnast.final_score;  // string or null\n   915→\n   916→            // Score changed (new score OR corrected score)\n   917→            if (currScore != null && prevScore !== currScore) {\n   918→              // Build gymnast data for Firebase and flash queue\n   919→              const gymnastData = {\n   920→                name: gymnast.full_name,\n   921→                score: currScore,\n   922→                startValue: gymnast.start_value || null,\n   923→                execution: gymnast.execution || null,\n   924→                difficulty: gymnast.difficulty || null,\n   925→                order: gymnast.order,\n   926→                event: eventKey,\n   927→                team: teamKey,\n   928→                gymnastKey: gymnastKey,\n   929→                timestamp: pollTimestamp,\n   930→                isCorrection: prevScore != null  // True if score was changed (not new)\n   931→              };\n   932→\n   933→              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}`] = gymnastData;\n   934→              hasChanges = true;\n   935→\n   936→              console.log('Score change detected:', {\n   937→                gymnast: gymnast.full_name,\n   938→                event: eventKey,\n   939→                team: teamKey,\n   940→                prev: prevScore,\n   941→                curr: currScore,\n   942→                isCorrection: prevScore != null\n   943→              });\n   944→\n   945→              // Trigger flash for this score change (A5)\n   946→              const teamIndex = teamIdx + 1;  // Convert 0-based to 1-based index\n   947→              if (isFlashActive(teamIndex, gymnastKey)) {\n   948→                // Correction during active flash - interrupt and replace\n   949→                interruptFlash(teamIndex, gymnastData);\n   950→              } else {\n   951→                // Queue new flash for this team\n   952→                triggerScoreFlash(teamIndex, gymnastData);\n   953→              }\n   954→            }\n   955→\n   956→            // Score removed (rare - inquiry pending)\n   957→            if (currScore == null && prevScore != null) {\n   958→              changedPaths[`teams/${teamKey}/events/${eventKey}/gymnasts/${gymnastKey}/score`] = null;\n   959→              hasChanges = true;\n   960→              console.log('Score removed:', { gymnast: gymnast.full_name, event: eventKey });\n   961→            }\n   962→          });\n   963→        });\n   964→      });\n   965→\n   966→      // Write to Firebase (using safeWrite for offline resilience)\n   967→      if (hasChanges) {\n   968→        // Write changed paths and reset stale counter\n   969→        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n   970→          ...changedPaths,\n   971→          lastDataChangeTimestamp: pollTimestamp,\n   972→          stalePollCount: 0\n   973→        });\n   974→        state.stalePollCount = 0;\n   975→\n   976→        console.log('Wrote incremental deltas to Firebase:', Object.keys(changedPaths).length, 'paths');\n   977→      } else {\n   978→        // No changes - increment stale counter\n   979→        state.stalePollCount++;\n   980→        await safeWrite(scoreBugRef.child('liveData'), 'update', {\n   981→          lastPollTimestamp: pollTimestamp,\n   982→          stalePollCount: state.stalePollCount\n   983→        });\n   984→      }\n   985→\n   986→      // Update previous state for next comparison\n   987→      state.previousScores = buildScoreMap(apiTeams);\n   988→      state.previousTeamTotals = buildTeamTotalMap(apiTeams);\n   989→\n   990→      // Detect and update rotation (A10)\n   991→      const newRotation = detectRotation(apiTeams);\n   992→      if (newRotation.current !== state.rotation.current ||\n   993→          newRotation.isFinal !== state.rotation.isFinal) {\n   994→        state.rotation = newRotation;\n   995→        updateRotationTag();\n   996→\n   997→        // Write rotation to Firebase for producer panel visibility\n   998→        await safeWrite(scoreBugRef.child('liveData/rotation'), 'set', newRotation.current);\n   999→        await safeWrite(scoreBugRef.child('liveData/totalRotations'), 'set', newRotation.total);\n  1000→        await safeWrite(scoreBugRef.child('liveData/isFinal'), 'set', newRotation.isFinal);\n  1001→\n  1002→        console.log('Rotation updated:', newRotation);\n  1003→      }\n  1004→    }\n  1005→\n  1006→    /**\n  1007→     * Build score map from API teams data.\n  1008→     * @returns {Object} Map of gymnastKey -> finalScore (string)\n  1009→     */\n  1010→    function buildScoreMap(apiTeams) {\n  1011→      const map = {};\n  1012→      apiTeams.forEach((team, teamIdx) => {\n  1013→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n  1014→        const events = team.events || [];\n  1015→\n  1016→        events.forEach((event) => {\n  1017→          const gymnasts = event.gymnasts || [];\n  1018→          gymnasts.forEach((gymnast) => {\n  1019→            const gymnastKey = gymnast.gymnast_id ||\n  1020→              `${teamKey}|${normalizeName(gymnast.full_name)}`;\n  1021→            map[gymnastKey] = gymnast.final_score;  // string or null\n  1022→          });\n  1023→        });\n  1024→      });\n  1025→      return map;\n  1026→    }\n  1027→\n  1028→    /**\n  1029→     * Build team total map from API teams data.\n  1030→     * @returns {Object} Map of teamKey -> finalScore (string)\n  1031→     */\n  1032→    function buildTeamTotalMap(apiTeams) {\n  1033→      const map = {};\n  1034→      apiTeams.forEach((team, teamIdx) => {\n  1035→        const teamKey = team.short_name || `team${teamIdx + 1}`;\n  1036→        map[teamKey] = team.final_score;  // string or null\n  1037→      });\n  1038→      return map;\n  1039→    }\n  1040→\n  1041→    // ============================================================\n  1042→    // SCORE DIFF ENGINE - Flash Queue Management (Task A5)\n  1043→    // ============================================================\n  1044→\n  1045→    /**\n  1046→     * Check if a flash is currently active for a given team and gymnast.\n  1047→     * Used to detect score corrections during active flash display.\n  1048→     * @param {number} teamIndex - 1-based team index\n  1049→     * @param {string} gymnastKey - Unique gymnast identifier\n  1050→     * @returns {boolean} True if flash is active for this gymnast\n  1051→     */\n  1052→    function isFlashActive(teamIndex, gymnastKey) {\n  1053→      const activeFlash = state.activeFlashes[teamIndex];\n  1054→      return activeFlash && activeFlash.gymnastKey === gymnastKey;\n  1055→    }\n  1056→\n  1057→    /**\n  1058→     * Interrupt current flash with a new one (score correction case).\n  1059→     * Immediately replaces the active flash and resets timer.\n  1060→     * @param {number} teamIndex - 1-based team index\n  1061→     * @param {Object} gymnastData - New score data to display\n  1062→     */\n  1063→    function interruptFlash(teamIndex, gymnastData) {\n  1064→      console.log('Interrupting active flash with correction:', {\n  1065→        team: teamIndex,\n  1066→        gymnast: gymnastData.name,\n  1067→        newScore: gymnastData.score\n  1068→      });\n  1069→\n  1070→      // Clear existing flash timer\n  1071→      if (state.activeFlashes[teamIndex]?.timer) {\n  1072→        clearTimeout(state.activeFlashes[teamIndex].timer);\n  1073→      }\n  1074→\n  1075→      // Replace with new flash data\n  1076→      state.activeFlashes[teamIndex] = {\n  1077→        ...gymnastData,\n  1078→        startTime: Date.now(),\n  1079→        timer: null\n  1080→      };\n  1081→\n  1082→      // Render the updated flash immediately\n  1083→      renderFlash(teamIndex, gymnastData);\n  1084→\n  1085→      // Set new timer\n  1086→      state.activeFlashes[teamIndex].timer = setTimeout(() => {\n  1087→        advanceFlashQueue(teamIndex);\n  1088→      }, state.flashDuration);\n  1089→    }\n  1090→\n  1091→    /**\n  1092→     * Queue a new score flash for a team.\n  1093→     * If no flash is active, displays immediately. Otherwise queued.\n  1094→     * @param {number} teamIndex - 1-based team index\n  1095→     * @param {Object} gymnastData - Score data to display\n  1096→     */\n  1097→    function triggerScoreFlash(teamIndex, gymnastData) {\n  1098→      // Initialize queue if needed\n  1099→      if (!state.flashQueues[teamIndex]) {\n  1100→        state.flashQueues[teamIndex] = [];\n  1101→      }\n  1102→\n  1103→      console.log('Queuing score flash:', {\n  1104→        team: teamIndex,\n  1105→        gymnast: gymnastData.name,\n  1106→        score: gymnastData.score,\n  1107→        queueLength: state.flashQueues[teamIndex].length\n  1108→      });\n  1109→\n  1110→      // Add to queue\n  1111→      state.flashQueues[teamIndex].push(gymnastData);\n  1112→\n  1113→      // If no active flash, start displaying\n  1114→      if (!state.activeFlashes[teamIndex]) {\n  1115→        displayNextFlash(teamIndex);\n  1116→      }\n  1117→    }\n  1118→\n  1119→    /**\n  1120→     * Display the next flash from the queue.\n  1121→     * Called when starting or advancing the queue.\n  1122→     * @param {number} teamIndex - 1-based team index\n  1123→     */\n  1124→    function displayNextFlash(teamIndex) {\n  1125→      const queue = state.flashQueues[teamIndex] || [];\n  1126→\n  1127→      if (queue.length === 0) {\n  1128→        // No more flashes - clear active state\n  1129→        state.activeFlashes[teamIndex] = null;\n  1130→        clearFlashDisplay(teamIndex);\n  1131→        return;\n  1132→      }\n  1133→\n  1134→      // Get next flash from queue\n  1135→      const gymnastData = queue.shift();\n  1136→\n  1137→      // Set as active\n  1138→      state.activeFlashes[teamIndex] = {\n  1139→        ...gymnastData,\n  1140→        startTime: Date.now(),\n  1141→        timer: setTimeout(() => {\n  1142→          advanceFlashQueue(teamIndex);\n  1143→        }, state.flashDuration)\n  1144→      };\n  1145→\n  1146→      // Render the flash\n  1147→      renderFlash(teamIndex, gymnastData);\n  1148→    }\n  1149→\n  1150→    /**\n  1151→     * Advance to next flash in queue (called when timer expires).\n  1152→     * @param {number} teamIndex - 1-based team index\n  1153→     */\n  1154→    function advanceFlashQueue(teamIndex) {\n  1155→      // Clear current flash timer\n  1156→      if (state.activeFlashes[teamIndex]?.timer) {\n  1157→        clearTimeout(state.activeFlashes[teamIndex].timer);\n  1158→      }\n  1159→\n  1160→      // Display next or clear\n  1161→      displayNextFlash(teamIndex);\n  1162→    }\n  1163→\n  1164→    /**\n  1165→     * Render a score flash in a team's slot area with slot machine animation.\n  1166→     * TODO: Task A7 will enhance rendering with headshots/apparatus.\n  1167→     * @param {number} teamIndex - 1-based team index\n  1168→     * @param {Object} gymnastData - Score data to render\n  1169→     */\n  1170→    function renderFlash(teamIndex, gymnastData) {\n  1171→      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n  1172→      if (!slotContent) return;\n  1173→\n  1174→      // Check if there's existing content to animate out\n  1175→      const hasExistingContent = slotContent.innerHTML.trim() !== '';\n  1176→\n  1177→      if (hasExistingContent) {\n  1178→        // Spin out existing content first\n  1179→        slotContent.classList.remove('spin-in', 'visible');\n  1180→        slotContent.classList.add('spin-out');\n  1181→\n  1182→        // After spin-out completes, insert new content and spin in\n  1183→        setTimeout(() => {\n  1184→          insertFlashContent(slotContent, gymnastData);\n  1185→          triggerSpinIn(slotContent);\n  1186→        }, 400);  // Match spin-out animation duration\n  1187→      } else {\n  1188→        // No existing content - insert and spin in directly\n  1189→        insertFlashContent(slotContent, gymnastData);\n  1190→        triggerSpinIn(slotContent);\n  1191→      }\n  1192→\n  1193→      console.log('Rendered flash:', {\n  1194→        team: teamIndex,\n  1195→        gymnast: gymnastData.name,\n  1196→        score: gymnastData.score,\n  1197→        animated: hasExistingContent ? 'spin-transition' : 'spin-in'\n  1198→      });\n  1199→    }\n  1200→\n  1201→    /**\n  1202→     * Insert flash content HTML into slot element (Task A7).\n  1203→     * Renders: apparatus | name | SV | separator | score | correction indicator\n  1204→     * @param {HTMLElement} slotContent - The slot content container\n  1205→     * @param {Object} gymnastData - Score data to render\n  1206→     */\n  1207→    function insertFlashContent(slotContent, gymnastData) {\n  1208→      // Format start value for display (e.g., \"5.0\" or \"5.2\")\n  1209→      const svDisplay = gymnastData.startValue\n  1210→        ? `<span class=\"slot-sv\">SV ${parseFloat(gymnastData.startValue).toFixed(1)}</span>`\n  1211→        : '';\n  1212→\n  1213→      // Format score for display (e.g., \"13.450\")\n  1214→      const scoreValue = parseFloat(gymnastData.score);\n  1215→      const scoreDisplay = isNaN(scoreValue) ? gymnastData.score : scoreValue.toFixed(3);\n  1216→\n  1217→      slotContent.innerHTML = `\n  1218→        <span class=\"slot-apparatus\">${gymnastData.event}</span>\n  1219→        <span class=\"slot-name\">${gymnastData.name}</span>\n  1220→        ${svDisplay}\n  1221→        <span class=\"slot-separator\">•</span>\n  1222→        <span class=\"slot-score\">${scoreDisplay}</span>\n  1223→        ${gymnastData.isCorrection ? '<span class=\"slot-correction\">(corrected)</span>' : ''}\n  1224→      `;\n  1225→    }\n  1226→\n  1227→    /**\n  1228→     * Trigger spin-in animation on slot content.\n  1229→     * @param {HTMLElement} slotContent - The slot content container\n  1230→     */\n  1231→    function triggerSpinIn(slotContent) {\n  1232→      // Reset animation state\n  1233→      slotContent.classList.remove('spin-out', 'exit-up', 'enter-from-below');\n  1234→\n  1235→      // Force reflow to ensure animation restarts\n  1236→      void slotContent.offsetWidth;\n  1237→\n  1238→      // Trigger spin-in animation\n  1239→      slotContent.classList.add('spin-in', 'visible');\n  1240→    }\n  1241→\n  1242→    /**\n  1243→     * Clear flash display for a team (return to idle state) with spin-out animation.\n  1244→     * @param {number} teamIndex - 1-based team index\n  1245→     */\n  1246→    function clearFlashDisplay(teamIndex) {\n  1247→      const slotContent = document.getElementById(`slotContent${teamIndex}`);\n  1248→      if (!slotContent) return;\n  1249→\n  1250→      // Only animate if there's content to clear\n  1251→      if (slotContent.innerHTML.trim() === '') return;\n  1252→\n  1253→      // Trigger spin-out animation\n  1254→      slotContent.classList.remove('spin-in', 'visible');\n  1255→      slotContent.classList.add('spin-out');\n  1256→\n  1257→      // Clear content after animation completes\n  1258→      setTimeout(() => {\n  1259→        if (!state.activeFlashes[teamIndex]) {\n  1260→          slotContent.innerHTML = '';\n  1261→          slotContent.classList.remove('spin-out');\n  1262→        }\n  1263→      }, 400);  // Match CSS animation duration\n  1264→    }\n  1265→\n  1266→    /**\n  1267→     * Get current flash queue status for debugging/producer panel.\n  1268→     * @returns {Object} Queue status by team\n  1269→     */\n  1270→    function getFlashQueueStatus() {\n  1271→      const status = {};\n  1272→      state.teams.forEach((team) => {\n  1273→        const queue = state.flashQueues[team.index] || [];\n  1274→        const active = state.activeFlashes[team.index];\n  1275→        status[team.index] = {\n  1276→          teamName: team.name,\n  1277→          queueLength: queue.length,\n  1278→          activeFlash: active ? {\n  1279→            gymnast: active.name,\n  1280→            score: active.score,\n  1281→            timeRemaining: active.startTime ?\n  1282→              Math.max(0, state.flashDuration - (Date.now() - active.startTime)) : 0\n  1283→          } : null\n  1284→        };\n  1285→      });\n  1286→      return status;\n  1287→    }\n  1288→\n  1289→    // ============================================================\n  1290→    // ROTATION DETECTION (Task A10)\n  1291→    // ============================================================\n  1292→\n  1293→    /**\n  1294→     * Detect current rotation from API data using ALL teams.\n  1295→     * Rotation only advances when ALL teams have completed their current event.\n  1296→     * @param {Array} apiTeams - Teams array from Virtius API\n  1297→     * @returns {Object} { current: number, total: number, isFinal: boolean }\n  1298→     */\n  1299→    function detectRotation(apiTeams) {\n  1300→      if (!apiTeams || apiTeams.length === 0) {\n  1301→        return state.rotation;  // Keep existing state if no data\n  1302→      }\n  1303→\n  1304→      // Total events based on gender (6 for men, 4 for women)\n  1305→      const totalEvents = state.rotation.total;\n  1306→\n  1307→      // Find minimum completed events across ALL teams\n  1308→      let minCompletedAcrossTeams = totalEvents;\n  1309→\n  1310→      apiTeams.forEach((team) => {\n  1311→        const events = team.events || [];\n  1312→        let completedEvents = 0;\n  1313→\n  1314→        events.forEach((event) => {\n  1315→          const gymnasts = event.gymnasts || [];\n  1316→          // An event is \"complete\" if all gymnasts have scores\n  1317→          const scored = gymnasts.filter(g => g.final_score != null);\n  1318→          if (scored.length === gymnasts.length && gymnasts.length > 0) {\n  1319→            completedEvents++;\n  1320→          }\n  1321→        });\n  1322→\n  1323→        minCompletedAcrossTeams = Math.min(minCompletedAcrossTeams, completedEvents);\n  1324→      });\n  1325→\n  1326→      // All events complete for all teams = Final\n  1327→      if (minCompletedAcrossTeams === totalEvents) {\n  1328→        return { current: totalEvents, total: totalEvents, isFinal: true };\n  1329→      }\n  1330→\n  1331→      // Current rotation = completed events + 1\n  1332→      const currentRotation = minCompletedAcrossTeams + 1;\n  1333→      return { current: currentRotation, total: totalEvents, isFinal: false };\n  1334→    }\n  1335→\n  1336→    /**\n  1337→     * Update the rotation tag display in the DOM.\n  1338→     * Shows \"Rotation X of Y\" or \"Final\" when complete.\n  1339→     */\n  1340→    function updateRotationTag() {\n  1341→      const tagEl = document.getElementById('rotationTag');\n  1342→      if (!tagEl) return;\n  1343→\n  1344→      const { current, total, isFinal } = state.rotation;\n  1345→\n  1346→      if (isFinal) {\n  1347→        tagEl.textContent = 'Final';\n  1348→      } else {\n  1349→        tagEl.textContent = `Rotation ${current} of ${total}`;\n  1350→      }\n  1351→    }\n  1352→\n  1353→    // Initialize Firebase schema with default values (prevents race conditions)\n  1354→    // Uses update() with null checks - only sets values that don't exist\n  1355→    async function initializeSchema() {\n  1356→      const defaultSchema = {\n  1357→        enabled: false,\n  1358→        polling: false,\n  1359→        automationMode: 'auto',\n  1360→        showLineup: null,\n  1361→        dismissFlash: {},\n  1362→        nowCompeting: {},\n  1363→        detected: {},\n  1364→        heartbeat: null,\n  1365→        liveData: {\n  1366→          lastPollTimestamp: null,\n  1367→          lastDataChangeTimestamp: null,\n  1368→          stalePollCount: 0,\n  1369→          rotation: null,\n  1370→          totalRotations: null,\n  1371→          teams: {}\n  1372→        },\n  1373→        lastError: null,\n  1374→        config: {\n  1375→          pollInterval: 5000,\n  1376→          flashDuration: 10000,\n  1377→          showStickIndicator: true\n  1378→        }\n  1379→      };\n  1380→\n  1381→      try {\n  1382→        // Use transaction to safely initialize schema without overwriting existing values\n  1383→        await scoreBugRef.transaction((currentData) => {\n  1384→          if (currentData === null) {\n  1385→            // No data exists - write full schema\n  1386→            console.log('Initializing scoreBug schema with defaults');\n  1387→            return defaultSchema;\n  1388→          }\n  1389→          // Data exists - merge defaults for any missing fields only\n  1390→          const merged = { ...defaultSchema };\n  1391→          Object.keys(currentData).forEach(key => {\n  1392→            if (currentData[key] !== undefined) {\n  1393→              // Keep existing value\n  1394→              merged[key] = currentData[key];\n  1395→            }\n  1396→          });\n  1397→          // Deep merge for nested objects (config, liveData)\n  1398→          if (currentData.config) {\n  1399→            merged.config = { ...defaultSchema.config, ...currentData.config };\n  1400→          }\n  1401→          if (currentData.liveData) {\n  1402→            merged.liveData = { ...defaultSchema.liveData, ...currentData.liveData };\n  1403→          }\n  1404→          console.log('Merged existing scoreBug data with defaults');\n  1405→          return merged;\n  1406→        });\n  1407→        console.log('Firebase schema initialized');\n  1408→      } catch (err) {\n  1409→        console.error('Failed to initialize schema:', err);\n  1410→      }\n  1411→    }\n  1412→\n  1413→    // Initialize on load\n  1414→    if (compId) {\n  1415→      // Start connection monitor immediately (A3d)\n  1416→      initConnectionMonitor();\n  1417→\n  1418→      // Order: load config -> render teams -> initialize schema -> start listeners\n  1419→      loadCompetitionConfig().then((success) => {\n  1420→        if (!success) return;\n  1421→\n  1422→        // Render team rows with initial state (before API data)\n  1423→        renderTeamRows();\n  1424→\n  1425→        // Update rotation tag for correct total (4 for women, 6 for men)\n  1426→        updateRotationTag();\n  1427→\n  1428→        // Initialize Firebase schema (safe defaults)\n  1429→        return initializeSchema();\n  1430→      }).then(() => {\n  1431→        // Start listening for Firebase changes\n  1432→        initFirebaseListeners();\n  1433→      });\n  1434→    }\n  1435→  </script>\n  1436→</body>\n  1437→</html>\n  1438→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a46aff20-67b6-4997-a035-d69355a59d46","uuid":"cf5f44aa-69d9-4a83-8450-dc62bbfd855f","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/overlays/team-bug.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=1920, height=1080\">\n  <title>Team Score Bug</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n\n  <!-- Firebase SDK -->\n  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js\"></script>\n  <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js\"></script>\n\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n\n    body {\n      font-family: 'Inter', sans-serif;\n      width: 1920px;\n      height: 1080px;\n      overflow: hidden;\n      background: transparent;\n    }\n\n    /* Score bug container - positioned on right side of screen */\n    .score-bug {\n      position: absolute;\n      top: 50%;\n      right: 0;\n      transform: translateY(-50%) translateX(100%);\n      display: flex;\n      flex-direction: column;\n      min-width: 500px;\n      opacity: 0;\n      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n\n    .score-bug.visible {\n      transform: translateY(-50%) translateX(0);\n      opacity: 1;\n    }\n\n    /* Rotation tag at top */\n    .rotation-tag {\n      background: #27272a;\n      color: #fff;\n      font-size: 20px;\n      font-weight: 700;\n      padding: 10px 20px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n\n    /* Team rows container */\n    .team-rows {\n      display: flex;\n      flex-direction: column;\n    }\n\n    /* Individual team row */\n    .team-row {\n      display: flex;\n      flex-direction: row;\n      background: #1a1a1a;\n      border-bottom: 1px solid #333;\n      min-height: 70px;\n    }\n\n    .team-row:last-child {\n      border-bottom: none;\n    }\n\n    /* Fixed left section: logo + total */\n    .team-fixed {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 10px 15px;\n      min-width: 100px;\n      background: #000;\n    }\n\n    .team-logo {\n      width: 40px;\n      height: 40px;\n      object-fit: contain;\n    }\n\n    .team-total {\n      font-size: 22px;\n      font-weight: 900;\n      color: #fff;\n      margin-top: 4px;\n    }\n\n    .team-total.highlight {\n      animation: totalPulse 0.5s ease;\n    }\n\n    @keyframes totalPulse {\n      0%, 100% { transform: scale(1); color: #fff; }\n      50% { transform: scale(1.1); color: #22d3ee; }\n    }\n\n    /* Slot area for score flash / now competing */\n    .team-slot {\n      flex: 1;\n      display: flex;\n      align-items: center;\n      padding: 10px 20px;\n      overflow: hidden;\n      position: relative;\n    }\n\n    /* Slot content (animates up/down) */\n    .slot-content {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      transform: translateY(0);\n      transition: transform 0.4s ease, opacity 0.4s ease;\n      opacity: 0;\n    }\n\n    .slot-content.visible {\n      opacity: 1;\n    }\n\n    .slot-content.exit-up {\n      transform: translateY(-100%);\n      opacity: 0;\n    }\n\n    .slot-content.enter-from-below {\n      transform: translateY(100%);\n      opacity: 0;\n    }\n\n    /* Slot machine animation - new content spins up from below */\n    @keyframes slotSpinIn {\n      0% {\n        transform: translateY(100%);\n        opacity: 0;\n      }\n      20% {\n        opacity: 1;\n      }\n      100% {\n        transform: translateY(0);\n        opacity: 1;\n      }\n    }\n\n    /* Slot machine animation - old content spins up and out */\n    @keyframes slotSpinOut {\n      0% {\n        transform: translateY(0);\n        opacity: 1;\n      }\n      80% {\n        opacity: 0;\n      }\n      100% {\n        transform: translateY(-100%);\n        opacity: 0;\n      }\n    }\n\n    .slot-content.spin-in {\n      animation: slotSpinIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n    }\n\n    .slot-content.spin-out {\n      animation: slotSpinOut 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n    }\n\n    /* Headshot in slot */\n    .slot-headshot {\n      width: 36px;\n      height: 36px;\n      border-radius: 50%;\n      object-fit: cover;\n      flex-shrink: 0;\n    }\n\n    /* Athlete name in slot */\n    .slot-name {\n      font-size: 24px;\n      font-weight: 700;\n      color: #fff;\n      white-space: nowrap;\n    }\n\n    /* Score in slot */\n    .slot-score {\n      font-size: 28px;\n      font-weight: 900;\n      color: #fff;\n    }\n\n    /* Apparatus code */\n    .slot-apparatus {\n      font-size: 18px;\n      font-weight: 600;\n      color: #a1a1aa;\n      text-transform: uppercase;\n    }\n\n    /* Start value */\n    .slot-sv {\n      font-size: 16px;\n      font-weight: 400;\n      color: #71717a;\n    }\n\n    /* Stick indicator */\n    .slot-stick {\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      background: #22c55e;\n      color: #fff;\n      font-size: 14px;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    /* Separator dot */\n    .slot-separator {\n      color: #52525b;\n      font-size: 20px;\n    }\n\n    /* Correction indicator (score was changed) */\n    .slot-correction {\n      font-size: 14px;\n      font-weight: 500;\n      color: #f59e0b;\n      font-style: italic;\n    }\n\n    /* Lineup card (above bug) */\n    .lineup-card {\n      position: absolute;\n      bottom: 100%;\n      right: 0;\n      width: 100%;\n      background: #1a1a1a;\n      transform: translateY(100%);\n      opacity: 0;\n      transition: transform 0.4s ease, opacity 0.4s ease;\n      margin-bottom: 8px;\n    }\n\n    .lineup-card.visible {\n      transform: translateY(0);\n      opacity: 1;\n    }\n\n    .lineup-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 20px;\n      background: #27272a;\n    }\n\n    .lineup-team-name {\n      font-size: 22px;\n      font-weight: 800;\n      color: #fff;\n      text-transform: uppercase;\n    }\n\n    .lineup-logo {\n      width: 32px;\n      height: 32px;\n      object-fit: contain;\n    }\n\n    .lineup-athletes {\n      padding: 8px 0;\n    }\n\n    .lineup-athlete {\n      display: flex;\n      align-items: center;\n      padding: 8px 20px;\n      gap: 12px;\n    }\n\n    .lineup-order {\n      font-size: 16px;\n      font-weight: 600;\n      color: #71717a;\n      min-width: 24px;\n    }\n\n    .lineup-name {\n      flex: 1;\n      font-size: 20px;\n      font-weight: 600;\n      color: #fff;\n    }\n\n    .lineup-sv {\n      font-size: 16px;\n      font-weight: 400;\n      color: #71717a;\n      min-width: 40px;\n      text-align: right;\n    }\n\n    .lineup-score {\n      font-size: 22px;\n      font-weight: 700;\n      color: #fff;\n      min-width: 70px;\n      text-align: right;\n    }\n\n    .lineup-score.pending {\n      color: #52525b;\n    }\n\n    .lineup-footer {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 20px;\n      background: #27272a;\n    }\n\n    .lineup-event {\n      font-size: 18px;\n      font-weight: 600;\n      color: #a1a1aa;\n      text-transform: uppercase;\n    }\n\n    .lineup-total {\n      font-size: 26px;\n      font-weight: 800;\n      color: #fff;\n    }\n\n    /* Loading / error states */\n    .loading-state {\n      color: #71717a;\n      font-size: 18px;\n      padding: 20px;\n      text-align: center;\n    }\n\n    .error-state {\n      color: #ef4444;\n      font-size: 18px;\n      padding: 20px;\n      text-align: center;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"score-bug\" id=\"scoreBug\">\n    <div class=\"lineup-card\" id=\"lineupCard\">\n      <!-- Lineup card content populated dynamically -->\n    </div>\n    <div class=\"rotation-tag\" id=\"rotationTag\">Rotation 1 of 6</div>\n    <div class=\"team-rows\" id=\"teamRows\">\n      <!-- Team rows populated dynamically -->\n    </div>\n  </div>\n\n  <script>\n    // Firebase configuration\n    const firebaseConfig = {\n      apiKey: \"AIzaSyCh0aZUvKl6Qvqsva3hvOgJJlleP1OwcTY\",\n      authDomain: \"gymnastics-graphics.firebaseapp.com\",\n      databaseURL: \"https://gymnastics-graphics-default-rtdb.firebaseio.com\",\n      projectId: \"gymnastics-graphics\",\n      storageBucket: \"gymnastics-graphics.firebasestorage.app\",\n      messagingSenderId: \"702072609550\",\n      appId: \"1:702072609550:web:ac74a811186d3ff45b955f\"\n    };\n\n    // Initialize Firebase\n    firebase.initializeApp(firebaseConfig);\n    const db = firebase.database();\n\n    // Parse URL parameters\n    const params = new URLSearchParams(window.location.search);\n    const compId = params.get('compId');\n\n    if (!compId) {\n      console.error('Missing compId parameter');\n      document.body.innerHTML = '<div class=\"error-state\">Missing compId parameter</div>';\n    }\n\n    // State management\n    const state = {\n      enabled: false,\n      polling: false,\n      automationMode: 'auto',\n      showLineup: null,\n      teams: [],\n      rotation: { current: 1, total: 6, isFinal: false },\n      previousScores: {},        // { \"gymnast_id\": \"finalScore\" (string) }\n      previousTeamTotals: {},    // { \"teamKey\": \"finalScore\" (string) }\n      flashQueues: {},           // Per-team flash queues\n      activeFlashes: {},         // Currently active flashes per team\n      pollInterval: 5000,\n      flashDuration: 10000,\n      stalePollCount: 0,         // Consecutive polls with no data changes\n      // Competition config (loaded from Firebase)\n      competitionConfig: null,\n      virtiusSessionId: null,\n      gender: 'mens',\n      // Error handling state (A3c)\n      consecutiveErrors: 0,      // Count of consecutive poll failures\n      lastError: null,           // Last error message\n      lastErrorTime: null,       // Timestamp of last error\n      maxBackoffMs: 60000,       // Max backoff delay (60 seconds)\n      // Offline/reconnect state (A3d)\n      firebaseConnected: true,   // Firebase connection state\n      pendingWrites: [],         // Writes queued during offline\n      reconnectAttempts: 0       // Count of reconnect attempts\n    };\n\n    /**\n     * Normalize athlete name for lookup (lowercase, remove special chars).\n     * Matches pattern used in output.html for headshot lookups.\n     */\n    function normalizeName(name) {\n      if (!name) return '';\n      return name.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');\n    }\n\n    // Firebase paths\n    const scoreBugRef = db.ref(`competitions/${compId}/scoreBug`);\n    const configRef = db.ref(`competitions/${compId}/config`);\n    const connectedRef = db.ref('.info/connected');\n\n    /**\n     * Initialize Firebase connection monitoring (A3d).\n     * Detects offline/online state and handles reconnection.\n     */\n    function initConnectionMonitor() {\n      connectedRef.on('value', (snapshot) => {\n        const connected = snapshot.val() === true;\n        const wasConnected = state.firebaseConnected;\n        state.firebaseConnected = connected;\n\n        if (connected && !wasConnected) {\n          // Just reconnected\n          console.log('Firebase connected - processing pending writes');\n          state.reconnectAttempts = 0;\n          processPendingWrites();\n\n          // Write reconnect event to Firebase\n          scoreBugRef.child('connectionStatus').set({\n            connected: true,\n            reconnectedAt: Date.now(),\n            pendingWritesProcessed: state.pendingWrites.length\n          });\n        } else if (!connected && wasConnected) {\n          // Just went offline\n          console.warn('Firebase disconnected - writes will be queued');\n          state.reconnectAttempts++;\n\n          // Note: Firebase SDK has offline persistence by default\n          // Writes are automatically queued and synced on reconnect\n        }\n\n        console.log('Firebase connection state:', connected ? 'ONLINE' : 'OFFLINE');\n      });\n    }\n\n    /**\n     * Process any pending writes that were queued during offline.\n     * Firebase SDK handles this automatically, but we log for visibility.\n     */\n    function processPendingWrites() {\n      if (state.pendingWrites.length === 0) return;\n\n      console.log('Processing', state.pendingWrites.length, 'pending writes');\n\n      // Firebase SDK automatically syncs queued writes\n      // Clear our tracking array\n      state.pendingWrites = [];\n    }\n\n    /**\n     * Safe write to Firebase with offline queueing (A3d).\n     * Wraps Firebase write operations to track pending writes during offline.\n     * @param {firebase.database.Reference} ref - Firebase reference\n     * @param {string} method - 'set', 'update', or 'remove'\n     * @param {*} data - Data to write (for set/update)\n     * @returns {Promise}\n     */\n    async function safeWrite(ref, method, data) {\n      const writeOp = { path: ref.toString(), method, data, timestamp: Date.now() };\n\n      if (!state.firebaseConnected) {\n        // Queue the write for tracking (Firebase SDK queues automatically)\n        state.pendingWrites.push(writeOp);\n        console.log('Queued offline write:', writeOp.path, method);\n      }\n\n      try {\n        if (method === 'set') {\n          await ref.set(data);\n        } else if (method === 'update') {\n          await ref.update(data);\n        } else if (method === 'remove') {\n          await ref.remove();\n        }\n        return true;\n      } catch (err) {\n        // Firebase SDK will retry on reconnect\n        console.error('Write failed (will retry on reconnect):', err.message);\n        if (!state.pendingWrites.includes(writeOp)) {\n          state.pendingWrites.push(writeOp);\n        }\n        return false;\n      }\n    }\n\n    /**\n     * Load competition config from Firebase.\n     * Gets virtiusSessionId, team names/logos, gender, and compType.\n     * Must be called before initializing Firebase listeners.\n     */\n    async function loadCompetitionConfig() {\n      try {\n        const snapshot = await configRef.once('value');\n        const config = snapshot.val();\n\n        if (!config) {\n          console.error('No competition config found for compId:', compId);\n          document.body.innerHTML = '<div class=\"error-state\">Competition not found</div>';\n          return false;\n        }\n\n        state.competitionConfig = config;\n        state.virtiusSessionId = config.virtiusSessionId || null;\n        state.gender = config.gender || 'mens';\n\n        // Build teams array from config (up to 6 teams)\n        state.teams = [];\n        for (let i = 1; i <= 6; i++) {\n          const teamName = config[`team${i}Name`];\n          if (teamName) {\n            state.teams.push({\n              index: i,\n              name: teamName,\n              logo: config[`team${i}Logo`] || '',\n              tricode: config[`team${i}Tricode`] || '',\n              total: '--'  // Initial state before first API poll\n            });\n          }\n        }\n\n        // Determine total rotations based on gender (6 for men, 4 for women)\n        state.rotation.total = state.gender === 'womens' ? 4 : 6;\n\n        console.log('Competition config loaded:', {\n          compId,\n          virtiusSessionId: state.virtiusSessionId,\n          gender: state.gender,\n          teamCount: state.teams.length,\n          teams: state.teams.map(t => t.name)\n        });\n\n        // Check if Virtius session ID is configured\n        if (!state.virtiusSessionId) {\n          console.warn('No Virtius session ID configured - API polling will not work');\n        }\n\n        return true;\n      } catch (err) {\n        console.error('Failed to load competition config:', err);\n        document.body.innerHTML = '<div class=\"error-state\">Failed to load competition config</div>';\n        return false;\n      }\n    }\n\n    /**\n     * Render initial team rows based on competition config.\n     * Called after loadCompetitionConfig() to show teams before API polling starts.\n     */\n    function renderTeamRows() {\n      const container = document.getElementById('teamRows');\n      if (!container) return;\n\n      container.innerHTML = state.teams.map((team, idx) => `\n        <div class=\"team-row\" data-team-index=\"${team.index}\">\n          <div class=\"team-fixed\">\n            <img class=\"team-logo\" src=\"${team.logo}\" alt=\"${team.name}\" onerror=\"this.style.display='none'\">\n            <div class=\"team-total\" id=\"teamTotal${team.index}\">${team.total}</div>\n          </div>\n          <div class=\"team-slot\" id=\"teamSlot${team.index}\">\n            <div class=\"slot-content\" id=\"slotContent${team.index}\">\n              <!-- Score flash / now competing content populated dynamically -->\n            </div>\n          </div>\n        </div>\n      `).join('');\n\n      console.log('Team rows rendered:', state.teams.length);\n    }\n\n    /**\n     * Update team total display element (A4).\n     * Called when API polling detects a change in team.final_score.\n     * Adds highlight animation on value change.\n     * @param {number} teamIndex - 1-based team index\n     * @param {string} newTotal - Formatted score string (e.g., \"196.450\")\n     */\n    function updateTeamTotal(teamIndex, newTotal) {\n      const totalEl = document.getElementById(`teamTotal${teamIndex}`);\n      if (!totalEl) return;\n\n      const prevTotal = totalEl.textContent;\n\n      // Only update if value changed\n      if (prevTotal === newTotal) return;\n\n      totalEl.textContent = newTotal;\n\n      // Trigger highlight animation on change (skip for initial load)\n      if (prevTotal !== '--') {\n        totalEl.classList.remove('highlight');\n        // Force reflow to restart animation\n        void totalEl.offsetWidth;\n        totalEl.classList.add('highlight');\n      }\n    }\n\n    /**\n     * Update all team totals from state (A4).\n     * Called after API poll updates state.teams[].total values.\n     */\n    function updateAllTeamTotals() {\n      state.teams.forEach((team) => {\n        updateTeamTotal(team.index, team.total);\n      });\n    }\n\n    // Initialize Firebase listeners\n    function initFirebaseListeners() {\n      // Listen for enabled state\n      scoreBugRef.child('enabled').on('value', (snapshot) => {\n        state.enabled = snapshot.val() === true;\n        updateBugVisibility();\n      });\n\n      // Listen for polling state\n      scoreBugRef.child('polling').on('value', (snapshot) => {\n        const wasPolling = state.polling;\n        state.polling = snapshot.val() === true;\n        if (state.polling && !wasPolling) {\n          startPolling();\n        } else if (!state.polling && wasPolling) {\n          stopPolling();\n        }\n      });\n\n      // Listen for automation mode\n      scoreBugRef.child('automationMode').on('value', (snapshot) => {\n        state.automationMode = snapshot.val() || 'auto';\n      });\n\n      // Listen for lineup card toggle\n      scoreBugRef.child('showLineup').on('value', (snapshot) => {\n        state.showLineup = snapshot.val();\n        updateLineupCard();\n      });\n\n      // Listen for flash dismissals\n      scoreBugRef.child('dismissFlash').on('value', (snapshot) => {\n        const dismissals = snapshot.val() || {};\n        handleFlashDismissals(dismissals);\n      });\n\n      // Listen for poll interval changes - restart polling with new interval\n      scoreBugRef.child('config/pollInterval').on('value', (snapshot) => {\n        const newInterval = snapshot.val() || 5000;\n        const wasPolling = state.polling && pollTimer !== null;\n        state.pollInterval = newInterval;\n\n        // Restart polling with new interval if currently polling\n        if (wasPolling) {\n          console.log('Poll interval changed to', newInterval, 'ms - restarting polling');\n          stopPolling();\n          startPolling();\n        }\n      });\n\n      // Listen for flash duration changes\n      scoreBugRef.child('config/flashDuration').on('value', (snapshot) => {\n        state.flashDuration = snapshot.val() || 10000;\n      });\n\n      console.log('Firebase listeners initialized');\n    }\n\n    // Update bug visibility based on enabled state\n    function updateBugVisibility() {\n      const bugEl = document.getElementById('scoreBug');\n      if (state.enabled) {\n        bugEl.classList.add('visible');\n      } else {\n        bugEl.classList.remove('visible');\n      }\n    }\n\n    // Update lineup card visibility\n    function updateLineupCard() {\n      const cardEl = document.getElementById('lineupCard');\n      if (state.showLineup) {\n        cardEl.classList.add('visible');\n        // TODO: Populate lineup card content (Phase C)\n      } else {\n        cardEl.classList.remove('visible');\n      }\n    }\n\n    // Handle flash dismissals from producer\n    function handleFlashDismissals(dismissals) {\n      // TODO: Implement flash dismissal handling (Task A12c)\n    }\n\n    // Polling management\n    let pollTimer = null;\n\n    function startPolling() {\n      if (pollTimer) return;\n      console.log('Starting API polling');\n      poll();  // Initial poll\n      pollTimer = setInterval(poll, state.pollInterval);\n    }\n\n    function stopPolling() {\n      if (pollTimer) {\n        clearInterval(pollTimer);\n        pollTimer = null;\n        console.log('Stopped API polling');\n      }\n    }\n\n    // Main poll function - fetches data from Virtius API\n    async function poll() {\n      // Check if we have a valid session ID\n      if (!state.virtiusSessionId) {\n        console.warn('No Virtius session ID - skipping poll');\n        return;\n      }\n\n      const pollStartTime = Date.now();\n\n      try {\n        // Fetch from Virtius API\n        const response = await fetch(`https://api.virti.us/session/${state.virtiusSessionId}/json`);\n\n        if (!response.ok) {\n          throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n        }\n\n        const data = await response.json();\n\n        // Store raw API data for score diff engine (Task A5)\n        // Extract teams array from meet data\n        const teams = data.meet?.teams || [];\n\n        if (teams.length === 0) {\n          console.warn('No teams found in API response');\n        }\n\n        // Store the latest API data in state\n        state.lastApiData = data;\n        state.lastApiTeams = teams;\n\n        // Extract team totals and update state.teams with actual data\n        // final_score comes as a string from API - convert to float for display\n        teams.forEach((apiTeam, idx) => {\n          // Match API team to our configured teams by index or name\n          const stateTeam = state.teams[idx];\n          if (stateTeam) {\n            // Convert string final_score to formatted number\n            const rawScore = apiTeam.final_score;\n            if (rawScore !== null && rawScore !== undefined) {\n              const numScore = parseFloat(rawScore);\n              stateTeam.total = isNaN(numScore) ? '--' : numScore.toFixed(3);\n            }\n            // Store API team reference for score diff engine\n            stateTeam.apiTeam = apiTeam;\n          }\n        });\n\n        // Write heartbeat to Firebase on successful poll (using safeWrite for offline resilience)\n        await safeWrite(scoreBugRef.child('heartbeat'), 'set', pollStartTime);\n\n        console.log('Poll successful:', {\n          sessionId: state.virtiusSessionId,\n          teamCount: teams.length,\n          teams: state.teams.map(t => ({ name: t.name, total: t.total }))\n        });\n\n        // Process API data - detect changes and write deltas to Firebase\n        await processApiData(teams, pollStartTime);\n\n        // Update team total displays (A4)\n        updateAllTeamTotals(