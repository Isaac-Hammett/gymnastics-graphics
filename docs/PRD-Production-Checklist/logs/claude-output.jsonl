{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KrdK27WMGEqhULW2hbZx5B","type":"tool_result","content":"     1→import { createContext, useContext, useEffect, useState, useCallback, useRef } from 'react';\n     2→import { io } from 'socket.io-client';\n     3→import { useCompetition } from './CompetitionContext';\n     4→import { db, ref, set } from '../lib/firebase';\n     5→\n     6→const ShowContext = createContext(null);\n     7→\n     8→// Initial state values for resetting on connection changes\n     9→const INITIAL_STATE = {\n    10→  currentSegmentIndex: 0,\n    11→  currentSegment: null,\n    12→  nextSegment: null,\n    13→  isPlaying: false,\n    14→  isPaused: false,\n    15→  talentLocked: false,\n    16→  obsConnected: false,\n    17→  obsCurrentScene: null,\n    18→  obsIsStreaming: false,\n    19→  obsIsRecording: false,\n    20→  connectedClients: [],\n    21→  showProgress: { completed: 0, total: 0 },\n    22→  showConfig: null\n    23→};\n    24→\n    25→const INITIAL_TIMESHEET_STATE = {\n    26→  state: 'stopped',\n    27→  isRunning: false,\n    28→  isPaused: false,\n    29→  currentSegmentIndex: -1,\n    30→  currentSegment: null,\n    31→  nextSegment: null,\n    32→  segmentElapsedMs: 0,\n    33→  segmentRemainingMs: 0,\n    34→  segmentProgress: 0,\n    35→  showElapsedMs: 0,\n    36→  isHoldSegment: false,\n    37→  canAdvanceHold: false,\n    38→  holdRemainingMs: 0,\n    39→  segments: [],\n    40→  rundownLoaded: false,\n    41→  isRehearsalMode: false,\n    42→  rundownModified: false,\n    43→  rundownModifiedSummary: null\n    44→};\n    45→\n    46→export function ShowProvider({ children }) {\n    47→  // Get socket URL and competition info from CompetitionContext\n    48→  const { socketUrl, compId, competitionConfig } = useCompetition();\n    49→\n    50→  const [socket, setSocket] = useState(null);\n    51→  const [connected, setConnected] = useState(false);\n    52→  const [clientId, setClientId] = useState(null);\n    53→  const [state, setState] = useState(INITIAL_STATE);\n    54→  const [elapsed, setElapsed] = useState(0);\n    55→  const [error, setError] = useState(null);\n    56→\n    57→  // Camera state\n    58→  const [cameraHealth, setCameraHealth] = useState([]);\n    59→  const [cameraRuntimeState, setCameraRuntimeState] = useState([]);\n    60→  const [activeFallbacks, setActiveFallbacks] = useState([]);\n    61→\n    62→  // Timesheet state\n    63→  const [timesheetState, setTimesheetState] = useState(INITIAL_TIMESHEET_STATE);\n    64→  const [overrideLog, setOverrideLog] = useState([]);\n    65→\n    66→  // Ref to always have access to latest competitionConfig in socket handlers\n    67→  const competitionConfigRef = useRef(competitionConfig);\n    68→  useEffect(() => {\n    69→    competitionConfigRef.current = competitionConfig;\n    70→  }, [competitionConfig]);\n    71→\n    72→  useEffect(() => {\n    73→    // Don't connect if no socket URL is available\n    74→    if (!socketUrl) {\n    75→      console.log('ShowContext: No socket URL available, skipping connection');\n    76→      return;\n    77→    }\n    78→\n    79→    console.log(`ShowContext: Connecting to ${socketUrl} for competition ${compId}`);\n    80→\n    81→    // Clear all state when connection changes\n    82→    setState(INITIAL_STATE);\n    83→    setElapsed(0);\n    84→    setError(null);\n    85→    setCameraHealth([]);\n    86→    setCameraRuntimeState([]);\n    87→    setActiveFallbacks([]);\n    88→    setTimesheetState(INITIAL_TIMESHEET_STATE);\n    89→    setOverrideLog([]);\n    90→\n    91→    const newSocket = io(socketUrl, {\n    92→      transports: ['websocket', 'polling'],\n    93→      query: { compId }  // Include competition ID for server to route to correct VM\n    94→    });\n    95→\n    96→    newSocket.on('connect', () => {\n    97→      console.log(`ShowContext: Connected to ${socketUrl} for ${compId}`);\n    98→      setConnected(true);\n    99→    });\n   100→\n   101→    newSocket.on('connected', ({ clientId, state }) => {\n   102→      setClientId(clientId);\n   103→      setState(state);\n   104→    });\n   105→\n   106→    newSocket.on('stateUpdate', (newState) => {\n   107→      setState(newState);\n   108→    });\n   109→\n   110→    newSocket.on('timeUpdate', ({ elapsed }) => {\n   111→      setElapsed(elapsed);\n   112→    });\n   113→\n   114→    newSocket.on('sceneChanged', (sceneName) => {\n   115→      setState(prev => ({ ...prev, obsCurrentScene: sceneName }));\n   116→    });\n   117→\n   118→    // Also listen for new event format from obsStateSync\n   119→    newSocket.on('obs:currentSceneChanged', (data) => {\n   120→      const sceneName = data?.sceneName || data;\n   121→      setState(prev => ({ ...prev, obsCurrentScene: sceneName }));\n   122→    });\n   123→\n   124→    // Listen for OBS connection status from obsConnectionManager\n   125→    newSocket.on('obs:connected', (data) => {\n   126→      console.log('ShowContext: OBS connected', data);\n   127→      setState(prev => ({ ...prev, obsConnected: true }));\n   128→      // Force a full state refresh to get fresh scene list\n   129→      newSocket.emit('obs:refreshState');\n   130→    });\n   131→\n   132→    newSocket.on('obs:disconnected', (data) => {\n   133→      console.log('ShowContext: OBS disconnected', data);\n   134→      setState(prev => ({ ...prev, obsConnected: false }));\n   135→    });\n   136→\n   137→    // Also extract connection status from obs:stateUpdated (sent on initial connection)\n   138→    newSocket.on('obs:stateUpdated', (data) => {\n   139→      console.log('ShowContext: OBS state updated', data);\n   140→      if (data?.connected !== undefined) {\n   141→        setState(prev => ({ ...prev, obsConnected: data.connected }));\n   142→      }\n   143→      if (data?.currentScene) {\n   144→        setState(prev => ({ ...prev, obsCurrentScene: data.currentScene }));\n   145→      }\n   146→    });\n   147→\n   148→    newSocket.on('error', ({ message }) => {\n   149→      setError(message);\n   150→      setTimeout(() => setError(null), 3000);\n   151→    });\n   152→\n   153→    newSocket.on('disconnect', () => {\n   154→      console.log(`ShowContext: Disconnected from ${socketUrl}`);\n   155→      setConnected(false);\n   156→    });\n   157→\n   158→    // Camera health events\n   159→    newSocket.on('cameraHealth', (health) => {\n   160→      console.log('Camera health update:', health);\n   161→      setCameraHealth(health);\n   162→    });\n   163→\n   164→    // Camera runtime state events\n   165→    newSocket.on('cameraRuntimeState', (runtimeState) => {\n   166→      console.log('Camera runtime state update:', runtimeState);\n   167→      setCameraRuntimeState(runtimeState);\n   168→    });\n   169→\n   170→    // Camera status changed event (individual camera transitions)\n   171→    newSocket.on('cameraStatusChanged', ({ cameraId, previousStatus, currentStatus, health }) => {\n   172→      console.log(`Camera ${cameraId} status changed: ${previousStatus} -> ${currentStatus}`);\n   173→      // Update the specific camera in cameraHealth array\n   174→      setCameraHealth(prev => prev.map(cam =>\n   175→        cam.cameraId === cameraId ? { ...cam, status: currentStatus, ...health } : cam\n   176→      ));\n   177→    });\n   178→\n   179→    // Fallback events\n   180→    newSocket.on('activeFallbacks', (fallbacks) => {\n   181→      console.log('Active fallbacks:', fallbacks);\n   182→      setActiveFallbacks(fallbacks);\n   183→    });\n   184→\n   185→    newSocket.on('fallbackActivated', ({ originalCameraId, fallbackCameraId, reason }) => {\n   186→      console.log(`Fallback activated: ${originalCameraId} -> ${fallbackCameraId} (${reason})`);\n   187→      setActiveFallbacks(prev => [\n   188→        ...prev.filter(f => f.originalCameraId !== originalCameraId),\n   189→        { originalCameraId, fallbackCameraId, reason, activatedAt: Date.now() }\n   190→      ]);\n   191→    });\n   192→\n   193→    newSocket.on('fallbackCleared', ({ cameraId }) => {\n   194→      console.log(`Fallback cleared for camera: ${cameraId}`);\n   195→      setActiveFallbacks(prev => prev.filter(f => f.originalCameraId !== cameraId));\n   196→    });\n   197→\n   198→    newSocket.on('fallbackUnavailable', ({ cameraId, reason }) => {\n   199→      console.log(`No fallback available for camera ${cameraId}: ${reason}`);\n   200→    });\n   201→\n   202→    newSocket.on('fallbackChainExhausted', ({ originalCameraId }) => {\n   203→      console.log(`Fallback chain exhausted for camera: ${originalCameraId}`);\n   204→    });\n   205→\n   206→    // Camera apparatus events\n   207→    newSocket.on('apparatusReassigned', ({ cameraId, previousApparatus, currentApparatus, assignedBy }) => {\n   208→      console.log(`Camera ${cameraId} apparatus reassigned: ${previousApparatus} -> ${currentApparatus}`);\n   209→      setCameraRuntimeState(prev => prev.map(cam =>\n   210→        cam.cameraId === cameraId ? { ...cam, currentApparatus } : cam\n   211→      ));\n   212→    });\n   213→\n   214→    newSocket.on('cameraVerified', ({ cameraId, verifiedBy, verifiedAt }) => {\n   215→      console.log(`Camera ${cameraId} verified by ${verifiedBy}`);\n   216→      setCameraRuntimeState(prev => prev.map(cam =>\n   217→        cam.cameraId === cameraId ? { ...cam, verified: true, verifiedBy, verifiedAt } : cam\n   218→      ));\n   219→    });\n   220→\n   221→    newSocket.on('mismatchDetected', ({ cameraId, expected, current }) => {\n   222→      console.log(`Camera ${cameraId} mismatch: expected ${expected}, got ${current}`);\n   223→    });\n   224→\n   225→    // Timesheet events\n   226→    newSocket.on('timesheetState', (state) => {\n   227→      console.log('Timesheet state:', state);\n   228→      // Merge server state with existing client-side state to preserve flags like rundownLoaded\n   229→      setTimesheetState(prev => ({\n   230→        ...prev,\n   231→        ...state\n   232→      }));\n   233→    });\n   234→\n   235→    newSocket.on('timesheetTick', (tickData) => {\n   236→      setTimesheetState(prev => ({\n   237→        ...prev,\n   238→        // Map server property names to client state property names\n   239→        segmentElapsedMs: tickData.elapsedMs,\n   240→        segmentRemainingMs: tickData.remainingMs,\n   241→        segmentProgress: tickData.progress,\n   242→        showElapsedMs: tickData.showElapsedMs,\n   243→        isHoldSegment: tickData.isHoldSegment,\n   244→        canAdvanceHold: tickData.canAdvanceHold,\n   245→        holdRemainingMs: tickData.holdRemainingMs\n   246→      }));\n   247→    });\n   248→\n   249→    newSocket.on('timesheetSegmentActivated', ({ segment, index, previousSegment }) => {\n   250→      console.log(`Timesheet segment activated: ${segment?.name} (index ${index})`);\n   251→      setTimesheetState(prev => ({\n   252→        ...prev,\n   253→        currentSegment: segment,\n   254→        currentSegmentIndex: index,\n   255→        segmentElapsedMs: 0,\n   256→        segmentRemainingMs: segment?.duration || 0,\n   257→        segmentProgress: 0\n   258→      }));\n   259→    });\n   260→\n   261→    newSocket.on('timesheetSegmentCompleted', ({ segment, index, endReason }) => {\n   262→      console.log(`Timesheet segment completed: ${segment?.name} (${endReason})`);\n   263→    });\n   264→\n   265→    newSocket.on('timesheetShowStarted', () => {\n   266→      console.log('Timesheet show started');\n   267→      setTimesheetState(prev => ({\n   268→        ...prev,\n   269→        state: 'running',\n   270→        isRunning: true,\n   271→        isPaused: false\n   272→      }));\n   273→    });\n   274→\n   275→    newSocket.on('timesheetShowStopped', () => {\n   276→      console.log('Timesheet show stopped');\n   277→      setTimesheetState(prev => ({\n   278→        ...prev,\n   279→        state: 'stopped',\n   280→        isRunning: false,\n   281→        isPaused: false\n   282→      }));\n   283→      // Clear legacy isPlaying so the producer isn't stuck (BUG-011)\n   284→      setState(prev => ({ ...prev, isPlaying: false, isPaused: false }));\n   285→    });\n   286→\n   287→    // Task 39: Handle show completion (all segments finished naturally)\n   288→    newSocket.on('timesheetShowComplete', (data) => {\n   289→      console.log(`Timesheet show COMPLETE - ${data.segmentsCompleted} segments finished naturally`);\n   290→      setTimesheetState(prev => ({\n   291→        ...prev,\n   292→        state: 'complete',\n   293→        isRunning: false,\n   294→        isPaused: false,\n   295→        showComplete: true,\n   296→        completedNaturally: true\n   297→      }));\n   298→    });\n   299→\n   300→    newSocket.on('timesheetStateChanged', ({ state: engineState }) => {\n   301→      console.log(`Timesheet state changed: ${engineState}`);\n   302→      setTimesheetState(prev => ({\n   303→        ...prev,\n   304→        state: engineState,\n   305→        isRunning: engineState === 'running',\n   306→        isPaused: engineState === 'paused'\n   307→      }));\n   308→    });\n   309→\n   310→    newSocket.on('timesheetHoldStarted', ({ segment, minDuration, maxDuration }) => {\n   311→      console.log(`Timesheet hold started: min ${minDuration}ms, max ${maxDuration}ms`);\n   312→      setTimesheetState(prev => ({\n   313→        ...prev,\n   314→        isHoldSegment: true,\n   315→        canAdvanceHold: false\n   316→      }));\n   317→    });\n   318→\n   319→    newSocket.on('timesheetHoldMaxReached', ({ segment }) => {\n   320→      console.log(`Timesheet hold max reached: ${segment?.name}`);\n   321→    });\n   322→\n   323→    newSocket.on('timesheetAutoAdvancing', ({ fromSegment, toSegment }) => {\n   324→      console.log(`Timesheet auto-advancing: ${fromSegment?.name} -> ${toSegment?.name}`);\n   325→    });\n   326→\n   327→    newSocket.on('timesheetOverrideRecorded', (override) => {\n   328→      console.log('Timesheet override recorded:', override);\n   329→      setOverrideLog(prev => [...prev, override]);\n   330→    });\n   331→\n   332→    newSocket.on('timesheetSceneChanged', ({ sceneName }) => {\n   333→      console.log(`Timesheet scene changed: ${sceneName}`);\n   334→    });\n   335→\n   336→    newSocket.on('timesheetSceneOverridden', ({ sceneName, triggeredBy }) => {\n   337→      console.log(`Timesheet scene overridden: ${sceneName} by ${triggeredBy}`);\n   338→    });\n   339→\n   340→    newSocket.on('timesheetCameraOverridden', ({ cameraId, sceneName, triggeredBy }) => {\n   341→      console.log(`Timesheet camera overridden: ${cameraId} (${sceneName}) by ${triggeredBy}`);\n   342→    });\n   343→\n   344→    newSocket.on('timesheetGraphicTriggered', ({ graphic, graphicId, data, segmentId }) => {\n   345→      console.log(`Timesheet graphic triggered: ${graphic}`, { graphicId, segmentId });\n   346→      // Write to Firebase so output.html receives the graphic\n   347→      // This bridges the server-side timesheet engine to the client-side Firebase\n   348→      if (compId && graphic) {\n   349→        // Use ref to get latest competition config (avoids stale closure)\n   350→        const config = competitionConfigRef.current;\n   351→        // Merge competition config (team names, logos, coaches, etc.) with segment-specific data\n   352→        // Competition config provides the base data, segment data overrides\n   353→        const mergedData = {\n   354→          // Event and venue info\n   355→          eventName: config?.eventName || '',\n   356→          venue: config?.venue || '',\n   357→          meetDate: config?.meetDate || '',\n   358→          // Team 1\n   359→          team1Name: config?.team1Name || '',\n   360→          team1Logo: config?.team1Logo || '',\n   361→          team1Coaches: config?.team1Coaches || '',\n   362→          team1Ave: config?.team1Ave || '',\n   363→          team1High: config?.team1High || '',\n   364→          // Team 2\n   365→          team2Name: config?.team2Name || '',\n   366→          team2Logo: config?.team2Logo || '',\n   367→          team2Coaches: config?.team2Coaches || '',\n   368→          team2Ave: config?.team2Ave || '',\n   369→          team2High: config?.team2High || '',\n   370→          // Team 3\n   371→          team3Name: config?.team3Name || '',\n   372→          team3Logo: config?.team3Logo || '',\n   373→          team3Coaches: config?.team3Coaches || '',\n   374→          team3Ave: config?.team3Ave || '',\n   375→          team3High: config?.team3High || '',\n   376→          // Team 4\n   377→          team4Name: config?.team4Name || '',\n   378→          team4Logo: config?.team4Logo || '',\n   379→          team4Coaches: config?.team4Coaches || '',\n   380→          team4Ave: config?.team4Ave || '',\n   381→          team4High: config?.team4High || '',\n   382→          // Team 5\n   383→          team5Name: config?.team5Name || '',\n   384→          team5Logo: config?.team5Logo || '',\n   385→          team5Coaches: config?.team5Coaches || '',\n   386→          team5Ave: config?.team5Ave || '',\n   387→          team5High: config?.team5High || '',\n   388→          // Team 6\n   389→          team6Name: config?.team6Name || '',\n   390→          team6Logo: config?.team6Logo || '',\n   391→          team6Coaches: config?.team6Coaches || '',\n   392→          team6Ave: config?.team6Ave || '',\n   393→          team6High: config?.team6High || '',\n   394→          // Merge segment-specific data on top (e.g., teamSlot)\n   395→          ...data\n   396→        };\n   397→        set(ref(db, `competitions/${compId}/currentGraphic`), {\n   398→          graphic,\n   399→          graphicId: graphicId || graphic,\n   400→          data: mergedData,\n   401→          segmentId,\n   402→          timestamp: Date.now()\n   403→        }).catch(err => console.error('Failed to trigger graphic via Firebase:', err));\n   404→      }\n   405→    });\n   406→\n   407→    newSocket.on('timesheetVideoStarted', ({ videoPath, segment }) => {\n   408→      console.log(`Timesheet video started: ${videoPath}`);\n   409→    });\n   410→\n   411→    newSocket.on('timesheetBreakStarted', ({ segment }) => {\n   412→      console.log(`Timesheet break started: ${segment?.name}`);\n   413→    });\n   414→\n   415→    newSocket.on('timesheetError', ({ message, type }) => {\n   416→      console.error(`Timesheet error (${type}): ${message}`);\n   417→      setError(message);\n   418→      setTimeout(() => setError(null), 3000);\n   419→    });\n   420→\n   421→    // Load rundown result handler\n   422→    newSocket.on('loadRundownResult', ({ success, segmentCount, error: loadError }) => {\n   423→      if (success) {\n   424→        console.log(`Rundown loaded successfully: ${segmentCount} segments`);\n   425→        setTimesheetState(prev => ({\n   426→          ...prev,\n   427→          rundownLoaded: true,\n   428→          rundownModified: false,\n   429→          rundownModifiedSummary: null\n   430→        }));\n   431→      } else {\n   432→        console.error(`Failed to load rundown: ${loadError}`);\n   433→        setError(`Failed to load rundown: ${loadError}`);\n   434→        setTimeout(() => setError(null), 5000);\n   435→      }\n   436→    });\n   437→\n   438→    // Rehearsal mode changed handler\n   439→    newSocket.on('rehearsalModeChanged', ({ isRehearsalMode }) => {\n   440→      console.log(`Rehearsal mode changed: ${isRehearsalMode}`);\n   441→      setTimesheetState(prev => ({\n   442→        ...prev,\n   443→        isRehearsalMode\n   444→      }));\n   445→    });\n   446→\n   447→    // Rundown modified handler (Phase I - Live Rundown Sync)\n   448→    newSocket.on('rundownModified', (summary) => {\n   449→      console.log('Rundown modified:', summary);\n   450→      setTimesheetState(prev => ({\n   451→        ...prev,\n   452→        rundownModified: true,\n   453→        rundownModifiedSummary: summary\n   454→      }));\n   455→    });\n   456→\n   457→    // AI suggestions result handler (Phase D - AI Suggestions)\n   458→    // Note: This handler is for callback-based usage - callers set up their own\n   459→    // one-time listener. This is a fallback for general logging.\n   460→    newSocket.on('aiSuggestionsResult', (result) => {\n   461→      console.log('AI suggestions received:', result.success ? `${result.suggestions?.length || 0} suggestions` : result.error);\n   462→    });\n   463→\n   464→    setSocket(newSocket);\n   465→\n   466→    return () => {\n   467→      console.log(`ShowContext: Closing connection to ${socketUrl}`);\n   468→      newSocket.close();\n   469→      setSocket(null);\n   470→      setConnected(false);\n   471→    };\n   472→  }, [socketUrl, compId]);\n   473→\n   474→  const identify = useCallback((role, name) => {\n   475→    socket?.emit('identify', { role, name });\n   476→  }, [socket]);\n   477→\n   478→  const advance = useCallback(() => {\n   479→    socket?.emit('advance');\n   480→  }, [socket]);\n   481→\n   482→  const previous = useCallback(() => {\n   483→    socket?.emit('previous');\n   484→  }, [socket]);\n   485→\n   486→  const jumpTo = useCallback((segmentId) => {\n   487→    socket?.emit('jumpTo', { segmentId });\n   488→  }, [socket]);\n   489→\n   490→  const overrideScene = useCallback((sceneName) => {\n   491→    socket?.emit('overrideScene', { sceneName });\n   492→  }, [socket]);\n   493→\n   494→  const lockTalent = useCallback((locked) => {\n   495→    socket?.emit('lockTalent', { locked });\n   496→  }, [socket]);\n   497→\n   498→  const togglePause = useCallback(() => {\n   499→    socket?.emit('togglePause');\n   500→  }, [socket]);\n   501→\n   502→  const startShow = useCallback(() => {\n   503→    socket?.emit('startShow');\n   504→  }, [socket]);\n   505→\n   506→  const resetShow = useCallback(() => {\n   507→    socket?.emit('resetShow');\n   508→  }, [socket]);\n   509→\n   510→  const triggerGraphic = useCallback((graphic, data = {}) => {\n   511→    socket?.emit('triggerGraphic', { graphic, data });\n   512→  }, [socket]);\n   513→\n   514→  const clearGraphic = useCallback(() => {\n   515→    socket?.emit('clearGraphic');\n   516→  }, [socket]);\n   517→\n   518→  // Camera control functions\n   519→  const reassignApparatus = useCallback((cameraId, apparatus, assignedBy = 'producer') => {\n   520→    socket?.emit('reassignApparatus', { cameraId, apparatus, assignedBy });\n   521→  }, [socket]);\n   522→\n   523→  const verifyCamera = useCallback((cameraId, verifiedBy = 'producer') => {\n   524→    socket?.emit('verifyCamera', { cameraId, verifiedBy });\n   525→  }, [socket]);\n   526→\n   527→  const clearFallback = useCallback((cameraId) => {\n   528→    socket?.emit('clearFallback', { cameraId });\n   529→  }, [socket]);\n   530→\n   531→  const resetVerifications = useCallback(() => {\n   532→    socket?.emit('resetVerifications');\n   533→  }, [socket]);\n   534→\n   535→  const overrideCamera = useCallback((cameraId, triggeredBy = 'producer') => {\n   536→    socket?.emit('overrideCamera', { cameraId, triggeredBy });\n   537→  }, [socket]);\n   538→\n   539→  // Timesheet control functions\n   540→  const loadRundown = useCallback(() => {\n   541→    console.log('ShowContext: Loading rundown for competition', compId);\n   542→    socket?.emit('loadRundown', { compId });\n   543→  }, [socket, compId]);\n   544→\n   545→  const startTimesheetShow = useCallback(() => {\n   546→    socket?.emit('startTimesheetShow');\n   547→  }, [socket]);\n   548→\n   549→  const stopTimesheetShow = useCallback(() => {\n   550→    socket?.emit('stopTimesheetShow');\n   551→  }, [socket]);\n   552→\n   553→  const pauseTimesheetShow = useCallback(() => {\n   554→    socket?.emit('pauseTimesheetShow');\n   555→  }, [socket]);\n   556→\n   557→  const resumeTimesheetShow = useCallback(() => {\n   558→    socket?.emit('resumeTimesheetShow');\n   559→  }, [socket]);\n   560→\n   561→  const advanceTimesheetSegment = useCallback((advancedBy = 'producer') => {\n   562→    socket?.emit('advanceSegment', { advancedBy });\n   563→  }, [socket]);\n   564→\n   565→  const previousTimesheetSegment = useCallback((triggeredBy = 'producer') => {\n   566→    socket?.emit('previousSegment', { triggeredBy });\n   567→  }, [socket]);\n   568→\n   569→  const goToTimesheetSegment = useCallback((segmentId, triggeredBy = 'producer') => {\n   570→    socket?.emit('goToSegment', { segmentId, triggeredBy });\n   571→  }, [socket]);\n   572→\n   573→  const overrideTimesheetScene = useCallback((sceneName, triggeredBy = 'producer') => {\n   574→    socket?.emit('timesheetOverrideScene', { sceneName, triggeredBy });\n   575→  }, [socket]);\n   576→\n   577→  const overrideTimesheetCamera = useCallback((cameraId, triggeredBy = 'producer') => {\n   578→    socket?.emit('overrideCamera', { cameraId, triggeredBy });\n   579→  }, [socket]);\n   580→\n   581→  const getTimesheetOverrides = useCallback(() => {\n   582→    return overrideLog;\n   583→  }, [overrideLog]);\n   584→\n   585→  const clearOverrideLog = useCallback(() => {\n   586→    setOverrideLog([]);\n   587→  }, []);\n   588→\n   589→  const setRehearsalMode = useCallback((enabled) => {\n   590→    console.log(`ShowContext: Setting rehearsal mode to ${enabled} for competition`, compId);\n   591→    socket?.emit('setRehearsalMode', { enabled, compId });\n   592→  }, [socket, compId]);\n   593→\n   594→  const clearRundownModified = useCallback(() => {\n   595→    setTimesheetState(prev => ({\n   596→      ...prev,\n   597→      rundownModified: false,\n   598→      rundownModifiedSummary: null\n   599→    }));\n   600→  }, []);\n   601→\n   602→  // AI Suggestions function (Phase D - AI Suggestions)\n   603→  // Returns a promise that resolves with the suggestions result\n   604→  const getAISuggestions = useCallback((options = {}) => {\n   605→    return new Promise((resolve, reject) => {\n   606→      if (!socket) {\n   607→        reject(new Error('Socket not connected'));\n   608→        return;\n   609→      }\n   610→\n   611→      console.log('ShowContext: Requesting AI suggestions for competition', compId);\n   612→\n   613→      // Set up one-time listener for the result\n   614→      const handleResult = (result) => {\n   615→        socket.off('aiSuggestionsResult', handleResult);\n   616→        if (result.success) {\n   617→          resolve(result);\n   618→        } else {\n   619→          reject(new Error(result.error || 'Failed to get AI suggestions'));\n   620→        }\n   621→      };\n   622→\n   623→      socket.on('aiSuggestionsResult', handleResult);\n   624→\n   625→      // Emit the request\n   626→      socket.emit('getAISuggestions', { compId, options });\n   627→\n   628→      // Timeout after 30 seconds\n   629→      setTimeout(() => {\n   630→        socket.off('aiSuggestionsResult', handleResult);\n   631→        reject(new Error('AI suggestions request timed out'));\n   632→      }, 30000);\n   633→    });\n   634→  }, [socket, compId]);\n   635→\n   636→  const value = {\n   637→    // Connection info\n   638→    socketUrl,\n   639→    compId,\n   640→    socket,\n   641→    connected,\n   642→    clientId,\n   643→    state,\n   644→    elapsed,\n   645→    error,\n   646→    identify,\n   647→    advance,\n   648→    previous,\n   649→    jumpTo,\n   650→    overrideScene,\n   651→    lockTalent,\n   652→    togglePause,\n   653→    startShow,\n   654→    resetShow,\n   655→    triggerGraphic,\n   656→    clearGraphic,\n   657→    // Camera state\n   658→    cameraHealth,\n   659→    cameraRuntimeState,\n   660→    activeFallbacks,\n   661→    // Camera control functions\n   662→    reassignApparatus,\n   663→    verifyCamera,\n   664→    clearFallback,\n   665→    resetVerifications,\n   666→    overrideCamera,\n   667→    // Timesheet state\n   668→    timesheetState,\n   669→    overrideLog,\n   670→    // Timesheet control functions\n   671→    loadRundown,\n   672→    startTimesheetShow,\n   673→    stopTimesheetShow,\n   674→    pauseTimesheetShow,\n   675→    resumeTimesheetShow,\n   676→    advanceTimesheetSegment,\n   677→    previousTimesheetSegment,\n   678→    goToTimesheetSegment,\n   679→    overrideTimesheetScene,\n   680→    overrideTimesheetCamera,\n   681→    getTimesheetOverrides,\n   682→    clearOverrideLog,\n   683→    setRehearsalMode,\n   684→    clearRundownModified,\n   685→    // AI Suggestions\n   686→    getAISuggestions\n   687→  };\n   688→\n   689→  return (\n   690→    <ShowContext.Provider value={value}>\n   691→      {children}\n   692→    </ShowContext.Provider>\n   693→  );\n   694→}\n   695→\n   696→export function useShow() {\n   697→  const context = useContext(ShowContext);\n   698→  if (!context) {\n   699→    throw new Error('useShow must be used within a ShowProvider');\n   700→  }\n   701→  return context;\n   702→}\n   703→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"80813a13-8d65-4e4c-b211-0298af3d1836","uuid":"72abde50-8201-4e49-a214-c7827f28a6f7","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/context/ShowContext.jsx","content":"import { createContext, useContext, useEffect, useState, useCallback, useRef } from 'react';\nimport { io } from 'socket.io-client';\nimport { useCompetition } from './CompetitionContext';\nimport { db, ref, set } from '../lib/firebase';\n\nconst ShowContext = createContext(null);\n\n// Initial state values for resetting on connection changes\nconst INITIAL_STATE = {\n  currentSegmentIndex: 0,\n  currentSegment: null,\n  nextSegment: null,\n  isPlaying: false,\n  isPaused: false,\n  talentLocked: false,\n  obsConnected: false,\n  obsCurrentScene: null,\n  obsIsStreaming: false,\n  obsIsRecording: false,\n  connectedClients: [],\n  showProgress: { completed: 0, total: 0 },\n  showConfig: null\n};\n\nconst INITIAL_TIMESHEET_STATE = {\n  state: 'stopped',\n  isRunning: false,\n  isPaused: false,\n  currentSegmentIndex: -1,\n  currentSegment: null,\n  nextSegment: null,\n  segmentElapsedMs: 0,\n  segmentRemainingMs: 0,\n  segmentProgress: 0,\n  showElapsedMs: 0,\n  isHoldSegment: false,\n  canAdvanceHold: false,\n  holdRemainingMs: 0,\n  segments: [],\n  rundownLoaded: false,\n  isRehearsalMode: false,\n  rundownModified: false,\n  rundownModifiedSummary: null\n};\n\nexport function ShowProvider({ children }) {\n  // Get socket URL and competition info from CompetitionContext\n  const { socketUrl, compId, competitionConfig } = useCompetition();\n\n  const [socket, setSocket] = useState(null);\n  const [connected, setConnected] = useState(false);\n  const [clientId, setClientId] = useState(null);\n  const [state, setState] = useState(INITIAL_STATE);\n  const [elapsed, setElapsed] = useState(0);\n  const [error, setError] = useState(null);\n\n  // Camera state\n  const [cameraHealth, setCameraHealth] = useState([]);\n  const [cameraRuntimeState, setCameraRuntimeState] = useState([]);\n  const [activeFallbacks, setActiveFallbacks] = useState([]);\n\n  // Timesheet state\n  const [timesheetState, setTimesheetState] = useState(INITIAL_TIMESHEET_STATE);\n  const [overrideLog, setOverrideLog] = useState([]);\n\n  // Ref to always have access to latest competitionConfig in socket handlers\n  const competitionConfigRef = useRef(competitionConfig);\n  useEffect(() => {\n    competitionConfigRef.current = competitionConfig;\n  }, [competitionConfig]);\n\n  useEffect(() => {\n    // Don't connect if no socket URL is available\n    if (!socketUrl) {\n      console.log('ShowContext: No socket URL available, skipping connection');\n      return;\n    }\n\n    console.log(`ShowContext: Connecting to ${socketUrl} for competition ${compId}`);\n\n    // Clear all state when connection changes\n    setState(INITIAL_STATE);\n    setElapsed(0);\n    setError(null);\n    setCameraHealth([]);\n    setCameraRuntimeState([]);\n    setActiveFallbacks([]);\n    setTimesheetState(INITIAL_TIMESHEET_STATE);\n    setOverrideLog([]);\n\n    const newSocket = io(socketUrl, {\n      transports: ['websocket', 'polling'],\n      query: { compId }  // Include competition ID for server to route to correct VM\n    });\n\n    newSocket.on('connect', () => {\n      console.log(`ShowContext: Connected to ${socketUrl} for ${compId}`);\n      setConnected(true);\n    });\n\n    newSocket.on('connected', ({ clientId, state }) => {\n      setClientId(clientId);\n      setState(state);\n    });\n\n    newSocket.on('stateUpdate', (newState) => {\n      setState(newState);\n    });\n\n    newSocket.on('timeUpdate', ({ elapsed }) => {\n      setElapsed(elapsed);\n    });\n\n    newSocket.on('sceneChanged', (sceneName) => {\n      setState(prev => ({ ...prev, obsCurrentScene: sceneName }));\n    });\n\n    // Also listen for new event format from obsStateSync\n    newSocket.on('obs:currentSceneChanged', (data) => {\n      const sceneName = data?.sceneName || data;\n      setState(prev => ({ ...prev, obsCurrentScene: sceneName }));\n    });\n\n    // Listen for OBS connection status from obsConnectionManager\n    newSocket.on('obs:connected', (data) => {\n      console.log('ShowContext: OBS connected', data);\n      setState(prev => ({ ...prev, obsConnected: true }));\n      // Force a full state refresh to get fresh scene list\n      newSocket.emit('obs:refreshState');\n    });\n\n    newSocket.on('obs:disconnected', (data) => {\n      console.log('ShowContext: OBS disconnected', data);\n      setState(prev => ({ ...prev, obsConnected: false }));\n    });\n\n    // Also extract connection status from obs:stateUpdated (sent on initial connection)\n    newSocket.on('obs:stateUpdated', (data) => {\n      console.log('ShowContext: OBS state updated', data);\n      if (data?.connected !== undefined) {\n        setState(prev => ({ ...prev, obsConnected: data.connected }));\n      }\n      if (data?.currentScene) {\n        setState(prev => ({ ...prev, obsCurrentScene: data.currentScene }));\n      }\n    });\n\n    newSocket.on('error', ({ message }) => {\n      setError(message);\n      setTimeout(() => setError(null), 3000);\n    });\n\n    newSocket.on('disconnect', () => {\n      console.log(`ShowContext: Disconnected from ${socketUrl}`);\n      setConnected(false);\n    });\n\n    // Camera health events\n    newSocket.on('cameraHealth', (health) => {\n      console.log('Camera health update:', health);\n      setCameraHealth(health);\n    });\n\n    // Camera runtime state events\n    newSocket.on('cameraRuntimeState', (runtimeState) => {\n      console.log('Camera runtime state update:', runtimeState);\n      setCameraRuntimeState(runtimeState);\n    });\n\n    // Camera status changed event (individual camera transitions)\n    newSocket.on('cameraStatusChanged', ({ cameraId, previousStatus, currentStatus, health }) => {\n      console.log(`Camera ${cameraId} status changed: ${previousStatus} -> ${currentStatus}`);\n      // Update the specific camera in cameraHealth array\n      setCameraHealth(prev => prev.map(cam =>\n        cam.cameraId === cameraId ? { ...cam, status: currentStatus, ...health } : cam\n      ));\n    });\n\n    // Fallback events\n    newSocket.on('activeFallbacks', (fallbacks) => {\n      console.log('Active fallbacks:', fallbacks);\n      setActiveFallbacks(fallbacks);\n    });\n\n    newSocket.on('fallbackActivated', ({ originalCameraId, fallbackCameraId, reason }) => {\n      console.log(`Fallback activated: ${originalCameraId} -> ${fallbackCameraId} (${reason})`);\n      setActiveFallbacks(prev => [\n        ...prev.filter(f => f.originalCameraId !== originalCameraId),\n        { originalCameraId, fallbackCameraId, reason, activatedAt: Date.now() }\n      ]);\n    });\n\n    newSocket.on('fallbackCleared', ({ cameraId }) => {\n      console.log(`Fallback cleared for camera: ${cameraId}`);\n      setActiveFallbacks(prev => prev.filter(f => f.originalCameraId !== cameraId));\n    });\n\n    newSocket.on('fallbackUnavailable', ({ cameraId, reason }) => {\n      console.log(`No fallback available for camera ${cameraId}: ${reason}`);\n    });\n\n    newSocket.on('fallbackChainExhausted', ({ originalCameraId }) => {\n      console.log(`Fallback chain exhausted for camera: ${originalCameraId}`);\n    });\n\n    // Camera apparatus events\n    newSocket.on('apparatusReassigned', ({ cameraId, previousApparatus, currentApparatus, assignedBy }) => {\n      console.log(`Camera ${cameraId} apparatus reassigned: ${previousApparatus} -> ${currentApparatus}`);\n      setCameraRuntimeState(prev => prev.map(cam =>\n        cam.cameraId === cameraId ? { ...cam, currentApparatus } : cam\n      ));\n    });\n\n    newSocket.on('cameraVerified', ({ cameraId, verifiedBy, verifiedAt }) => {\n      console.log(`Camera ${cameraId} verified by ${verifiedBy}`);\n      setCameraRuntimeState(prev => prev.map(cam =>\n        cam.cameraId === cameraId ? { ...cam, verified: true, verifiedBy, verifiedAt } : cam\n      ));\n    });\n\n    newSocket.on('mismatchDetected', ({ cameraId, expected, current }) => {\n      console.log(`Camera ${cameraId} mismatch: expected ${expected}, got ${current}`);\n    });\n\n    // Timesheet events\n    newSocket.on('timesheetState', (state) => {\n      console.log('Timesheet state:', state);\n      // Merge server state with existing client-side state to preserve flags like rundownLoaded\n      setTimesheetState(prev => ({\n        ...prev,\n        ...state\n      }));\n    });\n\n    newSocket.on('timesheetTick', (tickData) => {\n      setTimesheetState(prev => ({\n        ...prev,\n        // Map server property names to client state property names\n        segmentElapsedMs: tickData.elapsedMs,\n        segmentRemainingMs: tickData.remainingMs,\n        segmentProgress: tickData.progress,\n        showElapsedMs: tickData.showElapsedMs,\n        isHoldSegment: tickData.isHoldSegment,\n        canAdvanceHold: tickData.canAdvanceHold,\n        holdRemainingMs: tickData.holdRemainingMs\n      }));\n    });\n\n    newSocket.on('timesheetSegmentActivated', ({ segment, index, previousSegment }) => {\n      console.log(`Timesheet segment activated: ${segment?.name} (index ${index})`);\n      setTimesheetState(prev => ({\n        ...prev,\n        currentSegment: segment,\n        currentSegmentIndex: index,\n        segmentElapsedMs: 0,\n        segmentRemainingMs: segment?.duration || 0,\n        segmentProgress: 0\n      }));\n    });\n\n    newSocket.on('timesheetSegmentCompleted', ({ segment, index, endReason }) => {\n      console.log(`Timesheet segment completed: ${segment?.name} (${endReason})`);\n    });\n\n    newSocket.on('timesheetShowStarted', () => {\n      console.log('Timesheet show started');\n      setTimesheetState(prev => ({\n        ...prev,\n        state: 'running',\n        isRunning: true,\n        isPaused: false\n      }));\n    });\n\n    newSocket.on('timesheetShowStopped', () => {\n      console.log('Timesheet show stopped');\n      setTimesheetState(prev => ({\n        ...prev,\n        state: 'stopped',\n        isRunning: false,\n        isPaused: false\n      }));\n      // Clear legacy isPlaying so the producer isn't stuck (BUG-011)\n      setState(prev => ({ ...prev, isPlaying: false, isPaused: false }));\n    });\n\n    // Task 39: Handle show completion (all segments finished naturally)\n    newSocket.on('timesheetShowComplete', (data) => {\n      console.log(`Timesheet show COMPLETE - ${data.segmentsCompleted} segments finished naturally`);\n      setTimesheetState(prev => ({\n        ...prev,\n        state: 'complete',\n        isRunning: false,\n        isPaused: false,\n        showComplete: true,\n        completedNaturally: true\n      }));\n    });\n\n    newSocket.on('timesheetStateChanged', ({ state: engineState }) => {\n      console.log(`Timesheet state changed: ${engineState}`);\n      setTimesheetState(prev => ({\n        ...prev,\n        state: engineState,\n        isRunning: engineState === 'running',\n        isPaused: engineState === 'paused'\n      }));\n    });\n\n    newSocket.on('timesheetHoldStarted', ({ segment, minDuration, maxDuration }) => {\n      console.log(`Timesheet hold started: min ${minDuration}ms, max ${maxDuration}ms`);\n      setTimesheetState(prev => ({\n        ...prev,\n        isHoldSegment: true,\n        canAdvanceHold: false\n      }));\n    });\n\n    newSocket.on('timesheetHoldMaxReached', ({ segment }) => {\n      console.log(`Timesheet hold max reached: ${segment?.name}`);\n    });\n\n    newSocket.on('timesheetAutoAdvancing', ({ fromSegment, toSegment }) => {\n      console.log(`Timesheet auto-advancing: ${fromSegment?.name} -> ${toSegment?.name}`);\n    });\n\n    newSocket.on('timesheetOverrideRecorded', (override) => {\n      console.log('Timesheet override recorded:', override);\n      setOverrideLog(prev => [...prev, override]);\n    });\n\n    newSocket.on('timesheetSceneChanged', ({ sceneName }) => {\n      console.log(`Timesheet scene changed: ${sceneName}`);\n    });\n\n    newSocket.on('timesheetSceneOverridden', ({ sceneName, triggeredBy }) => {\n      console.log(`Timesheet scene overridden: ${sceneName} by ${triggeredBy}`);\n    });\n\n    newSocket.on('timesheetCameraOverridden', ({ cameraId, sceneName, triggeredBy }) => {\n      console.log(`Timesheet camera overridden: ${cameraId} (${sceneName}) by ${triggeredBy}`);\n    });\n\n    newSocket.on('timesheetGraphicTriggered', ({ graphic, graphicId, data, segmentId }) => {\n      console.log(`Timesheet graphic triggered: ${graphic}`, { graphicId, segmentId });\n      // Write to Firebase so output.html receives the graphic\n      // This bridges the server-side timesheet engine to the client-side Firebase\n      if (compId && graphic) {\n        // Use ref to get latest competition config (avoids stale closure)\n        const config = competitionConfigRef.current;\n        // Merge competition config (team names, logos, coaches, etc.) with segment-specific data\n        // Competition config provides the base data, segment data overrides\n        const mergedData = {\n          // Event and venue info\n          eventName: config?.eventName || '',\n          venue: config?.venue || '',\n          meetDate: config?.meetDate || '',\n          // Team 1\n          team1Name: config?.team1Name || '',\n          team1Logo: config?.team1Logo || '',\n          team1Coaches: config?.team1Coaches || '',\n          team1Ave: config?.team1Ave || '',\n          team1High: config?.team1High || '',\n          // Team 2\n          team2Name: config?.team2Name || '',\n          team2Logo: config?.team2Logo || '',\n          team2Coaches: config?.team2Coaches || '',\n          team2Ave: config?.team2Ave || '',\n          team2High: config?.team2High || '',\n          // Team 3\n          team3Name: config?.team3Name || '',\n          team3Logo: config?.team3Logo || '',\n          team3Coaches: config?.team3Coaches || '',\n          team3Ave: config?.team3Ave || '',\n          team3High: config?.team3High || '',\n          // Team 4\n          team4Name: config?.team4Name || '',\n          team4Logo: config?.team4Logo || '',\n          team4Coaches: config?.team4Coaches || '',\n          team4Ave: config?.team4Ave || '',\n          team4High: config?.team4High || '',\n          // Team 5\n          team5Name: config?.team5Name || '',\n          team5Logo: config?.team5Logo || '',\n          team5Coaches: config?.team5Coaches || '',\n          team5Ave: config?.team5Ave || '',\n          team5High: config?.team5High || '',\n          // Team 6\n          team6Name: config?.team6Name || '',\n          team6Logo: config?.team6Logo || '',\n          team6Coaches: config?.team6Coaches || '',\n          team6Ave: config?.team6Ave || '',\n          team6High: config?.team6High || '',\n          // Merge segment-specific data on top (e.g., teamSlot)\n          ...data\n        };\n        set(ref(db, `competitions/${compId}/currentGraphic`), {\n          graphic,\n          graphicId: graphicId || graphic,\n          data: mergedData,\n          segmentId,\n          timestamp: Date.now()\n        }).catch(err => console.error('Failed to trigger graphic via Firebase:', err));\n      }\n    });\n\n    newSocket.on('timesheetVideoStarted', ({ videoPath, segment }) => {\n      console.log(`Timesheet video started: ${videoPath}`);\n    });\n\n    newSocket.on('timesheetBreakStarted', ({ segment }) => {\n      console.log(`Timesheet break started: ${segment?.name}`);\n    });\n\n    newSocket.on('timesheetError', ({ message, type }) => {\n      console.error(`Timesheet error (${type}): ${message}`);\n      setError(message);\n      setTimeout(() => setError(null), 3000);\n    });\n\n    // Load rundown result handler\n    newSocket.on('loadRundownResult', ({ success, segmentCount, error: loadError }) => {\n      if (success) {\n        console.log(`Rundown loaded successfully: ${segmentCount} segments`);\n        setTimesheetState(prev => ({\n          ...prev,\n          rundownLoaded: true,\n          rundownModified: false,\n          rundownModifiedSummary: null\n        }));\n      } else {\n        console.error(`Failed to load rundown: ${loadError}`);\n        setError(`Failed to load rundown: ${loadError}`);\n        setTimeout(() => setError(null), 5000);\n      }\n    });\n\n    // Rehearsal mode changed handler\n    newSocket.on('rehearsalModeChanged', ({ isRehearsalMode }) => {\n      console.log(`Rehearsal mode changed: ${isRehearsalMode}`);\n      setTimesheetState(prev => ({\n        ...prev,\n        isRehearsalMode\n      }));\n    });\n\n    // Rundown modified handler (Phase I - Live Rundown Sync)\n    newSocket.on('rundownModified', (summary) => {\n      console.log('Rundown modified:', summary);\n      setTimesheetState(prev => ({\n        ...prev,\n        rundownModified: true,\n        rundownModifiedSummary: summary\n      }));\n    });\n\n    // AI suggestions result handler (Phase D - AI Suggestions)\n    // Note: This handler is for callback-based usage - callers set up their own\n    // one-time listener. This is a fallback for general logging.\n    newSocket.on('aiSuggestionsResult', (result) => {\n      console.log('AI suggestions received:', result.success ? `${result.suggestions?.length || 0} suggestions` : result.error);\n    });\n\n    setSocket(newSocket);\n\n    return () => {\n      console.log(`ShowContext: Closing connection to ${socketUrl}`);\n      newSocket.close();\n      setSocket(null);\n      setConnected(false);\n    };\n  }, [socketUrl, compId]);\n\n  const identify = useCallback((role, name) => {\n    socket?.emit('identify', { role, name });\n  }, [socket]);\n\n  const advance = useCallback(() => {\n    socket?.emit('advance');\n  }, [socket]);\n\n  const previous = useCallback(() => {\n    socket?.emit('previous');\n  }, [socket]);\n\n  const jumpTo = useCallback((segmentId) => {\n    socket?.emit('jumpTo', { segmentId });\n  }, [socket]);\n\n  const overrideScene = useCallback((sceneName) => {\n    socket?.emit('overrideScene', { sceneName });\n  }, [socket]);\n\n  const lockTalent = useCallback((locked) => {\n    socket?.emit('lockTalent', { locked });\n  }, [socket]);\n\n  const togglePause = useCallback(() => {\n    socket?.emit('togglePause');\n  }, [socket]);\n\n  const startShow = useCallback(() => {\n    socket?.emit('startShow');\n  }, [socket]);\n\n  const resetShow = useCallback(() => {\n    socket?.emit('resetShow');\n  }, [socket]);\n\n  const triggerGraphic = useCallback((graphic, data = {}) => {\n    socket?.emit('triggerGraphic', { graphic, data });\n  }, [socket]);\n\n  const clearGraphic = useCallback(() => {\n    socket?.emit('clearGraphic');\n  }, [socket]);\n\n  // Camera control functions\n  const reassignApparatus = useCallback((cameraId, apparatus, assignedBy = 'producer') => {\n    socket?.emit('reassignApparatus', { cameraId, apparatus, assignedBy });\n  }, [socket]);\n\n  const verifyCamera = useCallback((cameraId, verifiedBy = 'producer') => {\n    socket?.emit('verifyCamera', { cameraId, verifiedBy });\n  }, [socket]);\n\n  const clearFallback = useCallback((cameraId) => {\n    socket?.emit('clearFallback', { cameraId });\n  }, [socket]);\n\n  const resetVerifications = useCallback(() => {\n    socket?.emit('resetVerifications');\n  }, [socket]);\n\n  const overrideCamera = useCallback((cameraId, triggeredBy = 'producer') => {\n    socket?.emit('overrideCamera', { cameraId, triggeredBy });\n  }, [socket]);\n\n  // Timesheet control functions\n  const loadRundown = useCallback(() => {\n    console.log('ShowContext: Loading rundown for competition', compId);\n    socket?.emit('loadRundown', { compId });\n  }, [socket, compId]);\n\n  const startTimesheetShow = useCallback(() => {\n    socket?.emit('startTimesheetShow');\n  }, [socket]);\n\n  const stopTimesheetShow = useCallback(() => {\n    socket?.emit('stopTimesheetShow');\n  }, [socket]);\n\n  const pauseTimesheetShow = useCallback(() => {\n    socket?.emit('pauseTimesheetShow');\n  }, [socket]);\n\n  const resumeTimesheetShow = useCallback(() => {\n    socket?.emit('resumeTimesheetShow');\n  }, [socket]);\n\n  const advanceTimesheetSegment = useCallback((advancedBy = 'producer') => {\n    socket?.emit('advanceSegment', { advancedBy });\n  }, [socket]);\n\n  const previousTimesheetSegment = useCallback((triggeredBy = 'producer') => {\n    socket?.emit('previousSegment', { triggeredBy });\n  }, [socket]);\n\n  const goToTimesheetSegment = useCallback((segmentId, triggeredBy = 'producer') => {\n    socket?.emit('goToSegment', { segmentId, triggeredBy });\n  }, [socket]);\n\n  const overrideTimesheetScene = useCallback((sceneName, triggeredBy = 'producer') => {\n    socket?.emit('timesheetOverrideScene', { sceneName, triggeredBy });\n  }, [socket]);\n\n  const overrideTimesheetCamera = useCallback((cameraId, triggeredBy = 'producer') => {\n    socket?.emit('overrideCamera', { cameraId, triggeredBy });\n  }, [socket]);\n\n  const getTimesheetOverrides = useCallback(() => {\n    return overrideLog;\n  }, [overrideLog]);\n\n  const clearOverrideLog = useCallback(() => {\n    setOverrideLog([]);\n  }, []);\n\n  const setRehearsalMode = useCallback((enabled) => {\n    console.log(`ShowContext: Setting rehearsal mode to ${enabled} for competition`, compId);\n    socket?.emit('setRehearsalMode', { enabled, compId });\n  }, [socket, compId]);\n\n  const clearRundownModified = useCallback(() => {\n    setTimesheetState(prev => ({\n      ...prev,\n      rundownModified: false,\n      rundownModifiedSummary: null\n    }));\n  }, []);\n\n  // AI Suggestions function (Phase D - AI Suggestions)\n  // Returns a promise that resolves with the suggestions result\n  const getAISuggestions = useCallback((options = {}) => {\n    return new Promise((resolve, reject) => {\n      if (!socket) {\n        reject(new Error('Socket not connected'));\n        return;\n      }\n\n      console.log('ShowContext: Requesting AI suggestions for competition', compId);\n\n      // Set up one-time listener for the result\n      const handleResult = (result) => {\n        socket.off('aiSuggestionsResult', handleResult);\n        if (result.success) {\n          resolve(result);\n        } else {\n          reject(new Error(result.error || 'Failed to get AI suggestions'));\n        }\n      };\n\n      socket.on('aiSuggestionsResult', handleResult);\n\n      // Emit the request\n      socket.emit('getAISuggestions', { compId, options });\n\n      // Timeout after 30 seconds\n      setTimeout(() => {\n        socket.off('aiSuggestionsResult', handleResult);\n        reject(new Error('AI suggestions request timed out'));\n      }, 30000);\n    });\n  }, [socket, compId]);\n\n  const value = {\n    // Connection info\n    socketUrl,\n    compId,\n    socket,\n    connected,\n    clientId,\n    state,\n    elapsed,\n    error,\n    identify,\n    advance,\n    previous,\n    jumpTo,\n    overrideScene,\n    lockTalent,\n    togglePause,\n    startShow,\n    resetShow,\n    triggerGraphic,\n    clearGraphic,\n    // Camera state\n    cameraHealth,\n    cameraRuntimeState,\n    activeFallbacks,\n    // Camera control functions\n    reassignApparatus,\n    verifyCamera,\n    clearFallback,\n    resetVerifications,\n    overrideCamera,\n    // Timesheet state\n    timesheetState,\n    overrideLog,\n    // Timesheet control functions\n    loadRundown,\n    startTimesheetShow,\n    stopTimesheetShow,\n    pauseTimesheetShow,\n    resumeTimesheetShow,\n    advanceTimesheetSegment,\n    previousTimesheetSegment,\n    goToTimesheetSegment,\n    overrideTimesheetScene,\n    overrideTimesheetCamera,\n    getTimesheetOverrides,\n    clearOverrideLog,\n    setRehearsalMode,\n    clearRundownModified,\n    // AI Suggestions\n    getAISuggestions\n  };\n\n  return (\n    <ShowContext.Provider value={value}>\n      {children}\n    </ShowContext.Provider>\n  );\n}\n\nexport function useShow() {\n  const context = useContext(ShowContext);\n  if (!context) {\n    throw new Error('useShow must be used within a ShowProvider');\n  }\n  return context;\n}\n","numLines":703,"startLine":1,"totalLines":703}}}
