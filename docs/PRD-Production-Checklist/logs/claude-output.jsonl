{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0147FdMoLrvfJLHgcpbSSn1K","type":"tool_result","content":"     1→/**\n     2→ * ChecklistPage - Production Checklist for Competition\n     3→ *\n     4→ * Main page for the production checklist system. Shows all pre-flight items\n     5→ * a producer must complete before going live, grouped by phase and category.\n     6→ *\n     7→ * Features:\n     8→ * - Progress bar showing overall completion\n     9→ * - Phase tabs (Setup, Pre-Prod, 2hr Before, 1hr Before)\n    10→ * - Collapsible categories\n    11→ * - Auto-validated items (show system state)\n    12→ * - Manual items (checkboxes)\n    13→ * - Skeleton loading states\n    14→ *\n    15→ * Reference: docs/PRD-Production-Checklist/PRD-Production-Checklist-2026-01-24.md\n    16→ */\n    17→\n    18→import { useState, useMemo } from 'react';\n    19→import { Link } from 'react-router-dom';\n    20→import toast from 'react-hot-toast';\n    21→import {\n    22→  ChevronDownIcon,\n    23→  ChevronRightIcon,\n    24→  CheckCircleIcon,\n    25→  ExclamationTriangleIcon,\n    26→  XCircleIcon,\n    27→  ClockIcon,\n    28→  ArrowPathIcon,\n    29→} from '@heroicons/react/24/solid';\n    30→import {\n    31→  ArrowLeftIcon,\n    32→} from '@heroicons/react/24/outline';\n    33→import { useCompetition } from '../context/CompetitionContext';\n    34→import { useProductionChecklist } from '../hooks/useProductionChecklist';\n    35→\n    36→/**\n    37→ * Status icon component for checklist items\n    38→ */\n    39→function StatusIcon({ status, className = '' }) {\n    40→  const iconClass = `w-5 h-5 ${className}`;\n    41→\n    42→  switch (status) {\n    43→    case 'complete':\n    44→      return <CheckCircleIcon className={`${iconClass} text-green-500`} />;\n    45→    case 'warning':\n    46→      return <ExclamationTriangleIcon className={`${iconClass} text-amber-500`} />;\n    47→    case 'error':\n    48→      return <XCircleIcon className={`${iconClass} text-red-500`} />;\n    49→    case 'checking':\n    50→      return <ArrowPathIcon className={`${iconClass} text-zinc-500 animate-spin`} />;\n    51→    default:\n    52→      return <div className={`${iconClass} rounded-full border-2 border-zinc-500`} />;\n    53→  }\n    54→}\n    55→\n    56→/**\n    57→ * Skeleton loading component for checklist items\n    58→ */\n    59→function ChecklistSkeleton() {\n    60→  return (\n    61→    <div className=\"space-y-6 animate-pulse\">\n    62→      {/* Progress bar skeleton */}\n    63→      <div className=\"bg-zinc-800 rounded-lg p-4\">\n    64→        <div className=\"h-4 bg-zinc-700 rounded w-1/3 mb-3\" />\n    65→        <div className=\"h-3 bg-zinc-700 rounded-full w-full mb-2\" />\n    66→        <div className=\"flex gap-4\">\n    67→          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n    68→          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n    69→          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n    70→        </div>\n    71→      </div>\n    72→\n    73→      {/* Phase tabs skeleton */}\n    74→      <div className=\"flex gap-2\">\n    75→        {[1, 2, 3, 4].map(i => (\n    76→          <div key={i} className=\"h-10 bg-zinc-700 rounded-lg w-28\" />\n    77→        ))}\n    78→      </div>\n    79→\n    80→      {/* Category skeletons */}\n    81→      {[1, 2, 3].map(i => (\n    82→        <div key={i} className=\"bg-zinc-800 rounded-lg p-4\">\n    83→          <div className=\"h-5 bg-zinc-700 rounded w-48 mb-4\" />\n    84→          <div className=\"space-y-3\">\n    85→            {[1, 2, 3, 4].map(j => (\n    86→              <div key={j} className=\"flex items-center gap-3\">\n    87→                <div className=\"w-5 h-5 bg-zinc-700 rounded-full\" />\n    88→                <div className=\"h-4 bg-zinc-700 rounded flex-1\" />\n    89→              </div>\n    90→            ))}\n    91→          </div>\n    92→        </div>\n    93→      ))}\n    94→    </div>\n    95→  );\n    96→}\n    97→\n    98→/**\n    99→ * Progress bar component showing completion stats\n   100→ */\n   101→function ChecklistProgress({ summary }) {\n   102→  const { total, complete, warnings, errors, pending, percentage } = summary;\n   103→\n   104→  return (\n   105→    <div className=\"bg-zinc-800 rounded-lg p-4\">\n   106→      <div className=\"flex items-center justify-between mb-2\">\n   107→        <span className=\"text-lg font-semibold text-white\">\n   108→          {percentage}% Complete\n   109→        </span>\n   110→        <span className=\"text-sm text-zinc-400\">\n   111→          {complete}/{total} items\n   112→        </span>\n   113→      </div>\n   114→\n   115→      {/* Progress bar */}\n   116→      <div className=\"h-3 bg-zinc-700 rounded-full overflow-hidden mb-3\">\n   117→        <div\n   118→          className=\"h-full bg-green-500 transition-all duration-300\"\n   119→          style={{ width: `${percentage}%` }}\n   120→        />\n   121→      </div>\n   122→\n   123→      {/* Stats row */}\n   124→      <div className=\"flex gap-4 text-sm\">\n   125→        <span className=\"flex items-center gap-1.5\">\n   126→          <CheckCircleIcon className=\"w-4 h-4 text-green-500\" />\n   127→          <span className=\"text-zinc-300\">{complete} complete</span>\n   128→        </span>\n   129→        {warnings > 0 && (\n   130→          <span className=\"flex items-center gap-1.5\">\n   131→            <ExclamationTriangleIcon className=\"w-4 h-4 text-amber-500\" />\n   132→            <span className=\"text-zinc-300\">{warnings} warnings</span>\n   133→          </span>\n   134→        )}\n   135→        {errors > 0 && (\n   136→          <span className=\"flex items-center gap-1.5\">\n   137→            <XCircleIcon className=\"w-4 h-4 text-red-500\" />\n   138→            <span className=\"text-zinc-300\">{errors} errors</span>\n   139→          </span>\n   140→        )}\n   141→        {pending > 0 && (\n   142→          <span className=\"flex items-center gap-1.5\">\n   143→            <ClockIcon className=\"w-4 h-4 text-zinc-500\" />\n   144→            <span className=\"text-zinc-300\">{pending} pending</span>\n   145→          </span>\n   146→        )}\n   147→      </div>\n   148→    </div>\n   149→  );\n   150→}\n   151→\n   152→/**\n   153→ * Phase tab component\n   154→ */\n   155→function PhaseTab({ phase, isActive, onClick, itemCounts }) {\n   156→  // Calculate phase completion status\n   157→  const { complete, total } = itemCounts;\n   158→  const percentage = total > 0 ? Math.round((complete / total) * 100) : 0;\n   159→\n   160→  let statusIndicator;\n   161→  if (percentage === 100) {\n   162→    statusIndicator = <span className=\"text-green-500\">✓</span>;\n   163→  } else if (percentage > 0) {\n   164→    statusIndicator = <span className=\"text-amber-500\">◐</span>;\n   165→  } else {\n   166→    statusIndicator = <span className=\"text-zinc-500\">○</span>;\n   167→  }\n   168→\n   169→  return (\n   170→    <button\n   171→      onClick={onClick}\n   172→      className={`px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2 ${\n   173→        isActive\n   174→          ? 'bg-blue-600 text-white'\n   175→          : 'bg-zinc-800 text-zinc-300 hover:bg-zinc-700'\n   176→      }`}\n   177→    >\n   178→      {statusIndicator}\n   179→      <span>{phase.shortName}</span>\n   180→    </button>\n   181→  );\n   182→}\n   183→\n   184→/**\n   185→ * Category section component (collapsible)\n   186→ */\n   187→function ChecklistCategory({ category, expanded, onToggle, onItemToggle }) {\n   188→  const completeCount = category.items.filter(i => i.status === 'complete').length;\n   189→\n   190→  return (\n   191→    <div className=\"bg-zinc-800 rounded-lg overflow-hidden\">\n   192→      {/* Category header */}\n   193→      <button\n   194→        onClick={onToggle}\n   195→        className=\"w-full flex items-center justify-between px-4 py-3 hover:bg-zinc-700 transition-colors\"\n   196→      >\n   197→        <div className=\"flex items-center gap-3\">\n   198→          {expanded ? (\n   199→            <ChevronDownIcon className=\"w-5 h-5 text-zinc-400\" />\n   200→          ) : (\n   201→            <ChevronRightIcon className=\"w-5 h-5 text-zinc-400\" />\n   202→          )}\n   203→          <span className=\"font-medium text-white\">{category.name}</span>\n   204→        </div>\n   205→        <span className=\"text-sm text-zinc-400\">\n   206→          {completeCount}/{category.items.length}\n   207→        </span>\n   208→      </button>\n   209→\n   210→      {/* Items list */}\n   211→      {expanded && (\n   212→        <div className=\"px-4 pb-3 space-y-1\">\n   213→          {category.items.map(item => (\n   214→            <ChecklistItem\n   215→              key={item.id}\n   216→              item={item}\n   217→              onToggle={() => onItemToggle(item.id)}\n   218→            />\n   219→          ))}\n   220→        </div>\n   221→      )}\n   222→    </div>\n   223→  );\n   224→}\n   225→\n   226→/**\n   227→ * Individual checklist item component\n   228→ */\n   229→function ChecklistItem({ item, onToggle }) {\n   230→  const isManual = item.type === 'manual';\n   231→  const isClickable = isManual;\n   232→\n   233→  return (\n   234→    <div\n   235→      className={`flex items-center gap-3 py-2 px-2 rounded ${\n   236→        isClickable ? 'hover:bg-zinc-700 cursor-pointer' : ''\n   237→      }`}\n   238→      onClick={isClickable ? onToggle : undefined}\n   239→    >\n   240→      {/* Status icon or checkbox */}\n   241→      {isManual ? (\n   242→        <input\n   243→          type=\"checkbox\"\n   244→          checked={item.checked}\n   245→          onChange={onToggle}\n   246→          onClick={e => e.stopPropagation()}\n   247→          className=\"w-5 h-5 rounded border-2 border-zinc-500 bg-transparent checked:bg-green-500 checked:border-green-500 cursor-pointer\"\n   248→        />\n   249→      ) : (\n   250→        <StatusIcon status={item.status} />\n   251→      )}\n   252→\n   253→      {/* Item name */}\n   254→      <span className={`flex-1 ${item.status === 'complete' ? 'text-zinc-300' : 'text-white'}`}>\n   255→        {item.name}\n   256→      </span>\n   257→\n   258→      {/* Detail text for auto-validated items */}\n   259→      {item.detail && (\n   260→        <span className=\"text-sm text-zinc-500\">{item.detail}</span>\n   261→      )}\n   262→\n   263→      {/* Fix link for failed auto items */}\n   264→      {item.type === 'auto' && item.status === 'error' && item.fixLink && (\n   265→        <Link\n   266→          to={item.fixLink}\n   267→          onClick={e => e.stopPropagation()}\n   268→          className=\"text-sm text-blue-400 hover:text-blue-300\"\n   269→        >\n   270→          Fix\n   271→        </Link>\n   272→      )}\n   273→    </div>\n   274→  );\n   275→}\n   276→\n   277→/**\n   278→ * Main ChecklistPage component\n   279→ */\n   280→export default function ChecklistPage() {\n   281→  const { compId, competitionConfig } = useCompetition();\n   282→  const {\n   283→    phases,\n   284→    summary,\n   285→    toggleItem,\n   286→    loading,\n   287→    lastUpdated,\n   288→  } = useProductionChecklist();\n   289→\n   290→  // Active phase tab\n   291→  const [activePhaseId, setActivePhaseId] = useState('setup');\n   292→\n   293→  // Expanded categories (all expanded by default)\n   294→  const [expandedCategories, setExpandedCategories] = useState(new Set());\n   295→\n   296→  // Initialize expanded categories when phases load\n   297→  useMemo(() => {\n   298→    if (phases?.length && expandedCategories.size === 0) {\n   299→      const allCategories = new Set();\n   300→      phases.forEach(phase => {\n   301→        phase.categories.forEach(cat => {\n   302→          allCategories.add(cat.id);\n   303→        });\n   304→      });\n   305→      setExpandedCategories(allCategories);\n   306→    }\n   307→  }, [phases]);\n   308→\n   309→  // Get active phase\n   310→  const activePhase = phases?.find(p => p.id === activePhaseId) || phases?.[0];\n   311→\n   312→  // Calculate item counts per phase\n   313→  const phaseItemCounts = useMemo(() => {\n   314→    const counts = {};\n   315→    phases?.forEach(phase => {\n   316→      let complete = 0;\n   317→      let total = 0;\n   318→      phase.categories.forEach(cat => {\n   319→        cat.items.forEach(item => {\n   320→          total++;\n   321→          if (item.status === 'complete') complete++;\n   322→        });\n   323→      });\n   324→      counts[phase.id] = { complete, total };\n   325→    });\n   326→    return counts;\n   327→  }, [phases]);\n   328→\n   329→  // Toggle category expansion\n   330→  const toggleCategory = (categoryId) => {\n   331→    setExpandedCategories(prev => {\n   332→      const next = new Set(prev);\n   333→      if (next.has(categoryId)) {\n   334→        next.delete(categoryId);\n   335→      } else {\n   336→        next.add(categoryId);\n   337→      }\n   338→      return next;\n   339→    });\n   340→  };\n   341→\n   342→  // Handle item toggle with error handling\n   343→  const handleItemToggle = async (itemId) => {\n   344→    try {\n   345→      await toggleItem(itemId);\n   346→    } catch (error) {\n   347→      toast.error('Failed to update checklist item');\n   348→    }\n   349→  };\n   350→\n   351→  // Format last updated timestamp\n   352→  const formattedLastUpdated = lastUpdated\n   353→    ? new Date(lastUpdated).toLocaleString()\n   354→    : null;\n   355→\n   356→  return (\n   357→    <div className=\"min-h-screen bg-zinc-900 text-white\">\n   358→      {/* Header */}\n   359→      <header className=\"bg-zinc-800 border-b border-zinc-700 px-6 py-4\">\n   360→        <div className=\"flex items-center justify-between\">\n   361→          <div className=\"flex items-center gap-4\">\n   362→            <Link\n   363→              to={`/${compId}/producer`}\n   364→              className=\"text-zinc-400 hover:text-white transition-colors\"\n   365→            >\n   366→              <ArrowLeftIcon className=\"w-5 h-5\" />\n   367→            </Link>\n   368→            <div>\n   369→              <h1 className=\"text-xl font-bold\">Production Checklist</h1>\n   370→              <p className=\"text-sm text-zinc-400\">\n   371→                {competitionConfig?.eventName || 'Competition'}\n   372→              </p>\n   373→            </div>\n   374→          </div>\n   375→\n   376→          {formattedLastUpdated && (\n   377→            <span className=\"text-sm text-zinc-500\">\n   378→              Last updated: {formattedLastUpdated}\n   379→            </span>\n   380→          )}\n   381→        </div>\n   382→      </header>\n   383→\n   384→      {/* Main content */}\n   385→      <main className=\"max-w-5xl mx-auto px-6 py-6\">\n   386→        {loading ? (\n   387→          <ChecklistSkeleton />\n   388→        ) : (\n   389→          <div className=\"space-y-6\">\n   390→            {/* Progress bar */}\n   391→            <ChecklistProgress summary={summary} />\n   392→\n   393→            {/* Phase tabs */}\n   394→            <div className=\"flex gap-2 flex-wrap\">\n   395→              {phases?.map(phase => (\n   396→                <PhaseTab\n   397→                  key={phase.id}\n   398→                  phase={phase}\n   399→                  isActive={phase.id === activePhaseId}\n   400→                  onClick={() => setActivePhaseId(phase.id)}\n   401→                  itemCounts={phaseItemCounts[phase.id] || { complete: 0, total: 0 }}\n   402→                />\n   403→              ))}\n   404→            </div>\n   405→\n   406→            {/* Categories for active phase */}\n   407→            <div className=\"space-y-4\">\n   408→              {activePhase?.categories.map(category => (\n   409→                <ChecklistCategory\n   410→                  key={category.id}\n   411→                  category={category}\n   412→                  expanded={expandedCategories.has(category.id)}\n   413→                  onToggle={() => toggleCategory(category.id)}\n   414→                  onItemToggle={handleItemToggle}\n   415→                />\n   416→              ))}\n   417→            </div>\n   418→          </div>\n   419→        )}\n   420→      </main>\n   421→    </div>\n   422→  );\n   423→}\n   424→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3d982b9f-b5e1-47e1-88eb-2bc924db4a7f","uuid":"c2bbca42-7003-4a3f-ab30-37fc99bd79ae","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/pages/ChecklistPage.jsx","content":"/**\n * ChecklistPage - Production Checklist for Competition\n *\n * Main page for the production checklist system. Shows all pre-flight items\n * a producer must complete before going live, grouped by phase and category.\n *\n * Features:\n * - Progress bar showing overall completion\n * - Phase tabs (Setup, Pre-Prod, 2hr Before, 1hr Before)\n * - Collapsible categories\n * - Auto-validated items (show system state)\n * - Manual items (checkboxes)\n * - Skeleton loading states\n *\n * Reference: docs/PRD-Production-Checklist/PRD-Production-Checklist-2026-01-24.md\n */\n\nimport { useState, useMemo } from 'react';\nimport { Link } from 'react-router-dom';\nimport toast from 'react-hot-toast';\nimport {\n  ChevronDownIcon,\n  ChevronRightIcon,\n  CheckCircleIcon,\n  ExclamationTriangleIcon,\n  XCircleIcon,\n  ClockIcon,\n  ArrowPathIcon,\n} from '@heroicons/react/24/solid';\nimport {\n  ArrowLeftIcon,\n} from '@heroicons/react/24/outline';\nimport { useCompetition } from '../context/CompetitionContext';\nimport { useProductionChecklist } from '../hooks/useProductionChecklist';\n\n/**\n * Status icon component for checklist items\n */\nfunction StatusIcon({ status, className = '' }) {\n  const iconClass = `w-5 h-5 ${className}`;\n\n  switch (status) {\n    case 'complete':\n      return <CheckCircleIcon className={`${iconClass} text-green-500`} />;\n    case 'warning':\n      return <ExclamationTriangleIcon className={`${iconClass} text-amber-500`} />;\n    case 'error':\n      return <XCircleIcon className={`${iconClass} text-red-500`} />;\n    case 'checking':\n      return <ArrowPathIcon className={`${iconClass} text-zinc-500 animate-spin`} />;\n    default:\n      return <div className={`${iconClass} rounded-full border-2 border-zinc-500`} />;\n  }\n}\n\n/**\n * Skeleton loading component for checklist items\n */\nfunction ChecklistSkeleton() {\n  return (\n    <div className=\"space-y-6 animate-pulse\">\n      {/* Progress bar skeleton */}\n      <div className=\"bg-zinc-800 rounded-lg p-4\">\n        <div className=\"h-4 bg-zinc-700 rounded w-1/3 mb-3\" />\n        <div className=\"h-3 bg-zinc-700 rounded-full w-full mb-2\" />\n        <div className=\"flex gap-4\">\n          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n        </div>\n      </div>\n\n      {/* Phase tabs skeleton */}\n      <div className=\"flex gap-2\">\n        {[1, 2, 3, 4].map(i => (\n          <div key={i} className=\"h-10 bg-zinc-700 rounded-lg w-28\" />\n        ))}\n      </div>\n\n      {/* Category skeletons */}\n      {[1, 2, 3].map(i => (\n        <div key={i} className=\"bg-zinc-800 rounded-lg p-4\">\n          <div className=\"h-5 bg-zinc-700 rounded w-48 mb-4\" />\n          <div className=\"space-y-3\">\n            {[1, 2, 3, 4].map(j => (\n              <div key={j} className=\"flex items-center gap-3\">\n                <div className=\"w-5 h-5 bg-zinc-700 rounded-full\" />\n                <div className=\"h-4 bg-zinc-700 rounded flex-1\" />\n              </div>\n            ))}\n          </div>\n        </div>\n      ))}\n    </div>\n  );\n}\n\n/**\n * Progress bar component showing completion stats\n */\nfunction ChecklistProgress({ summary }) {\n  const { total, complete, warnings, errors, pending, percentage } = summary;\n\n  return (\n    <div className=\"bg-zinc-800 rounded-lg p-4\">\n      <div className=\"flex items-center justify-between mb-2\">\n        <span className=\"text-lg font-semibold text-white\">\n          {percentage}% Complete\n        </span>\n        <span className=\"text-sm text-zinc-400\">\n          {complete}/{total} items\n        </span>\n      </div>\n\n      {/* Progress bar */}\n      <div className=\"h-3 bg-zinc-700 rounded-full overflow-hidden mb-3\">\n        <div\n          className=\"h-full bg-green-500 transition-all duration-300\"\n          style={{ width: `${percentage}%` }}\n        />\n      </div>\n\n      {/* Stats row */}\n      <div className=\"flex gap-4 text-sm\">\n        <span className=\"flex items-center gap-1.5\">\n          <CheckCircleIcon className=\"w-4 h-4 text-green-500\" />\n          <span className=\"text-zinc-300\">{complete} complete</span>\n        </span>\n        {warnings > 0 && (\n          <span className=\"flex items-center gap-1.5\">\n            <ExclamationTriangleIcon className=\"w-4 h-4 text-amber-500\" />\n            <span className=\"text-zinc-300\">{warnings} warnings</span>\n          </span>\n        )}\n        {errors > 0 && (\n          <span className=\"flex items-center gap-1.5\">\n            <XCircleIcon className=\"w-4 h-4 text-red-500\" />\n            <span className=\"text-zinc-300\">{errors} errors</span>\n          </span>\n        )}\n        {pending > 0 && (\n          <span className=\"flex items-center gap-1.5\">\n            <ClockIcon className=\"w-4 h-4 text-zinc-500\" />\n            <span className=\"text-zinc-300\">{pending} pending</span>\n          </span>\n        )}\n      </div>\n    </div>\n  );\n}\n\n/**\n * Phase tab component\n */\nfunction PhaseTab({ phase, isActive, onClick, itemCounts }) {\n  // Calculate phase completion status\n  const { complete, total } = itemCounts;\n  const percentage = total > 0 ? Math.round((complete / total) * 100) : 0;\n\n  let statusIndicator;\n  if (percentage === 100) {\n    statusIndicator = <span className=\"text-green-500\">✓</span>;\n  } else if (percentage > 0) {\n    statusIndicator = <span className=\"text-amber-500\">◐</span>;\n  } else {\n    statusIndicator = <span className=\"text-zinc-500\">○</span>;\n  }\n\n  return (\n    <button\n      onClick={onClick}\n      className={`px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2 ${\n        isActive\n          ? 'bg-blue-600 text-white'\n          : 'bg-zinc-800 text-zinc-300 hover:bg-zinc-700'\n      }`}\n    >\n      {statusIndicator}\n      <span>{phase.shortName}</span>\n    </button>\n  );\n}\n\n/**\n * Category section component (collapsible)\n */\nfunction ChecklistCategory({ category, expanded, onToggle, onItemToggle }) {\n  const completeCount = category.items.filter(i => i.status === 'complete').length;\n\n  return (\n    <div className=\"bg-zinc-800 rounded-lg overflow-hidden\">\n      {/* Category header */}\n      <button\n        onClick={onToggle}\n        className=\"w-full flex items-center justify-between px-4 py-3 hover:bg-zinc-700 transition-colors\"\n      >\n        <div className=\"flex items-center gap-3\">\n          {expanded ? (\n            <ChevronDownIcon className=\"w-5 h-5 text-zinc-400\" />\n          ) : (\n            <ChevronRightIcon className=\"w-5 h-5 text-zinc-400\" />\n          )}\n          <span className=\"font-medium text-white\">{category.name}</span>\n        </div>\n        <span className=\"text-sm text-zinc-400\">\n          {completeCount}/{category.items.length}\n        </span>\n      </button>\n\n      {/* Items list */}\n      {expanded && (\n        <div className=\"px-4 pb-3 space-y-1\">\n          {category.items.map(item => (\n            <ChecklistItem\n              key={item.id}\n              item={item}\n              onToggle={() => onItemToggle(item.id)}\n            />\n          ))}\n        </div>\n      )}\n    </div>\n  );\n}\n\n/**\n * Individual checklist item component\n */\nfunction ChecklistItem({ item, onToggle }) {\n  const isManual = item.type === 'manual';\n  const isClickable = isManual;\n\n  return (\n    <div\n      className={`flex items-center gap-3 py-2 px-2 rounded ${\n        isClickable ? 'hover:bg-zinc-700 cursor-pointer' : ''\n      }`}\n      onClick={isClickable ? onToggle : undefined}\n    >\n      {/* Status icon or checkbox */}\n      {isManual ? (\n        <input\n          type=\"checkbox\"\n          checked={item.checked}\n          onChange={onToggle}\n          onClick={e => e.stopPropagation()}\n          className=\"w-5 h-5 rounded border-2 border-zinc-500 bg-transparent checked:bg-green-500 checked:border-green-500 cursor-pointer\"\n        />\n      ) : (\n        <StatusIcon status={item.status} />\n      )}\n\n      {/* Item name */}\n      <span className={`flex-1 ${item.status === 'complete' ? 'text-zinc-300' : 'text-white'}`}>\n        {item.name}\n      </span>\n\n      {/* Detail text for auto-validated items */}\n      {item.detail && (\n        <span className=\"text-sm text-zinc-500\">{item.detail}</span>\n      )}\n\n      {/* Fix link for failed auto items */}\n      {item.type === 'auto' && item.status === 'error' && item.fixLink && (\n        <Link\n          to={item.fixLink}\n          onClick={e => e.stopPropagation()}\n          className=\"text-sm text-blue-400 hover:text-blue-300\"\n        >\n          Fix\n        </Link>\n      )}\n    </div>\n  );\n}\n\n/**\n * Main ChecklistPage component\n */\nexport default function ChecklistPage() {\n  const { compId, competitionConfig } = useCompetition();\n  const {\n    phases,\n    summary,\n    toggleItem,\n    loading,\n    lastUpdated,\n  } = useProductionChecklist();\n\n  // Active phase tab\n  const [activePhaseId, setActivePhaseId] = useState('setup');\n\n  // Expanded categories (all expanded by default)\n  const [expandedCategories, setExpandedCategories] = useState(new Set());\n\n  // Initialize expanded categories when phases load\n  useMemo(() => {\n    if (phases?.length && expandedCategories.size === 0) {\n      const allCategories = new Set();\n      phases.forEach(phase => {\n        phase.categories.forEach(cat => {\n          allCategories.add(cat.id);\n        });\n      });\n      setExpandedCategories(allCategories);\n    }\n  }, [phases]);\n\n  // Get active phase\n  const activePhase = phases?.find(p => p.id === activePhaseId) || phases?.[0];\n\n  // Calculate item counts per phase\n  const phaseItemCounts = useMemo(() => {\n    const counts = {};\n    phases?.forEach(phase => {\n      let complete = 0;\n      let total = 0;\n      phase.categories.forEach(cat => {\n        cat.items.forEach(item => {\n          total++;\n          if (item.status === 'complete') complete++;\n        });\n      });\n      counts[phase.id] = { complete, total };\n    });\n    return counts;\n  }, [phases]);\n\n  // Toggle category expansion\n  const toggleCategory = (categoryId) => {\n    setExpandedCategories(prev => {\n      const next = new Set(prev);\n      if (next.has(categoryId)) {\n        next.delete(categoryId);\n      } else {\n        next.add(categoryId);\n      }\n      return next;\n    });\n  };\n\n  // Handle item toggle with error handling\n  const handleItemToggle = async (itemId) => {\n    try {\n      await toggleItem(itemId);\n    } catch (error) {\n      toast.error('Failed to update checklist item');\n    }\n  };\n\n  // Format last updated timestamp\n  const formattedLastUpdated = lastUpdated\n    ? new Date(lastUpdated).toLocaleString()\n    : null;\n\n  return (\n    <div className=\"min-h-screen bg-zinc-900 text-white\">\n      {/* Header */}\n      <header className=\"bg-zinc-800 border-b border-zinc-700 px-6 py-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-4\">\n            <Link\n              to={`/${compId}/producer`}\n              className=\"text-zinc-400 hover:text-white transition-colors\"\n            >\n              <ArrowLeftIcon className=\"w-5 h-5\" />\n            </Link>\n            <div>\n              <h1 className=\"text-xl font-bold\">Production Checklist</h1>\n              <p className=\"text-sm text-zinc-400\">\n                {competitionConfig?.eventName || 'Competition'}\n              </p>\n            </div>\n          </div>\n\n          {formattedLastUpdated && (\n            <span className=\"text-sm text-zinc-500\">\n              Last updated: {formattedLastUpdated}\n            </span>\n          )}\n        </div>\n      </header>\n\n      {/* Main content */}\n      <main className=\"max-w-5xl mx-auto px-6 py-6\">\n        {loading ? (\n          <ChecklistSkeleton />\n        ) : (\n          <div className=\"space-y-6\">\n            {/* Progress bar */}\n            <ChecklistProgress summary={summary} />\n\n            {/* Phase tabs */}\n            <div className=\"flex gap-2 flex-wrap\">\n              {phases?.map(phase => (\n                <PhaseTab\n                  key={phase.id}\n                  phase={phase}\n                  isActive={phase.id === activePhaseId}\n                  onClick={() => setActivePhaseId(phase.id)}\n                  itemCounts={phaseItemCounts[phase.id] || { complete: 0, total: 0 }}\n                />\n              ))}\n            </div>\n\n            {/* Categories for active phase */}\n            <div className=\"space-y-4\">\n              {activePhase?.categories.map(category => (\n                <ChecklistCategory\n                  key={category.id}\n                  category={category}\n                  expanded={expandedCategories.has(category.id)}\n                  onToggle={() => toggleCategory(category.id)}\n                  onItemToggle={handleItemToggle}\n                />\n              ))}\n            </div>\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}\n","numLines":424,"startLine":1,"totalLines":424}}}
