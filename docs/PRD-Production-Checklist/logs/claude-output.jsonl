{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014TTQ6WtMmUz82zrFR3Xa4Q","type":"tool_result","content":"     1→/**\n     2→ * ChecklistPage - Production Checklist for Competition\n     3→ *\n     4→ * Main page for the production checklist system. Shows all pre-flight items\n     5→ * a producer must complete before going live, grouped by phase and category.\n     6→ *\n     7→ * Features:\n     8→ * - Progress bar showing overall completion\n     9→ * - Phase tabs (Setup, Pre-Prod, 2hr Before, 1hr Before)\n    10→ * - Collapsible categories\n    11→ * - Auto-validated items (show system state)\n    12→ * - Manual items (checkboxes)\n    13→ * - Skeleton loading states\n    14→ *\n    15→ * Reference: docs/PRD-Production-Checklist/PRD-Production-Checklist-2026-01-24.md\n    16→ */\n    17→\n    18→import { useState, useMemo, useCallback } from 'react';\n    19→import { Link } from 'react-router-dom';\n    20→import toast from 'react-hot-toast';\n    21→import {\n    22→  ChevronDownIcon,\n    23→  ChevronRightIcon,\n    24→  CheckCircleIcon,\n    25→  ExclamationTriangleIcon,\n    26→  XCircleIcon,\n    27→  ClockIcon,\n    28→  ArrowPathIcon,\n    29→} from '@heroicons/react/24/solid';\n    30→import {\n    31→  ArrowLeftIcon,\n    32→  ChatBubbleLeftEllipsisIcon,\n    33→} from '@heroicons/react/24/outline';\n    34→import { useCompetition } from '../context/CompetitionContext';\n    35→import { useProductionChecklist } from '../hooks/useProductionChecklist';\n    36→import TeamContactsPanel from '../components/TeamContactsPanel';\n    37→\n    38→/**\n    39→ * Status icon component for checklist items\n    40→ */\n    41→function StatusIcon({ status, className = '' }) {\n    42→  const iconClass = `w-5 h-5 ${className}`;\n    43→\n    44→  switch (status) {\n    45→    case 'complete':\n    46→      return <CheckCircleIcon className={`${iconClass} text-green-500`} />;\n    47→    case 'warning':\n    48→      return <ExclamationTriangleIcon className={`${iconClass} text-amber-500`} />;\n    49→    case 'error':\n    50→      return <XCircleIcon className={`${iconClass} text-red-500`} />;\n    51→    case 'checking':\n    52→      return <ArrowPathIcon className={`${iconClass} text-zinc-500 animate-spin`} />;\n    53→    default:\n    54→      return <div className={`${iconClass} rounded-full border-2 border-zinc-500`} />;\n    55→  }\n    56→}\n    57→\n    58→/**\n    59→ * Skeleton loading component for checklist items\n    60→ */\n    61→function ChecklistSkeleton() {\n    62→  return (\n    63→    <div className=\"space-y-6 animate-pulse\">\n    64→      {/* Progress bar skeleton */}\n    65→      <div className=\"bg-zinc-800 rounded-lg p-4\">\n    66→        <div className=\"h-4 bg-zinc-700 rounded w-1/3 mb-3\" />\n    67→        <div className=\"h-3 bg-zinc-700 rounded-full w-full mb-2\" />\n    68→        <div className=\"flex gap-4\">\n    69→          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n    70→          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n    71→          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n    72→        </div>\n    73→      </div>\n    74→\n    75→      {/* Phase tabs skeleton */}\n    76→      <div className=\"flex gap-2\">\n    77→        {[1, 2, 3, 4].map(i => (\n    78→          <div key={i} className=\"h-10 bg-zinc-700 rounded-lg w-28\" />\n    79→        ))}\n    80→      </div>\n    81→\n    82→      {/* Category skeletons */}\n    83→      {[1, 2, 3].map(i => (\n    84→        <div key={i} className=\"bg-zinc-800 rounded-lg p-4\">\n    85→          <div className=\"h-5 bg-zinc-700 rounded w-48 mb-4\" />\n    86→          <div className=\"space-y-3\">\n    87→            {[1, 2, 3, 4].map(j => (\n    88→              <div key={j} className=\"flex items-center gap-3\">\n    89→                <div className=\"w-5 h-5 bg-zinc-700 rounded-full\" />\n    90→                <div className=\"h-4 bg-zinc-700 rounded flex-1\" />\n    91→              </div>\n    92→            ))}\n    93→          </div>\n    94→        </div>\n    95→      ))}\n    96→    </div>\n    97→  );\n    98→}\n    99→\n   100→/**\n   101→ * Progress bar component showing completion stats\n   102→ */\n   103→function ChecklistProgress({ summary }) {\n   104→  const { total, complete, warnings, errors, pending, percentage } = summary;\n   105→\n   106→  return (\n   107→    <div className=\"bg-zinc-800 rounded-lg p-4\">\n   108→      <div className=\"flex items-center justify-between mb-2\">\n   109→        <span className=\"text-lg font-semibold text-white\">\n   110→          {percentage}% Complete\n   111→        </span>\n   112→        <span className=\"text-sm text-zinc-400\">\n   113→          {complete}/{total} items\n   114→        </span>\n   115→      </div>\n   116→\n   117→      {/* Progress bar */}\n   118→      <div className=\"h-3 bg-zinc-700 rounded-full overflow-hidden mb-3\">\n   119→        <div\n   120→          className=\"h-full bg-green-500 transition-all duration-300\"\n   121→          style={{ width: `${percentage}%` }}\n   122→        />\n   123→      </div>\n   124→\n   125→      {/* Stats row */}\n   126→      <div className=\"flex gap-4 text-sm\">\n   127→        <span className=\"flex items-center gap-1.5\">\n   128→          <CheckCircleIcon className=\"w-4 h-4 text-green-500\" />\n   129→          <span className=\"text-zinc-300\">{complete} complete</span>\n   130→        </span>\n   131→        {warnings > 0 && (\n   132→          <span className=\"flex items-center gap-1.5\">\n   133→            <ExclamationTriangleIcon className=\"w-4 h-4 text-amber-500\" />\n   134→            <span className=\"text-zinc-300\">{warnings} warnings</span>\n   135→          </span>\n   136→        )}\n   137→        {errors > 0 && (\n   138→          <span className=\"flex items-center gap-1.5\">\n   139→            <XCircleIcon className=\"w-4 h-4 text-red-500\" />\n   140→            <span className=\"text-zinc-300\">{errors} errors</span>\n   141→          </span>\n   142→        )}\n   143→        {pending > 0 && (\n   144→          <span className=\"flex items-center gap-1.5\">\n   145→            <ClockIcon className=\"w-4 h-4 text-zinc-500\" />\n   146→            <span className=\"text-zinc-300\">{pending} pending</span>\n   147→          </span>\n   148→        )}\n   149→      </div>\n   150→    </div>\n   151→  );\n   152→}\n   153→\n   154→/**\n   155→ * Phase tab component\n   156→ */\n   157→function PhaseTab({ phase, isActive, onClick, itemCounts }) {\n   158→  // Calculate phase completion status\n   159→  const { complete, total } = itemCounts;\n   160→  const percentage = total > 0 ? Math.round((complete / total) * 100) : 0;\n   161→\n   162→  let statusIndicator;\n   163→  if (percentage === 100) {\n   164→    statusIndicator = <span className=\"text-green-500\">✓</span>;\n   165→  } else if (percentage > 0) {\n   166→    statusIndicator = <span className=\"text-amber-500\">◐</span>;\n   167→  } else {\n   168→    statusIndicator = <span className=\"text-zinc-500\">○</span>;\n   169→  }\n   170→\n   171→  return (\n   172→    <button\n   173→      onClick={onClick}\n   174→      className={`px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2 ${\n   175→        isActive\n   176→          ? 'bg-blue-600 text-white'\n   177→          : 'bg-zinc-800 text-zinc-300 hover:bg-zinc-700'\n   178→      }`}\n   179→    >\n   180→      {statusIndicator}\n   181→      <span>{phase.shortName}</span>\n   182→    </button>\n   183→  );\n   184→}\n   185→\n   186→/**\n   187→ * Category section component (collapsible)\n   188→ */\n   189→function ChecklistCategory({ category, expanded, onToggle, onItemToggle, onNoteChange }) {\n   190→  const completeCount = category.items.filter(i => i.status === 'complete').length;\n   191→\n   192→  return (\n   193→    <div className=\"bg-zinc-800 rounded-lg overflow-hidden\">\n   194→      {/* Category header */}\n   195→      <button\n   196→        onClick={onToggle}\n   197→        className=\"w-full flex items-center justify-between px-4 py-3 hover:bg-zinc-700 transition-colors\"\n   198→      >\n   199→        <div className=\"flex items-center gap-3\">\n   200→          {expanded ? (\n   201→            <ChevronDownIcon className=\"w-5 h-5 text-zinc-400\" />\n   202→          ) : (\n   203→            <ChevronRightIcon className=\"w-5 h-5 text-zinc-400\" />\n   204→          )}\n   205→          <span className=\"font-medium text-white\">{category.name}</span>\n   206→        </div>\n   207→        <span className=\"text-sm text-zinc-400\">\n   208→          {completeCount}/{category.items.length}\n   209→        </span>\n   210→      </button>\n   211→\n   212→      {/* Items list */}\n   213→      {expanded && (\n   214→        <div className=\"px-4 pb-3 space-y-1\">\n   215→          {category.items.map(item => (\n   216→            <ChecklistItem\n   217→              key={item.id}\n   218→              item={item}\n   219→              onToggle={() => onItemToggle(item.id)}\n   220→              onNoteChange={onNoteChange}\n   221→            />\n   222→          ))}\n   223→        </div>\n   224→      )}\n   225→    </div>\n   226→  );\n   227→}\n   228→\n   229→/**\n   230→ * Individual checklist item component\n   231→ */\n   232→function ChecklistItem({ item, onToggle, onNoteChange }) {\n   233→  const isManual = item.type === 'manual';\n   234→  const isClickable = isManual;\n   235→  const [showNoteInput, setShowNoteInput] = useState(false);\n   236→  const [noteValue, setNoteValue] = useState(item.note || '');\n   237→  const [isSaving, setIsSaving] = useState(false);\n   238→\n   239→  // Handle note save\n   240→  const handleNoteSave = useCallback(async () => {\n   241→    if (noteValue === item.note) {\n   242→      setShowNoteInput(false);\n   243→      return;\n   244→    }\n   245→    setIsSaving(true);\n   246→    try {\n   247→      await onNoteChange(item.id, noteValue);\n   248→      setShowNoteInput(false);\n   249→    } catch (error) {\n   250→      toast.error('Failed to save note');\n   251→    } finally {\n   252→      setIsSaving(false);\n   253→    }\n   254→  }, [noteValue, item.note, item.id, onNoteChange]);\n   255→\n   256→  // Handle key events for note input\n   257→  const handleKeyDown = useCallback((e) => {\n   258→    if (e.key === 'Enter' && !e.shiftKey) {\n   259→      e.preventDefault();\n   260→      handleNoteSave();\n   261→    } else if (e.key === 'Escape') {\n   262→      setNoteValue(item.note || '');\n   263→      setShowNoteInput(false);\n   264→    }\n   265→  }, [handleNoteSave, item.note]);\n   266→\n   267→  return (\n   268→    <div className=\"group\">\n   269→      <div\n   270→        className={`flex items-center gap-3 py-2 px-2 rounded ${\n   271→          isClickable ? 'hover:bg-zinc-700 cursor-pointer' : ''\n   272→        }`}\n   273→        onClick={isClickable ? onToggle : undefined}\n   274→      >\n   275→        {/* Status icon or checkbox */}\n   276→        {isManual ? (\n   277→          <input\n   278→            type=\"checkbox\"\n   279→            checked={item.checked}\n   280→            onChange={onToggle}\n   281→            onClick={e => e.stopPropagation()}\n   282→            className=\"w-5 h-5 rounded border-2 border-zinc-500 bg-transparent checked:bg-green-500 checked:border-green-500 cursor-pointer\"\n   283→          />\n   284→        ) : (\n   285→          <StatusIcon status={item.status} />\n   286→        )}\n   287→\n   288→        {/* Item name */}\n   289→        <span className={`flex-1 ${item.status === 'complete' ? 'text-zinc-300' : 'text-white'}`}>\n   290→          {item.name}\n   291→        </span>\n   292→\n   293→        {/* Note indicator */}\n   294→        {item.note && !showNoteInput && (\n   295→          <button\n   296→            onClick={(e) => {\n   297→              e.stopPropagation();\n   298→              setShowNoteInput(true);\n   299→            }}\n   300→            className=\"text-zinc-400 hover:text-zinc-300\"\n   301→            title={item.note}\n   302→          >\n   303→            <ChatBubbleLeftEllipsisIcon className=\"w-4 h-4\" />\n   304→          </button>\n   305→        )}\n   306→\n   307→        {/* Add note button (visible on hover when no note) */}\n   308→        {!item.note && !showNoteInput && (\n   309→          <button\n   310→            onClick={(e) => {\n   311→              e.stopPropagation();\n   312→              setShowNoteInput(true);\n   313→            }}\n   314→            className=\"text-zinc-600 hover:text-zinc-400 opacity-0 group-hover:opacity-100 transition-opacity text-sm\"\n   315→          >\n   316→            + Note\n   317→          </button>\n   318→        )}\n   319→\n   320→        {/* Detail text for auto-validated items */}\n   321→        {item.detail && (\n   322→          <span className=\"text-sm text-zinc-500\">{item.detail}</span>\n   323→        )}\n   324→\n   325→        {/* Fix link for failed auto items */}\n   326→        {item.type === 'auto' && item.status === 'error' && item.fixLink && (\n   327→          <Link\n   328→            to={item.fixLink}\n   329→            onClick={e => e.stopPropagation()}\n   330→            className=\"text-sm text-blue-400 hover:text-blue-300\"\n   331→          >\n   332→            Fix\n   333→          </Link>\n   334→        )}\n   335→      </div>\n   336→\n   337→      {/* Note input area */}\n   338→      {showNoteInput && (\n   339→        <div className=\"ml-8 mt-1 mb-2 flex gap-2\" onClick={e => e.stopPropagation()}>\n   340→          <input\n   341→            type=\"text\"\n   342→            value={noteValue}\n   343→            onChange={(e) => setNoteValue(e.target.value)}\n   344→            onKeyDown={handleKeyDown}\n   345→            placeholder=\"Add a note...\"\n   346→            autoFocus\n   347→            className=\"flex-1 bg-zinc-700 border border-zinc-600 rounded px-3 py-1.5 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500\"\n   348→          />\n   349→          <button\n   350→            onClick={handleNoteSave}\n   351→            disabled={isSaving}\n   352→            className=\"px-3 py-1.5 bg-blue-600 hover:bg-blue-500 disabled:bg-zinc-600 rounded text-sm text-white transition-colors\"\n   353→          >\n   354→            {isSaving ? '...' : 'Save'}\n   355→          </button>\n   356→          <button\n   357→            onClick={() => {\n   358→              setNoteValue(item.note || '');\n   359→              setShowNoteInput(false);\n   360→            }}\n   361→            className=\"px-3 py-1.5 bg-zinc-700 hover:bg-zinc-600 rounded text-sm text-zinc-300 transition-colors\"\n   362→          >\n   363→            Cancel\n   364→          </button>\n   365→        </div>\n   366→      )}\n   367→\n   368→      {/* Display existing note when not editing */}\n   369→      {item.note && !showNoteInput && (\n   370→        <div\n   371→          className=\"ml-8 text-sm text-zinc-400 italic cursor-pointer hover:text-zinc-300\"\n   372→          onClick={(e) => {\n   373→            e.stopPropagation();\n   374→            setShowNoteInput(true);\n   375→          }}\n   376→        >\n   377→          {item.note}\n   378→        </div>\n   379→      )}\n   380→    </div>\n   381→  );\n   382→}\n   383→\n   384→/**\n   385→ * Main ChecklistPage component\n   386→ */\n   387→export default function ChecklistPage() {\n   388→  const { compId } = useCompetition();\n   389→  const {\n   390→    phases,\n   391→    summary,\n   392→    contacts,\n   393→    teamKeys,\n   394→    toggleItem,\n   395→    updateNote,\n   396→    updateContact,\n   397→    deleteContact,\n   398→    loading,\n   399→    lastUpdated,\n   400→    competitionConfig,\n   401→    teamCount,\n   402→  } = useProductionChecklist();\n   403→\n   404→  // Build team names array for the contacts panel\n   405→  const teamNames = [];\n   406→  for (let i = 1; i <= teamCount; i++) {\n   407→    const name = competitionConfig?.[`team${i}Name`];\n   408→    if (name) {\n   409→      teamNames.push(name);\n   410→    }\n   411→  }\n   412→\n   413→  // Active phase tab\n   414→  const [activePhaseId, setActivePhaseId] = useState('setup');\n   415→\n   416→  // Expanded categories (all expanded by default)\n   417→  const [expandedCategories, setExpandedCategories] = useState(new Set());\n   418→\n   419→  // Initialize expanded categories when phases load\n   420→  useMemo(() => {\n   421→    if (phases?.length && expandedCategories.size === 0) {\n   422→      const allCategories = new Set();\n   423→      phases.forEach(phase => {\n   424→        phase.categories.forEach(cat => {\n   425→          allCategories.add(cat.id);\n   426→        });\n   427→      });\n   428→      setExpandedCategories(allCategories);\n   429→    }\n   430→  }, [phases]);\n   431→\n   432→  // Get active phase\n   433→  const activePhase = phases?.find(p => p.id === activePhaseId) || phases?.[0];\n   434→\n   435→  // Calculate item counts per phase\n   436→  const phaseItemCounts = useMemo(() => {\n   437→    const counts = {};\n   438→    phases?.forEach(phase => {\n   439→      let complete = 0;\n   440→      let total = 0;\n   441→      phase.categories.forEach(cat => {\n   442→        cat.items.forEach(item => {\n   443→          total++;\n   444→          if (item.status === 'complete') complete++;\n   445→        });\n   446→      });\n   447→      counts[phase.id] = { complete, total };\n   448→    });\n   449→    return counts;\n   450→  }, [phases]);\n   451→\n   452→  // Toggle category expansion\n   453→  const toggleCategory = (categoryId) => {\n   454→    setExpandedCategories(prev => {\n   455→      const next = new Set(prev);\n   456→      if (next.has(categoryId)) {\n   457→        next.delete(categoryId);\n   458→      } else {\n   459→        next.add(categoryId);\n   460→      }\n   461→      return next;\n   462→    });\n   463→  };\n   464→\n   465→  // Handle item toggle with error handling\n   466→  const handleItemToggle = async (itemId) => {\n   467→    try {\n   468→      await toggleItem(itemId);\n   469→    } catch (error) {\n   470→      toast.error('Failed to update checklist item');\n   471→    }\n   472→  };\n   473→\n   474→  // Format last updated timestamp\n   475→  const formattedLastUpdated = lastUpdated\n   476→    ? new Date(lastUpdated).toLocaleString()\n   477→    : null;\n   478→\n   479→  return (\n   480→    <div className=\"min-h-screen bg-zinc-900 text-white\">\n   481→      {/* Header */}\n   482→      <header className=\"bg-zinc-800 border-b border-zinc-700 px-6 py-4\">\n   483→        <div className=\"flex items-center justify-between\">\n   484→          <div className=\"flex items-center gap-4\">\n   485→            <Link\n   486→              to={`/${compId}/producer`}\n   487→              className=\"text-zinc-400 hover:text-white transition-colors\"\n   488→            >\n   489→              <ArrowLeftIcon className=\"w-5 h-5\" />\n   490→            </Link>\n   491→            <div>\n   492→              <h1 className=\"text-xl font-bold\">Production Checklist</h1>\n   493→              <p className=\"text-sm text-zinc-400\">\n   494→                {competitionConfig?.eventName || 'Competition'}\n   495→              </p>\n   496→            </div>\n   497→          </div>\n   498→\n   499→          {formattedLastUpdated && (\n   500→            <span className=\"text-sm text-zinc-500\">\n   501→              Last updated: {formattedLastUpdated}\n   502→            </span>\n   503→          )}\n   504→        </div>\n   505→      </header>\n   506→\n   507→      {/* Main content */}\n   508→      <main className=\"max-w-7xl mx-auto px-6 py-6\">\n   509→        {loading ? (\n   510→          <ChecklistSkeleton />\n   511→        ) : (\n   512→          <div className=\"space-y-6\">\n   513→            {/* Progress bar */}\n   514→            <ChecklistProgress summary={summary} />\n   515→\n   516→            {/* Phase tabs */}\n   517→            <div className=\"flex gap-2 flex-wrap\">\n   518→              {phases?.map(phase => (\n   519→                <PhaseTab\n   520→                  key={phase.id}\n   521→                  phase={phase}\n   522→                  isActive={phase.id === activePhaseId}\n   523→                  onClick={() => setActivePhaseId(phase.id)}\n   524→                  itemCounts={phaseItemCounts[phase.id] || { complete: 0, total: 0 }}\n   525→                />\n   526→              ))}\n   527→            </div>\n   528→\n   529→            {/* Two-column layout: Checklist + Contacts */}\n   530→            <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n   531→              {/* Categories for active phase */}\n   532→              <div className=\"lg:col-span-2 space-y-4\">\n   533→                {activePhase?.categories.map(category => (\n   534→                  <ChecklistCategory\n   535→                    key={category.id}\n   536→                    category={category}\n   537→                    expanded={expandedCategories.has(category.id)}\n   538→                    onToggle={() => toggleCategory(category.id)}\n   539→                    onItemToggle={handleItemToggle}\n   540→                    onNoteChange={updateNote}\n   541→                  />\n   542→                ))}\n   543→              </div>\n   544→\n   545→              {/* Team Contacts sidebar */}\n   546→              <div className=\"lg:col-span-1\">\n   547→                <div className=\"sticky top-6\">\n   548→                  <TeamContactsPanel\n   549→                    teamKeys={teamKeys}\n   550→                    contacts={contacts}\n   551→                    teamNames={teamNames}\n   552→                    onUpdateContact={updateContact}\n   553→                    onDeleteContact={deleteContact}\n   554→                    collapsed={activePhaseId === 'day-of-2hr' || activePhaseId === 'day-of-1hr'}\n   555→                  />\n   556→                </div>\n   557→              </div>\n   558→            </div>\n   559→          </div>\n   560→        )}\n   561→      </main>\n   562→    </div>\n   563→  );\n   564→}\n   565→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"da1dc871-ffa6-4ff4-9f29-bfaecbae6338","uuid":"b3f2dccd-bfda-4e65-aa96-d5e2210028cd","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/pages/ChecklistPage.jsx","content":"/**\n * ChecklistPage - Production Checklist for Competition\n *\n * Main page for the production checklist system. Shows all pre-flight items\n * a producer must complete before going live, grouped by phase and category.\n *\n * Features:\n * - Progress bar showing overall completion\n * - Phase tabs (Setup, Pre-Prod, 2hr Before, 1hr Before)\n * - Collapsible categories\n * - Auto-validated items (show system state)\n * - Manual items (checkboxes)\n * - Skeleton loading states\n *\n * Reference: docs/PRD-Production-Checklist/PRD-Production-Checklist-2026-01-24.md\n */\n\nimport { useState, useMemo, useCallback } from 'react';\nimport { Link } from 'react-router-dom';\nimport toast from 'react-hot-toast';\nimport {\n  ChevronDownIcon,\n  ChevronRightIcon,\n  CheckCircleIcon,\n  ExclamationTriangleIcon,\n  XCircleIcon,\n  ClockIcon,\n  ArrowPathIcon,\n} from '@heroicons/react/24/solid';\nimport {\n  ArrowLeftIcon,\n  ChatBubbleLeftEllipsisIcon,\n} from '@heroicons/react/24/outline';\nimport { useCompetition } from '../context/CompetitionContext';\nimport { useProductionChecklist } from '../hooks/useProductionChecklist';\nimport TeamContactsPanel from '../components/TeamContactsPanel';\n\n/**\n * Status icon component for checklist items\n */\nfunction StatusIcon({ status, className = '' }) {\n  const iconClass = `w-5 h-5 ${className}`;\n\n  switch (status) {\n    case 'complete':\n      return <CheckCircleIcon className={`${iconClass} text-green-500`} />;\n    case 'warning':\n      return <ExclamationTriangleIcon className={`${iconClass} text-amber-500`} />;\n    case 'error':\n      return <XCircleIcon className={`${iconClass} text-red-500`} />;\n    case 'checking':\n      return <ArrowPathIcon className={`${iconClass} text-zinc-500 animate-spin`} />;\n    default:\n      return <div className={`${iconClass} rounded-full border-2 border-zinc-500`} />;\n  }\n}\n\n/**\n * Skeleton loading component for checklist items\n */\nfunction ChecklistSkeleton() {\n  return (\n    <div className=\"space-y-6 animate-pulse\">\n      {/* Progress bar skeleton */}\n      <div className=\"bg-zinc-800 rounded-lg p-4\">\n        <div className=\"h-4 bg-zinc-700 rounded w-1/3 mb-3\" />\n        <div className=\"h-3 bg-zinc-700 rounded-full w-full mb-2\" />\n        <div className=\"flex gap-4\">\n          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n        </div>\n      </div>\n\n      {/* Phase tabs skeleton */}\n      <div className=\"flex gap-2\">\n        {[1, 2, 3, 4].map(i => (\n          <div key={i} className=\"h-10 bg-zinc-700 rounded-lg w-28\" />\n        ))}\n      </div>\n\n      {/* Category skeletons */}\n      {[1, 2, 3].map(i => (\n        <div key={i} className=\"bg-zinc-800 rounded-lg p-4\">\n          <div className=\"h-5 bg-zinc-700 rounded w-48 mb-4\" />\n          <div className=\"space-y-3\">\n            {[1, 2, 3, 4].map(j => (\n              <div key={j} className=\"flex items-center gap-3\">\n                <div className=\"w-5 h-5 bg-zinc-700 rounded-full\" />\n                <div className=\"h-4 bg-zinc-700 rounded flex-1\" />\n              </div>\n            ))}\n          </div>\n        </div>\n      ))}\n    </div>\n  );\n}\n\n/**\n * Progress bar component showing completion stats\n */\nfunction ChecklistProgress({ summary }) {\n  const { total, complete, warnings, errors, pending, percentage } = summary;\n\n  return (\n    <div className=\"bg-zinc-800 rounded-lg p-4\">\n      <div className=\"flex items-center justify-between mb-2\">\n        <span className=\"text-lg font-semibold text-white\">\n          {percentage}% Complete\n        </span>\n        <span className=\"text-sm text-zinc-400\">\n          {complete}/{total} items\n        </span>\n      </div>\n\n      {/* Progress bar */}\n      <div className=\"h-3 bg-zinc-700 rounded-full overflow-hidden mb-3\">\n        <div\n          className=\"h-full bg-green-500 transition-all duration-300\"\n          style={{ width: `${percentage}%` }}\n        />\n      </div>\n\n      {/* Stats row */}\n      <div className=\"flex gap-4 text-sm\">\n        <span className=\"flex items-center gap-1.5\">\n          <CheckCircleIcon className=\"w-4 h-4 text-green-500\" />\n          <span className=\"text-zinc-300\">{complete} complete</span>\n        </span>\n        {warnings > 0 && (\n          <span className=\"flex items-center gap-1.5\">\n            <ExclamationTriangleIcon className=\"w-4 h-4 text-amber-500\" />\n            <span className=\"text-zinc-300\">{warnings} warnings</span>\n          </span>\n        )}\n        {errors > 0 && (\n          <span className=\"flex items-center gap-1.5\">\n            <XCircleIcon className=\"w-4 h-4 text-red-500\" />\n            <span className=\"text-zinc-300\">{errors} errors</span>\n          </span>\n        )}\n        {pending > 0 && (\n          <span className=\"flex items-center gap-1.5\">\n            <ClockIcon className=\"w-4 h-4 text-zinc-500\" />\n            <span className=\"text-zinc-300\">{pending} pending</span>\n          </span>\n        )}\n      </div>\n    </div>\n  );\n}\n\n/**\n * Phase tab component\n */\nfunction PhaseTab({ phase, isActive, onClick, itemCounts }) {\n  // Calculate phase completion status\n  const { complete, total } = itemCounts;\n  const percentage = total > 0 ? Math.round((complete / total) * 100) : 0;\n\n  let statusIndicator;\n  if (percentage === 100) {\n    statusIndicator = <span className=\"text-green-500\">✓</span>;\n  } else if (percentage > 0) {\n    statusIndicator = <span className=\"text-amber-500\">◐</span>;\n  } else {\n    statusIndicator = <span className=\"text-zinc-500\">○</span>;\n  }\n\n  return (\n    <button\n      onClick={onClick}\n      className={`px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2 ${\n        isActive\n          ? 'bg-blue-600 text-white'\n          : 'bg-zinc-800 text-zinc-300 hover:bg-zinc-700'\n      }`}\n    >\n      {statusIndicator}\n      <span>{phase.shortName}</span>\n    </button>\n  );\n}\n\n/**\n * Category section component (collapsible)\n */\nfunction ChecklistCategory({ category, expanded, onToggle, onItemToggle, onNoteChange }) {\n  const completeCount = category.items.filter(i => i.status === 'complete').length;\n\n  return (\n    <div className=\"bg-zinc-800 rounded-lg overflow-hidden\">\n      {/* Category header */}\n      <button\n        onClick={onToggle}\n        className=\"w-full flex items-center justify-between px-4 py-3 hover:bg-zinc-700 transition-colors\"\n      >\n        <div className=\"flex items-center gap-3\">\n          {expanded ? (\n            <ChevronDownIcon className=\"w-5 h-5 text-zinc-400\" />\n          ) : (\n            <ChevronRightIcon className=\"w-5 h-5 text-zinc-400\" />\n          )}\n          <span className=\"font-medium text-white\">{category.name}</span>\n        </div>\n        <span className=\"text-sm text-zinc-400\">\n          {completeCount}/{category.items.length}\n        </span>\n      </button>\n\n      {/* Items list */}\n      {expanded && (\n        <div className=\"px-4 pb-3 space-y-1\">\n          {category.items.map(item => (\n            <ChecklistItem\n              key={item.id}\n              item={item}\n              onToggle={() => onItemToggle(item.id)}\n              onNoteChange={onNoteChange}\n            />\n          ))}\n        </div>\n      )}\n    </div>\n  );\n}\n\n/**\n * Individual checklist item component\n */\nfunction ChecklistItem({ item, onToggle, onNoteChange }) {\n  const isManual = item.type === 'manual';\n  const isClickable = isManual;\n  const [showNoteInput, setShowNoteInput] = useState(false);\n  const [noteValue, setNoteValue] = useState(item.note || '');\n  const [isSaving, setIsSaving] = useState(false);\n\n  // Handle note save\n  const handleNoteSave = useCallback(async () => {\n    if (noteValue === item.note) {\n      setShowNoteInput(false);\n      return;\n    }\n    setIsSaving(true);\n    try {\n      await onNoteChange(item.id, noteValue);\n      setShowNoteInput(false);\n    } catch (error) {\n      toast.error('Failed to save note');\n    } finally {\n      setIsSaving(false);\n    }\n  }, [noteValue, item.note, item.id, onNoteChange]);\n\n  // Handle key events for note input\n  const handleKeyDown = useCallback((e) => {\n    if (e.key === 'Enter' && !e.shiftKey) {\n      e.preventDefault();\n      handleNoteSave();\n    } else if (e.key === 'Escape') {\n      setNoteValue(item.note || '');\n      setShowNoteInput(false);\n    }\n  }, [handleNoteSave, item.note]);\n\n  return (\n    <div className=\"group\">\n      <div\n        className={`flex items-center gap-3 py-2 px-2 rounded ${\n          isClickable ? 'hover:bg-zinc-700 cursor-pointer' : ''\n        }`}\n        onClick={isClickable ? onToggle : undefined}\n      >\n        {/* Status icon or checkbox */}\n        {isManual ? (\n          <input\n            type=\"checkbox\"\n            checked={item.checked}\n            onChange={onToggle}\n            onClick={e => e.stopPropagation()}\n            className=\"w-5 h-5 rounded border-2 border-zinc-500 bg-transparent checked:bg-green-500 checked:border-green-500 cursor-pointer\"\n          />\n        ) : (\n          <StatusIcon status={item.status} />\n        )}\n\n        {/* Item name */}\n        <span className={`flex-1 ${item.status === 'complete' ? 'text-zinc-300' : 'text-white'}`}>\n          {item.name}\n        </span>\n\n        {/* Note indicator */}\n        {item.note && !showNoteInput && (\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              setShowNoteInput(true);\n            }}\n            className=\"text-zinc-400 hover:text-zinc-300\"\n            title={item.note}\n          >\n            <ChatBubbleLeftEllipsisIcon className=\"w-4 h-4\" />\n          </button>\n        )}\n\n        {/* Add note button (visible on hover when no note) */}\n        {!item.note && !showNoteInput && (\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              setShowNoteInput(true);\n            }}\n            className=\"text-zinc-600 hover:text-zinc-400 opacity-0 group-hover:opacity-100 transition-opacity text-sm\"\n          >\n            + Note\n          </button>\n        )}\n\n        {/* Detail text for auto-validated items */}\n        {item.detail && (\n          <span className=\"text-sm text-zinc-500\">{item.detail}</span>\n        )}\n\n        {/* Fix link for failed auto items */}\n        {item.type === 'auto' && item.status === 'error' && item.fixLink && (\n          <Link\n            to={item.fixLink}\n            onClick={e => e.stopPropagation()}\n            className=\"text-sm text-blue-400 hover:text-blue-300\"\n          >\n            Fix\n          </Link>\n        )}\n      </div>\n\n      {/* Note input area */}\n      {showNoteInput && (\n        <div className=\"ml-8 mt-1 mb-2 flex gap-2\" onClick={e => e.stopPropagation()}>\n          <input\n            type=\"text\"\n            value={noteValue}\n            onChange={(e) => setNoteValue(e.target.value)}\n            onKeyDown={handleKeyDown}\n            placeholder=\"Add a note...\"\n            autoFocus\n            className=\"flex-1 bg-zinc-700 border border-zinc-600 rounded px-3 py-1.5 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500\"\n          />\n          <button\n            onClick={handleNoteSave}\n            disabled={isSaving}\n            className=\"px-3 py-1.5 bg-blue-600 hover:bg-blue-500 disabled:bg-zinc-600 rounded text-sm text-white transition-colors\"\n          >\n            {isSaving ? '...' : 'Save'}\n          </button>\n          <button\n            onClick={() => {\n              setNoteValue(item.note || '');\n              setShowNoteInput(false);\n            }}\n            className=\"px-3 py-1.5 bg-zinc-700 hover:bg-zinc-600 rounded text-sm text-zinc-300 transition-colors\"\n          >\n            Cancel\n          </button>\n        </div>\n      )}\n\n      {/* Display existing note when not editing */}\n      {item.note && !showNoteInput && (\n        <div\n          className=\"ml-8 text-sm text-zinc-400 italic cursor-pointer hover:text-zinc-300\"\n          onClick={(e) => {\n            e.stopPropagation();\n            setShowNoteInput(true);\n          }}\n        >\n          {item.note}\n        </div>\n      )}\n    </div>\n  );\n}\n\n/**\n * Main ChecklistPage component\n */\nexport default function ChecklistPage() {\n  const { compId } = useCompetition();\n  const {\n    phases,\n    summary,\n    contacts,\n    teamKeys,\n    toggleItem,\n    updateNote,\n    updateContact,\n    deleteContact,\n    loading,\n    lastUpdated,\n    competitionConfig,\n    teamCount,\n  } = useProductionChecklist();\n\n  // Build team names array for the contacts panel\n  const teamNames = [];\n  for (let i = 1; i <= teamCount; i++) {\n    const name = competitionConfig?.[`team${i}Name`];\n    if (name) {\n      teamNames.push(name);\n    }\n  }\n\n  // Active phase tab\n  const [activePhaseId, setActivePhaseId] = useState('setup');\n\n  // Expanded categories (all expanded by default)\n  const [expandedCategories, setExpandedCategories] = useState(new Set());\n\n  // Initialize expanded categories when phases load\n  useMemo(() => {\n    if (phases?.length && expandedCategories.size === 0) {\n      const allCategories = new Set();\n      phases.forEach(phase => {\n        phase.categories.forEach(cat => {\n          allCategories.add(cat.id);\n        });\n      });\n      setExpandedCategories(allCategories);\n    }\n  }, [phases]);\n\n  // Get active phase\n  const activePhase = phases?.find(p => p.id === activePhaseId) || phases?.[0];\n\n  // Calculate item counts per phase\n  const phaseItemCounts = useMemo(() => {\n    const counts = {};\n    phases?.forEach(phase => {\n      let complete = 0;\n      let total = 0;\n      phase.categories.forEach(cat => {\n        cat.items.forEach(item => {\n          total++;\n          if (item.status === 'complete') complete++;\n        });\n      });\n      counts[phase.id] = { complete, total };\n    });\n    return counts;\n  }, [phases]);\n\n  // Toggle category expansion\n  const toggleCategory = (categoryId) => {\n    setExpandedCategories(prev => {\n      const next = new Set(prev);\n      if (next.has(categoryId)) {\n        next.delete(categoryId);\n      } else {\n        next.add(categoryId);\n      }\n      return next;\n    });\n  };\n\n  // Handle item toggle with error handling\n  const handleItemToggle = async (itemId) => {\n    try {\n      await toggleItem(itemId);\n    } catch (error) {\n      toast.error('Failed to update checklist item');\n    }\n  };\n\n  // Format last updated timestamp\n  const formattedLastUpdated = lastUpdated\n    ? new Date(lastUpdated).toLocaleString()\n    : null;\n\n  return (\n    <div className=\"min-h-screen bg-zinc-900 text-white\">\n      {/* Header */}\n      <header className=\"bg-zinc-800 border-b border-zinc-700 px-6 py-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-4\">\n            <Link\n              to={`/${compId}/producer`}\n              className=\"text-zinc-400 hover:text-white transition-colors\"\n            >\n              <ArrowLeftIcon className=\"w-5 h-5\" />\n            </Link>\n            <div>\n              <h1 className=\"text-xl font-bold\">Production Checklist</h1>\n              <p className=\"text-sm text-zinc-400\">\n                {competitionConfig?.eventName || 'Competition'}\n              </p>\n            </div>\n          </div>\n\n          {formattedLastUpdated && (\n            <span className=\"text-sm text-zinc-500\">\n              Last updated: {formattedLastUpdated}\n            </span>\n          )}\n        </div>\n      </header>\n\n      {/* Main content */}\n      <main className=\"max-w-7xl mx-auto px-6 py-6\">\n        {loading ? (\n          <ChecklistSkeleton />\n        ) : (\n          <div className=\"space-y-6\">\n            {/* Progress bar */}\n            <ChecklistProgress summary={summary} />\n\n            {/* Phase tabs */}\n            <div className=\"flex gap-2 flex-wrap\">\n              {phases?.map(phase => (\n                <PhaseTab\n                  key={phase.id}\n                  phase={phase}\n                  isActive={phase.id === activePhaseId}\n                  onClick={() => setActivePhaseId(phase.id)}\n                  itemCounts={phaseItemCounts[phase.id] || { complete: 0, total: 0 }}\n                />\n              ))}\n            </div>\n\n            {/* Two-column layout: Checklist + Contacts */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n              {/* Categories for active phase */}\n              <div className=\"lg:col-span-2 space-y-4\">\n                {activePhase?.categories.map(category => (\n                  <ChecklistCategory\n                    key={category.id}\n                    category={category}\n                    expanded={expandedCategories.has(category.id)}\n                    onToggle={() => toggleCategory(category.id)}\n                    onItemToggle={handleItemToggle}\n                    onNoteChange={updateNote}\n                  />\n                ))}\n              </div>\n\n              {/* Team Contacts sidebar */}\n              <div className=\"lg:col-span-1\">\n                <div className=\"sticky top-6\">\n                  <TeamContactsPanel\n                    teamKeys={teamKeys}\n                    contacts={contacts}\n                    teamNames={teamNames}\n                    onUpdateContact={updateContact}\n                    onDeleteContact={deleteContact}\n                    collapsed={activePhaseId === 'day-of-2hr' || activePhaseId === 'day-of-1hr'}\n                  />\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}\n","numLines":565,"startLine":1,"totalLines":565}}}
