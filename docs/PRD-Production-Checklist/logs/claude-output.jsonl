{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0119EewqtmsCDQCzftjrMFA5","type":"tool_result","content":"     1→/**\n     2→ * Production Checklist Items Definition\n     3→ *\n     4→ * 75 items across 4 phases and 14 categories.\n     5→ * 14 auto-validated items (system checks state automatically).\n     6→ * 61 manual items (producer checks off manually).\n     7→ *\n     8→ * All items appear for all competition types in MVP.\n     9→ * Dynamic behavior is in the validators (they check N teams based on comp type),\n    10→ * not in item visibility. Item filtering by comp type is deferred to Phase 2 (templates).\n    11→ *\n    12→ * Reference: docs/PRD-Production-Checklist/checklist-items-definition.md\n    13→ */\n    14→\n    15→export const CHECKLIST_PHASES = [\n    16→  {\n    17→    id: 'setup',\n    18→    name: 'Setup (5+ Days Out)',\n    19→    shortName: 'Setup',\n    20→    categories: [\n    21→      {\n    22→        id: 'competition-config',\n    23→        name: 'Competition Config',\n    24→        items: [\n    25→          { id: 'event-name', name: 'Event name configured', type: 'auto', validator: 'event-name', fixLink: '/' },\n    26→          { id: 'meet-date', name: 'Meet date configured', type: 'auto', validator: 'meet-date', fixLink: '/' },\n    27→          { id: 'venue-configured', name: 'Venue configured', type: 'auto', validator: 'venue-configured', fixLink: '/' },\n    28→          { id: 'teams-configured', name: 'Teams configured with names & logos', type: 'auto', validator: 'teams-configured', fixLink: '/' },\n    29→          { id: 'rosters-loaded', name: 'Rosters loaded for all teams', type: 'auto', validator: 'rosters-loaded', fixLink: '/media-manager' },\n    30→          { id: 'headshots-uploaded', name: 'Headshots uploaded & current (>80%)', type: 'auto', validator: 'headshots-uploaded', fixLink: '/media-manager' },\n    31→          { id: 'theme-configured', name: 'Meet theme configured', type: 'auto', validator: 'theme-configured', fixLink: '/themes' },\n    32→        ],\n    33→      },\n    34→      {\n    35→        id: 'session-setup',\n    36→        name: 'Session Setup',\n    37→        items: [\n    38→          { id: 'session-created', name: 'Session created in Virtius', type: 'manual' },\n    39→          { id: 'session-configured', name: 'Session configured with teams, times, public, judges', type: 'manual' },\n    40→          { id: 'session-front-page', name: 'Session placed on Virtius front page', type: 'manual' },\n    41→        ],\n    42→      },\n    43→      {\n    44→        id: 'communications',\n    45→        name: 'Communications',\n    46→        items: [\n    47→          { id: 'pre-meet-email', name: 'Pre-meet email sent to coaches', type: 'manual' },\n    48→          { id: 'camera-op-contact', name: 'Camera op contact info received', type: 'manual', autoAssist: 'camera-op-primary' },\n    49→          { id: 'talent-contacted', name: 'Commentary talent contacted & confirmed', type: 'manual', autoAssist: 'head-coach' },\n    50→          { id: 'streaming-plan-confirmed', name: 'Streaming plan confirmed with school', type: 'manual' },\n    51→          { id: 'ops-group-chat', name: 'Group chat created with ops team & camera crew', type: 'manual' },\n    52→          { id: 'talent-group-chat', name: 'Talent text group chat created with producer', type: 'manual' },\n    53→        ],\n    54→      },\n    55→      {\n    56→        id: 'graphics-deliverables',\n    57→        name: 'Graphics & Deliverables',\n    58→        items: [\n    59→          { id: 'meet-graphics-received', name: 'Meet graphics received from school', type: 'manual' },\n    60→          { id: 'show-timeline-received', name: 'Show timeline received', type: 'manual' },\n    61→          { id: 'sponsorships-received', name: 'Sponsorships & sponsor requirements received', type: 'manual' },\n    62→          { id: 'animated-background', name: 'Custom animated backgr