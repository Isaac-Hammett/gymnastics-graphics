{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QDcmGrJXcEiTQASyrBqfgw","type":"tool_result","content":"     1→/**\n     2→ * TeamContactsPanel - Contact management panel for production checklist\n     3→ *\n     4→ * Displays team contacts with tabs for each team in the competition.\n     5→ * Supports N teams (1-7) based on competition type.\n     6→ *\n     7→ * Features:\n     8→ * - Team tabs (dynamic count)\n     9→ * - Contact list with role icons\n    10→ * - Click-to-call (tel:) and click-to-email (mailto:)\n    11→ * - Add/Edit contact functionality (modal in Task 19)\n    12→ *\n    13→ * Reference: docs/PRD-Production-Checklist/PLAN-Production-Checklist-2026-01-24.md\n    14→ */\n    15→\n    16→import { useState } from 'react';\n    17→import {\n    18→  UserGroupIcon,\n    19→  PhoneIcon,\n    20→  EnvelopeIcon,\n    21→  UserIcon,\n    22→  ChevronDownIcon,\n    23→  ChevronUpIcon,\n    24→} from '@heroicons/react/24/solid';\n    25→import {\n    26→  PlusIcon,\n    27→} from '@heroicons/react/24/outline';\n    28→\n    29→/**\n    30→ * Standard contact roles\n    31→ */\n    32→export const CONTACT_ROLES = {\n    33→  'head-coach': { label: 'Head Coach', icon: '👤' },\n    34→  'assistant-coach': { label: 'Assistant Coach', icon: '👤' },\n    35→  'sid': { label: 'Sports Information Director', icon: '📋' },\n    36→  'camera-op-primary': { label: 'Camera Operator', icon: '📹' },\n    37→  'camera-op-backup': { label: 'Camera Op (Backup)', icon: '📹' },\n    38→  'venue-operations': { label: 'Venue Operations', icon: '🏟️' },\n    39→  'scoring-operations': { label: 'Scoring Operations', icon: '📊' },\n    40→};\n    41→\n    42→/**\n    43→ * Get display name from team key\n    44→ */\n    45→function getTeamDisplayName(teamKey, teamNames) {\n    46→  // Try to find matching team name in the provided list\n    47→  if (teamNames && teamKey) {\n    48→    const keyLower = teamKey.toLowerCase();\n    49→    for (const name of teamNames) {\n    50→      // Simple match: school name matches start of team key\n    51→      const normalized = name.toLowerCase().replace(/\\s+/g, '-');\n    52→      if (keyLower.startsWith(normalized)) {\n    53→        return name;\n    54→      }\n    55→    }\n    56→  }\n    57→  // Fallback: convert team key to display name\n    58→  return teamKey\n    59→    ? teamKey\n    60→        .replace(/-mens$/, '')\n    61→        .replace(/-womens$/, '')\n    62→        .split('-')\n    63→        .map(word => word.charAt(0).toUpperCase() + word.slice(1))\n    64→        .join(' ')\n    65→    : 'Unknown Team';\n    66→}\n    67→\n    68→/**\n    69→ * Single contact card\n    70→ */\n    71→function ContactCard({ contact, roleId, onEdit }) {\n    72→  const roleInfo = CONTACT_ROLES[roleId] || { label: roleId, icon: '👤' };\n    73→\n    74→  return (\n    75→    <div className=\"bg-zinc-700/50 rounded-lg p-3\">\n    76→      <div className=\"flex items-start justify-between gap-2\">\n    77→        <div className=\"flex-1 min-w-0\">\n    78→          {/* Role and name */}\n    79→          <div className=\"flex items-center gap-2 mb-1\">\n    80→            <span className=\"text-sm\">{roleInfo.icon}</span>\n    81→            <span className=\"text-xs text-zinc-400\">{roleInfo.label}</span>\n    82→          </div>\n    83→          <div className=\"font-medium text-white truncate\">\n    84→            {contact.name || 'No name'}\n    85→          </div>\n    86→        </div>\n    87→      </div>\n    88→\n    89→      {/* Contact methods */}\n    90→      <div className=\"mt-2 flex flex-wrap gap-2\">\n    91→        {contact.phone && (\n    92→          <a\n    93→            href={`tel:${contact.phone}`}\n    94→            className=\"inline-flex items-center gap-1.5 px-2 py-1 bg-zinc-600 hover:bg-zinc-500 rounded text-sm text-zinc-200 transition-colors\"\n    95→            onClick={(e) => e.stopPropagation()}\n    96→          >\n    97→            <PhoneIcon className=\"w-3.5 h-3.5\" />\n    98→            <span className=\"text-xs\">{contact.phone}</span>\n    99→          </a>\n   100→        )}\n   101→        {contact.email && (\n   102→          <a\n   103→            href={`mailto:${contact.email}`}\n   104→            className=\"inline-flex items-center gap-1.5 px-2 py-1 bg-zinc-600 hover:bg-zinc-500 rounded text-sm text-zinc-200 transition-colors\"\n   105→            onClick={(e) => e.stopPropagation()}\n   106→          >\n   107→            <EnvelopeIcon className=\"w-3.5 h-3.5\" />\n   108→            <span className=\"text-xs truncate max-w-[120px]\">{contact.email}</span>\n   109→          </a>\n   110→        )}\n   111→      </div>\n   112→\n   113→      {/* Notes */}\n   114→      {contact.notes && (\n   115→        <div className=\"mt-2 text-xs text-zinc-400 italic\">\n   116→          {contact.notes}\n   117→        </div>\n   118→      )}\n   119→    </div>\n   120→  );\n   121→}\n   122→\n   123→/**\n   124→ * Empty state when no contacts exist for a team\n   125→ */\n   126→function EmptyContacts({ teamName, onAddContact }) {\n   127→  return (\n   128→    <div className=\"text-center py-6\">\n   129→      <UserGroupIcon className=\"w-10 h-10 text-zinc-600 mx-auto mb-2\" />\n   130→      <p className=\"text-zinc-400 text-sm mb-3\">\n   131→        No contacts for {teamName}\n   132→      </p>\n   133→      <button\n   134→        onClick={onAddContact}\n   135→        className=\"inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded text-sm text-white transition-colors\"\n   136→      >\n   137→        <PlusIcon className=\"w-4 h-4\" />\n   138→        Add Contact\n   139→      </button>\n   140→    </div>\n   141→  );\n   142→}\n   143→\n   144→/**\n   145→ * Team tab button\n   146→ */\n   147→function TeamTab({ teamKey, teamName, isActive, onClick, contactCount }) {\n   148→  return (\n   149→    <button\n   150→      onClick={onClick}\n   151→      className={`px-3 py-1.5 rounded text-sm font-medium transition-colors flex items-center gap-1.5 ${\n   152→        isActive\n   153→          ? 'bg-blue-600 text-white'\n   154→          : 'bg-zinc-700 text-zinc-300 hover:bg-zinc-600'\n   155→      }`}\n   156→    >\n   157→      <span className=\"truncate max-w-[80px]\">{teamName}</span>\n   158→      {contactCount > 0 && (\n   159→        <span className={`text-xs px-1.5 py-0.5 rounded-full ${\n   160→          isActive ? 'bg-blue-500' : 'bg-zinc-600'\n   161→        }`}>\n   162→          {contactCount}\n   163→        </span>\n   164→      )}\n   165→    </button>\n   166→  );\n   167→}\n   168→\n   169→/**\n   170→ * TeamContactsPanel - Main component\n   171→ *\n   172→ * @param {string[]} teamKeys - Array of team keys for the competition\n   173→ * @param {Object} contacts - Contacts data by team key: { [teamKey]: { [roleId]: contactData } }\n   174→ * @param {string[]} teamNames - Array of team display names (parallel to teamKeys)\n   175→ * @param {Function} onAddContact - Callback when user wants to add a contact (opens modal)\n   176→ * @param {Function} onEditContact - Callback when user wants to edit a contact\n   177→ * @param {boolean} collapsed - Whether panel starts collapsed\n   178→ */\n   179→export default function TeamContactsPanel({\n   180→  teamKeys = [],\n   181→  contacts = {},\n   182→  teamNames = [],\n   183→  onAddContact,\n   184→  onEditContact,\n   185→  collapsed: initialCollapsed = false\n   186→}) {\n   187→  const [collapsed, setCollapsed] = useState(initialCollapsed);\n   188→  const [activeTeamKey, setActiveTeamKey] = useState(teamKeys[0] || null);\n   189→\n   190→  // Get contacts for active team\n   191→  const activeTeamContacts = contacts[activeTeamKey] || {};\n   192→  const contactEntries = Object.entries(activeTeamContacts);\n   193→\n   194→  // Count total contacts\n   195→  const totalContacts = Object.values(contacts).reduce(\n   196→    (sum, teamContacts) => sum + Object.keys(teamContacts || {}).length,\n   197→    0\n   198→  );\n   199→\n   200→  // Get contact count per team\n   201→  const getContactCount = (teamKey) => {\n   202→    return Object.keys(contacts[teamKey] || {}).length;\n   203→  };\n   204→\n   205→  // Get display name for a team key\n   206→  const getDisplayName = (teamKey, index) => {\n   207→    if (teamNames[index]) return teamNames[index];\n   208→    return getTeamDisplayName(teamKey, teamNames);\n   209→  };\n   210→\n   211→  // Handle adding contact for active team\n   212→  const handleAddContact = () => {\n   213→    if (onAddContact && activeTeamKey) {\n   214→      onAddContact(activeTeamKey);\n   215→    }\n   216→  };\n   217→\n   218→  // Empty state for no teams\n   219→  if (teamKeys.length === 0) {\n   220→    return (\n   221→      <div className=\"bg-zinc-800 rounded-xl p-4\">\n   222→        <div className=\"flex items-center gap-2 text-zinc-400\">\n   223→          <UserGroupIcon className=\"w-5 h-5\" />\n   224→          <span className=\"font-medium\">Team Contacts</span>\n   225→        </div>\n   226→        <div className=\"text-center py-4 text-zinc-500 text-sm\">\n   227→          No teams configured\n   228→        </div>\n   229→      </div>\n   230→    );\n   231→  }\n   232→\n   233→  return (\n   234→    <div className=\"bg-zinc-800 rounded-xl overflow-hidden\">\n   235→      {/* Header */}\n   236→      <button\n   237→        onClick={() => setCollapsed(!collapsed)}\n   238→        className=\"w-full flex items-center justify-between px-4 py-3 hover:bg-zinc-700/50 transition-colors\"\n   239→      >\n   240→        <div className=\"flex items-center gap-2\">\n   241→          <UserGroupIcon className=\"w-5 h-5 text-zinc-400\" />\n   242→          <span className=\"font-medium text-white\">Team Contacts</span>\n   243→          {totalContacts > 0 && (\n   244→            <span className=\"px-2 py-0.5 bg-zinc-700 text-zinc-300 text-xs rounded-full\">\n   245→              {totalContacts}\n   246→            </span>\n   247→          )}\n   248→        </div>\n   249→        {collapsed ? (\n   250→          <ChevronDownIcon className=\"w-5 h-5 text-zinc-400\" />\n   251→        ) : (\n   252→          <ChevronUpIcon className=\"w-5 h-5 text-zinc-400\" />\n   253→        )}\n   254→      </button>\n   255→\n   256→      {!collapsed && (\n   257→        <div className=\"px-4 pb-4\">\n   258→          {/* Team tabs */}\n   259→          {teamKeys.length > 1 && (\n   260→            <div className=\"flex gap-2 mb-4 overflow-x-auto pb-1\">\n   261→              {teamKeys.map((teamKey, index) => (\n   262→                <TeamTab\n   263→                  key={teamKey}\n   264→                  teamKey={teamKey}\n   265→                  teamName={getDisplayName(teamKey, index)}\n   266→                  isActive={activeTeamKey === teamKey}\n   267→                  onClick={() => setActiveTeamKey(teamKey)}\n   268→                  contactCount={getContactCount(teamKey)}\n   269→                />\n   270→              ))}\n   271→            </div>\n   272→          )}\n   273→\n   274→          {/* Single team label (when only 1 team) */}\n   275→          {teamKeys.length === 1 && (\n   276→            <div className=\"text-sm text-zinc-400 mb-3\">\n   277→              {getDisplayName(teamKeys[0], 0)}\n   278→            </div>\n   279→          )}\n   280→\n   281→          {/* Contacts list */}\n   282→          {contactEntries.length > 0 ? (\n   283→            <div className=\"space-y-2\">\n   284→              {contactEntries.map(([roleId, contact]) => (\n   285→                <ContactCard\n   286→                  key={roleId}\n   287→                  contact={contact}\n   288→                  roleId={roleId}\n   289→                  onEdit={() => onEditContact?.(activeTeamKey, roleId, contact)}\n   290→                />\n   291→              ))}\n   292→\n   293→              {/* Add more button */}\n   294→              {onAddContact && (\n   295→                <button\n   296→                  onClick={handleAddContact}\n   297→                  className=\"w-full flex items-center justify-center gap-1.5 px-3 py-2 border border-dashed border-zinc-600 hover:border-zinc-500 rounded-lg text-sm text-zinc-400 hover:text-zinc-300 transition-colors\"\n   298→                >\n   299→                  <PlusIcon className=\"w-4 h-4\" />\n   300→                  Add Contact\n   301→                </button>\n   302→              )}\n   303→            </div>\n   304→          ) : (\n   305→            <EmptyContacts\n   306→              teamName={getDisplayName(activeTeamKey, teamKeys.indexOf(activeTeamKey))}\n   307→              onAddContact={handleAddContact}\n   308→            />\n   309→          )}\n   310→        </div>\n   311→      )}\n   312→    </div>\n   313→  );\n   314→}\n   315→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"2603c14a-d0db-43c5-896e-d4948fa0dbfb","uuid":"3969f3f3-e88b-4dd2-8dbc-e3a642ceab8e","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/components/TeamContactsPanel.jsx","content":"/**\n * TeamContactsPanel - Contact management panel for production checklist\n *\n * Displays team contacts with tabs for each team in the competition.\n * Supports N teams (1-7) based on competition type.\n *\n * Features:\n * - Team tabs (dynamic count)\n * - Contact list with role icons\n * - Click-to-call (tel:) and click-to-email (mailto:)\n * - Add/Edit contact functionality (modal in Task 19)\n *\n * Reference: docs/PRD-Production-Checklist/PLAN-Production-Checklist-2026-01-24.md\n */\n\nimport { useState } from 'react';\nimport {\n  UserGroupIcon,\n  PhoneIcon,\n  EnvelopeIcon,\n  UserIcon,\n  ChevronDownIcon,\n  ChevronUpIcon,\n} from '@heroicons/react/24/solid';\nimport {\n  PlusIcon,\n} from '@heroicons/react/24/outline';\n\n/**\n * Standard contact roles\n */\nexport const CONTACT_ROLES = {\n  'head-coach': { label: 'Head Coach', icon: '👤' },\n  'assistant-coach': { label: 'Assistant Coach', icon: '👤' },\n  'sid': { label: 'Sports Information Director', icon: '📋' },\n  'camera-op-primary': { label: 'Camera Operator', icon: '📹' },\n  'camera-op-backup': { label: 'Camera Op (Backup)', icon: '📹' },\n  'venue-operations': { label: 'Venue Operations', icon: '🏟️' },\n  'scoring-operations': { label: 'Scoring Operations', icon: '📊' },\n};\n\n/**\n * Get display name from team key\n */\nfunction getTeamDisplayName(teamKey, teamNames) {\n  // Try to find matching team name in the provided list\n  if (teamNames && teamKey) {\n    const keyLower = teamKey.toLowerCase();\n    for (const name of teamNames) {\n      // Simple match: school name matches start of team key\n      const normalized = name.toLowerCase().replace(/\\s+/g, '-');\n      if (keyLower.startsWith(normalized)) {\n        return name;\n      }\n    }\n  }\n  // Fallback: convert team key to display name\n  return teamKey\n    ? teamKey\n        .replace(/-mens$/, '')\n        .replace(/-womens$/, '')\n        .split('-')\n        .map(word => word.charAt(0).toUpperCase() + word.slice(1))\n        .join(' ')\n    : 'Unknown Team';\n}\n\n/**\n * Single contact card\n */\nfunction ContactCard({ contact, roleId, onEdit }) {\n  const roleInfo = CONTACT_ROLES[roleId] || { label: roleId, icon: '👤' };\n\n  return (\n    <div className=\"bg-zinc-700/50 rounded-lg p-3\">\n      <div className=\"flex items-start justify-between gap-2\">\n        <div className=\"flex-1 min-w-0\">\n          {/* Role and name */}\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"text-sm\">{roleInfo.icon}</span>\n            <span className=\"text-xs text-zinc-400\">{roleInfo.label}</span>\n          </div>\n          <div className=\"font-medium text-white truncate\">\n            {contact.name || 'No name'}\n          </div>\n        </div>\n      </div>\n\n      {/* Contact methods */}\n      <div className=\"mt-2 flex flex-wrap gap-2\">\n        {contact.phone && (\n          <a\n            href={`tel:${contact.phone}`}\n            className=\"inline-flex items-center gap-1.5 px-2 py-1 bg-zinc-600 hover:bg-zinc-500 rounded text-sm text-zinc-200 transition-colors\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <PhoneIcon className=\"w-3.5 h-3.5\" />\n            <span className=\"text-xs\">{contact.phone}</span>\n          </a>\n        )}\n        {contact.email && (\n          <a\n            href={`mailto:${contact.email}`}\n            className=\"inline-flex items-center gap-1.5 px-2 py-1 bg-zinc-600 hover:bg-zinc-500 rounded text-sm text-zinc-200 transition-colors\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <EnvelopeIcon className=\"w-3.5 h-3.5\" />\n            <span className=\"text-xs truncate max-w-[120px]\">{contact.email}</span>\n          </a>\n        )}\n      </div>\n\n      {/* Notes */}\n      {contact.notes && (\n        <div className=\"mt-2 text-xs text-zinc-400 italic\">\n          {contact.notes}\n        </div>\n      )}\n    </div>\n  );\n}\n\n/**\n * Empty state when no contacts exist for a team\n */\nfunction EmptyContacts({ teamName, onAddContact }) {\n  return (\n    <div className=\"text-center py-6\">\n      <UserGroupIcon className=\"w-10 h-10 text-zinc-600 mx-auto mb-2\" />\n      <p className=\"text-zinc-400 text-sm mb-3\">\n        No contacts for {teamName}\n      </p>\n      <button\n        onClick={onAddContact}\n        className=\"inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 rounded text-sm text-white transition-colors\"\n      >\n        <PlusIcon className=\"w-4 h-4\" />\n        Add Contact\n      </button>\n    </div>\n  );\n}\n\n/**\n * Team tab button\n */\nfunction TeamTab({ teamKey, teamName, isActive, onClick, contactCount }) {\n  return (\n    <button\n      onClick={onClick}\n      className={`px-3 py-1.5 rounded text-sm font-medium transition-colors flex items-center gap-1.5 ${\n        isActive\n          ? 'bg-blue-600 text-white'\n          : 'bg-zinc-700 text-zinc-300 hover:bg-zinc-600'\n      }`}\n    >\n      <span className=\"truncate max-w-[80px]\">{teamName}</span>\n      {contactCount > 0 && (\n        <span className={`text-xs px-1.5 py-0.5 rounded-full ${\n          isActive ? 'bg-blue-500' : 'bg-zinc-600'\n        }`}>\n          {contactCount}\n        </span>\n      )}\n    </button>\n  );\n}\n\n/**\n * TeamContactsPanel - Main component\n *\n * @param {string[]} teamKeys - Array of team keys for the competition\n * @param {Object} contacts - Contacts data by team key: { [teamKey]: { [roleId]: contactData } }\n * @param {string[]} teamNames - Array of team display names (parallel to teamKeys)\n * @param {Function} onAddContact - Callback when user wants to add a contact (opens modal)\n * @param {Function} onEditContact - Callback when user wants to edit a contact\n * @param {boolean} collapsed - Whether panel starts collapsed\n */\nexport default function TeamContactsPanel({\n  teamKeys = [],\n  contacts = {},\n  teamNames = [],\n  onAddContact,\n  onEditContact,\n  collapsed: initialCollapsed = false\n}) {\n  const [collapsed, setCollapsed] = useState(initialCollapsed);\n  const [activeTeamKey, setActiveTeamKey] = useState(teamKeys[0] || null);\n\n  // Get contacts for active team\n  const activeTeamContacts = contacts[activeTeamKey] || {};\n  const contactEntries = Object.entries(activeTeamContacts);\n\n  // Count total contacts\n  const totalContacts = Object.values(contacts).reduce(\n    (sum, teamContacts) => sum + Object.keys(teamContacts || {}).length,\n    0\n  );\n\n  // Get contact count per team\n  const getContactCount = (teamKey) => {\n    return Object.keys(contacts[teamKey] || {}).length;\n  };\n\n  // Get display name for a team key\n  const getDisplayName = (teamKey, index) => {\n    if (teamNames[index]) return teamNames[index];\n    return getTeamDisplayName(teamKey, teamNames);\n  };\n\n  // Handle adding contact for active team\n  const handleAddContact = () => {\n    if (onAddContact && activeTeamKey) {\n      onAddContact(activeTeamKey);\n    }\n  };\n\n  // Empty state for no teams\n  if (teamKeys.length === 0) {\n    return (\n      <div className=\"bg-zinc-800 rounded-xl p-4\">\n        <div className=\"flex items-center gap-2 text-zinc-400\">\n          <UserGroupIcon className=\"w-5 h-5\" />\n          <span className=\"font-medium\">Team Contacts</span>\n        </div>\n        <div className=\"text-center py-4 text-zinc-500 text-sm\">\n          No teams configured\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"bg-zinc-800 rounded-xl overflow-hidden\">\n      {/* Header */}\n      <button\n        onClick={() => setCollapsed(!collapsed)}\n        className=\"w-full flex items-center justify-between px-4 py-3 hover:bg-zinc-700/50 transition-colors\"\n      >\n        <div className=\"flex items-center gap-2\">\n          <UserGroupIcon className=\"w-5 h-5 text-zinc-400\" />\n          <span className=\"font-medium text-white\">Team Contacts</span>\n          {totalContacts > 0 && (\n            <span className=\"px-2 py-0.5 bg-zinc-700 text-zinc-300 text-xs rounded-full\">\n              {totalContacts}\n            </span>\n          )}\n        </div>\n        {collapsed ? (\n          <ChevronDownIcon className=\"w-5 h-5 text-zinc-400\" />\n        ) : (\n          <ChevronUpIcon className=\"w-5 h-5 text-zinc-400\" />\n        )}\n      </button>\n\n      {!collapsed && (\n        <div className=\"px-4 pb-4\">\n          {/* Team tabs */}\n          {teamKeys.length > 1 && (\n            <div className=\"flex gap-2 mb-4 overflow-x-auto pb-1\">\n              {teamKeys.map((teamKey, index) => (\n                <TeamTab\n                  key={teamKey}\n                  teamKey={teamKey}\n                  teamName={getDisplayName(teamKey, index)}\n                  isActive={activeTeamKey === teamKey}\n                  onClick={() => setActiveTeamKey(teamKey)}\n                  contactCount={getContactCount(teamKey)}\n                />\n              ))}\n            </div>\n          )}\n\n          {/* Single team label (when only 1 team) */}\n          {teamKeys.length === 1 && (\n            <div className=\"text-sm text-zinc-400 mb-3\">\n              {getDisplayName(teamKeys[0], 0)}\n            </div>\n          )}\n\n          {/* Contacts list */}\n          {contactEntries.length > 0 ? (\n            <div className=\"space-y-2\">\n              {contactEntries.map(([roleId, contact]) => (\n                <ContactCard\n                  key={roleId}\n                  contact={contact}\n                  roleId={roleId}\n                  onEdit={() => onEditContact?.(activeTeamKey, roleId, contact)}\n                />\n              ))}\n\n              {/* Add more button */}\n              {onAddContact && (\n                <button\n                  onClick={handleAddContact}\n                  className=\"w-full flex items-center justify-center gap-1.5 px-3 py-2 border border-dashed border-zinc-600 hover:border-zinc-500 rounded-lg text-sm text-zinc-400 hover:text-zinc-300 transition-colors\"\n                >\n                  <PlusIcon className=\"w-4 h-4\" />\n                  Add Contact\n                </button>\n              )}\n            </div>\n          ) : (\n            <EmptyContacts\n              teamName={getDisplayName(activeTeamKey, teamKeys.indexOf(activeTeamKey))}\n              onAddContact={handleAddContact}\n            />\n          )}\n        </div>\n      )}\n    </div>\n  );\n}\n","numLines":315,"startLine":1,"totalLines":315}}}
