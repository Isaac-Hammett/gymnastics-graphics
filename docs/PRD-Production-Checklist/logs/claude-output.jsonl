{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DsdxijpRiCYu53XhJCcCAM","type":"tool_result","content":"     1→import { createContext, useContext, useEffect, useState, useCallback, useRef } from 'react';\n     2→import { useShow } from './ShowContext';\n     3→\n     4→const OBSContext = createContext(null);\n     5→\n     6→// Local storage key for auto-load preference\n     7→const AUTO_LOAD_TEMPLATE_KEY = 'obs-auto-load-template';\n     8→\n     9→// Initial state values\n    10→const INITIAL_OBS_STATE = {\n    11→  connected: false,\n    12→  scenes: [],\n    13→  currentScene: null,\n    14→  previewScene: null,\n    15→  inputs: [],\n    16→  audioSources: [],\n    17→  transitions: [],\n    18→  currentTransition: null,\n    19→  streaming: false,\n    20→  recording: false,\n    21→  recordingPaused: false,\n    22→  studioModeEnabled: false,\n    23→  connectionError: null,\n    24→  // PRD-OBS-06: Stream & Recording state\n    25→  streamSettings: null,\n    26→  streamStatus: null,\n    27→  recordingStatus: null\n    28→};\n    29→\n    30→// Initial audio levels state (PRD-OBS-04: Real-time Audio Levels)\n    31→const INITIAL_AUDIO_LEVELS = new Map();\n    32→\n    33→export function OBSProvider({ children }) {\n    34→  // Get socket from ShowContext\n    35→  const { socket, connected } = useShow();\n    36→\n    37→  // State - obsConnected is derived from obsState.connected (set by obs:stateUpdated event)\n    38→  const [obsState, setObsState] = useState(INITIAL_OBS_STATE);\n    39→  const [connectionError, setConnectionError] = useState(null);\n    40→\n    41→  // PRD-OBS-04: Real-time audio levels state\n    42→  const [audioLevels, setAudioLevels] = useState(INITIAL_AUDIO_LEVELS);\n    43→\n    44→  // PRD-OBS-04 Phase 1.5: Audio presets state\n    45→  const [presets, setPresets] = useState([]);\n    46→  const [presetsLoading, setPresetsLoading] = useState(false);\n    47→  const [presetApplying, setPresetApplying] 