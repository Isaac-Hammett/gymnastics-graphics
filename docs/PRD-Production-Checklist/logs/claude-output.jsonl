});\n   444→  }, [socket]);\n   445→\n   446→  // Apply an audio preset (corrected event name for Phase 1.5)\n   447→  const applyPreset = useCallback((presetId) => {\n   448→    console.log('OBSContext: Applying preset', presetId);\n   449→    socket?.emit('obs:applyPreset', { presetId });\n   450→  }, [socket]);\n   451→\n   452→  // Alias for backwards compatibility\n   453→  const loadPreset = applyPreset;\n   454→\n   455→  // List all audio presets (default + user-created)\n   456→  const listPresets = useCallback(() => {\n   457→    console.log('OBSContext: Listing presets');\n   458→    socket?.emit('obs:listPresets');\n   459→  }, [socket]);\n   460→\n   461→  // Save current audio mix as a new preset\n   462→  const savePreset = useCallback((name, description, sources) => {\n   463→    console.log('OBSContext: Saving preset', name);\n   464→    socket?.emit('obs:savePreset', { name, description, sources });\n   465→  }, [socket]);\n   466→\n   467→  // Delete a user-created preset\n   468→  const deletePreset = useCallback((presetId) => {\n   469→    console.log('OBSContext: Deleting preset', presetId);\n   470→    socket?.emit('obs:deletePreset', { presetId });\n   471→  }, [socket]);\n   472→\n   473→  const startStream = useCallback(() => {\n   474→    console.log('OBSContext: Starting stream');\n   475→    socket?.emit('obs:startStream');\n   476→  }, [socket]);\n   477→\n   478→  const stopStream = useCallback(() => {\n   479→    console.log('OBSContext: Stopping stream');\n   480→    socket?.emit('obs:stopStream');\n   481→  }, [socket]);\n   482→\n   483→  const startRecording = useCallback(() => {\n   484→    console.log('OBSContext: Starting recording');\n   485→    socket?.emit('obs:startRecording');\n   486→  }, [socket]);\n   487→\n   488→  const stopRecording = useCallback(() => {\n   489→    console.log('OBSContext: Stopping recording');\n   490→    socket?.emit('obs:stopRecording');\n   491→  }, [socket]);\n   492→\n   493→  // PRD-OBS-06: A