ocket]);\n   539→\n   540→  const disableStudioMode = useCallback(() => {\n   541→    console.log('OBSContext: Disabling studio mode');\n   542→    socket?.emit('obs:disableStudioMode');\n   543→  }, [socket]);\n   544→\n   545→  const createScene = useCallback((sceneName, templateId = null) => {\n   546→    console.log('OBSContext: Creating scene', sceneName, templateId ? `from template ${templateId}` : '(blank)');\n   547→    socket?.emit('obs:createScene', { sceneName, templateId });\n   548→  }, [socket]);\n   549→\n   550→  const deleteScene = useCallback((sceneName) => {\n   551→    console.log('OBSContext: Deleting scene', sceneName);\n   552→    socket?.emit('obs:deleteScene', { sceneName });\n   553→  }, [socket]);\n   554→\n   555→  const deleteAllScenes = useCallback(() => {\n   556→    console.log('OBSContext: Deleting all scenes');\n   557→    socket?.emit('obs:deleteAllScenes');\n   558→  }, [socket]);\n   559→\n   560→  const duplicateScene = useCallback((sceneName, newSceneName) => {\n   561→    console.log('OBSContext: Duplicating scene', sceneName, 'to', newSceneName);\n   562→    socket?.emit('obs:duplicateScene', { sceneName, newSceneName });\n   563→  }, [socket]);\n   564→\n   565→  const renameScene = useCallback((sceneName, newSceneName) => {\n   566→    console.log('OBSContext: Renaming scene', sceneName, 'to', newSceneName);\n   567→    socket?.emit('obs:renameScene', { sceneName, newSceneName });\n   568→  }, [socket]);\n   569→\n   570→  const reorderScenes = useCallback((sceneNames) => {\n   571→    console.log('OBSContext: Reordering scenes', sceneNames);\n   572→    socket?.emit('obs:reorderScenes', { sceneNames });\n   573→  }, [socket]);\n   574→\n   575→  // Scene item actions\n   576→  const toggleItemVisibility = useCallback((sceneName, sceneItemId, enabled) => {\n   577→    console.log('OBSContext: Toggle item visibility', sceneName, sceneItemId, enabled);\n   578→    socket?.emit('obs:toggleItemVisibility', { sceneName, sceneItemId, enabled });\n   579→  }, [socket]);\n   580→\n   581→  const toggleItemLock = useCallback((sceneName, sceneItemId, locked) => {\n   582→    console.log('OBSContext: Toggle item lock', sceneName, sceneItemId, locked);\n   583→    socket?.emit('obs:toggleItemLock', { sceneName, sceneItemId, locked });\n   584→  }, [socket]);\n   585→\n   586→  const deleteSceneItem = useCallback((sceneName, sceneItemId) => {\n   587→    console.log('OBSContext: Delete scene item', sceneName, sceneItemId);\n   588→    socket?.emit('obs:deleteSceneItem', { sceneName, sceneItemId });\n   589→  }, [socket]);\n   590→\n   591→  const reorderSceneItems = useCallback((sceneName, sceneItemId, newIndex) => {\n   592→    console.log('OBSContext: Reorder scene items', sceneName, sceneItemId, newIndex);\n   593→    socket?.emit('obs:reorderSceneItems', { sceneName, sceneItemId, newIndex });\n   594→  }, [socket]);\n   595→\n   596→  const applyTransformPreset = useCallback((sceneName, sceneItemId, transform) => {\n   597→    console.log('OBSContext: Apply transform preset', sceneName, sceneItemId, transform);\n   598→    socket?.emit('obs:applyTransformPreset', { sceneName, sceneItemId, transform });\n   599→  }, [socket]);\n   600→\n   601→  const addSourceToScene = useCallback((sceneName, sourceName) => {\n   602→    console.log('OBSContext: Add source to scene', sceneName, sourceName);\n   603→    socket?.emit('obs:addSourceToScene', { sceneName, sourceName });\n   604→  }, [socket]);\n   605→\n   606→  // Create a new input/source and optionally add it to a scene\n   607→  const createInput = useCallback((inputName, inputKind, inputSettings, sceneName = null) => {\n   608→    console.log('OBSContext: Creating input', inputName, inputKind, inputSettings, sceneName ? `in scene ${sceneName}` : '');\n   609→    socket?.emit('obs:createInput', { inputName, inputKind, inputSettings, sceneName });\n   610→  }, [socket]);\n   611→\n   612→  // Remove an input entirely from OBS (PRD-OBS-03: Source Management)\n   613→  const removeInput = useCallback((inputName) => {\n   614→    console.log('OBSContext: Removing input', inputName);\n   615→    socket?.emit('obs:removeInput', { inputName });\n   616→  }, [socket]);\n   617→\n   618→  // Update input settings (PRD-OBS-03: Source Management)\n   619→  const updateInputSettings = useCallback((inputName, inputSettings) => {\n   620→    console.log('OBSContext: Updating input settings', inputName, inputSettings);\n   621→    socket?.emit('obs:updateInputSettings', { inputName, inputSettings });\n   622→  }, [socket]);\n   623→\n   624→  // Get input settings (for SourceEditor to load current values)\n   625→  const getInputSettings = useCallback((inputName) => {\n   626→    return new Promise((resolve, reject) => {\n   627→      if (!socket) {\n   628→        reject(new Error('Socket not connected'));\n   629→        return;\n   630→      }\n   631→      console.log('OBSContext: Getting input settings for', inputName);\n   632→      socket.emit('obs:getInputSettings', { inputName }, (response) => {\n   633→        if (response.error) {\n   634→          console.error('OBSContext: Failed to get input settings:', response.error);\n   635→          reject(new Error(response.error));\n   636→        } else {\n   637→          console.log('OBSContext: Received input settings:', response);\n   638→          resolve(response);\n   639→        }\n   640→      });\n   641→    });\n   642→  }, [socket]);\n   643→\n   644→  // Set scene item transform (PRD-OBS-03: Source Management)\n   645→  const setSceneItemTransform = useCallback((sceneName, sceneItemId, transform) => {\n   646→    console.log('OBSContext: Setting scene item transform', sceneName, sceneItemId, transform);\n   647→    socket?.emit('obs:setSceneItemTransform', { sceneName, sceneItemId, transform });\n   648→  }, [socket]);\n   649→\n   650→  // Audio monitoring\n   651→  const setMonitorType = useCallback((inputName, monitorType) => {\n   652→    console.log('OBSContext: Set monitor type', inputName, monitorType);\n   653→    socket?.emit('obs:setMonitorType', { inputName, monitorType });\n   654→  }, [socket]);\n   655→\n   656→  // PRD-OBS-04: Audio level subscription (for real-time VU meters)\n   657→  const subscribeAudioLevels = useCallback(() => {\n   658→    console.log('OBSContext: Subscribing to audio levels');\n   659→    socket?.emit('obs:subscribeAudioLevels', { enabled: true });\n   660→  }, [socket]);\n   661→\n   662→  const unsubscribeAudioLevels = useCallback(() => {\n   663→    console.log('OBSContext: Unsubscribing from audio levels');\n   664→    socket?.emit('obs:subscribeAudioLevels', { enabled: false });\n   665→    // Clear audio levels when unsubscribing\n   666→    setAudioLevels(new Map());\n   667→  }, [socket]);\n   668→\n   669→  // Screenshot capture\n   670→  const takeScreenshot = useCallback(() => {\n   671→    console.log('OBSContext: Taking screenshot');\n   672→    socket?.emit('obs:takeScreenshot');\n   673→  }, [socket]);\n   674→\n   675→  const refreshState = useCallback(() => {\n   676→    console.log('OBSContext: Refreshing state');\n   677→    socket?.emit('obs:refreshState');\n   678→  }, [socket]);\n   679→\n   680→  const connectOBS = useCallback((config) => {\n   681→    console.log('OBSContext: Connecting to OBS', config);\n   682→    socket?.emit('obs:connect', config);\n   683→  }, [socket]);\n   684→\n   685→  const disconnectOBS = useCallback(() => {\n   686→    console.log('OBSContext: Disconnecting from OBS');\n   687→    socket?.emit('obs:disconnect');\n   688→  }, [socket]);\n   689→\n   690→  // PRD-OBS-11: Toggle auto-load template preference\n   691→  const setAutoLoadTemplateEnabled = useCallback((enabled) => {\n   692→    setAutoLoadEnabled(enabled);\n   693→    localStorage.setItem(AUTO_LOAD_TEMPLATE_KEY, String(enabled));\n   694→    console.log('OBSContext: Auto-load template', enabled ? 'enabled' : 'disabled');\n   695→  }, []);\n   696→\n   697→  // PRD-OBS-11: Get default template for a meet type\n   698→  const getDefaultTemplate = useCallback((meetType) => {\n   699→    return new Promise((resolve, reject) => {\n   700→      if (!socket) {\n   701→        reject(new Error('Socket not connected'));\n   702→        return;\n   703→      }\n   704→      console.log('OBSContext: Getting default template for', meetType);\n   705→      socket.emit('obs:getDefaultTemplate', { meetType }, (response) => {\n   706→        if (response.error) {\n   707→          console.error('OBSContext: Failed to get default template:', response.error);\n   708→          reject(new Error(response.error));\n   709→        } else {\n   710→          console.log('OBSContext: Default template result:', response.template?.name || 'none');\n   711→          resolve(response.template);\n   712→        }\n   713→      });\n   714→    });\n   715→  }, [socket]);\n   716→\n   717→  // PRD-OBS-11: Reset auto-apply state (called when entering a new competition)\n   718→  const resetAutoApplyState = useCallback(() => {\n   719→    hasAttemptedAutoApply.current = false;\n   720→    setAutoAppliedTemplate(null);\n   721→  }, []);\n   722→\n   723→  const value = {\n   724→    // State\n   725→    obsState,\n   726→    obsConnected,\n   727→    connectionError,\n   728→\n   729→    // Scene actions\n   730→    switchScene,\n   731→    setPreviewScene,\n   732→    transitionToProgram,\n   733→\n   734→    // Transition actions\n   735→    setTransition,\n   736→    setCurrentTransition,\n   737→    setTransitionDuration,\n   738→    getTransitions,\n   739→    setTransitionSettings,\n   740→    getTransitionSettings,\n   741→\n   742→    // Audio actions\n   743→    setVolume,\n   744→    setMute,\n   745→\n   746→    // Preset actions (PRD-OBS-04 Phase 1.5)\n   747→    loadPreset,\n   748→    applyPreset,\n   749→    listPresets,\n   750→    savePreset,\n   751→    deletePreset,\n   752→    presets,\n   753→    presetsLoading,\n   754→    presetApplying,\n   755→\n   756→    // Streaming actions\n   757→    startStream,\n   758→    stopStream,\n   759→    getStreamSettings,\n   760→    setStreamSettings,\n   761→    getStreamStatus,\n   762→    restoreStreamSettings,\n   763→    deleteStoredStreamKey,\n   764→\n   765→    // Recording actions\n   766→    startRecording,\n   767→    stopRecording,\n   768→    pauseRecording,\n   769→    resumeRecording,\n   770→    getRecordingStatus,\n   771→\n   772→    // Studio mode actions\n   773→    enableStudioMode,\n   774→    disableStudioMode,\n   775→\n   776→    // Scene CRUD actions\n   777→    createScene,\n   778→    deleteScene,\n   779→    deleteAllScenes,\n   780→    duplicateScene,\n   781→    renameScene,\n   782→    reorderScenes,\n   783→\n   784→    // Scene item actions\n   785→    toggleItemVisibility,\n   786→    toggleItemLock,\n   787→    deleteSceneItem,\n   788→    reorderSceneItems,\n   789→    applyTransformPreset,\n   790→    addSourceToScene,\n   791→    createInput,\n   792→    removeInput,\n   793→    updateInputSettings,\n   794→    getInputSettings,\n   795→    setSceneItemTransform,\n   796→\n   797→    // Audio monitoring\n   798→    setMonitorType,\n   799→\n   800→    // PRD-OBS-04: Real-time audio levels\n   801→    audioLevels,\n   802→    subscribeAudioLevels,\n   803→    unsubscribeAudioLevels,\n   804→\n   805→    // Screenshot capture\n   806→    takeScreenshot,\n   807→\n   808→    // Connection actions\n   809→    refreshState,\n   810→    connectOBS,\n   811→    disconnectOBS,\n   812→\n   813→    // PRD-OBS-11: Template auto-loading\n   814→    autoLoadEnabled,\n   815→    setAutoLoadTemplateEnabled,\n   816→    autoAppliedTemplate,\n   817→    getDefaultTemplate,\n   818→    resetAutoApplyState\n   819→  };\n   820→\n   821→  return (\n   822→    <OBSContext.Provider value={value}>\n   823→      {children}\n   824→    </OBSContext.Provider>\n   825→  );\n   826→}\n   827→\n   828→export function useOBS() {\n   829→  const context = useContext(OBSContext);\n   830→  if (!context) {\n   831→    throw new Error('useOBS must be used within an OBSProvider');\n   832→  }\n   833→  return context;\n   834→}\n   835→\n   836→export { OBSContext };\n   837→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"80813a13-8d65-4e4c-b211-0298af3d1836","uuid":"0e7b072b-0f67-41cd-97d1-1df9ab2a6ae9","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/context/OBSContext.jsx","content":"import { createContext, useContext, useEffect, useState, useCallback, useRef } from 'react';\nimport { useShow } from './ShowContext';\n\nconst OBSContext = createContext(null);\n\n// Local storage key for auto-load preference\nconst AUTO_LOAD_TEMPLATE_KEY = 'obs-auto-load-template';\n\n// Initial state values\nconst INITIAL_OBS_STATE = {\n  connected: false,\n  scenes: [],\n  currentScene: null,\n  previewScene: null,\n  inputs: [],\n  audioSources: [],\n  transitions: [],\n  currentTransition: null,\n  streaming: false,\n  recording: false,\n  recordingPaused: false,\n  studioModeEnabled: false,\n  connectionError: null,\n  // PRD-OBS-06: Stream & Recording state\n  streamSettings: null,\n  streamStatus: null,\n  recordingStatus: null\n};\n\n// Initial audio levels state (PRD-OBS-04: Real-time Audio Levels)\nconst INITIAL_AUDIO_LEVELS = new Map();\n\nexport function OBSProvider({ children }) {\n  // Get socket from ShowContext\n  const { socket, connected } = useShow();\n\n  // State - obsConnected is derived from obsState.connected (set by obs:stateUpdated event)\n  const [obsState, setObsState] = useState(INITIAL_OBS_STATE);\n  const [connectionError, setConnectionError] = useState(null);\n\n  // PRD-OBS-04: Real-time audio levels state\n  const [audioLevels, setAudioLevels] = useState(INITIAL_AUDIO_LEVELS);\n\n  // PRD-OBS-04 Phase 1.5: Audio presets state\n  const [presets, setPresets] = useState([]);\n  const [presetsLoading, setPresetsLoading] = useState(false);\n  const [presetApplying, setPresetApplying] = useState(null); // presetId being applied\n\n  // PRD-OBS-11: Template auto-loading state\n  const [autoLoadEnabled, setAutoLoadEnabled] = useState(() => {\n    const stored = localStorage.getItem(AUTO_LOAD_TEMPLATE_KEY);\n    return stored === null ? true : stored === 'true';\n  });\n  const [autoAppliedTemplate, setAutoAppliedTemplate] = useState(null);\n  const hasAttemptedAutoApply = useRef(false);\n\n  // obsConnected comes from obsState which is updated directly by obs:stateUpdated\n  // This ensures OBSManager sees the connected state immediately when the event fires\n  const obsConnected = obsState?.connected ?? false;\n\n  // Subscribe to socket events\n  useEffect(() => {\n    if (!socket || !connected) {\n      console.log('OBSContext: Socket not available or not connected');\n      return;\n    }\n\n    console.log('OBSContext: Setting up OBS event listeners');\n\n    const handleStateUpdate = (state) => {\n      console.log('OBSContext: State update received', state);\n      setObsState(state);\n      setConnectionError(state?.connectionError ?? null);\n    };\n\n    const handleConnected = (data) => {\n      console.log('OBSContext: OBS connected', data);\n      setObsState(prev => ({ ...prev, connected: true }));\n      setConnectionError(null);\n    };\n\n    const handleDisconnected = (data) => {\n      console.log('OBSContext: OBS disconnected', data);\n      setObsState(prev => ({ ...prev, connected: false }));\n      if (data?.error) {\n        setConnectionError(data.error);\n      }\n    };\n\n    const handleSceneChanged = (data) => {\n      const sceneName = data?.sceneName || data;\n      console.log('OBSContext: Scene changed to', sceneName);\n      setObsState(prev => ({\n        ...prev,\n        currentScene: sceneName\n      }));\n    };\n\n    const handlePreviewSceneChanged = (data) => {\n      console.log('OBSContext: Preview scene changed', data);\n      setObsState(prev => ({\n        ...prev,\n        previewScene: data.sceneName\n      }));\n    };\n\n    const handleStreamingStateChanged = (data) => {\n      console.log('OBSContext: Streaming state changed', data);\n      setObsState(prev => ({\n        ...prev,\n        streaming: data.active\n      }));\n    };\n\n    const handleRecordingStateChanged = (data) => {\n      console.log('OBSContext: Recording state changed', data);\n      setObsState(prev => ({\n        ...prev,\n        recording: data.active\n      }));\n    };\n\n    const handleTransitionChanged = (data) => {\n      console.log('OBSContext: Transition changed', data);\n      setObsState(prev => ({\n        ...prev,\n        currentTransition: data.transitionName\n      }));\n    };\n\n    // PRD-OBS-05: Handle transitions list response\n    const handleTransitionsList = (data) => {\n      console.log('OBSContext: Transitions list received', data);\n      setObsState(prev => ({\n        ...prev,\n        transitions: data.transitions || [],\n        currentTransition: data.currentTransition,\n        transitionDuration: data.transitionDuration\n      }));\n    };\n\n    const handleError = (data) => {\n      console.error('OBSContext: Error received', data);\n      setConnectionError(data?.message || 'Unknown OBS error');\n      setTimeout(() => setConnectionError(null), 5000);\n    };\n\n    const handleScreenshotCaptured = (data) => {\n      console.log('OBSContext: Screenshot captured', data.sceneName, data.timestamp);\n      // Download the screenshot as a file\n      if (data.imageData) {\n        const link = document.createElement('a');\n        link.href = data.imageData;\n        link.download = `screenshot-${data.sceneName}-${Date.now()}.png`;\n        document.body.appendChild(link);\n        link.click();\n        document.body.removeChild(link);\n      }\n    };\n\n    // PRD-OBS-06: Stream settings response handler\n    const handleStreamSettings = (data) => {\n      console.log('OBSContext: Stream settings received', data);\n      setObsState(prev => ({\n        ...prev,\n        streamSettings: data\n      }));\n    };\n\n    // PRD-OBS-06: Stream status response handler\n    const handleStreamStatus = (data) => {\n      console.log('OBSContext: Stream status received', data);\n      setObsState(prev => ({\n        ...prev,\n        streamStatus: data,\n        streaming: data.active\n      }));\n    };\n\n    // PRD-OBS-06: Recording status response handler\n    const handleRecordingStatus = (data) => {\n      console.log('OBSContext: Recording status received', data);\n      setObsState(prev => ({\n        ...prev,\n        recordingStatus: data,\n        recording: data.active,\n        recordingPaused: data.paused\n      }));\n    };\n\n    // PRD-OBS-06: Stream started confirmation\n    const handleStreamStarted = () => {\n      console.log('OBSContext: Stream started');\n      setObsState(prev => ({\n        ...prev,\n        streaming: true\n      }));\n    };\n\n    // PRD-OBS-06: Stream stopped confirmation\n    const handleStreamStopped = () => {\n      console.log('OBSContext: Stream stopped');\n      setObsState(prev => ({\n        ...prev,\n        streaming: false,\n        streamStatus: null\n      }));\n    };\n\n    // PRD-OBS-06: Recording started confirmation\n    const handleRecordingStarted = () => {\n      console.log('OBSContext: Recording started');\n      setObsState(prev => ({\n        ...prev,\n        recording: true,\n        recordingPaused: false\n      }));\n    };\n\n    // PRD-OBS-06: Recording stopped confirmation\n    const handleRecordingStopped = (data) => {\n      console.log('OBSContext