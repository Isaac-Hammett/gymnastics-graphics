{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G58MgZtLMsaTzeJ9chtvx9","type":"tool_result","content":"     1→/**\n     2→ * ChecklistPage - Production Checklist for Competition\n     3→ *\n     4→ * Main page for the production checklist system. Shows all pre-flight items\n     5→ * a producer must complete before going live, grouped by phase and category.\n     6→ *\n     7→ * Features:\n     8→ * - Progress bar showing overall completion\n     9→ * - Phase tabs (Setup, Pre-Prod, 2hr Before, 1hr Before)\n    10→ * - Collapsible categories\n    11→ * - Auto-validated items (show system state)\n    12→ * - Manual items (checkboxes)\n    13→ * - Skeleton loading states\n    14→ *\n    15→ * Reference: docs/PRD-Production-Checklist/PRD-Production-Checklist-2026-01-24.md\n    16→ */\n    17→\n    18→import { useState, useMemo } from 'react';\n    19→import { Link } from 'react-router-dom';\n    20→import {\n    21→  ChevronDownIcon,\n    22→  ChevronRightIcon,\n    23→  CheckCircleIcon,\n    24→  ExclamationTriangleIcon,\n    25→  XCircleIcon,\n    26→  ClockIcon,\n    27→  ArrowPathIcon,\n    28→} from '@heroicons/react/24/solid';\n    29→import {\n    30→  ArrowLeftIcon,\n    31→} from '@heroicons/react/24/outline';\n    32→import { useCompetition } from '../context/CompetitionContext';\n    33→import { useProductionChecklist } from '../hooks/useProductionChecklist';\n    34→\n    35→/**\n    36→ * Status icon component for checklist items\n    37→ */\n    38→function StatusIcon({ status, className = '' }) {\n    39→  const iconClass = `w-5 h-5 ${className}`;\n    40→\n    41→  switch (status) {\n    42→    case 'complete':\n    43→      return <CheckCircleIcon className={`${iconClass} text-green-500`} />;\n    44→    case 'warning':\n    45→      return <ExclamationTriangleIcon className={`${iconClass} text-amber-500`} />;\n    46→    case 'error':\n    47→      return <XCircleIcon className={`${iconClass} text-red-500`} />;\n    48→    case 'checking':\n    49→      return <ArrowPathIcon className={`${iconClass} text-zinc-500 animate-spin`} />;\n    50→    default:\n    51→      return <div className={`${iconClass} rounded-full border-2 border-zinc-500`} />;\n    52→  }\n    53→}\n    54→\n    55→/**\n    56→ * Skeleton loading component for checklist items\n    57→ */\n    58→function ChecklistSkeleton() {\n    59→  return (\n    60→    <div className=\"space-y-6 animate-pulse\">\n    61→      {/* Progress bar skeleton */}\n    62→      <div className=\"bg-zinc-800 rounded-lg p-4\">\n    63→        <div className=\"h-4 bg-zinc-700 rounded w-1/3 mb-3\" />\n    64→        <div className=\"h-3 bg-zinc-700 rounded-full w-full mb-2\" />\n    65→        <div className=\"flex gap-4\">\n    66→          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n    67→          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n    68→          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n    69→        </div>\n    70→      </div>\n    71→\n    72→      {/* Phase tabs skeleton */}\n    73→      <div className=\"flex gap-2\">\n    74→        {[1, 2, 3, 4].map(i => (\n    75→          <div key={i} className=\"h-10 bg-zinc-700 rounded-lg w-28\" />\n    76→        ))}\n    77→      </div>\n    78→\n    79→      {/* Category skeletons */}\n    80→      {[1, 2, 3].map(i => (\n    81→        <div key={i} className=\"bg-zinc-800 rounded-lg p-4\">\n    82→          <div className=\"h-5 bg-zinc-700 rounded w-48 mb-4\" />\n    83→          <div className=\"space-y-3\">\n    84→            {[1, 2, 3, 4].map(j => (\n    85→              <div key={j} className=\"flex items-center gap-3\">\n    86→                <div className=\"w-5 h-5 bg-zinc-700 rounded-full\" />\n    87→                <div className=\"h-4 bg-zinc-700 rounded flex-1\" />\n    88→              </div>\n    89→            ))}\n    90→          </div>\n    91→        </div>\n    92→      ))}\n    93→    </div>\n    94→  );\n    95→}\n    96→\n    97→/**\n    98→ * Progress bar component showing completion stats\n    99→ */\n   100→function ChecklistProgress({ summary }) {\n   101→  const { total, complete, warnings, errors, pending, percentage } = summary;\n   102→\n   103→  return (\n   104→    <div className=\"bg-zinc-800 rounded-lg p-4\">\n   105→      <div className=\"flex items-center justify-between mb-2\">\n   106→        <span className=\"text-lg font-semibold text-white\">\n   107→          {percentage}% Complete\n   108→        </span>\n   109→        <span className=\"text-sm text-zinc-400\">\n   110→          {complete}/{total} items\n   111→        </span>\n   112→      </div>\n   113→\n   114→      {/* Progress bar */}\n   115→      <div className=\"h-3 bg-zinc-700 rounded-full overflow-hidden mb-3\">\n   116→        <div\n   117→          className=\"h-full bg-green-500 transition-all duration-300\"\n   118→          style={{ width: `${percentage}%` }}\n   119→        />\n   120→      </div>\n   121→\n   122→      {/* Stats row */}\n   123→      <div className=\"flex gap-4 text-sm\">\n   124→        <span className=\"flex items-center gap-1.5\">\n   125→          <CheckCircleIcon className=\"w-4 h-4 text-green-500\" />\n   126→          <span className=\"text-zinc-300\">{complete} complete</span>\n   127→        </span>\n   128→        {warnings > 0 && (\n   129→          <span className=\"flex items-center gap-1.5\">\n   130→            <ExclamationTriangleIcon className=\"w-4 h-4 text-amber-500\" />\n   131→            <span className=\"text-zinc-300\">{warnings} warnings</span>\n   132→          </span>\n   133→        )}\n   134→        {errors > 0 && (\n   135→          <span className=\"flex items-center gap-1.5\">\n   136→            <XCircleIcon className=\"w-4 h-4 text-red-500\" />\n   137→            <span className=\"text-zinc-300\">{errors} errors</span>\n   138→          </span>\n   139→        )}\n   140→        {pending > 0 && (\n   141→          <span className=\"flex items-center gap-1.5\">\n   142→            <ClockIcon className=\"w-4 h-4 text-zinc-500\" />\n   143→            <span className=\"text-zinc-300\">{pending} pending</span>\n   144→          </span>\n   145→        )}\n   146→      </div>\n   147→    </div>\n   148→  );\n   149→}\n   150→\n   151→/**\n   152→ * Phase tab component\n   153→ */\n   154→function PhaseTab({ phase, isActive, onClick, itemCounts }) {\n   155→  // Calculate phase completion status\n   156→  const { complete, total } = itemCounts;\n   157→  const percentage = total > 0 ? Math.round((complete / total) * 100) : 0;\n   158→\n   159→  let statusIndicator;\n   160→  if (percentage === 100) {\n   161→    statusIndicator = <span className=\"text-green-500\">✓</span>;\n   162→  } else if (percentage > 0) {\n   163→    statusIndicator = <span className=\"text-amber-500\">◐</span>;\n   164→  } else {\n   165→    statusIndicator = <span className=\"text-zinc-500\">○</span>;\n   166→  }\n   167→\n   168→  return (\n   169→    <button\n   170→      onClick={onClick}\n   171→      className={`px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2 ${\n   172→        isActive\n   173→          ? 'bg-blue-600 text-white'\n   174→          : 'bg-zinc-800 text-zinc-300 hover:bg-zinc-700'\n   175→      }`}\n   176→    >\n   177→      {statusIndicator}\n   178→      <span>{phase.shortName}</span>\n   179→    </button>\n   180→  );\n   181→}\n   182→\n   183→/**\n   184→ * Category section component (collapsible)\n   185→ */\n   186→function ChecklistCategory({ category, expanded, onToggle, onItemToggle }) {\n   187→  const completeCount = category.items.filter(i => i.status === 'complete').length;\n   188→\n   189→  return (\n   190→    <div className=\"bg-zinc-800 rounded-lg overflow-hidden\">\n   191→      {/* Category header */}\n   192→      <button\n   193→        onClick={onToggle}\n   194→        className=\"w-full flex items-center justify-between px-4 py-3 hover:bg-zinc-700 transition-colors\"\n   195→      >\n   196→        <div className=\"flex items-center gap-3\">\n   197→          {expanded ? (\n   198→            <ChevronDownIcon className=\"w-5 h-5 text-zinc-400\" />\n   199→          ) : (\n   200→            <ChevronRightIcon className=\"w-5 h-5 text-zinc-400\" />\n   201→          )}\n   202→          <span className=\"font-medium text-white\">{category.name}</span>\n   203→        </div>\n   204→        <span className=\"text-sm text-zinc-400\">\n   205→          {completeCount}/{category.items.length}\n   206→        </span>\n   207→      </button>\n   208→\n   209→      {/* Items list */}\n   210→      {expanded && (\n   211→        <div className=\"px-4 pb-3 space-y-1\">\n   212→          {category.items.map(item => (\n   213→            <ChecklistItem\n   214→              key={item.id}\n   215→              item={item}\n   216→              onToggle={() => onItemToggle(item.id)}\n   217→            />\n   218→          ))}\n   219→        </div>\n   220→      )}\n   221→    </div>\n   222→  );\n   223→}\n   224→\n   225→/**\n   226→ * Individual checklist item component\n   227→ */\n   228→function ChecklistItem({ item, onToggle }) {\n   229→  const isManual = item.type === 'manual';\n   230→  const isClickable = isManual;\n   231→\n   232→  return (\n   233→    <div\n   234→      className={`flex items-center gap-3 py-2 px-2 rounded ${\n   235→        isClickable ? 'hover:bg-zinc-700 cursor-pointer' : ''\n   236→      }`}\n   237→      onClick={isClickable ? onToggle : undefined}\n   238→    >\n   239→      {/* Status icon or checkbox */}\n   240→      {isManual ? (\n   241→        <input\n   242→          type=\"checkbox\"\n   243→          checked={item.checked}\n   244→          onChange={onToggle}\n   245→          onClick={e => e.stopPropagation()}\n   246→          className=\"w-5 h-5 rounded border-2 border-zinc-500 bg-transparent checked:bg-green-500 checked:border-green-500 cursor-pointer\"\n   247→        />\n   248→      ) : (\n   249→        <StatusIcon status={item.status} />\n   250→      )}\n   251→\n   252→      {/* Item name */}\n   253→      <span className={`flex-1 ${item.status === 'complete' ? 'text-zinc-300' : 'text-white'}`}>\n   254→        {item.name}\n   255→      </span>\n   256→\n   257→      {/* Detail text for auto-validated items */}\n   258→      {item.detail && (\n   259→        <span className=\"text-sm text-zinc-500\">{item.detail}</span>\n   260→      )}\n   261→\n   262→      {/* Fix link for failed auto items */}\n   263→      {item.type === 'auto' && item.status === 'error' && item.fixLink && (\n   264→        <Link\n   265→          to={item.fixLink}\n   266→          onClick={e => e.stopPropagation()}\n   267→          className=\"text-sm text-blue-400 hover:text-blue-300\"\n   268→        >\n   269→          Fix\n   270→        </Link>\n   271→      )}\n   272→    </div>\n   273→  );\n   274→}\n   275→\n   276→/**\n   277→ * Main ChecklistPage component\n   278→ */\n   279→export default function ChecklistPage() {\n   280→  const { compId, competitionConfig } = useCompetition();\n   281→  const {\n   282→    phases,\n   283→    summary,\n   284→    toggleItem,\n   285→    loading,\n   286→    lastUpdated,\n   287→  } = useProductionChecklist();\n   288→\n   289→  // Active phase tab\n   290→  const [activePhaseId, setActivePhaseId] = useState('setup');\n   291→\n   292→  // Expanded categories (all expanded by default)\n   293→  const [expandedCategories, setExpandedCategories] = useState(new Set());\n   294→\n   295→  // Initialize expanded categories when phases load\n   296→  useMemo(() => {\n   297→    if (phases?.length && expandedCategories.size === 0) {\n   298→      const allCategories = new Set();\n   299→      phases.forEach(phase => {\n   300→        phase.categories.forEach(cat => {\n   301→          allCategories.add(cat.id);\n   302→        });\n   303→      });\n   304→      setExpandedCategories(allCategories);\n   305→    }\n   306→  }, [phases]);\n   307→\n   308→  // Get active phase\n   309→  const activePhase = phases?.find(p => p.id === activePhaseId) || phases?.[0];\n   310→\n   311→  // Calculate item counts per phase\n   312→  const phaseItemCounts = useMemo(() => {\n   313→    const counts = {};\n   314→    phases?.forEach(phase => {\n   315→      let complete = 0;\n   316→      let total = 0;\n   317→      phase.categories.forEach(cat => {\n   318→        cat.items.forEach(item => {\n   319→          total++;\n   320→          if (item.status === 'complete') complete++;\n   321→        });\n   322→      });\n   323→      counts[phase.id] = { complete, total };\n   324→    });\n   325→    return counts;\n   326→  }, [phases]);\n   327→\n   328→  // Toggle category expansion\n   329→  const toggleCategory = (categoryId) => {\n   330→    setExpandedCategories(prev => {\n   331→      const next = new Set(prev);\n   332→      if (next.has(categoryId)) {\n   333→        next.delete(categoryId);\n   334→      } else {\n   335→        next.add(categoryId);\n   336→      }\n   337→      return next;\n   338→    });\n   339→  };\n   340→\n   341→  // Handle item toggle with error handling\n   342→  const handleItemToggle = async (itemId) => {\n   343→    try {\n   344→      await toggleItem(itemId);\n   345→    } catch (error) {\n   346→      // Toast will be added in Task 8\n   347→      console.error('Failed to toggle item:', error);\n   348→    }\n   349→  };\n   350→\n   351→  // Format last updated timestamp\n   352→  const formattedLastUpdated = lastUpdated\n   353→    ? new Date(lastUpdated).toLocaleString()\n   354→    : null;\n   355→\n   356→  return (\n   357→    <div className=\"min-h-screen bg-zinc-900 text-white\">\n   358→      {/* Header */}\n   359→      <header className=\"bg-zinc-800 border-b border-zinc-700 px-6 py-4\">\n   360→        <div className=\"flex items-center justify-between\">\n   361→          <div className=\"flex items-center gap-4\">\n   362→            <Link\n   363→              to={`/${compId}/producer`}\n   364→              className=\"text-zinc-400 hover:text-white transition-colors\"\n   365→            >\n   366→              <ArrowLeftIcon className=\"w-5 h-5\" />\n   367→            </Link>\n   368→            <div>\n   369→              <h1 className=\"text-xl font-bold\">Production Checklist</h1>\n   370→              <p className=\"text-sm text-zinc-400\">\n   371→                {competitionConfig?.eventName || 'Competition'}\n   372→              </p>\n   373→            </div>\n   374→          </div>\n   375→\n   376→          {formattedLastUpdated && (\n   377→            <span className=\"text-sm text-zinc-500\">\n   378→              Last updated: {formattedLastUpdated}\n   379→            </span>\n   380→          )}\n   381→        </div>\n   382→      </header>\n   383→\n   384→      {/* Main content */}\n   385→      <main className=\"max-w-5xl mx-auto px-6 py-6\">\n   386→        {loading ? (\n   387→          <ChecklistSkeleton />\n   388→        ) : (\n   389→          <div className=\"space-y-6\">\n   390→            {/* Progress bar */}\n   391→            <ChecklistProgress summary={summary} />\n   392→\n   393→            {/* Phase tabs */}\n   394→            <div className=\"flex gap-2 flex-wrap\">\n   395→              {phases?.map(phase => (\n   396→                <PhaseTab\n   397→                  key={phase.id}\n   398→                  phase={phase}\n   399→                  isActive={phase.id === activePhaseId}\n   400→                  onClick={() => setActivePhaseId(phase.id)}\n   401→                  itemCounts={phaseItemCounts[phase.id] || { complete: 0, total: 0 }}\n   402→                />\n   403→              ))}\n   404→            </div>\n   405→\n   406→            {/* Categories for active phase */}\n   407→            <div className=\"space-y-4\">\n   408→              {activePhase?.categories.map(category => (\n   409→                <ChecklistCategory\n   410→                  key={category.id}\n   411→                  category={category}\n   412→                  expanded={expandedCategories.has(category.id)}\n   413→                  onToggle={() => toggleCategory(category.id)}\n   414→                  onItemToggle={handleItemToggle}\n   415→                />\n   416→              ))}\n   417→            </div>\n   418→          </div>\n   419→        )}\n   420→      </main>\n   421→    </div>\n   422→  );\n   423→}\n   424→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"de8042c3-0326-4104-811b-130b46417532","uuid":"41a08f69-73f2-4923-9d11-7a8f9de0533e","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/pages/ChecklistPage.jsx","content":"/**\n * ChecklistPage - Production Checklist for Competition\n *\n * Main page for the production checklist system. Shows all pre-flight items\n * a producer must complete before going live, grouped by phase and category.\n *\n * Features:\n * - Progress bar showing overall completion\n * - Phase tabs (Setup, Pre-Prod, 2hr Before, 1hr Before)\n * - Collapsible categories\n * - Auto-validated items (show system state)\n * - Manual items (checkboxes)\n * - Skeleton loading states\n *\n * Reference: docs/PRD-Production-Checklist/PRD-Production-Checklist-2026-01-24.md\n */\n\nimport { useState, useMemo } from 'react';\nimport { Link } from 'react-router-dom';\nimport {\n  ChevronDownIcon,\n  ChevronRightIcon,\n  CheckCircleIcon,\n  ExclamationTriangleIcon,\n  XCircleIcon,\n  ClockIcon,\n  ArrowPathIcon,\n} from '@heroicons/react/24/solid';\nimport {\n  ArrowLeftIcon,\n} from '@heroicons/react/24/outline';\nimport { useCompetition } from '../context/CompetitionContext';\nimport { useProductionChecklist } from '../hooks/useProductionChecklist';\n\n/**\n * Status icon component for checklist items\n */\nfunction StatusIcon({ status, className = '' }) {\n  const iconClass = `w-5 h-5 ${className}`;\n\n  switch (status) {\n    case 'complete':\n      return <CheckCircleIcon className={`${iconClass} text-green-500`} />;\n    case 'warning':\n      return <ExclamationTriangleIcon className={`${iconClass} text-amber-500`} />;\n    case 'error':\n      return <XCircleIcon className={`${iconClass} text-red-500`} />;\n    case 'checking':\n      return <ArrowPathIcon className={`${iconClass} text-zinc-500 animate-spin`} />;\n    default:\n      return <div className={`${iconClass} rounded-full border-2 border-zinc-500`} />;\n  }\n}\n\n/**\n * Skeleton loading component for checklist items\n */\nfunction ChecklistSkeleton() {\n  return (\n    <div className=\"space-y-6 animate-pulse\">\n      {/* Progress bar skeleton */}\n      <div className=\"bg-zinc-800 rounded-lg p-4\">\n        <div className=\"h-4 bg-zinc-700 rounded w-1/3 mb-3\" />\n        <div className=\"h-3 bg-zinc-700 rounded-full w-full mb-2\" />\n        <div className=\"flex gap-4\">\n          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n          <div className=\"h-3 bg-zinc-700 rounded w-24\" />\n        </div>\n      </div>\n\n      {/* Phase tabs skeleton */}\n      <div className=\"flex gap-2\">\n        {[1, 2, 3, 4].map(i => (\n          <div key={i} className=\"h-10 bg-zinc-700 rounded-lg w-28\" />\n        ))}\n      </div>\n\n      {/* Category skeletons */}\n      {[1, 2, 3].map(i => (\n        <div key={i} className=\"bg-zinc-800 rounded-lg p-4\">\n          <div className=\"h-5 bg-zinc-700 rounded w-48 mb-4\" />\n          <div className=\"space-y-3\">\n            {[1, 2, 3, 4].map(j => (\n              <div key={j} className=\"flex items-center gap-3\">\n                <div className=\"w-5 h-5 bg-zinc-700 rounded-full\" />\n                <div className=\"h-4 bg-zinc-700 rounded flex-1\" />\n              </div>\n            ))}\n          </div>\n        </div>\n      ))}\n    </div>\n  );\n}\n\n/**\n * Progress bar component showing completion stats\n */\nfunction ChecklistProgress({ summary }) {\n  const { total, complete, warnings, errors, pending, percentage } = summary;\n\n  return (\n    <div className=\"bg-zinc-800 rounded-lg p-4\">\n      <div className=\"flex items-center justify-between mb-2\">\n        <span className=\"text-lg font-semibold text-white\">\n          {percentage}% Complete\n        </span>\n        <span className=\"text-sm text-zinc-400\">\n          {complete}/{total} items\n        </span>\n      </div>\n\n      {/* Progress bar */}\n      <div className=\"h-3 bg-zinc-700 rounded-full overflow-hidden mb-3\">\n        <div\n          className=\"h-full bg-green-500 transition-all duration-300\"\n          style={{ width: `${percentage}%` }}\n        />\n      </div>\n\n      {/* Stats row */}\n      <div className=\"flex gap-4 text-sm\">\n        <span className=\"flex items-center gap-1.5\">\n          <CheckCircleIcon className=\"w-4 h-4 text-green-500\" />\n          <span className=\"text-zinc-300\">{complete} complete</span>\n        </span>\n        {warnings > 0 && (\n          <span className=\"flex items-center gap-1.5\">\n            <ExclamationTriangleIcon className=\"w-4 h-4 text-amber-500\" />\n            <span className=\"text-zinc-300\">{warnings} warnings</span>\n          </span>\n        )}\n        {errors > 0 && (\n          <span className=\"flex items-center gap-1.5\">\n            <XCircleIcon className=\"w-4 h-4 text-red-500\" />\n            <span className=\"text-zinc-300\">{errors} errors</span>\n          </span>\n        )}\n        {pending > 0 && (\n          <span className=\"flex items-center gap-1.5\">\n            <ClockIcon className=\"w-4 h-4 text-zinc-500\" />\n            <span className=\"text-zinc-300\">{pending} pending</span>\n          </span>\n        )}\n      </div>\n    </div>\n  );\n}\n\n/**\n * Phase tab component\n */\nfunction PhaseTab({ phase, isActive, onClick, itemCounts }) {\n  // Calculate phase completion status\n  const { complete, total } = itemCounts;\n  const percentage = total > 0 ? Math.round((complete / total) * 100) : 0;\n\n  let statusIndicator;\n  if (percentage === 100) {\n    statusIndicator = <span className=\"text-green-500\">✓</span>;\n  } else if (percentage > 0) {\n    statusIndicator = <span className=\"text-amber-500\">◐</span>;\n  } else {\n    statusIndicator = <span className=\"text-zinc-500\">○</span>;\n  }\n\n  return (\n    <button\n      onClick={onClick}\n      className={`px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2 ${\n        isActive\n          ? 'bg-blue-600 text-white'\n          : 'bg-zinc-800 text-zinc-300 hover:bg-zinc-700'\n      }`}\n    >\n      {statusIndicator}\n      <span>{phase.shortName}</span>\n    </button>\n  );\n}\n\n/**\n * Category section component (collapsible)\n */\nfunction ChecklistCategory({ category, expanded, onToggle, onItemToggle }) {\n  const completeCount = category.items.filter(i => i.status === 'complete').length;\n\n  return (\n    <div className=\"bg-zinc-800 rounded-lg overflow-hidden\">\n      {/* Category header */}\n      <button\n        onClick={onToggle}\n        className=\"w-full flex items-center justify-between px-4 py-3 hover:bg-zinc-700 transition-colors\"\n      >\n        <div className=\"flex items-center gap-3\">\n          {expanded ? (\n            <ChevronDownIcon className=\"w-5 h-5 text-zinc-400\" />\n          ) : (\n            <ChevronRightIcon className=\"w-5 h-5 text-zinc-400\" />\n          )}\n          <span className=\"font-medium text-white\">{category.name}</span>\n        </div>\n        <span className=\"text-sm text-zinc-400\">\n          {completeCount}/{category.items.length}\n        </span>\n      </button>\n\n      {/* Items list */}\n      {expanded && (\n        <div className=\"px-4 pb-3 space-y-1\">\n          {category.items.map(item => (\n            <ChecklistItem\n              key={item.id}\n              item={item}\n              onToggle={() => onItemToggle(item.id)}\n            />\n          ))}\n        </div>\n      )}\n    </div>\n  );\n}\n\n/**\n * Individual checklist item component\n */\nfunction ChecklistItem({ item, onToggle }) {\n  const isManual = item.type === 'manual';\n  const isClickable = isManual;\n\n  return (\n    <div\n      className={`flex items-center gap-3 py-2 px-2 rounded ${\n        isClickable ? 'hover:bg-zinc-700 cursor-pointer' : ''\n      }`}\n      onClick={isClickable ? onToggle : undefined}\n    >\n      {/* Status icon or checkbox */}\n      {isManual ? (\n        <input\n          type=\"checkbox\"\n          checked={item.checked}\n          onChange={onToggle}\n          onClick={e => e.stopPropagation()}\n          className=\"w-5 h-5 rounded border-2 border-zinc-500 bg-transparent checked:bg-green-500 checked:border-green-500 cursor-pointer\"\n        />\n      ) : (\n        <StatusIcon status={item.status} />\n      )}\n\n      {/* Item name */}\n      <span className={`flex-1 ${item.status === 'complete' ? 'text-zinc-300' : 'text-white'}`}>\n        {item.name}\n      </span>\n\n      {/* Detail text for auto-validated items */}\n      {item.detail && (\n        <span className=\"text-sm text-zinc-500\">{item.detail}</span>\n      )}\n\n      {/* Fix link for failed auto items */}\n      {item.type === 'auto' && item.status === 'error' && item.fixLink && (\n        <Link\n          to={item.fixLink}\n          onClick={e => e.stopPropagation()}\n          className=\"text-sm text-blue-400 hover:text-blue-300\"\n        >\n          Fix\n        </Link>\n      )}\n    </div>\n  );\n}\n\n/**\n * Main ChecklistPage component\n */\nexport default function ChecklistPage() {\n  const { compId, competitionConfig } = useCompetition();\n  const {\n    phases,\n    summary,\n    toggleItem,\n    loading,\n    lastUpdated,\n  } = useProductionChecklist();\n\n  // Active phase tab\n  const [activePhaseId, setActivePhaseId] = useState('setup');\n\n  // Expanded categories (all expanded by default)\n  const [expandedCategories, setExpandedCategories] = useState(new Set());\n\n  // Initialize expanded categories when phases load\n  useMemo(() => {\n    if (phases?.length && expandedCategories.size === 0) {\n      const allCategories = new Set();\n      phases.forEach(phase => {\n        phase.categories.forEach(cat => {\n          allCategories.add(cat.id);\n        });\n      });\n      setExpandedCategories(allCategories);\n    }\n  }, [phases]);\n\n  // Get active phase\n  const activePhase = phases?.find(p => p.id === activePhaseId) || phases?.[0];\n\n  // Calculate item counts per phase\n  const phaseItemCounts = useMemo(() => {\n    const counts = {};\n    phases?.forEach(phase => {\n      let complete = 0;\n      let total = 0;\n      phase.categories.forEach(cat => {\n        cat.items.forEach(item => {\n          total++;\n          if (item.status === 'complete') complete++;\n        });\n      });\n      counts[phase.id] = { complete, total };\n    });\n    return counts;\n  }, [phases]);\n\n  // Toggle category expansion\n  const toggleCategory = (categoryId) => {\n    setExpandedCategories(prev => {\n      const next = new Set(prev);\n      if (next.has(categoryId)) {\n        next.delete(categoryId);\n      } else {\n        next.add(categoryId);\n      }\n      return next;\n    });\n  };\n\n  // Handle item toggle with error handling\n  const handleItemToggle = async (itemId) => {\n    try {\n      await toggleItem(itemId);\n    } catch (error) {\n      // Toast will be added in Task 8\n      console.error('Failed to toggle item:', error);\n    }\n  };\n\n  // Format last updated timestamp\n  const formattedLastUpdated = lastUpdated\n    ? new Date(lastUpdated).toLocaleString()\n    : null;\n\n  return (\n    <div className=\"min-h-screen bg-zinc-900 text-white\">\n      {/* Header */}\n      <header className=\"bg-zinc-800 border-b border-zinc-700 px-6 py-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-4\">\n            <Link\n              to={`/${compId}/producer`}\n              className=\"text-zinc-400 hover:text-white transition-colors\"\n            >\n              <ArrowLeftIcon className=\"w-5 h-5\" />\n            </Link>\n            <div>\n              <h1 className=\"text-xl font-bold\">Production Checklist</h1>\n              <p className=\"text-sm text-zinc-400\">\n                {competitionConfig?.eventName || 'Competition'}\n              </p>\n            </div>\n          </div>\n\n          {formattedLastUpdated && (\n            <span className=\"text-sm text-zinc-500\">\n              Last updated: {formattedLastUpdated}\n            </span>\n          )}\n        </div>\n      </header>\n\n      {/* Main content */}\n      <main className=\"max-w-5xl mx-auto px-6 py-6\">\n        {loading ? (\n          <ChecklistSkeleton />\n        ) : (\n          <div className=\"space-y-6\">\n            {/* Progress bar */}\n            <ChecklistProgress summary={summary} />\n\n            {/* Phase tabs */}\n            <div className=\"flex gap-2 flex-wrap\">\n              {phases?.map(phase => (\n                <PhaseTab\n                  key={phase.id}\n                  phase={phase}\n                  isActive={phase.id === activePhaseId}\n                  onClick={() => setActivePhaseId(phase.id)}\n                  itemCounts={phaseItemCounts[phase.id] || { complete: 0, total: 0 }}\n                />\n              ))}\n            </div>\n\n            {/* Categories for active phase */}\n            <div className=\"space-y-4\">\n              {activePhase?.categories.map(category => (\n                <ChecklistCategory\n                  key={category.id}\n                  category={category}\n                  expanded={expandedCategories.has(category.id)}\n                  onToggle={() => toggleCategory(category.id)}\n                  onItemToggle={handleItemToggle}\n                />\n              ))}\n            </div>\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}\n","numLines":424,"startLine":1,"totalLines":424}}}
