{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M9vsRsRukNbhBKGimGBkrZ","type":"tool_result","content":"     1→/**\n     2→ * Competition utility functions for extracting and working with\n     3→ * competition types, gender context, and team keys.\n     4→ *\n     5→ * These functions ensure consistent gender handling throughout the app,\n     6→ * preventing issues where women's competitions fall back to men's team data.\n     7→ */\n     8→\n     9→import { normalizeName } from './nameNormalization';\n    10→\n    11→/**\n    12→ * Extracts the gender string from a competition type.\n    13→ *\n    14→ * @param {string} compType - Competition type (e.g., 'womens-quad', 'mens-dual')\n    15→ * @returns {'womens' | 'mens' | null} Gender string or null if not determinable\n    16→ *\n    17→ * @example\n    18→ * getGenderFromCompType('womens-quad')  // 'womens'\n    19→ * getGenderFromCompType('mens-dual')    // 'mens'\n    20→ * getGenderFromCompType('invalid')      // null\n    21→ */\n    22→export function getGenderFromCompType(compType) {\n    23→  if (!compType || typeof compType !== 'string') return null;\n    24→\n    25→  const normalized = compType.toLowerCase().trim();\n    26→\n    27→  if (normalized.startsWith('womens')) return 'womens';\n    28→  if (normalized.startsWith('mens')) return 'mens';\n    29→\n    30→  // Handle variations like \"women's-dual\" or \"men's-quad\"\n    31→  if (normalized.startsWith(\"women's\") || normalized.startsWith('women-')) return 'womens';\n    32→  if (normalized.startsWith(\"men's\") || normalized.startsWith('men-')) return 'mens';\n    33→\n    34→  return null;\n    35→}\n    36→\n    37→/**\n    38→ * Extracts the gender string from a competition type with a fallback default.\n    39→ *\n    40→ * @param {string} compType - Competition type (e.g., 'womens-quad', 'mens-dual')\n    41→ * @param {'womens' | 'mens'} defaultGender - Fallback gender if not determinable\n    42→ * @returns {'womens' | 'mens'} Gender string (never null)\n    43→ *\n    44→ * @example\n    45→ * getGenderSuffix('womens-quad')           // 'womens'\n    46→ * getGenderSuffix('invalid', 'womens')     // 'womens'\n    47→ * getGenderSuffix(null, 'mens')            // 'mens'\n    48→ */\n    49→export function getGenderSuffix(compType, defaultGender = 'mens') {\n    50→  const gender = getGenderFromCompType(compType);\n    51→  return gender || defaultGender;\n    52→}\n    53→\n    54→/**\n    55→ * Constructs a proper team key from a school name and gender.\n    56→ *\n    57→ * @param {string} schoolName - School/team name (e.g., 'Stanford', 'Navy Men\\'s')\n    58→ * @param {'womens' | 'mens'} gender - Gender suffix to use\n    59→ * @returns {string} Team key (e.g., 'stanford-womens', 'navy-mens')\n    60→ *\n    61→ * @example\n    62→ * buildTeamKey('Stanford', 'womens')       // 'stanford-womens'\n    63→ * buildTeamKey('Navy Men\\'s', 'womens')    // 'navy-womens' (gender override)\n    64→ * buildTeamKey('Greenville', 'mens')       // 'greenville-mens'\n    65→ */\n    66→export function buildTeamKey(schoolName, gender) {\n    67→  if (!schoolName) return '';\n    68→\n    69→  // Use normalizeName to handle special characters, then strip gender suffixes\n    70→  const normalized = normalizeName(schoolName)\n    71→    // Remove existing gender suffixes from the name\n    72→    .replace(/-mens$/, '')\n    73→    .replace(/-womens$/, '')\n    74→    .replace(/ mens$/, '')\n    75→    .replace(/ womens$/, '')\n    76→    .replace(/ men$/, '')\n    77→    .replace(/ women$/, '')\n    78→    // Replace spaces with hyphens for the key format\n    79→    .replace(/\\s+/g, '-')\n    80→    .trim();\n    81→\n    82→  if (!normalized) return '';\n    83→\n    84→  // Use the provided gender, defaulting to 'mens' if not specified\n    85→  const genderSuffix = gender === 'womens' ? 'womens' : 'mens';\n    86→\n    87→  return `${normalized}-${genderSuffix}`;\n    88→}\n    89→\n    90→/**\n    91→ * Extracts just the school portion from a team key or name.\n    92→ *\n    93→ * @param {string} teamKeyOrName - Team key or name (e.g., 'stanford-womens', 'Navy Men\\'s')\n    94→ * @returns {string} School name without gender (e.g., 'stanford', 'navy')\n    95→ *\n    96→ * @example\n    97→ * extractSchoolName('stanford-womens')     // 'stanford'\n    98→ * extractSchoolName('Navy Men\\'s')         // 'navy'\n    99→ * extractSchoolName('greenville')          // 'greenville'\n   100→ */\n   101→export function extractSchoolName(teamKeyOrName) {\n   102→  if (!teamKeyOrName) return '';\n   103→\n   104→  return normalizeName(teamKeyOrName)\n   105→    .replace(/-mens$/, '')\n   106→    .replace(/-womens$/, '')\n   107→    .replace(/ mens$/, '')\n   108→    .replace(/ womens$/, '')\n   109→    .replace(/ men$/, '')\n   110→    .replace(/ women$/, '')\n   111→    .replace(/\\s+/g, '-')\n   112→    .trim();\n   113→}\n   114→\n   115→/**\n   116→ * Checks if a competition type is for women's gymnastics.\n   117→ *\n   118→ * @param {string} compType - Competition type\n   119→ * @returns {boolean} True if women's competition\n   120→ */\n   121→export function isWomensCompetition(compType) {\n   122→  return getGenderFromCompType(compType) === 'womens';\n   123→}\n   124→\n   125→/**\n   126→ * Checks if a competition type is for men's gymnastics.\n   127→ *\n   128→ * @param {string} compType - Competition type\n   129→ * @returns {boolean} True if men's competition\n   130→ */\n   131→export function isMensCompetition(compType) {\n   132→  return getGenderFromCompType(compType) === 'mens';\n   133→}\n   134→\n   135→/**\n   136→ * Gets the team count from a competition type.\n   137→ *\n   138→ * @param {string} compType - Competition type (e.g., 'womens-quad', 'mens-dual')\n   139→ * @returns {number} Number of teams (2-6), or 2 as default\n   140→ *\n   141→ * @example\n   142→ * getTeamCount('womens-quad')  // 4\n   143→ * getTeamCount('mens-dual')    // 2\n   144→ * getTeamCount('mens-tri')     // 3\n   145→ */\n   146→export function getTeamCount(compType) {\n   147→  if (!compType) return 2;\n   148→\n   149→  const normalized = compType.toLowerCase();\n   150→\n   151→  if (normalized.includes('dual')) return 2;\n   152→  if (normalized.includes('tri')) return 3;\n   153→  if (normalized.includes('quad')) return 4;\n   154→  if (normalized.includes('-5') || normalized.includes('5-team')) return 5;\n   155→  if (normalized.includes('-6') || normalized.includes('6-team')) return 6;\n   156→  if (normalized.includes('-7') || normalized.includes('7-team')) return 7;\n   157→\n   158→  return 2;\n   159→}\n   160→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"80813a13-8d65-4e4c-b211-0298af3d1836","uuid":"a210f5e4-3da0-4aff-babf-624912863d28","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/lib/competitionUtils.js","content":"/**\n * Competition utility functions for extracting and working with\n * competition types, gender context, and team keys.\n *\n * These functions ensure consistent gender handling throughout the app,\n * preventing issues where women's competitions fall back to men's team data.\n */\n\nimport { normalizeName } from './nameNormalization';\n\n/**\n * Extracts the gender string from a competition type.\n *\n * @param {string} compType - Competition type (e.g., 'womens-quad', 'mens-dual')\n * @returns {'womens' | 'mens' | null} Gender string or null if not determinable\n *\n * @example\n * getGenderFromCompType('womens-quad')  // 'womens'\n * getGenderFromCompType('mens-dual')    // 'mens'\n * getGenderFromCompType('invalid')      // null\n */\nexport function getGenderFromCompType(compType) {\n  if (!compType || typeof compType !== 'string') return null;\n\n  const normalized = compType.toLowerCase().trim();\n\n  if (normalized.startsWith('womens')) return 'womens';\n  if (normalized.startsWith('mens')) return 'mens';\n\n  // Handle variations like \"women's-dual\" or \"men's-quad\"\n  if (normalized.startsWith(\"women's\") || normalized.startsWith('women-')) return 'womens';\n  if (normalized.startsWith(\"men's\") || normalized.startsWith('men-')) return 'mens';\n\n  return null;\n}\n\n/**\n * Extracts the gender string from a competition type with a fallback default.\n *\n * @param {string} compType - Competition type (e.g., 'womens-quad', 'mens-dual')\n * @param {'womens' | 'mens'} defaultGender - Fallback gender if not determinable\n * @returns {'womens' | 'mens'} Gender string (never null)\n *\n * @example\n * getGenderSuffix('womens-quad')           // 'womens'\n * getGenderSuffix('invalid', 'womens')     // 'womens'\n * getGenderSuffix(null, 'mens')            // 'mens'\n */\nexport function getGenderSuffix(compType, defaultGender = 'mens') {\n  const gender = getGenderFromCompType(compType);\n  return gender || defaultGender;\n}\n\n/**\n * Constructs a proper team key from a school name and gender.\n *\n * @param {string} schoolName - School/team name (e.g., 'Stanford', 'Navy Men\\'s')\n * @param {'womens' | 'mens'} gender - Gender suffix to use\n * @returns {string} Team key (e.g., 'stanford-womens', 'navy-mens')\n *\n * @example\n * buildTeamKey('Stanford', 'womens')       // 'stanford-womens'\n * buildTeamKey('Navy Men\\'s', 'womens')    // 'navy-womens' (gender override)\n * buildTeamKey('Greenville', 'mens')       // 'greenville-mens'\n */\nexport function buildTeamKey(schoolName, gender) {\n  if (!schoolName) return '';\n\n  // Use normalizeName to handle special characters, then strip gender suffixes\n  const normalized = normalizeName(schoolName)\n    // Remove existing gender suffixes from the name\n    .replace(/-mens$/, '')\n    .replace(/-womens$/, '')\n    .replace(/ mens$/, '')\n    .replace(/ womens$/, '')\n    .replace(/ men$/, '')\n    .replace(/ women$/, '')\n    // Replace spaces with hyphens for the key format\n    .replace(/\\s+/g, '-')\n    .trim();\n\n  if (!normalized) return '';\n\n  // Use the provided gender, defaulting to 'mens' if not specified\n  const genderSuffix = gender === 'womens' ? 'womens' : 'mens';\n\n  return `${normalized}-${genderSuffix}`;\n}\n\n/**\n * Extracts just the school portion from a team key or name.\n *\n * @param {string} teamKeyOrName - Team key or name (e.g., 'stanford-womens', 'Navy Men\\'s')\n * @returns {string} School name without gender (e.g., 'stanford', 'navy')\n *\n * @example\n * extractSchoolName('stanford-womens')     // 'stanford'\n * extractSchoolName('Navy Men\\'s')         // 'navy'\n * extractSchoolName('greenville')          // 'greenville'\n */\nexport function extractSchoolName(teamKeyOrName) {\n  if (!teamKeyOrName) return '';\n\n  return normalizeName(teamKeyOrName)\n    .replace(/-mens$/, '')\n    .replace(/-womens$/, '')\n    .replace(/ mens$/, '')\n    .replace(/ womens$/, '')\n    .replace(/ men$/, '')\n    .replace(/ women$/, '')\n    .replace(/\\s+/g, '-')\n    .trim();\n}\n\n/**\n * Checks if a competition type is for women's gymnastics.\n *\n * @param {string} compType - Competition type\n * @returns {boolean} True if women's competition\n */\nexport function isWomensCompetition(compType) {\n  return getGenderFromCompType(compType) === 'womens';\n}\n\n/**\n * Checks if a competition type is for men's gymnastics.\n *\n * @param {string} compType - Competition type\n * @returns {boolean} True if men's competition\n */\nexport function isMensCompetition(compType) {\n  return getGenderFromCompType(compType) === 'mens';\n}\n\n/**\n * Gets the team count from a competition type.\n *\n * @param {string} compType - Competition type (e.g., 'womens-quad', 'mens-dual')\n * @returns {number} Number of teams (2-6), or 2 as default\n *\n * @example\n * getTeamCount('womens-quad')  // 4\n * getTeamCount('mens-dual')    // 2\n * getTeamCount('mens-tri')     // 3\n */\nexport function getTeamCount(compType) {\n  if (!compType) return 2;\n\n  const normalized = compType.toLowerCase();\n\n  if (normalized.includes('dual')) return 2;\n  if (normalized.includes('tri')) return 3;\n  if (normalized.includes('quad')) return 4;\n  if (normalized.includes('-5') || normalized.includes('5-team')) return 5;\n  if (normalized.includes('-6') || normalized.includes('6-team')) return 6;\n  if (normalized.includes('-7') || normalized.includes('7-team')) return 7;\n\n  return 2;\n}\n","numLines":160,"startLine":1,"totalLines":160}}}
