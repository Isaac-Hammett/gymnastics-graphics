{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013EpPQfJZeGCQJqBtycLUiF","type":"tool_result","content":"     1→/**\n     2→ * Production Checklist Validators\n     3→ *\n     4→ * Auto-validation functions for checklist items.\n     5→ * Each validator receives a context object and returns { status, detail }.\n     6→ *\n     7→ * Status values:\n     8→ * - 'complete': Requirement met (green)\n     9→ * - 'warning': Partial/suboptimal (amber)\n    10→ * - 'error': Requirement not met (red)\n    11→ * - 'checking': Async validation in progress (gray with spinner)\n    12→ *\n    13→ * Reference: docs/PRD-Production-Checklist/checklist-items-definition.md\n    14→ */\n    15→\n    16→import { getTeamCount } from './competitionUtils';\n    17→\n    18→/**\n    19→ * Helper: get team count from competition config\n    20→ */\n    21→function getTeamCountFromConfig(config) {\n    22→  if (!config?.compType) return 2;\n    23→  return getTeamCount(config.compType);\n    24→}\n    25→\n    26→/**\n    27→ * Validators object - keyed by validator ID matching checklistItems.js\n    28→ */\n    29→export const validators = {\n    30→  // ============================================\n    31→  // Competition Config Validators (Phase 1: Setup)\n    32→  // ============================================\n    33→\n    34→  /**\n    35→   * Check if event name is configured\n    36→   */\n    37→  'event-name': (ctx) => ({\n    38→    status: ctx.config?.eventName ? 'complete' : 'error',\n    39→    detail: ctx.config?.eventName || 'Not set',\n    40→  }),\n    41→\n    42→  /**\n    43→   * Check if meet date is configured\n    44→   */\n    45→  'meet-date': (ctx) => ({\n    46→    status: ctx.config?.meetDate ? 'complete' : 'error',\n    47→    detail: ctx.config?.meetDate || 'Not set',\n    48→  }),\n    49→\n    50→  /**\n    51→   * Check if venue is configured\n    52→   */\n    53→  'venue-configured': (ctx) => ({\n    54→    status: ctx.config?.venue ? 'complete' : 'error',\n    55→    detail: ctx.config?.venue || 'Not set',\n    56→  }),\n    57→\n    58→  /**\n    59→   * Check if all teams are configured with names and logos.\n    60→   * Dynamic: checks N teams based on competition type.\n    61→   */\n    62→  'teams-configured': (ctx) => {\n    63→    const teamCount = getTeamCountFromConfig(ctx.config);\n    64→    const results = [];\n    65→    let allOk = true;\n    66→\n    67→    for (let i = 1; i <= teamCount; i++) {\n    68→      const nameOk = !!ctx.config?.[`team${i}Name`];\n    69→      const logoOk = !!ctx.config?.[`team${i}Logo`];\n    70→      const ok = nameOk && logoOk;\n    71→      if (!ok) allOk = false;\n    72→      results.push(`Team ${i}: ${ok ? '✓' : '✗'}`);\n    73→    }\n    74→\n    75→    return {\n    76→      status: allOk ? 'complete' : 'error',\n    77→      detail: results.join(', '),\n    78→    };\n    79→  },\n    80→\n    81→  /**\n    82→   * Check if meet theme is configured.\n    83→   * Uses warning (not error) when missing — defaults work fine.\n    84→   */\n    85→  'theme-configured': (ctx) => ({\n    86→    status: ctx.config?.meetTheme ? 'complete' : 'warning',\n    87→    detail: ctx.config?.meetTheme || 'No theme set (using defaults)',\n    88→  }),\n    89→\n    90→  // ============================================\n    91→  // Team Data Validators (Task 10)\n    92→  // ============================================\n    93→\n    94→  /**\n    95→   * Check if rosters are loaded for all teams.\n    96→   * Dynamic: checks N teams based on competition type.\n    97→   */\n    98→  'rosters-loaded': (ctx) => {\n    99→    const teamCount = getTeamCountFromConfig(ctx.config);\n   100→    const results = [];\n   101→    let allOk = true;\n   102→\n   103→    for (let i = 1; i <= teamCount; i++) {\n   104→      const roster = ctx.teamData?.[`team${i}`]?.roster;\n   105→      const count = Array.isArray(roster) ? roster.length : 0;\n   106→      if (count === 0) allOk = false;\n   107→      results.push(`Team ${i}: ${count}`);\n   108→    }\n   109→\n   110→    return {\n   111→      status: allOk ? 'complete' : 'warning',\n   112→      detail: results.join(', '),\n   113→    };\n   114→  },\n   115→\n   116→  /**\n   117→   * Check if headshots are uploaded for all teams (>= 80% threshold).\n   118→   * Dynamic: checks N teams based on competition type.\n   119→   *\n   120→   * Threshold rationale: 80% accounts for walk-ons and injured athletes who\n   121→   * won't compete and may not have headshots. Only ~6 of ~20 roster members\n   122→   * typically compete, so 80% of the full roster is a reasonable floor.\n   123→   */\n   124→  'headshots-uploaded': (ctx) => {\n   125→    const teamCount = getTeamCountFromConfig(ctx.config);\n   126→\n   127→    const getHeadshotPercent = (roster) => {\n   128→      if (!Array.isArray(roster) || roster.length === 0) return 0;\n   129→      const withPhotos = roster.filter(a => a?.headshotUrl).length;\n   130→      return Math.round((withPhotos / roster.length) * 100);\n   131→    };\n   132→\n   133→    let totalPct = 0;\n   134→    const results = [];\n   135→\n   136→    for (let i = 1; i <= teamCount; i++) {\n   137→      const roster = ctx.teamData?.[`team${i}`]?.roster;\n   138→      const pct = getHeadshotPercent(roster);\n   139→      totalPct += pct;\n   140→      results.push(`T${i}: ${pct}%`);\n   141→    }\n   142→\n   143→    const avgPct = teamCount > 0 ? Math.round(totalPct / teamCount) : 0;\n   144→\n   145→    return {\n   146→      status: avgPct >= 80 ? 'complete' : avgPct >= 50 ? 'warning' : 'error',\n   147→      detail: results.join(', '),\n   148→    };\n   149→  },\n   150→\n   151→  // ============================================\n   152→  // Infrastructure Validators (Task 11)\n   153→  // ============================================\n   154→\n   155→  /**\n   156→   * Check if a VM is assigned to the competition.\n   157→   */\n   158→  'vm-assigned': (ctx) => ({\n   159→    status: ctx.config?.vmAddress ? 'complete' : 'error',\n   160→    detail: ctx.config?.vmAddress || 'No VM assigned',\n   161→  }),\n   162→\n   163→  /**\n   164→   * Check if the VM is online.\n   165→   * Note: Custom VMs will always show offline since there's no health check path.\n   166→   * The vmStatus object is populated by polling in useProductionChecklist.\n   167→   */\n   168→  'vm-online': (ctx) => {\n   169→    // No VM assigned - show error\n   170→    if (!ctx.config?.vmAddress) {\n   171→      return { status: 'error', detail: 'No VM assigned' };\n   172→    }\n   173→\n   174→    // VM status is being checked\n   175→    if (ctx.vmStatus?.checking) {\n   176→      return { status: 'checking', detail: 'Checking...' };\n   177→    }\n   178→\n   179→    // VM is online\n   180→    if (ctx.vmStatus?.online) {\n   181→      return { status: 'complete', detail: 'Online' };\n   182→    }\n   183→\n   184→    // VM is offline or error\n   185→    return {\n   186→      status: 'error',\n   187→      detail: ctx.vmStatus?.error || 'Offline',\n   188→    };\n   189→  },\n   190→\n   191→  /**\n   192→   * Check if socket is connected to the coordinator.\n   193→   * Note: This will show red when no one is actively running the show,\n   194→   * which is expected pre-show behavior.\n   195→   */\n   196→  'socket-connected': (ctx) => ({\n   197→    status: ctx.socketConnected ? 'complete' : 'error',\n   198→    detail: ctx.socketConnected ? 'Connected' : 'Disconnected',\n   199→  }),\n   200→\n   201→  /**\n   202→   * Check if OBS is connected.\n   203→   * Note: This will show red when OBS is not running, which is expected\n   204→   * pre-show until the producer starts OBS.\n   205→   */\n   206→  'obs-connected': (ctx) => ({\n   207→    status: ctx.obsConnected ? 'complete' : 'error',\n   208→    detail: ctx.obsConnected ? 'Connected' : 'Not connected',\n   209→  }),\n   210→\n   211→  // ============================================\n   212→  // Rundown Validators (Task 12)\n   213→  // Path: competitions/{compId}/rundown/segments\n   214→  // ============================================\n   215→\n   216→  /**\n   217→   * Check if a rundown has been created (has segments).\n   218→   */\n   219→  'rundown-created': (ctx) => {\n   220→    const segments = ctx.rundownSegments;\n   221→    const hasSegments = Array.isArray(segments) && segments.length > 0;\n   222→\n   223→    return {\n   224→      status: hasSegments ? 'complete' : 'error',\n   225→      detail: hasSegments ? `${segments.length} segments` : 'No segments',\n   226→    };\n   227→  },\n   228→\n   229→  /**\n   230→   * Check if all segments have proper names (not \"New Segment\" or empty).\n   231→   */\n   232→  'segments-named': (ctx) => {\n   233→    const segments = ctx.rundownSegments;\n   234→\n   235→    // No segments at all\n   236→    if (!Array.isArray(segments) || segments.length === 0) {\n   237→      return { status: 'error', detail: 'No segments' };\n   238→    }\n   239→\n   240→    // Count unnamed segments\n   241→    const unnamed = segments.filter(\n   242→      s => !s.name || s.name.trim() === '' || s.name === 'New Segment'\n   243→    ).length;\n   244→\n   245→    return {\n   246→      status: unnamed === 0 ? 'complete' : 'warning',\n   247→      detail: unnamed === 0 ? 'All named' : `${unnamed} unnamed`,\n   248→    };\n   249→  },\n   250→\n   251→  /**\n   252→   * Check if segments have graphics assigned (>= 80% threshold).\n   253→   * A segment has a graphic if segment.graphic?.graphicId exists.\n   254→   */\n   255→  'graphics-assigned': (ctx) => {\n   256→    const segments = ctx.rundownSegments;\n   257→\n   258→    // No segments at all\n   259→    if (!Array.isArray(segments) || segments.length === 0) {\n   260→      return { status: 'error', detail: 'No segments' };\n   261→    }\n   262→\n   263→    const total = segments.length;\n   264→    const withGraphics = segments.filter(s => s.graphic?.graphicId).length;\n   265→    const pct = Math.round((withGraphics / total) * 100);\n   266→\n   267→    return {\n   268→      status: pct >= 80 ? 'complete' : pct >= 50 ? 'warning' : 'error',\n   269→      detail: `${withGraphics}/${total} (${pct}%)`,\n   270→    };\n   271→  },\n   272→};\n   273→\n   274→/**\n   275→ * Run a validator by key.\n   276→ * Returns { status: 'pending', detail: 'No validator' } if validator not found.\n   277→ *\n   278→ * @param {string} validatorKey - The validator key from checklistItems.js\n   279→ * @param {object} ctx - Context object with config, teamData, etc.\n   280→ * @returns {{ status: string, detail: string }}\n   281→ */\n   282→export function runValidator(validatorKey, ctx) {\n   283→  const validator = validators[validatorKey];\n   284→  if (!validator) {\n   285→    return { status: 'pending', detail: 'No validator' };\n   286→  }\n   287→  try {\n   288→    return validator(ctx);\n   289→  } catch (error) {\n   290→    console.error(`Validator ${validatorKey} error:`, error);\n   291→    return { status: 'error', detail: 'Validation error' };\n   292→  }\n   293→}\n   294→\n   295→/**\n   296→ * Run all validators and return a map of results.\n   297→ *\n   298→ * @param {object} ctx - Context object with config, teamData, etc.\n   299→ * @returns {Object<string, { status: string, detail: string }>}\n   300→ */\n   301→export function runAllValidators(ctx) {\n   302→  const results = {};\n   303→  for (const key of Object.keys(validators)) {\n   304→    results[key] = runValidator(key, ctx);\n   305→  }\n   306→  return results;\n   307→}\n   308→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3d982b9f-b5e1-47e1-88eb-2bc924db4a7f","uuid":"3824bb38-8662-4c5a-9792-fbe8cb23c078","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/lib/checklistValidators.js","content":"/**\n * Production Checklist Validators\n *\n * Auto-validation functions for checklist items.\n * Each validator receives a context object and returns { status, detail }.\n *\n * Status values:\n * - 'complete': Requirement met (green)\n * - 'warning': Partial/suboptimal (amber)\n * - 'error': Requirement not met (red)\n * - 'checking': Async validation in progress (gray with spinner)\n *\n * Reference: docs/PRD-Production-Checklist/checklist-items-definition.md\n */\n\nimport { getTeamCount } from './competitionUtils';\n\n/**\n * Helper: get team count from competition config\n */\nfunction getTeamCountFromConfig(config) {\n  if (!config?.compType) return 2;\n  return getTeamCount(config.compType);\n}\n\n/**\n * Validators object - keyed by validator ID matching checklistItems.js\n */\nexport const validators = {\n  // ============================================\n  // Competition Config Validators (Phase 1: Setup)\n  // ============================================\n\n  /**\n   * Check if event name is configured\n   */\n  'event-name': (ctx) => ({\n    status: ctx.config?.eventName ? 'complete' : 'error',\n    detail: ctx.config?.eventName || 'Not set',\n  }),\n\n  /**\n   * Check if meet date is configured\n   */\n  'meet-date': (ctx) => ({\n    status: ctx.config?.meetDate ? 'complete' : 'error',\n    detail: ctx.config?.meetDate || 'Not set',\n  }),\n\n  /**\n   * Check if venue is configured\n   */\n  'venue-configured': (ctx) => ({\n    status: ctx.config?.venue ? 'complete' : 'error',\n    detail: ctx.config?.venue || 'Not set',\n  }),\n\n  /**\n   * Check if all teams are configured with names and logos.\n   * Dynamic: checks N teams based on competition type.\n   */\n  'teams-configured': (ctx) => {\n    const teamCount = getTeamCountFromConfig(ctx.config);\n    const results = [];\n    let allOk = true;\n\n    for (let i = 1; i <= teamCount; i++) {\n      const nameOk = !!ctx.config?.[`team${i}Name`];\n      const logoOk = !!ctx.config?.[`team${i}Logo`];\n      const ok = nameOk && logoOk;\n      if (!ok) allOk = false;\n      results.push(`Team ${i}: ${ok ? '✓' : '✗'}`);\n    }\n\n    return {\n      status: allOk ? 'complete' : 'error',\n      detail: results.join(', '),\n    };\n  },\n\n  /**\n   * Check if meet theme is configured.\n   * Uses warning (not error) when missing — defaults work fine.\n   */\n  'theme-configured': (ctx) => ({\n    status: ctx.config?.meetTheme ? 'complete' : 'warning',\n    detail: ctx.config?.meetTheme || 'No theme set (using defaults)',\n  }),\n\n  // ============================================\n  // Team Data Validators (Task 10)\n  // ============================================\n\n  /**\n   * Check if rosters are loaded for all teams.\n   * Dynamic: checks N teams based on competition type.\n   */\n  'rosters-loaded': (ctx) => {\n    const teamCount = getTeamCountFromConfig(ctx.config);\n    const results = [];\n    let allOk = true;\n\n    for (let i = 1; i <= teamCount; i++) {\n      const roster = ctx.teamData?.[`team${i}`]?.roster;\n      const count = Array.isArray(roster) ? roster.length : 0;\n      if (count === 0) allOk = false;\n      results.push(`Team ${i}: ${count}`);\n    }\n\n    return {\n      status: allOk ? 'complete' : 'warning',\n      detail: results.join(', '),\n    };\n  },\n\n  /**\n   * Check if headshots are uploaded for all teams (>= 80% threshold).\n   * Dynamic: checks N teams based on competition type.\n   *\n   * Threshold rationale: 80% accounts for walk-ons and injured athletes who\n   * won't compete and may not have headshots. Only ~6 of ~20 roster members\n   * typically compete, so 80% of the full roster is a reasonable floor.\n   */\n  'headshots-uploaded': (ctx) => {\n    const teamCount = getTeamCountFromConfig(ctx.config);\n\n    const getHeadshotPercent = (roster) => {\n      if (!Array.isArray(roster) || roster.length === 0) return 0;\n      const withPhotos = roster.filter(a => a?.headshotUrl).length;\n      return Math.round((withPhotos / roster.length) * 100);\n    };\n\n    let totalPct = 0;\n    const results = [];\n\n    for (let i = 1; i <= teamCount; i++) {\n      const roster = ctx.teamData?.[`team${i}`]?.roster;\n      const pct = getHeadshotPercent(roster);\n      totalPct += pct;\n      results.push(`T${i}: ${pct}%`);\n    }\n\n    const avgPct = teamCount > 0 ? Math.round(totalPct / teamCount) : 0;\n\n    return {\n      status: avgPct >= 80 ? 'complete' : avgPct >= 50 ? 'warning' : 'error',\n      detail: results.join(', '),\n    };\n  },\n\n  // ============================================\n  // Infrastructure Validators (Task 11)\n  // ============================================\n\n  /**\n   * Check if a VM is assigned to the competition.\n   */\n  'vm-assigned': (ctx) => ({\n    status: ctx.config?.vmAddress ? 'complete' : 'error',\n    detail: ctx.config?.vmAddress || 'No VM assigned',\n  }),\n\n  /**\n   * Check if the VM is online.\n   * Note: Custom VMs will always show offline since there's no health check path.\n   * The vmStatus object is populated by polling in useProductionChecklist.\n   */\n  'vm-online': (ctx) => {\n    // No VM assigned - show error\n    if (!ctx.config?.vmAddress) {\n      return { status: 'error', detail: 'No VM assigned' };\n    }\n\n    // VM status is being checked\n    if (ctx.vmStatus?.checking) {\n      return { status: 'checking', detail: 'Checking...' };\n    }\n\n    // VM is online\n    if (ctx.vmStatus?.online) {\n      return { status: 'complete', detail: 'Online' };\n    }\n\n    // VM is offline or error\n    return {\n      status: 'error',\n      detail: ctx.vmStatus?.error || 'Offline',\n    };\n  },\n\n  /**\n   * Check if socket is connected to the coordinator.\n   * Note: This will show red when no one is actively running the show,\n   * which is expected pre-show behavior.\n   */\n  'socket-connected': (ctx) => ({\n    status: ctx.socketConnected ? 'complete' : 'error',\n    detail: ctx.socketConnected ? 'Connected' : 'Disconnected',\n  }),\n\n  /**\n   * Check if OBS is connected.\n   * Note: This will show red when OBS is not running, which is expected\n   * pre-show until the producer starts OBS.\n   */\n  'obs-connected': (ctx) => ({\n    status: ctx.obsConnected ? 'complete' : 'error',\n    detail: ctx.obsConnected ? 'Connected' : 'Not connected',\n  }),\n\n  // ============================================\n  // Rundown Validators (Task 12)\n  // Path: competitions/{compId}/rundown/segments\n  // ============================================\n\n  /**\n   * Check if a rundown has been created (has segments).\n   */\n  'rundown-created': (ctx) => {\n    const segments = ctx.rundownSegments;\n    const hasSegments = Array.isArray(segments) && segments.length > 0;\n\n    return {\n      status: hasSegments ? 'complete' : 'error',\n      detail: hasSegments ? `${segments.length} segments` : 'No segments',\n    };\n  },\n\n  /**\n   * Check if all segments have proper names (not \"New Segment\" or empty).\n   */\n  'segments-named': (ctx) => {\n    const segments = ctx.rundownSegments;\n\n    // No segments at all\n    if (!Array.isArray(segments) || segments.length === 0) {\n      return { status: 'error', detail: 'No segments' };\n    }\n\n    // Count unnamed segments\n    const unnamed = segments.filter(\n      s => !s.name || s.name.trim() === '' || s.name === 'New Segment'\n    ).length;\n\n    return {\n      status: unnamed === 0 ? 'complete' : 'warning',\n      detail: unnamed === 0 ? 'All named' : `${unnamed} unnamed`,\n    };\n  },\n\n  /**\n   * Check if segments have graphics assigned (>= 80% threshold).\n   * A segment has a graphic if segment.graphic?.graphicId exists.\n   */\n  'graphics-assigned': (ctx) => {\n    const segments = ctx.rundownSegments;\n\n    // No segments at all\n    if (!Array.isArray(segments) || segments.length === 0) {\n      return { status: 'error', detail: 'No segments' };\n    }\n\n    const total = segments.length;\n    const withGraphics = segments.filter(s => s.graphic?.graphicId).length;\n    const pct = Math.round((withGraphics / total) * 100);\n\n    return {\n      status: pct >= 80 ? 'complete' : pct >= 50 ? 'warning' : 'error',\n      detail: `${withGraphics}/${total} (${pct}%)`,\n    };\n  },\n};\n\n/**\n * Run a validator by key.\n * Returns { status: 'pending', detail: 'No validator' } if validator not found.\n *\n * @param {string} validatorKey - The validator key from checklistItems.js\n * @param {object} ctx - Context object with config, teamData, etc.\n * @returns {{ status: string, detail: string }}\n */\nexport function runValidator(validatorKey, ctx) {\n  const validator = validators[validatorKey];\n  if (!validator) {\n    return { status: 'pending', detail: 'No validator' };\n  }\n  try {\n    return validator(ctx);\n  } catch (error) {\n    console.error(`Validator ${validatorKey} error:`, error);\n    return { status: 'error', detail: 'Validation error' };\n  }\n}\n\n/**\n * Run all validators and return a map of results.\n *\n * @param {object} ctx - Context object with config, teamData, etc.\n * @returns {Object<string, { status: string, detail: string }>}\n */\nexport function runAllValidators(ctx) {\n  const results = {};\n  for (const key of Object.keys(validators)) {\n    results[key] = runValidator(key, ctx);\n  }\n  return results;\n}\n","numLines":308,"startLine":1,"totalLines":308}}}
