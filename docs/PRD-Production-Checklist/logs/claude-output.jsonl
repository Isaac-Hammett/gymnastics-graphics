{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F8XERcDHCsbBBTT427w6Nm","type":"tool_result","content":"     1→/**\n     2→ * Production Checklist Hook\n     3→ *\n     4→ * Main hook for checklist state management. Subscribes to Firebase for\n     5→ * manual item states, computes auto-validated items from system state,\n     6→ * and provides actions for toggling items and updating notes.\n     7→ *\n     8→ * Reference: docs/PRD-Production-Checklist/PLAN-Production-Checklist-2026-01-24.md\n     9→ */\n    10→\n    11→import { useState, useEffect, useCallback, useMemo } from 'react';\n    12→import { useCompetition } from '../context/CompetitionContext';\n    13→import { useShow } from '../context/ShowContext';\n    14→import { useOBS } from '../context/OBSContext';\n    15→import { db, ref, onValue, set, get } from '../lib/firebase';\n    16→import { checkVmStatus } from './useCompetitions';\n    17→import { CHECKLIST_PHASES, getAllItems } from '../lib/checklistItems';\n    18→import { getTeamCount, buildTeamKey, getGenderFromCompType } from '../lib/competitionUtils';\n    19→\n    20→/**\n    21→ * useProductionChecklist - Main hook for production checklist state\n    22→ *\n    23→ * @returns {Object} Checklist state and actions:\n    24→ *   - phases: Computed phases with status\n    25→ *   - summary: { total, complete, warnings, errors, pending, percentage }\n    26→ *   - contacts: Team contacts from Firebase\n    27→ *   - teamKeys: Array of team keys for the competition\n    28→ *   - toggleItem: (itemId) => Promise<void>\n    29→ *   - updateNote: (itemId, note) => Promise<void>\n    30→ *   - updateContact: (teamKey, contactId, data) => Promise<void>\n    31→ *   - deleteContact: (teamKey, contactId) => Promise<void>\n    32→ *   - refresh: () => void\n    33→ *   - loading: boolean\n    34→ *   - lastUpdated: ISO timestamp or null\n    35→ */\n    36→export function useProductionChecklist() {\n    37→  const { compId, competitionConfig } = useCompetition();\n    38→  const { connected: socketConnected } = useShow();\n    39→  const { obsConnected } = useOBS();\n    40→\n    41→  // Checklist state from Firebase\n    42→  const [checklistState, setChecklistState] = useState(null);\n    43→  const [localChecklistState, setLocalChecklistState] = useState(null); // for optimistic updates\n    44→\n    45→  // Team data from Firebase (rosters, headshots)\n    46→  const [teamData, setTeamData] = useState(null);\n    47→\n    48→  // Rundown segments from Firebase\n    49→  const [rundownSegments, setRundownSegments] = useState([]);\n    50→\n    51→  // Team contacts from Firebase\n    52→  const [contacts, setContacts] = useState({});\n    53→\n    54→  // VM status\n    55→  const [vmStatus, setVmStatus] = useState({ online: false, checking: true });\n    56→\n    57→  // Loading state\n    58→  const [loading, setLoading] = useState(true);\n    59→\n    60→  // Last updated timestamp\n    61→  const [lastUpdated, setLastUpdated] = useState(null);\n    62→\n    63→  // Derive team count and keys from competition config\n    64→  const teamCount = useMemo(() => {\n    65→    if (!competitionConfig?.compType) return 2;\n    66→    return getTeamCount(competitionConfig.compType);\n    67→  }, [competitionConfig?.compType]);\n    68→\n    69→  const gender = useMemo(() => {\n    70→    if (competitionConfig?.gender) return competitionConfig.gender;\n    71→    return getGenderFromCompType(competitionConfig?.compType) || 'womens';\n    72→  }, [competitionConfig?.gender, competitionConfig?.compType]);\n    73→\n    74→  const teamKeys = useMemo(() => {\n    75→    const keys = [];\n    76→    for (let i = 1; i <= teamCount; i++) {\n    77→      const name = competitionConfig?.[`team${i}Name`];\n    78→      if (name) {\n    79→        keys.push(buildTeamKey(name, gender));\n    80→      }\n    81→    }\n    82→    return keys;\n    83→  }, [competitionConfig, teamCount, gender]);\n    84→\n    85→  // Subscribe to checklist state from Firebase\n    86→  useEffect(() => {\n    87→    if (!compId) return;\n    88→\n    89→    const checklistRef = ref(db, `competitions/${compId}/checklist`);\n    90→    const unsubscribe = onValue(checklistRef, (snapshot) => {\n    91→      const data = snapshot.val();\n    92→      setChecklistState(data);\n    93→      setLastUpdated(data?.lastUpdated || null);\n    94→      // Clear local optimistic state when Firebase updates\n    95→      setLocalChecklistState(null);\n    96→      setLoading(false);\n    97→    }, (err) => {\n    98→      console.error('[useProductionChecklist] Failed to load checklist state:', err);\n    99→      setLoading(false);\n   100→    });\n   101→\n   102→    return () => unsubscribe();\n   103→  }, [compId]);\n   104→\n   105→  // Subscribe to team data from Firebase\n   106→  useEffect(() => {\n   107→    if (!compId) return;\n   108→\n   109→    const teamDataRef = ref(db, `competitions/${compId}/teamData`);\n   110→    const unsubscribe = onValue(teamDataRef, (snapshot) => {\n   111→      setTeamData(snapshot.val());\n   112→    });\n   113→\n   114→    return () => unsubscribe();\n   115→  }, [compId]);\n   116→\n   117→  // Subscribe to rundown segments from Firebase\n   118→  // IMPORTANT: Path is competitions/{compId}/rundown/segments (NOT production/rundown/segments/)\n   119→  useEffect(() => {\n   120→    if (!compId) return;\n   121→\n   122→    const segmentsRef = ref(db, `competitions/${compId}/rundown/segments`);\n   123→    const unsubscribe = onValue(segmentsRef, (snapshot) => {\n   124→      const data = snapshot.val();\n   125→      setRundownSegments(data ? Object.values(data) : []);\n   126→    });\n   127→\n   128→    return () => unsubscribe();\n   129→  }, [compId]);\n   130→\n   131→  // Subscribe to team contacts from Firebase\n   132→  useEffect(() => {\n   133→    if (teamKeys.length === 0) return;\n   134→\n   135→    const unsubscribes = [];\n   136→    const contactsData = {};\n   137→\n   138→    for (const teamKey of teamKeys) {\n   139→      const contactsRef = ref(db, `teamsDatabase/contacts/${teamKey}`);\n   140→      const unsub = onValue(contactsRef, (snapshot) => {\n   141→        contactsData[teamKey] = snapshot.val() || {};\n   142→        setContacts({ ...contactsData });\n   143→      });\n   144→      unsubscribes.push(unsub);\n   145→    }\n   146→\n   147→    return () => {\n   148→      for (const unsub of unsubscribes) {\n   149→        unsub();\n   150→      }\n   151→    };\n   152→  }, [teamKeys]);\n   153→\n   154→  // VM status polling (30s interval)\n   155→  useEffect(() => {\n   156→    if (!competitionConfig?.vmAddress) {\n   157→      setVmStatus({ online: false, checking: false });\n   158→      return;\n   159→    }\n   160→\n   161→    const poll = async () => {\n   162→      setVmStatus(prev => ({ ...prev, checking: true }));\n   163→      try {\n   164→        const result = await checkVmStatus(competitionConfig.vmAddress, 5000, compId);\n   165→        setVmStatus({ online: result.online, checking: false, error: result.error });\n   166→      } catch (err) {\n   167→        setVmStatus({ online: false, checking: false, error: err.message });\n   168→      }\n   169→    };\n   170→\n   171→    poll();\n   172→    const interval = setInterval(poll, 30000);\n   173→    return () => clearInterval(interval);\n   174→  }, [competitionConfig?.vmAddress, compId]);\n   175→\n   176→  // Compute effective checklist state (local optimistic or Firebase)\n   177→  const effectiveChecklistState = useMemo(() => {\n   178→    return localChecklistState || checklistState || { items: {}, notes: {} };\n   179→  }, [localChecklistState, checklistState]);\n   180→\n   181→  // Build validator context\n   182→  const validatorContext = useMemo(() => ({\n   183→    config: competitionConfig,\n   184→    teamData,\n   185→    rundownSegments,\n   186→    socketConnected,\n   187→    obsConnected,\n   188→    vmStatus,\n   189→    contacts,\n   190→    teamCount,\n   191→    gender\n   192→  }), [competitionConfig, teamData, rundownSegments, socketConnected, obsConnected, vmStatus, contacts, teamCount, gender]);\n   193→\n   194→  // Compute phases with item statuses\n   195→  const phases = useMemo(() => {\n   196→    return CHECKLIST_PHASES.map(phase => ({\n   197→      ...phase,\n   198→      categories: phase.categories.map(category => ({\n   199→        ...category,\n   200→        items: category.items.map(item => {\n   201→          // Compute status for this item\n   202→          let status = 'pending';\n   203→          let detail = null;\n   204→\n   205→          if (item.type === 'auto' && item.validator) {\n   206→            // Auto-validated items - compute status from validators\n   207→            // Validators will be implemented in Task 9, for now return pending\n   208→            status = 'pending';\n   209→            detail = 'Validator not implemented';\n   210→          } else {\n   211→            // Manual items - get from Firebase state\n   212→            const itemState = effectiveChecklistState.items?.[item.id];\n   213→            status = itemState?.checked ? 'complete' : 'pending';\n   214→          }\n   215→\n   216→          // Get note if any\n   217→          const note = effectiveChecklistState.notes?.[item.id] || null;\n   218→\n   219→          // Build fix link with compId substitution\n   220→          let fixLink = item.fixLink || null;\n   221→          if (fixLink && compId) {\n   222→            fixLink = fixLink.replace('{compId}', compId);\n   223→          }\n   224→\n   225→          return {\n   226→            ...item,\n   227→            status,\n   228→            detail,\n   229→            note,\n   230→            fixLink,\n   231→            checked: effectiveChecklistState.items?.[item.id]?.checked || false,\n   232→            checkedAt: effectiveChecklistState.items?.[item.id]?.checkedAt || null\n   233→          };\n   234→        })\n   235→      }))\n   236→    }));\n   237→  }, [effectiveChecklistState, compId]);\n   238→\n   239→  // Compute summary stats\n   240→  const summary = useMemo(() => {\n   241→    const allItems = getAllItems();\n   242→    const total = allItems.length;\n   243→    let complete = 0;\n   244→    let warnings = 0;\n   245→    let errors = 0;\n   246→    let pending = 0;\n   247→\n   248→    for (const phase of phases) {\n   249→      for (const category of phase.categories) {\n   250→        for (const item of category.items) {\n   251→          switch (item.status) {\n   252→            case 'complete':\n   253→              complete++;\n   254→              break;\n   255→            case 'warning':\n   256→              warnings++;\n   257→              break;\n   258→            case 'error':\n   259→              errors++;\n   260→              break;\n   261→            default:\n   262→              pending++;\n   263→          }\n   264→        }\n   265→      }\n   266→    }\n   267→\n   268→    const percentage = total > 0 ? Math.round((complete / total) * 100) : 0;\n   269→\n   270→    return { total, complete, warnings, errors, pending, percentage };\n   271→  }, [phases]);\n   272→\n   273→  // Toggle item action - optimistic update with rollback\n   274→  const toggleItem = useCallback(async (itemId) => {\n   275→    if (!compId) return;\n   276→\n   277→    let previousState;\n   278→    const now = new Date().toISOString();\n   279→\n   280→    // Optimistic update — use functional form to safely read current local state\n   281→    setLocalChecklistState(prev => {\n   282→      const baseState = prev || checklistState || { items: {}, notes: {} };\n   283→      previousState = baseState.items?.[itemId]?.checked ?? false;\n   284→      return {\n   285→        ...baseState,\n   286→        items: {\n   287→          ...(baseState.items || {}),\n   288→          [itemId]: { checked: !previousState, checkedAt: now }\n   289→        }\n   290→      };\n   291→    });\n   292→\n   293→    try {\n   294→      await set(ref(db, `competitions/${compId}/checklist/items/${itemId}`), {\n   295→        checked: !previousState,\n   296→        checkedAt: now\n   297→      });\n   298→      // Update lastUpdated timestamp\n   299→      await set(ref(db, `competitions/${compId}/checklist/lastUpdated`), now);\n   300→    } catch (error) {\n   301→      console.error('[useProductionChecklist] Failed to toggle item:', error);\n   302→      // Rollback on failure — only revert this specific item\n   303→      setLocalChecklistState(prev => {\n   304→        const baseState = prev || checklistState || { items: {}, notes: {} };\n   305→        return {\n   306→          ...baseState,\n   307→          items: {\n   308→            ...(baseState.items || {}),\n   309→            [itemId]: { checked: previousState }\n   310→          }\n   311→        };\n   312→      });\n   313→      throw error; // Re-throw for toast handling in UI\n   314→    }\n   315→  }, [compId, checklistState]);\n   316→\n   317→  // Update note action\n   318→  const updateNote = useCallback(async (itemId, note) => {\n   319→    if (!compId) return;\n   320→\n   321→    try {\n   322→      const now = new Date().toISOString();\n   323→      await set(ref(db, `competitions/${compId}/checklist/notes/${itemId}`), note);\n   324→      await set(ref(db, `competitions/${compId}/checklist/lastUpdated`), now);\n   325→    } catch (error) {\n   326→      console.error('[useProductionChecklist] Failed to save note:', error);\n   327→      throw error; // Re-throw for toast handling in UI\n   328→    }\n   329→  }, [compId]);\n   330→\n   331→  // Update contact action\n   332→  const updateContact = useCallback(async (teamKey, contactId, contactData) => {\n   333→    if (!teamKey || !contactId) return;\n   334→\n   335→    try {\n   336→      await set(ref(db, `teamsDatabase/contacts/${teamKey}/${contactId}`), {\n   337→        ...contactData,\n   338→        updatedAt: new Date().toISOString()\n   339→      });\n   340→    } catch (error) {\n   341→      console.error('[useProductionChecklist] Failed to save contact:', error);\n   342→      throw error; // Re-throw for toast handling in UI\n   343→    }\n   344→  }, []);\n   345→\n   346→  // Delete contact action\n   347→  const deleteContact = useCallback(async (teamKey, contactId) => {\n   348→    if (!teamKey || !contactId) return;\n   349→\n   350→    try {\n   351→      await set(ref(db, `teamsDatabase/contacts/${teamKey}/${contactId}`), null);\n   352→    } catch (error) {\n   353→      console.error('[useProductionChecklist] Failed to delete contact:', error);\n   354→      throw error; // Re-throw for toast handling in UI\n   355→    }\n   356→  }, []);\n   357→\n   358→  // Refresh action - force re-fetch from Firebase\n   359→  const refresh = useCallback(() => {\n   360→    // Clear local state to force re-read from Firebase\n   361→    setLocalChecklistState(null);\n   362→  }, []);\n   363→\n   364→  return {\n   365→    phases,\n   366→    summary,\n   367→    contacts,\n   368→    teamKeys,\n   369→    toggleItem,\n   370→    updateNote,\n   371→    updateContact,\n   372→    deleteContact,\n   373→    refresh,\n   374→    loading,\n   375→    lastUpdated,\n   376→    // Expose additional context for components that need it\n   377→    validatorContext,\n   378→    competitionConfig,\n   379→    teamCount,\n   380→    gender\n   381→  };\n   382→}\n   383→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"de8042c3-0326-4104-811b-130b46417532","uuid":"32e03a44-59fb-402c-ba53-6a269d2be510","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/hooks/useProductionChecklist.js","content":"/**\n * Production Checklist Hook\n *\n * Main hook for checklist state management. Subscribes to Firebase for\n * manual item states, computes auto-validated items from system state,\n * and provides actions for toggling items and updating notes.\n *\n * Reference: docs/PRD-Production-Checklist/PLAN-Production-Checklist-2026-01-24.md\n */\n\nimport { useState, useEffect, useCallback, useMemo } from 'react';\nimport { useCompetition } from '../context/CompetitionContext';\nimport { useShow } from '../context/ShowContext';\nimport { useOBS } from '../context/OBSContext';\nimport { db, ref, onValue, set, get } from '../lib/firebase';\nimport { checkVmStatus } from './useCompetitions';\nimport { CHECKLIST_PHASES, getAllItems } from '../lib/checklistItems';\nimport { getTeamCount, buildTeamKey, getGenderFromCompType } from '../lib/competitionUtils';\n\n/**\n * useProductionChecklist - Main hook for production checklist state\n *\n * @returns {Object} Checklist state and actions:\n *   - phases: Computed phases with status\n *   - summary: { total, complete, warnings, errors, pending, percentage }\n *   - contacts: Team contacts from Firebase\n *   - teamKeys: Array of team keys for the competition\n *   - toggleItem: (itemId) => Promise<void>\n *   - updateNote: (itemId, note) => Promise<void>\n *   - updateContact: (teamKey, contactId, data) => Promise<void>\n *   - deleteContact: (teamKey, contactId) => Promise<void>\n *   - refresh: () => void\n *   - loading: boolean\n *   - lastUpdated: ISO timestamp or null\n */\nexport function useProductionChecklist() {\n  const { compId, competitionConfig } = useCompetition();\n  const { connected: socketConnected } = useShow();\n  const { obsConnected } = useOBS();\n\n  // Checklist state from Firebase\n  const [checklistState, setChecklistState] = useState(null);\n  const [localChecklistState, setLocalChecklistState] = useState(null); // for optimistic updates\n\n  // Team data from Firebase (rosters, headshots)\n  const [teamData, setTeamData] = useState(null);\n\n  // Rundown segments from Firebase\n  const [rundownSegments, setRundownSegments] = useState([]);\n\n  // Team contacts from Firebase\n  const [contacts, setContacts] = useState({});\n\n  // VM status\n  const [vmStatus, setVmStatus] = useState({ online: false, checking: true });\n\n  // Loading state\n  const [loading, setLoading] = useState(true);\n\n  // Last updated timestamp\n  const [lastUpdated, setLastUpdated] = useState(null);\n\n  // Derive team count and keys from competition config\n  const teamCount = useMemo(() => {\n    if (!competitionConfig?.compType) return 2;\n    return getTeamCount(competitionConfig.compType);\n  }, [competitionConfig?.compType]);\n\n  const gender = useMemo(() => {\n    if (competitionConfig?.gender) return competitionConfig.gender;\n    return getGenderFromCompType(competitionConfig?.compType) || 'womens';\n  }, [competitionConfig?.gender, competitionConfig?.compType]);\n\n  const teamKeys = useMemo(() => {\n    const keys = [];\n    for (let i = 1; i <= teamCount; i++) {\n      const name = competitionConfig?.[`team${i}Name`];\n      if (name) {\n        keys.push(buildTeamKey(name, gender));\n      }\n    }\n    return keys;\n  }, [competitionConfig, teamCount, gender]);\n\n  // Subscribe to checklist state from Firebase\n  useEffect(() => {\n    if (!compId) return;\n\n    const checklistRef = ref(db, `competitions/${compId}/checklist`);\n    const unsubscribe = onValue(checklistRef, (snapshot) => {\n      const data = snapshot.val();\n      setChecklistState(data);\n      setLastUpdated(data?.lastUpdated || null);\n      // Clear local optimistic state when Firebase updates\n      setLocalChecklistState(null);\n      setLoading(false);\n    }, (err) => {\n      console.error('[useProductionChecklist] Failed to load checklist state:', err);\n      setLoading(false);\n    });\n\n    return () => unsubscribe();\n  }, [compId]);\n\n  // Subscribe to team data from Firebase\n  useEffect(() => {\n    if (!compId) return;\n\n    const teamDataRef = ref(db, `competitions/${compId}/teamData`);\n    const unsubscribe = onValue(teamDataRef, (snapshot) => {\n      setTeamData(snapshot.val());\n    });\n\n    return () => unsubscribe();\n  }, [compId]);\n\n  // Subscribe to rundown segments from Firebase\n  // IMPORTANT: Path is competitions/{compId}/rundown/segments (NOT production/rundown/segments/)\n  useEffect(() => {\n    if (!compId) return;\n\n    const segmentsRef = ref(db, `competitions/${compId}/rundown/segments`);\n    const unsubscribe = onValue(segmentsRef, (snapshot) => {\n      const data = snapshot.val();\n      setRundownSegments(data ? Object.values(data) : []);\n    });\n\n    return () => unsubscribe();\n  }, [compId]);\n\n  // Subscribe to team contacts from Firebase\n  useEffect(() => {\n    if (teamKeys.length === 0) return;\n\n    const unsubscribes = [];\n    const contactsData = {};\n\n    for (const teamKey of teamKeys) {\n      const contactsRef = ref(db, `teamsDatabase/contacts/${teamKey}`);\n      const unsub = onValue(contactsRef, (snapshot) => {\n        contactsData[teamKey] = snapshot.val() || {};\n        setContacts({ ...contactsData });\n      });\n      unsubscribes.push(unsub);\n    }\n\n    return () => {\n      for (const unsub of unsubscribes) {\n        unsub();\n      }\n    };\n  }, [teamKeys]);\n\n  // VM status polling (30s interval)\n  useEffect(() => {\n    if (!competitionConfig?.vmAddress) {\n      setVmStatus({ online: false, checking: false });\n      return;\n    }\n\n    const poll = async () => {\n      setVmStatus(prev => ({ ...prev, checking: true }));\n      try {\n        const result = await checkVmStatus(competitionConfig.vmAddress, 5000, compId);\n        setVmStatus({ online: result.online, checking: false, error: result.error });\n      } catch (err) {\n        setVmStatus({ online: false, checking: false, error: err.message });\n      }\n    };\n\n    poll();\n    const interval = setInterval(poll, 30000);\n    return () => clearInterval(interval);\n  }, [competitionConfig?.vmAddress, compId]);\n\n  // Compute effective checklist state (local optimistic or Firebase)\n  const effectiveChecklistState = useMemo(() => {\n    return localChecklistState || checklistState || { items: {}, notes: {} };\n  }, [localChecklistState, checklistState]);\n\n  // Build validator context\n  const validatorContext = useMemo(() => ({\n    config: competitionConfig,\n    teamData,\n    rundownSegments,\n    socketConnected,\n    obsConnected,\n    vmStatus,\n    contacts,\n    teamCount,\n    gender\n  }), [competitionConfig, teamData, rundownSegments, socketConnected, obsConnected, vmStatus, contacts, teamCount, gender]);\n\n  // Compute phases with item statuses\n  const phases = useMemo(() => {\n    return CHECKLIST_PHASES.map(phase => ({\n      ...phase,\n      categories: phase.categories.map(category => ({\n        ...category,\n        items: category.items.map(item => {\n          // Compute status for this item\n          let status = 'pending';\n          let detail = null;\n\n          if (item.type === 'auto' && item.validator) {\n            // Auto-validated items - compute status from validators\n            // Validators will be implemented in Task 9, for now return pending\n            status = 'pending';\n            detail = 'Validator not implemented';\n          } else {\n            // Manual items - get from Firebase state\n            const itemState = effectiveChecklistState.items?.[item.id];\n            status = itemState?.checked ? 'complete' : 'pending';\n          }\n\n          // Get note if any\n          const note = effectiveChecklistState.notes?.[item.id] || null;\n\n          // Build fix link with compId substitution\n          let fixLink = item.fixLink || null;\n          if (fixLink && compId) {\n            fixLink = fixLink.replace('{compId}', compId);\n          }\n\n          return {\n            ...item,\n            status,\n            detail,\n            note,\n            fixLink,\n            checked: effectiveChecklistState.items?.[item.id]?.checked || false,\n            checkedAt: effectiveChecklistState.items?.[item.id]?.checkedAt || null\n          };\n        })\n      }))\n    }));\n  }, [effectiveChecklistState, compId]);\n\n  // Compute summary stats\n  const summary = useMemo(() => {\n    const allItems = getAllItems();\n    const total = allItems.length;\n    let complete = 0;\n    let warnings = 0;\n    let errors = 0;\n    let pending = 0;\n\n    for (const phase of phases) {\n      for (const category of phase.categories) {\n        for (const item of category.items) {\n          switch (item.status) {\n            case 'complete':\n              complete++;\n              break;\n            case 'warning':\n              warnings++;\n              break;\n            case 'error':\n              errors++;\n              break;\n            default:\n              pending++;\n          }\n        }\n      }\n    }\n\n    const percentage = total > 0 ? Math.round((complete / total) * 100) : 0;\n\n    return { total, complete, warnings, errors, pending, percentage };\n  }, [phases]);\n\n  // Toggle item action - optimistic update with rollback\n  const toggleItem = useCallback(async (itemId) => {\n    if (!compId) return;\n\n    let previousState;\n    const now = new Date().toISOString();\n\n    // Optimistic update — use functional form to safely read current local state\n    setLocalChecklistState(prev => {\n      const baseState = prev || checklistState || { items: {}, notes: {} };\n      previousState = baseState.items?.[itemId]?.checked ?? false;\n      return {\n        ...baseState,\n        items: {\n          ...(baseState.items || {}),\n          [itemId]: { checked: !previousState, checkedAt: now }\n        }\n      };\n    });\n\n    try {\n      await set(ref(db, `competitions/${compId}/checklist/items/${itemId}`), {\n        checked: !previousState,\n        checkedAt: now\n      });\n      // Update lastUpdated timestamp\n      await set(ref(db, `competitions/${compId}/checklist/lastUpdated`), now);\n    } catch (error) {\n      console.error('[useProductionChecklist] Failed to toggle item:', error);\n      // Rollback on failure — only revert this specific item\n      setLocalChecklistState(prev => {\n        const baseState = prev || checklistState || { items: {}, notes: {} };\n        return {\n          ...baseState,\n          items: {\n            ...(baseState.items || {}),\n            [itemId]: { checked: previousState }\n          }\n        };\n      });\n      throw error; // Re-throw for toast handling in UI\n    }\n  }, [compId, checklistState]);\n\n  // Update note action\n  const updateNote = useCallback(async (itemId, note) => {\n    if (!compId) return;\n\n    try {\n      const now = new Date().toISOString();\n      await set(ref(db, `competitions/${compId}/checklist/notes/${itemId}`), note);\n      await set(ref(db, `competitions/${compId}/checklist/lastUpdated`), now);\n    } catch (error) {\n      console.error('[useProductionChecklist] Failed to save note:', error);\n      throw error; // Re-throw for toast handling in UI\n    }\n  }, [compId]);\n\n  // Update contact action\n  const updateContact = useCallback(async (teamKey, contactId, contactData) => {\n    if (!teamKey || !contactId) return;\n\n    try {\n      await set(ref(db, `teamsDatabase/contacts/${teamKey}/${contactId}`), {\n        ...contactData,\n        updatedAt: new Date().toISOString()\n      });\n    } catch (error) {\n      console.error('[useProductionChecklist] Failed to save contact:', error);\n      throw error; // Re-throw for toast handling in UI\n    }\n  }, []);\n\n  // Delete contact action\n  const deleteContact = useCallback(async (teamKey, contactId) => {\n    if (!teamKey || !contactId) return;\n\n    try {\n      await set(ref(db, `teamsDatabase/contacts/${teamKey}/${contactId}`), null);\n    } catch (error) {\n      console.error('[useProductionChecklist] Failed to delete contact:', error);\n      throw error; // Re-throw for toast handling in UI\n    }\n  }, []);\n\n  // Refresh action - force re-fetch from Firebase\n  const refresh = useCallback(() => {\n    // Clear local state to force re-read from Firebase\n    setLocalChecklistState(null);\n  }, []);\n\n  return {\n    phases,\n    summary,\n    contacts,\n    teamKeys,\n    toggleItem,\n    updateNote,\n    updateContact,\n    deleteContact,\n    refresh,\n    loading,\n    lastUpdated,\n    // Expose additional context for components that need it\n    validatorContext,\n    competitionConfig,\n    teamCount,\n    gender\n  };\n}\n","numLines":383,"startLine":1,"totalLines":383}}}
