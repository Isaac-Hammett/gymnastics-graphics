TTPS), always use the coordinator API to avoid Mixed Content errors\n    44→  // The coordinator handles routing to the appropriate VM based on compId\n    45→  const socketUrl = (() => {\n    46→    if (isLocalMode) {\n    47→      // In local mode, use centralized server URL resolution\n    48→      return getServerUrl();\n    49→    }\n    50→\n    51→    // Check if we're on HTTPS (production) - if so, use coordinator to avoid Mixed Content\n    52→    const isSecureContext = typeof window !== 'undefined' &&\n    53→      (window.location.protocol === 'https:' || window.location.hostname === 'commentarygraphic.com');\n    54→\n    55→    if (isSecureContext) {\n    56→      // In production, always use the secure coordinator API\n    57→      // The coordinator will handle VM-specific connections server-side\n    58→      return 'https://api.commentarygraphic.com';\n    59→    }\n    60→\n    61→    // In development (HTTP), can connect directly to VM\n    62→    if (vmAddress) {\n    63→      // Ensure vmAddress doesn't already have protocol\n    64→      if (vmAddress.startsWith('http://') || vmAddress.startsWith('https://')) {\n    65→        return vmAddress;\n    66→      }\n    67→      return `http://${vmAddress}`;\n    68→    }\n    69→    return null;\n    70→  })();\n    71→\n    72→  // WebSocket URL (same as socket URL for socket.io)\n    73→  const websocketUrl = socketUrl;\n    74→\n    75→  useEffect(() => {\n    76→    // Reset state when compId changes\n    77→    setCompetitionConfig(null);\n    78→    setError(null);\n    79→    setErrorType(null);\n    80→    setIsLoading(true);\n    81→\n    82→    if (!compId) {\n    83→      setIsLoading(false);\n    84→      setError('No competition ID provided');\n    85→      setErrorType(CompetitionErrorType.NOT_FOUND);\n    86→      return;\n    87→    }\n    88→\n    89→    // Handle local development mode\n    90→    if (isLocalMode) {\n    91→      // Support ?gender=mens query param for testing MAG apparatus in local mode\n    92→      const genderParam = searchParams.get('gender');\n    93→      const localGender = genderParam === 'mens' ? 'mens' : 'womens';\n    94→      console.log(`CompetitionContext: Local development mode (gender: ${localGender})`);\n    95→      setCompetitionConfig({\n    96→        eventName: 'Local Development',\n    97→        gender: localGender,\n    98→        vmAddress: null // Will use getServerUrl() for local mode\n    99→      });\n   100→      setIsLoading(false);\n   101→      return;\n   102→    }\n   103→\n   104→    // Subscribe to competition config from Firebase\n   105→    const configRef = ref(db, `competitions/${compId}/config`);\n   106→\n   107→    const unsubscribe = onValue(\n   108→      configRef,\n   109→      (snapshot) => {\n   110→        const config = snapshot.val();\n   111→\n   112→        if (!config) {\n   113→          console.log(`CompetitionContext: Competition ${compId} not found`);\n   114→          setError(`Competition \"${compId}\" not found`);\n   115→          setErrorType(CompetitionErrorType.NOT_FOUND);\n   116→          setCompetitionConfig(null);\n   117→          setIsLoading(false);\n   118→          return;\n   119→        }\n   120→\n   121→        console.log(`CompetitionContext: Loaded config for ${compId}`, {\n   122→          eventName: config.eventName,\n   123→          vmAddress: config.vmAddress,\n   124→          gender: config.gender\n   125→        });\n   126→\n   127→        setCompetitionConfig(config);\n   128→        setError(null);\n   129→        setErrorType(null);\n   130→        setIsLoading(false);\n   131→\n   132→        // Check if vmAddress is configured\n   133→        if (!config.vmAddress && !isLocalMode) {\n   134→          console.warn(`CompetitionContext: Competition ${compId} has no vmAddress configured`);\n   135→          // Note: We don't set error here - the UI layer decides if vmAddress is required\n   136→        }\n   137→      },\n   138→      (err) => {\n   139→        console.error(`CompetitionContext: Firebase error for ${compId}:`, err);\n   140→        setError(err.message);\n   141→        setErrorType(CompetitionErrorType.FIREBASE_ERROR);\n   142→        setIsLoading(false);\n   143→      }\n   144→    );\n   145→\n   146→    return () => {\n   147→      unsubscribe();\n   148→    };\n   149→  }, [compId, isLocalMode, searchParams]);\n   150→\n   151→  const value = {\n   152→    // Competition identification\n   153→    compId,\n   154→    isLocalMode,\n   155→\n   156→    // Competition configuration from Firebase\n   157→    competitionConfig,\n   158→\n   159→    // Derived values\n   160→    vmAddress,\n   161→    gender,\n   162→    socketUrl,\n   163→    websocketUrl,\n   164→\n   165→    // Loading and error states\n   166→    isLoading,\n   167→    error,\n   168→    errorType\n   169→  };\n   170→\n   171→  return (\n   172→    <CompetitionContext.Provider value={value}>\n   173→      {children}\n   174→    </CompetitionContext.Provider>\n   175→  );\n   176→}\n   177→\n   178→/**\n   179→ * Hook to access competition context.\n   180→ * Must be used within a CompetitionProvider.\n   181→ *\n   182→ * @returns {Object} Competition context with:\n   183→ *   - compId: Competition ID from URL\n   184→ *   - isLocalMode: true if using local development mode (compId='local')\n   185→ *   - competitionConfig: Full competition config from Firebase\n   186→ *   - vmAddress: VM address for this competition (host:port format)\n   187→ *   - gender: Competition gender ('mens' or 'womens')\n   188→ *   - socketUrl: Full socket URL for connecting to VM (http://host:port)\n   189→ *   - websocketUrl: WebSocket URL (same as socketUrl for socket.io)\n   190→ *   - isLoading: true while loading config from Firebase\n   191→ *   - error: Error message if loading failed\n   192→ *   - errorType: CompetitionErrorType constant for specific error handling\n   193→ */\n   194→export function useCompetition() {\n   195→  const context = useContext(CompetitionContext);\n   196→  if (!context) {\n   197→    throw new Error('useCompetition must be used within a CompetitionProvider');\n   198→  }\n   199→  return context;\n   200→}\n   201→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"80813a13-8d65-4e4c-b211-0298af3d1836","uuid":"dae7c1cd-7c7c-405a-9c8f-f84c4d4665c2","tool_use_result":{"type":"text","file":{"filePath":"/Users/juliacosmiano/code/gymnastics-graphics/show-controller/src/context/CompetitionContext.jsx","content":"import { createContext, useContext, useEffect, useState } from 'react';\nimport { useParams, useSearchParams } from 'react-router-dom';\nimport { db, ref, onValue } from '../lib/firebase';\nimport { getServerUrl } from '../lib/serverUrl';\n\n// Error types for different failure scenarios\nexport const CompetitionErrorType = {\n  NOT_FOUND: 'NOT_FOUND',\n  NO_VM_ADDRESS: 'NO_VM_ADDRESS',\n  VM_UNREACHABLE: 'VM_UNREACHABLE',\n  FIREBASE_ERROR: 'FIREBASE_ERROR'\n};\n\nconst CompetitionContext = createContext(null);\n\n/**\n * CompetitionProvider wraps routes that need competition-specific configuration.\n * It extracts the compId from the URL, fetches the competition config from Firebase,\n * and derives the socket URL for connecting to the competition's VM.\n *\n * Special handling for compId='local' enables local development mode.\n */\nexport function CompetitionProvider({ children }) {\n  const { compId } = useParams();\n  const [searchParams] = useSearchParams();\n\n  // Competition config from Firebase\n  const [competitionConfig, setCompetitionConfig] = useState(null);\n\n  // Loading and error states\n  const [isLoading, setIsLoading] = useState(true);\n  const [error, setError] = useState(null);\n  const [errorType, setErrorType] = useState(null);\n\n  // Derived values\n  const isLocalMode = compId === 'local';\n\n  // Extract vmAddress and gender from config\n  const vmAddress = competitionConfig?.vmAddress || null;\n  const gender = competitionConfig?.gender || 'womens';\n\n  // Derive socket URL from vmAddress\n  // In production (HTTPS), always use the coordinator API to avoid Mixed Content errors\n  // The coordinator handles routing to the appropriate VM based on compId\n  const socketUrl = (() => {\n    if (isLocalMode) {\n      // In local mode, use centralized server URL resolution\n      return getServerUrl();\n    }\n\n    // Check if we're on HTTPS (production) - if so, use coordinator to avoid Mixed Content\n    const isSecureContext = typeof window !== 'undefined' &&\n      (window.location.protocol === 'https:' || window.location.hostname === 'commentarygraphic.com');\n\n    if (isSecureContext) {\n      // In production, always use the secure coordinator API\n      // The coordinator will handle VM-specific connections server-side\n      return 'https://api.commentarygraphic.com';\n    }\n\n    // In development (HTTP), can connect directly to VM\n    if (vmAddress) {\n      // Ensure vmAddress doesn't already have protocol\n      if (vmAddress.startsWith('http://') || vmAddress.startsWith('https://')) {\n        return vmAddress;\n      }\n      return `http://${vmAddress}`;\n    }\n    return null;\n  })();\n\n  // WebSocket URL (same as socket URL for socket.io)\n  const websocketUrl = socketUrl;\n\n  useEffect(() => {\n    // Reset state when compId changes\n    setCompetitionConfig(null);\n    setError(null);\n    setErrorType(null);\n    setIsLoading(true);\n\n    if (!compId) {\n      setIsLoading(false);\n      setError('No competition ID provided');\n      setErrorType(CompetitionErrorType.NOT_FOUND);\n      return;\n    }\n\n    // Handle local development mode\n    if (isLocalMode) {\n      // Support ?gender=mens query param for testing MAG apparatus in local mode\n      const genderParam = searchParams.get('gender');\n      const localGender = genderParam === 'mens' ? 'mens' : 'womens';\n      console.log(`CompetitionContext: Local development mode (gender: ${localGender})`);\n      setCompetitionConfig({\n        eventName: 'Local Development',\n        gender: localGender,\n        vmAddress: null // Will use getServerUrl() for local mode\n      });\n      setIsLoading(false);\n      return;\n    }\n\n    // Subscribe to competition config from Firebase\n    const configRef = ref(db, `competitions/${compId}/config`);\n\n    const unsubscribe = onValue(\n      configRef,\n      (snapshot) => {\n        const config = snapshot.val();\n\n        if (!config) {\n          console.log(`CompetitionContext: Competition ${compId} not found`);\n          setError(`Competition \"${compId}\" not found`);\n          setErrorType(CompetitionErrorType.NOT_FOUND);\n          setCompetitionConfig(null);\n          setIsLoading(false);\n          return;\n        }\n\n        console.log(`CompetitionContext: Loaded config for ${compId}`, {\n          eventName: config.eventName,\n          vmAddress: config.vmAddress,\n          gender: config.gender\n        });\n\n        setCompetitionConfig(config);\n        setError(null);\n        setErrorType(null);\n        setIsLoading(false);\n\n        // Check if vmAddress is configured\n        if (!config.vmAddress && !isLocalMode) {\n          console.warn(`CompetitionContext: Competition ${compId} has no vmAddress configured`);\n          // Note: We don't set error here - the UI layer decides if vmAddress is required\n        }\n      },\n      (err) => {\n        console.error(`CompetitionContext: Firebase error for ${compId}:`, err);\n        setError(err.message);\n        setErrorType(CompetitionErrorType.FIREBASE_ERROR);\n        setIsLoading(false);\n      }\n    );\n\n    return () => {\n      unsubscribe();\n    };\n  }, [compId, isLocalMode, searchParams]);\n\n  const value = {\n    // Competition identification\n    compId,\n    isLocalMode,\n\n    // Competition configuration from Firebase\n    competitionConfig,\n\n    // Derived values\n    vmAddress,\n    gender,\n    socketUrl,\n    websocketUrl,\n\n    // Loading and error states\n    isLoading,\n    error,\n    errorType\n  };\n\n  return (\n    <CompetitionContext.Provider value={value}>\n      {children}\n    </CompetitionContext.Provider>\n  );\n}\n\n/**\n * Hook to access competition context.\n * Must be used within a CompetitionProvider.\n *\n * @returns {Object} Competition context with:\n *   - compId: Competition ID from URL\n *   - isLocalMode: true if using local development mode (compId='local')\n *   - competitionConfig: Full competition config from Firebase\n *   - vmAddress: VM address for this competition (host:port format)\n *   - gender: Competition gender ('mens' or 'womens')\n *   - socketUrl: Full socket URL for connecting to VM (http://host:port)\n *   - websocketUrl: WebSocket URL (same as socketUrl for socket.io)\n *   - isLoading: true while loading config from Firebase\n *   - error: Error message if loading failed\n *   - errorType: CompetitionErrorType constant for specific error handling\n */\nexport function useCompetition() {\n  const context = useContext(CompetitionContext);\n  if (!context) {\n    throw new Error('useCompetition must be used within a CompetitionProvider');\n  }\n  return context;\n}\n","numLines":201,"startLine":1,"totalLines":201}}}
