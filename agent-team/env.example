# Copy to agent-team/.env and fill in:   cp agent-team/env.example agent-team/.env
# agent-team/.env is gitignored. Values here override models.conf; the real environment overrides both.

# --- Linear ---
LINEAR_API_KEY=
LINEAR_TEAM_KEY=ISA2
# Optional: restrict the board to one project name, e.g. "Xavier: AI producer prototype (Suggest mode)". Empty = whole team.
LINEAR_PROJECT=
# Optional: a pinned ticket the planner posts its summary on.
TRACKING_TICKET=

# --- git ---
MAIN_BRANCH=main
PUSH_AFTER_MERGE=1

# --- dispatcher ---
MAX_AGENTS=2
MAX_VERIFIERS=1
POLL_SECONDS=240
STUCK_MINUTES=20
CLAUDE_MAX_TURNS=150
AGENT_TIMEOUT_MIN=180
VERIFY_TIMEOUT_MIN=60

# --- planner / reviewer / loops ---
PLANNER_ENABLED=0
PLANNER_EVERY_MINUTES=1440
PLANNER_MIN_GAP_MIN=60
# recommend: the reviewer comments a recommendation and adds `reviewed`; Isaac decides. auto: it approves/rejects/escalates itself.
REVIEWER_MODE=recommend
REVIEWER_MIN_GAP_MIN=10
REVIEWER_COOLDOWN_MIN=30
REVIEWER_MAX_APPROVALS_PER_DAY=80
LOOPS_ENABLED=0
LOOP_COOLDOWN_MIN=60

# --- worktrees ---
# Where ticket worktrees live. Default: a sibling of the repo, ../gymnastics-graphics-worktrees (outside the repo so
# agents do not load CLAUDE.md twice and repo-wide searches skip agent copies).
WORKTREES_DIR=

# --- verify lane (dev servers inside the _verify worktree) ---
VERIFY_SPA_PORT=5199
VERIFY_API_PORT=3099
VERIFY_LOGIN_EMAIL=
VERIFY_LOGIN_PASSWORD=
# The only competition agents may write to in Firebase.
TEST_COMP_ID=

# --- notifications ---
# ntfy.sh topic; empty = macOS notification only.
NTFY_TOPIC=
