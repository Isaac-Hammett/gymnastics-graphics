# Dependencies (no trailing slash, so the node_modules symlinks inside agent worktrees are ignored too)
node_modules

# Environment files
.env
.env.local
.env.*.local

# Firebase service account (credentials - never commit!)
firebase-service-account.json
*-service-account*.json

# Build output
show-controller/dist/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Event-specific files (OBS scene collections, show CSVs, recordings)
*_SceneCollection.json
*_ShowController.csv
*_recording_session.json

# Cache directories
.cache/

# Screenshots (test artifacts)
screenshots/
ralph-wigg/screenshots/
docs/PRD-Rundown-01-EditorPrototype/logs/claude-output.jsonl
docs/PRD-Rundown-System/logs/*.jsonl
docs/PRD-Rundown-System/logs/claude-output.jsonl

# agent team (Linear-driven runs). No trailing slash: inside ticket worktrees these are symlinks.
agent-team/runs
agent-team/logs
agent-team/worktrees
agent-team/.env

# Firebase Admin keys as downloaded from the console (e.g. <project>-firebase-adminsdk-<id>.json)
*firebase-adminsdk*.json

# Recorded meets for Xavier's recorded-source mode. Video and frame grabs stay local (large);
# the small JSON files (layout timeline, event log, final Virtius data) are committed so every
# checkout and agent worktree has them.
recordings/*/*
!recordings/*/meta.json
!recordings/*/events.jsonl
!recordings/*/virtius-final.json
